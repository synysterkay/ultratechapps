{
  "subject": "\u0627\u0639\u062a\u0631\u0627\u0641: 90% \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u0631\u062a\u0643\u0628\u0648\u0646 \u0647\u0630\u0627 \u0627\u0644\u062e\u0637\u0623 \u0628\u0639\u062f \u0623\u0633\u0628\u0648\u0639\u064a\u0646",
  "preview_text": "\u0644\u0642\u062f \u0645\u0631\u0651 \u0623\u0633\u0628\u0648\u0639\u0627\u0646 \u0639\u0644\u0649 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0643 \u0644\u0644\u0640\u062a\u0637\u0628\u064a\u0642. \u0625\u0644\u064a\u0643 \u0645\u0627 \u0641\u0627\u062a\u0643 \u0648\u0645\u0627 \u064a\u062c\u0628 \u0623\u0646 \u062a\u0641\u0639\u0644\u0647 \u0627\u0644\u0622\u0646 \u0642\u0628\u0644 \u0641\u0648\u0627\u062a \u0627\u0644\u0623\u0648\u0627\u0646.",
  "body_paragraphs": [
    "\u0623\u0633\u0628\u0648\u0639\u0627\u0646. \u0647\u0630\u0627 \u0643\u0644 \u0645\u0627 \u062a\u062d\u062a\u0627\u062c\u0647 \u0644\u062a\u0628\u062f\u0623 \u062a\u0631\u0649 \u0646\u0645\u0637\u0627\u064b \u0645\u062e\u0641\u064a\u0627\u064b. \u0645\u0639\u0638\u0645 \u0645\u0646 \u064a\u0635\u0644\u0648\u0646 \u0625\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0646\u0642\u0637\u0629 \u064a\u062a\u0648\u0642\u0641\u0648\u0646 \u0639\u0646 \u0641\u0639\u0644 \u0634\u064a\u0621 \u0648\u0627\u062d\u062f \u0628\u0633\u064a\u0637\u060c \u0648\u0647\u0648 \u0646\u0641\u0633 \u0627\u0644\u0634\u064a\u0621 \u0627\u0644\u0630\u064a \u064a\u062c\u0639\u0644 \u062a\u0648\u0642\u0639\u0627\u062a\u0647\u0645 \u0623\u0642\u0644 \u062f\u0642\u0629 \u0628\u0646\u0633\u0628\u0629 40%. \u0625\u0646\u0647 \u0644\u064a\u0633 \u062e\u0637\u0623\u0643\u060c \u0628\u0644 \u062e\u0637\u0623 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0644\u0623\u0646\u0647 \u0644\u0645 \u064a\u062e\u0628\u0631\u0643.",
    "\u0644\u0643\u0646 \u062f\u0639\u0646\u064a \u0623\u062e\u0628\u0631\u0643 \u0628\u0645\u0627 \u0623\u0646\u062c\u0632\u062a\u0647 \u062d\u0642\u0627\u064b \u062e\u0644\u0627\u0644 14 \u064a\u0648\u0645\u0627\u064b: \u0644\u0642\u062f \u062d\u0644\u0651\u0644\u062a \u0628\u064a\u0627\u0646\u0627\u062a \u0623\u0643\u062b\u0631 \u0645\u0645\u0627 \u064a\u0633\u062a\u0647\u0644\u0643\u0647 \u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u0645\u0634\u062c\u0639 \u0641\u064a \u0645\u0648\u0633\u0645 \u0643\u0627\u0645\u0644. \u0643\u0644 \u0646\u0642\u0631\u062a\u0643 \u0633\u062c\u0644\u062a\u060c \u0643\u0644 \u062a\u0648\u0642\u0639 \u062f\u0631\u0633\u062a\u0647\u060c \u0643\u0644 \u0646\u062a\u064a\u062c\u0629 \u0642\u0627\u0631\u0646\u062a\u0647\u0627. \u0644\u062f\u064a\u0643 \u0627\u0644\u0622\u0646 \u0623\u0633\u0627\u0633 \u0628\u064a\u0627\u0646\u0627\u062a \u0634\u062e\u0635\u064a \u064a\u0641\u0648\u0642 95% \u0645\u0646 \u0627\u0644\u0645\u0634\u062c\u0639\u064a\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0639\u062a\u0645\u062f\u0648\u0646 \u0639\u0644\u0649 '\u0627\u0644\u0634\u0639\u0648\u0631 \u0627\u0644\u062f\u0627\u062e\u0644\u064a'. \u0647\u0630\u0627 \u0631\u0635\u064a\u062f\u0643 \u0627\u0644\u0630\u064a \u0644\u0627 \u064a\u062c\u0628 \u0623\u0646 \u062a\u0647\u062f\u0631\u0647.",
    "\u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u064a \u062a\u062a\u062c\u0627\u0647\u0644\u0647\u0627\u061f '\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u062a\u0642\u062f\u0645 \u0627\u0644\u0634\u062e\u0635\u064a' \u0641\u064a \u0642\u0633\u0645 \u0627\u0644\u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a. \u0625\u0646\u0647 \u0644\u0627 \u064a\u0638\u0647\u0631 \u0641\u0642\u0637 \u0645\u0639\u062f\u0644 \u062f\u0642\u062a\u0643\u060c \u0628\u0644 \u064a\u0643\u0634\u0641 \u0628\u0627\u0644\u0636\u0628\u0637 \u0623\u064a \u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a \u062a\u062a\u0641\u0648\u0642 \u0641\u064a\u0647\u0627 (\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629\u061f \u0639\u062f\u062f \u0627\u0644\u0623\u0647\u062f\u0627\u0641\u061f) \u0648\u0623\u064a\u0647\u0627 \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u062a\u0639\u062f\u064a\u0644. \u0625\u0646\u0647 \u0645\u062b\u0644 \u0645\u062f\u0631\u0628 \u0634\u062e\u0635\u064a \u064a\u062e\u0628\u0631\u0643: '\u062a\u0648\u0642\u0639\u0627\u062a\u0643 \u0641\u064a \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a \u062f\u0642\u064a\u0642\u0629 \u0628\u0646\u0633\u0628\u0629 78%\u060c \u0644\u0643\u0646\u0643 \u062a\u062a\u0639\u062b\u0631 \u0641\u064a \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0627\u0644\u0643\u0623\u0633'.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0634\u0627\u0647\u062f \u062a\u0642\u0631\u064a\u0631 \u0623\u0633\u0628\u0648\u0639\u064a\u0643 \u0627\u0644\u0643\u0627\u0645\u0644. \u0633\u062a\u062a\u0641\u0627\u062c\u0623 \u0628\u0645\u0627 \u062a\u0631\u0627\u0647\u060c \u0648\u0623\u0639\u062f\u0643 \u0623\u0646 \u062a\u0648\u0642\u0639\u0627\u062a\u0643 \u0627\u0644\u0642\u0627\u062f\u0645\u0629 \u0633\u062a\u0643\u0648\u0646 \u0627\u0644\u0623\u0643\u062b\u0631 \u0630\u0643\u0627\u0621\u064b \u0639\u0644\u0649 \u0627\u0644\u0625\u0637\u0644\u0627\u0642. P.S.: \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0637\u0651\u0644\u0639\u0648\u0646 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0623\u0633\u0628\u0648\u0639\u064a\u0627\u064b \u064a\u0632\u064a\u062f\u0648\u0646 \u062f\u0642\u0629 \u062a\u0648\u0642\u0639\u0627\u062a\u0647\u0645 \u0628\u0645\u0639\u062f\u0644 22% \u0641\u064a \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u062a\u0627\u0644\u064a. \u0644\u0627 \u062a\u0643\u0646 \u0645\u0646 \u0627\u0644\u064010% \u0627\u0644\u0630\u064a\u0646 \u064a\u0641\u0648\u0651\u062a\u0648\u0646 \u0630\u0644\u0643."
  ],
