  "subject": "70 \u0926\u093f\u0928 \u092c\u093e\u0926: \u0924\u0941\u092e Loudify \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u094b",
  "preview_text": "70 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0924\u0941\u092e\u0928\u0947 \u0915\u094d\u092f\u093e \u0938\u0941\u0928\u093e? \u0939\u092e\u093e\u0930\u0947 \u092a\u093e\u0938 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0921\u0947\u091f\u093e \u0939\u0948\u0964 \u0906\u091c \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u090f\u0915 \u0916\u093e\u0938 \u092c\u093e\u0924 \u092c\u0924\u093e\u0928\u0940 \u0939\u0948\u0964",
  "body_paragraphs": [
    "70 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0924\u0941\u092e\u0928\u0947 Loudify \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e\u0964 \u0924\u092c \u0938\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0915\u093e\u0928\u094b\u0902 \u0928\u0947 \u0915\u093f\u0924\u0928\u0940 \u0906\u0935\u093e\u091c\u093c\u0947\u0902 \u0938\u0941\u0928\u0940 \u0939\u094b\u0902\u0917\u0940? \u091f\u094d\u0930\u0947\u0928 \u0915\u093e \u0936\u094b\u0930, \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u0940 \u0906\u0935\u093e\u091c\u093c, \u0917\u0947\u092e \u0915\u0940 \u0927\u092e\u093e\u0915\u0947\u0926\u093e\u0930 \u0906\u0935\u093e\u091c\u093c\u0947\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u091a\u0940\u091c\u093c \u092c\u0926\u0932 \u0917\u0908 \u0939\u0948\u0964 \u0905\u092c \u0924\u0941\u092e \u0938\u093f\u0930\u094d\u092b\u093c \u092f\u0942\u091c\u093c\u0930 \u0928\u0939\u0940\u0902 \u0939\u094b\u0964 \u0924\u0941\u092e \u0909\u0938 \u091a\u0940\u091c\u093c \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u094b \u091c\u094b \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u0938\u093e\u092b \u0914\u0930 \u0924\u0947\u091c\u093c \u092c\u0928\u093e\u0924\u0940 \u0939\u0948\u0964",
    "\u0939\u092e\u0928\u0947 100,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939 \u0910\u092a \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964 \u0939\u0930 \u0939\u092b\u093c\u094d\u0924\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e Sound DNA \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0939\u092e\u0947\u0902 \u092c\u0924\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0924\u0941\u092e \u0915\u0948\u0938\u0947 \u0938\u0941\u0928\u0924\u0947 \u0939\u094b\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b\u093c \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0906\u0926\u0924\u094b\u0902 \u0915\u093e \u0928\u0915\u094d\u0936\u093e \u0939\u0948\u0964 \u0939\u092e \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0915\u092c \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0906\u0935\u093e\u091c\u093c \u091a\u093e\u0939\u093f\u090f \u0914\u0930 \u0915\u092c \u0938\u092b\u093c\u093e\u0908\u0964 \u092f\u0939\u0940 \u0935\u091c\u0939 \u0939\u0948 \u0915\u093f \u0939\u092e \u0939\u0930 \u0926\u093f\u0928 \u0911\u091f\u094bEQ \u0915\u094b \u092c\u0947\u0939\u0924\u0930 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0947 \u0932\u093f\u090f\u0964",
