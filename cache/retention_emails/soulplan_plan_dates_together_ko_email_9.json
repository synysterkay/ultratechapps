{
  "subject": "\ub2f9\uc2e0\uc758 3\uc77c \ucc4c\ub9b0\uc9c0\uac00 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4",
  "preview_text": "\uc624\ub298\ubd80\ud130 3\uc77c\ub9cc \ud574\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc758 \uad00\uacc4\uac00 \ubc14\ub00c\ub294 \uac78 \ub290\ub084 \uac70\uc608\uc694.",
  "body_paragraphs": [
    "\uc9c0\ub09c\uc8fc\uc5d0 \ub370\uc774\ud2b8\ub97c \uba87 \ubc88\uc774\ub098 \ud588\ub098\uc694? \uc194\uc9c1\ud788 \ub9d0\ud558\uba74, \ub300\ubd80\ubd84\uc758 \ucee4\ud50c\uc774 \uc77c\uc8fc\uc77c\uc5d0 \ud55c \ubc88\ub3c4 \uc81c\ub300\ub85c \ub41c \uc2dc\uac04\uc744 \ubabb \ub0b4\uc694. \ubc14\uc05c \uc77c\uc0c1 \uc18d\uc5d0\uc11c '\uc5b8\uc820\uac00'\ub77c\ub294 \ub9d0\ub85c \ubbf8\ub8e8\ub2e4 \ubcf4\uba74, \uc5b4\ub290\uc0c8 \uc11c\ub85c\uac00 \ub0af\uc124\uc5b4\uc9c0\uae30 \uc2dc\uc791\ud558\uc8e0.",
    "\ud558\uc9c0\ub9cc \uc791\uc740 \ubcc0\ud654 \ud558\ub098\ub85c \ubaa8\ub4e0 \uac8c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc5b4\uc694. \uc800\ud76c \uc571\uc744 \uc0ac\uc6a9\ud558\ub294 \ucee4\ud50c \uc911 3\uc77c \ucc4c\ub9b0\uc9c0\uc5d0 \ucc38\uc5ec\ud55c \ubd84\ub4e4\uc740 \ud55c \ub2ec \ub3d9\uc548 \ub370\uc774\ud2b8 \ud69f\uc218\uac00 4\ubc30\ub098 \ub298\uc5c8\uc5b4\uc694. \ube44\uacb0\uc740 \uac04\ub2e8\ud574\uc694: \ub9e4\uc77c 30\ucd08\ub9cc \ud22c\uc790\ud574\uc11c '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ud655\uc778\ud558\ub294 \uac70\uc608\uc694. \ucf54\uc9c0, \ubaa8\ud5d8, \uc990\uac70\uc6c0, \ud790\ub9c1 \uc911 \ud558\ub098\ub97c \uace0\ub974\uba74 AI\uac00 \ubc14\ub85c \uc624\ub298 \ubc24\uc744 \uacc4\ud68d\ud574\uc918\uc694.",
    "\uc774\uac8c \ub05d\uc774 \uc544\ub2c8\uc5d0\uc694. \ud30c\ud2b8\ub108\uac00 \uc81c\uc548\uc744 \ubcf4\ub0b4\uba74 '\uc624\ub298 \ub108\ub97c \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \ud480\uc2a4\ud06c\ub9b0 \uc21c\uac04\uc774 \ud3bc\uccd0\uc838\uc694. \uadf8 \uc21c\uac04, \ub2f9\uc2e0\uc740 \uc0c1\ub300\ubc29\uc774 \uc5bc\ub9c8\ub098 \uc18c\uc911\ud55c\uc9c0 \ub2e4\uc2dc \uae68\ub2eb\uac8c \ub3fc\uc694. \uadf8\ub9ac\uace0 \uba54\ubaa8\ub9ac \ud0c0\uc784\ub77c\uc778\uc5d0 \uadf8\ub0a0\uc758 \uc0ac\uc9c4\uacfc \uba54\ubaa8\ub97c \ub0a8\uae30\uba74, \uba87 \ub2ec \ud6c4\uc5d0\ub294 \ub458\ub9cc\uc758 \ud2b9\ubcc4\ud55c \uc568\ubc94\uc774 \uc644\uc131\ub3fc\uc694.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uace0 '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694. 3\uc77c \ud6c4, \ub2f9\uc2e0\uc758 \uad00\uacc4\uac00 \uc5b4\ub5bb\uac8c \ubcc0\ud588\ub294\uc9c0 \uc81c\uac8c \uc54c\ub824\uc8fc\uc138\uc694. P.S. \uccab \ub0a0\uc740 \uac00\uc7a5 \uc26c\uc6b4 \ucf54\uc9c0 \ubaa8\ub4dc\ub85c \uc2dc\uc791\ud574\ubcf4\ub294 \uac74 \uc5b4\ub54c\uc694? \ud30c\ud2b8\ub108\uac00 \uae5c\uc9dd \ub180\ub784 \uac70\uc608\uc694."
  ],
