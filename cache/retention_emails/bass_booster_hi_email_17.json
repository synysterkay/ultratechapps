{
  "subject": "\u0935\u0939 3 \u092e\u093f\u0928\u091f \u0915\u093e \u0930\u0942\u091f\u0940\u0928 \u091c\u094b \u092c\u093e\u0938 \u0915\u094b 10x \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948",
  "preview_text": "\u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u0906\u0926\u0924 \u091c\u094b \u0906\u092a\u0915\u0947 \u0917\u093e\u0928\u094b\u0902 \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u092c\u0926\u0932 \u0926\u0947\u0917\u0940\u0964 \u0938\u0941\u0928\u093f\u090f, \u092b\u093f\u0930 \u092e\u093e\u0928\u093f\u090f\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 11:15 \u092c\u091c\u0947, \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u092a\u0930 \u090f\u0915 \u0917\u093e\u0928\u093e \u0932\u0917\u093e\u092f\u093e\u0964 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u0947, \u092c\u0938 \u0938\u0940\u0927\u093e Spotify\u0964 \u0932\u0917\u093e \u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u0917\u0940\u0932\u093e \u0924\u094c\u0932\u093f\u092f\u093e \u092c\u091c \u0930\u0939\u093e \u0939\u094b\u0964 \u092b\u093f\u0930 \u092e\u0948\u0902\u0928\u0947 \u0935\u0939\u0940 3 \u092e\u093f\u0928\u091f \u0915\u093e \u0930\u0942\u091f\u0940\u0928 \u0915\u093f\u092f\u093e \u091c\u094b \u092e\u0948\u0902 \u0939\u0930 \u0926\u093f\u0928 \u0915\u0930\u0924\u093e \u0939\u0942\u0901\u0964 \u0914\u0930 \u092c\u0942\u092e \u2014 \u0935\u0939\u0940 \u0921\u094d\u0930\u0949\u092a, \u0905\u092c \u0938\u0940\u0928\u0947 \u092e\u0947\u0902 \u0917\u0942\u0902\u091c \u0930\u0939\u093e \u0925\u093e\u0964",
    "\u092f\u0939 \u0915\u094b\u0908 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u090f\u0915 \u0906\u0926\u0924 \u0939\u0948\u0964 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0906\u092a Bass Booster \u0916\u094b\u0932\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092c\u093e\u0930 Bass Boost \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b \u090a\u092a\u0930 \u0916\u0940\u0902\u091a\u093f\u090f\u0964 \u092c\u0938 \u0924\u0940\u0928 \u0938\u0947\u0915\u0902\u0921\u0964 \u092b\u093f\u0930 \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091f\u094d\u0930\u0948\u0915 \u092a\u0930 \u091c\u093e\u0907\u090f\u0964 \u092f\u0939 \u091b\u094b\u091f\u0940 \u0938\u0940 \u0939\u0930\u0915\u0924 \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u094b \u0935\u0939 \u092c\u093e\u0938 \u0926\u0947\u0924\u0940 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u0915\u0947 \u0938\u094d\u092a\u0940\u0915\u0930 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0926\u0947 \u092a\u093e\u0924\u0947\u0964",
    "\u092f\u0939\u0940 \u0935\u0939 \u0930\u0942\u091f\u0940\u0928 \u0939\u0948 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 100,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0936\u0947\u092f\u0930 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 Bass Virtualizer \u0914\u0930 3D Surround \u0915\u094b \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902 \u2014 \u092b\u093f\u0930 \u090f\u0915 \u092c\u093e\u0930 Bass Boost \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b \u092e\u0942\u0935 \u0915\u0930\u0947\u0902\u0964 \u0906\u092a \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0947\u0902\u0917\u0947 \u0915\u093f \u0921\u094d\u0930\u0949\u092a \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0906\u092a\u0915\u0947 \u0938\u0940\u0928\u0947 \u092e\u0947\u0902 \u0917\u0942\u0902\u091c \u0930\u0939\u093e \u0939\u0948\u0964 \u091a\u093e\u0939\u0947 Hip-Hop \u0939\u094b, EDM \u0939\u094b \u092f\u093e Rock \u2014 \u092f\u0939 \u0930\u0942\u091f\u0940\u0928 \u0939\u0930 \u0917\u093e\u0928\u0947 \u0915\u094b \u090f\u0915 \u0928\u092f\u093e \u091c\u0940\u0935\u0928 \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u093f\u090f \u0914\u0930 Bass Boost \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b \u090a\u092a\u0930 \u0916\u0940\u0902\u091a\u093f\u090f\u0964 \u092b\u093f\u0930 \u0905\u092a\u0928\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091f\u094d\u0930\u0948\u0915 \u0932\u0917\u093e\u0907\u090f\u0964 \u092f\u0939 \u0924\u0940\u0928 \u0938\u0947\u0915\u0902\u0921 \u0915\u093e \u0915\u093e\u092e \u0939\u0948\u0964 \u0914\u0930 \u0939\u093e\u0901, Premium \u0915\u0947 \u0938\u093e\u0925 \u0906\u092a Unlimited Boost \u0914\u0930 \u092a\u0942\u0930\u0940 10-band EQ \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u2014 \u0932\u0947\u0915\u093f\u0928 \u0906\u091c, \u092c\u0938 \u092f\u0939 \u090f\u0915 \u0915\u0926\u092e \u0909\u0920\u093e\u0907\u090f\u0964 P.S. \u2014 \u092e\u0948\u0902\u0928\u0947 \u0916\u0941\u0926 \u092f\u0939 \u0930\u0942\u091f\u0940\u0928 30 \u0926\u093f\u0928\u094b\u0902 \u0924\u0915 \u0915\u093f\u092f\u093e \u0939\u0948, \u0914\u0930 \u0905\u092c \u092e\u0948\u0902 \u092c\u093f\u0928\u093e Bass Booster \u0915\u0947 \u0917\u093e\u0928\u093e \u0928\u0939\u0940\u0902 \u0938\u0941\u0928 \u0938\u0915\u0924\u093e\u0964 \u0906\u092a \u092d\u0940 \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u093f\u090f\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u093f\u090f \u0914\u0930 Bass Boost \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b \u090a\u092a\u0930 \u0916\u0940\u0902\u091a\u093f\u090f\u0964 \u092b\u093f\u0930 \u0905\u092a\u0928\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091f\u094d\u0930\u0948\u0915 \u0932\u0917\u093e\u0907\u090f\u0964 \u092f\u0939 \u0924\u0940\u0928 \u0938\u0947\u0915\u0902\u0921 \u0915\u093e \u0915\u093e\u092e \u0939\u0948\u0964 \u0914\u0930 \u0939\u093e\u0901, Premium \u0915\u0947 \u0938\u093e\u0925 \u0906\u092a Unlimited Boost \u0914\u0930 \u092a\u0942\u0930\u0940 10-band EQ \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u2014 \u0932\u0947\u0915\u093f\u0928 \u0906\u091c, \u092c\u0938 \u092f\u0939 \u090f\u0915 \u0915\u0926\u092e \u0909\u0920\u093e\u0907\u090f\u0964 P.S. \u2014 \u092e\u0948\u0902\u0928\u0947 \u0916\u0941\u0926 \u092f\u0939 \u0930\u0942\u091f\u0940\u0928 30 \u0926\u093f\u0928\u094b\u0902 \u0924\u0915 \u0915\u093f\u092f\u093e \u0939\u0948, \u0914\u0930 \u0905\u092c \u092e\u0948\u0902 \u092c\u093f\u0928\u093e Bass Booster \u0915\u0947 \u0917\u093e\u0928\u093e \u0928\u0939\u0940\u0902 \u0938\u0941\u0928 \u0938\u0915\u0924\u093e\u0964 \u0906\u092a \u092d\u0940 \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u093f\u090f\u0964"
