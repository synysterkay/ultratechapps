{
  "subject": "\u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u0915\u093e \u0938\u091a \u091c\u094b \u0915\u094b\u0908 \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u0924\u093e",
  "preview_text": "\u0939\u0930 \u0915\u094b\u0908 \u0915\u0939\u0924\u093e \u0939\u0948 \u0915\u093f \u0910\u092a \u092e\u0947\u0902 \u090f\u0921\u094d\u0938 \u091c\u0930\u0942\u0930\u0940 \u0939\u0948\u0902\u0964 \u092e\u0917\u0930 \u092f\u0939 \u091d\u0942\u0920 \u0939\u0948\u0964 \u0939\u092e\u0928\u0947 \u0938\u093e\u092c\u093f\u0924 \u0915\u093f\u092f\u093e \u0939\u0948 \u0915\u093f \u0915\u0948\u0938\u0947\u0964",
  "body_paragraphs": [
    "\u0906\u092a\u0928\u0947 \u0938\u0941\u0928\u093e \u0939\u094b\u0917\u093e \u0915\u093f '\u092b\u094d\u0930\u0940 \u0910\u092a \u092e\u0947\u0902 \u090f\u0921\u094d\u0938 \u0939\u094b\u0928\u093e \u091c\u0930\u0942\u0930\u0940 \u0939\u0948'\u2014\u0921\u0947\u0935\u0932\u092a\u0930\u094d\u0938 \u0915\u094b \u092a\u0948\u0938\u0947 \u091a\u093e\u0939\u093f\u090f\u0964 \u092e\u0917\u0930 \u092f\u0939 \u0938\u091a \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0905\u0938\u0932 \u092e\u0947\u0902, 73% \u092f\u0942\u091c\u0930\u094d\u0938 \u090f\u0921\u094d\u0938 \u0938\u0947 \u0907\u0924\u0928\u0947 \u092a\u0930\u0947\u0936\u093e\u0928 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0910\u092a \u0915\u094b \u0939\u0940 \u0921\u093f\u0932\u0940\u091f \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u092e\u0928\u0947 \u0916\u0941\u0926 \u0926\u0947\u0916\u093e: \u0906\u092a\u0915\u0947 \u091c\u0948\u0938\u0947 \u0932\u094b\u0917, \u091c\u094b \u0939\u0930 \u0926\u093f\u0928 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u092c\u0940\u091a \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u092e\u0947\u0902 \u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u090f\u0921\u094d\u0938 \u0938\u0947 \u0924\u0902\u0917 \u0906\u0915\u0930 \u0910\u092a \u0939\u0940 \u091b\u094b\u0921\u093c \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0915\u094b\u0908 \u091c\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u092a\u0941\u0930\u093e\u0928\u0940 \u0938\u094b\u091a \u0939\u0948 \u091c\u093f\u0938\u0947 \u0924\u094b\u0921\u093c\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964",
    "\u0939\u092e\u0928\u0947 \u0935\u0939\u0940 \u0915\u093f\u092f\u093e \u091c\u094b \u0915\u094b\u0908 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e: \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u090f\u0921-\u092b\u094d\u0930\u0940 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f\u0930 \u092c\u0928\u093e\u092f\u093e\u0964 \u0915\u094b\u0908 \u0907\u0902\u091f\u0930\u0938\u094d\u091f\u0940\u0936\u093f\u092f\u0932 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0928\u093e\u0917 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u090f\u0915 \u0938\u094d\u0932\u093e\u0907\u0921\u0930, \u090f\u0915 EQ, \u0914\u0930 +200% \u092c\u0942\u0938\u094d\u091f\u0964 \u092f\u0939 \u0938\u091a \u0939\u0948\u2014\u0939\u092e\u0928\u0947 \u0907\u0938\u0915\u093e \u092a\u094d\u0930\u0942\u092b \u0926\u093f\u092f\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u0947 \u092b\u094d\u0930\u0940 \u0935\u0930\u094d\u091c\u0928 \u0915\u0947 \u092f\u0942\u091c\u0930\u094d\u0938 \u0928\u0947 \u0916\u0941\u0926 \u0915\u0939\u093e, '\u092c\u0938 \u090f\u0921\u094d\u0938 \u0939\u091f\u093e \u0926\u094b, \u0914\u0930 \u092e\u0948\u0902 \u092a\u0948\u0938\u0947 \u0926\u0942\u0902\u0917\u093e\u0964' \u0907\u0938\u0932\u093f\u090f \u0939\u092e\u0928\u0947 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092c\u0928\u093e\u092f\u093e, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u091d\u0902\u091d\u091f \u0915\u0947\u0964",
    "\u0905\u092c \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u092e\u094c\u0915\u093e \u0939\u0948: \u0935\u0939\u0940 \u0926\u092e\u0926\u093e\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u092c\u0940\u091a \u0915\u0947 \u0930\u0941\u0915\u093e\u0935\u091f \u0915\u0947\u0964 \u0910\u092a \u0915\u094b \u0916\u094b\u0932\u0947\u0902, \u0939\u0947\u0921\u092b\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902, \u0914\u0930 \u092f\u0939 \u0911\u091f\u094b-\u0905\u092a\u094d\u0932\u093e\u0908 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u2014\u091a\u093e\u0939\u0947 \u0906\u092a Spotify \u092a\u0930 \u0939\u094b\u0902, YouTube \u092a\u0930, \u092f\u093e \u0917\u0947\u092e \u0916\u0947\u0932 \u0930\u0939\u0947 \u0939\u094b\u0902\u0964 \u0915\u094b\u0908 \u092c\u094d\u0932\u094b\u091f \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0917\u0947\u092e\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u090f\u0915 \u0936\u093e\u0902\u0924, \u092d\u0930\u094b\u0938\u0947\u092e\u0902\u0926 \u091f\u0942\u0932, \u091c\u0948\u0938\u0947 \u0906\u092a\u0915\u093e \u0905\u0932\u093e\u0930\u094d\u092e \u0915\u092d\u0940 \u0939\u0941\u0906 \u0915\u0930\u0924\u093e \u0925\u093e\u0964",
    "\u0905\u092c \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0930\u0947\u0902: \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0915\u093e 7-\u0926\u093f\u0928 \u0915\u093e \u092b\u094d\u0930\u0940 \u091f\u094d\u0930\u093e\u092f\u0932 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0964 \u092a\u0940.\u090f\u0938. \u092f\u093e\u0926 \u0930\u0916\u0947\u0902\u2014\u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0906\u092a \u0915\u094b\u0908 \u090f\u0921 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0915\u094b\u0908 \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0935\u093e\u0908 \u0915\u093e \u092b\u093e\u092f\u0926\u093e \u0909\u0920\u093e \u0930\u0939\u093e \u0939\u0948\u0964 \u0939\u092e \u0910\u0938\u093e \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964"
  ],
