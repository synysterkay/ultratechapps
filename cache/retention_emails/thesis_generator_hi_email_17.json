{
  "subject": "3 \u092e\u093f\u0928\u091f \u0915\u0940 \u0930\u0942\u091f\u0940\u0928 \u091c\u094b \u0906\u092a\u0915\u0940 \u0925\u0940\u0938\u093f\u0938 \u092c\u0926\u0932 \u0926\u0947\u0917\u0940",
  "preview_text": "\u0935\u094b \u091b\u094b\u091f\u0940 \u0938\u0940 \u0906\u0926\u0924 \u091c\u094b 50,000 \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0915\u094b A- \u0924\u0915 \u0932\u0947 \u0917\u0908\u0964 \u0906\u091c \u0939\u0940 \u0906\u091c\u093c\u092e\u093e\u090f\u0902\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u094b \u0930\u093e\u0924 \u091c\u092c \u0906\u092a \u0916\u093e\u0932\u0940 \u092a\u0947\u091c \u0915\u094b \u0918\u0942\u0930 \u0930\u0939\u0947 \u0925\u0947 \u0914\u0930 \u0926\u093f\u092e\u093e\u0917 \u092e\u0947\u0902 \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0906 \u0930\u0939\u093e \u0925\u093e? \u092e\u0948\u0902\u0928\u0947 \u092d\u0940 \u0935\u0939\u0940 \u091d\u0947\u0932\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 3-\u092e\u093f\u0928\u091f \u0915\u0940 \u0930\u0942\u091f\u0940\u0928 \u092c\u0928\u093e\u0908 \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964",
    "\u0939\u0930 \u0938\u0941\u092c\u0939, \u0905\u092a\u0928\u093e \u092b\u094b\u0928 \u0909\u0920\u093e\u090f\u0902, Thesis Generator \u0916\u094b\u0932\u0947\u0902, \u0914\u0930 \u0938\u093f\u0930\u094d\u092b 3 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u090f\u0915 thesis statement \u091f\u093e\u0907\u092a \u0915\u0930\u0947\u0902\u0964 \u092f\u0947 \u0907\u0924\u0928\u093e \u091b\u094b\u091f\u093e \u0939\u0948 \u0915\u093f \u0906\u092a \u0907\u0938\u0947 \u092e\u093f\u0938 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0947\u0964 30 \u0926\u093f\u0928 \u092c\u093e\u0926, \u092f\u0947 \u0906\u0926\u0924 \u092c\u0928 \u091c\u093e\u0924\u0940 \u0939\u0948 \u2014 \u0914\u0930 \u0906\u092a\u0915\u093e \u0917\u094d\u0930\u0947\u0921 B+ \u0938\u0947 A- \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u0939\u092e\u093e\u0930\u093e 'Quick Thesis' \u092b\u0940\u091a\u0930 \u0920\u0940\u0915 \u0907\u0938\u0940 \u0915\u0947 \u0932\u093f\u090f \u092c\u0928\u093e \u0939\u0948\u0964 \u092c\u0938 \u0905\u092a\u0928\u093e \u091f\u0949\u092a\u093f\u0915 \u0921\u093e\u0932\u0947\u0902, \u0914\u0930 10 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0906\u092a\u0915\u094b 3 \u0924\u0948\u092f\u093e\u0930 thesis statements \u092e\u093f\u0932 \u091c\u093e\u090f\u0902\u0917\u0947\u0964 \u092b\u093f\u0930 \u0906\u092a \u091c\u094b \u091a\u093e\u0939\u0947\u0902, \u090f\u0921\u093f\u091f \u0915\u0930\u0947\u0902 \u092f\u093e \u0938\u0940\u0927\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0947\u0902\u0964 \u092f\u0947 \u0935\u094b \u0930\u0942\u091f\u0940\u0928 \u0939\u0948 \u091c\u094b 50,000 \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0915\u094b \u0915\u093e\u092e \u0906\u0908 \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 'Quick Thesis' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u0938\u093f\u0930\u094d\u092b 3 \u092e\u093f\u0928\u091f \u0926\u0940\u091c\u093f\u090f \u2014 \u0906\u092a \u0916\u0941\u0926 \u0926\u0947\u0916\u0947\u0902\u0917\u0947 \u092b\u0930\u094d\u0915\u0964 \u092a\u0940.\u090f\u0938. \u2014 \u0905\u0917\u0930 \u0906\u092a\u0928\u0947 \u0915\u0932 \u092d\u0940 \u0910\u0938\u093e \u0915\u093f\u092f\u093e, \u0924\u094b \u0906\u092a\u0915\u0940 \u092a\u0942\u0930\u0940 \u0925\u0940\u0938\u093f\u0938 \u090f\u0915 \u0939\u092b\u094d\u0924\u0947 \u092e\u0947\u0902 \u0924\u0948\u092f\u093e\u0930 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u094b\u0964"
