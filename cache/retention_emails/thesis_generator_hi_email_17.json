{
  "subject": "\u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0910\u092a \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092c\u0921\u093c\u0940 \u0917\u0932\u0924\u0940 \u0915\u0940",
  "preview_text": "90% \u092f\u0942\u091c\u0930\u094d\u0938 \u092f\u0939 3 \u092e\u093f\u0928\u091f \u0915\u093e \u0930\u0942\u091f\u0940\u0928 \u091b\u094b\u0921\u093c \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u092f\u0939 \u0906\u092a\u0915\u0947 \u092a\u0947\u092a\u0930 \u0915\u094b 10x \u092c\u0947\u0939\u0924\u0930 \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964 \u092a\u0922\u093c\u093f\u090f \u0915\u094d\u092f\u094b\u0902\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u0939 \u0926\u093f\u0928 \u091c\u092c \u0924\u0941\u092e \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930 \u0916\u094b\u0932\u0947 \u0925\u0947? \u092e\u0941\u091d\u0947 \u092a\u0924\u093e \u0939\u0948 \u0924\u0941\u092e \u0938\u094b\u091a \u0930\u0939\u0947 \u0925\u0947, '\u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930 \u0932\u0942\u0902, \u0915\u094d\u092f\u093e \u0939\u094b\u0917\u093e\u0964' \u0932\u0947\u0915\u093f\u0928 \u0938\u091a \u092f\u0939 \u0939\u0948 \u0915\u093f \u0907\u0938 \u0910\u092a \u0915\u093e \u0905\u0938\u0932\u0940 \u091c\u093e\u0926\u0942 \u0924\u092c \u0906\u0924\u093e \u0939\u0948 \u091c\u092c \u0924\u0941\u092e \u0907\u0938\u0947 \u0939\u0930 \u0926\u093f\u0928 \u0938\u093f\u0930\u094d\u092b 3 \u092e\u093f\u0928\u091f \u0926\u0947\u0924\u0947 \u0939\u094b\u0964 \u092e\u0948\u0902\u0928\u0947 \u092d\u0940 \u092a\u0939\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u0924\u0915 \u0907\u0938\u0947 \u0905\u0928\u0926\u0947\u0916\u093e \u0915\u093f\u092f\u093e, \u092b\u093f\u0930 \u090f\u0915 \u0930\u093e\u0924 deadline \u0938\u0947 \u092a\u0939\u0932\u0947 \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e, '\u091a\u0932\u094b \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902\u0964'",
    "\u0909\u0938 \u0930\u093e\u0924 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u0930\u0942\u091f\u0940\u0928 \u092c\u0928\u093e\u092f\u093e: \u0939\u0930 \u0938\u0941\u092c\u0939 \u0909\u0920\u0924\u0947 \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u0928\u093e, \u0905\u092a\u0928\u0947 \u092a\u0947\u092a\u0930 \u0915\u093e \u090f\u0915 \u0938\u0935\u093e\u0932 \u091f\u093e\u0907\u092a \u0915\u0930\u0928\u093e, \u0914\u0930 'Generate Thesis' \u092c\u091f\u0928 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0928\u093e\u0964 \u0935\u0939 \u0938\u093f\u0930\u094d\u092b 3 \u092e\u093f\u0928\u091f \u0915\u093e \u0915\u093e\u092e \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u0939\u092b\u094d\u0924\u0947 \u092e\u0947\u0902 \u092e\u0947\u0930\u093e \u092a\u0942\u0930\u093e \u092a\u0947\u092a\u0930 \u0924\u0948\u092f\u093e\u0930 \u0925\u093e\u0964 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 deadline panic \u0915\u0947\u0964 \u0914\u0930 \u0917\u094d\u0930\u0947\u0921? A- \u0938\u0947 \u092c\u0922\u093c\u0915\u0930 A \u0939\u094b \u0917\u092f\u093e\u0964 \u0905\u092c \u092e\u0948\u0902 \u0907\u0938\u0947 \u0905\u092a\u0928\u0947 \u0926\u093f\u0928 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092c\u0928\u093e \u091a\u0941\u0915\u093e \u0939\u0942\u0902\u0964",
    "\u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0936\u093e\u092f\u0926 \u092a\u0924\u093e \u0928 \u0939\u094b, \u0932\u0947\u0915\u093f\u0928 \u0907\u0938 \u0910\u092a \u0915\u093e 'Daily Thesis Prompt' \u092b\u0940\u091a\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0939\u0940 \u092c\u0928\u093e \u0939\u0948\u0964 \u092c\u0938 \u0924\u0940\u0928 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u090f\u0915 \u0938\u0935\u093e\u0932 \u0921\u093e\u0932\u094b, \u0914\u0930 \u0910\u092a \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u090f\u0915 \u092a\u0942\u0930\u093e thesis statement, citations \u0915\u0947 \u0938\u093e\u0925, \u0926\u0947 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0932\u093f\u0916\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924 \u0915\u094b \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964 \u0915\u094b\u0908 \u0914\u0930 \u091a\u0940\u091c \u0928\u0939\u0940\u0902, \u092c\u0938 \u092f\u0939 \u090f\u0915 \u0930\u0942\u091f\u0940\u0928\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 'Daily Thesis Prompt' \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u094b\u0964 \u0938\u093f\u0930\u094d\u092b \u0924\u0940\u0928 \u092e\u093f\u0928\u091f\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u0947\u092a\u0930 \u092c\u091a\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 P.S. \u0905\u0917\u0930 \u0924\u0941\u092e\u0928\u0947 \u092f\u0939 \u0915\u0932 \u0930\u093e\u0924 \u0915\u093f\u092f\u093e \u0939\u094b\u0924\u093e, \u0924\u094b \u0906\u091c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u0939\u0932\u093e \u092a\u0948\u0930\u093e\u0917\u094d\u0930\u093e\u092b \u0924\u0948\u092f\u093e\u0930 \u0939\u094b\u0924\u093e\u0964"
  ],
