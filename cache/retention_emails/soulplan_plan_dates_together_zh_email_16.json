{
  "subject": "\u6211\u505a\u4e86\u4e00\u4e2a\u989d\u5916\u7684\u4e1c\u897f\u7ed9\u4f60",
  "preview_text": "\u672c\u6765\u6ca1\u6253\u7b97\u5206\u4eab\u8fd9\u4e2a\uff0c\u4f46\u4f60\u662f\u7b2c\u4e00\u6279\u3002\u6253\u5f00\u770b\u770b\uff0c\u4eca\u665a\u5c31\u80fd\u7528\u3002",
  "body_paragraphs": [
    "\u4e0a\u5468\u51cc\u6668\u4e09\u70b9\uff0c\u6211\u76ef\u7740\u5c4f\u5e55\uff0c\u7a81\u7136\u6709\u4e2a\u5ff5\u5934\u2014\u2014\u6211\u4eec\u505a\u4e86\u8fd9\u4e48\u591a\u529f\u80fd\uff0c\u4f46\u5c11\u4e86\u4e00\u4e2a\u771f\u6b63\u5c5e\u4e8e\u4f60\u4eec\u4e24\u4e2a\u4eba\u7684\u77ac\u95f4\u3002\u4e0d\u662f\u63a8\u9001\uff0c\u4e0d\u662f\u901a\u77e5\uff0c\u662f\u4f60\u6253\u5f00app\u65f6\uff0c\u5979/\u4ed6\u5077\u5077\u4e3a\u4f60\u51c6\u5907\u7684\u4e00\u4e2a\u5c0f\u60ca\u559c\u3002\u6211\u71ac\u4e86\u4e24\u665a\uff0c\u628a\u5b83\u505a\u51fa\u6765\u4e86\uff0c\u672c\u6765\u60f3\u85cf\u5230\u4e0b\u4e2a\u7248\u672c\uff0c\u4f46\u60f3\u4e86\u60f3\uff0c\u4f60\u503c\u5f97\u5148\u8bd5\u8bd5\u3002",
    "\u4f60\u4e0d\u662f\u90a3\u4e2a\u4f1a\u8ba9\u6d6a\u6f2b\u53d8\u6210\u4efb\u52a1\u7684\u4eba\u3002\u4f60\u4e0b\u8f7dSoulPlan\uff0c\u662f\u56e0\u4e3a\u4f60\u60f3\u8ba9\u6bcf\u4e00\u6b21\u7ea6\u4f1a\u90fd\u6709\u6e29\u5ea6\uff0c\u800c\u4e0d\u662f\u91cd\u590d\u6628\u5929\u7684\u5957\u8def\u3002\u4f46\u73b0\u5b9e\u662f\u2014\u2014\u4f60\u5fd9\u4e86\u4e00\u5929\uff0c\u6253\u5f00app\uff0c\u770b\u5230\u4e00\u5806\u9009\u9879\uff0c\u53cd\u800c\u89c9\u5f97\u7d2f\u3002\u4f60\u4e0d\u60f3\u8981\u66f4\u591a\u7684\u9009\u62e9\uff0c\u4f60\u60f3\u8981\u4e00\u4e2a\u786e\u5b9a\u7684\u611f\u89c9\uff1a\u4eca\u665a\uff0c\u6709\u4eba\u4e3a\u4f60\u51c6\u5907\u597d\u4e86\u3002",
    "\u6240\u4ee5\u6211\u5728\u2018\u4eca\u665a\u7ea6\u4f1a\u2019\u5361\u7247\u540e\u9762\u52a0\u4e86\u4e00\u4e2a\u9690\u85cf\u5165\u53e3\u3002\u4efb\u610f\u9009\u62e9\u5fc3\u60c5\u6a21\u5f0f\u540e\uff0c\u4f1a\u5f39\u51fa\u4e00\u4e2a\u2018\u4e3a\u5bf9\u65b9\u51c6\u5907\u4e00\u4e2a\u60ca\u559c\u2019\u7684\u6309\u94ae\u3002\u70b9\u4e00\u4e0b\uff0c\u4e0d\u51fa\u4e94\u79d2\uff0c\u5bf9\u65b9\u4f1a\u5728\u624b\u673a\u5c4f\u5e55\u4e0a\u770b\u5230\u4f60\u7279\u610f\u6311\u9009\u7684\u8ff7\u4f60\u7ea6\u4f1a\u2014\u2014\u4e00\u4e2a\u82b1\u4e09\u5206\u949f\u5c31\u80fd\u5b8c\u6210\u7684\u5c0f\u4e92\u52a8\uff0c\u6bd4\u5982\u4e00\u8d77\u542c\u4e00\u9996\u6b4c\u3001\u53d1\u4e00\u5f20\u65e7\u7167\u7247\u3001\u6216\u8005\u5199\u4e00\u53e5\u6084\u6084\u8bdd\u3002\u6ca1\u6709\u89c4\u5212\u538b\u529b\uff0c\u53ea\u6709\u2018\u4f60\u60f3\u5230\u6211\u4e86\u2019\u7684\u6e29\u6696\u3002",
    "\u73b0\u5728\u5c31\u53bb\u8bd5\u8bd5\u5427\u3002\u6253\u5f00app\uff0c\u9009\u4e00\u4e2a\u5fc3\u60c5\u6a21\u5f0f\uff0c\u7136\u540e\u770b\u90a3\u4e2a\u60ca\u559c\u6309\u94ae\u6709\u6ca1\u6709\u51fa\u73b0\u3002\u4f60\u53ef\u80fd\u4f1a\u53d1\u73b0\uff0c\u5979/\u4ed6\u5df2\u7ecf\u4e3a\u4f60\u7559\u4e86\u4e00\u4e2a\u3002P.S. \u8fd9\u4e2a\u529f\u80fd\u53ea\u4fdd\u7559\u4e03\u5929\uff0c\u4e4b\u540e\u4f1a\u6d88\u5931\u3002\u5982\u679c\u4f60\u559c\u6b22\uff0c\u544a\u8bc9\u6211\uff0c\u6211\u4f1a\u8ba9\u5b83\u4e00\u76f4\u7559\u7740\u3002"
  ],
