{
  "subject": "\u042f \u0437\u0456\u0437\u043d\u0430\u044e\u0441\u044f: \u044f \u043f\u043e\u043c\u0438\u043b\u0438\u043b\u0430\u0441\u044f \u0437 \u0446\u0438\u043c \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u043c",
  "preview_text": "\u0421\u0435\u043a\u0440\u0435\u0442, \u044f\u043a\u0438\u0439 90% \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u044e\u0442\u044c. \u0412\u0456\u0434\u043a\u0440\u0438\u0439 \u0456 \u0434\u0456\u0437\u043d\u0430\u0439\u0441\u044f, \u044f\u043a \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u043f\u0435\u0440\u0435\u0432\u0430\u0433\u0443 \u0432\u0436\u0435 \u0437\u0430 30 \u0441\u0435\u043a\u0443\u043d\u0434.",
  "body_paragraphs": [
    "\u0417\u043d\u0430\u0454\u0448, \u043a\u043e\u043b\u0438 \u0434\u0438\u0432\u0438\u0448\u0441\u044f \u043c\u0430\u0442\u0447 \u0456 \u0434\u0443\u043c\u0430\u0454\u0448: \"\u042f \u0436 \u0437\u043d\u0430\u0432, \u0449\u043e \u0442\u0430\u043a \u0431\u0443\u0434\u0435\", \u0430\u043b\u0435 \u043d\u0435 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0432 \u0433\u0440\u043e\u0448\u0456 \u0447\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u0432\u0433\u0430\u0434\u0430\u0432 \u0440\u0430\u0445\u0443\u043d\u043e\u043a? \u042f \u0442\u0435\u0436 \u0442\u0430\u043a \u0440\u043e\u0431\u0438\u0432. \u0410 \u043f\u043e\u0442\u0456\u043c \u044f \u0437\u043d\u0430\u0439\u0448\u043e\u0432 \u043e\u0434\u043d\u0443 \u0440\u0456\u0447 \u0443 Predictify, \u044f\u043a\u0430 \u0437\u043c\u0456\u043d\u0438\u043b\u0430 \u0432\u0441\u0435. \u0406 \u0446\u0435 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0447\u0435\u0440\u0433\u043e\u0432\u0438\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u2014 \u0446\u0435 \u0442\u0435, \u0449\u043e \u043f\u0440\u0430\u0446\u044e\u0454 \u0437\u0430 30 \u0441\u0435\u043a\u0443\u043d\u0434.",
    "\u0421\u043b\u0443\u0445\u0430\u0439, \u044f \u043d\u0435 \u043b\u044e\u0431\u043b\u044e \u0434\u043e\u0432\u0433\u0456 \u0456\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0456\u0457. \u0422\u043e\u043c\u0443 \u043e\u0434\u0440\u0430\u0437\u0443 \u0434\u043e \u0441\u043f\u0440\u0430\u0432\u0438: \u0432\u0456\u0434\u043a\u0440\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0456 \u0437\u043d\u0430\u0439\u0434\u0438 \u0440\u043e\u0437\u0434\u0456\u043b \"\u041f\u0440\u043e\u0433\u043d\u043e\u0437 \u0434\u043d\u044f\" (POTD). \u0422\u0430\u043c AI \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0454 \u0442\u0438\u0441\u044f\u0447\u0456 \u0437\u043c\u0456\u043d\u043d\u0438\u0445 \u2014 \u0432\u043e\u043b\u043e\u0434\u0456\u043d\u043d\u044f \u043c'\u044f\u0447\u0435\u043c, xG, \u0441\u0438\u043b\u0443 \u0430\u0442\u0430\u043a\u0438, \u0456\u0441\u0442\u043e\u0440\u0456\u044e \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0435\u0439 \u2014 \u0456 \u0432\u0438\u0434\u0430\u0454 \u0442\u043e\u0447\u043d\u0438\u0439 \u0440\u0430\u0445\u0443\u043d\u043e\u043a \u0456\u0437 \u0440\u0456\u0432\u043d\u0435\u043c \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u043e\u0441\u0442\u0456. \u0422\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0438\u0432\u0438\u0448\u0441\u044f \u0456 \u0431\u0430\u0447\u0438\u0448, \u0447\u0438 \u0432\u0430\u0440\u0442\u043e \u0434\u043e\u0432\u0456\u0440\u044f\u0442\u0438 \u0441\u0432\u043e\u0457\u0439 \u0456\u043d\u0442\u0443\u0457\u0446\u0456\u0457.",
    "\u0423\u044f\u0432\u0456\u0442\u044c: \u0432\u0438 \u0437\u0430\u0445\u043e\u0434\u0438\u0442\u0435 \u0432 \u0447\u0430\u0442 \u0456\u0437 \u0434\u0440\u0443\u0437\u044f\u043c\u0438, \u0430 \u0432\u043e\u043d\u0438 \u0441\u043f\u0435\u0440\u0435\u0447\u0430\u044e\u0442\u044c\u0441\u044f, \u0445\u0442\u043e \u0432\u0438\u0433\u0440\u0430\u0454. \u0410 \u0432\u0438 \u0434\u0456\u0441\u0442\u0430\u0454\u0442\u0435 \u0442\u0435\u043b\u0435\u0444\u043e\u043d, \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454\u0442\u0435 \u0446\u0435\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437, \u0456 \u043a\u0430\u0436\u0435\u0442\u0435: \"AI \u043a\u0430\u0436\u0435 2:1 \u043d\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u044c \u0411\u0430\u0440\u0441\u0438 \u0437 \u0443\u043f\u0435\u0432\u043d\u0435\u043d\u0456\u0441\u0442\u044e 78%\". \u0406 \u0432\u0441\u0456 \u0437\u0430\u043c\u043e\u0432\u043a\u0430\u044e\u0442\u044c. \u0421\u0430\u043c\u0435 \u0446\u0435 \u044f \u043c\u0430\u044e \u043d\u0430 \u0443\u0432\u0430\u0437\u0456, \u043a\u043e\u043b\u0438 \u043a\u0430\u0436\u0443 \"\u0431\u0443\u0442\u0438 \u043d\u0430\u0439\u0440\u043e\u0437\u0443\u043c\u043d\u0456\u0448\u0438\u043c \u0444\u0430\u043d\u0430\u0442\u043e\u043c \u0443 \u043a\u0456\u043c\u043d\u0430\u0442\u0456\".",
    "\u0417\u0430\u0440\u0430\u0437 \u0432\u0456\u0434\u043a\u0440\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0456 \u043f\u0435\u0440\u0435\u0432\u0456\u0440 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u043d\u0430 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456\u0448\u043d\u0456\u0439 \u043c\u0430\u0442\u0447. \u0426\u0435 \u0437\u0430\u0439\u043c\u0435 \u043c\u0435\u043d\u0448\u0435 \u0445\u0432\u0438\u043b\u0438\u043d\u0438. \u0410 \u043f\u043e\u0442\u0456\u043c \u043d\u0430\u043f\u0438\u0448\u0438 \u043c\u0435\u043d\u0456, \u0447\u0438 \u0432\u0433\u0430\u0434\u0430\u0432 AI.\n\nP.S. \u0414\u043e \u0440\u0435\u0447\u0456, \u0432 \u0440\u043e\u0437\u0434\u0456\u043b\u0456 \"\u0421\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0438\" \u0454 \u0433\u0440\u0443\u043f\u0430, \u0434\u0435 \u0444\u0430\u043d\u0430\u0442\u0438 \u043e\u0431\u0433\u043e\u0432\u043e\u0440\u044e\u044e\u0442\u044c \u0446\u0456 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438. \u041f\u0440\u0438\u0454\u0434\u043d\u0443\u0439\u0441\u044f \u2014 \u0442\u0430\u043c \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u0433\u0430\u0440\u044f\u0447\u0435."
  ],
