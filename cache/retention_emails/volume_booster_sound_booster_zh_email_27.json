{
  "subject": "\u6211\u4eec\u5206\u6790\u4e861\u4e07\u7528\u6237\uff0c\u53d1\u73b0\u4e00\u4e2a\u81f4\u547d\u9519\u8bef",
  "preview_text": "90%\u7684\u4eba\u90fd\u5728\u6d6a\u8d39\u8fd9\u4e2a\u529f\u80fd\uff0c\u4f60\u7684\u97f3\u9891\u8d28\u91cf\u53ef\u80fd\u56e0\u6b64\u51cf\u534a\u3002\u7acb\u5373\u67e5\u770b\u771f\u76f8\u3002",
  "body_paragraphs": [
    "\u8bf4\u5b9e\u8bdd\uff0c\u6211\u72b9\u8c6b\u4e86\u5f88\u4e45\u8981\u4e0d\u8981\u53d1\u8fd9\u5c01\u90ae\u4ef6\u3002\u56e0\u4e3a\u6570\u636e\u592a\u60ca\u4eba\u4e86\uff0c\u751a\u81f3\u53ef\u80fd\u8ba9\u4f60\u91cd\u65b0\u5ba1\u89c6\u81ea\u5df1\u4f7f\u7528\u97f3\u9891\u7684\u65b9\u5f0f\u3002\u6211\u4eec\u521a\u521a\u5b8c\u6210\u4e86\u4e00\u9879\u5185\u90e8\u7814\u7a76\uff0c\u5206\u6790\u4e86\u8d85\u8fc71\u4e07\u540d\u6d3b\u8dc3\u7528\u6237\u7684\u8c03\u97f3\u4e60\u60ef\u3002",
    "\u7ed3\u679c\u53d1\u73b0\uff1a\u8d85\u8fc790%\u7684\u7528\u6237\u4ece\u672a\u8c03\u6574\u8fc7\u5747\u8861\u5668\u9884\u8bbe\u3002\u4ed6\u4eec\u53ea\u7528\u4e86\u97f3\u91cf\u589e\u5f3a\uff0c\u5374\u5b8c\u5168\u5ffd\u7565\u4e86\u97f3\u8d28\u4f18\u5316\u7684\u5de8\u5927\u6f5c\u529b\u3002\u8fd9\u610f\u5473\u7740\uff0c\u5927\u591a\u6570\u4eba\u53ea\u89e3\u9501\u4e86\u8fd9\u6b3e\u5e94\u7528\u4e00\u534a\u7684\u80fd\u529b\u2014\u2014\u58f0\u97f3\u5927\u4e86\uff0c\u4f46\u7ec6\u8282\u3001\u5c42\u6b21\u611f\u548c\u6c89\u6d78\u611f\u90fd\u6253\u4e86\u6298\u6263\u3002",
    "\u8fd9\u5c31\u50cf\u4e70\u4e86\u4e00\u8f86\u8dd1\u8f66\u5374\u6c38\u8fdc\u53ea\u7528\u4e00\u6863\u884c\u9a76\u3002\u5185\u7f6e\u7684\u5747\u8861\u5668\u9884\u8bbe\uff08\u6d41\u884c\u3001\u6447\u6eda\u3001\u7235\u58eb\u3001\u7535\u5b50\u3001\u53e4\u5178\uff09\u4e0d\u662f\u6446\u8bbe\uff0c\u5b83\u4eec\u662f\u9488\u5bf9\u4e0d\u540c\u97f3\u9891\u5185\u5bb9\u4f18\u5316\u8fc7\u7684\u201c\u97f3\u8d28\u5bc6\u94a5\u201d\u3002\u7279\u522b\u662f\u201c\u7535\u5b50\u201d\u548c\u201c\u6447\u6eda\u201d\u9884\u8bbe\uff0c\u80fd\u77ac\u95f4\u6fc0\u6d3b\u4f60\u97f3\u4e50\u4e2d\u88ab\u7cfb\u7edf\u538b\u7f29\u6389\u7684\u4f4e\u9891\u7ec6\u8282\u3002",
    "\u4eca\u5929\uff0c\u5c31\u82b130\u79d2\u3002\u6253\u5f00\u5e94\u7528\uff0c\u522b\u6025\u7740\u62c9\u97f3\u91cf\u6761\uff0c\u5148\u70b9\u5f00\u5747\u8861\u5668\uff0c\u9009\u4e00\u4e2a\u7b26\u5408\u4f60\u6b63\u5728\u542c\u7684\u5185\u5bb9\u7c7b\u578b\u7684\u9884\u8bbe\u3002\u7136\u540e\u544a\u8bc9\u6211\uff0c\u662f\u4e0d\u662f\u611f\u89c9\u50cf\u6362\u4e86\u4e00\u526f\u8033\u6735\u3002P.S. \u4e00\u4f4d\u4ed8\u8d39\u7528\u6237\u544a\u8bc9\u6211\uff0c\u7528\u4e86\u201c\u53e4\u5178\u201d\u9884\u8bbe\u542c\u64ad\u5ba2\u540e\uff0c\u4ed6\u518d\u4e5f\u6ca1\u6f0f\u6389\u8fc7\u4efb\u4f55\u4e00\u4e2a\u6c14\u53e3\u548c\u7ec6\u5fae\u60c5\u7eea\uff0c\u8fd9\u6539\u53d8\u4e86\u4ed6\u901a\u52e4\u7684\u6574\u4e2a\u4f53\u9a8c\u3002",
    "\u7acb\u5373\u6253\u5f00\u5747\u8861\u5668"
  ],
