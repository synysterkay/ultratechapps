{
  "subject": "\u6211\u4eec\u5206\u6790\u4e8610000\u540d\u7528\u6237\uff0c\u53d1\u73b0\u4e86\u4e00\u4e2a\u60ca\u4eba\u4e8b\u5b9e",
  "preview_text": "\u4f60\u60f3\u8c61\u4e0d\u5230\uff0c\u4ed6\u4eec\u7684\u624b\u673a\u97f3\u91cf\u7adf\u7136\u6bd4\u4f60\u7684\u9ad8200%\u2014\u2014\u800c\u4e14\u53ea\u505a\u4e86\u4e00\u4ef6\u4e8b\u3002",
  "body_paragraphs": [
    "\u544a\u8bc9\u6211\uff0c\u4f60\u6709\u6ca1\u6709\u8fc7\u8fd9\u6837\u7684\u7ecf\u5386\uff1a\u5728\u5608\u6742\u7684\u5730\u94c1\u91cc\uff0c\u628a\u624b\u673a\u97f3\u91cf\u8c03\u5230\u6700\u5927\uff0c\u8fd8\u662f\u542c\u4e0d\u6e05\u64ad\u5ba2\u91cc\u7684\u6bcf\u4e00\u4e2a\u5b57\uff1f\u6216\u8005\uff0c\u5728\u542c\u4e00\u9996\u559c\u6b22\u7684\u6b4c\u65f6\uff0c\u603b\u89c9\u5f97\u5c11\u4e86\u70b9\u4ec0\u4e48\uff0c\u58f0\u97f3\u50cf\u8499\u4e86\u4e00\u5c42\u5e03\uff0c\u4f4e\u97f3\u5b8c\u5168\u51fa\u4e0d\u6765\uff1f",
    "\u6211\u4eec\u56e2\u961f\u6700\u8fd1\u5e72\u4e86\u4e00\u4ef6\u75af\u72c2\u7684\u4e8b\u2014\u2014\u5206\u6790\u4e8610000\u540d\u7528\u6237\u7684\u4f7f\u7528\u6570\u636e\uff0c\u7ed3\u679c\u8ba9\u6211\u4eec\u81ea\u5df1\u90fd\u5413\u4e86\u4e00\u8df3\u3002\u90a3\u4e9b\u6bcf\u5929\u6253\u5f00\u97f3\u91cf\u589e\u5f3a\u5668\u7684\u7528\u6237\uff0c\u5e73\u5747\u97f3\u91cf\u63d0\u5347\u4e86200%\u4ee5\u4e0a\u3002\u4f46\u6700\u5173\u952e\u7684\u53d1\u73b0\u662f\uff1a\u8d85\u8fc770%\u7684\u4eba\uff0c\u53ea\u7528\u4e86\u4e00\u6b21\u57fa\u7840\u529f\u80fd\u5c31\u79bb\u5f00\u4e86\uff0c\u5b8c\u5168\u9519\u8fc7\u4e86\u771f\u6b63\u8ba9\u624b\u673a\u8131\u80ce\u6362\u9aa8\u7684\u6838\u5fc3\u3002",
    "\u60f3\u8c61\u4e00\u4e0b\uff0c\u4f60\u624b\u673a\u4e0a\u6709\u4e2a\u9690\u85cf\u7684\u5f00\u5173\uff0c\u80fd\u4e00\u952e\u628a\u97f3\u91cf\u63a8\u5230\u7cfb\u7edf\u6781\u9650\u4e4b\u4e0a\uff0c\u540c\u65f6\u6fc0\u6d3b\u5185\u7f6e\u5747\u8861\u5668\uff0c\u7ed9\u4f60\u7684\u97f3\u4e50\u6ce8\u5165\u6f8e\u6e43\u4f4e\u97f3\u548c\u6e05\u6670\u9ad8\u97f3\u3002\u6ca1\u9519\uff0c\u8fd9\u5c31\u662f\u6211\u4eecApp\u91cc\u7684\u201c\u589e\u5f3a\u5668\u201d\u529f\u80fd\u3002\u5b83\u4e0d\u9700\u8981\u4f60\u61c2\u4efb\u4f55\u6280\u672f\uff0c\u53ea\u9700\u8981\u6253\u5f00App\uff0c\u70b9\u4e00\u4e0b\u90a3\u4e2a\u5927\u6309\u94ae\uff0c\u7136\u540e\u6234\u4e0a\u8033\u673a\u6216\u8005\u5916\u653e\uff0c\u6574\u4e2a\u4e16\u754c\u90fd\u4f1a\u53d8\u5f97\u54cd\u4eae\u800c\u9971\u6ee1\u3002",
    "\u73b0\u5728\uff0c\u6253\u5f00\u4f60\u7684\u97f3\u91cf\u589e\u5f3a\u5668\uff0c\u70b9\u51fb\u90a3\u4e2a\u201c\u589e\u5f3a\u5668\u201d\u6309\u94ae\uff0c\u542c\u4e00\u9996\u4f60\u6700\u559c\u6b22\u7684\u6b4c\u3002\u628a\u97f3\u91cf\u8c03\u5230\u4f60\u89c9\u5f97\u5408\u9002\u7684\u7a0b\u5ea6\uff0c\u7136\u540e\u544a\u8bc9\u6211\u2014\u2014\u662f\u4e0d\u662f\u50cf\u6362\u4e86\u4e00\u53f0\u65b0\u624b\u673a\uff1f\u5982\u679c\u4f60\u8fd8\u60f3\u66f4\u8fdb\u4e00\u6b65\uff0c\u8bd5\u8bd5\u201c\u5747\u8861\u5668\u201d\u91cc\u7684\u201c\u6447\u6eda\u201d\u6216\u201c\u7535\u5b50\u201d\u9884\u8bbe\uff0c\u4f60\u4f1a\u542c\u5230\u97f3\u4e50\u91cc\u4ece\u672a\u6ce8\u610f\u8fc7\u7684\u7ec6\u8282\u3002P.S. \u5982\u679c\u4f60\u5728\u6df1\u591c\u542c\u6b4c\uff0c\u8bb0\u5f97\u8c03\u4f4e\u4e00\u70b9\u2014\u2014\u522b\u5435\u9192\u90bb\u5c45\uff0c\u4f46\u628a\u90a3\u4f4e\u97f3\u4fdd\u7559\u7740\uff0c\u5b83\u4f1a\u8ba9\u4f60\u611f\u89c9\u50cf\u5750\u5728\u6f14\u5531\u4f1a\u524d\u6392\u3002"
  ],
  "cta_text": "\u6253\u5f00\u97f3\u91cf\u589e\u5f3a\u5668\uff0c\u8bd5\u4e00\u4e0b\u589e\u5f3a\u5668",
