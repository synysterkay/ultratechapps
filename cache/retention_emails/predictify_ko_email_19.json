{
  "subject": "\ub4dc\ub514\uc5b4 \uacf5\uac1c\ud569\ub2c8\ub2e4, \ub2f9\uc2e0\ub9cc\uc744 \uc704\ud55c \ube44\ubc00 \uae30\ub2a5",
  "preview_text": "\uc544\uc9c1 \uc544\ubb34\ub3c4 \ubaa8\ub974\ub294 \uc608\uce21\uc758 \uc0c8\ub85c\uc6b4 \uae30\uc900\uc744 \uba3c\uc800 \uc54c\ub824\ub4dc\ub9bd\ub2c8\ub2e4. \ub2f9\uc2e0\ub9cc\uc758 \ud2b9\uad8c\uc744 \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "\ucd95\uad6c \ud32c\uc774\ub77c\uba74 \ud55c \ubc88\ucbe4 \uafc8\uafd4\ubd24\uc744 \uac70\uc57c: '\ub0b4\uac00 \uacbd\uae30 \uc804\uc5d0 \ubaa8\ub4e0 \ub370\uc774\ud130\ub97c \uc54c \uc218 \uc788\ub2e4\uba74?' \ub4dc\ub514\uc5b4 \uadf8\uac8c \ud604\uc2e4\uc774 \ub41c\ub2e4. 42\uc77c \ub3d9\uc548 Predictify\ub97c \uc0ac\uc6a9\ud574\ubcf8 \ub2f9\uc2e0, \uc774\uc81c\ub294 \uc9c4\uc9dc \uace0\uc218\ub4e4\uc758 \uc601\uc5ed\uc73c\ub85c \ucd08\ub300\ud560 \uc2dc\uac04\uc774\uc57c. \uc6b0\ub9ac\uac00 \uc900\ube44\ud55c \ub2e4\uc74c \uc5c5\ub370\uc774\ud2b8\ub294 \ub2f9\uc2e0\uc758 \uc608\uce21\uc744 \uc644\uc804\ud788 \ubc14\uafd4\ub193\uc744 \uac70\uc57c.",
    "\uc9c0\uae08\uae4c\uc9c0 AI\uac00 \ubd84\uc11d\ud55c \uc218\ucc9c \uac1c\uc758 \ubcc0\uc218\uc640 50\uac1c \ub9ac\uadf8 \ub370\uc774\ud130\ub85c \uc2b9\ubd80\ub97c \uc608\uce21\ud588\ub2e4\uba74, \uc774\uc81c\ub294 \ub354 \uae4a\uc774 \ub4e4\uc5b4\uac04\ub2e4. \uc0c8\ub85c\uc6b4 '\uc804\uc220 \ubd84\uc11d \ub3c4\uad6c'\ub294 \uc0c1\ub300\ud300\uc758 \uc57d\uc810\uc744 \uc2e4\uc2dc\uac04\uc73c\ub85c \ud30c\ud5e4\uccd0, \ub2f9\uc2e0\uc758 \ubca0\ud305\uacfc \uc608\uce21\uc5d0 \ud655\uc2e0\uc744 \ub354\ud574\uc904 \uac70\uc57c. \uc774\uac74 \ub2e8\uc21c\ud55c \uc5c5\ub370\uc774\ud2b8\uac00 \uc544\ub2c8\ub77c, \ucd95\uad6c \uc9c0\uc2dd\uc758 \uc0c8\ub85c\uc6b4 \ucc28\uc6d0\uc774\uc57c. \ub2f9\uc2e0\uc774 \uac00\uc7a5 \uba3c\uc800 \uc54c\uac8c \ub41c \uac8c \uc790\ub791\uc2a4\ub7ec\uc6b8 \uc815\ub3c4\ub85c.",
    "\uace7 \uc571\uc5d0\uc11c 'AI \uc804\uc220 \ubcf4\ub4dc' \uae30\ub2a5\uc744 \ub9cc\ub098\ubcfc \uc218 \uc788\uc5b4. \uc0c1\ub300\ud300\uc758 \uc218\ube44 \ub77c\uc778, \uc810\uc720\uc728 \ud328\ud134, \uc138\ud2b8\ud53c\uc2a4 \uc804\ub7b5\uae4c\uc9c0 \ud55c\ub208\uc5d0 \ubd84\uc11d\ud558\uace0, \ub2f9\uc2e0\uc758 \uc608\uce21\uc5d0 \ubc18\uc601\ud574\ubd10. \uc774 \uae30\ub2a5\uc740 \ud504\ub9ac\ubbf8\uc5c4 \uc0ac\uc6a9\uc790\uc5d0\uac8c \uba3c\uc800 \uacf5\uac1c\ub420 \uc608\uc815\uc774\uc9c0\ub9cc, \uc624\ub298 \ubbf8\ub9ac \ub9db\ubcf4\uae30\ub97c \uc6d0\ud55c\ub2e4\uba74 \uc9c0\uae08 \uc571\uc5d0\uc11c 'AI \ucc44\ud305'\uc5d0 '\uc804\uc220 \ubd84\uc11d'\uc774\ub77c\uace0 \uc785\ub825\ud574\ubd10. \ub370\uc774\ud130 \uae30\ubc18 \ub2f5\ubcc0\uc774 \ubc14\ub85c \ub0a0\uc544\uc62c \uac70\uc57c.",
    "\uc9c0\uae08 Predictify\ub97c \uc5f4\uace0 'AI \ucc44\ud305' \uae30\ub2a5\uc5d0 '\ub808\uc54c \ub9c8\ub4dc\ub9ac\ub4dc\uc758 \ucd5c\uadfc \uc804\uc220 \uc57d\uc810'\uc774\ub77c\uace0 \ubb3c\uc5b4\ubd10. \ubb34\ub8cc\ub85c\ub3c4 \ub9db\ubcfc \uc218 \uc788\ub294 \ub370\uc774\ud130\uc758 \ud798\uc744 \ub290\uaef4\ubd10. P.S. \uc774 \uae30\ub2a5\uc740 \uc544\uc9c1 \ubca0\ud0c0\uc9c0\ub9cc, \ub2f9\uc2e0\uc774 \uba3c\uc800 \ud14c\uc2a4\ud2b8\ud574\ubcf4\uace0 \ud53c\ub4dc\ubc31\uc744 \uc8fc\uba74 \ud2b9\ubcc4 \ubcf4\uc0c1\uc744 \uc900\ube44\ud588\uc5b4. \ub193\uce58\uc9c0 \ub9c8."
  ],
