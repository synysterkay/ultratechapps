  "subject": "\ub2e4\uc74c \uc8fc \ud504\ub9ac\ubbf8\uc5b4\ub9ac\uadf8 \uc608\uce21, \ubbf8\ub9ac \ubcf4\uc168\ub098\uc694?",
  "preview_text": "\uc544\uc9c1 \uc544\ubb34\ub3c4 \ubaa8\ub974\ub294 \ub370\uc774\ud130 \uae30\ubc18 \ud504\ub9ac\ubdf0. Predictify\uc5d0\uc11c\ub9cc \uba3c\uc800 \uacf5\uac1c\ud569\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uc5b4\uc82f\ubc24, \uc6b0\ub9ac AI\uac00 500\uac1c \ubcc0\uc218\ub97c \ubd84\uc11d\ud558\ub2e4\uac00 \ucda9\uaca9\uc801\uc778 \ud328\ud134\uc744 \ubc1c\uacac\ud588\uc5b4. \ub9e8\uc2dc\ud2f0 vs \uc544\uc2a4\ub110, \ub2e4\uc74c \uc8fc \uc77c\uc694\uc77c \uacbd\uae30\uc778\ub370, \uc608\uc0c1 \ubc16\uc758 \uacb0\uacfc\uac00 \ub098\uc62c \ud655\ub960\uc774 \ubb34\ub824 73%\uc57c. \ub108\ub9cc \uc54c\uace0 \uc788\uc5b4. \uc544\uc9c1 \uacf5\uc2dd \ubc1c\ud45c \uc804\uc774\ub2c8\uae4c.",
    "\uc65c \uc774\ub7f0 \uc77c\uc774 \uc0dd\uae30\ub294\uc9c0 \uad81\uae08\ud558\uc9c0? \uc0ac\uc2e4, \uc6b0\ub9ac\uac00 \uc900\ube44 \uc911\uc778 'AI \uc804\ub7b5 \ub9ac\ud3ec\ud2b8' \uae30\ub2a5\uc774 \ubc14\ub85c \uc774\ub7f0 \uc228\uc740 \ud328\ud134\uc744 \uc7a1\uc544\ub0b4\uac70\ub4e0. \ub2e8\uc21c\ud55c \uc810\uc218 \uc608\uce21\uc744 \ub118\uc5b4, \uc120\uc218 \ubd80\uc0c1, \ucd5c\uadfc \ud3fc, \uc2ec\uc9c0\uc5b4 \uc6d0\uc815 \ubc84\uc2a4 \ub3c4\ucc29 \uc2dc\uac04\uae4c\uc9c0 \ubc18\uc601\ud55c \uc2e4\uc2dc\uac04 \uc778\uc0ac\uc774\ud2b8\uc57c. \ub2e4\ub978 \uc571\uc5d0\uc120 \uc808\ub300 \ubcfc \uc218 \uc5c6\uc5b4.",
    "\uc774 \uae30\ub2a5\uc740 \ub2e4\uc74c \uc8fc \uc5c5\ub370\uc774\ud2b8\ub85c \uc815\uc2dd \ucd9c\uc2dc\ub418\uc9c0\ub9cc, \uc624\ub298 \uba3c\uc800 \uccb4\ud5d8\ud574\ubcfc \uae30\ud68c\ub97c \uc904\uac8c. \uc571\uc5d0\uc11c '\ub2e4\uac00\uc624\ub294 \uacbd\uae30' \ud0ed\uc744 \uc5f4\uc5b4\ubd10. \uac70\uae30 \ubcf4\uc774\ub294 'AI \ud504\ub9ac\ubdf0' \ubc30\ub108\ub97c \ub204\ub974\uba74, \uc544\uc9c1 \uacf5\uac1c\ub418\uc9c0 \uc54a\uc740 \ubd84\uc11d\uc744 \ubbf8\ub9ac \ubcfc \uc218 \uc788\uc5b4. \ub2e8, \uc624\ub298 \ud558\ub8e8\ub9cc \uc720\ud6a8\ud574.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uc5b4\ubd10. 'AI \ud504\ub9ac\ubdf0'\uac00 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4. P.S. \uc774 \uba54\uc77c\uc744 \ubcf8 \uc0ac\ub78c \uc911 10%\ub9cc \uc2e4\uc81c\ub85c \uc5f4\uc5b4\ubcfc \uac70\uc57c. \ub108\ub294 \uadf8 10%\uc5d0 \uc18d\ud558\uae38 \ubc14\ub77c."
