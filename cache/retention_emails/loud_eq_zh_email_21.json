{
  "subject": "\u4f60\u79bb\u5f00\u768448\u5929\u91cc\uff0c\u6211\u4eec\u6539\u4e863\u4e2a\u4e1c\u897f",
  "preview_text": "\u4e0a\u6b21\u4f60\u6253\u5f00\u540e\uff0c\u6211\u4eec\u6084\u6084\u66f4\u65b0\u4e863\u4e2a\u529f\u80fd\u3002\u5176\u4e2d\u4e00\u4e2a\uff0c\u53ef\u80fd\u5c31\u662f\u4f60\u4e4b\u524d\u62b1\u6028\u7684\u95ee\u9898\u3002",
  "body_paragraphs": [
    "\u4f60\u8fd8\u8bb0\u5f97\u4e0a\u6b21\u5f00\u8f66\u65f6\uff0c\u628a\u97f3\u91cf\u8c03\u5230100%\uff0c\u8fd8\u662f\u542c\u4e0d\u6e05\u5bfc\u822a\u5417\uff1f\u90a3\u79cd\u611f\u89c9\uff0c\u6211\u61c2\u300248\u5929\u524d\u4f60\u4e0b\u8f7d\u4e86Loud EQ\uff0c\u7136\u540e\u53ef\u80fd\u89c9\u5f97\u2018\u5c31\u90a3\u6837\u5427\u2019\u2014\u2014\u4f46\u6709\u4e9b\u4e8b\u60c5\u53d8\u4e86\u3002",
    "\u8fd948\u5929\u91cc\uff0c7000\u591a\u4e2a\u7528\u6237\u7528\u4e86\u6211\u4eec\u7684\u2018\u4e00\u952e\u4f18\u5316\u2019\u529f\u80fd\uff0c\u53cd\u9988\u4e863\u4e2a\u6700\u70e6\u4eba\u7684\u95ee\u9898\u3002\u6211\u4eec\u6ca1\u95f2\u7740\uff1a\u7b2c1\u4e2a\u66f4\u65b0\uff0c\u662f\u8ba9\u84dd\u7259\u8033\u673a\u8fde\u63a5\u65f6\u81ea\u52a8\u8c03\u51fa\u4f60\u4e0a\u6b21\u7528\u7684\u914d\u7f6e\uff0c\u4e0d\u7528\u518d\u624b\u52a8\u5207\u6362\u3002\u7b2c2\u4e2a\uff0c\u662f\u9488\u5bf9\u2018\u64ad\u5ba2\u6a21\u5f0f\u2019\u505a\u4e86\u964d\u566a\u5fae\u8c03\uff0c\u5bf9\u8bdd\u66f4\u6e05\u6670\uff0c\u4e0d\u4f1a\u70b8\u8033\u6735\u3002",
    "\u7b2c3\u4e2a\u66f4\u65b0\uff0c\u53ef\u80fd\u76f4\u63a5\u89e3\u51b3\u4f60\u7684\u75db\u70b9\uff1a\u73b0\u5728\u2018\u4f18\u5316\u2019\u6309\u94ae\u80fd\u8bc6\u522b\u4f60\u63d2\u7684\u8033\u673a\u578b\u53f7\uff0c\u81ea\u52a8\u6821\u51c6\u5230\u6700\u4f73\u97f3\u91cf\u3002\u4f60\u4e0d\u9700\u8981\u61c2EQ\uff0c\u70b9\u4e00\u4e0b\uff0c\u58f0\u97f3\u5c31\u53d8\u5927\u53d8\u6e05\u695a\uff0c\u800c\u4e14\u4e0d\u4f24\u8033\u6735\u3002\u8bd5\u8bd5\u770b\uff0c\u5c3130\u79d2\u3002",
    "\u6253\u5f00Loud EQ\uff0c\u70b9\u4e00\u4e0b\u90a3\u4e2a\u2018\u4f18\u5316\u2019\u6309\u94ae\u3002\u7136\u540e\u542c\u542c\u770b\u2014\u2014\u4f60\u53ef\u80fd\u4f1a\u60ca\u8bb6\u3002\nP.S. \u5982\u679c48\u5929\u524d\u4f60\u9519\u8fc7\u4e86\u514d\u8d39\u8bd5\u7528\uff0c\u73b0\u5728\u8fd8\u6709\u673a\u4f1a\u3002\u4f46\u4f60\u5f97\u5148\u6253\u5f00App\uff0c\u624d\u77e5\u9053\u600e\u4e48\u9886\u3002"
