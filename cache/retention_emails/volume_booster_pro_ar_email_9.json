{
  "subject": "\u062a\u062d\u062f\u064a 3 \u0623\u064a\u0627\u0645 \u0644\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0628\u062f\u0648\u0646 \u0625\u0639\u0644\u0627\u0646\u0627\u062a",
  "preview_text": "\u062c\u0631\u0628 \u0647\u0630\u0647 \u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0628\u0633\u064a\u0637\u0629 \u0644\u0645\u062f\u0629 3 \u0623\u064a\u0627\u0645 \u0648\u0644\u0627\u062d\u0638 \u0627\u0644\u0641\u0631\u0642 \u0628\u0646\u0641\u0633\u0643. \u0644\u0627 \u0625\u0639\u0644\u0627\u0646\u0627\u062a\u060c \u0644\u0627 \u0625\u0632\u0639\u0627\u062c.",
  "body_paragraphs": [
    "\u0641\u064a \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062b\u0627\u0644\u062b \u0645\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0643 \u0644\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u060c \u0644\u0627\u062d\u0638\u062a \u0634\u064a\u0626\u064b\u0627: \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u062a\u062a\u0633\u0644\u0644 \u0628\u064a\u0646 \u0627\u0644\u0645\u0642\u0627\u0637\u0639 \u0627\u0644\u0635\u0648\u062a\u064a\u0629\u060c \u0648\u062a\u0642\u0637\u0639 \u062a\u0631\u0643\u064a\u0632\u0643. \u0644\u0643\u0646\u0643 \u062a\u0639\u0644\u0645 \u0623\u0646 \u0647\u0646\u0627\u0643 \u0628\u062f\u064a\u0644\u0627\u064b.",
    "\u0647\u0630\u0627 \u0627\u0644\u062a\u062d\u062f\u064a \u0644\u064a\u0633 \u0645\u0639\u0642\u062f\u064b\u0627. \u0644\u0645\u062f\u0629 3 \u0623\u064a\u0627\u0645 \u0641\u0642\u0637\u060c \u0627\u0633\u062a\u062e\u062f\u0645 \u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u0639\u0632\u064a\u0632 \u0628\u0646\u0633\u0628\u0629 200% \u0645\u0639 \u0633\u0645\u0627\u0639\u0627\u062a \u0627\u0644\u0631\u0623\u0633. \u0644\u0627 \u062a\u0642\u0645 \u0628\u0625\u064a\u0642\u0627\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u0639\u062f \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645. \u0641\u0642\u0637 \u0627\u0641\u062a\u062d\u0647\u060c \u0627\u0636\u0628\u0637 \u0627\u0644\u0645\u0633\u062a\u0648\u0649\u060c \u0648\u0627\u062a\u0631\u0643\u0647 \u064a\u0639\u0645\u0644.",
    "\u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0645\u0635\u0645\u0645 \u0644\u0643: \u0634\u0627\u0634\u0629 \u0648\u0627\u062d\u062f\u0629\u060c \u0644\u0627 \u0625\u0634\u0639\u0627\u0631\u0627\u062a\u060c \u0644\u0627 \u0623\u0644\u0639\u0627\u0628 \u0632\u0627\u0626\u0641\u0629. \u0641\u0642\u0637 \u0627\u0644\u0645\u0646\u0632\u0644\u0642 \u0648\u0645\u0639\u0627\u062f\u0644 \u0627\u0644\u0635\u0648\u062a. \u064a\u0639\u0645\u0644 \u0645\u0639 \u0643\u0644 \u0634\u064a\u0621: \u0633\u0628\u0648\u062a\u064a\u0641\u0627\u064a\u060c \u064a\u0648\u062a\u064a\u0648\u0628\u060c \u0628\u0648\u062f\u0643\u0627\u0633\u062a\u060c \u0623\u0644\u0639\u0627\u0628.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628 \u0627\u0644\u062a\u062d\u062f\u064a. \u0633\u062a\u0634\u0639\u0631 \u0628\u0627\u0644\u0641\u0631\u0642 \u0641\u064a \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062b\u0627\u0644\u062b. \u0645\u0644\u0627\u062d\u0638\u0629: \u0627\u0644\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0645\u0645\u064a\u0632 \u064a\u0632\u064a\u0644 \u0643\u0644 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0648\u064a\u0636\u064a\u0641 \u062a\u0639\u0632\u064a\u0632\u064b\u0627 \u0641\u0648\u0631\u064a\u064b\u0627 \u0639\u0646\u062f \u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a."
  ],
