{
  "subject": "\u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u09ec\u09ed% \u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u0995\u09b2",
  "preview_text": "\u09b6\u09c1\u09a7\u09c1 \u09e9\u09e6 \u09b8\u09c7\u0995\u09c7\u09a8\u09cd\u09a1\u09c7 \u099c\u09be\u09a8\u09c1\u09a8 \u0995\u09cb\u09a8 \u09a6\u09b2 \u099c\u09bf\u09a4\u09ac\u09c7 \u2013 \u09a1\u09c7\u099f\u09be \u09af\u09be \u09ac\u09b2\u09c7, \u0997\u09be\u099f \u09ab\u09bf\u09b2\u09bf\u0982 \u09a8\u09df\u0964",
  "body_paragraphs": [
    "\u0995\u09b2\u09cd\u09aa\u09a8\u09be \u0995\u09b0\u09c1\u09a8, \u0986\u09aa\u09a8\u09bf \u09b8\u09cb\u09ab\u09be\u09df \u09ac\u09b8\u09c7 \u09ae\u09cd\u09af\u09be\u09a8 \u0987\u0989\u09a8\u09be\u0987\u099f\u09c7\u09a1 \u09ac\u09a8\u09be\u09ae \u09b2\u09bf\u09ad\u09be\u09b0\u09aa\u09c1\u09b2 \u09ae\u09cd\u09af\u09be\u099a \u09a6\u09c7\u0996\u099b\u09c7\u09a8\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09a8\u09cd\u09a7\u09c1 \u09ac\u09b2\u099b\u09c7 '\u09b2\u09bf\u09ad\u09be\u09b0\u09aa\u09c1\u09b2 \u099c\u09bf\u09a4\u09ac\u09c7', \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u09aa\u09a8\u09be\u09b0 \u0997\u09be\u099f \u09ac\u09b2\u099b\u09c7 \u09ae\u09cd\u09af\u09be\u09a8 \u0987\u0989\u09a8\u09be\u0987\u099f\u09c7\u09a1\u0964 \u0995\u09be\u0995\u09c7 \u09ac\u09bf\u09b6\u09cd\u09ac\u09be\u09b8 \u0995\u09b0\u09ac\u09c7\u09a8? \u098f\u0996\u09a8 \u098f\u0995\u099f\u09be \u0989\u09aa\u09be\u09df \u0986\u099b\u09c7 \u2013 \u09e9\u09e6 \u09b8\u09c7\u0995\u09c7\u09a8\u09cd\u09a1\u09c7 \u098f\u0986\u0987 \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3 \u0995\u09b0\u09c7 \u09a6\u09c7\u0996\u09bf\u09df\u09c7 \u09a6\u09c7\u09df \u0995\u09cb\u09a8 \u09a6\u09b2\u09c7\u09b0 \u099c\u09c7\u09a4\u09be\u09b0 \u09b8\u09ae\u09cd\u09ad\u09be\u09ac\u09a8\u09be \u0995\u09a4 \u09b6\u09a4\u09be\u0982\u09b6\u0964",
    "Predictify-\u09a4\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b9\u09be\u099c\u09be\u09b0\u09cb \u09ad\u09c7\u09b0\u09bf\u09df\u09c7\u09ac\u09b2 \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3 \u0995\u09b0\u09be \u09b9\u09df: \u09aa\u09cd\u09b2\u09c7\u09df\u09be\u09b0\u09a6\u09c7\u09b0 xG, \u09aa\u099c\u09c7\u09b6\u09a8, \u09a1\u09bf\u09ab\u09c7\u09a8\u09cd\u09b8\u09bf\u09ad \u09b8\u09cd\u099f\u09cd\u09b0\u09c7\u0982\u09a5, \u09b9\u09c7\u09a1-\u099f\u09c1-\u09b9\u09c7\u09a1 \u09b9\u09bf\u09b8\u09cd\u099f\u09cd\u09b0\u09bf \u2013 \u09b8\u09ac\u0995\u09bf\u099b\u09c1\u0964 \u0986\u09aa\u09a8\u09bf \u09b6\u09c1\u09a7\u09c1 \u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u099b\u09a8\u09cd\u09a6\u09c7\u09b0 \u09b2\u09bf\u0997 \u09ac\u09be\u099b\u09c1\u09a8, \u0986\u09b0 \u09a6\u09c7\u0996\u09c1\u09a8 \u098f\u0986\u0987 \u0995\u09c0 \u09ac\u09b2\u099b\u09c7\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, \u099a\u09b2\u09a4\u09bf \u09b8\u09aa\u09cd\u09a4\u09be\u09b9\u09c7\u09b0 \u09ac\u09be\u09b0\u09cd\u09b8\u09be \u09ac\u09a8\u09be\u09ae \u09b0\u09bf\u09df\u09be\u09b2 \u09ae\u09cd\u09af\u09be\u099a\u09c7 \u098f\u0986\u0987-\u098f\u09b0 \u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u09b8\u09cd\u0995\u09cb\u09b0 \u09ed\u09ee% \u2013 \u09ae\u09be\u09a8\u09c7 \u098f\u099f\u09be \u09aa\u09cd\u09b0\u09be\u09df \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4\u0964",
    "\u0986\u09ae\u09b0\u09be \u09ac\u09b2\u099b\u09bf \u09a8\u09be \u09af\u09c7 \u0997\u09be\u099f \u09ab\u09bf\u09b2\u09bf\u0982 \u09b8\u09ac\u09b8\u09ae\u09df \u09ad\u09c1\u09b2 \u2013 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09a1\u09c7\u099f\u09be \u0995\u0996\u09a8\u09cb \u09ae\u09bf\u09a5\u09cd\u09af\u09be \u09ac\u09b2\u09c7 \u09a8\u09be\u0964 \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 '\u099f\u09c1\u09a1\u09c7\u09b8 \u09aa\u09bf\u0995\u09b8' \u09ab\u09bf\u099a\u09be\u09b0\u09c7 \u09e9\u09e6 \u09b8\u09c7\u0995\u09c7\u09a8\u09cd\u09a1\u09c7 \u09a6\u09c7\u0996\u09c1\u09a8 \u0986\u099c\u0995\u09c7\u09b0 \u09b8\u09c7\u09b0\u09be \u09ac\u09c7\u099f \u0995\u09cb\u09a5\u09be\u09df\u0964 \u0986\u09b0 \u09b9\u09cd\u09af\u09be\u0981, \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8\u09c7\u09b0 \u09aa\u09be\u09b6\u09c7 \u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u09b8\u09cd\u0995\u09cb\u09b0 \u09a6\u09c7\u0993\u09df\u09be \u0986\u099b\u09c7 \u2013 \u0986\u09aa\u09a8\u09bf \u099c\u09be\u09a8\u09ac\u09c7\u09a8 \u0995\u09a4\u099f\u09be \u09b8\u09bf\u09b0\u09bf\u09df\u09be\u09b8\u09b2\u09bf \u09a8\u09bf\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964",
    "\u098f\u0996\u09a8\u0987 \u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09c1\u09a8 \u098f\u09ac\u0982 '\u099f\u09c1\u09a1\u09c7\u09b8 \u09aa\u09bf\u0995\u09b8' \u099a\u09c7\u0995 \u0995\u09b0\u09c1\u09a8\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u09a6\u09c7\u0996\u09a4\u09c7 \u09b8\u09ae\u09df \u09b2\u09be\u0997\u09ac\u09c7 \u09ae\u09be\u09a4\u09cd\u09b0 \u09e9\u09e6 \u09b8\u09c7\u0995\u09c7\u09a8\u09cd\u09a1\u0964 \u09aa\u09bf.\u098f\u09b8.: \u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09df\u09be\u09ae \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0\u09be \u0986\u09b0\u0993 \u09a1\u09bf\u099f\u09c7\u0987\u09b2\u09a1 \u0985\u09cd\u09af\u09be\u09a8\u09be\u09b2\u09be\u0987\u09b8\u09bf\u09b8 \u09aa\u09be\u09a8 \u2013 \u09ab\u09cd\u09b0\u09bf \u099f\u09cd\u09b0\u09be\u09df\u09be\u09b2 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8 \u09e9 \u09a6\u09bf\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af, \u09ae\u09be\u09a4\u09cd\u09b0 \u09e7\u09e8.\u09ef\u09ef \u09a1\u09b2\u09be\u09b0/\u09ae\u09be\u09b8\u0964"
  ],
  "cta_text": "\u098f\u0996\u09a8\u0987 \u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09c1\u09a8",
