{
  "subject": "\u0906\u092a\u0915\u093e 45\u0935\u093e\u0902 \u0926\u093f\u0928 \u0914\u0930 \u090f\u0915 \u0928\u0908 \u0936\u0941\u0930\u0941\u0906\u0924",
  "preview_text": "\u0939\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0906\u092a\u0928\u0947 \u0905\u092c \u0924\u0915 \u0915\u093f\u0924\u0928\u0940 \u0924\u093e\u0930\u0940\u0916\u094b\u0902 \u0915\u0940 \u092f\u094b\u091c\u0928\u093e \u092c\u0928\u093e\u0908 \u0939\u0948\u0964 \u0905\u092c \u090f\u0915 \u0928\u092f\u093e \u0905\u0927\u094d\u092f\u093e\u092f \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "45 \u0926\u093f\u0928\u0964 \u092f\u0939 \u0915\u094b\u0908 \u091b\u094b\u091f\u0940 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0906\u092a\u0928\u0947 SoulPlan \u092a\u0930 \u091c\u093f\u0924\u0928\u093e \u0938\u092e\u092f \u092c\u093f\u0924\u093e\u092f\u093e \u0939\u0948, \u0935\u0939 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u0947 \u0930\u093f\u0936\u094d\u0924\u0947 \u092e\u0947\u0902 \u091c\u093e\u0926\u0942 \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u093e \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u092e\u093e\u092f\u0928\u0947 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u092c \u090f\u0915 \u0928\u092f\u093e \u0938\u0935\u093e\u0932 \u0909\u0920\u0924\u093e \u0939\u0948: \u0915\u094d\u092f\u093e \u0906\u092a \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0939\u0948\u0902 \u092f\u093e \u090f\u0915 \u0930\u093e\u091c\u0926\u0942\u0924?",
    "\u0939\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0939\u0948 \u0915\u093f \u091c\u094b \u091c\u094b\u0921\u093c\u0947 45 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u092c\u093e\u0926 \u092d\u0940 \u0938\u0915\u094d\u0930\u093f\u092f \u0930\u0939\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0905\u0915\u094d\u0938\u0930 \u090f\u0915 \u0928\u0908 \u092a\u0939\u091a\u093e\u0928 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u0947 \u0938\u093f\u0930\u094d\u092b \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u2014\u0935\u0947 \u0926\u0942\u0938\u0930\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u0947\u0930\u093f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0940 \u092e\u0947\u092e\u094b\u0930\u0940 \u091f\u093e\u0907\u092e\u0932\u093e\u0907\u0928 \u092e\u0947\u0902 \u0905\u092c \u0936\u093e\u092f\u0926 \u0915\u0908 \u0924\u0938\u094d\u0935\u0940\u0930\u0947\u0902 \u0939\u0948\u0902, \u0914\u0930 \u0906\u092a\u0915\u093e \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u0915\u093e\u0909\u0902\u091f\u0930 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0928\u0947 \u0915\u093f\u0924\u0928\u0940 \u092c\u093e\u0930 '\u0906\u091c \u0915\u0940 \u0924\u093e\u0930\u0940\u0916' \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u092f\u0939 \u0938\u092c \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902 \u0939\u0948\u2014\u092f\u0939 \u0906\u092a\u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u0939\u0948\u0964",
    "\u0915\u094d\u092f\u093e \u0906\u092a\u0928\u0947 \u0915\u092d\u0940 \u0938\u094b\u091a\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u0940 \u0935\u093f\u0936\u0932\u093f\u0938\u094d\u091f \u092e\u0947\u0902 \u0915\u093f\u0924\u0928\u0947 \u0906\u0907\u0921\u093f\u092f\u093e \u0939\u0948\u0902? \u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u0909\u0928\u094d\u0939\u0947\u0902 \u0906\u091c\u093c\u092e\u093e\u0928\u0947 \u0915\u093e\u0964 \u0939\u092e\u093e\u0930\u093e AI \u0905\u092c \u0906\u092a\u0915\u0940 \u092a\u0938\u0902\u0926 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0928\u093e\u0907\u091f\u094d\u0938 \u0915\u093e \u0938\u0941\u091d\u093e\u0935 \u0926\u0947\u0917\u093e\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u2014'\u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c' \u092e\u094b\u0921 \u092a\u0930\u2014\u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0906\u092a\u0915\u093e \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u0948\u0938\u0947 \u0916\u093f\u0932 \u0909\u0920\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0935\u0939 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u092a\u0938\u0902\u0926 \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u0905\u092a\u0928\u093e \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0940 \u0935\u093f\u0936\u0932\u093f\u0938\u094d\u091f \u0938\u0947 \u090f\u0915 \u0906\u0907\u0921\u093f\u092f\u093e \u091a\u0941\u0928\u0947\u0902\u0964 \u0907\u0938\u0947 \u0905\u092a\u0928\u0947 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u094b \u092d\u0947\u091c\u0947\u0902 \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0935\u0939 \u0915\u0948\u0938\u0947 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 P.S. \u092f\u093e\u0926 \u0930\u0916\u0947\u0902, \u0906\u092a \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u2014\u0906\u092a SoulPlan \u0915\u0947 \u0930\u093e\u091c\u0926\u0942\u0924 \u0939\u0948\u0902\u0964 \u0905\u092a\u0928\u0947 \u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0915\u094b \u092c\u0924\u093e\u090f\u0902, \u0914\u0930 \u0906\u092a \u0926\u094b\u0928\u094b\u0902 \u0915\u094b \u090f\u0915 \u0935\u093f\u0936\u0947\u0937 \u0909\u092a\u0939\u093e\u0930 \u092e\u093f\u0932\u0947\u0917\u093e\u0964"
  ],
