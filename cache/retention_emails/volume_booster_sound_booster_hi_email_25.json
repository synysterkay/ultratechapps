{
  "subject": "\u0935\u094b \u0930\u093e\u0924 3 \u092c\u091c\u0947 \u0915\u093e \u090f\u0915\u094d\u0938\u092a\u0947\u0930\u093f\u092e\u0947\u0902\u091f",
  "preview_text": "\u092e\u0948\u0902\u0928\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u0915\u094b\u0908 \u0907\u0938 \u0910\u092a \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0907\u0938 \u0924\u0930\u0939 \u0915\u0930\u0947\u0917\u093e\u0964 \u090f\u0915 \u092f\u0942\u091c\u0930 \u0928\u0947 \u0915\u0941\u091b \u0910\u0938\u093e \u0915\u093f\u092f\u093e \u091c\u093f\u0938\u0928\u0947 \u092e\u0947\u0930\u0940 \u0938\u094b\u091a \u092c\u0926\u0932 \u0926\u0940\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u090f\u0915 \u092f\u0942\u091c\u0930 \u0928\u0947 \u092e\u0941\u091d\u0947 \u0908\u092e\u0947\u0932 \u0915\u093f\u092f\u093e\u0964 \u0909\u0938\u0928\u0947 \u0932\u093f\u0916\u093e, '\u092e\u0948\u0902\u0928\u0947 \u0906\u092a\u0915\u0947 \u0910\u092a \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u094b \u0905\u0932\u093e\u0930\u094d\u092e \u0918\u0921\u093c\u0940 \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u092f\u093e \u0939\u0948\u0964' \u092e\u0948\u0902 \u091a\u094c\u0902\u0915 \u0917\u092f\u093e\u0964 \u092e\u0948\u0902\u0928\u0947 Volume Booster - Sound Booster \u0915\u094b \u0938\u093f\u0930\u094d\u092b \u092e\u094d\u092f\u0942\u091c\u093f\u0915 \u0914\u0930 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u0947 \u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u0909\u0938\u0928\u0947 \u0907\u0938\u0947 \u090f\u0915 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0928\u090f \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e\u0964",
    "\u0909\u0938\u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0935\u0939 \u0930\u093e\u0924 \u0915\u094b \u0938\u094b\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u094b \u090f\u0915 \u092e\u093f\u0928\u0940 \u092e\u0942\u0935\u0940 \u0925\u093f\u090f\u091f\u0930 \u092e\u0947\u0902 \u092c\u0926\u0932 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0935\u0939 Bass Booster \u0914\u0930 Loudness Enhancer \u0915\u094b \u0911\u0928 \u0915\u0930\u0924\u093e \u0939\u0948, \u092b\u093f\u0930 \u0928\u0947\u091f\u092b\u094d\u0932\u093f\u0915\u094d\u0938 \u092a\u0930 \u0915\u094b\u0908 \u090f\u0915\u094d\u0936\u0928 \u092b\u093f\u0932\u094d\u092e \u0926\u0947\u0916\u0924\u093e \u0939\u0948\u0964 \u0909\u0938\u0928\u0947 \u0915\u0939\u093e, '\u0906\u092a\u0915\u093e \u0910\u092a \u092e\u0947\u0930\u0947 \u092b\u094b\u0928 \u0915\u094b \u0907\u0924\u0928\u093e \u0924\u0947\u091c\u093c \u0914\u0930 \u0917\u0939\u0930\u093e \u092c\u0928\u093e \u0926\u0947\u0924\u093e \u0939\u0948 \u0915\u093f \u092e\u0941\u091d\u0947 \u0932\u0917\u0924\u093e \u0939\u0948 \u091c\u0948\u0938\u0947 \u092e\u0948\u0902 \u0938\u093f\u0928\u0947\u092e\u093e \u0939\u0949\u0932 \u092e\u0947\u0902 \u092c\u0948\u0920\u093e \u0939\u0942\u0902\u0964' \u092e\u0948\u0902 \u092f\u0939 \u0938\u0941\u0928\u0915\u0930 \u0939\u0948\u0930\u093e\u0928 \u0930\u0939 \u0917\u092f\u093e\u0964",
    "\u092f\u0939\u0940 \u0935\u094b \u0915\u094d\u0937\u0923 \u0939\u0948 \u091c\u092c \u092e\u0941\u091d\u0947 \u090f\u0939\u0938\u093e\u0938 \u0939\u0941\u0906 \u0915\u093f \u092f\u0939 \u0910\u092a \u0938\u093f\u0930\u094d\u092b \u0906\u0935\u093e\u091c\u093c \u092c\u0922\u093c\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0907\u0938\u0915\u093e \u0905\u0938\u0932\u0940 \u091c\u093e\u0926\u0942 \u0939\u0948 \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u0915\u0947 \u0939\u0930 \u0911\u0921\u093f\u092f\u094b \u0905\u0928\u0941\u092d\u0935 \u0915\u094b \u092c\u0926\u0932\u0928\u093e\u0964 \u091a\u093e\u0939\u0947 \u0906\u092a \u090f\u0915 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928 \u0930\u0939\u0947 \u0939\u094b\u0902, \u092f\u093e \u0915\u094b\u0908 \u0935\u0940\u0921\u093f\u092f\u094b \u0926\u0947\u0916 \u0930\u0939\u0947 \u0939\u094b\u0902, \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0938\u0947 \u0906\u092a Equalizer \u0915\u0947 \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938 \u0915\u094b \u091f\u094d\u0930\u093e\u0908 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u2014Pop, Rock, Jazz, \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915\u2014\u0914\u0930 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a\u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u093f\u0924\u0928\u0940 \u092c\u0926\u0932 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964",
    "\u0924\u094b \u0906\u091c \u0930\u093e\u0924, \u091c\u092c \u0906\u092a \u0905\u092a\u0928\u093e \u092b\u094b\u0928 \u0909\u0920\u093e\u090f\u0902, \u0924\u094b \u0915\u0941\u091b \u0905\u0932\u0917 \u0915\u0930\u0947\u0902\u0964 Volume Booster - Sound Booster \u0916\u094b\u0932\u0947\u0902, Bass Booster \u0915\u094b \u0911\u0928 \u0915\u0930\u0947\u0902, \u0914\u0930 \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092b\u093f\u0932\u094d\u092e \u092f\u093e \u0917\u093e\u0928\u093e \u0932\u0917\u093e\u090f\u0902\u0964 \u092b\u093f\u0930 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u090f\u0902 \u0915\u093f \u0906\u092a\u0915\u094b \u0915\u0948\u0938\u093e \u0932\u0917\u093e\u0964 \u092e\u0948\u0902 \u0936\u0930\u094d\u0924 \u0932\u0917\u093e\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u0906\u092a \u092d\u0940 \u0939\u0948\u0930\u093e\u0928 \u0939\u094b \u091c\u093e\u090f\u0902\u0917\u0947\u0964\n\nP.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u092a\u093e\u0938 \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0932\u0947\u0935\u0932 \u0914\u0930 \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 EQ \u0915\u0902\u091f\u094d\u0930\u094b\u0932\u094d\u0938 \u0939\u0948\u0902\u2014\u090f\u0915 \u092c\u093e\u0930 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u0947\u0902, \u0906\u092a\u0915\u094b \u092a\u091b\u0924\u093e\u0935\u093e \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u093e\u0964"
  ],
