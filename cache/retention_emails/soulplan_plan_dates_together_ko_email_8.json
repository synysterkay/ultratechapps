{
  "subject": "\ubbfc\uc218\uc640 \uc9c0\uc740\uc758 \ud654\uc694\uc77c \ubc24 11\uc2dc",
  "preview_text": "\ub370\uc774\ud2b8 \uacc4\ud68d\uc774 \uc9c0\ub8e8\ud574\uc9c8 \ub54c, \ud55c \ucee4\ud50c\uc774 \ucc3e\uc740 \ud574\uacb0\ucc45\uc744 \ub4e4\ub824\ub4dc\ub9bd\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\ud654\uc694\uc77c \ubc24 11\uc2dc 17\ubd84, \ubbfc\uc218\ub294 \uc18c\ud30c\uc5d0\uc11c \ud578\ub4dc\ud3f0\ub9cc \ubcf4\uace0 \uc788\uc5c8\uc5b4\uc694. \uc9c0\uc740\uc774 \uc606\uc5d0\uc11c \ucc45\uc744 \uc77d\uace0 \uc788\uc5c8\uc9c0\ub9cc, \ub458 \uc0ac\uc774\uc758 \uac70\ub9ac\ub294 \uc810\uc810 \uba40\uc5b4\uc9c0\uace0 \uc788\uc5c8\uc8e0. '\ub610 \ubb58 \ud558\uc9c0?'\ub77c\ub294 \uc0dd\uac01\uc774 \uba38\ub9bf\uc18d\uc744 \ub9f4\ub3cc\uc558\uac70\ub4e0\uc694. \uc9c0\ub09c\uc8fc\uc5d0\ub3c4, \uadf8 \uc804\uc8fc\uc5d0\ub3c4 \uac19\uc740 \uace0\ubbfc\uc774\uc5c8\uc5b4\uc694.",
    "\uadf8\ub7f0\ub370 \uac11\uc790\uae30 \uc9c0\uc740\uc774 \ub9d0\ud588\uc5b4\uc694. '\uc624\ub298\uc740 \ub124\uac00 \ub370\uc774\ud2b8\ub97c \uace8\ub77c\uc918, \uc544\ubb34\uac70\ub098 \uad1c\ucc2e\uc544.' \ubbfc\uc218\ub294 \uc21c\uac04 \ub2f9\ud669\ud588\uc9c0\ub9cc, SoulPlan \uc571\uc744 \uc5f4\uc5c8\uc5b4\uc694. \uc624\ub298\uc758 \uae30\ubd84\uc740 '\uce58\uc720'\uc600\uac70\ub4e0\uc694. \ud55c \ubc88 \ud130\uce58\ud558\uc790, 30\ucd08 \ub9cc\uc5d0 \uc791\uc740 \ud648\uce74\ud398 \ub370\uc774\ud2b8\uac00 \uc644\uc131\ub410\uc5b4\uc694. \ucee4\ud53c\ub97c \ub0b4\ub9ac\uace0, \ud568\uaed8 \uc88b\uc544\ud558\ub294 \uc74c\uc545\uc744 \ud2c0\uc5c8\uc8e0. \uadf8\ub0a0 \ubc24, \ub458\uc740 2\uc2dc\uac04 \ub118\uac8c \uc6c3\uace0 \ub5a0\ub4e4\uc5c8\uc5b4\uc694.",
    "\ubbfc\uc218\uac00 \ub098\uc911\uc5d0 \ub9d0\ud588\uc5b4\uc694. '\uadf8\ub0e5 \uc571 \ud558\ub098 \ud130\uce58\ud588\uc744 \ubfd0\uc778\ub370, \uc9c0\uc740\uc774 '\uc624\ub298 \ub098 \uc0dd\uac01\ud588\uad6c\ub098'\ub77c\uace0 \ub9d0\ud558\ub354\ub77c. \uadf8 \ub9d0\uc5d0 \ubaa8\ub4e0 \uac8c \ud480\ub838\uc5b4.' SoulPlan\uc758 '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \uae30\ub2a5\uc774 \uadf8\ub807\uac8c \ub450 \uc0ac\ub78c\uc758 \uc77c\uc0c1\uc744 \ubc14\uafe8\uc5b4\uc694. \ub9e4\uc77c \uc0c8\ub85c\uc6b4 \uc544\uc774\ub514\uc5b4\ub97c \uc81c\uc548\ud558\uace0, \ud568\uaed8\ud55c \ubaa8\ub4e0 \uc21c\uac04\uc744 \uba54\ubaa8\ub9ac \ud0c0\uc784\ub77c\uc778\uc5d0 \uae30\ub85d\ud574\uc8fc\ub2c8\uae4c\uc694. \ub370\uc774\ud2b8 \uacc4\ud68d\uc774 \ub354 \uc774\uc0c1 \uc2a4\ud2b8\ub808\uc2a4\uac00 \uc544\ub2c8\ub77c, \uae30\ub300\ub418\ub294 \uc21c\uac04\uc73c\ub85c \ubc14\ub010 \uac70\uc608\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uc5b4\ubcf4\uc138\uc694. \uc624\ub298 \uc800\ub141, \ub2f9\uc2e0\uacfc \ud30c\ud2b8\ub108\ub9cc\uc744 \uc704\ud55c \ud55c \uc7a5\uc758 \uce74\ub4dc\uac00 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694. 30\ucd08\uba74 \ucda9\ubd84\ud574\uc694. P.S. \ud55c \ubc88 \uc2dc\ub3c4\ud55c \ucee4\ud50c\uc740 \ud55c \ub2ec \ub3d9\uc548 \ub370\uc774\ud2b8 \ud69f\uc218\uac00 4\ubc30 \ub298\uc5c8\ub2e4\ub294 \uc0ac\uc2e4, \uc544\uc2dc\ub098\uc694?"
  ],
