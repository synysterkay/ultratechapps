  "subject": "10,000\uba85 \ubd84\uc11d \uacb0\uacfc, \ub2f9\uc2e0\uc774 \ub193\uce58\ub294 \ub370\uc774\ud130",
  "preview_text": "\uc6b0\ub9ac\uac00 10,000\uba85\uc758 \uc0ac\uc6a9\uc790\ub97c \ubd84\uc11d\ud55c \uacb0\uacfc, \uc608\uce21 \uc131\uacf5\ub960\uc744 \uac08\ub77c\ub193\ub294 \ub2e8 \ud558\ub098\uc758 \uc2b5\uad00\uc744 \ubc1c\uacac\ud588\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \uc774\uac78 \uc0ac\uc6a9\ud558\uace0 \uc788\ub098\uc694?",
  "body_paragraphs": [
    "\uc6b0\ub9ac\uac00 10,000\uba85\uc758 \ucd95\uad6c \ud32c\uc744 \ubd84\uc11d\ud588\uc5b4\uc694. \uacb0\uacfc\uac00 \ucda9\uaca9\uc801\uc774\uc5c8\uc2b5\ub2c8\ub2e4. \uc608\uce21 \uc131\uacf5\ub960\uc774 \ub192\uc740 \uc0c1\uc704 10%\uc758 \uc0ac\uc6a9\uc790\uc640 \ub098\uba38\uc9c0 90% \uc0ac\uc774\uc5d0 \ud55c \uac00\uc9c0 \ud070 \ucc28\uc774\uac00 \uc788\uc5c8\uac70\ub4e0\uc694. \uadf8\uac74 \ubc14\ub85c '\uacbd\uae30 \uc804 \ub370\uc774\ud130 \ud655\uc778 \uc2b5\uad00'\uc774\uc5c8\uc2b5\ub2c8\ub2e4. \uc0c1\uc704 \uc0ac\uc6a9\uc790\ub4e4\uc740 \ubb34\uc870\uac74 AI\uc758 \uc608\uce21\uc744 \ubbff\ub294 \uac8c \uc544\ub2c8\ub77c, \uc2a4\uc2a4\ub85c \ub370\uc774\ud130\ub97c \ud30c\uace0\ub4e4\ub354\ub77c\uace0\uc694.",
    "\uc774\uac8c \ubb34\uc2a8 \ub73b\uc774\ub0d0\uba74, AI\uac00 90%\uc758 \ud655\uc2e0\uc744 \uc918\ub3c4, \ub2f9\uc2e0\uc774 \uc9c1\uc811 xG\ub098 \uc218\ube44 \uac15\ub3c4\ub97c \ud655\uc778\ud558\uba74 \ub354 \ud604\uba85\ud55c \ubca0\ud305\uc744 \ud560 \uc218 \uc788\ub2e4\ub294 \uac81\ub2c8\ub2e4. \uc6b0\ub9ac \uc571\uc5d0\ub294 \uc774\uac78 \uc704\ud55c \ubaa8\ub4e0 \ub3c4\uad6c\uac00 \uac16\ucdb0\uc838 \uc788\uc5b4\uc694. AI\uac00 \ubd84\uc11d\ud55c \uc218\ucc9c \uac1c\uc758 \ubcc0\uc218 \uc911\uc5d0\uc11c \ub2f9\uc2e0\uc774 \uc9c1\uc811 \ud575\uc2ec \uc9c0\ud45c\ub97c \uace8\ub77c\ubcfc \uc218 \uc788\uac70\ub4e0\uc694. \ub9c8\uce58 \ub2f9\uc2e0\ub9cc\uc758 \ub370\uc774\ud130 \ubd84\uc11d\uac00\uac00 \ub41c \uae30\ubd84\uc774\uc5d0\uc694.",
    "\ud2b9\ud788 '\ub9e4\uce58 \uc778\uc0ac\uc774\ud2b8' \uae30\ub2a5\uc744 \ucf1c\ubcf4\uc138\uc694. \uc5ec\uae30\uc11c AI\uac00 \uc81c\uacf5\ud558\ub294 \uc608\uce21 \uc810\uc218\ubfd0 \uc544\ub2c8\ub77c, \ud300\ubcc4 xG \ucc28\uc774, \uc810\uc720\uc728, \uacb0\uc815\uc801 \uc218\ube44 \uc131\uacf5\ub960 \uac19\uc740 \uc138\ubd80 \uc9c0\ud45c\ub97c \ud55c\ub208\uc5d0 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ub370\uc774\ud130\ub97c \ubcf4\uba74 \uc65c \uc5b4\ub5a4 \uacbd\uae30\ub294 \uc608\uc0c1 \uc678\uc758 \uacb0\uacfc\uac00 \ub098\uc624\ub294\uc9c0 \uc774\ud574\uac00 \ub420 \uac70\uc608\uc694. \uadf8\ub9ac\uace0 \ub2f9\uc2e0\uc758 \uc608\uce21 \uc815\ud655\ub3c4\uac00 \ud655 \ub2ec\ub77c\uc9c8 \uac81\ub2c8\ub2e4.",
    "\uc9c0\uae08 \ubc14\ub85c Predictify\ub97c \uc5f4\uace0, \uc624\ub298 \uacbd\uae30 \uc911 \ud558\ub098\ub97c \uace8\ub77c '\ub9e4\uce58 \uc778\uc0ac\uc774\ud2b8'\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694. \ub370\uc774\ud130\ub97c \uc9c1\uc811 \ub9cc\uc838\ubcf4\ub294 \uc21c\uac04, \ub2f9\uc2e0\uc758 \uc608\uce21 \uac8c\uc784\uc774 \uc644\uc804\ud788 \ubc14\ub014 \uac70\uc608\uc694. P.S. \ud504\ub9ac\ubbf8\uc5c4 \uc0ac\uc6a9\uc790\ub4e4\uc740 \uc774\ub7f0 \ub370\uc774\ud130\ub97c \ubb34\uc81c\ud55c\uc73c\ub85c \ubcfc \uc218 \uc788\ub294\ub370, 3\uc77c \ubb34\ub8cc \uccb4\ud5d8\ub3c4 \uc788\uc73c\ub2c8 \ubd80\ub2f4 \uc5c6\uc774 \uc2dc\uc791\ud574\ubcf4\uc154\ub3c4 \uc88b\uc2b5\ub2c8\ub2e4."
  ],
