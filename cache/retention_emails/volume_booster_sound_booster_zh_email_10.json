{
  "subject": "\u4e00\u4e2a\u79d8\u5bc6\uff1a\u6211\u4eec1%\u9876\u7ea7\u7528\u6237\u7edd\u4e0d\u8fd9\u6837\u8bbe\u7f6e",
  "preview_text": "\u4ed6\u4eec\u72af\u8fc7\u4e00\u4e2a\u9519\u8bef\uff0c\u73b0\u5728\u90fd\u6539\u4e86\u3002\u8fd9\u662f\u4ed6\u4eec\u771f\u6b63\u7684\u5de5\u4f5c\u6d41\u7a0b\uff0c\u548c\u4f60\u60f3\u7684\u5b8c\u5168\u4e0d\u540c\u3002",
  "body_paragraphs": [
    "\u8bf4\u5b9e\u8bdd\uff0c\u6211\u89c2\u5bdf\u4e86\u6211\u4eec\u51e0\u5343\u4e2a\u7528\u6237\u7684\u6570\u636e\uff0c\u53d1\u73b0\u4e86\u4e00\u4e2a\u5947\u602a\u7684\u73b0\u8c61\u300299%\u7684\u4eba\u4e0b\u8f7d\u540e\u5c31\u76f4\u63a5\u70b9\u2018\u589e\u5f3a\u2019\uff0c\u7136\u540e\u2026\u2026\u5c31\u505c\u5728\u90a3\u91cc\u4e86\u3002\u4ed6\u4eec\u4ee5\u4e3a\u8fd9\u5c31\u662f\u5168\u90e8\u3002",
    "\u4f46\u771f\u6b63\u7684\u9ad8\u624b\u2014\u2014\u90a3\u4e9b\u6bcf\u5929\u542c\u97f3\u4e50\u8d85\u8fc73\u5c0f\u65f6\u3001\u628a\u97f3\u8d28\u5f53\u4fe1\u4ef0\u76841%\u2014\u2014\u4ed6\u4eec\u5b8c\u5168\u4e0d\u540c\u3002\u4ed6\u4eec\u4e0d\u628aVolume Booster\u5f53\u6210\u4e00\u4e2a\u7b80\u5355\u7684\u2018\u97f3\u91cf\u5f00\u5173\u2019\u3002\u4ed6\u4eec\u628a\u5b83\u5f53\u4f5c\u4e00\u4e2a\u5b8c\u6574\u7684\u97f3\u9891\u5de5\u4f5c\u7ad9\u3002\u7b2c\u4e00\u6b65\u6c38\u8fdc\u662f\u5148\u6253\u5f00\u5185\u7f6e\u5747\u8861\u5668\uff0c\u9009\u4e00\u4e2a\u6700\u63a5\u8fd1\u4ed6\u4eec\u5f53\u524d\u97f3\u4e50\u98ce\u683c\u7684\u9884\u8bbe\uff0c\u6bd4\u5982\u542c\u6447\u6eda\u9009Rock\uff0c\u542c\u7535\u5b50\u9009Electronic\u3002\u8fd9\u5c31\u50cf\u8c03\u97f3\u5e08\u5728\u97f3\u4e50\u4f1a\u5f00\u59cb\u524d\u8c03\u97f3\uff0c\u800c\u4e0d\u662f\u76f4\u63a5\u628a\u97f3\u91cf\u65cb\u94ae\u62e7\u5230\u5934\u3002",
    "\u7136\u540e\uff0c\u4ed6\u4eec\u624d\u4f1a\u53bb\u52a8\u90a3\u4e2a\u589e\u5f3a\u6ed1\u5757\u3002\u4f46\u5173\u952e\u6765\u4e86\uff1a\u4ed6\u4eec\u4e0d\u4f1a\u4e00\u6b21\u6027\u62c9\u5230\u6700\u9ad8\u3002\u4ed6\u4eec\u4f1a\u5148\u62c9\u523070%\u5de6\u53f3\uff0c\u64ad\u653e30\u79d2\uff0c\u611f\u53d7\u58f0\u97f3\u7684\u6e05\u6670\u5ea6\u548c\u5931\u771f\u5ea6\u3002\u5982\u679c\u97f3\u8d28\u4f9d\u7136\u5e72\u51c0\uff0c\u4ed6\u4eec\u624d\u4f1a\u518d\u5f80\u4e0a\u63a810%\u3002\u8fd9\u4e2a\u2018\u4e24\u6b65\u6821\u51c6\u6cd5\u2019\u662f\u4fdd\u8bc1\u97f3\u8d28\u4e0d\u70b8\u88c2\u3001\u4f4e\u97f3\u4e0d\u6d51\u6d4a\u7684\u79d8\u5bc6\u3002\u6700\u540e\uff0c\u4ed6\u4eec\u624d\u4f1a\u6839\u636e\u73af\u5883\u2014\u2014\u6bd4\u5982\u5728\u5730\u94c1\u91cc\u8fd8\u662f\u5728\u5bb6\u91cc\u2014\u2014\u5fae\u8c03\u4f4e\u97f3\u589e\u5f3a\u548c\u54cd\u5ea6\u4f18\u5316\u3002\u8fd9\u4e00\u6574\u5957\u6d41\u7a0b\uff0c\u4e0d\u5230\u4e00\u5206\u949f\uff0c\u4f46\u6548\u679c\u5929\u5dee\u5730\u522b\u3002",
    "\u4eca\u5929\u6253\u5f00App\uff0c\u522b\u6025\u7740\u589e\u5f3a\u3002\u5148\u8bd5\u8bd5\u8fd9\u4e2a\u20181%\u5de5\u4f5c\u6d41\u2019\uff1a\u9009\u9884\u8bbe -> \u6821\u51c6\u589e\u5f3a -> \u5fae\u8c03\u73af\u5883\u3002\u4f60\u4f1a\u611f\u89c9\u4e4b\u524d\u542c\u7684\u97f3\u4e50\u90fd\u767d\u542c\u4e86\u3002P.S. \u8fd9\u4e2a\u5de5\u4f5c\u6d41\u5728\u514d\u8d39\u7248\u5c31\u80fd\u7528\uff0c\u4f46\u5982\u679c\u4f60\u60f3\u89e3\u9501\u6240\u6709\u9884\u8bbe\u548c\u7cbe\u7ec6\u5230\u8d6b\u5179\u7684EQ\u63a7\u5236\uff0c\u90a3\u624d\u662f\u5b8c\u5168\u4f53\u3002"
