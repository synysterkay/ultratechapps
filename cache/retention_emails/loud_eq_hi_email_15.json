{
  "subject": "2 \u092e\u093f\u0928\u091f \u0915\u093e \u091f\u094d\u0930\u093f\u0915 \u091c\u094b 20 \u092e\u093f\u0928\u091f \u092c\u091a\u093e\u0924\u093e \u0939\u0948",
  "preview_text": "\u0938\u0941\u0928\u0928\u0947 \u0915\u093e \u0924\u0930\u0940\u0915\u093e \u092c\u0926\u0932 \u0926\u0947\u0902\u0964 \u0905\u092c \u091f\u094d\u0930\u0948\u092b\u093f\u0915 \u092e\u0947\u0902 \u092d\u0940 \u0939\u0930 \u0936\u092c\u094d\u0926 \u0938\u093e\u092b \u0938\u0941\u0928\u0947\u0902\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0915\u0947 \u0938\u093e\u0925 \u0914\u0930 \u092d\u0940 \u092b\u093e\u092f\u0926\u0947\u0964",
  "body_paragraphs": [
    "\u0915\u094d\u092f\u093e \u0906\u092a\u0928\u0947 \u0915\u092d\u0940 \u0938\u094b\u091a\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u092f\u093e \u0917\u093e\u0928\u093e \u0938\u0941\u0928\u0928\u0947 \u092e\u0947\u0902 20 \u092e\u093f\u0928\u091f \u0915\u094d\u092f\u094b\u0902 \u0932\u0917\u0924\u0947 \u0939\u0948\u0902? \u092e\u0948\u0902 \u092c\u0924\u093e \u0930\u0939\u093e \u0939\u0942\u0901\u2014\u0935\u094b \u0938\u092e\u092f \u0938\u093f\u0930\u094d\u092b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0922\u0942\u0902\u0922\u0928\u0947 \u092e\u0947\u0902 \u091a\u0932\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u0939\u092e\u0928\u0947 \u090f\u0915 \u0928\u092f\u093e \u091f\u094d\u0930\u093f\u0915 \u0922\u0942\u0902\u0922 \u0932\u093f\u092f\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u094b 2 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0935\u0939\u0940 \u0915\u093e\u092e \u0915\u0930\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0938\u0947 \u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c \u092b\u0940\u091a\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902, \u0914\u0930 \u0906\u092a\u0915\u093e \u0938\u093e\u0909\u0902\u0921 \u0905\u092a\u0928\u0947 \u0906\u092a \u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0938\u0947\u091f \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u091f\u094d\u0930\u0948\u092b\u093f\u0915 \u092e\u0947\u0902, \u092e\u0947\u091f\u094d\u0930\u094b \u092e\u0947\u0902, \u092f\u093e \u0918\u0930 \u092a\u0930\u2014\u0939\u0930 \u091c\u0917\u0939 \u0938\u094d\u092a\u0937\u094d\u091f \u0938\u0941\u0928\u0947\u0902\u0964",
    "\u092f\u0939 \u092e\u0948\u091c\u093f\u0915 \u0928\u0939\u0940\u0902 \u0939\u0948, \u092f\u0939 Loud EQ \u0915\u093e \u090f\u0915 \u0938\u0930\u0932 \u092b\u0940\u091a\u0930 \u0939\u0948\u2014'\u090f\u0915-\u091f\u0948\u092a \u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c'\u0964 \u092f\u0939 \u0906\u092a\u0915\u0947 \u0908\u092f\u0930\u092b\u094b\u0928 \u092f\u093e \u0938\u094d\u092a\u0940\u0915\u0930 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0938\u093e\u0909\u0902\u0921 \u0915\u094b \u091f\u094d\u092f\u0942\u0928 \u0915\u0930\u0924\u093e \u0939\u0948, \u0924\u093e\u0915\u093f \u0906\u092a\u0915\u094b \u0939\u0930 \u092c\u093e\u0930 \u092e\u0948\u0928\u094d\u092f\u0941\u0905\u0932\u0940 EQ \u092c\u0926\u0932\u0928\u0947 \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0928 \u092a\u0921\u093c\u0947\u0964 \u0905\u092c \u0915\u0932\u094d\u092a\u0928\u093e \u0915\u0930\u0947\u0902: \u0906\u092a \u0905\u092a\u0928\u0940 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 2 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0938\u092c \u0915\u0941\u091b \u092a\u0930\u092b\u0947\u0915\u094d\u091f \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092a\u0939\u0932\u0947 \u092f\u0939 20 \u092e\u093f\u0928\u091f \u0932\u0947\u0924\u093e \u0925\u093e\u0964",
    "\u0907\u0938\u0932\u093f\u090f \u0906\u091c \u0939\u0940 Loud EQ \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u090f\u0915-\u091f\u0948\u092a \u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c' \u0906\u091c\u093c\u092e\u093e\u090f\u0902\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0915\u0947 \u0938\u093e\u0925 \u0906\u092a\u0915\u094b +200% \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0914\u0930 \u0938\u092d\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932\u094d\u0938 \u092e\u093f\u0932\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u092f\u0939 \u091f\u094d\u0930\u093f\u0915 \u092b\u094d\u0930\u0940 \u0935\u0930\u094d\u091c\u0928 \u092e\u0947\u0902 \u092d\u0940 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964 P.S. \u0905\u0917\u0932\u0940 \u092c\u093e\u0930 \u091c\u092c \u0906\u092a \u091f\u094d\u0930\u0948\u092b\u093f\u0915 \u092e\u0947\u0902 \u0939\u094b\u0902, \u0924\u094b \u0907\u0938 \u091f\u094d\u0930\u093f\u0915 \u0915\u094b \u092f\u093e\u0926 \u0930\u0916\u0947\u0902\u2014\u0906\u092a\u0915\u093e \u0938\u092e\u092f \u0914\u0930 \u0938\u0941\u0928\u0928\u0947 \u0915\u093e \u0905\u0928\u0941\u092d\u0935 \u0926\u094b\u0928\u094b\u0902 \u092c\u091a \u091c\u093e\u090f\u0917\u093e\u0964"
  ],
