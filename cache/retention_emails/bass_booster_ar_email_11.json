{
  "subject": "\u062e\u0631\u0627\u0641\u0629 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0639\u0627\u0644\u064a \u062a\u062f\u0645\u0631 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a",
  "preview_text": "\u064a\u0639\u062a\u0642\u062f \u0627\u0644\u062c\u0645\u064a\u0639 \u0623\u0646 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u064a\u0643\u0633\u0631 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a. \u0644\u0643\u0646 \u0627\u0644\u062d\u0642\u064a\u0642\u0629 \u0645\u062e\u062a\u0644\u0641\u0629 \u062a\u0645\u0627\u0645\u064b\u0627. \u0634\u0648\u0641 \u0628\u0646\u0641\u0633\u0643.",
  "body_paragraphs": [
    "\u0633\u0645\u0639\u062a \u0647\u0627\u0644\u0639\u0628\u0627\u0631\u0629 \u0623\u0644\u0641 \u0645\u0631\u0629: '\u0625\u0630\u0627 \u0631\u0641\u0639\u062a \u0627\u0644\u0635\u0648\u062a \u0639\u0627\u0644\u064a\u060c \u0631\u0627\u062d \u062a\u062e\u0631\u0628 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a'. \u0627\u0644\u0643\u0644 \u064a\u0631\u062f\u062f\u0647\u0627\u060c \u062d\u062a\u0649 \u0623\u0635\u062d\u0627\u0628\u0643 \u0627\u0644\u0644\u064a \u064a\u062f\u0651\u0639\u0648\u0646 \u0627\u0644\u062e\u0628\u0631\u0629. \u0644\u0643\u0646 \u062e\u0644\u0646\u064a \u0623\u0642\u0648\u0644\u0643 \u0634\u064a\u0621: \u0647\u0630\u064a \u0645\u062c\u0631\u062f \u062e\u0631\u0627\u0641\u0629\u060c \u0648\u0623\u0646\u0627 \u0639\u0646\u062f\u064a \u062f\u0644\u064a\u0644.",
    "\u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a \u062a\u0635\u0645\u0645 \u062a\u062a\u062d\u0645\u0644 \u0636\u063a\u0637 \u0623\u0639\u0644\u0649 \u0628\u0643\u062a\u064a\u0631 \u0645\u0646 \u0627\u0644\u0644\u064a \u062a\u0633\u0645\u0639\u0647. \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629 \u0645\u0634 \u0641\u064a \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0639\u0627\u0644\u064a\u060c \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0641\u064a \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u0634\u0648\u0651\u0647. \u0644\u0645\u0627 \u062a\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0639\u0644\u0649 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0635\u0646\u0639\u060c \u0627\u0644\u0635\u0648\u062a \u064a\u0628\u062f\u0623 \u064a\u062a\u0642\u0637\u0639 \u0648\u064a\u0634\u0648\u0634\u2014\u0648\u0647\u0630\u0627 \u0627\u0644\u0644\u064a \u064a\u0636\u0631 \u0627\u0644\u0633\u0645\u0627\u0639\u0629 \u0641\u0639\u0644\u064a\u064b\u0627.",
    "\u062a\u0637\u0628\u064a\u0642\u0646\u0627 \u064a\u0639\u0637\u064a\u0643 Boost slider \u0648\u0627\u062d\u062f\u2014\u062a\u0633\u062d\u0628\u0647 \u0648\u062a\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a 200% \u0628\u062f\u0648\u0646 \u062a\u0634\u0648\u064a\u0647. \u0627\u0644\u0635\u0648\u062a \u064a\u0628\u0642\u0649 \u0646\u0642\u064a\u060c \u0642\u0648\u064a\u060c \u0648\u0646\u0638\u064a\u0641. \u062c\u0631\u0628 \u0628\u0646\u0641\u0633\u0643: \u0627\u0641\u062a\u062d \u0623\u063a\u0646\u064a\u0629 \u062f\u0631\u064a\u0644 \u0623\u0648 \u0631\u0648\u0643\u060c \u0627\u0633\u062d\u0628 \u0627\u0644\u0640 Boost\u060c \u0648\u0634\u0648\u0641 \u0643\u064a\u0641 \u0627\u0644\u0633\u0645\u0627\u0639\u0629 \u062a\u0647\u062a\u0632 \u0645\u0639\u0627\u0643 \u0628\u062f\u0644 \u0645\u0627 \u062a\u0648\u062c\u0639 \u0631\u0627\u0633\u0643.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u062f\u0644\u0648\u0642\u062a\u064a \u0648\u062c\u0631\u0628 \u0627\u0644\u0640 'Boost' \u0639\u0644\u0649 \u0623\u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649. \u0644\u0648 \u0645\u0627 \u062c\u0631\u0628\u062a \u0627\u0644\u0640 Premium\u060c \u062c\u0631\u0651\u0628\u0647 \u0645\u062c\u0627\u0646\u064b\u0627 \u0644\u0645\u062f\u0629 \u0645\u062d\u062f\u0648\u062f\u0629\u2014\u0647\u062a\u0644\u0627\u0642\u064a \u0627\u0644\u0628\u0627\u0633 \u064a\u0636\u0631\u0628 \u0641\u064a \u0635\u062f\u0631\u0643. \u0628\u064a \u0625\u0633: \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a \u0631\u062e\u064a\u0635\u0629 \u0627\u0644\u0644\u064a \u0628\u062a\u062e\u0631\u0628\u060c \u0645\u0648 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0639\u0627\u0644\u064a. \u062c\u0647\u0627\u0632\u0643 \u0623\u0642\u0648\u0649 \u0645\u0646 \u0627\u0644\u0644\u064a \u062a\u062a\u062e\u064a\u0644."
  ],
