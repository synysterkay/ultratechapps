{
  "subject": "\u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0915\u093e \u0935\u094b \u092e\u0948\u0938\u0947\u091c \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u0939\u092e\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u0939\u092e \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u092c\u0928\u093e \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u0906\u092a\u0928\u0947 \u0939\u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u092f\u093e \u0915\u093f \u092f\u0939 \u0915\u0941\u091b \u0914\u0930 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u094b \u0926\u093f\u0928 \u091c\u092c \u0924\u0941\u092e\u0928\u0947 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f\u0930 \u0916\u094b\u0932\u093e \u0925\u093e? \u0936\u093e\u092f\u0926 \u0924\u0941\u092e \u0938\u093f\u0930\u094d\u092b \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u092c\u0922\u093c\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0925\u0947\u0964 \u092e\u0917\u0930 \u0906\u091c, 70 \u0926\u093f\u0928 \u092c\u093e\u0926, \u0924\u0941\u092e \u0909\u0928 \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u0932\u094b\u0917\u094b\u0902 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u094b \u091c\u094b \u0930\u094b\u091c\u093c \u0907\u0938 \u0910\u092a \u0915\u094b \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092f\u0942\u091c\u093c\u0930 \u0928\u0939\u0940\u0902 \u0930\u0939\u0947\u2014\u0924\u0941\u092e \u0907\u0938 \u092e\u093f\u0936\u0928 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092c\u0928 \u0917\u090f \u0939\u094b\u0964",
    "\u0939\u092e\u0947\u0902 \u092a\u0924\u093e \u091a\u0932\u093e \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0924\u0930\u0939 \u0915\u0947 \u0932\u094b\u0917 \u0939\u0940 \u0907\u0938 \u0910\u092a \u0915\u0940 \u0905\u0938\u0932\u0940 \u0924\u093e\u0915\u0924 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e\u0928\u0947 \u0939\u092e\u0947\u0902 \u0938\u093f\u0916\u093e\u092f\u093e \u0915\u093f \u0938\u093f\u0930\u094d\u092b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u093e \u0915\u093e\u092b\u0940 \u0928\u0939\u0940\u0902\u2014\u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0938\u093e\u0909\u0902\u0921 \u0915\u094d\u0935\u093e\u0932\u093f\u091f\u0940 \u091a\u093e\u0939\u093f\u090f, \u092c\u0947\u0938 \u091a\u093e\u0939\u093f\u090f, \u0935\u094b \u092b\u0940\u0932 \u091a\u093e\u0939\u093f\u090f \u091c\u094b \u0915\u0949\u0928\u094d\u0938\u0930\u094d\u091f \u092e\u0947\u0902 \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u0907\u0938\u0940\u0932\u093f\u090f \u0939\u092e\u0928\u0947 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938 \u0915\u094b \u0905\u092a\u0921\u0947\u091f \u0915\u093f\u092f\u093e\u2014\u0905\u092c \u092a\u0949\u092a, \u0930\u0949\u0915, \u091c\u0948\u091c\u093c, \u0939\u0930 \u091c\u0949\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0938\u0947\u091f\u093f\u0902\u0917 \u0939\u0948\u0964",
    "\u0938\u094b\u091a, \u091c\u092c \u0924\u0941\u092e \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u0947 \u0915\u094b \u092c\u0942\u0938\u094d\u091f \u0915\u0930\u0924\u0947 \u0939\u094b \u0924\u094b \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948? \u0935\u0939\u0940 \u092c\u093e\u0938 \u091c\u094b \u092a\u0939\u0932\u0947 \u0938\u0941\u0928\u093e\u0908 \u0928\u0939\u0940\u0902 \u0926\u0947\u0924\u093e \u0925\u093e, \u0905\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0915\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0917\u0942\u0902\u091c\u0924\u093e \u0939\u0948\u0964 \u0939\u0930 \u0936\u092c\u094d\u0926 \u0938\u093e\u092b\u093c, \u0939\u0930 \u092c\u0940\u091f \u0917\u0939\u0930\u0940\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092b\u0940\u091a\u0930 \u0928\u0939\u0940\u0902\u2014\u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0928\u092f\u093e \u0924\u0930\u0940\u0915\u093e \u0939\u0948 \u0938\u0902\u0917\u0940\u0924 \u0915\u094b \u091c\u0940\u0928\u0947 \u0915\u093e\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u092c\u093e\u0938 \u092c\u0942\u0938\u094d\u091f\u0930' \u092b\u0940\u091a\u0930 \u0915\u094b 10 \u0938\u0947\u0915\u0902\u0921 \u0915\u0947 \u0932\u093f\u090f \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b\u0964 \u0926\u0947\u0916\u094b \u0915\u0948\u0938\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u0941\u0930\u093e\u0928\u093e \u0917\u093e\u0928\u093e \u0928\u092f\u093e \u0932\u0917\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u0939\u093e\u0901\u2014\u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0935\u0930\u094d\u091c\u093c\u0928 \u092e\u0947\u0902 \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0932\u0947\u0935\u0932\u094d\u0938 \u0939\u0948\u0902, \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0914\u0930 \u092d\u0940 \u0917\u0939\u0930\u093e\u0908 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 P.S. \u0939\u092e \u091c\u0932\u094d\u0926 \u0939\u0940 \u090f\u0915 \u0928\u092f\u093e \u0905\u092a\u0921\u0947\u091f \u0932\u093e \u0930\u0939\u0947 \u0939\u0948\u0902\u2014\u0938\u093f\u0930\u094d\u092b \u0909\u0928\u0915\u0947 \u0932\u093f\u090f \u091c\u094b \u0907\u0938 \u092e\u093f\u0936\u0928 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u0948\u0902\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0906\u0935\u093e\u091c\u093c \u0939\u0940 \u0939\u092e\u093e\u0930\u093e \u0917\u093e\u0907\u0921 \u0939\u0948\u0964"
  ],
