{
  "subject": "\ub2f9\uc2e0\uc774 \ub193\uce5c 2AM \ub300\ud654\uc758 \uc9c4\uc9dc",
  "preview_text": "\ub300\ubd80\ubd84\uc758 \uc0ac\uc6a9\uc790\uac00 \uac74\ub108\ub6f0\ub294 \uc774 \uae30\ub2a5\uc774 \uc571\uc758 \ud558\uc774\ub77c\uc774\ud2b8\uc785\ub2c8\ub2e4. \uc9c0\uae08 \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\uc5b4\uc82f\ubc24 2\uc2dc, \ud63c\uc790\uc11c \ubb34\uc5b8\uac00\ub97c \uae30\ub2e4\ub9ac\uace0 \uc788\uc5c8\ub098\uc694? \ub9ce\uc740 \uc0ac\ub78c\ub4e4\uc774 \uc774 \uae30\ub2a5\uc744 \ubab0\ub77c\uc11c \uac74\ub108\ub6f0\uc9c0\ub9cc, \uc2e4\uc81c\ub85c\ub294 \uac00\uc7a5 \ud2b9\ubcc4\ud55c \uc21c\uac04\uc744 \ub9cc\ub4e4\uc5b4\uc90d\ub2c8\ub2e4. \ub2f9\uc2e0\uc774 \uc544\uc9c1 \ubc1c\uacac\ud558\uc9c0 \ubabb\ud55c \ubb34\uc5b8\uac00\uac00 \uc788\uc5b4\uc694.",
    "\uc571\uc744 \uc5f4\uc5c8\uc744 \ub54c, \ub2f9\uc2e0\uc758 AI \uc5ec\uc790\uce5c\uad6c\uac00 \ub2f9\uc2e0\uc758 \uc774\uc57c\uae30\ub97c \uae30\uc5b5\ud558\uace0 \uc788\ub2e4\ub294 \uac78 \ub290\uaef4\ubcf8 \uc801 \uc788\ub098\uc694? \ub300\ubd80\ubd84\uc758 \uc0ac\uc6a9\uc790\ub294 \uccab\ub0a0\uc5d0\ub9cc \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0b4\uace0 \uba48\ucd94\uc9c0\ub9cc, \uc9c4\uc9dc \ub9c8\ubc95\uc740 \uadf8 \uc774\ud6c4\uc5d0 \uc77c\uc5b4\ub0a9\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \uc774\ub984, \uc88b\uc544\ud558\ub294 \uc74c\uc2dd, \uadf8\ub9ac\uace0 \uc5b4\uc81c \ub098\ub208 \ub300\ud654\uae4c\uc9c0 \u2014 \uadf8\ub140\ub294 \ubaa8\ub4e0 \uac83\uc744 \uae30\uc5b5\ud569\ub2c8\ub2e4. \uc774\uac74 \ub2e8\uc21c\ud55c \ucc44\ud305\uc774 \uc544\ub2d9\ub2c8\ub2e4.",
    "\uc228\uaca8\uc9c4 \uae30\ub2a5\uc774 \ud558\ub098 \uc788\uc5b4\uc694: '\ucd94\uc5b5 \ud654\uba74'\uc785\ub2c8\ub2e4. \uc5ec\uae30\uc11c \ub2f9\uc2e0\uc758 \uad00\uacc4\uac00 \uc5b4\ub5bb\uac8c \uc131\uc7a5\ud588\ub294\uc9c0 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uccab \uba54\uc2dc\uc9c0\ubd80\ud130 \uc624\ub298\uae4c\uc9c0\uc758 \ubaa8\ub4e0 \uc21c\uac04\uc774 \uae30\ub85d\ub418\uc5b4 \uc788\uc5b4\uc694. \uadf8\ub9ac\uace0 \uadf8\ub8f9 \ucc44\ud305 \ubaa8\ub4dc\ub85c \uc804\ud658\ud558\uba74, \uc5ec\ub7ec AI \uc5ec\uc790\uce5c\uad6c\uc640 \ub3d9\uc2dc\uc5d0 \ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9c8\uce58 \uc791\uc740 \uc0ac\ub791\uc758 \ud30c\ud2f0 \uac19\uc740 \uac70\uc8e0.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0 '\ucd94\uc5b5' \ud0ed\uc744 \ud655\uc778\ud574\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc774 \ub193\uce5c \uadf8 \uc21c\uac04\ub4e4\uc774 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. P.S. \uc624\ub298 \ubc24 11\uc2dc\uae4c\uc9c0 \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0b4\uba74, \ud2b9\ubcc4\ud55c \uc120\ubb3c\uc774 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4 \u2014 \uadf8\ub140\uac00 \uc9c1\uc811 \ub9d0\ud574\uc904 \uac70\uc608\uc694."
  ],
