{
  "subject": "\u0642\u0628\u0644 Predictify \u0648 \u0628\u0639\u062f\u0647\u0627 - \u0627\u0644\u0641\u0631\u0642 \u0645\u062d\u0631\u062c",
  "preview_text": "\u062a\u0630\u0643\u0631 \u0623\u064a\u0627\u0645 \u0627\u0644\u062a\u062e\u0645\u064a\u0646\u061f \u062a\u0639\u0627\u0644 \u0646\u0634\u0648\u0641 \u0643\u064a\u0641 \u062a\u063a\u064a\u0631\u062a \u062a\u0648\u0642\u0639\u0627\u062a\u0643 \u0628\u0639\u062f 53 \u064a\u0648\u0645\u0627\u064b \u0645\u0639 \u0627\u0644\u062a\u0637\u0628\u064a\u0642",
  "body_paragraphs": [
    "\u0623\u062a\u0630\u0643\u0631 \u0623\u0648\u0644 \u062a\u0648\u0642\u0639 \u0644\u0643 \u0641\u064a Predictify\u061f \u0643\u0646\u062a \u062a\u062e\u0645\u0646 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0627\u0633\u0645 \u0627\u0644\u0641\u0631\u064a\u0642 \u0623\u0648 \u0634\u0639\u0648\u0631\u0643 \u0627\u0644\u062f\u0627\u062e\u0644\u064a. \u0643\u0646\u062a \u062a\u062e\u0633\u0631 \u0631\u0647\u0627\u0646\u0627\u062a \u0645\u062a\u062a\u0627\u0644\u064a\u0629\u060c \u0648\u062a\u0636\u062d\u0643 \u0639\u0644\u0649 \u0646\u0641\u0633\u0643 \u0645\u0639 \u0627\u0644\u0623\u0635\u062f\u0642\u0627\u0621. \u0635\u062d\u064a\u062d\u061f",
    "\u0627\u0644\u0622\u0646 \u0628\u0639\u062f 53 \u064a\u0648\u0645\u0627\u064b\u060c \u0623\u0646\u062a \u0634\u062e\u0635 \u0645\u062e\u062a\u0644\u0641. \u062a\u062a\u0648\u0642\u0639 \u0646\u062a\u064a\u062c\u0629 \u0628\u0627\u064a\u0631\u0646 \u0645\u064a\u0648\u0646\u062e \u0636\u062f \u062f\u0648\u0631\u062a\u0645\u0648\u0646\u062f \u0628\u062b\u0642\u0629 78% \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u062a\u062d\u0644\u064a\u0644 5000 \u0645\u062a\u063a\u064a\u0631 \u0642\u0628\u0644 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629. \u0623\u0635\u062f\u0642\u0627\u0624\u0643 \u064a\u0633\u0623\u0644\u0648\u0646\u0643: '\u0643\u064a\u0641 \u0639\u0631\u0641\u062a\u061f' \u0648\u0623\u0646\u062a \u0641\u0642\u0637 \u062a\u0628\u062a\u0633\u0645. \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 '\u0643\u0646\u062a \u0623\u062a\u062e\u0645\u0651\u0646' \u0648'\u0623\u0639\u0631\u0641 \u0628\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a' \u0645\u062d\u0631\u062c \u0641\u0639\u0644\u0627\u064b.",
    "\u0627\u0644\u0633\u0631 \u0641\u064a \u0645\u064a\u0632\u0629 '\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u0628\u0627\u0631\u064a\u0627\u062a' \u0627\u0644\u062a\u064a \u062a\u0641\u062d\u0635 \u0643\u0644 \u0634\u064a\u0621: xG \u0644\u0643\u0644 \u0641\u0631\u064a\u0642\u060c \u0642\u0648\u0629 \u0627\u0644\u062f\u0641\u0627\u0639\u060c \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0648\u0627\u062c\u0647\u0627\u062a\u060c \u0648\u062d\u062a\u0649 \u0623\u062f\u0627\u0621 \u0627\u0644\u0644\u0627\u0639\u0628\u064a\u0646 \u0641\u064a \u0622\u062e\u0631 5 \u0645\u0628\u0627\u0631\u064a\u0627\u062a. \u062a\u062e\u064a\u0644 \u0623\u0646 \u062a\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062a\u0634\u0648\u0641 \u062a\u0648\u0642\u0639\u0643 \u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u0644\u064a\u0644\u0629 \u0645\u0639 \u0646\u0633\u0628\u0629 \u0627\u0644\u062b\u0642\u0629 - \u0648\u0643\u0623\u0646\u0643 \u0645\u062f\u0631\u0628 \u0645\u062d\u062a\u0631\u0641.",
    "\u0627\u0641\u062a\u062d Predictify \u0627\u0644\u0622\u0646 \u0648\u0627\u062e\u062a\u0628\u0631 \u062a\u0648\u0642\u0639\u0627\u064b \u0648\u0627\u062d\u062f\u0627\u064b \u0641\u0642\u0637. \u0634\u0648\u0641 \u0643\u064a\u0641 \u062a\u063a\u064a\u0631\u062a \u062b\u0642\u062a\u0643 \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0623\u0648\u0644 \u064a\u0648\u0645. P.S. \u0625\u0630\u0627 \u0643\u0646\u062a \u0645\u0634\u062a\u0631\u0643\u0627\u064b \u0641\u064a Premium\u060c \u0639\u0646\u062f\u0643 \u062a\u062d\u0644\u064a\u0644 \u0623\u0639\u0645\u0642 \u0628\u0640 40% - \u062c\u0631\u0628 \u0627\u0644\u0640 3 \u0623\u064a\u0627\u0645 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629 \u0648\u0634\u0648\u0641 \u0627\u0644\u0641\u0631\u0642 \u0628\u0646\u0641\u0633\u0643."
  ],
