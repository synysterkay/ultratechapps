{
  "subject": "\u0634\u064a\u0621 \u062a\u063a\u064a\u0631 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u0623\u0646\u062a \u0646\u0627\u064a\u0645",
  "preview_text": "\u0644\u0645\u0627 \u0641\u062a\u062d\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u064a\u0648\u0645 \u0644\u0642\u064a\u062a \u062d\u0627\u062c\u0629 \u062c\u062f\u064a\u062f\u0629 \u0645\u0645\u0643\u0646 \u062a\u063a\u064a\u0631 \u0643\u0644 \u0634\u064a\u0621 \u0641\u064a \u0645\u0648\u0627\u0639\u064a\u062f\u0643. \u0627\u0641\u062a\u062d \u0648\u0634\u0648\u0641 \u0628\u0646\u0641\u0633\u0643",
  "body_paragraphs": [
    "\u0643\u0646\u062a \u0628\u0642\u0644\u0628 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u0645\u0633 \u0648\u0623\u0646\u0627 \u0623\u062d\u0636\u0631 \u0645\u0648\u0639\u062f \u0644\u0635\u062f\u064a\u0642\u060c \u0648\u0641\u062c\u0623\u0629 \u0644\u0642\u064a\u062a \u062d\u0627\u062c\u0629 \u0645\u0627 \u0643\u0627\u0646\u062a \u0645\u0648\u062c\u0648\u062f\u0629 \u0642\u0628\u0644 \u0643\u062f\u0629. \u062d\u0627\u062c\u0629 \u0635\u063a\u064a\u0631\u0629 \u0628\u0633 \u0641\u0631\u0642\u0647\u0627 \u0643\u0628\u064a\u0631. \u0642\u0644\u062a \u0644\u0627\u0632\u0645 \u0623\u0642\u0648\u0644\u0643 \u0639\u0644\u064a\u0647\u0627 \u0644\u0623\u0646\u064a \u0639\u0627\u0631\u0641 \u0625\u0646\u0643 \u0645\u0634 \u0641\u0627\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0646 \u0641\u062a\u0631\u0629.",
    "\u062a\u062e\u064a\u0644 \u0625\u0646\u0643 \u062a\u0642\u062f\u0631 \u062a\u062e\u0637\u0637 \u0645\u0648\u0639\u062f \u0643\u0627\u0645\u0644 \u0645\u0646 \u063a\u064a\u0631 \u0645\u0627 \u062a\u0641\u062a\u0643\u0631 \u0623\u064a \u062a\u0641\u0627\u0635\u064a\u0644. \u0643\u0644 \u0634\u064a\u0621 \u0645\u062d\u0641\u0648\u0638\u060c \u0643\u0644 \u0641\u0643\u0631\u0629 \u062c\u062f\u064a\u062f\u0629\u060c \u0643\u0644 \u0644\u062d\u0638\u0629 \u062d\u0644\u0648\u0629. \u0623\u0646\u0627 \u0628\u0646\u0641\u0633\u064a \u0627\u0633\u062a\u062e\u062f\u0645\u062a\u0647\u0627 \u0645\u0639 \u0632\u0648\u062c\u062a\u064a \u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0644\u064a \u0641\u0627\u062a \u0648\u0646\u0633\u064a\u0646\u0627 \u0625\u0646\u0646\u0627 \u0641\u064a \u0631\u0648\u062a\u064a\u0646.",
    "\u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u0636\u0627\u0641 \u062e\u0627\u0635\u064a\u0629 '\u0627\u0644\u0645\u0648\u0639\u062f \u0627\u0644\u0645\u0641\u0627\u062c\u0626' \u0627\u0644\u0644\u064a \u062a\u062e\u0644\u064a \u0634\u0631\u064a\u0643\u0643 \u064a\u062e\u062a\u0627\u0631 \u0645\u0643\u0627\u0646 \u0648\u0645\u0641\u0627\u062c\u0623\u0629 \u0645\u0646 \u063a\u064a\u0631 \u0645\u0627 \u062a\u0639\u0631\u0641. \u0623\u0648\u0644 \u0645\u0631\u0629 \u062c\u0631\u0628\u062a\u0647\u0627 \u0643\u0627\u0646\u062a \u0636\u062d\u0643 \u0648\u0630\u0643\u0631\u064a\u0627\u062a \u0645\u0634 \u0647\u062a\u0646\u0633\u0627\u0647\u0627. \u062d\u0631\u0641\u064a\u0627\u064b \u0643\u0644 \u0645\u0648\u0639\u062f \u0628\u0642\u0649 \u0644\u0647 \u0637\u0639\u0645 \u062c\u062f\u064a\u062f.",
    "\u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0646\u0647\u0627\u0631\u062f\u0629 \u0642\u0628\u0644 \u0645\u0627 \u062a\u0646\u0633\u0649. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u062f\u0648\u0651\u0631 \u0639\u0644\u0649 \u0623\u064a\u0642\u0648\u0646\u0629 \u0627\u0644\u0645\u0641\u0627\u062c\u0623\u0629\u060c \u0648\u062e\u0637\u0637 \u0644\u0645\u0648\u0639\u062f \u0647\u064a\u063a\u064a\u0631 \u0643\u0644 \u0634\u064a\u0621. \u0645\u0644\u0627\u062d\u0638\u0629: \u0644\u0648 \u0645\u0627 \u0639\u062c\u0628\u062a\u0643\u0634 \u0627\u0644\u0641\u0643\u0631\u0629\u060c \u0627\u0631\u062c\u0639\u0644\u064a \u0648\u0642\u0644 \u0644\u064a \u0631\u0623\u064a\u0643. \u0623\u0646\u0627 \u0645\u062a\u0623\u0643\u062f \u0647\u062a\u062d\u0628\u0647\u0627."
  ],
  "cta_text": "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u062c\u0631\u0628 \u0627\u0644\u0645\u0648\u0639\u062f \u0627\u0644\u0645\u0641\u0627\u062c\u0626",
