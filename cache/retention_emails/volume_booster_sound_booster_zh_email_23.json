{
  "subject": "\u5766\u767d\u8bf4\uff0c\u6ca1\u5f00\u8fd9\u4e2a\u529f\u80fd\u524d\u6211\u6709\u70b9\u5c34\u5c2c",
  "preview_text": "\u624b\u673a\u97f3\u91cf\u5f00\u5230\u6700\u5927\u8fd8\u662f\u542c\u4e0d\u6e05\uff1f\u4f60\u53ef\u80fd\u4e00\u76f4\u7528\u9519\u4e86\u65b9\u6cd5\u3002\u5bf9\u6bd4\u4e00\u4e0b\u5c31\u77e5\u9053\u5dee\u522b\u6709\u591a\u5927\u3002",
  "body_paragraphs": [
    "\u4e0a\u5468\u5728\u5730\u94c1\u4e0a\uff0c\u6211\u65c1\u8fb9\u7684\u4eba\u8033\u673a\u91cc\u6f0f\u51fa\u7684\u97f3\u4e50\u90fd\u6bd4\u6211\u624b\u673a\u5916\u653e\u7684\u58f0\u97f3\u5927\u3002\u90a3\u4e00\u523b\u6211\u610f\u8bc6\u5230\uff0c\u4ee5\u524d\u7684\u6211\u4e5f\u662f\u8fd9\u6837\u2014\u2014\u4ee5\u4e3a\u628a\u97f3\u91cf\u6ed1\u5757\u62d6\u5230\u5e95\u5c31\u591f\u4e86\uff0c\u5176\u5b9e\u5b8c\u5168\u9519\u8fc7\u4e86\u771f\u6b63\u8be5\u6709\u7684\u4f53\u9a8c\u3002",
    "\u6ca1\u6709\u7528\u5747\u8861\u5668\u548c\u4f4e\u97f3\u589e\u5f3a\u4e4b\u524d\uff0c\u6211\u7684\u97f3\u4e50\u5c31\u50cf\u9694\u7740\u4e00\u5c42\u6bdb\u73bb\u7483\u5728\u542c\u3002\u4eba\u58f0\u6a21\u7cca\uff0c\u9f13\u70b9\u8f6f\u7ef5\u7ef5\uff0c\u770b\u5267\u6c38\u8fdc\u5f97\u770b\u5b57\u5e55\u731c\u53f0\u8bcd\u3002\u73b0\u5728\u56de\u60f3\u8d77\u6765\uff0c\u90a3\u79cd\u2018\u5c06\u5c31\u7740\u542c\u2019\u7684\u72b6\u6001\uff0c\u5728\u5bf9\u6bd4\u4e4b\u4e0b\u7b80\u76f4\u6709\u70b9\u96be\u4e3a\u60c5\u3002\u5c31\u50cf\u4e00\u76f4\u7528\u9ed1\u767d\u7535\u89c6\u7684\u4eba\uff0c\u7a81\u7136\u770b\u5230\u4e864K\u9ad8\u6e05\u3002",
    "\u4f60\u731c\u79d8\u5bc6\u662f\u4ec0\u4e48\uff1f\u4e0d\u662f\u628a\u603b\u97f3\u91cf\u62c9\u6ee1\uff0c\u800c\u662f\u7528\u5185\u7f6e\u7684\u2018\u6447\u6eda\u2019\u6216\u2018\u7535\u5b50\u2019\u9884\u8bbe\u4e00\u952e\u8c03\u6821\u3002\u5b83\u4f1a\u667a\u80fd\u63d0\u5347\u4eba\u58f0\u6e05\u6670\u5ea6\uff0c\u540c\u65f6\u628a\u4f4e\u9891\u624e\u5b9e\u5730\u63a8\u51fa\u6765\u3002\u7cfb\u7edf\u97f3\u91cf\u4e0a\u9650\uff1f\u90a3\u53ea\u662f\u4e2a\u5efa\u8bae\u503c\u3002",
    "\u73b0\u5728\u5c31\u6253\u5f00\u5e94\u7528\uff0c\u9009\u4e00\u4e2a\u9002\u5408\u4f60\u6b63\u5728\u542c\u7684\u5185\u5bb9\u7684\u9884\u8bbe\uff0c\u7acb\u523b\u5bf9\u6bd4\u5f00\u5173\u524d\u540e\u7684\u533a\u522b\u3002\u4f60\u4f1a\u56de\u6765\u8c22\u6211\u7684\u3002P.S. \u771f\u6b63\u5c34\u5c2c\u7684\u662f\uff0c\u5f88\u591a\u4eba\u624b\u673a\u91cc\u88c5\u7740\u5b9d\u5e93\uff0c\u5374\u4ece\u6ca1\u6253\u5f00\u8fc7\u90a3\u6247\u95e8\u3002",
    "P.S. \u771f\u6b63\u5c34\u5c2c\u7684\u662f\uff0c\u5f88\u591a\u4eba\u624b\u673a\u91cc\u88c5\u7740\u5b9d\u5e93\uff0c\u5374\u4ece\u6ca1\u6253\u5f00\u8fc7\u90a3\u6247\u95e8\u3002"
