{
  "subject": "\u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092c\u0928\u093e \u092f\u0939 \u092b\u0940\u091a\u0930 \u2014 \u0905\u0938\u0932\u0940 \u0915\u0939\u093e\u0928\u0940",
  "preview_text": "\u090f\u0915 \u0930\u093e\u0924 \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u093e \u0939\u0947\u0921\u092b\u094b\u0928 \u0924\u094b\u0921\u093c \u0926\u093f\u092f\u093e\u0964 \u0924\u092c \u091c\u0928\u094d\u092e\u093e Loudify \u0915\u093e \u0935\u094b \u092b\u0940\u091a\u0930 \u091c\u094b \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924 \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964",
  "body_paragraphs": [
    "\u090f\u0915 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u094b\u0928 \u0938\u0947 \u092a\u0930\u0947\u0936\u093e\u0928 \u0939\u094b\u0915\u0930 \u0909\u0920\u093e\u0964 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092e\u0948\u0915\u094d\u0938 \u092a\u0930 \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u0921\u093e\u092f\u0932\u0949\u0917 \u0938\u093e\u092b \u0928\u0939\u0940\u0902 \u0906 \u0930\u0939\u0947 \u0925\u0947\u0964 \u0917\u0941\u0938\u094d\u0938\u0947 \u092e\u0947\u0902 \u092e\u0948\u0902\u0928\u0947 \u0939\u0947\u0921\u092b\u094b\u0928 \u091f\u0947\u092c\u0932 \u092a\u0930 \u092a\u091f\u0915 \u0926\u093f\u092f\u093e \u2014 \u0914\u0930 \u0935\u0939 \u091f\u0942\u091f \u0917\u092f\u093e\u0964 \u0909\u0938\u0940 \u092a\u0932 \u092e\u0948\u0902\u0928\u0947 \u0924\u092f \u0915\u093f\u092f\u093e: \u0915\u0941\u091b \u0910\u0938\u093e \u092c\u0928\u093e\u090a\u0902 \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0928\u0939\u0940\u0902 \u092c\u0922\u093c\u093e\u090f, \u092c\u0932\u094d\u0915\u093f \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0938\u093e\u092b \u0914\u0930 \u0924\u093e\u0915\u0924\u0935\u0930 \u092c\u0928\u093e\u090f\u0964",
    "\u0905\u0917\u0932\u0947 \u0926\u093f\u0928 \u092e\u0948\u0902\u0928\u0947 \u0915\u094b\u0921\u093f\u0902\u0917 \u0936\u0941\u0930\u0942 \u0915\u0940\u0964 \u092e\u0941\u091d\u0947 \u092a\u0924\u093e \u0925\u093e \u0915\u093f \u0906\u092e \u092c\u0942\u0938\u094d\u091f\u0930 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u092c\u093f\u0917\u093e\u0921\u093c \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u094b \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0910\u0938\u093e \u090f\u0932\u094d\u0917\u094b\u0930\u093f\u0926\u092e \u092c\u0928\u093e\u092f\u093e \u091c\u094b \u0939\u0930 \u092b\u094d\u0930\u0940\u0915\u094d\u0935\u0947\u0902\u0938\u0940 \u0915\u094b \u0905\u0932\u0917-\u0905\u0932\u0917 \u0939\u0948\u0902\u0921\u0932 \u0915\u0930\u0924\u093e \u0939\u0948 \u2014 \u0924\u093e\u0915\u093f \u0924\u0947\u091c\u093c \u0906\u0935\u093e\u091c\u093c \u092e\u0947\u0902 \u092d\u0940 \u0921\u093e\u092f\u0932\u0949\u0917 \u0938\u093e\u092b \u0930\u0939\u0947, \u0914\u0930 \u092c\u093e\u0938 \u0913\u0935\u0930\u0932\u094b\u0921 \u0928 \u0939\u094b\u0964 \u092f\u0939\u0940 \u0935\u094b \u092a\u0932 \u0925\u093e \u091c\u092c Loudify \u0915\u093e +200% \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092b\u0940\u091a\u0930 \u091c\u0928\u094d\u092e\u093e\u0964",
    "\u0905\u092c \u091c\u092c \u0906\u092a Loudify \u0916\u094b\u0932\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0935\u0939\u0940 2AM \u0915\u093e \u091c\u0941\u0928\u0942\u0928 \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0917\u0942\u0902\u091c\u0924\u093e \u0939\u0948\u0964 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0906\u092a AutoEQ \u091a\u093e\u0932\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0939 \u0906\u092a\u0915\u0947 \u0939\u0947\u0921\u092b\u094b\u0928 \u0915\u094b \u092a\u0939\u091a\u093e\u0928 \u0932\u0947\u0924\u093e \u0939\u0948 \u2014 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u092c\u0926\u0932\u0947\u0964 \u0914\u0930 Weekly Sound DNA \u0906\u092a\u0915\u094b \u092c\u0924\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0928\u0947 \u0915\u0948\u0938\u0947 \u0938\u0941\u0928\u093e, \u0915\u092c \u0938\u0941\u0928\u093e, \u0914\u0930 \u0915\u094d\u092f\u093e \u092e\u093f\u0938 \u0915\u093f\u092f\u093e\u0964",
    "\u0906\u091c \u0939\u0940 Loudify \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 +200% \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0915\u094b \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902 \u2014 \u0935\u0939\u0940 \u092b\u0940\u091a\u0930 \u091c\u094b \u090f\u0915 \u091f\u0942\u091f\u0947 \u0939\u0947\u0921\u092b\u094b\u0928 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0939\u0941\u0906\u0964 P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u0939\u0930 \u0939\u092b\u094d\u0924\u0947 \u090f\u0915 \u092a\u0930\u094d\u0938\u0928\u0932\u093e\u0907\u091c\u093c\u094d\u0921 Sound DNA \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092e\u093f\u0932\u0924\u0940 \u0939\u0948 \u2014 \u0906\u092a\u0915\u093e \u0938\u0941\u0928\u0928\u0947 \u0915\u093e \u0924\u0930\u0940\u0915\u093e, \u0921\u0947\u091f\u093e \u092e\u0947\u0902\u0964"
  ],
