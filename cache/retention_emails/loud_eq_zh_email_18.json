{
  "subject": "\u7b2c39\u5929\uff0c\u5766\u767d\u4e00\u4ef6\u4e8b",
  "preview_text": "\u6211\u5e73\u65f6\u4e0d\u5199\u8fd9\u79cd\u90ae\u4ef6\uff0c\u4f46\u4eca\u5929\u60f3\u8ddf\u4f60\u8bf4\u70b9\u771f\u5fc3\u8bdd\u3002\u53ea\u82b1\u4f60\u4e00\u5206\u949f\u3002",
  "body_paragraphs": [
    "\u6211\u5e73\u65f6\u4e0d\u5199\u8fd9\u79cd\u90ae\u4ef6\uff0c\u771f\u7684\u3002\u4f46\u4eca\u5929\u60f3\u8ddf\u4f60\u804a\u804a\uff0c\u56e0\u4e3a\u4f60\u662f\u7b2c100,000\u4e2a\u4e0b\u8f7dLoud EQ\u7684\u4eba\u4e4b\u4e00\u3002\u8bf4\u5b9e\u8bdd\uff0c\u505a\u8fd9\u4e2aapp\u7684\u521d\u8877\u5f88\u81ea\u79c1\u2014\u2014\u6211\u53d7\u4e0d\u4e86\u5728\u5730\u94c1\u4e0a\u628a\u97f3\u91cf\u62c9\u5230\u9876\uff0c\u8fd8\u662f\u542c\u4e0d\u6e05\u64ad\u5ba2\u91cc\u5728\u8bf4\u4ec0\u4e48\u3002\u90a3\u79cd\u611f\u89c9\u592a\u6298\u78e8\u4e86\uff0c\u8033\u6735\u75bc\uff0c\u5185\u5bb9\u4e5f\u9519\u8fc7\u4e86\u3002",
    "\u540e\u6765\u6211\u53d1\u73b0\uff0c\u4e0d\u53ea\u6211\u6709\u8fd9\u4e2a\u95ee\u9898\u3002\u901a\u52e4\u8def\u4e0a\u3001\u5f00\u8f66\u65f6\u3001\u7528\u4fbf\u5b9c\u8033\u673a\u542c\u6b4c\uff0c\u65e0\u6570\u4eba\u90fd\u5728\u8ddf\u2018\u97f3\u91cf\u4e0d\u591f\u2019\u8f83\u52b2\u3002\u666e\u901a\u97f3\u91cf\u589e\u5f3a\u5668\u8981\u4e48\u8ba9\u58f0\u97f3\u70b8\u88c2\uff0c\u8981\u4e48\u635f\u5bb3\u5587\u53ed\u3002\u6240\u4ee5\u6211\u505a\u4e86Loud EQ\u2014\u2014\u4e0d\u662f\u4e3a\u4e86\u70ab\u8000\u529f\u80fd\uff0c\u800c\u662f\u8ba9\u4f60\u591a20%\u97f3\u91cf\uff0c\u4e14\u6e05\u6670\u4e0d\u523a\u8033\u3002",
    "\u4eca\u5929\u60f3\u63d0\u9192\u4f60\uff0capp\u91cc\u90a3\u4e2a\u2018\u4e00\u952e\u4f18\u5316\u2019\u529f\u80fd\uff0c\u80fd\u6839\u636e\u4f60\u63d2\u7684\u8bbe\u5907\u81ea\u52a8\u8c03\u97f3\u3002\u6bd4\u5982\u4f60\u8fde\u4e0aAirPods\u6216\u8f66\u8f7d\u84dd\u7259\uff0c\u5b83\u81ea\u5df1\u5c31\u4e3b\u52a8\u9002\u914d\u3002\u5f88\u591a\u7528\u6237\u8bf4\uff0c\u7528\u4e86\u8fd9\u4e2a\u540e\uff0c\u64ad\u5ba2\u91cc\u6bcf\u53e5\u8bdd\u90fd\u542c\u5f97\u6e05\u6e05\u695a\u695a\uff0c\u4e0d\u7528\u518d\u628a\u624b\u673a\u8d34\u8033\u6735\u4e0a\u4e86\u3002\u8bd5\u8bd5\u8fd9\u4e2a\u529f\u80fd\uff0c\u5c31\u4e00\u5206\u949f\u3002",
