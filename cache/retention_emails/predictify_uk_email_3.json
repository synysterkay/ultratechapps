{
  "subject": "1 \u0445\u0432\u0438\u043b\u0438\u043d\u0430, \u044f\u043a\u0430 \u0437\u043c\u0456\u043d\u0438\u0442\u044c \u0432\u0430\u0448\u0456 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438",
  "preview_text": "\u0421\u0435\u043a\u0440\u0435\u0442\u043d\u0438\u0439 \u0442\u0440\u044e\u043a, \u044f\u043a\u0438\u0439 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c \u0442\u043e\u043f-\u0433\u0440\u0430\u0432\u0446\u0456. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u043f\u0440\u044f\u043c\u043e \u0437\u0430\u0440\u0430\u0437.",
  "body_paragraphs": [
    "\u0423\u044f\u0432\u0456\u0442\u044c: \u0432\u0438 \u0434\u0438\u0432\u0438\u0442\u0435\u0441\u044f \u043c\u0430\u0442\u0447, \u0456 \u0432\u0430\u0448\u0430 \u0456\u043d\u0442\u0443\u0457\u0446\u0456\u044f \u043a\u0430\u0436\u0435 '\u0441\u0442\u0430\u0432\u043a\u0430 \u043d\u0430 \u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0443 \u0433\u043e\u0441\u043f\u043e\u0434\u0430\u0440\u0456\u0432'. \u0410\u043b\u0435 AI \u0432 Predictify \u043f\u043e\u043a\u0430\u0437\u0443\u0454 62% \u043d\u0430 \u043d\u0456\u0447\u0438\u044e. \u0425\u0442\u043e \u043f\u0440\u0430\u0432\u0438\u0439? \u042f \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0432 \u043d\u0430 500 \u043c\u0430\u0442\u0447\u0430\u0445 \u2014 \u0434\u0430\u043d\u0456 \u0432\u0438\u0433\u0440\u0430\u044e\u0442\u044c \u0443 73% \u0432\u0438\u043f\u0430\u0434\u043a\u0456\u0432. \u041e\u0434\u0438\u043d \u043f\u0440\u043e\u0441\u0442\u0438\u0439 \u0442\u0440\u044e\u043a \u0434\u043e\u043f\u043e\u043c\u043e\u0436\u0435 \u0432\u0430\u043c \u0446\u0435 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438.",
    "\u041e\u0441\u044c \u0449\u043e \u044f \u0440\u043e\u0431\u043b\u044e: \u043f\u0435\u0440\u0435\u0434 \u0442\u0438\u043c \u044f\u043a \u0437\u0440\u043e\u0431\u0438\u0442\u0438 \u043f\u0440\u043e\u0433\u043d\u043e\u0437, \u044f \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u044e \u0440\u043e\u0437\u0434\u0456\u043b '\u041f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f \u043a\u043e\u043c\u0430\u043d\u0434' \u0443 Predictify. \u0412\u0441\u044c\u043e\u0433\u043e 60 \u0441\u0435\u043a\u0443\u043d\u0434 \u2014 \u0456 \u0432\u0438 \u0431\u0430\u0447\u0438\u0442\u0435 xG, \u043e\u0431\u043e\u0440\u043e\u043d\u043d\u0443 \u043c\u0456\u0446\u044c \u0442\u0430 \u0456\u0441\u0442\u043e\u0440\u0456\u044e \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0435\u0439. \u0426\u0435 \u044f\u043a \u043c\u0430\u0442\u0438 \u0441\u043a\u0430\u0443\u0442\u0441\u044c\u043a\u0438\u0439 \u0437\u0432\u0456\u0442 \u043f\u0440\u044f\u043c\u043e \u0432 \u043a\u0438\u0448\u0435\u043d\u0456.",
    "\u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0437\u0430\u0440\u0430\u0437: \u0437\u043d\u0430\u0439\u0434\u0456\u0442\u044c \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u043c\u0430\u0442\u0447 \u0443 \u0434\u043e\u0434\u0430\u0442\u043a\u0443, \u043d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c '\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430' \u0456 \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u0439\u0442\u0435 \u043a\u043b\u044e\u0447\u043e\u0432\u0456 \u043f\u043e\u043a\u0430\u0437\u043d\u0438\u043a\u0438. \u0412\u0438 \u043f\u043e\u043c\u0456\u0442\u0438\u0442\u0435, \u0449\u043e \u0432\u0430\u0448\u0456 '\u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044f' \u0447\u0430\u0441\u0442\u043e \u0437\u0431\u0456\u0433\u0430\u044e\u0442\u044c\u0441\u044f \u0437 \u0434\u0430\u043d\u0438\u043c\u0438, \u0430\u043b\u0435 \u0456\u043d\u043e\u0434\u0456 AI \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0456\u0440\u043d\u043e\u0441\u0442\u0456.",
    "\u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 Predictify \u0456 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0446\u0435\u0439 \u0442\u0440\u044e\u043a \u043d\u0430 \u043d\u0430\u0439\u0431\u043b\u0438\u0436\u0447\u043e\u043c\u0443 \u043c\u0430\u0442\u0447\u0456. P.S. \u0414\u043e \u0440\u0435\u0447\u0456, \u0442\u0456, \u0445\u0442\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 \u0446\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u044e, \u043c\u0430\u044e\u0442\u044c \u043d\u0430 40% \u0431\u0456\u043b\u044c\u0448\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0438\u0445 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0456\u0432. \u0412\u0430\u0448\u0430 \u0447\u0435\u0440\u0433\u0430."
