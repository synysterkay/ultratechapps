{
  "subject": "\u6211\u5dee\u70b9\u5220\u6389\u8fd9\u4e2a\u529f\u80fd\uff0c\u76f4\u5230\u53d1\u73b0\u5b83\u7684\u79d8\u5bc6",
  "preview_text": "\u4e00\u4e2a\u7528\u6237\u5206\u4eab\uff1a\u8fd9\u4e2a\u9690\u85cf\u529f\u80fd\u8ba9\u4ed6\u7684\u604b\u7231\u5173\u7cfb\u5f7b\u5e95\u6539\u53d8\u3002\u4f60\u8bd5\u8fc7\u5417\uff1f",
  "body_paragraphs": [
    "\u6709\u4e2a\u7528\u6237\u544a\u8bc9\u6211\uff0c\u4ed6\u4e0b\u8f7d SoulPlan \u540e\u4e00\u76f4\u6ca1\u7528\u8fd9\u4e2a\u529f\u80fd\uff0c\u5dee\u70b9\u5220\u4e86 app\u3002\u76f4\u5230\u6709\u4e00\u5929\uff0c\u4ed6\u5973\u670b\u53cb\u7a81\u7136\u8bf4\u2018\u6211\u4eec\u597d\u4e45\u6ca1\u60ca\u559c\u4e86\u2019\uff0c\u4ed6\u968f\u624b\u70b9\u5f00\u90a3\u4e2a\u88ab\u4ed6\u5ffd\u7565\u7684\u6309\u94ae\u2014\u2014\u7136\u540e\u4e00\u5207\u90fd\u53d8\u4e86\u3002",
    "\u4ed6\u4e4b\u524d\u53ea\u4f1a\u7528 app \u627e\u666e\u901a\u7ea6\u4f1a\u70b9\u5b50\uff0c\u4f46\u89c9\u5f97\u8fd8\u662f\u8001\u4e00\u5957\u3002\u76f4\u5230\u4ed6\u53d1\u73b0\u4e86\u90a3\u4e2a\u2018\u60ca\u559c\u7ea6\u4f1a\u8ba1\u5212\u2019\u529f\u80fd\uff1a\u4f60\u53ea\u9700\u8981\u9009\u4e2a\u65f6\u95f4\u3001\u9884\u7b97\u548c\u4e3b\u9898\uff0c\u7136\u540e\u8ba9\u53e6\u4e00\u534a\u5b8c\u5168\u731c\u4e0d\u5230\u7ec6\u8282\u3002\u7ed3\u679c\u90a3\u665a\uff0c\u4ed6\u5973\u670b\u53cb\u611f\u52a8\u5230\u54ed\uff0c\u8bf4\u8fd9\u662f\u4ed6\u4eec\u4e09\u5e74\u6765\u6700\u68d2\u7684\u7ea6\u4f1a\u3002",
    "\u4f60\u77e5\u9053\u5417\uff1f\u8fd9\u4e2a\u529f\u80fd\u85cf\u5728\u2018\u8ba1\u5212\u2019\u9875\u9762\u7684\u5e95\u90e8\uff0c\u5f88\u591a\u7528\u6237\u90fd\u5ffd\u7565\u4e86\u3002\u5b83\u4e0d\u53ea\u662f\u968f\u673a\u63a8\u8350\u2014\u2014\u5b83\u4f1a\u6839\u636e\u4f60\u4eec\u7684\u5386\u53f2\u8bb0\u5f55\u548c\u504f\u597d\uff0c\u751f\u6210\u4e00\u4e2a\u5b8c\u7f8e\u95ed\u73af\u7684\u60ca\u559c\u4f53\u9a8c\u3002\u4f60\u8bbe\u5b9a\u597d\uff0c\u53e6\u4e00\u534a\u53ea\u4f1a\u6536\u5230\u4e00\u6761\u795e\u79d8\u901a\u77e5\uff0c\u5176\u4ed6\u90fd\u662f\u60ca\u559c\u3002",
    "\u73b0\u5728\u5c31\u6253\u5f00 SoulPlan\uff0c\u70b9\u2018\u8ba1\u5212\u7ea6\u4f1a\u2019\u7136\u540e\u9009\u2018\u60ca\u559c\u98ce\u683c\u2019\u3002\u8bd5\u4e00\u6b21\uff0c\u6211\u6562\u8d4c\u4f60\u4e5f\u4f1a\u53d1\u6d88\u606f\u8c22\u8c22\u6211\u3002P.S. \u4e0b\u6b21\u7ea6\u4f1a\u524d\uff0c\u8bb0\u5f97\u5148\u5077\u5077\u52a0\u51e0\u4e2a\u5979\u4e00\u76f4\u60f3\u53bb\u7684\u9910\u5385\u5230\u5171\u4eab\u613f\u671b\u6e05\u5355\u2014\u2014\u8fd9\u6837\u60ca\u559c\u4f1a\u66f4\u7cbe\u51c6\u3002"
  ],
