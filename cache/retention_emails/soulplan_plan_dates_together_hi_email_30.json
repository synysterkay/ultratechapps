{
  "subject": "\u0935\u094b \u0917\u0932\u0924\u0940 \u091c\u094b 90% \u0932\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902",
  "preview_text": "\u0939\u092e\u0928\u0947 \u090f\u0915 \u0930\u093e\u091c\u093c \u0916\u094b\u0932\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u0930\u093f\u0936\u094d\u0924\u0947 \u0915\u094b \u092c\u0926\u0932 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u092a\u0922\u093c\u093f\u090f \u0915\u094d\u092f\u094b\u0902 \u0906\u092a \u0938\u093f\u0930\u094d\u092b\u093c \u092f\u0942\u091c\u093c\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 70 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902, \u0906\u092a\u0928\u0947 SoulPlan \u0915\u0947 \u0938\u093e\u0925 \u0915\u093f\u0924\u0928\u0940 \u0921\u0947\u091f\u094d\u0938 \u092a\u094d\u0932\u093e\u0928 \u0915\u0940? \u0936\u093e\u092f\u0926 \u091c\u0935\u093e\u092c \u092f\u093e\u0926 \u0928 \u0939\u094b, \u0932\u0947\u0915\u093f\u0928 \u0939\u092e\u093e\u0930\u0947 \u0921\u0947\u091f\u093e \u092e\u0947\u0902 \u0939\u0948\u0964 \u0939\u092e\u0928\u0947 \u0915\u0941\u091b \u0926\u0947\u0916\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u094b \u0939\u0948\u0930\u093e\u0928 \u0915\u0930 \u0926\u0947\u0917\u093e: \u091c\u094b \u0932\u094b\u0917 \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u092f\u0942\u091c\u093c\u0930 \u0915\u0940 \u0924\u0930\u0939 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 3 \u092e\u0939\u0940\u0928\u0947 \u092e\u0947\u0902 \u0910\u092a \u091b\u094b\u0921\u093c \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u091c\u094b \u0932\u094b\u0917 \u0907\u0938\u0947 \u0905\u092a\u0928\u0947 \u0930\u093f\u0936\u094d\u0924\u0947 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092c\u0928\u093e \u0932\u0947\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u091b\u094b\u0921\u093c\u0924\u0947\u0964",
    "\u0906\u092a \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u092f\u0942\u091c\u093c\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964 \u0906\u092a \u0909\u0938 \u092e\u093f\u0936\u0928 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u0948\u0902 \u091c\u094b \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u0915\u092a\u0932\u094d\u0938 \u0915\u094b \u0930\u0942\u091f\u0940\u0928 \u0938\u0947 \u092c\u091a\u093e \u0930\u0939\u093e \u0939\u0948\u0964 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0906\u092a \u0915\u094b\u0908 \u0921\u0947\u091f \u0906\u0907\u0921\u093f\u092f\u093e \u0938\u0947\u0935 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u092f\u093e \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c\u093c \u092a\u094d\u0932\u093e\u0928\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0906\u092a \u090f\u0915 \u092c\u0921\u093c\u0940 \u091a\u0940\u091c\u093c \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092c\u0928\u0924\u0947 \u0939\u0948\u0902: \u0915\u092a\u0932\u094d\u0938 \u0915\u094b \u092b\u093f\u0930 \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936\u0964 230 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0915\u092a\u0932\u094d\u0938 \u0928\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u092c\u0947\u0939\u0924\u0930 \u0921\u0947\u091f\u094d\u0938 \u092a\u094d\u0932\u093e\u0928 \u0915\u0940 \u0939\u0948\u0902, \u0914\u0930 92% \u0928\u0947 \u0915\u0939\u093e \u0915\u093f \u0907\u0938\u0938\u0947 \u0909\u0928\u0915\u093e \u0930\u093f\u0936\u094d\u0924\u093e \u092c\u0947\u0939\u0924\u0930 \u0939\u0941\u0906\u0964 \u0906\u092a\u0915\u0940 \u0939\u0930 \u090f\u0915\u094d\u091f\u093f\u0935\u093f\u091f\u0940 \u092e\u093e\u092f\u0928\u0947 \u0930\u0916\u0924\u0940 \u0939\u0948\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u091a\u0940\u091c\u093c \u0939\u0948 \u091c\u094b \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0905\u0928\u0926\u0947\u0916\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902: \u0936\u0947\u092f\u0930\u094d\u0921 \u0935\u093f\u0936\u0932\u093f\u0938\u094d\u091f\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u092b\u0940\u091a\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948, \u092f\u0939 \u0906\u092a\u0915\u0947 \u0930\u093f\u0936\u094d\u0924\u0947 \u0915\u093e \u092d\u0935\u093f\u0937\u094d\u092f \u0939\u0948\u0964 \u091c\u092c \u0906\u092a \u0914\u0930 \u0906\u092a\u0915\u093e \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0935\u0939\u093e\u0901 \u0921\u094d\u0930\u0940\u092e \u0921\u0947\u091f\u094d\u0938 \u091c\u094b\u0921\u093c\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0906\u092a \u0938\u093f\u0930\u094d\u092b\u093c \u092a\u094d\u0932\u093e\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0930\u0939\u0947, \u0906\u092a \u090f\u0915 \u0938\u093e\u0925 \u0915\u0941\u091b \u092c\u0921\u093c\u093e \u092c\u0928\u093e \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939\u0940 \u0905\u0938\u0932\u0940 \u092e\u0948\u091c\u093f\u0915 \u0939\u0948\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948: \u0916\u094b\u0932\u0947\u0902 SoulPlan, \u0914\u0930 \u0936\u0947\u092f\u0930\u094d\u0921 \u0935\u093f\u0936\u0932\u093f\u0938\u094d\u091f \u092e\u0947\u0902 \u0915\u092e \u0938\u0947 \u0915\u092e \u090f\u0915 \u0921\u0947\u091f \u091c\u094b\u0921\u093c\u0947\u0902\u0964 \u092b\u093f\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. - \u0915\u094d\u092f\u093e \u0906\u092a\u0915\u094b \u092a\u0924\u093e \u0939\u0948 \u0915\u093f \u0939\u0930 \u0939\u092b\u093c\u094d\u0924\u0947 \u0935\u093f\u0936\u0932\u093f\u0938\u094d\u091f \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u092a\u0932\u094d\u0938 \u0915\u0940 \u0921\u0947\u091f \u0928\u093e\u0907\u091f 40% \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0938\u0915\u094d\u0938\u0947\u0938\u092b\u0941\u0932 \u0939\u094b\u0924\u0940 \u0939\u0948? \u092f\u0939 \u0915\u094b\u0908 \u0938\u0902\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
  ],
