{
  "subject": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0924\u0948\u092f\u093e\u0930 \u0939\u0948",
  "preview_text": "\u0905\u092c \u0914\u0930 \u092e\u0924 \u0938\u094b\u091a\u094b\u0964 \u092c\u0938 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0926\u0947\u0916\u094b \u0915\u0948\u0938\u0947 \u092f\u0939 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092e\u0948\u0902 \u091c\u093e\u0928\u0924\u093e \u0939\u0942\u0901 \u0924\u0941\u092e \u0905\u092d\u0940 \u090f\u0915 \u0916\u093e\u0932\u0940 \u092a\u0947\u091c \u0915\u094b \u0918\u0942\u0930 \u0930\u0939\u0947 \u0939\u094b\u0964 \u0918\u0902\u091f\u094b\u0902 \u0938\u0947 \u0918\u0942\u0930 \u0930\u0939\u0947 \u0939\u094b\u0964 \u0926\u093f\u092e\u093e\u0917 \u092e\u0947\u0902 \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0906 \u0930\u0939\u093e\u0964 \u0921\u0947\u0921\u0932\u093e\u0907\u0928 \u0915\u0930\u0940\u092c \u0906 \u0930\u0939\u0940 \u0939\u0948\u0964 \u0935\u094b \u0938\u093e\u0930\u0940 \u0909\u0932\u091d\u0928 \u091c\u094b \u0939\u0930 \u091b\u093e\u0924\u094d\u0930 \u0915\u094b \u0906\u0924\u0940 \u0939\u0948 \u2014 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092d\u0940 \u0906 \u0930\u0939\u0940 \u0939\u0948\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u0915\u094d\u092f\u093e \u0939\u094b \u0905\u0917\u0930 \u092e\u0948\u0902 \u0915\u0939\u0942\u0901 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u0938\u093f\u0930\u094d\u092b 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0924\u0948\u092f\u093e\u0930 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948? \u0939\u093e\u0901, \u092c\u093f\u0932\u094d\u0915\u0941\u0932\u0964 50,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0928\u0947 \u092f\u0939 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u0909\u0928\u0915\u0947 \u0917\u094d\u0930\u0947\u0921 B+ \u0938\u0947 A- \u0924\u0915 \u092a\u0939\u0941\u0901\u091a\u0947\u0964 \u0914\u0930 \u092f\u0939 \u0938\u092c \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 AI \u0921\u093f\u091f\u0947\u0915\u094d\u0936\u0928 \u0915\u0940 \u091a\u093f\u0902\u0924\u093e \u0915\u0947\u0964",
    "\u092f\u0939 \u0915\u094b\u0908 \u0938\u092a\u0928\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 Thesis Generator \u0915\u0940 \u0905\u0938\u0932\u0940 \u0924\u093e\u0915\u0924 \u0939\u0948\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0910\u092a \u0916\u094b\u0932\u094b \u2014 '\u0925\u0940\u0938\u093f\u0938 \u091c\u0947\u0928\u0930\u0947\u091f' \u092b\u0940\u091a\u0930 \u092a\u0930 \u091c\u093e\u0913 \u2014 \u0905\u092a\u0928\u093e \u091f\u0949\u092a\u093f\u0915 \u0921\u093e\u0932\u094b \u2014 \u0914\u0930 \u0926\u0947\u0916\u094b \u0915\u0948\u0938\u0947 \u0938\u0947\u0915\u0902\u0921\u094b\u0902 \u092e\u0947\u0902 \u090f\u0915 \u092a\u0930\u092b\u0947\u0915\u094d\u091f \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u0906 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u092b\u0942\u092b\u093e \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u092e\u0936\u0915\u094d\u0915\u0924 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u0906\u0909\u091f\u092a\u0941\u091f\u0964",
    "\u0924\u094b \u0905\u092c \u0915\u094d\u092f\u093e \u0938\u094b\u091a \u0930\u0939\u0947 \u0939\u094b? \u0910\u092a \u0916\u094b\u0932\u094b, \u092f\u0939 \u092b\u0940\u091a\u0930 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b, \u0914\u0930 \u0916\u0941\u0926 \u0915\u094b \u0909\u0938 \u0918\u0902\u091f\u094b\u0902 \u0915\u0940 \u092e\u0947\u0939\u0928\u0924 \u0938\u0947 \u092c\u091a\u093e\u0913\u0964 P.S. \u2014 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u092e\u0947\u0902 \u0939\u0940 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0910\u0938\u093e \u0932\u0917\u0947\u0917\u093e \u091c\u0948\u0938\u0947 \u0924\u0941\u092e\u0928\u0947 \u0915\u094b\u0908 \u091a\u0940\u091f \u0915\u094b\u0921 \u0922\u0942\u0901\u0922 \u0932\u093f\u092f\u093e \u0939\u094b\u0964"
