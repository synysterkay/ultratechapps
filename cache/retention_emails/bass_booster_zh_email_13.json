{
  "subject": "\u4f60\u7684\u7b2c28\u5929\u4f4e\u97f3\u62a5\u544a",
  "preview_text": "\u4e00\u4e2a\u6708\u524d\u4f60\u4e0b\u8f7d\u4e86Bass Booster\u3002\u6765\u770b\u770b\u4f60\u9519\u8fc7\u4e86\u4ec0\u4e48\u2014\u2014\u4ee5\u53ca\u4eca\u5929\u5982\u4f55\u8ba9\u6bcf\u4e2a\u8282\u62cd\u9707\u5230\u80f8\u53e3\u3002",
  "body_paragraphs": [
    "\u4e00\u4e2a\u6708\u4e86\u3002\u4ece\u4f60\u7b2c\u4e00\u6b21\u70b9\u4e0b\u201c\u4e0b\u8f7d\u201d\u5230\u73b0\u5728\uff0c\u5df2\u7ecf\u8fc7\u4e8628\u5929\u3002\u6211\u4e0d\u77e5\u9053\u4f60\u5728\u542c\u4ec0\u4e48\u2014\u2014\u662fDrake\u7684\u4f4e\u97f3\u7ebf\uff0c\u8fd8\u662fSkrillex\u7684drop\uff0c\u53c8\u6216\u8005\u662f\u4e00\u9996\u8001Rock\u7684\u9f13\u70b9\u2014\u2014\u4f46\u6211\u77e5\u9053\u4e00\u4ef6\u4e8b\uff1a\u4f60\u7684\u624b\u673a\u8fd8\u6ca1\u771f\u6b63\u70b8\u8fc7\u3002",
    "\u6211\u4eec\u770b\u4e86\u770b\u6570\u636e\u3002\u5728\u8fd928\u5929\u91cc\uff0c\u4f60\u5927\u6982\u542c\u4e86\u5341\u51e0\u4e2a\u5c0f\u65f6\u7684\u97f3\u4e50\u3002\u4f46\u5927\u90e8\u5206\u65f6\u95f4\uff0c\u4f60\u7684\u626c\u58f0\u5668\u548c\u8033\u673a\u90fd\u5728\u6b3a\u9a97\u4f60\u3002\u5b83\u4eec\u628a\u4f4e\u9891\u780d\u6389\uff0c\u8ba9\u4f60\u4ee5\u4e3a\u201c\u5c31\u8fd9\u6837\u4e86\u201d\u3002\u4e0d\u3002\u4f60\u4eca\u5929\u5c31\u80fd\u6539\u53d8\u8fd9\u4e2a\u3002",
    "\u6253\u5f00Bass Booster\uff0c\u70b9\u90a3\u4e2aBoost\u6ed1\u5757\u3002\u62d6\u523070%\u4ee5\u4e0a\u3002\u7136\u540e\u627e\u4e00\u9996\u4f60\u719f\u6089\u7684\u6b4c\u2014\u2014\u5c31\u662f\u90a3\u9996\u4f60\u603b\u89c9\u5f97\u201c\u5dee\u4e86\u70b9\u201d\u7684\u6b4c\u3002\u542c\u524d10\u79d2\u3002\u4f60\u4f1a\u611f\u89c9\u5230\u624b\u673a\u5728\u9707\u3002\u4e0d\u662f\u55e1\u55e1\u58f0\uff0c\u662f\u5b9e\u5b9e\u5728\u5728\u7684\u63a8\u529b\u3002\u8fd9\u5c31\u662f\u6211\u4eec\u8bf4\u7684\u201c\u80f8\u53e3\u4e00\u9707\u201d\u3002",
    "\u73b0\u5728\uff0c\u53bb\u8bd5\u8bd5\u3002\u6253\u5f00\u5e94\u7528\uff0c\u628aBoost\u62c9\u5230\u6700\u723d\u7684\u4f4d\u7f6e\u3002\u522b\u5173\u3002\u542c\u7740\u3002\u7136\u540e\u544a\u8bc9\u6211\u2014\u2014\u662f\u4e0d\u662f\u6bd4\u6628\u5929\u597d\uff1f\n\nP.S. \u5982\u679c\u4f60\u60f3\u8981\u66f4\u731b\uff0c\u8bd5\u8bd510\u6bb5\u5747\u8861\u5668\u91cc\u7684\u201c\u91cd\u4f4e\u97f3\u201d\u9884\u8bbe\u3002\u90a3\u662f\u4e3aEDM\u548cHip-Hop\u91cf\u8eab\u5b9a\u505a\u7684\u3002\u4f60\u5df2\u7ecf\u5728\u7528\u514d\u8d39\u7248\u4e86\u2014\u2014\u89e3\u9501Premium\uff0c\u8ba9\u8fd9\u4f53\u9a8c\u7ffb\u500d\u3002"
  ],
