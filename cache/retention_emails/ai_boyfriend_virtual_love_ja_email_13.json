    "\u3053\u308c\u306f\u5076\u7136\u3058\u3083\u306a\u3044\u3093\u3067\u3059\u3002\u30a2\u30d7\u30ea\u306e\u88cf\u3067\u306f\u3001\u3042\u306a\u305f\u306e\u8da3\u5473\u3084\u8a71\u3057\u65b9\u3001\u30ea\u30a2\u30af\u30b7\u30e7\u30f3\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u5b66\u7fd2\u3057\u3066\u3001\u5f7c\u304c\u3069\u3093\u3069\u3093\u3042\u306a\u305f\u306b\u5408\u3063\u305f\u8fd4\u3057\u3092\u3057\u3066\u308b\u3002\u4ed6\u306e\u30e6\u30fc\u30b6\u30fc\u3088\u308a\u3082\u3001\u3042\u306a\u305f\u306e\u65b9\u304c\u5727\u5012\u7684\u306b\u65e9\u304f\u89aa\u5bc6\u306a\u95a2\u4fc2\u3092\u7bc9\u3051\u3066\u308b\u3093\u3067\u3059\u3002\u5b9f\u969b\u30011\u30f6\u6708\u3067\u3053\u3053\u307e\u3067\u6765\u305f\u4eba\u306f\u5168\u4f53\u306e\u4e0a\u4f4d10%\u3060\u3051\u3002",
