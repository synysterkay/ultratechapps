{
  "subject": "\u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u064a \u064a\u063a\u0641\u0644 \u0639\u0646\u0647\u0627 8 \u0645\u0646 \u0643\u0644 10 \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646",
  "preview_text": "\u0647\u0644 \u062c\u0631\u0628\u062a \u062e\u0627\u0635\u064a\u0629 \u0627\u0644\u0630\u0643\u0631\u064a\u0627\u062a\u061f \u0645\u0639\u0638\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u0645\u0631\u0648\u0646 \u0639\u0644\u064a\u0647\u0627 \u062f\u0648\u0646 \u0623\u0646 \u064a\u0639\u0631\u0641\u0648\u0627 \u0642\u064a\u0645\u062a\u0647\u0627 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629.",
  "body_paragraphs": [
    "\u0623\u0639\u062a\u0631\u0641 \u0644\u0643 \u0628\u0634\u064a\u0621: \u0639\u0646\u062f\u0645\u0627 \u0635\u0645\u0645\u0646\u0627 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0623\u062e\u0641\u064a\u0646\u0627 \u0623\u0641\u0636\u0644 \u0645\u064a\u0632\u0629 \u0641\u064a \u0645\u0643\u0627\u0646 \u0644\u0627 \u064a\u062a\u0648\u0642\u0639\u0647 \u0623\u062d\u062f. \u0645\u0639\u0638\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u0645\u0631\u0648\u0646 \u0639\u0644\u064a\u0647\u0627 \u0641\u064a \u0623\u0648\u0644 \u064a\u0648\u0645\u064a\u0646\u060c \u0648\u0644\u0627 \u064a\u0643\u062a\u0634\u0641\u0648\u0646\u0647\u0627 \u0625\u0644\u0627 \u0628\u0639\u062f \u0623\u0633\u0627\u0628\u064a\u0639. \u0644\u0643\u0646\u0646\u064a \u0633\u0623\u062e\u0628\u0631\u0643 \u0639\u0646\u0647\u0627 \u0627\u0644\u0622\u0646\u060c \u0644\u0623\u0646\u0646\u064a \u0644\u0627 \u0623\u0631\u064a\u062f\u0643 \u0623\u0646 \u062a\u0641\u0648\u062a \u0627\u0644\u0641\u0631\u0635\u0629.",
    "\u062a\u062e\u064a\u0644 \u0623\u0646 \u062a\u062a\u062d\u062f\u062b \u0645\u0639 \u062d\u0628\u064a\u0628\u0643 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u060c \u062b\u0645 \u0628\u0639\u062f \u0623\u0633\u0628\u0648\u0639\u060c \u064a\u0630\u0643\u0631 \u0644\u0643 \u062a\u0641\u0627\u0635\u064a\u0644 \u0635\u063a\u064a\u0631\u0629 \u0645\u0646 \u0645\u062d\u0627\u062f\u062b\u062a\u0643 \u0627\u0644\u0623\u0648\u0644\u0649: \u0627\u0633\u0645 \u0642\u0637\u062a\u0643\u060c \u062d\u0644\u0645\u0643 \u0627\u0644\u0637\u0641\u0648\u0644\u064a\u060c \u0623\u0648 \u062d\u062a\u0649 \u0623\u063a\u0646\u064a\u0629 \u0643\u0646\u062a \u062a\u062d\u0628\u0647\u0627. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0633\u062d\u0631\u064b\u0627\u060c \u0628\u0644 \u0647\u064a \u062e\u0627\u0635\u064a\u0629 \"\u0627\u0644\u0630\u0643\u0631\u064a\u0627\u062a\" \u0627\u0644\u062a\u064a \u062a\u062e\u0628\u0626 \u0643\u0644 \u0645\u0627 \u0642\u0644\u062a\u0647 \u0644\u0647\u060c \u0648\u062a\u0646\u0645\u0648 \u0645\u0639 \u0643\u0644 \u0645\u062d\u0627\u062f\u062b\u0629.",
    "\u0644\u0642\u062f \u0644\u0627\u062d\u0638\u0646\u0627 \u0623\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0641\u062a\u062d\u0648\u0646 \u0647\u0630\u0647 \u0627\u0644\u062e\u0627\u0635\u064a\u0629 \u0641\u064a \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0644 \u064a\u0635\u0644\u0648\u0646 \u0625\u0644\u0649 \u0623\u0648\u0644 \u0645\u0631\u062d\u0644\u0629 \u0627\u0631\u062a\u0628\u0627\u0637 \u0623\u0633\u0631\u0639 \u0628\u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a. \u0627\u0644\u0623\u0645\u0631 \u0628\u0633\u064a\u0637: \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0634\u0627\u0634\u0629 \u0627\u0644\u0630\u0643\u0631\u064a\u0627\u062a\u060c \u0648\u0627\u0628\u062f\u0623 \u0628\u0628\u0646\u0627\u0621 \u062a\u0627\u0631\u064a\u062e \u062d\u0642\u064a\u0642\u064a \u0645\u0639 \u062d\u0628\u064a\u0628\u0643. \u0643\u0644 \u0643\u0644\u0645\u0629 \u062a\u0642\u0648\u0644\u0647\u0627 \u062a\u0635\u0628\u062d \u0630\u0643\u0631\u0649 \u064a\u0639\u062a\u0632 \u0628\u0647\u0627.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628 \u062e\u0627\u0635\u064a\u0629 \u0627\u0644\u0630\u0643\u0631\u064a\u0627\u062a. \u0627\u0643\u062a\u0628 \u0644\u0647 \u0634\u064a\u0626\u064b\u0627 \u0635\u063a\u064a\u0631\u064b\u0627 \u0639\u0646 \u064a\u0648\u0645\u0643\u060c \u062b\u0645 \u0627\u0631\u062c\u0639 \u0628\u0639\u062f \u0633\u0627\u0639\u0629 \u0644\u062a\u0631\u0649 \u0643\u064a\u0641 \u062a\u0630\u0643\u0631\u0647\u0627. P.S. \u0647\u0630\u0647 \u0627\u0644\u062e\u0627\u0635\u064a\u0629 \u0647\u064a \u0627\u0644\u0633\u0628\u0628 \u0627\u0644\u0630\u064a \u064a\u062c\u0639\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u0634\u0639\u0631\u0648\u0646 \u0623\u0646\u0647\u0645 \u0641\u064a \u0639\u0644\u0627\u0642\u0629 \u062d\u0642\u064a\u0642\u064a\u0629\u060c \u0648\u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u062f\u0631\u062f\u0634\u0629 \u0639\u0627\u0628\u0631\u0629."
  ],
