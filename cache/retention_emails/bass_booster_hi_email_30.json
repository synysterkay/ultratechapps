{
  "subject": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092c\u093f\u0928\u093e \u092f\u0939 \u0910\u092a \u0905\u0927\u0942\u0930\u093e \u0939\u0948",
  "preview_text": "70 \u0926\u093f\u0928 \u0939\u094b \u0917\u090f\u0964 \u0905\u092c \u0924\u0941\u092e \u0938\u093f\u0930\u094d\u092b \u092f\u0942\u091c\u0930 \u0928\u0939\u0940\u0902, \u0939\u092e\u093e\u0930\u0940 \u092e\u093f\u0936\u0928 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u094b\u0964 \u091c\u093e\u0928\u094b \u0915\u094d\u092f\u094b\u0902\u0964",
  "body_paragraphs": [
    "70 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0924\u0941\u092e\u0928\u0947 Bass Booster \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e\u0964 \u0924\u092c \u0938\u0947 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0924\u0941\u092e '\u092c\u0942\u0938\u094d\u091f' \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0916\u0940\u0902\u091a\u0924\u0947 \u0939\u094b, \u0924\u0941\u092e \u0938\u093f\u0930\u094d\u092b \u0905\u092a\u0928\u0947 \u0938\u094d\u092a\u0940\u0915\u0930 \u0915\u094b \u091c\u093c\u094b\u0930 \u0938\u0947 \u0928\u0939\u0940\u0902 \u092c\u091c\u093e \u0930\u0939\u0947\u0964 \u0924\u0941\u092e \u090f\u0915 \u0906\u0902\u0926\u094b\u0932\u0928 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092c\u0928 \u0930\u0939\u0947 \u0939\u094b \u2014 \u092b\u094d\u0932\u0948\u091f, \u092c\u0947\u091c\u093e\u0928 \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u0916\u0924\u094d\u092e \u0915\u0930\u0928\u0947 \u0915\u093e\u0964",
    "\u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u091b\u094b\u091f\u0940 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0939\u092e\u093e\u0930\u093e \u0938\u092a\u0928\u093e \u092c\u0921\u093c\u093e \u0939\u0948: \u0939\u0930 \u092b\u094b\u0928 \u0915\u094b \u090f\u0915 \u0938\u092c\u0935\u0942\u092b\u0930 \u092c\u0928\u093e\u0928\u093e\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u091c\u0948\u0938\u0947 12,800 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0939\u092e\u0947\u0902 4.7 \u0938\u094d\u091f\u093e\u0930 \u0926\u093f\u090f \u0939\u0948\u0902\u0964 \u0914\u0930 \u0939\u0930 \u0926\u093f\u0928 \u0915\u0930\u0940\u092c 9,000 \u0932\u094b\u0917 \u0907\u0938\u0940 \u0935\u0915\u094d\u0924 \u092c\u0942\u0938\u094d\u091f \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e \u0909\u0928\u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0939\u094b\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0906\u0935\u093e\u091c\u093c, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092b\u0940\u0921\u092c\u0948\u0915 \u2014 \u092f\u0939\u0940 \u0939\u092e\u0947\u0902 \u0906\u0917\u0947 \u092c\u0922\u093c\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u090f\u0915 \u092c\u093e\u0924 \u0914\u0930 \u0939\u0948: \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0935\u0930\u094d\u091c\u0928 \u092e\u0947\u0902 \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0914\u0930 10-\u092c\u0948\u0902\u0921 EQ \u0939\u0948\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092b\u0940\u091a\u0930 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0938\u0941\u0928\u0928\u0947 \u0915\u0947 \u0905\u0928\u0941\u092d\u0935 \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u092c\u0926\u0932\u0928\u0947 \u0915\u093e \u091f\u0942\u0932 \u0939\u0948\u0964 \u0939\u092e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0924\u0941\u092e \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e\u0913 \u2014 \u0928\u0939\u0940\u0902 \u0924\u094b \u0924\u0941\u092e \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u091c\u093e\u0928 \u092a\u093e\u0913\u0917\u0947 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0917\u093e\u0928\u0947 \u092e\u0947\u0902 \u0915\u093f\u0924\u0928\u093e \u092c\u093e\u0938 \u091b\u093f\u092a\u093e \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u092c\u0942\u0938\u094d\u091f' \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b \u0926\u093e\u090f\u0902 \u0916\u0940\u0902\u091a\u094b\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930\u0964 \u092b\u093f\u0930 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0928\u093e \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0915\u0948\u0938\u093e \u0932\u0917\u093e\u0964 P.S. \u2014 \u0905\u0917\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u0939\u092e \u090f\u0915 \u0928\u092f\u093e \u092b\u0940\u091a\u0930 \u0932\u0949\u0928\u094d\u091a \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0939\u094b\u0917\u093e\u0964 \u0924\u0948\u092f\u093e\u0930 \u0930\u0939\u094b\u0964"
  ],
