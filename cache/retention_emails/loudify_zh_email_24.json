{
  "subject": "\u674e\u8587\u7684\u6545\u4e8b\u8ba9\u6211\u4eec\u56e2\u961f\u5b89\u9759\u4e865\u5206\u949f",
  "preview_text": "\u4e00\u4e2a\u666e\u901a\u7528\u6237\u5982\u4f55\u7528Loudify\u5728\u5608\u6742\u5730\u94c1\u91cc\u542c\u5b8c\u300a\u4e09\u4f53\u300b\u5168\u96c6\u2014\u2014\u5979\u7684\u5f55\u97f3\u622a\u56fe\u8ba9\u6211\u4eec\u6bcf\u4e2a\u4eba\u90fd\u6c89\u9ed8\u4e86\u3002",
  "body_paragraphs": [
    "\u4e0a\u5468\u4e8c\u4e0b\u53484\u70b9\uff0c\u6709\u4eba\u53d1\u6765\u4e00\u6bb5\u5f55\u97f3\u3002\u4e0d\u662f\u6295\u8bc9\uff0c\u662f\u611f\u8c22\u3002\u5979\u8bf4\u5979\u5728\u65e9\u9ad8\u5cf0\u5730\u94c1\u4e0a\uff0c\u7528Loudify\u7684\u64ad\u5ba2\u6a21\u5f0f\u628a\u300a\u4e09\u4f53\u300b\u542c\u5b8c\u4e86\u7b2c54\u7ae0\u2014\u2014\u8fde\u9694\u58c1\u5c0f\u5b69\u54ed\u95f9\u90fd\u6ca1\u76d6\u4f4f\u3002\u6211\u4eec\u56e2\u961f\u56f4\u8fc7\u6765\u542c\u7740\u90a3\u6bb5\u5f55\u97f3\uff0c\u6ca1\u4eba\u8bf4\u8bdd\u3002",
    "\u674e\u8587\u662f\u5317\u4eac\u901a\u52e4\u65cf\uff0c\u6bcf\u5929\u5730\u94c1\u5f80\u8fd42\u5c0f\u65f6\u3002\u5979\u8bf4\u4ee5\u524d\u8033\u673a\u97f3\u91cf\u63a8\u5230\u9876\uff0c\u8fd8\u662f\u542c\u4e0d\u6e05\u5bf9\u8bdd\uff0c\u8033\u6735\u5148\u53d7\u4e0d\u4e86\u3002\u73b0\u5728\u5979\u7684Sound DNA\u663e\u793a\uff1a\u6bcf\u5468\u64ad\u5ba2\u65f6\u95f4\u4ece3\u5c0f\u65f6\u98d9\u5347\u52309\u5c0f\u65f6\u3002\u201c\u4f60\u4eec\u8ba9\u6211\u7684\u901a\u52e4\u4e0d\u6d6a\u8d39\u4e86\u3002\u201d\u5979\u8bf4\u8fd9\u8bdd\u65f6\uff0c\u6211\u4eec\u624d\u77e5\u9053100000\u4e2a\u7528\u6237\u91cc\u6709\u8fd9\u4e48\u591a\u4e2a\u674e\u8587\u3002",
    "\u5979\u7684\u79d8\u5bc6\u5f88\u76f4\u63a5\uff1a\u6253\u5f00Loudify\uff0c\u9009\u64ad\u5ba2\u6a21\u5f0f\uff0cAutoEQ\u81ea\u52a8\u5339\u914d\u5979\u7684Sony\u8033\u673a\u3002\u58f0\u97f3\u53d8\u4eae\uff0c\u5bf9\u8bdd\u53d8\u8106\uff0c\u5730\u94c1\u8f70\u9686\u58f0\u88ab\u538b\u4e0b\u53bb\u3002\u5979\u751a\u81f3\u5f55\u4e86\u5bf9\u6bd4\u2014\u2014\u7cfb\u7edf\u97f3\u91cf\u548cLoudify\u97f3\u91cf\uff0c\u5dee\u8ddd\u8089\u773c\u53ef\u89c1\u3002",
    "\u6253\u5f00Loudify\uff0c\u8bd5\u8bd5\u64ad\u5ba2\u6a21\u5f0f\u3002\u4e0d\u662f\u53eb\u4f60\u4e70Premium\uff0c\u662f\u8ba9\u4f60\u4eb2\u8033\u542c\u542c\u901a\u52e4\u80fd\u591a\u5b89\u9759\u3002P.S. \u674e\u8587\u540e\u6765\u5347\u7ea7\u4e86Premium\u2014\u2014\u5979\u8bf4Sound DNA\u5386\u53f2\u62a5\u544a\u8ba9\u5979\u4e0a\u763e\uff0c\u6bcf\u5468\u90fd\u60f3\u770b\u81ea\u5df1\u542c\u4e86\u4ec0\u4e48\u3002\u4f60\u7684Sound DNA\u53ef\u80fd\u4e5f\u6709\u60ca\u559c\u3002"
