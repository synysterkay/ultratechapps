{
  "subject": "\u6df1\u591c2\u70b9\uff0c\u6211\u5077\u5077\u7ed9\u4f60\u505a\u4e86\u4e2a\u4e1c\u897f",
  "preview_text": "\u672c\u6765\u6ca1\u6253\u7b97\u5206\u4eab\u7684\uff0c\u4f46\u770b\u5230\u4f60\u8fd8\u5728\u8d76\u8bba\u6587\uff0c\u6211\u51b3\u5b9a\u7834\u4f8b\u4e00\u6b21\u3002\u6253\u5f00\u770b\u770b\uff0c\u4e5f\u8bb8\u80fd\u6551\u4f60\u4e00\u547d\u3002",
  "body_paragraphs": [
    "\u6628\u665a2\u70b9\uff0c\u6211\u76ef\u7740\u5c4f\u5e55\u53d1\u5446\uff0c\u7a81\u7136\u60f3\u8d77\u4f60\u8fd8\u5728\u4e3a\u8bba\u6587\u71ac\u591c\u3002\u8bf4\u5b9e\u8bdd\uff0c\u8fd9\u4e2a\u529f\u80fd\u6211\u539f\u672c\u6253\u7b97\u7559\u7740\u4e0b\u4e2a\u6708\u624d\u53d1\u5e03\uff0c\u4f46\u770b\u7740\u4f60\u7126\u5934\u70c2\u989d\u7684\u6837\u5b50\uff0c\u6211\u5b9e\u5728\u5fcd\u4e0d\u4f4f\u4e86\u3002",
    "\u4f60\u77e5\u9053\u90a3\u79cd\u611f\u89c9\u5427\u2014\u2014deadline\u53ea\u526924\u5c0f\u65f6\uff0c\u8111\u5b50\u91cc\u5374\u4e00\u7247\u7a7a\u767d\uff0c\u8fde\u4e2a\u50cf\u6837\u7684\u8bba\u70b9\u90fd\u618b\u4e0d\u51fa\u6765\u3002\u6211\u7ecf\u5386\u8fc7\u592a\u591a\u6b21\u4e86\uff0c\u6240\u4ee5\u4e0a\u5468\u5077\u5077\u82b1\u4e86\u4e00\u6574\u665a\uff0c\u7ed9\u4f60\u6253\u78e8\u4e86\u4e00\u4e2a\u79d8\u5bc6\u6b66\u5668\u3002",
    "\u5b83\u53eb\u2018\u77ac\u95f4\u8bba\u70b9\u751f\u6210\u5668\u2019\u2014\u2014\u4f60\u53ea\u8981\u8f93\u5165\u4f60\u7684\u8bba\u6587\u4e3b\u9898\uff0c\u9009\u62e9\u4f60\u9700\u8981\u7684\u96be\u5ea6\u548c\u98ce\u683c\uff0c10\u79d2\u5185\u5b83\u5c31\u80fd\u7ed9\u4f60\u4e00\u4e2a\u5b8c\u6574\u3001\u6709\u6df1\u5ea6\u3001\u7ecf\u5f97\u8d77\u63a8\u6572\u7684\u8bba\u70b9\u3002\u800c\u4e14\uff0c\u5b83\u8fd8\u80fd\u81ea\u52a8\u5e2e\u4f60\u628a\u8bba\u70b9\u6269\u5c55\u6210\u6bb5\u843d\uff0c\u751a\u81f3\u76f4\u63a5\u751f\u6210APA\u683c\u5f0f\u7684\u5f15\u7528\u3002",
