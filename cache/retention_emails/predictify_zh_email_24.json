  "subject": "\u4ed6\u53d1\u73b0\u7684\u8fd9\u4e2a\u529f\u80fd\u8ba9\u6211\u9707\u60ca",
  "preview_text": "\u4e00\u4e2a\u666e\u901a\u7528\u6237\u65e0\u610f\u4e2d\u63ed\u5f00\u4e86Predictify\u9690\u85cf\u7684\u79d8\u8bc0\uff0c\u8fde\u6211\u4eec\u7684\u56e2\u961f\u90fd\u6ca1\u60f3\u5230\u3002\u4f60\u9519\u8fc7\u5b83\u4e86\u5417\uff1f",
  "body_paragraphs": [
