{
  "subject": "\u0627\u0644\u0645\u0647\u0645\u0629 \u0627\u0644\u062a\u064a \u0628\u062f\u0623\u0646\u0627\u0647\u0627 \u0645\u0639\u064b\u0627",
  "preview_text": "\u0623\u0646\u062a \u0627\u0644\u0622\u0646 \u062c\u0632\u0621 \u0645\u0646 \u0631\u062d\u0644\u0629 \u062a\u063a\u064a\u064a\u0631 \u0639\u0627\u0644\u0645 \u0633\u0628\u0627\u0642\u0627\u062a \u0627\u0644\u062e\u064a\u0644. \u062a\u0641\u0636\u0644 \u0628\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0642\u0635\u0629 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629",
  "body_paragraphs": [
    "\u064a\u062c\u0628 \u0623\u0646 \u0623\u0639\u062a\u0631\u0641 \u0644\u0643 \u0628\u0634\u064a\u0621: \u0639\u0646\u062f\u0645\u0627 \u0623\u0637\u0644\u0642\u062a Predictify\u060c \u0644\u0645 \u0623\u0643\u0646 \u0623\u0628\u062d\u062b \u0639\u0646 \u0645\u062c\u0631\u062f \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646. \u0643\u0646\u062a \u0623\u0628\u062d\u062b \u0639\u0646 \u0634\u0631\u0643\u0627\u0621 \u0641\u064a \u0631\u062d\u0644\u0629 \u062a\u063a\u064a\u064a\u0631 \u0633\u0628\u0627\u0642\u0627\u062a \u0627\u0644\u062e\u064a\u0644 \u0625\u0644\u0649 \u0644\u0639\u0628\u0629 \u0628\u064a\u0627\u0646\u0627\u062a \u062f\u0642\u064a\u0642\u0629\u060c \u0628\u0639\u064a\u062f\u064b\u0627 \u0639\u0646 \u0627\u0644\u062a\u062e\u0645\u064a\u0646. \u0642\u0628\u0644 \u0623\u0633\u0628\u0648\u0639\u064a\u0646\u060c \u0631\u0623\u064a\u062a \u0625\u062d\u0635\u0627\u0626\u064a\u0629 \u0635\u0627\u062f\u0645\u0629: \u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646\u0627 \u062d\u0635\u0644\u0648\u0627 \u0639\u0644\u0649 \u0645\u062a\u0648\u0633\u0637 73% \u062f\u0642\u0629 \u0641\u064a \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a\u2014\u0648\u0647\u0630\u0627 \u0623\u0639\u0644\u0649 \u0628\u0643\u062b\u064a\u0631 \u0645\u0646 \u0623\u064a \u0645\u062d\u0644\u0644 \u062a\u0642\u0644\u064a\u062f\u064a.",
    "\u0627\u0644\u0622\u0646\u060c \u0623\u0646\u062a \u0644\u0633\u062a \u0645\u062c\u0631\u062f \u0645\u0633\u062a\u062e\u062f\u0645. \u0623\u0646\u062a \u062c\u0632\u0621 \u0645\u0646 \u0645\u062c\u062a\u0645\u0639 \u064a\u062d\u062f\u062f \u0645\u0633\u062a\u0642\u0628\u0644 \u0627\u0644\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0631\u064a\u0627\u0636\u064a. \u0643\u0644 \u0645\u0631\u0629 \u062a\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0623\u0646\u062a \u062a\u0633\u0627\u0639\u062f \u0641\u064a \u062a\u062f\u0631\u064a\u0628 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0639\u0644\u0649 \u0622\u0644\u0627\u0641 \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a: \u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0633\u0627\u0631\u060c \u0623\u062f\u0627\u0621 \u0627\u0644\u062c\u0648\u0643\u064a\u060c \u0648\u0632\u0646 \u0627\u0644\u062d\u0635\u0627\u0646. \u0647\u0630\u0647 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u062a\u062c\u0639\u0644 \u062a\u0646\u0628\u0624\u0627\u062a \u0627\u0644\u063a\u062f \u0623\u0643\u062b\u0631 \u062f\u0642\u0629.",
    "\u0644\u0642\u062f \u0628\u0646\u064a\u062a \u0645\u064a\u0632\u0629 '\u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u0627\u0644\u0630\u0643\u064a' \u062e\u0635\u064a\u0635\u064b\u0627 \u0644\u0647\u0630\u0627 \u0627\u0644\u063a\u0631\u0636. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0642\u0633\u0645 '\u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a\u064a'\u2014\u0633\u062a\u0631\u0649 \u0643\u064a\u0641 \u062a\u0633\u0627\u0647\u0645 \u062a\u0648\u0642\u0639\u0627\u062a\u0643 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0641\u064a \u062a\u062d\u0633\u064a\u0646 \u0627\u0644\u0646\u0638\u0627\u0645. \u0625\u0646\u0647\u0627 \u0644\u064a\u0633\u062a \u0645\u062c\u0631\u062f \u0623\u0631\u0642\u0627\u0645\u060c \u0625\u0646\u0647\u0627 \u0628\u0635\u0645\u062a\u0643 \u0641\u064a \u0639\u0627\u0644\u0645 \u0627\u0644\u0631\u0647\u0627\u0646\u0627\u062a.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u062c\u0631\u0628 \u0625\u062d\u062f\u0649 \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a \u0645\u0639 \u062e\u0627\u0635\u064a\u0629 '\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u062b\u0642\u0629'\u2014\u0627\u062e\u062a\u0631 \u0633\u0628\u0627\u0642\u064b\u0627 \u0645\u0646 \u0643\u0623\u0633 \u062f\u0628\u064a \u0627\u0644\u0639\u0627\u0644\u0645\u064a \u0623\u0648 \u0643\u0646\u062a\u0627\u0643\u064a \u062f\u064a\u0631\u0628\u064a\u060c \u0648\u0627\u0646\u0638\u0631 \u0643\u064a\u0641 \u064a\u062a\u063a\u064a\u0631 \u0627\u0644\u0645\u0633\u0627\u0631 \u0645\u0639 \u0643\u0644 \u0642\u0631\u0627\u0631\u0643. P.S. \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u062a\u0627\u0628\u0639\u0648\u0646 \u062a\u0648\u0642\u0639\u0627\u062a\u0647\u0645 \u0644\u0645\u062f\u0629 30 \u064a\u0648\u0645\u064b\u0627 \u064a\u062d\u0642\u0642\u0648\u0646 \u0623\u0631\u0628\u0627\u062d\u064b\u0627 \u0623\u0639\u0644\u0649 \u0628\u0646\u0633\u0628\u0629 40%\u2014\u0623\u0646\u062a \u0639\u0644\u0649 \u0628\u0639\u062f \u062e\u0637\u0648\u0629 \u0645\u0646 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0627\u0644\u0623\u0641\u0636\u0644."
  ],
