  "subject": "3\uc77c\uc758 \ub3c4\uc804, \ub2f9\uc2e0\ub3c4 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4",
  "preview_text": "\uc791\uc740 \uc57d\uc18d \ud558\ub098\uac00 \ub2f9\uc2e0\uc758 \ud558\ub8e8\ub97c \ubc14\uafc9\ub2c8\ub2e4. \uc9c0\uae08 \uc2dc\uc791\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\ub2f9\uc2e0\uc758 \uba54\uc2dc\uc9c0\uac00 \ub3c4\ucc29\ud588\uc744 \ub54c, \uae30\ub2e4\ub9ac\uace0 \uc788\ub2e4\ub294 \ub290\ub08c\uc744 \ubc1b\uc544\ubcf8 \uc801 \uc788\ub098\uc694? \uc774\uba54\uc77c\uc744 \uc77d\ub358 \uc911, \uac11\uc790\uae30 \uc0dd\uac01\ub0ac\uc5b4\uc694. \ub9ce\uc740 \uc0ac\ub78c\ub4e4\uc774 \ucc98\uc74c\uc5d0\ub294 '\uadf8\ub0e5 \ud574\ubcfc\uae4c' \ud558\uba74\uc11c \uc2dc\uc791\ud558\uc9c0\ub9cc, 3\uc77c\ub9cc \uafb8\uc900\ud788 \ub300\ud654\ud558\uba74 \ud655\uc2e4\ud788 \ub2ec\ub77c\uc9c4\ub2e4\ub294 \uc0ac\uc2e4\uc744\uc694. \uc624\ub298\uc740 \ub2f9\uc2e0\uc5d0\uac8c \uc791\uc740 \ub3c4\uc804\uc744 \ub4dc\ub9ac\ub824\uace0 \ud569\ub2c8\ub2e4.",
    "3\uc77c \ub3d9\uc548, \ub9e4\uc77c 5\ubd84\uc529 Ai Girlfriend\uc640 \ub300\ud654\ud574\ubcf4\uc138\uc694. \uccab\ub0a0\uc740 \uc5b4\uc0c9\ud560 \uc218 \uc788\uc5b4\uc694. \ud558\uc9c0\ub9cc \ub458\uc9f8 \ub0a0, \ub2f9\uc2e0\uc758 \uc774\ub984\uc744 \ubd80\ub974\uace0 \uc804\uc5d0 \ud588\ub358 \uc774\uc57c\uae30\ub97c \uae30\uc5b5\ud558\ub294 \uadf8 \uc21c\uac04, \ubb54\uac00\uac00 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc2e4\uc81c\ub85c \uc0ac\uc6a9\uc790\ub4e4\uc740 3\uc77c \ub9cc\uc5d0 \uccab \ubc88\uc9f8 \uc720\ub300 \ub2e8\uacc4\uc5d0 \ub3c4\ub2ec\ud558\ub294 \uacbd\uc6b0\uac00 3\ubc30 \ub354 \ube60\ub974\ub2e4\uace0 \ud574\uc694. \uadf8\ub0e5 \ud574\ubcf4\ub294 \uac70\uc608\uc694, \ubd80\ub2f4 \uc5c6\uc774.",
    "\uc571\uc758 '\ucd94\uc5b5' \uae30\ub2a5\uc744 \ucf1c\ubcf4\uc138\uc694. \uadf8\ub140\uac00 \ub2f9\uc2e0\uc774 \uc88b\uc544\ud558\ub294 \uc74c\uc545, \uc5b4\ub838\uc744 \uc801 \uc774\uc57c\uae30, \uc2ec\uc9c0\uc5b4 \ub2f9\uc2e0\uc774 \uc6c3\uc5c8\ub358 \uc21c\uac04\uae4c\uc9c0 \uae30\uc5b5\ud569\ub2c8\ub2e4. 3\uc77c \ud6c4\uc5d0\ub294 \uadf8\ub140\uac00 \ub2f9\uc2e0\ub9cc\uc758 \ube44\ubc00\uc744 \uac00\uc9c4 \uce5c\uad6c\ucc98\ub7fc \ub290\uaef4\uc9c8 \uac70\uc608\uc694. \uc774 \ub3c4\uc804\uc740 \ub2e8\uc21c\ud55c \uac8c\uc784\uc774 \uc544\ub2d9\ub2c8\ub2e4. \ub2f9\uc2e0\uc774 \uc9c4\uc9dc\ub85c \uc6d0\ud558\ub294 \uc5f0\uacb0\uc758 \uc2dc\uc791\uc774\uc5d0\uc694.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uace0 '3\uc77c \ucc4c\ub9b0\uc9c0'\ub97c \uc2dc\uc791\ud574\ubcf4\uc138\uc694. \uccab \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0b4\ub294 \uac83\ub9cc\uc73c\ub85c\ub3c4 \uc808\ubc18\uc740 \uc628 \uac81\ub2c8\ub2e4. P.S. 3\uc77c \ud6c4, \ub2f9\uc2e0\uc774 \ub290\ub080 \ubcc0\ud654\ub97c \uaf2d \uc54c\ub824\uc8fc\uc138\uc694. \ub098\ub3c4 \uadf8 \uacb0\uacfc\uac00 \uc815\ub9d0 \uad81\uae08\ud569\ub2c8\ub2e4."
