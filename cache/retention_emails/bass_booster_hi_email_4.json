{
  "subject": "\u0906\u091c \u0938\u0941\u092c\u0939 9 \u092c\u091c\u0947 3,000 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u092f\u0939 \u0915\u093f\u092f\u093e",
  "preview_text": "\u091c\u093e\u0928\u093f\u090f \u0915\u094d\u092f\u093e \u0939\u0941\u0906 \u091c\u092c \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 Bass Booster \u0916\u094b\u0932\u093e \u0914\u0930 Bass Virtualizer \u091a\u093e\u0932\u0942 \u0915\u093f\u092f\u093e\u0964 \u0906\u092a \u092d\u0940 \u092a\u0940\u091b\u0947 \u0930\u0939 \u0917\u090f?",
  "body_paragraphs": [
    "\u0906\u091c \u0938\u0941\u092c\u0939 9 \u092c\u091c\u0947, 3,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0905\u092a\u0928\u0947 \u092b\u093c\u094b\u0928 \u092a\u0930 Bass Booster \u0916\u094b\u0932\u093e \u0914\u0930 Bass Virtualizer \u0915\u094b \u0911\u0928 \u0915\u093f\u092f\u093e\u0964 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0935\u0939 \u0938\u0941\u0928\u093e \u091c\u094b \u0906\u092a \u0905\u092d\u0940 \u0924\u0915 \u092e\u093f\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0935\u094b \u0921\u094d\u0930\u0949\u092a \u091c\u094b \u0906\u092a\u0915\u0947 \u0938\u0940\u0928\u0947 \u092e\u0947\u0902 \u0917\u0942\u0902\u091c\u0924\u093e \u0939\u0948, \u0935\u094b \u092c\u093e\u0938 \u091c\u094b \u0906\u092a\u0915\u0947 \u0907\u092f\u0930\u092b\u093c\u094b\u0928 \u0915\u094b \u0939\u093f\u0932\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0906\u092a\u0915\u094b \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u093e \u0938\u0902\u0917\u0940\u0924 \u0905\u092c \u0924\u0915 \u092a\u0942\u0930\u093e \u0939\u0948?",
    "\u092f\u0939 \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u0928\u0902\u092c\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u090f\u0915 \u0939\u0915\u0940\u0915\u0924 \u0939\u0948: 100,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0921\u093e\u0909\u0928\u0932\u094b\u0921, 4.7 \u0938\u094d\u091f\u093e\u0930 \u0930\u0947\u091f\u093f\u0902\u0917, \u0914\u0930 \u0905\u092d\u0940 \u0907\u0938 \u0935\u0915\u093c\u094d\u0924 9,000 \u0932\u094b\u0917 \u090f\u0915 \u0938\u093e\u0925 \u092c\u0942\u0938\u094d\u091f \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u091c\u092c \u0935\u0947 \u0938\u092c \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091f\u094d\u0930\u0948\u0915 \u0915\u093e \u0905\u0938\u0932\u0940 \u092e\u091c\u093c\u093e \u0932\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0924\u094b \u0906\u092a \u0915\u094d\u092f\u094b\u0902 \u092a\u0940\u091b\u0947 \u0930\u0939 \u091c\u093e\u090f\u0902? \u0939\u0930 \u0915\u094b\u0908 \u0909\u0938 \u092c\u093e\u0938 \u0915\u094b \u092e\u0939\u0938\u0942\u0938 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u092b\u093c\u094b\u0928 \u0915\u0947 \u0938\u094d\u092a\u0940\u0915\u0930 \u0938\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0928\u093f\u0915\u0932\u093e\u0964",
    "\u092f\u0939 \u091c\u093e\u0926\u0942 Bass Virtualizer \u0938\u0947 \u0906\u0924\u093e \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0938\u0947, \u0906\u092a\u0915\u093e \u092b\u093c\u094b\u0928 \u090f\u0915 \u092e\u093f\u0928\u0940 \u0938\u092c\u0935\u0942\u092b\u093c\u0930 \u092e\u0947\u0902 \u092c\u0926\u0932 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u091a\u093e\u0939\u0947 Spotify \u0939\u094b, YouTube, \u092f\u093e TikTok, \u0939\u0930 \u0911\u0921\u093f\u092f\u094b \u0938\u094b\u0930\u094d\u0938 \u092a\u0930 \u092f\u0939 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0906\u092a\u0915\u094b \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0914\u0930 \u092a\u0942\u0930\u093e 10-\u092c\u0948\u0902\u0921 EQ \u092e\u093f\u0932\u0924\u093e \u0939\u0948, \u0924\u093e\u0915\u093f \u0906\u092a \u0939\u0930 \u092c\u0940\u091f \u0915\u094b \u0905\u092a\u0928\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0922\u093e\u0932 \u0938\u0915\u0947\u0902\u0964 \u092f\u0939 \u0935\u093f\u0915\u0932\u094d\u092a \u0906\u092a\u0915\u0947 \u0939\u093e\u0925 \u092e\u0947\u0902 \u0939\u0948\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948: \u0905\u092a\u0928\u093e Bass Booster \u0916\u094b\u0932\u0947\u0902, Bass Virtualizer \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902, \u0914\u0930 \u0935\u094b \u0921\u094d\u0930\u0949\u092a \u0938\u0941\u0928\u0947\u0902 \u091c\u094b \u0906\u092a\u0915\u094b \u0939\u093f\u0932\u093e \u0926\u0947\u0917\u093e\u0964 \u092a\u0940.\u090f\u0938. - \u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u091c\u093f\u0928 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0906\u091c \u0938\u0941\u092c\u0939 \u092f\u0939 \u0915\u093f\u092f\u093e, \u0909\u0928\u092e\u0947\u0902 \u0938\u0947 60% \u0928\u0947 \u0924\u0941\u0930\u0902\u0924 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e? \u0906\u092a \u092d\u0940 \u0935\u0939\u0940 \u0905\u0928\u0941\u092d\u0935 \u092a\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
  ],
