  "body_paragraphs": [
    "50\u5929\u524d\u4f60\u4e0b\u8f7d\u4e86SoulPlan\uff0c\u53ef\u80fd\u53ea\u662f\u968f\u624b\u4e00\u7528\u3002\u4f46\u4eca\u5929\u6211\u60f3\u544a\u8bc9\u4f60\u4e00\u4e2a\u5c0f\u79d8\u5bc6\uff1a\u5728\u6211\u4eec\u5185\u90e8\u6d4b\u8bd5\u4e2d\uff0c\u67093%\u7684\u7528\u6237\u53d1\u73b0\u4e86\u5b83\uff0c\u7136\u540e\u4ed6\u4eec\u7684\u7ea6\u4f1a\u9891\u7387\u76f4\u63a5\u7ffb\u4e863\u500d\u3002\u4e0d\u662f\u9760\u66f4\u591a\u65f6\u95f4\uff0c\u800c\u662f\u9760\u4e00\u4e2a\u88ab\u85cf\u8d77\u6765\u7684\u5feb\u6377\u952e\u3002",
