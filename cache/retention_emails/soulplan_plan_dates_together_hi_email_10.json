{
  "subject": "\u0935\u094b 3 \u091a\u0940\u091c\u0947\u0902 \u091c\u094b \u0939\u092e\u093e\u0930\u0947 1% \u092f\u0942\u091c\u0930\u094d\u0938 \u0905\u0932\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902",
  "preview_text": "\u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0940 \u0935\u0930\u094d\u0915\u092b\u094d\u0932\u094b \u092e\u0947\u0902 \u090f\u0915 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u092a\u0948\u091f\u0930\u094d\u0928 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u094b \u0939\u0948\u0930\u093e\u0928 \u0915\u0930 \u0926\u0947\u0917\u093e\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u0939\u092e\u0928\u0947 \u0905\u092a\u0928\u0947 \u0938\u092c\u0938\u0947 \u090f\u0915\u094d\u091f\u093f\u0935 \u0915\u092a\u0932\u094d\u0938 \u0915\u0947 \u0921\u0947\u091f\u093e \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u093f\u092f\u093e\u0964 \u0914\u0930 \u0939\u092e\u0947\u0902 \u090f\u0915 \u092c\u093e\u0924 \u092a\u0924\u093e \u091a\u0932\u0940 \u091c\u093f\u0938\u0928\u0947 \u0939\u092e\u0947\u0902 \u091a\u094c\u0902\u0915\u093e \u0926\u093f\u092f\u093e\u0964 \u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a 1% \u092f\u0942\u091c\u0930\u094d\u0938 \u0938\u093f\u0930\u094d\u092b \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u2014\u0935\u0947 \u090f\u0915 \u0905\u0932\u0917 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0938\u094b\u091a\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u0947 '\u0906\u091c \u0930\u093e\u0924 \u0915\u0940 \u0921\u0947\u091f' \u0915\u094b \u090f\u0915 \u0906\u0926\u0924 \u092c\u0928\u093e \u0932\u0947\u0924\u0947 \u0939\u0948\u0902, \u0928 \u0915\u093f \u0915\u094b\u0908 \u090f\u0915 \u092c\u093e\u0930 \u0915\u093e \u0915\u093e\u092e\u0964",
    "\u0909\u0928\u0915\u093e \u0930\u093e\u091c \u0915\u094d\u092f\u093e \u0939\u0948? \u0935\u0947 \u0939\u0930 \u0930\u093e\u0924, \u091a\u093e\u0939\u0947 \u0915\u093f\u0924\u0928\u0940 \u092d\u0940 \u0925\u0915\u093e\u0928 \u0939\u094b, \u090f\u0915 \u092e\u093f\u0928\u091f \u0928\u093f\u0915\u093e\u0932\u0915\u0930 \u0905\u092a\u0928\u0947 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u092e\u0942\u0921 \u091a\u0941\u0928\u0924\u0947 \u0939\u0948\u0902\u2014\u0906\u0930\u093e\u092e\u0926\u093e\u092f\u0915, \u0930\u094b\u092e\u093e\u0902\u091a\u0915, \u092f\u093e \u0916\u093f\u0932\u0902\u0926\u0921\u093c\u093e\u0964 \u092f\u0939 \u091b\u094b\u091f\u0940 \u0938\u0940 \u0906\u0926\u0924 \u0909\u0928\u0915\u0947 \u0930\u093f\u0936\u094d\u0924\u0947 \u0915\u094b \u0930\u0942\u091f\u0940\u0928 \u0938\u0947 \u092c\u093e\u0939\u0930 \u0928\u093f\u0915\u093e\u0932 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964 \u0914\u0930 \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u0940 \u092c\u093e\u0924? \u0909\u0928\u094d\u0939\u0947\u0902 \u092a\u094d\u0932\u093e\u0928\u093f\u0902\u0917 \u0915\u093e \u0924\u0928\u093e\u0935 \u0928\u0939\u0940\u0902 \u091d\u0947\u0932\u0928\u093e \u092a\u0921\u093c\u0924\u093e\u0964",
    "\u0939\u092e\u0928\u0947 \u090f\u0915 \u092b\u0940\u091a\u0930 \u092c\u0928\u093e\u092f\u093e \u0939\u0948 \u091c\u094b \u0907\u0938\u0940 \u0935\u0930\u094d\u0915\u092b\u094d\u0932\u094b \u0915\u094b \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0906\u0938\u093e\u0928 \u092c\u0928\u093e\u0924\u093e \u0939\u0948: '\u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f'\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0915\u0930\u0947\u0902, \u0905\u092a\u0928\u093e \u092e\u0942\u0921 \u091a\u0941\u0928\u0947\u0902, \u0914\u0930 \u090f\u0906\u0908 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u092a\u0930\u092b\u0947\u0915\u094d\u091f \u0921\u0947\u091f \u0924\u0948\u092f\u093e\u0930 \u0915\u0930 \u0926\u0947\u0917\u093e\u0964 \u091c\u092c \u0906\u092a\u0915\u093e \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0907\u0938\u0947 \u0926\u0947\u0916\u0947\u0917\u093e, \u0924\u094b \u0909\u0938\u0947 \u090f\u0915 \u0916\u0942\u092c\u0938\u0942\u0930\u0924 \u092b\u0941\u0932-\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092e\u0948\u0938\u0947\u091c \u092e\u093f\u0932\u0947\u0917\u093e\u2014'\u0906\u091c \u0930\u093e\u0924 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0938\u094b\u091a\u093e'\u0964 \u092f\u0939 \u0935\u0939 \u090f\u0939\u0938\u093e\u0938 \u0939\u0948 \u091c\u094b \u092a\u094d\u0932\u093e\u0928\u093f\u0902\u0917 \u0915\u0947 \u092c\u093f\u0928\u093e \u092d\u0940 \u0930\u094b\u092e\u093e\u0902\u0938 \u0915\u094b \u091c\u093f\u0902\u0926\u093e \u0930\u0916\u0924\u093e \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u090f\u0915 \u092c\u093e\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902: \u0910\u092a \u0916\u094b\u0932\u0947\u0902, '\u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902, \u0914\u0930 \u0905\u092a\u0928\u093e \u092e\u0942\u0921 \u091a\u0941\u0928\u0947\u0902\u0964 \u0926\u0947\u0916\u093f\u090f \u0915\u093f\u0924\u0928\u093e \u0906\u0938\u093e\u0928 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u093e \u0915\u0939\u0928\u093e \u0939\u0948 \u0915\u093f \u092f\u0939 \u0909\u0928\u0915\u0940 \u0938\u092c\u0938\u0947 \u0905\u0902\u0921\u0930\u0930\u0947\u091f\u0947\u0921 \u0906\u0926\u0924 \u0939\u0948\u2014\u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092f\u0939 \u0909\u0928\u094d\u0939\u0947\u0902 \u0939\u0930 \u0930\u093e\u0924 \u090f\u0915-\u0926\u0942\u0938\u0930\u0947 \u0915\u0947 \u0915\u0930\u0940\u092c \u0932\u093e\u0924\u0940 \u0939\u0948, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u092e\u0947\u0939\u0928\u0924 \u0915\u0947\u0964"
  ],
  "cta_text": "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f' \u0906\u091c\u093c\u092e\u093e\u090f\u0902",
