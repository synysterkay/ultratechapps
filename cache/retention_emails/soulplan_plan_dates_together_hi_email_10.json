{
  "subject": "\u0939\u092e\u093e\u0930\u0947 1% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u093e \u0930\u093e\u091c\u093c \u091c\u094b \u0906\u092a\u0915\u094b \u0928\u0939\u0940\u0902 \u092a\u0924\u093e",
  "preview_text": "\u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0905\u092a\u0928\u0940 \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928\u093f\u0902\u0917 \u0915\u094b \u0915\u0948\u0938\u0947 \u092c\u0926\u0932\u0924\u0947 \u0939\u0948\u0902? \u092f\u0939 \u091f\u094d\u0930\u093f\u0915 \u0906\u092a\u0915\u0940 \u0930\u0942\u091f\u0940\u0928 \u0924\u094b\u0921\u093c \u0926\u0947\u0917\u0940\u0964",
  "body_paragraphs": [
    "\u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u092e\u0948\u0902 \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928\u093f\u0902\u0917 \u0915\u093e \u092e\u093e\u0938\u094d\u091f\u0930 \u0939\u0942\u0901, \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u092e\u0948\u0902\u0928\u0947 \u0939\u092e\u093e\u0930\u0947 \u0910\u092a \u0915\u0947 1% \u091f\u0949\u092a \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u093e \u0921\u0947\u091f \u092a\u0948\u091f\u0930\u094d\u0928 \u0926\u0947\u0916\u093e\u0964 \u0939\u0948\u0930\u093e\u0928 \u0930\u0939 \u0917\u092f\u093e\u0964 \u0935\u0947 \u0932\u094b\u0917 \u0915\u0941\u091b \u0914\u0930 \u0939\u0940 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0928\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0935\u0947 \u0915\u0948\u0938\u0947 \u0939\u0930 \u0921\u0947\u091f \u0915\u094b \u092f\u093e\u0926\u0917\u093e\u0930 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902? \u092f\u0939 \u0915\u094b\u0908 \u0930\u0949\u0915\u0947\u091f \u0938\u093e\u0907\u0902\u0938 \u0928\u0939\u0940\u0902, \u092c\u0938 \u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u0906\u0926\u0924 \u0939\u0948\u0964",
    "\u091c\u092c \u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e, \u0924\u094b \u092a\u093e\u092f\u093e \u0915\u093f \u092f\u0947 \u0932\u094b\u0917 \u090f\u0915 \u0939\u0940 \u091a\u0940\u091c\u093c \u0905\u0932\u0917 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902: \u0935\u0947 \u0905\u092a\u0928\u0940 \u0921\u0947\u091f \u0915\u094b \u092a\u0939\u0932\u0947 \u0938\u0947 \u0938\u0947\u091f\u0905\u092a \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0938\u093f\u0930\u094d\u092b \u092a\u094d\u0932\u093e\u0928 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 '\u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c\u093c \u090f\u0932\u093f\u092e\u0947\u0902\u091f' \u091c\u094b\u0921\u093c\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u0947 \u0939\u0930 \u092c\u093e\u0930 \u0905\u092a\u0928\u0947 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u094b \u0905\u0928\u091c\u093e\u0928 \u0930\u0916\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u091c \u0915\u094d\u092f\u093e \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u093e \u0939\u0948\u0964 \u092f\u0939\u0940 \u0909\u0928\u0915\u093e \u0930\u093e\u091c\u093c \u0939\u0948\u0964",
    "\u0938\u094b\u0932\u092a\u094d\u0932\u093e\u0928 \u092e\u0947\u0902 \u090f\u0915 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u093f\u0938\u0947 '\u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c\u093c \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928\u0930' \u0915\u0939\u0924\u0947 \u0939\u0948\u0902\u0964 \u091f\u0949\u092a \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0907\u0938\u0940 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u0947 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u094b \u092c\u093f\u0928\u093e \u092c\u0924\u093e\u090f \u092a\u0942\u0930\u0940 \u0921\u0947\u091f \u0938\u0947\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a \u092d\u0940 \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902: \u092c\u0938 \u090f\u0915 \u0921\u0947\u091f \u0906\u0907\u0921\u093f\u092f\u093e \u091a\u0941\u0928\u0947\u0902, \u092c\u091c\u091f \u0938\u0947\u091f \u0915\u0930\u0947\u0902, \u0914\u0930 \u092b\u093f\u0930 '\u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c\u093c \u092e\u094b\u0921' \u0911\u0928 \u0915\u0930\u0947\u0902\u0964 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u094b \u092a\u0924\u093e \u092d\u0940 \u0928\u0939\u0940\u0902 \u091a\u0932\u0947\u0917\u093e, \u0914\u0930 \u0935\u094b \u0939\u0948\u0930\u093e\u0928 \u0930\u0939 \u091c\u093e\u090f\u0917\u093e\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c\u093c \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928\u0930' \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0905\u0917\u0932\u0940 \u0921\u0947\u091f \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964 \u0906\u092a \u0926\u0947\u0916\u0947\u0902\u0917\u0947 \u0915\u093f \u0930\u0942\u091f\u0940\u0928 \u0915\u0948\u0938\u0947 \u0917\u093e\u092f\u092c \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u2013 \u091c\u092c \u0906\u092a \u092f\u0939 \u0915\u0930\u0947\u0902\u0917\u0947, \u0924\u094b \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0907\u090f\u0917\u093e \u0915\u093f \u0906\u092a\u0915\u0947 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u093e \u0930\u093f\u090f\u0915\u094d\u0936\u0928 \u0915\u094d\u092f\u093e \u0925\u093e\u0964 \u092e\u0941\u091d\u0947 \u092a\u0942\u0930\u093e \u092f\u0915\u0940\u0928 \u0939\u0948 \u0915\u093f \u0935\u094b \u0906\u092a\u0915\u094b \u0914\u0930 \u092d\u0940 \u092a\u094d\u092f\u093e\u0930 \u0915\u0930\u0928\u0947 \u0932\u0917\u0947\u0917\u093e\u0964"
  ],
  "cta_text": "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c\u093c \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928\u0930 \u0906\u091c\u093c\u092e\u093e\u090f\u0902",
