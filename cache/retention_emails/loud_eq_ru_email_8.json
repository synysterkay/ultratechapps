{
  "subject": "\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0410\u043d\u0442\u043e\u043d\u0430 \u0438\u0437 \u043c\u0435\u0442\u0440\u043e",
  "preview_text": "\u041a\u0430\u043a \u043e\u043d \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b \u043d\u0430\u043f\u0440\u044f\u0433\u0430\u0442\u044c \u0441\u043b\u0443\u0445 \u0438 \u043d\u0430\u0447\u0430\u043b \u0441\u043b\u044b\u0448\u0430\u0442\u044c \u043a\u0430\u0436\u0434\u043e\u0435 \u0441\u043b\u043e\u0432\u043e \u0434\u0430\u0436\u0435 \u043d\u0430 \u0448\u0443\u043c\u043d\u043e\u0439 \u0432\u0435\u0442\u043a\u0435. \u041f\u043e\u0445\u043e\u0436\u0435 \u043d\u0430 \u0432\u0430\u0448\u0443 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044e?",
  "body_paragraphs": [
    "\u0410\u043d\u0442\u043e\u043d \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u0435\u0437\u0434\u0438\u043b \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0443 40 \u043c\u0438\u043d\u0443\u0442. \u041c\u0435\u0442\u0440\u043e, \u0448\u0443\u043c, \u0442\u043e\u043b\u043f\u0430. \u041e\u043d \u0432\u043a\u043b\u044e\u0447\u0430\u043b \u043f\u043e\u0434\u043a\u0430\u0441\u0442 \u043d\u0430 \u043f\u043e\u043b\u043d\u0443\u044e \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u2014 \u0438 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u0441\u043b\u044b\u0448\u0430\u043b \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0431\u0440\u044b\u0432\u043a\u0438. \u0414\u0438\u0430\u043b\u043e\u0433\u0438 \u0442\u0435\u0440\u044f\u043b\u0438\u0441\u044c \u043f\u043e\u0434 \u0433\u0440\u043e\u0445\u043e\u0442\u043e\u043c \u0432\u0430\u0433\u043e\u043d\u043e\u0432. \u041e\u043d \u0434\u0443\u043c\u0430\u043b: \u00ab\u041c\u043e\u0436\u0435\u0442, \u0432 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u0445 \u0434\u0435\u043b\u043e?\u00bb \u041d\u043e \u043d\u0435\u0442 \u2014 AirPods Pro, \u0438\u0441\u043f\u0440\u0430\u0432\u043d\u044b\u0435. \u041f\u0440\u043e\u0441\u0442\u043e \u0437\u0432\u0443\u043a \u043d\u0435 \u043f\u0440\u043e\u0431\u0438\u0432\u0430\u043b \u0448\u0443\u043c.",
    "\u041e\u0434\u043d\u0430\u0436\u0434\u044b \u043e\u043d \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e \u043e\u0442\u043a\u0440\u044b\u043b \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 Loud EQ. \u041d\u0430\u0436\u0430\u043b \u043a\u043d\u043e\u043f\u043a\u0443 \u00ab\u041e\u043f\u0442\u0438\u043c\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u00bb \u2014 \u0438 \u0432\u0441\u0451 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e\u0441\u044c. \u0413\u043e\u043b\u043e\u0441 \u0432\u0435\u0434\u0443\u0449\u0435\u0433\u043e \u0441\u0442\u0430\u043b \u0447\u0451\u0442\u043a\u0438\u043c, \u0431\u0443\u0434\u0442\u043e \u0442\u043e\u0442 \u0441\u0438\u0434\u0435\u043b \u0440\u044f\u0434\u043e\u043c. \u0413\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0432\u044b\u0440\u043e\u0441\u043b\u0430, \u043d\u043e \u0431\u0435\u0437 \u0445\u0440\u0438\u043f\u043e\u0432 \u0438 \u0438\u0441\u043a\u0430\u0436\u0435\u043d\u0438\u0439. \u0410\u043d\u0442\u043e\u043d \u0434\u0430\u0436\u0435 \u043d\u0435 \u043f\u043e\u0432\u0435\u0440\u0438\u043b \u0441\u043d\u0430\u0447\u0430\u043b\u0430. \u0422\u0435\u043f\u0435\u0440\u044c \u043e\u043d \u043d\u0435 \u0432\u044b\u043a\u0440\u0443\u0447\u0438\u0432\u0430\u0435\u0442 \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a \u043d\u0430 100% \u2014 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u00ab\u041f\u043e\u0434\u043a\u0430\u0441\u0442\u00bb \u0438 \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u0442.",
    "\u0412 Loud EQ \u0435\u0441\u0442\u044c \u0444\u0443\u043d\u043a\u0446\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0430\u043c\u0430 \u043f\u043e\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0434 \u0442\u0432\u043e\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438 \u0438 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435. \u041e\u0434\u0438\u043d \u0442\u0430\u043f \u2014 \u0438 \u0437\u0432\u0443\u043a \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f loud \u0442\u0430\u043c, \u0433\u0434\u0435 \u043d\u0443\u0436\u043d\u043e, \u0438 clear \u0431\u0435\u0437 \u043f\u043e\u0442\u0435\u0440\u0438 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430. \u042d\u0442\u043e \u043d\u0435 \u043c\u0430\u0433\u0438\u044f, \u044d\u0442\u043e 5-\u043f\u043e\u043b\u043e\u0441\u043d\u044b\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u0438 +200% \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u044f \u0431\u0435\u0437 \u0432\u0440\u0435\u0434\u0430 \u0434\u043b\u044f \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u043e\u0432. \u0418 \u0434\u0430, \u0442\u0432\u043e\u0438 \u0443\u0448\u0438 \u0441\u043a\u0430\u0436\u0443\u0442 \u0441\u043f\u0430\u0441\u0438\u0431\u043e \u2014 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0441\u043b\u0435\u0434\u0438\u0442 \u0437\u0430 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u044b\u043c \u0443\u0440\u043e\u0432\u043d\u0435\u043c.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043d\u0430\u0436\u043c\u0438 \u00ab\u041e\u043f\u0442\u0438\u043c\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u00bb. \u0423\u0441\u043b\u044b\u0448\u0438\u0448\u044c \u0440\u0430\u0437\u043d\u0438\u0446\u0443 \u0437\u0430 10 \u0441\u0435\u043a\u0443\u043d\u0434.\nP.S. \u0410\u043d\u0442\u043e\u043d \u0442\u0435\u043f\u0435\u0440\u044c \u0441\u043b\u0443\u0448\u0430\u0435\u0442 \u0430\u0443\u0434\u0438\u043e\u043a\u043d\u0438\u0433\u0438 \u0434\u0430\u0436\u0435 \u0432 \u0447\u0430\u0441 \u043f\u0438\u043a. \u0411\u0435\u0437 \u043d\u0430\u043f\u0440\u044f\u0433\u0430. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u2014 \u044d\u0442\u043e \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e."
  ],
