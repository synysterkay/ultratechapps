{
  "subject": "30 \u064a\u0648\u0645\u0627 \u0645\u0639\u0646\u0627.. \u0648\u0647\u0630\u0647 \u0642\u0635\u062a\u0643",
  "preview_text": "\u0623\u0646\u062a \u0627\u0644\u0622\u0646 \u062c\u0632\u0621 \u0645\u0646 \u0645\u062c\u062a\u0645\u0639 \u0645\u062e\u062a\u0644\u0641.. \u0645\u0646 \u064a\u0642\u0631\u0631 \u0628\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0644\u064a\u0633 \u0628\u0627\u0644\u0639\u0648\u0627\u0637\u0641",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0645\u0639\u064a: 30 \u064a\u0648\u0645\u0627 \u0645\u0636\u062a \u0645\u0646\u0630 \u0623\u0646 \u0628\u062f\u0623\u062a \u0631\u062d\u0644\u062a\u0643 \u0645\u0639 Predictify. \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0641\u062a\u0631\u0629\u060c \u0627\u0646\u0636\u0645\u0645\u062a \u0625\u0644\u0649 \u0622\u0644\u0627\u0641 \u0627\u0644\u0645\u0634\u062c\u0639\u064a\u0646 \u0627\u0644\u0630\u064a\u0646 \u0627\u062e\u062a\u0627\u0631\u0648\u0627 \u0623\u0646 \u064a\u0643\u0648\u0646\u0648\u0627 \u0623\u0643\u062b\u0631 \u0630\u0643\u0627\u0621 \u0641\u064a \u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u0628\u0627\u0631\u064a\u0627\u062a. \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u062a\u062e\u0645\u064a\u0646\u060c \u0628\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u062d\u0642\u064a\u0642\u064a\u0629 \u0645\u0646 \u0622\u0644\u0627\u0641 \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0644\u0643\u0644 \u0645\u0628\u0627\u0631\u0627\u0629. \u0623\u0646\u062a \u0627\u0644\u0622\u0646 \u062c\u0632\u0621 \u0645\u0646 \u0645\u062c\u0645\u0648\u0639\u0629 \u062a\u0646\u0645\u0648 \u064a\u0648\u0645\u064a\u0627\u060c \u062a\u0641\u0643\u0631 \u0628\u0634\u0643\u0644 \u0645\u062e\u062a\u0644\u0641 \u0639\u0646 90% \u0645\u0646 \u0627\u0644\u0645\u0634\u062c\u0639\u064a\u0646.",
    "\u0641\u064a \u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0645\u0627\u0636\u064a\u060c \u0634\u0627\u0647\u062f\u062a \u062a\u062d\u0644\u064a\u0644\u0627 \u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0628\u0631\u0634\u0644\u0648\u0646\u0629 \u0648\u0631\u064a\u0627\u0644 \u0645\u062f\u0631\u064a\u062f. \u0628\u064a\u0646\u0645\u0627 \u0643\u0627\u0646 \u0627\u0644\u062c\u0645\u064a\u0639 \u064a\u062a\u062d\u062f\u062b \u0639\u0646 \u0627\u0644\u0639\u0627\u0637\u0641\u0629\u060c \u0643\u0646\u062a \u0623\u0646\u062a \u062a\u0639\u0631\u0641 \u0623\u0646 \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a \u062a\u0634\u064a\u0631 \u0625\u0644\u0649 68% \u0641\u0631\u0635\u0629 \u0644\u0641\u0648\u0632 \u0627\u0644\u0628\u0644\u0648\u063a\u0631\u0627\u0646\u0627 \u0628\u0646\u0627\u0621 \u0639\u0644\u0649 xG \u0648\u0627\u0644\u0636\u063a\u0637 \u0627\u0644\u062f\u0641\u0627\u0639\u064a. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0641\u0631\u0642: \u0623\u0646\u062a \u0644\u0627 \u062a\u062a\u0627\u0628\u0639 \u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645 \u0641\u0642\u0637\u060c \u0623\u0646\u062a \u062a\u0641\u0647\u0645\u0647\u0627.",
    "\u0644\u0643\u0646 \u0627\u0644\u0642\u0648\u0629 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629 \u062a\u0623\u062a\u064a \u0639\u0646\u062f\u0645\u0627 \u062a\u0634\u0627\u0631\u0643 \u0647\u0630\u0647 \u0627\u0644\u0645\u0639\u0631\u0641\u0629. \u0645\u062c\u062a\u0645\u0639\u0627\u062a Predictify \u0647\u064a \u0645\u0643\u0627\u0646\u0643 \u0644\u0645\u0646\u0627\u0642\u0634\u0629 Prediction of the Day\u060c \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u062a \u0639\u0644\u0649 \u0623\u0641\u0636\u0644 \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a\u060c \u0648\u0627\u062e\u062a\u0628\u0627\u0631 \u0630\u0643\u0627\u0626\u0643 \u0627\u0644\u0643\u0631\u0648\u064a \u0641\u064a IQ Quiz. \u0643\u0644 \u064a\u0648\u0645\u060c \u0622\u0644\u0627\u0641 \u0627\u0644\u0645\u0634\u062c\u0639\u064a\u0646 \u064a\u062a\u0628\u0627\u062f\u0644\u0648\u0646 \u0627\u0644\u0631\u0624\u0649 \u0647\u0646\u0627. \u0647\u0644 \u062c\u0631\u0628\u062a \u0645\u064a\u0632\u0629 AI Chat\u061f \u0627\u0633\u0623\u0644 \u0623\u064a \u0633\u0624\u0627\u0644 \u0639\u0646 \u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u063a\u062f \u0648\u0627\u062d\u0635\u0644 \u0639\u0644\u0649 \u0625\u062c\u0627\u0628\u0629 \u0641\u0648\u0631\u064a\u0629 \u0645\u062f\u0639\u0648\u0645\u0629 \u0628\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062a\u0648\u062c\u0647 \u0625\u0644\u0649 \u0642\u0633\u0645 \u0627\u0644\u0645\u062c\u062a\u0645\u0639\u0627\u062a. \u0627\u0646\u0636\u0645 \u0625\u0644\u0649 \u0646\u0642\u0627\u0634 Prediction of the Day \u0648\u0634\u0627\u0631\u0643 \u0631\u0623\u064a\u0643. \u0647\u0630\u0647 \u0645\u062c\u0631\u062f \u0628\u062f\u0627\u064a\u0629.. \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u062a\u062d\u062f\u064a\u0627\u062a \u0648\u0627\u0644\u062c\u0648\u0627\u0626\u0632 \u062a\u0646\u062a\u0638\u0631\u0643. P.S. \u0647\u0644 \u062a\u0639\u0644\u0645 \u0623\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0634\u0627\u0631\u0643\u0648\u0646 \u0641\u064a \u0627\u0644\u0645\u062c\u062a\u0645\u0639\u0627\u062a \u064a\u062d\u0642\u0642\u0648\u0646 \u062a\u0648\u0642\u0639\u0627\u062a \u0623\u0641\u0636\u0644 \u0628\u0646\u0633\u0628\u0629 40%\u061f \u0627\u0628\u062f\u0623 \u0627\u0644\u064a\u0648\u0645."
