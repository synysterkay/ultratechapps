{
  "subject": "\u0627\u0644\u0623\u0633\u0637\u0648\u0631\u0629 \u0627\u0644\u062a\u064a \u064a\u0635\u062f\u0642\u0647\u0627 \u0627\u0644\u062c\u0645\u064a\u0639 \u0639\u0646 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0639\u0627\u0644\u064a",
  "preview_text": "\u0647\u0644 \u062a\u0639\u062a\u0642\u062f \u0623\u0646 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u064a\u0636\u0631 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a\u061f \u0647\u0630\u0627 \u063a\u064a\u0631 \u0635\u062d\u064a\u062d \u062a\u0645\u0627\u0645\u064b\u0627. \u0625\u0644\u064a\u0643 \u0627\u0644\u062f\u0644\u064a\u0644 \u0645\u0646 \u062a\u0637\u0628\u064a\u0642\u0643.",
  "body_paragraphs": [
    "\u0647\u0646\u0627\u0643 \u0623\u0633\u0637\u0648\u0631\u0629 \u0634\u0627\u0626\u0639\u0629: \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0623\u0643\u062b\u0631 \u0645\u0646 100% \u064a\u062d\u0631\u0642 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a \u0623\u0648 \u064a\u0634\u0648\u0647 \u0627\u0644\u062c\u0648\u062f\u0629. \u0627\u0644\u062c\u0645\u064a\u0639 \u064a\u0631\u062f\u062f\u0647\u0627. \u062d\u062a\u0649 \u0628\u0639\u0636 \u062e\u0628\u0631\u0627\u0621 \u0627\u0644\u0635\u0648\u062a \u064a\u0631\u0648\u062c\u0648\u0646 \u0644\u0647\u0627. \u0644\u0643\u0646\u0647\u0627 \u062e\u0627\u0637\u0626\u0629 \u062a\u0645\u0627\u0645\u064b\u0627.",
    "\u0627\u0644\u062d\u0642\u064a\u0642\u0629 \u0623\u0646 \u0627\u0644\u062a\u0634\u0648\u064a\u0647 \u064a\u062d\u062f\u062b \u0628\u0633\u0628\u0628 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0631\u062f\u064a\u0626\u0629 \u0627\u0644\u062a\u064a \u062a\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u062f\u0648\u0646 \u062a\u062d\u0643\u0645. \u0645\u062d\u0631\u0643\u0646\u0627 \u064a\u0639\u0645\u0644 \u0628\u0634\u0643\u0644 \u0645\u062e\u062a\u0644\u0641: \u064a\u0632\u064a\u062f \u0627\u0644\u0635\u0648\u062a \u062d\u062a\u0649 200% \u0645\u0639 \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u0646\u0642\u0627\u0621. \u0627\u062e\u062a\u0628\u0631\u0646\u0627\u0647 \u0639\u0644\u0649 \u0645\u0626\u0627\u062a \u0627\u0644\u0623\u062c\u0647\u0632\u0629. \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a \u0644\u0627 \u062a\u062d\u062a\u0631\u0642. \u0627\u0644\u0635\u0648\u062a \u064a\u0628\u0642\u0649 \u0646\u0638\u064a\u0641\u064b\u0627.",
    "\u0641\u064a Volume Booster Pro\u060c \u0644\u0627 \u0646\u062e\u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u062d\u0642\u064a\u0642\u0629. slider \u0627\u0644\u0635\u0648\u062a \u0645\u0635\u0645\u0645 \u0644\u064a\u0645\u0646\u062d\u0643 \u0627\u0644\u0642\u0648\u0629 \u062f\u0648\u0646 \u062e\u0648\u0641. \u062c\u0631\u0628 \u0631\u0641\u0639\u0647 \u0625\u0644\u0649 150% \u0627\u0644\u0622\u0646 \u2014 \u0633\u062a\u0633\u0645\u0639 \u0627\u0644\u0641\u0631\u0642 \u0628\u0646\u0641\u0633\u0643. \u0644\u0627 \u0625\u0639\u0644\u0627\u0646\u0627\u062a. \u0644\u0627 \u0625\u0634\u0639\u0627\u0631\u0627\u062a. \u0641\u0642\u0637 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0646\u0642\u064a.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0627\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0625\u0644\u0649 150% \u0639\u0644\u0649 \u0623\u064a \u0645\u0642\u0637\u0639. \u0627\u0633\u0645\u0639 \u0627\u0644\u0641\u0631\u0642 \u0628\u0646\u0641\u0633\u0643. P.S. \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u062a\u0639\u0645\u0644 \u0645\u0639 \u0643\u0644 \u0627\u0644\u0645\u0635\u0627\u062f\u0631: \u064a\u0648\u062a\u064a\u0648\u0628\u060c \u0633\u0628\u0648\u062a\u064a\u0641\u0627\u064a\u060c \u0628\u0648\u062f\u0643\u0627\u0633\u062a\u060c \u062d\u062a\u0649 \u0627\u0644\u0623\u0644\u0639\u0627\u0628. \u062c\u0631\u0628\u0647\u0627."
  ],
