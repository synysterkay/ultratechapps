  "subject": "\u4f60\u548c800\u5bf9\u592b\u59bb\u7684\u79d8\u5bc6",
  "preview_text": "30\u5929\u524d\u4e0b\u8f7d\u65f6\u4f60\u662f\u7b2c1\u4e2a\uff0c\u73b0\u5728\u5df2\u7ecf\u662f800\u4eba\u4e2d\u7684\u4e00\u5458\u3002\u770b\u770b\u4ed6\u4eec\u5728\u505a\u4ec0\u4e48\u3002",
  "body_paragraphs": [
    "30\u5929\u524d\u4f60\u7b2c\u4e00\u6b21\u6253\u5f00SoulPlan\u65f6\uff0c\u8fd9\u4e2a\u793e\u533a\u91cc\u53ea\u6709\u4f60\u4e00\u4e2a\u4eba\u3002\u73b0\u5728\uff0c\u5df2\u7ecf\u6709800\u5bf9\u592b\u59bb\u5728\u8fd9\u91cc\u6084\u6084\u6539\u53d8\u4ed6\u4eec\u7684\u7ea6\u4f1a\u65b9\u5f0f\u3002\u4ed6\u4eec\u4e0d\u662f\u5728\u8ba1\u5212\uff0c\u800c\u662f\u5728\u521b\u9020\u2014\u2014\u6bcf\u4e00\u4e2a\u665a\u4e0a\uff0c\u90fd\u6709\u4e00\u4e2a\u6545\u4e8b\u5728\u53d1\u751f\u3002",
    "\u6628\u665a\uff0c\u6709\u4e00\u5bf9\u592b\u59bb\u7528\u4eca\u665a\u7ea6\u4f1a\u529f\u80fd\u9009\u4e86\u4e00\u4e2a\u6cbb\u6108\u6a21\u5f0f\u3002\u4ed6\u4eec\u6ca1\u544a\u8bc9\u6211\u7ec6\u8282\uff0c\u4f46\u7b2c\u4e8c\u5929\u65e9\u4e0a\uff0c\u5979\u5728\u65f6\u95f4\u7ebf\u4e0a\u5199\u4e86\u4e00\u53e5\uff1a\u4ed6\u7ec8\u4e8e\u8bb0\u5f97\u6211\u559c\u6b22\u4ec0\u4e48\u4e86\u3002\u8fd9\u53e5\u8bdd\u4e0d\u662f\u53d1\u7ed9\u6211\u7684\uff0c\u662f\u7ed9\u6574\u4e2a\u793e\u533a\u7684\u3002\u4f60\u4e5f\u80fd\u611f\u53d7\u5230\u90a3\u79cd\u4e1c\u897f\u5417\uff1f\u90a3\u79cd\u2014\u2014\u4f60\u4e0d\u662f\u5728\u5b64\u519b\u594b\u6218\u7684\u611f\u89c9\u3002",
    "\u6253\u5f00\u4f60\u7684\u4e3b\u9875\uff0c\u770b\u770b\u4f60\u548c\u4f34\u4fa3\u7684\u5934\u50cf\u5e76\u5217\u5728\u4e00\u8d77\u3002\u90a3\u4e2a\u4f60\u4eec\u4fe9\u7684\u540d\u5b57\uff0c\u90a3\u4e2a\u5c0f\u5c0f\u7684\u5fbd\u7ae0\uff0c\u90fd\u5728\u544a\u8bc9\u4f60\uff1a\u4f60\u4eec\u662f\u8fd9800\u5bf9\u4e2d\u7684\u4e00\u90e8\u5206\u3002\u4f46\u771f\u6b63\u8ba9\u4f60\u5c5e\u4e8e\u8fd9\u91cc\u7684\uff0c\u662f\u5f53\u4f60\u6253\u5f00\u4eca\u665a\u7ea6\u4f1a\uff0c\u770b\u5230\u4e00\u5f20\u5361\u7247\u4e0a\u5199\u7740\uff1a\u4eca\u665a\uff0c\u505a\u4e2a\u5192\u9669\u5bb6\u3002\u7136\u540e\u4f60\u70b9\u4e0b\u53bb\uff0c30\u79d2\u540e\uff0c\u4eca\u665a\u5c31\u6709\u4e86\u5f62\u72b6\u3002",
    "\u73b0\u5728\uff0c\u53bb\u505a\u4e00\u4ef6\u4e8b\uff1a\u6253\u5f00\u4eca\u665a\u7ea6\u4f1a\uff0c\u9009\u4e00\u4e2a\u4f60\u4eec\u4ece\u672a\u8bd5\u8fc7\u7684\u6a21\u5f0f\u3002\u7136\u540e\uff0c\u53bb\u65f6\u95f4\u7ebf\u4e0a\u770b\u4e00\u773c\u2014\u2014\u90a3\u91cc\u6709800\u5bf9\u592b\u59bb\u7684\u56de\u5fc6\u5728\u7b49\u4f60\u3002P.S. \u5982\u679c\u4f60\u8fd8\u6ca1\u8bd5\u8fc7\u613f\u671b\u6e05\u5355\uff0c\u90a3\u53ef\u80fd\u662f\u4f60\u4eca\u665a\u7684\u4e0b\u4e00\u7ad9\u3002"
