{
  "subject": "\u6709\u4e00\u4e2a\u79d8\u5bc6\uff0c230\u5bf9\u60c5\u4fa3\u90fd\u5728\u7528",
  "preview_text": "\u4f60\u77e5\u9053\u5417\uff1f\u4f60\u5df2\u7ecf\u662f\u8fd9\u4e2a\u7279\u522b\u7fa4\u4f53\u7684\u4e00\u5458\u4e86\u3002\u6253\u5f00\u770b\u770b\uff0c\u4e3a\u4ec0\u4e48\u4ed6\u4eec\u6bd4\u5176\u4ed6\u4eba\u66f4\u6d6a\u6f2b\u3002",
  "body_paragraphs": [
    "\u544a\u8bc9\u4f60\u4e00\u4e2a\u79d8\u5bc6\uff1a\u4f60\u4e0d\u662f\u968f\u4fbf\u4e0b\u8f7d\u8fd9\u4e2aApp\u7684\u3002230\u5bf9\u60c5\u4fa3\u5df2\u7ecf\u52a0\u5165\u4e86\u6211\u4eec\uff0c\u800c\u4ed6\u4eec\u6709\u4e00\u4e2a\u5171\u540c\u70b9\u2014\u2014\u4ed6\u4eec\u62d2\u7edd\u8ba9\u7231\u60c5\u53d8\u5f97\u5e73\u6de1\u3002\u4f60\u4e5f\u662f\u5176\u4e2d\u4e4b\u4e00\u3002",
    "\u4f60\u77e5\u9053\u4ed6\u4eec\u600e\u4e48\u505a\u7684\u5417\uff1f\u4ed6\u4eec\u4e0d\u518d\u4e34\u65f6\u62b1\u4f5b\u811a\u60f3\u7ea6\u4f1a\uff0c\u800c\u662f\u7528SoulPlan\u5077\u5077\u8ba1\u5212\u60ca\u559c\u300292%\u7684\u4eba\u8bf4\uff0c\u8fd9\u8ba9\u4ed6\u4eec\u611f\u89c9\u66f4\u88ab\u5728\u4e4e\u3002\u4f60\u4e0d\u60f3\u6210\u4e3a\u8fd992%\u7684\u4e00\u5458\u5417\uff1f",
    "\u6253\u5f00App\uff0c\u770b\u770b\u4f60\u7684\u2018\u60ca\u559c\u7ea6\u4f1a\u89c4\u5212\u5668\u2019\u3002\u90a3\u4e2a\u529f\u80fd\u4e0d\u662f\u6446\u8bbe\u2014\u2014\u5b83\u662f\u8ba9\u4f60\u6210\u4e3a\u6d6a\u6f2b\u9ad8\u624b\u7684\u5173\u952e\u3002\u968f\u4fbf\u9009\u4e00\u4e2a\u504f\u597d\uff0c\u7cfb\u7edf\u4f1a\u81ea\u52a8\u751f\u6210\u4e00\u4e2a\u4e13\u5c5e\u7ea6\u4f1a\uff0c\u8fde\u5730\u70b9\u90fd\u5e2e\u4f60\u627e\u597d\u4e86\u3002",
    "\u4eca\u5929\u8bd5\u8bd5\u5427\uff1a\u70b9\u5f00\u2018\u60ca\u559c\u7ea6\u4f1a\u2019\uff0c\u8bbe\u5b9a\u4e00\u4e2a\u9884\u7b97\u548c\u5174\u8da3\u3002\u7136\u540e\uff0c\u7b49\u7740\u770b\u4f60\u4f34\u4fa3\u8138\u4e0a\u7684\u7b11\u5bb9\u3002P.S. \u4f60\u77e5\u9053\u5927\u591a\u6570\u60c5\u4fa3\u72af\u7684\u6700\u5927\u9519\u8bef\u662f\u4ec0\u4e48\u5417\uff1f\u4ed6\u4eec\u4e0d\u8bb0\u5f55\u7ea6\u4f1a\u5386\u53f2\u3002\u6211\u4eec\u5e2e\u4f60\u8bb0\u2014\u2014\u8fd9\u6837\u4f60\u6c38\u8fdc\u4e0d\u4f1a\u91cd\u590d\u65e0\u804a\u7684\u7ea6\u4f1a\u3002\u6253\u5f00App\uff0c\u770b\u770b\u4f60\u7684\u2018\u7ea6\u4f1a\u5386\u53f2\u2019\u5427\u3002"
