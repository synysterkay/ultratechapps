{
  "subject": "\u90a3\u4e2a\u88ab\u4f60\u8df3\u8fc7\u7684\u6309\u94ae 87%\u7684\u4eba\u540e\u6094\u4e86",
  "preview_text": "\u6628\u665a3\u5206\u949f\u641e\u5b9a\u7684\u7ea6\u4f1a\uff0c\u5176\u5b9e\u85cf\u5728\u6700\u4e0d\u8d77\u773c\u7684\u5730\u65b9\u3002\u70b9\u5f00\u770b\u770b\u4f60\u9519\u8fc7\u4e86\u4ec0\u4e48\u3002",
  "body_paragraphs": [
    "\u6628\u665a\u4f60\u6253\u5f00SoulPlan\u65f6\uff0c\u662f\u4e0d\u662f\u76f4\u63a5\u6ed1\u8d70\u4e86\uff1f\u5927\u90e8\u5206\u4eba\u90fd\u5728\u627e\u590d\u6742\u7684\u8ba1\u5212\uff0c\u5374\u9519\u8fc7\u4e86\u5c4f\u5e55\u4e2d\u592e\u90a3\u4e2a\u5c0f\u5361\u7247\u2014\u2014\u5b83\u53eb'\u4eca\u665a\u7ea6\u4f1a'\uff0c\u4e00\u4e2a\u4f60\u51e0\u4e4e\u6ca1\u78b0\u7684\u6309\u94ae\u3002",
    "\u6211\u89c1\u8fc7\u592a\u591a\u60c5\u4fa3\u82b1\u534a\u5c0f\u65f6\u7ffb\u83dc\u5355\u3001\u6311\u7535\u5f71\u3001\u4e92\u76f8\u95ee'\u4f60\u60f3\u5e72\u561b'\uff0c\u6700\u540e\u762b\u5728\u6c99\u53d1\u4e0a\u5237\u624b\u673a\u3002\u4f46\u4f60\u77e5\u9053\u5417\uff1f87%\u7684\u7528\u6237\u7b2c\u4e00\u6b21\u7528\u8fd9\u4e2a\u529f\u80fd\u65f6\uff0c\u90fd\u8bf4\u4e86\u540c\u4e00\u53e5\u8bdd\uff1a'\u8fd9\u4e48\u7b80\u5355\uff1f'\u3002",
    "\u771f\u76f8\u662f\uff1a'\u4eca\u665a\u7ea6\u4f1a'\u4e0d\u662f\u968f\u4fbf\u9009\u4e2a\u6d3b\u52a8\u3002\u4f60\u70b9\u4e00\u4e0b'\u6e29\u99a8'\u6216'\u5192\u9669'\uff0cAI\u4f1a\u79d2\u51fa\u4e00\u5957\u5b8c\u6574\u65b9\u6848\u2014\u2014\u4ece\u9910\u5385\u5230\u5c0f\u60ca\u559c\uff0c\u8fde\u5bf9\u65b9\u6536\u5230\u65f6\u7684\u8868\u60c5\u90fd\u66ff\u4f60\u7b97\u597d\u4e86\u3002\u53e6\u4e00\u534a\u6253\u5f00\u624b\u673a\u65f6\uff0c\u770b\u5230\u7684\u4e0d\u662f\u4e00\u4e2a\u901a\u77e5\uff0c\u800c\u662f\u4e00\u53e5'\u4eca\u665a\u7279\u610f\u4e3a\u4f60'\u3002",
    "\u73b0\u5728\u6253\u5f00SoulPlan\uff0c\u70b9\u90a3\u4e2a\u4e00\u76f4\u88ab\u4f60\u5ffd\u7565\u7684\u5361\u7247\u3002\u4eca\u665a\u522b\u8ba9\u8ba1\u5212\u5077\u8d70\u6d6a\u6f2b\u3002\nP.S. \u7528\u4e86\u8fd9\u4e2a\u529f\u80fd\u7684\u60c5\u4fa3\uff0c\u4e0b\u4e2a\u6708\u7ea6\u4f1a\u6b21\u6570\u7ffb4\u500d\u2014\u2014\u4e0d\u662f\u5439\u7684\uff0c\u662f\u6570\u636e\u8bf4\u7684\u3002"
  ],
