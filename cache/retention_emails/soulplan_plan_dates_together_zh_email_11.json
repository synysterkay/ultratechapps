{
  "subject": "\u7ea6\u4f1a\u8d8a\u9891\u7e41\u611f\u60c5\u8d8a\u597d\uff1f\u5927\u9519\u7279\u9519",
  "preview_text": "\u4f60\u4ee5\u4e3a\u5929\u5929\u7ea6\u4f1a\u5c31\u751c\u871c\uff1f\u771f\u76f8\u4f1a\u8ba9\u4f60\u91cd\u65b0\u601d\u8003\u3002",
  "body_paragraphs": [
    "\u6211\u6253\u8d4c\u4f60\u542c\u8fc7\u8fd9\u53e5\u8bdd\uff1a\u7ea6\u4f1a\u8d8a\u591a\uff0c\u611f\u60c5\u8d8a\u751c\u3002\u5bf9\u5427\uff1f\u51e0\u4e4e\u6240\u6709\u60c5\u4fa3\u90fd\u8fd9\u4e48\u60f3\u3002\u4f46\u6700\u8fd1\u4e00\u9879\u7814\u7a76\u76f4\u63a5\u6253\u8138\u4e86\u2014\u2014\u9891\u7e41\u7ea6\u4f1a\u53cd\u800c\u53ef\u80fd\u52a0\u901f\u611f\u60c5\u75b2\u52b3\uff0c\u5c24\u5176\u662f\u90a3\u4e9b\u91cd\u590d\u3001\u6ca1\u65b0\u610f\u7684\u7ea6\u4f1a\u3002\u662f\u7684\uff0c\u4f60\u6ca1\u542c\u9519\uff1a\u6570\u91cf\u4e0d\u662f\u5173\u952e\uff0c\u8d28\u91cf\u624d\u662f\u3002",
    "\u60f3\u8c61\u4e00\u4e0b\uff0c\u4f60\u548c\u4f34\u4fa3\u6bcf\u5468\u90fd\u51fa\u53bb\uff0c\u4f46\u6bcf\u6b21\u90fd\u662f\u5403\u996d\u770b\u7535\u5f71\u3002\u7b2c\u4e09\u5468\uff0c\u8fde\u70b9\u9910\u90fd\u61d2\u5f97\u8bf4\u8bdd\u4e86\u3002\u8fd9\u4e0d\u662f\u7ef4\u6301\u706b\u82b1\uff0c\u8fd9\u662f\u57f9\u517b\u4e60\u60ef\u6027\u9ebb\u6728\u3002\u771f\u76f8\u662f\uff1a\u90a3\u4e9b\u6700\u751c\u871c\u7684\u60c5\u4fa3\uff0c\u9760\u7684\u4e0d\u662f\u9891\u6b21\uff0c\u800c\u662f\u2018\u610f\u5916\u611f\u2019\u548c\u2018\u65b0\u9c9c\u5ea6\u2019\u3002\u4e00\u4e2a\u7cbe\u5fc3\u51c6\u5907\u7684\u60ca\u559c\u7ea6\u4f1a\uff0c\u6bd4\u5341\u6b21\u4f8b\u884c\u665a\u9910\u66f4\u6709\u6740\u4f24\u529b\u3002",
    "\u8fd9\u5c31\u662f\u4e3a\u4ec0\u4e48\u6211\u4eec\u8bbe\u8ba1\u4e86\u2018\u60ca\u559c\u7ea6\u4f1a\u8ba1\u5212\u2019\u529f\u80fd\u3002\u4e00\u4eba\u5077\u5077\u5728SoulPlan\u4e0a\u8bbe\u5b9a\u65e5\u671f\u3001\u5730\u70b9\u548c\u6d3b\u52a8\uff0c\u53e6\u4e00\u4eba\u53ea\u6536\u5230\u4e00\u6761\u901a\u77e5\uff1a\u2018\u4eca\u665a\u6709\u7ea6\u4f1a\uff0c\u522b\u5b89\u6392\u522b\u7684\u4e8b\u3002\u2019\u6ca1\u6709\u5546\u91cf\uff0c\u6ca1\u6709\u63d0\u524d\u5267\u900f\u3002\u7136\u540e\uff0c\u5f53\u5929\u4f60\u4f1a\u88ab\u5e26\u5230\u67d0\u4e2a\u4f60\u4ece\u672a\u53bb\u8fc7\u7684\u5730\u65b9\u2014\u2014\u4e5f\u8bb8\u662f\u9690\u85cf\u7684\u5c4b\u9876\u9152\u5427\uff0c\u6216\u8005\u6df1\u591c\u7684\u4fdd\u9f84\u7403\u9986\u3002\u8fd9\u79cd\u672a\u77e5\u7684\u523a\u6fc0\uff0c\u624d\u662f\u7ea6\u4f1a\u771f\u6b63\u7684\u9b54\u6cd5\u3002",
    "\u73b0\u5728\u6253\u5f00SoulPlan\uff0c\u70b9\u5f00\u2018\u60ca\u559c\u7ea6\u4f1a\u8ba1\u5212\u2019\uff0c\u521b\u5efa\u4f60\u7684\u7b2c\u4e00\u4e2a\u79d8\u5bc6\u7ea6\u4f1a\u5427\u3002\u522b\u544a\u8bc9\u5979\u53bb\u54ea\uff0c\u5c31\u8ba9\u5979\u671f\u5f85\u3002P.S. \u5df2\u7ecf\u6709\u60c5\u4fa3\u9760\u8fd9\u4e2a\u529f\u80fd\uff0c\u4e09\u4e2a\u6708\u6ca1\u91cd\u590d\u8fc7\u540c\u4e00\u4e2a\u7ea6\u4f1a\u5730\u70b9\u3002\u4f60\u4e5f\u8bd5\u8bd5\uff1f"
  ],
