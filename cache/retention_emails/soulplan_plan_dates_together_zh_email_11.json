{
  "subject": "\u4f60\u76f8\u4fe1\u7684\u7ea6\u4f1a\u771f\u76f8\u5176\u5b9e\u662f\u9519\u7684",
  "preview_text": "\u522b\u4fe1\u4ec0\u4e48\u6d6a\u6f2b\u90fd\u662f\u5929\u751f\u7684\u2014\u2014\u4eca\u665a\u5c31\u8ba9\u4f60\u548cTA\u7684\u7ea6\u4f1a\u7115\u7136\u4e00\u65b0\u3002",
  "body_paragraphs": [
    "\u6709\u6ca1\u6709\u89c9\u5f97\uff0c\u7ea6\u4f1a\u4e00\u5b9a\u8981\u7cbe\u5fc3\u7b56\u5212\u624d\u80fd\u6d6a\u6f2b\uff1f\u670b\u53cb\u5708\u3001\u77ed\u89c6\u9891\u91cc\u90a3\u4e9b\u751c\u871c\u7684\u77ac\u95f4\uff0c\u8ba9\u4f60\u89c9\u5f97\u53ea\u6709\u5929\u624d\u624d\u80fd\u5b89\u6392\u51fa\u60ca\u559c\u3002\u4f46\u8bf4\u5b9e\u8bdd\uff0c90%\u7684\u6d6a\u6f2b\u90fd\u4e0d\u662f\u9760\u62fc\u547d\u60f3\u51fa\u6765\u7684\u3002",
    "\u771f\u76f8\u662f\uff0c\u6700\u8ba9\u4eba\u5fc3\u52a8\u7684\u7ea6\u4f1a\uff0c\u5f80\u5f80\u6765\u81ea\u4e00\u4e2a\u7b80\u5355\u7684\u4e3e\u52a8\u3002\u5c31\u50cf\u4f60\u521a\u4e0b\u8f7d\u7684SoulPlan\uff0c\u5b83\u4e0d\u662f\u4e3a\u4e86\u8ba9\u4f60\u66f4\u5fd9\u2014\u2014\u800c\u662f\u8ba9\u4f60\u572830\u79d2\u5185\uff0c\u628a\u2018\u4eca\u665a\u505a\u4ec0\u4e48\u2019\u4ece\u538b\u529b\u53d8\u6210\u4eea\u5f0f\u611f\u3002\u6211\u4eec\u7814\u7a76\u4e86500\u5bf9\u60c5\u4fa3\uff0c\u53d1\u73b0\u90a3\u4e9b\u6240\u8c13\u7684\u2018\u5b8c\u7f8e\u7ea6\u4f1a\u2019\uff0c\u5176\u5b9e\u5c31\u85cf\u5728\u2018\u4eca\u665a\u6a21\u5f0f\u2019\u91cc\uff0c\u9009\u4e2a\u5fc3\u60c5\uff0c\u5269\u4e0b\u7684\u4ea4\u7ed9\u5b83\u3002",
    "\u4f60\u6253\u5f00SoulPlan\uff0c\u770b\u5230\u9996\u9875\u90a3\u5f20\u5361\u7247\u4e86\u5417\uff1f\u70b9\u4e00\u4e0b\u2018\u4eca\u665a\u7ea6\u4f1a\u2019\uff0c\u9009\u4e2a\u5fc3\u60c5\u2014\u2014\u6696\u5fc3\u3001\u5192\u9669\u3001\u73a9\u4e50\u3001\u6cbb\u6108\u2014\u2014\u7136\u540e\u770b\u770b\u4f1a\u53d1\u751f\u4ec0\u4e48\u3002\u4e0d\u662f\u8ba9\u4f60\u5237\u5c4f\uff0c\u800c\u662f\u76f4\u63a5\u7ed9\u4f60\u4e00\u4e2a\u5b8c\u6574\u7684\u8ba1\u5212\u3002\u4f60\u7684\u53e6\u4e00\u534a\u6536\u5230\u65f6\uff0c\u4e0d\u662f\u666e\u901a\u7684\u901a\u77e5\uff0c\u800c\u662f\u4e00\u4e2a\u6ee1\u5c4f\u7684\u2018\u4eca\u665a\u60f3\u5230\u4f60\u2019\u7684\u77ac\u95f4\u3002",
    "\u522b\u7b49\u4e86\uff0c\u73b0\u5728\u5c31\u6253\u5f00SoulPlan\uff0c\u70b9\u2018\u4eca\u665a\u7ea6\u4f1a\u2019\u8bd5\u8bd5\u770b\u3002\u8ba9\u4eca\u665a\u6210\u4e3a\u4f60\u4fe9\u8bb0\u5fc6\u4e2d\u90a3\u4e2a\u2018\u4e0d\u5c0f\u5fc3\u2019\u7684\u6d6a\u6f2b\u3002 \nP.S. \u90a3\u4e2a\u2018\u5c0f\u786e\u5e78\u56de\u5fc6\u5f55\u2019\u529f\u80fd\uff0c\u7b49\u4f60\u7528\u4e00\u6b21\u5c31\u4f1a\u7231\u4e0a\u3002\u6bcf\u6b21\u7ea6\u4f1a\u540e\u968f\u624b\u62cd\u5f20\u7167\uff0c\u8fc7\u51e0\u4e2a\u6708\u56de\u5934\u770b\uff0c\u4f60\u4f1a\u611f\u8c22\u4eca\u5929\u7684\u81ea\u5df1\u3002"
  ],
