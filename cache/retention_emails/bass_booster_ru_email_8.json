{
  "subject": "\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u043e\u0434\u043d\u043e\u0433\u043e \u043f\u0430\u0440\u043d\u044f \u043d\u0430 16-\u0439 \u0434\u0435\u043d\u044c",
  "preview_text": "\u041e\u043d \u043f\u043e\u0447\u0442\u0438 \u0443\u0434\u0430\u043b\u0438\u043b \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435. \u041f\u043e\u0442\u043e\u043c \u0447\u0442\u043e-\u0442\u043e \u0449\u0435\u043b\u043a\u043d\u0443\u043b\u043e. \u0422\u0435\u043f\u0435\u0440\u044c \u043e\u043d \u043d\u0435 \u0432\u044b\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0431\u0430\u0441.",
  "body_paragraphs": [
    "\u041d\u0430 16-\u0439 \u0434\u0435\u043d\u044c \u043f\u043e\u0441\u043b\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 Bass Booster \u044f \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435: \u00ab\u0421\u043b\u0443\u0448\u0430\u0439, \u0443 \u043c\u0435\u043d\u044f \u0434\u0435\u0448\u0435\u0432\u044b\u0435 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438, \u0431\u0430\u0441\u0430 \u043d\u0435\u0442 \u0432\u043e\u043e\u0431\u0449\u0435. \u0422\u0432\u043e\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u2014 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f \u043d\u0430\u0434\u0435\u0436\u0434\u0430\u00bb. \u041f\u0430\u0440\u0435\u043d\u044c \u0441\u043b\u0443\u0448\u0430\u043b \u0442\u0440\u0435\u043a Phonk \u0432 \u043c\u0430\u0448\u0438\u043d\u0435, \u043d\u043e \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430 \u0437\u0432\u0443\u0447\u0430\u043b\u0438 \u043a\u0430\u043a \u043a\u043e\u043d\u0441\u0435\u0440\u0432\u043d\u0430\u044f \u0431\u0430\u043d\u043a\u0430. \u041e\u043d \u0443\u0436\u0435 \u0445\u043e\u0442\u0435\u043b \u0443\u0434\u0430\u043b\u0438\u0442\u044c \u0432\u0441\u0451.",
    "\u042f \u043e\u0442\u0432\u0435\u0442\u0438\u043b: \u00ab\u041e\u0442\u043a\u0440\u043e\u0439 Bass Booster, \u0432\u043a\u043b\u044e\u0447\u0438 \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u00ab\u041c\u0443\u0437\u044b\u043a\u0430\u00bb \u0438 \u0441\u0434\u0432\u0438\u043d\u044c \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u044f \u0434\u043e \u0443\u043f\u043e\u0440\u0430. \u041d\u0435 \u0431\u043e\u0439\u0441\u044f, 200% \u2014 \u044d\u0442\u043e \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u00bb. \u0427\u0435\u0440\u0435\u0437 \u043c\u0438\u043d\u0443\u0442\u0443 \u043e\u043d \u043f\u0440\u0438\u0441\u043b\u0430\u043b \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u043e\u0435: \u00ab\u0411\u043b\u0438\u043d, \u044f \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0443\u0434\u0430\u0440 \u0432 \u0433\u0440\u0443\u0434\u0438. \u0414\u0430\u0436\u0435 \u043d\u0430 \u044d\u0442\u0438\u0445 \u0437\u0430\u0442\u044b\u0447\u043a\u0430\u0445 \u0431\u0430\u0441 \u0437\u0430\u0448\u0435\u043b \u0442\u0430\u043a, \u0431\u0443\u0434\u0442\u043e \u043f\u043e\u0434 \u0441\u0438\u0434\u0435\u043d\u044c\u0435\u043c \u0441\u0430\u0431\u0432\u0443\u0444\u0435\u0440\u00bb. \u041e\u043d \u043d\u0435 \u0443\u0434\u0430\u043b\u0438\u043b \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435. \u041e\u043d \u043a\u0443\u043f\u0438\u043b Premium \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0434\u0435\u043d\u044c.",
    "\u0412\u043e\u0442 \u0447\u0442\u043e \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e: Bass Virtualizer \u0438 3D Surround \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0438 \u0435\u0433\u043e \u043f\u043b\u043e\u0441\u043a\u0438\u0435 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438 \u0432 \u043c\u0438\u043d\u0438-\u043a\u043b\u0443\u0431. \u0414\u0435\u0441\u044f\u0442\u0438\u043f\u043e\u043b\u043e\u0441\u043d\u044b\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 (\u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 Premium) \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b \u0435\u043c\u0443 \u0432\u044b\u0440\u0435\u0437\u0430\u0442\u044c \u043b\u0438\u0448\u043d\u0438\u0435 \u0447\u0430\u0441\u0442\u043e\u0442\u044b \u0438 \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c 60 \u0413\u0446 \u2014 \u0442\u043e\u0442 \u0441\u0430\u043c\u044b\u0439 \u043f\u043e\u0434\u0432\u0430\u043b, \u0433\u0434\u0435 \u0436\u0438\u0432\u0435\u0442 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u0431\u0430\u0441. \u041e\u0434\u043d\u043e \u043d\u0430\u0436\u0430\u0442\u0438\u0435 \u043d\u0430 \u0441\u043b\u0430\u0439\u0434\u0435\u0440 \u2014 \u0438 \u0442\u0440\u0435\u043a \u0437\u0430\u0438\u0433\u0440\u0430\u043b \u0442\u0430\u043a, \u043a\u0430\u043a \u0437\u0430\u0434\u0443\u043c\u044b\u0432\u0430\u043b \u0437\u0432\u0443\u043a\u043e\u0440\u0435\u0436\u0438\u0441\u0441\u0435\u0440.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Bass Booster \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u0412\u043a\u043b\u044e\u0447\u0438 \u043b\u044e\u0431\u043e\u0439 \u0442\u0440\u0435\u043a \u2014 \u0445\u043e\u0442\u044c \u0414\u0440\u0435\u0439\u043a\u0430, \u0445\u043e\u0442\u044c \u0421\u043a\u0440\u0438\u043b\u043b\u0435\u043a\u0441\u0430. \u041d\u0430\u0436\u043c\u0438 \u043d\u0430 Bass Virtualizer. \u0415\u0441\u043b\u0438 \u043d\u0435 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044c \u0440\u0430\u0437\u043d\u0438\u0446\u0443 \u0447\u0435\u0440\u0435\u0437 10 \u0441\u0435\u043a\u0443\u043d\u0434 \u2014 \u0437\u043d\u0430\u0447\u0438\u0442, \u0443 \u0442\u0435\u0431\u044f \u0441\u043b\u043e\u043c\u0430\u043d\u044b \u0443\u0448\u0438. P.S. \u042d\u0442\u043e \u043f\u0438\u0441\u044c\u043c\u043e \u2014 \u043d\u0435 \u0440\u0435\u043a\u043b\u0430\u043c\u0430. \u042d\u0442\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043f\u0430\u0440\u043d\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0447\u0443\u0442\u044c \u043d\u0435 \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u043a\u0430\u0439\u0444 \u043e\u0442 \u043c\u0443\u0437\u044b\u043a\u0438. \u041d\u0435 \u0431\u0443\u0434\u044c \u0438\u043c."
  ],
