{
  "subject": "\uc218\ud604\uc774\uc758 55\uc77c \uc5f0\uc18d \ub370\uc774\ud2b8 \ube44\ubc00",
  "preview_text": "\ud55c \ucee4\ud50c\uc774 55\uc77c \ub3d9\uc548 \ub9e4\uc77c \uc0c8\ub85c\uc6b4 \ub370\uc774\ud2b8\ub97c \ud55c \ubc29\ubc95\uc744 \uacf5\uac1c\ud569\ub2c8\ub2e4. \ub2f9\uc2e0\ub3c4 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uc218\ud604\uc774\uc640 \ub3d9\ud601\uc774 \uc774\uc57c\uae30\ub97c \ub4e3\uace0 \uc6b0\ub9ac \ud300 \uc804\uccb4\uac00 \uba48\ucdb0 \uc130\uc5b4\uc694. \uadf8\ub4e4\uc740 SoulPlan\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud55c \ud6c4 55\uc77c \ub3d9\uc548 \ud558\ub8e8\ub3c4 \ube60\uc9d0\uc5c6\uc774 \ub370\uc774\ud2b8\ub97c \ud588\uc2b5\ub2c8\ub2e4. \ubc18\ubcf5\ub418\ub294 \uc77c\uc0c1\uc5d0 \uc9c0\uccd0 \uc11c\ub85c \uba40\uc5b4\uc9c8 \ubed4\ud588\ub358 \ub450 \uc0ac\ub78c\uc774 \uc5b4\ub5bb\uac8c \ub9e4\uc77c \ubc24 \uc0c8\ub85c\uc6b4 \ucd94\uc5b5\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc5c8\uc744\uae4c\uc694?",
    "\ube44\uacb0\uc740 \uc0dd\uac01\ubcf4\ub2e4 \ub2e8\uc21c\ud588\uc2b5\ub2c8\ub2e4. \uadf8\ub4e4\uc740 \ub9e4\uc77c \uc800\ub141 '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \uce74\ub4dc\ub97c \ud55c \ubc88 \ud0ed\ud558\ub294 \uac83\ub9cc\uc73c\ub85c \uc2dc\uc791\ud588\uc2b5\ub2c8\ub2e4. \uae30\ubd84(\uc544\ub291\ud55c, \ubaa8\ud5d8\uc801\uc778, \uc7a5\ub09c\uae30 \uc788\ub294, \ud790\ub9c1)\uc744 \uc120\ud0dd\ud558\uba74 AI\uac00 \ubc14\ub85c \uadf8\ub0a0\uc758 \ub370\uc774\ud2b8\ub97c \uc81c\uc548\ud588\uc8e0. \uacc4\ud68d \ud53c\ub85c\ub294 \uc0ac\ub77c\uc9c0\uace0, \ub300\uc2e0 '\uc624\ub298 \ubc24 \ub108\ub97c \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \uc804\uc728\uc774 \ucc3e\uc544\uc654\uc2b5\ub2c8\ub2e4.",
    "\uac00\uc7a5 \ub180\ub77c\uc6b4 \uc21c\uac04\uc740 \ud30c\ud2b8\ub108\uac00 \ubcf4\ub0b8 \uc81c\uc548\uc774 '\uc624\ub298 \ubc24 \ub108\ub97c \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \ud480\uc2a4\ud06c\ub9b0 \uba54\uc2dc\uc9c0\ub85c \ub098\ud0c0\ub0a0 \ub54c\uc600\ub2e4\uace0 \uc218\ud604\uc774\ub294 \ub9d0\ud588\uc2b5\ub2c8\ub2e4. \ub2e8\uc21c\ud55c \uc54c\ub9bc\uc774 \uc544\ub2cc, \uc11c\ub85c\ub97c \ud5a5\ud55c \uc9c4\uc2ec\uc774 \ub290\uaef4\uc9c0\ub294 \uadf8 \uacbd\ud5d8\uc774 \ub370\uc774\ud2b8\ub97c \ud2b9\ubcc4\ud558\uac8c \ub9cc\ub4e4\uc5c8\ub2e4\uace0\uc694. \uba54\ubaa8\ub9ac \ud0c0\uc784\ub77c\uc778\uc5d0 \uc313\uc778 \uc0ac\uc9c4\uacfc \ub178\ud2b8\ub294 \uc5b4\ub290\uc0c8 55\uc77c\uc758 \uc0ac\ub791 \uc774\uc57c\uae30\ub85c \ubcc0\ud588\uc2b5\ub2c8\ub2e4.",
    "\uc624\ub298 \ubc24, \ub2f9\uc2e0\ub3c4 \uc2dc\uc791\ud574\ubcf4\uc138\uc694. \uc571\uc744 \uc5f4\uace0 '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ud0ed\ud558\uace0 \uae30\ubd84 \ud558\ub098\ub97c \uace0\ub974\uc138\uc694. 30\ucd08\uba74 \ub429\ub2c8\ub2e4. P.S. \uc218\ud604\uc774\uc640 \ub3d9\ud601\uc774\ub294 100\uc77c\uc744 \ubaa9\ud45c\ub85c \ud558\uace0 \uc788\uc5b4\uc694 \u2014 \ub2f9\uc2e0\uc758 \uc5f0\uc18d \uae30\ub85d\uc740 \uc5bc\ub9c8\uc778\uac00\uc694?"
  ],
