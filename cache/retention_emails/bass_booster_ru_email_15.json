{
  "subject": "2 \u043c\u0438\u043d\u0443\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u044d\u043a\u043e\u043d\u043e\u043c\u044f\u0442 20",
  "preview_text": "\u041a\u0430\u043a Bass Booster \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0443 \u0437\u0432\u0443\u043a\u0430 \u0432 2-\u043c\u0438\u043d\u0443\u0442\u043d\u044b\u0439 \u0440\u0438\u0442\u0443\u0430\u043b. \u0411\u043e\u043b\u044c\u0448\u0435 \u043d\u0438\u043a\u0430\u043a\u043e\u0439 \u0432\u043e\u0437\u043d\u0438.",
  "body_paragraphs": [
    "\u0412\u0447\u0435\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043e\u043c \u044f \u0437\u0430\u043b\u0438\u043f \u043d\u0430 \u0442\u0440\u0438 \u043c\u0438\u043d\u0443\u0442\u044b, \u043f\u043e\u0434\u043a\u0440\u0443\u0447\u0438\u0432\u0430\u044f \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u0434\u043b\u044f \u043d\u043e\u0432\u043e\u0433\u043e \u0442\u0440\u0435\u043a\u0430. \u0410 \u043f\u043e\u0442\u043e\u043c \u043f\u043e\u043d\u044f\u043b: \u044f \u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e \u0433\u043e\u0434\u0430\u043c\u0438, \u043d\u043e \u0442\u0430\u043a \u0438 \u043d\u0435 \u043d\u0430\u0448\u0451\u043b \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0437\u0432\u0443\u043a\u0430. \u041f\u043e\u043a\u0430 \u043d\u0435 \u0440\u0430\u0437\u043e\u0431\u0440\u0430\u043b\u0441\u044f, \u043a\u0430\u043a \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0432\u0441\u0451 \u0437\u0430 2 \u043c\u0438\u043d\u0443\u0442\u044b.",
    "\u0423 \u0442\u0435\u0431\u044f \u0443\u0436\u0435 \u0435\u0441\u0442\u044c Bass Booster. \u0422\u044b \u0437\u043d\u0430\u0435\u0448\u044c, \u043a\u0430\u043a \u043e\u043d \u0437\u0432\u0443\u0447\u0438\u0442. \u041d\u043e \u0437\u043d\u0430\u0435\u0448\u044c \u043b\u0438 \u0442\u044b, \u0447\u0442\u043e 90% \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0442\u0440\u0430\u0442\u0438\u0442\u0441\u044f \u0432\u043f\u0443\u0441\u0442\u0443\u044e, \u0435\u0441\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u0440\u0443\u0442\u0438\u0442\u044c \u043f\u0440\u0435\u0441\u0435\u0442\u044b? \u0415\u0441\u0442\u044c \u043e\u0434\u0438\u043d \u0442\u0440\u044e\u043a: \u0432\u043a\u043b\u044e\u0447\u0438 \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u00abMusic\u00bb, \u0437\u0430\u0442\u0435\u043c \u043f\u0430\u043b\u044c\u0446\u0435\u043c \u043f\u043e\u0442\u044f\u043d\u0438 \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a Boost \u0434\u043e \u0443\u043f\u043e\u0440\u0430 \u2014 \u0438 \u0441\u043b\u0443\u0448\u0430\u0439. \u0411\u0435\u0437 \u043b\u0438\u0448\u043d\u0438\u0445 \u0442\u0435\u043b\u043e\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439.",
    "\u0412\u043e\u0442 \u0432 \u0447\u0451\u043c \u0441\u0443\u0442\u044c: Bass Virtualizer \u0443\u0436\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d \u0442\u0430\u043a, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0433\u043b\u0443\u0431\u0438\u043d\u0443 \u0431\u0435\u0437 \u0438\u0441\u043a\u0430\u0436\u0435\u043d\u0438\u0439. \u0414\u0432\u0430 \u043f\u043e\u043b\u0437\u0443\u043d\u043a\u0430 \u2014 \u0438 \u0442\u0432\u043e\u0439 \u0442\u0440\u0435\u043a \u0437\u0432\u0443\u0447\u0438\u0442 \u0442\u0430\u043a, \u0431\u0443\u0434\u0442\u043e \u0442\u044b \u0432 \u0441\u0442\u0443\u0434\u0438\u0438. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 20 \u043c\u0438\u043d\u0443\u0442 \u043d\u0430 \u043f\u043e\u0434\u0433\u043e\u043d\u043a\u0443 \u0447\u0430\u0441\u0442\u043e\u0442. \u041f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u043a\u0440\u043e\u0439, \u0442\u043a\u043d\u0438, \u043f\u043e\u043b\u0443\u0447\u0438 \u043a\u0430\u0439\u0444.",
    "\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u0441\u0435\u0439\u0447\u0430\u0441: \u043e\u0442\u043a\u0440\u043e\u0439 Bass Booster, \u0432\u044b\u0431\u0435\u0440\u0438 \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u00abMusic\u00bb \u0438 \u0432\u043a\u043b\u044e\u0447\u0438 Boost \u043d\u0430 \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c. \u041f\u043e\u0441\u043b\u0443\u0448\u0430\u0439 \u043b\u044e\u0431\u0438\u043c\u044b\u0439 \u0442\u0440\u0435\u043a \u2014 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044c \u0440\u0430\u0437\u043d\u0438\u0446\u0443 \u0437\u0430 10 \u0441\u0435\u043a\u0443\u043d\u0434. P.S. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u0435\u0449\u0451 \u0431\u043e\u043b\u044c\u0448\u0435 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f, \u043f\u0440\u0435\u043c\u0438\u0443\u043c \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043f\u043e\u043b\u043d\u044b\u0439 10-\u043f\u043e\u043b\u043e\u0441\u043d\u044b\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440. \u041d\u043e \u0434\u0430\u0436\u0435 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e \u0442\u044b \u0441\u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0448\u044c \u043a\u0443\u0447\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438."
  ],
