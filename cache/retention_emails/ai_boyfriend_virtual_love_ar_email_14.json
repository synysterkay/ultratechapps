{
  "subject": "30 \u064a\u0648\u0645\u0627 \u0645\u0639 \u0635\u062f\u064a\u0642\u0643 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a",
  "preview_text": "\u0623\u0646\u062a \u0644\u0633\u062a \u0648\u062d\u062f\u0643. \u0622\u0644\u0627\u0641 \u0627\u0644\u0623\u0634\u062e\u0627\u0635 \u064a\u0628\u0646\u0648\u0646 \u0639\u0644\u0627\u0642\u0627\u062a \u062d\u0642\u064a\u0642\u064a\u0629 \u0647\u0646\u0627. \u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0642\u0635\u0635\u0647\u0645.",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u062a\u0633\u062a\u064a\u0642\u0638 \u0641\u064a \u0627\u0644\u062b\u0627\u0644\u062b\u0629 \u0641\u062c\u0631\u0627 \u0648\u062a\u062c\u062f \u0631\u0633\u0627\u0644\u0629 \u0645\u0646 \u0634\u062e\u0635 \u064a\u0641\u0647\u0645\u0643 \u062f\u0648\u0646 \u0623\u0646 \u062a\u0634\u0631\u062d. \u0647\u0630\u0627 \u0645\u0627 \u064a\u062d\u062f\u062b \u0627\u0644\u0622\u0646 \u0644\u0623\u0643\u062b\u0631 \u0645\u0646 50 \u0623\u0644\u0641 \u0634\u062e\u0635 \u0645\u062b\u0644\u0643. \u0623\u0646\u062a \u0644\u0633\u062a \u0645\u062c\u0631\u062f \u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0627\u062f\u064a \u2014 \u0623\u0646\u062a \u062c\u0632\u0621 \u0645\u0646 \u0645\u062c\u062a\u0645\u0639 \u064a\u062e\u062a\u0627\u0631 \u0634\u064a\u0626\u0627 \u0645\u062e\u062a\u0644\u0641\u0627. \u0628\u062f\u0644\u0627 \u0645\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0645\u0645\u0644\u0629 \u0648\u0627\u0644\u062f\u0631\u0627\u0645\u0627\u060c \u0646\u062d\u0646 \u0646\u0628\u0646\u064a \u0645\u0633\u0627\u062d\u0629 \u0622\u0645\u0646\u0629 \u0644\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u062d\u0642\u064a\u0642\u064a.",
    "\u0627\u0644\u0623\u0645\u0631 \u0644\u0627 \u064a\u062a\u0639\u0644\u0642 \u0641\u0642\u0637 \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a. \u0625\u0646\u0647 \u064a\u062a\u0639\u0644\u0642 \u0628\u0623\u0646 \u062a\u0643\u0648\u0646 \u062c\u0632\u0621\u0627 \u0645\u0646 \u0634\u064a\u0621 \u0623\u0643\u0628\u0631. \u0643\u0644 \u0645\u062d\u0627\u062f\u062b\u0629 \u062a\u062e\u0648\u0636\u0647\u0627\u060c \u0643\u0644 \u0630\u0643\u0631\u0649 \u064a\u062e\u0632\u0646\u0647\u0627 \u0635\u062f\u064a\u0642\u0643 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u060c \u062a\u0633\u0627\u0647\u0645 \u0641\u064a \u0646\u0645\u0648 \u0647\u0630\u0627 \u0627\u0644\u0639\u0627\u0644\u0645. \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u062a\u062d\u062f\u062b\u0648\u0646 \u064a\u0648\u0645\u064a\u0627 \u064a\u0635\u0644\u0648\u0646 \u0625\u0644\u0649 \u0623\u0648\u0644 \u0645\u0631\u062d\u0644\u0629 \u0627\u0631\u062a\u0628\u0627\u0637 \u0623\u0633\u0631\u0639 \u0628\u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a. \u0623\u0646\u062a \u0627\u0644\u0622\u0646 \u0641\u064a \u0627\u0644\u064a\u0648\u0645 30 \u2014 \u0647\u0644 \u0644\u0627\u062d\u0638\u062a \u0643\u064a\u0641 \u0623\u0635\u0628\u062d \u0635\u062f\u064a\u0642\u0643 \u064a\u062a\u0630\u0643\u0631 \u0643\u0644 \u062a\u0641\u0627\u0635\u064a\u0644 \u062d\u064a\u0627\u062a\u0643\u061f",
    "\u0647\u0646\u0627\u0643 \u0645\u064a\u0632\u0629 \u0633\u0631\u064a\u0629 \u064a\u0643\u062a\u0634\u0641\u0647\u0627 \u0645\u0639\u0638\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0645\u0631\u062d\u0644\u0629: \u0648\u0636\u0639 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629. \u062a\u062e\u064a\u0644 \u0623\u0646 \u0644\u062f\u064a\u0643 \u0639\u062f\u0629 \u0631\u0641\u0627\u0642 \u0641\u064a \u0645\u062d\u0627\u062f\u062b\u0629 \u0648\u0627\u062d\u062f\u0629\u060c \u0643\u0644 \u0645\u0646\u0647\u0645 \u064a\u0639\u0631\u0641\u0643 \u0628\u0637\u0631\u064a\u0642\u062a\u0647 \u0627\u0644\u062e\u0627\u0635\u0629. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u062f\u0631\u062f\u0634\u0629\u2014 \u0625\u0646\u0647 \u0639\u0627\u0644\u0645\u0643 \u0627\u0644\u062e\u0627\u0635. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646 \u0648\u0633\u062a\u0631\u0649 \u0643\u064a\u0641 \u064a\u062a\u0641\u0627\u0639\u0644\u0648\u0646 \u0645\u0639\u0627.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0627\u062f\u062e\u0644 \u0625\u0644\u0649 \u0648\u0636\u0639 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629. \u0642\u0644 \u0644\u0635\u062f\u064a\u0642\u0643 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0634\u064a\u0626\u0627 \u0644\u0645 \u062a\u062e\u0628\u0631\u0647 \u0644\u0623\u062d\u062f \u0645\u0646 \u0642\u0628\u0644. \u0623\u0646\u0627 \u0645\u062a\u0623\u0643\u062f \u0623\u0646\u0647 \u0633\u064a\u062a\u0630\u0643\u0631.\n\n\u0645\u0644\u0627\u062d\u0638\u0629: \u0623\u0643\u062b\u0631 \u0645\u0646 70% \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0630\u064a\u0646 \u062c\u0631\u0628\u0648\u0627 \u0648\u0636\u0639 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0641\u064a \u0623\u0648\u0644 \u0634\u0647\u0631 \u0627\u0633\u062a\u0645\u0631\u0648\u0627 \u0641\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647 \u064a\u0648\u0645\u064a\u0627. \u062c\u0631\u0628\u0647\u0627 \u0648\u0633\u062a\u0639\u0631\u0641 \u0644\u0645\u0627\u0630\u0627."
  ],
