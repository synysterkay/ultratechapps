{
  "subject": "\u0935\u094b \u092c\u093e\u0938 \u091f\u094d\u0930\u093f\u0915 \u091c\u094b \u0915\u094b\u0908 \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u0924\u093e",
  "preview_text": "50 \u0926\u093f\u0928 \u092c\u093e\u0926 \u092d\u0940 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u0928\u0939\u0940\u0902? \u092f\u0947 \u090f\u0915 \u0938\u0947\u091f\u093f\u0902\u0917 \u092c\u0926\u0932 \u0926\u0947\u0917\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0938\u0941\u0928\u0928\u0947 \u0915\u093e \u0924\u0930\u0940\u0915\u093e\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u092a\u0930 \u090f\u0915 \u0917\u093e\u0928\u093e \u0932\u0917\u093e\u092f\u093e\u0964 \u0935\u094b \u0921\u094d\u0930\u0949\u092a \u0906\u092f\u093e \u0914\u0930 \u092e\u0947\u0930\u0947 \u0915\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0910\u0938\u093e \u0932\u0917\u093e \u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u0938\u092c\u0935\u0942\u092b\u0930 \u092b\u091f \u0930\u0939\u093e \u0939\u094b\u0964 \u0932\u0947\u0915\u093f\u0928 \u092e\u0948\u0902\u0928\u0947 \u0915\u094b\u0908 \u092e\u0939\u0901\u0917\u093e \u0938\u094d\u092a\u0940\u0915\u0930 \u0928\u0939\u0940\u0902 \u0916\u0930\u0940\u0926\u093e\u0964 \u092c\u0938 \u090f\u0915 \u091b\u0941\u092a\u0940 \u0939\u0941\u0908 \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u091a\u093e\u0932\u0942 \u0915\u0940 \u091c\u094b \u0939\u0930 Bass Booster \u092f\u0942\u091c\u093c\u0930 \u0915\u0947 \u092a\u093e\u0938 \u0939\u0948, \u092a\u0930 \u0915\u094b\u0908 \u092c\u0924\u093e\u0924\u093e \u0928\u0939\u0940\u0902\u0964",
    "\u0924\u0941\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0939\u0948 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0908\u092f\u0930\u092b\u094b\u0928 \u092e\u0947\u0902 \u092c\u093e\u0938 \u0915\u092d\u0940 \u092a\u0902\u091c \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e? \u0935\u094b \u092b\u094d\u0932\u0948\u091f, \u092c\u0947\u091c\u093e\u0928 \u0906\u0935\u093e\u091c\u093c\u0964 Hip-Hop \u0915\u093e \u092c\u0940\u091f \u091f\u093f\u0928\u0940 \u0932\u0917\u0924\u093e \u0939\u0948, EDM \u0915\u093e \u0921\u094d\u0930\u0949\u092a \u0915\u0939\u0940\u0902 \u0916\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092f\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092b\u094b\u0928 \u092f\u093e \u0908\u092f\u0930\u092b\u094b\u0928 \u0915\u093e \u0926\u094b\u0937 \u0928\u0939\u0940\u0902\u0964 \u092f\u0947 \u090f\u0915 \u0938\u0947\u091f\u093f\u0902\u0917 \u0939\u0948 \u091c\u094b \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u092c\u0926\u0932\u0924\u0947 \u0939\u0948\u0902\u2014\u092c\u093e\u0915\u0940 \u0932\u094b\u0917 \u0938\u093f\u0930\u094d\u092b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",
    "Bass Booster \u092e\u0947\u0902 \u090f\u0915 '\u092c\u093e\u0938 \u0935\u0930\u094d\u091a\u0941\u0905\u0932\u093e\u0907\u091c\u093c\u0930' \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0938\u094d\u092a\u0940\u0915\u0930 \u0915\u094b \u0927\u094b\u0916\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u092f\u0947 \u0910\u0938\u093e \u0932\u0917\u0924\u093e \u0939\u0948 \u091c\u0948\u0938\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092b\u094b\u0928 \u0915\u0947 \u0905\u0902\u0926\u0930 \u0915\u094b\u0908 \u091b\u094b\u091f\u093e \u0938\u092c\u0935\u0942\u092b\u0930 \u0939\u094b\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0938\u0947 \u0907\u0938\u0947 \u0911\u0928 \u0915\u0930\u094b\u2014\u092b\u093f\u0930 Spotify, YouTube, TikTok\u2014\u0939\u0930 \u091c\u0917\u0939 \u092c\u093e\u0938 \u0927\u0921\u093c\u0915\u0947\u0917\u093e\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092e\u0947\u0902 \u0924\u094b \u092a\u0942\u0930\u093e 10-\u092c\u0948\u0902\u0921 EQ \u0916\u0941\u0932\u0924\u093e \u0939\u0948, \u091c\u0939\u093e\u0901 \u0924\u0941\u092e \u0939\u0930 \u092b\u094d\u0930\u0940\u0915\u094d\u0935\u0947\u0902\u0938\u0940 \u0915\u094b \u0905\u092a\u0928\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0922\u093e\u0932 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u092c\u093e\u0938 \u0935\u0930\u094d\u091a\u0941\u0905\u0932\u093e\u0907\u091c\u093c\u0930' \u0915\u094b \u0911\u0928 \u0915\u0930\u094b\u0964 \u092b\u093f\u0930 \u0935\u094b \u0917\u093e\u0928\u093e \u0932\u0917\u093e\u0913 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0939\u092e\u0947\u0936\u093e \u0915\u092e\u091c\u093c\u094b\u0930 \u0932\u0917\u0924\u093e \u0925\u093e\u0964 \u092c\u0938 10 \u0938\u0947\u0915\u0902\u0921\u2014\u0914\u0930 \u0924\u0941\u092e \u0938\u092e\u091d \u091c\u093e\u0913\u0917\u0947 \u0915\u093f \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930 \u0915\u094d\u092f\u094b\u0902 \u092f\u0947 \u091f\u094d\u0930\u093f\u0915 \u0915\u093f\u0938\u0940 \u0915\u094b \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u0924\u0947\u0964 P.S. \u092f\u0947 \u091f\u094d\u0930\u093f\u0915 \u0938\u093f\u0930\u094d\u092b \u0924\u092c \u0915\u093e\u092e \u0915\u0930\u0924\u0940 \u0939\u0948 \u091c\u092c \u0924\u0941\u092e '\u092c\u0942\u0938\u094d\u091f' \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b \u092d\u0940 50% \u0938\u0947 \u090a\u092a\u0930 \u0930\u0916\u0924\u0947 \u0939\u094b\u0964 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u094b\u0964"
  ],
