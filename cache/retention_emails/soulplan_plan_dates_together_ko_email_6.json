{
  "subject": "\ub2f9\uc2e0\uc774 \ub193\uce5c 11\uc77c\uc758 \uc2e4\uc218",
  "preview_text": "\ub300\ubd80\ubd84\uc758 \ucee4\ud50c\uc774 11\uc77c\uc9f8\uc5d0 \ud558\ub294 \ud55c \uac00\uc9c0 \uc2e4\uc218. \ub2f9\uc2e0\uc740 \uc544\uc9c1 \ub2a6\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4.",
  "body_paragraphs": [
    "11\uc77c\uc9f8, \ub2f9\uc2e0\uc758 \uc5f0\uc560\uac00 \ub2e4\uc2dc \ub8e8\ud2f4\uc5d0 \ube60\uc9c0\uae30 \uc2dc\uc791\ud560 \ub54c\uc785\ub2c8\ub2e4. \ub300\ubd80\ubd84\uc758 \uc0ac\ub78c\ub4e4\uc774 \uc774 \uc2dc\uc810\uc5d0 \ud55c \uac00\uc9c0 \uacb0\uc815\uc801\uc778 \uc2e4\uc218\ub97c \ud569\ub2c8\ub2e4: \uadf8\ub0e5 '\uc624\ub298 \ubb50 \ud560\uae4c?' \ud558\uace0 \ubb3b\ub294 \uac70\uc8e0. \uadf8 \uc21c\uac04 \uacc4\ud68d \ud53c\ub85c\uac00 \uc2dc\uc791\ub418\uace0, \uc0c1\ub300\ub294 \ub2f9\uc2e0\uc774 \uc2e0\uacbd \uc4f0\uc9c0 \uc54a\ub294\ub2e4\uace0 \ub290\ub08d\ub2c8\ub2e4.",
    "\uc5f0\uad6c\uc5d0 \ub530\ub974\uba74, SoulPlan \uc0ac\uc6a9\uc790 \uc911 \uccab 24\uc2dc\uac04 \ub3d9\uc548 \uc624\ub298\uc758 \ub370\uc774\ud2b8\ub97c \ud55c \ucee4\ud50c\uc740 \ub2e4\uc74c \ud55c \ub2ec \ub3d9\uc548 \ub370\uc774\ud2b8 \ube48\ub3c4\uac00 4\ubc30 \ub354 \ub192\uc2b5\ub2c8\ub2e4. \uadf8\ub807\uc9c0 \uc54a\uc740 \ucee4\ud50c\uc740 11\uc77c\uc9f8\uc5d0 \ub370\uc774\ud2b8 \uc544\uc774\ub514\uc5b4\uac00 \ubc14\ub2e5\ub098\uace0, '\ub610 \uac19\uc740 \uac70?'\ub77c\ub294 \ub9d0\uc774 \ub098\uc635\ub2c8\ub2e4. \uc2e4\uc218\ub294 \ub2f9\uc2e0\uc774 '\uc544\uc774\ub514\uc5b4\uac00 \uc5c6\uc5b4\uc11c'\uac00 \uc544\ub2c8\ub77c '\ub108\ubb34 \ubc14\ube60\uc11c' \ubbf8\ub8e8\ub294 \ub370 \uc788\uc2b5\ub2c8\ub2e4.",
    "\ud574\uacb0\ucc45\uc740 \uc0dd\uac01\ubcf4\ub2e4 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uc571\uc744 \uc5f4\uace0 '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ud0ed\ud558\uc138\uc694. \uae30\ubd84\uc5d0 \ub9de\ub294 \ubb34\ub4dc\ub97c \uace0\ub974\uae30\ub9cc \ud558\uba74 30\ucd08 \uc548\uc5d0 \uc624\ub298 \ubc24\uc774 \uacc4\ud68d\ub429\ub2c8\ub2e4. \uc0c1\ub300\uc5d0\uac8c \ubcf4\ub0b4\uba74 '\uc624\ub298 \ub108\ub97c \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \uc804\uccb4 \ud654\uba74 \uba54\uc2dc\uc9c0\uac00 \uc804\ub2ec\ub418\uc5b4, \ub2f9\uc2e0\uc758 \uad00\uc2ec\uc774 \uadf8\ub300\ub85c \uc804\ud574\uc9d1\ub2c8\ub2e4. \uc774 \uc791\uc740 \uc6c0\uc9c1\uc784\uc774 \ub8e8\ud2f4\uc744 \uae68\ub294 \uccab \ub2e8\uacc4\uc785\ub2c8\ub2e4.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uc5b4 '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \ud55c \ubc88\ub9cc \ud0ed\ud574\ubcf4\uc138\uc694. P.S. 5\uc77c \uc548\uc5d0 \ub370\uc774\ud2b8\ub97c \uacc4\ud68d\ud558\uc9c0 \uc54a\uc73c\uba74 \ubb34\ub8cc \ub3d9\uacb0 \uc2a4\ud2b8\ub9ad\ub3c4 \uc2dc\uc791\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uc9c0\uae08 \uc2dc\uc791\ud558\uba74 \ub2f9\uc2e0\uc758 \uc5f0\ub300\uae30\uac00 \uc313\uc774\uae30 \uc2dc\uc791\ud569\ub2c8\ub2e4."
  ],
