    "\u4f60\u5df2\u7ecf\u6709SoulPlan\u4e86\u3002\u4f60\u77e5\u9053\u90a3\u79cd\u611f\u89c9\uff1a\u5f53\u4f60\u4eec\u70b9\u5f00\u4eca\u665a\u7684\u7ea6\u4f1a\uff0c30\u79d2\u5c31\u5b9a\u597d\u8ba1\u5212\uff0c\u7136\u540e\u6536\u5230\u5bf9\u65b9\u90a3\u53e5'\u4eca\u665a\u4f60\u60f3\u5230\u4e86\u6211'\u3002\u4e0d\u662f\u6240\u6709\u4eba\u90fd\u6709\u8fd9\u4e2a\u3002\u4f46\u6709\u4e00\u4e2a\u4eba\uff0c\u4f60\u8ba4\u8bc6\u7684\u4eba\uff0c\u771f\u7684\u9700\u8981\u5b83\u3002",
    "\u4f60\u5fc3\u91cc\u5df2\u7ecf\u6709\u7b54\u6848\u4e86\uff1a\u90a3\u5bf9\u603b\u662f\u8bf4'\u968f\u4fbf'\u7684\u670b\u53cb\uff0c\u90a3\u4e2a\u62b1\u6028\u4f34\u4fa3\u5fd8\u4e86\u7eaa\u5ff5\u65e5\u7684\u95fa\u871c\uff0c\u6216\u90a3\u4e2a\u603b\u8bf4'\u7ea6\u4f1a\u592a\u9ebb\u70e6'\u7684\u540c\u4e8b\u3002\u5206\u4eabSoulPlan\u4e0d\u662f\u63a8\u9500\uff0c\u662f\u9080\u8bf7\u4ed6\u4eec\u8fdb\u5165\u4f60\u4eec\u7684\u9ed8\u5951\u3002\u6253\u5f00\u5e94\u7528\uff0c\u70b9\u51fb\u9080\u8bf7\u6309\u94ae\u2014\u201430\u79d2\uff0c\u4f60\u5c31\u80fd\u7ed9\u4ed6\u4eec\u4e00\u4e2a\u6539\u53d8\u5173\u7cfb\u7684\u4e1c\u897f\u3002",
    "\u4eca\u665a\uff0c\u5c31\u5206\u4eab\u7ed9\u90a3\u4e2a\u4eba\u3002\u6253\u5f00SoulPlan\uff0c\u627e\u5230\u9080\u8bf7\u529f\u80fd\uff0c\u53d1\u51fa\u53bb\u3002 P.S. \u4ed6\u4eec\u4e0b\u8f7d\u540e\uff0c\u4f60\u4eec\u4fe9\u90fd\u4f1a\u6536\u5230\u4e00\u4e2a'\u8fde\u7ed3\u6210\u529f'\u7684\u60ca\u559c\u2014\u2014\u4e0d\u4ec5\u4ed6\u4eec\uff0c\u4f60\u7684\u8bb0\u5fc6\u65f6\u95f4\u7ebf\u4e5f\u4f1a\u591a\u4e00\u4e2a\u5171\u4eab\u65e5\u671f\u3002"
