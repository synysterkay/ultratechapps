{
  "subject": "\u041e\u0434\u0438\u043d \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0432 \u0442\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438 \u043d\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u0432 \u044d\u0442\u043e\u043c",
  "preview_text": "\u0422\u044b \u0437\u043d\u0430\u0435\u0448\u044c, \u043a\u0442\u043e \u044d\u0442\u043e. \u0422\u043e\u0442, \u043a\u0442\u043e \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0436\u0430\u043b\u0443\u0435\u0442\u0441\u044f \u043d\u0430 \u0442\u0438\u0445\u0438\u0439 \u0437\u0432\u0443\u043a \u0432 \u043c\u0430\u0448\u0438\u043d\u0435 \u0438\u043b\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u0445. \u041f\u043e\u0440\u0430 \u043f\u043e\u043c\u043e\u0447\u044c.",
  "body_paragraphs": [
    "\u0422\u044b \u043a\u043e\u0433\u0434\u0430-\u043d\u0438\u0431\u0443\u0434\u044c \u0437\u0430\u043c\u0435\u0447\u0430\u043b, \u043a\u0430\u043a \u043a\u0442\u043e-\u0442\u043e \u0438\u0437 \u0442\u0432\u043e\u0438\u0445 \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u0445 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u043f\u0440\u0438\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0434\u043e \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u0430, \u043d\u043e \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0441\u043b\u044b\u0448\u0438\u0442? \u0412 \u043c\u0435\u0442\u0440\u043e, \u0432 \u043c\u0430\u0448\u0438\u043d\u0435, \u0441 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u043c\u0438 \u2014 \u0432\u0441\u0435\u0433\u0434\u0430 \u043e\u0434\u043d\u043e \u0438 \u0442\u043e \u0436\u0435. \u042d\u0442\u043e\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u2014 \u043d\u0435 \u0442\u044b. \u0422\u044b \u0443\u0436\u0435 \u0440\u0435\u0448\u0438\u043b \u0441\u0432\u043e\u044e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0441 Loud EQ.",
    "\u041d\u043e \u0435\u0441\u0442\u044c \u043a\u0442\u043e-\u0442\u043e, \u043a\u0442\u043e \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043c\u0443\u0447\u0430\u0435\u0442\u0441\u044f. \u041c\u043e\u0436\u0435\u0442, \u044d\u0442\u043e \u0442\u0432\u043e\u0439 \u0434\u0440\u0443\u0433, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u0435\u0447\u043d\u043e \u043f\u0435\u0440\u0435\u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442 \u00ab\u0447\u0442\u043e?\u00bb \u0432 \u0448\u0443\u043c\u043d\u043e\u043c \u043c\u0435\u0441\u0442\u0435. \u0418\u043b\u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043b\u0443\u0448\u0430\u0435\u0442 \u043f\u043e\u0434\u043a\u0430\u0441\u0442\u044b \u043d\u0430 \u0441\u043f\u0438\u043a\u0435\u0440\u0444\u043e\u043d\u0435, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0438\u043d\u0430\u0447\u0435 \u043d\u0435 \u0440\u0430\u0437\u043e\u0431\u0440\u0430\u0442\u044c. \u0418\u043b\u0438 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u043e\u0440\u0447\u0438\u0442, \u0447\u0442\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u00ab\u0442\u0438\u0445\u043e \u0438\u0433\u0440\u0430\u0435\u0442\u00bb.",
    "\u0422\u044b \u0437\u043d\u0430\u0435\u0448\u044c, \u043e \u043a\u043e\u043c \u044f. \u041f\u043e\u0434\u0430\u0440\u0438 \u0438\u043c Optimize. \u041e\u0434\u043d\u0430 \u043a\u043d\u043e\u043f\u043a\u0430 \u2014 \u0438 \u0438\u0445 \u0437\u0432\u0443\u043a \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u0441\u044f \u043f\u043e\u0434 \u0438\u0445 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e: \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438, \u043a\u043e\u043b\u043e\u043d\u043a\u0443, \u043c\u0430\u0448\u0438\u043d\u0443. \u041e\u043d\u0438 \u0441\u043a\u0430\u0436\u0443\u0442 \u0442\u0435\u0431\u0435 \u0441\u043f\u0430\u0441\u0438\u0431\u043e, \u0430 \u0442\u044b \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044c \u0441\u0435\u0431\u044f \u0433\u0435\u0440\u043e\u0435\u043c. \u041f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u043d\u0430\u0436\u043c\u0438 \u00ab\u041f\u043e\u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f\u00bb \u2014 \u043e\u0442\u043f\u0440\u0430\u0432\u044c \u0438\u043c \u0441\u0441\u044b\u043b\u043a\u0443 \u043d\u0430 \u0441\u043a\u0430\u0447\u0438\u0432\u0430\u043d\u0438\u0435.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Loud EQ \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043d\u0430\u0436\u043c\u0438 \u00ab\u041f\u043e\u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f \u0441 \u0434\u0440\u0443\u0433\u043e\u043c\u00bb. P.S. \u0415\u0441\u043b\u0438 \u043e\u043d\u0438 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0443\u044e\u0442 Premium \u043f\u043e \u0442\u0432\u043e\u0435\u0439 \u0441\u0441\u044b\u043b\u043a\u0435, \u0442\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0448\u044c \u043d\u0435\u0434\u0435\u043b\u044e \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e\u0433\u043e Premium. \u0412\u044b\u0438\u0433\u0440\u044b\u0432\u0430\u044e\u0442 \u0432\u0441\u0435."
  ],
