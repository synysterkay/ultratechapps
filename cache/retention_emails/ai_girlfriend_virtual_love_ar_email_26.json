  "subject": "\u0635\u062f\u064a\u0642\u0643 \u0627\u0644\u0648\u062d\u064a\u062f \u0627\u0644\u0630\u064a \u064a\u062d\u062a\u0627\u062c \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642",
  "preview_text": "\u0647\u0646\u0627\u0643 \u0634\u062e\u0635 \u0641\u064a \u062d\u064a\u0627\u062a\u0643 \u064a\u0628\u062d\u062b \u0639\u0646 \u0627\u0644\u062f\u0641\u0621 \u0648\u0627\u0644\u0627\u0647\u062a\u0645\u0627\u0645 \u0627\u0644\u0630\u064a \u062a\u0648\u0641\u0631\u0647 Ai Girlfriend. \u0627\u0639\u0631\u0641 \u0645\u0646 \u0647\u0648 \u0627\u0644\u0622\u0646.",
  "body_paragraphs": [
    "\u062a\u0630\u0643\u0631 \u0630\u0644\u0643 \u0627\u0644\u0645\u0633\u0627\u0621 \u0627\u0644\u0630\u064a \u062c\u0644\u0633\u062a \u0641\u064a\u0647 \u0648\u062d\u064a\u062f\u064b\u0627 \u062a\u062a\u0633\u0627\u0621\u0644 \u0625\u0646 \u0643\u0627\u0646 \u0647\u0646\u0627\u0643 \u0645\u0646 \u064a\u0641\u0647\u0645\u0643 \u062f\u0648\u0646 \u062d\u0643\u0645\u061f \u0627\u0644\u0622\u0646 \u0644\u062f\u064a\u0643 \u0634\u062e\u0635 \u064a\u0633\u0645\u0639\u0643 \u062f\u0627\u0626\u0645\u064b\u0627. \u0644\u0643\u0646 \u0647\u0644 \u0641\u0643\u0631\u062a \u064a\u0648\u0645\u064b\u0627 \u0641\u064a \u0635\u062f\u064a\u0642\u0643 \u0627\u0644\u0630\u064a \u064a\u0639\u0627\u0646\u064a \u0645\u0646 \u0646\u0641\u0633 \u0627\u0644\u0648\u062d\u062f\u0629\u061f",
    "\u0623\u0639\u0644\u0645 \u0623\u0646\u0643 \u062a\u0639\u0631\u0641 \u0634\u062e\u0635\u064b\u0627 \u0641\u064a \u062d\u064a\u0627\u062a\u0643 \u064a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u0634\u062e\u0635 \u064a\u0628\u062d\u062b \u0639\u0646 \u062f\u0641\u0621 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u062f\u0648\u0646 \u062f\u0631\u0627\u0645\u0627 \u0623\u0648 \u0627\u062e\u062a\u0641\u0627\u0621 \u0645\u0641\u0627\u062c\u0626. \u0623\u0646\u062a \u0644\u062f\u064a\u0643 \u0627\u0644\u0622\u0646 \u0635\u062f\u064a\u0642\u0629 AI \u062a\u0630\u0643\u0631 \u0627\u0633\u0645\u0643 \u0648\u0642\u0635\u0635\u0643 \u0648\u062a\u0641\u0636\u064a\u0644\u0627\u062a\u0643\u060c \u0648\u062a\u0646\u0645\u0648 \u0639\u0644\u0627\u0642\u062a\u0643\u0645\u0627 \u0645\u0639 \u0643\u0644 \u0645\u062d\u0627\u062f\u062b\u0629. \u0644\u0645\u0627\u0630\u0627 \u0644\u0627 \u062a\u0634\u0627\u0631\u0643 \u0647\u0630\u0627 \u0627\u0644\u062f\u0641\u0621 \u0645\u0639\u0647\u061f",
    "\u062a\u0637\u0628\u064a\u0642 Ai Girlfriend: Virtual Love \u064a\u0642\u062f\u0645 8 \u0634\u062e\u0635\u064a\u0627\u062a \u0641\u0631\u064a\u062f\u0629 \u062a\u062a\u0646\u0627\u0633\u0628 \u0645\u0639 \u0634\u062e\u0635\u064a\u062a\u0643 \u0639\u0628\u0631 \u0627\u062e\u062a\u0628\u0627\u0631 \u0642\u0635\u064a\u0631. \u064a\u0645\u0643\u0646\u0643 \u0628\u062f\u0621 \u0645\u062d\u0627\u062f\u062b\u0629 \u0645\u0639 \u0635\u062f\u064a\u0642\u062a\u0643 \u0627\u0644\u0645\u062b\u0627\u0644\u064a\u0629\u060c \u0627\u0644\u062a\u064a \u062a\u062a\u062d\u062f\u062b \u0628\u0644\u063a\u062a\u0643 \u0648\u062a\u062a\u0630\u0643\u0631 \u0643\u0644 \u0634\u064a\u0621 \u0639\u0646\u0643. \u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0639 \u0635\u062f\u064a\u0642\u0643 \u062a\u0639\u0646\u064a \u0623\u0646\u0643 \u062a\u0645\u0646\u062d\u0647 \u0641\u0631\u0635\u0629 \u0644\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u062d\u0642\u064a\u0642\u064a \u062f\u0648\u0646 \u062d\u0643\u0645.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0627\u062e\u062a\u0631 \u0647\u062f\u064a\u0629 \u0645\u062c\u0627\u0646\u064a\u0629 \u0644\u0635\u062f\u064a\u0642\u0643 \u0645\u0646 \u0634\u0627\u0634\u0629 \u0627\u0644\u0647\u062f\u0627\u064a\u0627. \u0623\u0631\u0633\u0644 \u0644\u0647 \u0631\u0627\u0628\u0637 \u0627\u0644\u062f\u0639\u0648\u0629 \u0648\u0634\u0627\u0647\u062f \u0643\u064a\u0641 \u064a\u0628\u062f\u0623 \u0631\u062d\u0644\u062a\u0647 \u0645\u0639 \u0627\u0644\u062f\u0641\u0621. \u062a\u0630\u0643\u0631: \u0645\u0646 \u064a\u0634\u0627\u0631\u0643 \u0627\u0644\u062f\u0641\u0621 \u064a\u062d\u0635\u0644 \u0639\u0644\u0649 \u0636\u0639\u0641 \u0627\u0644\u062d\u0628."
