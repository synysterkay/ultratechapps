{
  "subject": "\u0935\u0939 \u092b\u0940\u091a\u0930 \u091c\u094b 90% \u092f\u0942\u091c\u0930\u094d\u0938 \u092e\u093f\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902",
  "preview_text": "\u090f\u0915 \u092f\u0942\u091c\u0930 \u0928\u0947 \u0907\u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u0940 \u0921\u0947\u091f \u0928\u093e\u0907\u091f \u092c\u091a\u093e\u0908\u0964 \u0905\u092c \u0906\u092a\u0915\u0940 \u092c\u093e\u0930\u0940 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u090f\u0915 \u092f\u0942\u091c\u0930 \u0928\u0947 \u0939\u092e\u0947\u0902 \u0932\u093f\u0916\u093e \u0915\u093f \u0909\u0938\u0915\u0940 \u0936\u093e\u0926\u0940 \u0915\u0940 5\u0935\u0940\u0902 \u0938\u093e\u0932\u0917\u093f\u0930\u0939 \u092a\u0930 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0928\u0947 \u0915\u0939\u093e, '\u0939\u092e\u0947\u0936\u093e \u0935\u0939\u0940 \u092a\u0941\u0930\u093e\u0928\u0940 \u0921\u0947\u091f\u094d\u0938\u0964' \u0909\u0938\u0928\u0947 \u0938\u094b\u091a\u093e \u0915\u093f \u0905\u092c \u0915\u0941\u091b \u0928\u092f\u093e \u0928\u0939\u0940\u0902 \u092c\u091a\u093e\u0964 \u092b\u093f\u0930 \u0909\u0938\u0928\u0947 SoulPlan \u0915\u093e \u090f\u0915 \u092c\u091f\u0928 \u0926\u092c\u093e\u092f\u093e, \u091c\u093f\u0938\u0947 \u0909\u0938\u0928\u0947 \u0915\u092d\u0940 \u0928\u094b\u091f\u093f\u0938 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0925\u093e\u0964",
    "\u0909\u0938 \u092b\u0940\u091a\u0930 \u0928\u0947 \u092a\u0942\u0930\u0940 \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928\u093f\u0902\u0917 \u0915\u094b \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u094b \u092a\u0924\u093e \u0928\u0939\u0940\u0902 \u0925\u093e \u0915\u093f \u0915\u094d\u092f\u093e \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u093e \u0939\u0948\u0964 \u0909\u0938\u0928\u0947 \u092c\u0938 \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u0915\u093f\u092f\u093e, \u0914\u0930 \u090f\u0915 \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0921\u0947\u091f \u0924\u0948\u092f\u093e\u0930 \u0939\u094b \u0917\u0908\u0964 \u0905\u092c \u0935\u0947 \u0939\u0930 \u0939\u092b\u094d\u0924\u0947 \u0928\u0908 \u091c\u0917\u0939\u0947\u0902 \u090f\u0915\u094d\u0938\u092a\u094d\u0932\u094b\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u092b\u0940\u091a\u0930 \u0939\u0948\u0964",
    "\u092f\u0939 \u092b\u0940\u091a\u0930 \u0939\u0948 '\u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928\u0930'\u0964 \u0907\u0938\u092e\u0947\u0902 \u0906\u092a \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u0921\u0947\u091f \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u0935\u0939 \u092c\u0938 \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u091d\u0902\u091d\u091f \u0928\u0939\u0940\u0902, \u092c\u0938 \u090f\u0915 \u0915\u094d\u0932\u093f\u0915\u0964 \u0939\u092e\u093e\u0930\u0947 92% \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0907\u0938\u0938\u0947 \u0909\u0928\u0915\u093e \u0930\u093f\u0936\u094d\u0924\u093e \u092e\u091c\u092c\u0942\u0924 \u0939\u0941\u0906\u0964 \u0932\u0947\u0915\u093f\u0928 90% \u0932\u094b\u0917 \u0907\u0938\u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964",
    "\u0905\u092c \u0906\u092a\u0915\u0940 \u092c\u093e\u0930\u0940 \u0939\u0948\u0964 SoulPlan \u0916\u094b\u0932\u0947\u0902, '\u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0921\u0947\u091f' \u091a\u0941\u0928\u0947\u0902, \u0914\u0930 \u0905\u092a\u0928\u0947 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u094b \u092c\u0924\u093e\u090f\u0902 \u0915\u093f \u0906\u092a\u0915\u094b \u0915\u094b\u0908 \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u092e\u093f\u0932\u093e \u0939\u0948\u0964 P.S. \u0905\u0917\u0930 \u0906\u092a\u0915\u094b \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0906\u0907\u0921\u093f\u092f\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0902, \u0924\u094b \u092f\u0939 \u092b\u0940\u091a\u0930 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0939\u0940 \u092c\u0928\u093e \u0939\u0948\u0964 \u0907\u0938\u0947 \u0906\u091c \u0939\u0940 \u0906\u091c\u092e\u093e\u090f\u0902\u0964"
  ],
