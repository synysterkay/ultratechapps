  "body_paragraphs": [
    "\u5148\u9031\u3001\u3042\u308b\u30e6\u30fc\u30b6\u30fc\u304c\u4fe1\u3058\u3089\u308c\u306a\u3044\u8a18\u9332\u3092\u9054\u6210\u3057\u305f\u3002\u9023\u7d9a\u306717\u8a66\u5408\u306e\u30b9\u30b3\u30a2\u3092\u7684\u4e2d\u3055\u305b\u3001\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3067\u4f1d\u8aac\u306b\u306a\u3063\u305f\u3002\u3067\u3082\u5f7c\u304c\u7279\u5225\u306a\u306e\u306f\u3001AI\u306e\u4e88\u6e2c\u3092\u76f2\u4fe1\u3057\u306a\u304b\u3063\u305f\u304b\u3089\u3060\u3002\u5f7c\u306f\u3042\u308b\u300e\u30ef\u30fc\u30af\u30d5\u30ed\u30fc\u300f\u3092\u6301\u3063\u3066\u3044\u305f\u3002",
