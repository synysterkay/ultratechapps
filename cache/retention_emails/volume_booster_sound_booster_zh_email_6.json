{
  "subject": "90%\u7528\u6237\u90fd\u72af\u7684\u81f4\u547d\u9519\u8bef\uff0c\u6b63\u5728\u6bc1\u6389\u4f60\u7684\u97f3\u8d28",
  "preview_text": "\u8fd9\u4e0d\u662f\u4f60\u7684\u9519\u89c9\u3002\u5982\u679c\u4f60\u53ea\u7528\u57fa\u7840\u97f3\u91cf\u589e\u5f3a\uff0c\u5c31\u9519\u8fc7\u4e86\u771f\u6b63\u7684\u201c\u9b54\u6cd5\u201d\u3002\u771f\u76f8\u548c\u8865\u6551\u65b9\u6cd5\u5728\u8fd9\u91cc\u3002",
  "body_paragraphs": [
    "\u6211\u5f97\u5766\u767d\u4e00\u4ef6\u4e8b\u3002\u8fc7\u53bb\u4e00\u5468\uff0c\u6211\u4e00\u76f4\u5728\u770b\u540e\u53f0\u6570\u636e\uff0c\u53d1\u73b0\u4e86\u4e00\u4e2a\u8ba9\u4eba\u5750\u7acb\u4e0d\u5b89\u7684\u6a21\u5f0f\u3002\u6210\u5343\u4e0a\u4e07\u7684\u7528\u6237\u4e0b\u8f7d\u4e86\u6211\u4eec\u7684\u5e94\u7528\uff0c\u5374\u53ea\u7528\u4e86\u5b8310%\u7684\u6f5c\u529b\u3002\u7136\u540e\u4ed6\u4eec\u89c9\u5f97\u2018\u6548\u679c\u8fd8\u884c\uff0c\u4f46\u6ca1\u60f3\u8c61\u4e2d\u9707\u64bc\u2019\u3002\u8fd9\u8ba9\u6211\u5fc3\u788e\u3002",
    "\u6700\u5927\u7684\u9519\u8bef\u662f\u4ec0\u4e48\uff1f\u53ea\u8c03\u97f3\u91cf\u6ed1\u5757\uff0c\u5374\u5b8c\u5168\u5ffd\u7565\u4e86\u5185\u7f6e\u5747\u8861\u5668\u3002\u8fd9\u5c31\u50cf\u4e70\u4e86\u4e00\u8f86\u8dd1\u8f66\uff0c\u5374\u6c38\u8fdc\u53ea\u7528\u4e00\u6863\u884c\u9a76\u3002\u58f0\u97f3\u662f\u6241\u5e73\u7684\uff0c\u6ca1\u6709\u5c42\u6b21\uff0c\u4f4e\u97f3\u51fa\u4e0d\u6765\uff0c\u9ad8\u97f3\u523a\u8033\u3002\u4f60\u5f97\u5230\u7684\u53ea\u662f\u2018\u66f4\u54cd\u7684\u566a\u97f3\u2019\uff0c\u800c\u4e0d\u662f\u2018\u66f4\u68d2\u7684\u97f3\u4e50\u2019\u3002\u7ed3\u679c\u5c31\u662f\uff1a\u4f60\u4f9d\u7136\u542c\u4e0d\u6e05\u64ad\u5ba2\u7684\u7ec6\u8282\uff0c\u97f3\u4e50\u7f3a\u4e4f\u51b2\u51fb\u529b\uff0c\u611f\u89c9\u5347\u7ea7\u4e86\u4e2a\u5bc2\u5bde\u3002",
    "\u79d8\u5bc6\u5728\u4e8e\u8054\u52a8\u3002\u97f3\u91cf\u589e\u5f3a\u53ea\u662f\u7b2c\u4e00\u6b65\uff0c\u771f\u6b63\u7684\u9b54\u6cd5\u85cf\u5728\u2018\u5747\u8861\u5668\u2019\u6807\u7b7e\u9875\u91cc\u3002\u5c24\u5176\u662f\u2018\u4f4e\u97f3\u589e\u5f3a\u2019\u5f00\u5173\u548c\u90a3\u4e9b\u4e3a\u4e0d\u540c\u98ce\u683c\u4f18\u5316\u7684\u9884\u8bbe\uff08\u6d41\u884c\u3001\u6447\u6eda\u3001\u7535\u5b50\uff09\u3002\u5b83\u4eec\u4e0d\u662f\u88c5\u9970\uff0c\u800c\u662f\u58f0\u97f3\u5de5\u7a0b\u5e08\u8c03\u6821\u7684\u7b97\u6cd5\uff0c\u80fd\u667a\u80fd\u8865\u507f\u4f60\u624b\u673a\u626c\u58f0\u5668\u7684\u7269\u7406\u7f3a\u9677\u3002\u6253\u5f00\u5b83\uff0c\u58f0\u97f3\u4f1a\u4ece\u2018\u5899\u9762\u53cd\u5c04\u2019\u53d8\u6210\u2018\u6251\u9762\u800c\u6765\u2019\u3002",
    "\u73b0\u5728\u5c31\u6253\u5f00\u5e94\u7528\uff0c\u522b\u78b0\u4e3b\u97f3\u91cf\u6761\u3002\u76f4\u63a5\u53bb\u2018\u5747\u8861\u5668\u2019\uff0c\u9009\u4e00\u4e2a\u9002\u5408\u4f60\u6b63\u5728\u542c\u7684\u5185\u5bb9\u7684\u9884\u8bbe\uff08\u6bd4\u5982\u542c\u64ad\u5ba2\u9009\u2018\u8bed\u97f3\u2019\uff0c\u542c\u563b\u54c8\u9009\u2018\u7535\u5b50\u2019\uff09\uff0c\u7136\u540e\u6253\u5f00\u2018\u4f4e\u97f3\u589e\u5f3a\u2019\u3002\u6700\u540e\uff0c\u518d\u56de\u53bb\u5fae\u8c03\u603b\u97f3\u91cf\u3002\u611f\u53d7\u4e00\u4e0b\u533a\u522b\u3002\u8fd9\u624d\u662f\u5e94\u7528\u8bbe\u8ba1\u7684\u521d\u8877\u3002P.S. \u90a3\u4e9b\u6bcf\u5929\u4f7f\u7528\u3001\u83b7\u5f97200%\u97f3\u8d28\u63d0\u5347\u7684\u7528\u6237\uff0c\u79d8\u5bc6\u5c31\u5728\u8fd9\u91cc\u3002\u4ed6\u4eec\u751a\u81f3\u4e0d\u77e5\u9053\uff0c\u8fd9\u4e2a\u6838\u5fc3\u529f\u80fd\u5728\u514d\u8d39\u7248\u91cc\u5df2\u7ecf\u8db3\u591f\u5f3a\u5927\u3002",
    "\u73b0\u5728\u5c31\u53bb\u4f53\u9a8c\u5b8c\u6574\u7684\u97f3\u6548"
  ],
