{
  "subject": "\u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092c\u0928\u093e\u0908 \u0917\u0908 \u090f\u0915 \u0917\u0932\u0924\u0940",
  "preview_text": "\u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u092b\u0940\u091a\u0930 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092c\u0928\u093e\u092f\u093e \u0925\u093e\u0964 \u0905\u0938\u0932\u0940 \u0915\u0939\u093e\u0928\u0940 \u0938\u0941\u0928\u093f\u090f \u2013 \u092f\u0939 \u0917\u0932\u0924\u0940 \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924 \u092c\u0926\u0932 \u0938\u0915\u0924\u0940 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c \u0930\u0939\u0947 \u0925\u0947\u0964 \u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0932\u0948\u092a\u091f\u0949\u092a \u092a\u0930 \u0915\u093e\u092e \u0915\u0930 \u0930\u0939\u093e \u0925\u093e, \u0914\u0930 \u092e\u0947\u0930\u0947 \u0915\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0939\u0947\u0921\u092b\u094b\u0928 \u0932\u0917\u0947 \u0925\u0947\u0964 \u0905\u091a\u093e\u0928\u0915, \u092e\u0941\u091d\u0947 \u090f\u0939\u0938\u093e\u0938 \u0939\u0941\u0906 \u0915\u093f \u092e\u0948\u0902 \u090f\u0915 \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u094b \u0938\u0941\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f 100% \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092a\u0930 \u092d\u0940 \u091c\u094b\u0930 \u0932\u0917\u093e \u0930\u0939\u093e \u0939\u0942\u0902\u0964 \u0921\u093e\u092f\u0932\u0949\u0917 \u0938\u093e\u092b \u0928\u0939\u0940\u0902 \u0906 \u0930\u0939\u0947 \u0925\u0947, \u0914\u0930 \u092e\u0947\u0930\u0947 \u0915\u093e\u0928 \u0926\u0941\u0916\u0928\u0947 \u0932\u0917\u0947 \u0925\u0947\u0964",
    "\u0909\u0938 \u0930\u093e\u0924 \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u2013 \u0915\u094d\u092f\u094b\u0902 \u0939\u0930 \u0910\u092a \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u092a\u0930 \u0906\u0935\u093e\u091c \u0915\u094b \u0916\u0930\u093e\u092c \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948? \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u090f\u0915 \u092b\u0940\u091a\u0930 \u092c\u0928\u093e\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e \u091c\u094b \u0906\u0935\u093e\u091c \u0915\u094b \u092c\u093f\u0928\u093e \u0924\u094b\u0921\u093c\u0947 \u0938\u093e\u092b \u0914\u0930 \u0924\u0947\u091c \u0915\u0930 \u0938\u0915\u0947\u0964 \u0935\u0939 \u092b\u0940\u091a\u0930 \u0906\u091c Loud EQ \u092e\u0947\u0902 'Optimal Boost' \u0939\u0948\u0964 \u092e\u0948\u0902\u0928\u0947 \u0907\u0938\u0947 \u0938\u093f\u0930\u094d\u092b \u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u0938\u094b\u091a\u093e \u0915\u093f \u0936\u093e\u092f\u0926 \u0914\u0930 \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u092d\u0940 \u0907\u0938\u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0939\u094b\u0964",
    "\u092f\u0939 \u092b\u0940\u091a\u0930 \u0906\u092a\u0915\u094b +200% \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0926\u0947\u0924\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0915\u094d\u0930\u0948\u0915\u0932 \u092f\u093e \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0915\u0947\u0964 \u092f\u0939 \u0906\u092a\u0915\u0947 \u0938\u094d\u092a\u0940\u0915\u0930 \u092f\u093e \u0939\u0947\u0921\u092b\u094b\u0928 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0916\u0941\u0926 \u0915\u094b \u090f\u0921\u091c\u0938\u094d\u091f \u0915\u0930\u0924\u093e \u0939\u0948 \u2013 \u091a\u093e\u0939\u0947 \u0906\u092a \u090f\u092f\u0930\u092a\u0949\u0921\u094d\u0938 \u0932\u0917\u093e\u090f\u0902 \u092f\u093e \u0935\u093e\u092f\u0930\u094d\u0921 \u0939\u0947\u0921\u092b\u094b\u0928\u0964 \u0914\u0930 \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u0940 \u092c\u093e\u0924? \u092f\u0939 \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092d\u0940 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u0905\u092a\u0928\u093e Loud EQ \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 'Optimize' \u092a\u0930 \u090f\u0915 \u092c\u093e\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u0926\u0947\u0916\u093f\u090f \u0915\u0948\u0938\u0947 \u0906\u0935\u093e\u091c \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u092e\u0947\u0939\u0928\u0924 \u0915\u0947 \u0938\u093e\u092b \u0914\u0930 \u0924\u0947\u091c \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0935\u0939\u0940 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0909\u0938 \u0930\u093e\u0924 \u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e \u0925\u093e \u2013 \u0914\u0930 \u0905\u092c \u092f\u0939 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u092d\u0940 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u2013 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939 \u092b\u0940\u091a\u0930 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0905\u0928\u0932\u0949\u0915 \u0939\u0948\u0964 \u092b\u094d\u0930\u0940 \u091f\u094d\u0930\u093e\u092f\u0932 \u0932\u0947\u0915\u0930 \u0907\u0938\u0947 \u0906\u091c \u0939\u0940 \u0906\u091c\u092e\u093e\u090f\u0902\u0964"
  ],
