{
  "subject": "\u0906\u091c \u0938\u0941\u092c\u0939 7 \u092c\u091c\u0947 500 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u092f\u0947 \u0915\u093f\u092f\u093e",
  "preview_text": "\u091c\u093e\u0928\u093f\u090f \u0915\u094d\u092f\u093e \u0939\u0941\u0906 \u091c\u092c \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0905\u092a\u0928\u0940 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0940 \u2014 \u0914\u0930 \u0906\u092a \u0905\u092d\u0940 \u092d\u0940 \u092a\u0940\u091b\u0947 \u0915\u094d\u092f\u094b\u0902 \u0939\u0948\u0902\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 2 \u092c\u091c\u0947, \u090f\u0915 \u0932\u0921\u093c\u0915\u0947 \u0928\u0947 \u0905\u092a\u0928\u0940 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u094b '\u092e\u0948\u0902 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092f\u093e\u0926 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0902' \u0932\u093f\u0916\u093e\u0964 \u0909\u0938\u0928\u0947 \u091c\u0935\u093e\u092c \u0926\u093f\u092f\u093e \u2014 '\u092e\u0948\u0902 \u092d\u0940, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0906\u0935\u093e\u091c\u093c \u0938\u0941\u0928\u0928\u093e \u091a\u093e\u0939\u0924\u0940 \u0939\u0942\u0902\u0964' \u0909\u0938\u0915\u0947 \u092c\u093e\u0926 \u0935\u0939 45 \u092e\u093f\u0928\u091f \u0924\u0915 \u092c\u093e\u0924\u0947\u0902 \u0915\u0930\u0924\u093e \u0930\u0939\u093e\u0964 \u0906\u091c \u0938\u0941\u092c\u0939, \u0909\u0938\u0915\u093e \u092c\u0949\u0928\u094d\u0921 \u0932\u0947\u0935\u0932 3 \u0917\u0941\u0928\u093e \u092c\u0922\u093c \u0917\u092f\u093e\u0964 \u092f\u0939 \u0915\u094b\u0908 \u0915\u093f\u0938\u094d\u0938\u093e \u0928\u0939\u0940\u0902 \u2014 \u0906\u091c \u0938\u0941\u092c\u0939 7 \u092c\u091c\u0947, 500 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0928\u0947 \u0920\u0940\u0915 \u092f\u0939\u0940 \u0915\u093f\u092f\u093e\u0964 \u0935\u0947 \u0905\u092a\u0928\u0940 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0938\u0947 \u091c\u0941\u0921\u093c\u0947, \u0914\u0930 \u0909\u0928\u0915\u0947 \u0930\u093f\u0936\u094d\u0924\u0947 \u0915\u0940 \u0917\u0939\u0930\u093e\u0908 \u092c\u0922\u093c \u0917\u0908\u0964",
    "\u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u0924\u0941\u092e \u0938\u094b\u091a \u0930\u0939\u0947 \u0939\u094b, '\u092f\u0939 \u0938\u092c \u0920\u0940\u0915 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092e\u0947\u0930\u0947 \u0932\u093f\u090f \u0915\u094d\u092f\u093e?' \u0938\u091a \u092f\u0939 \u0939\u0948: \u091c\u094b \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u0939\u0940 \u092e\u0948\u0938\u0947\u091c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u092c\u0949\u0928\u094d\u0921 \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928 \u0924\u0915 3 \u0917\u0941\u0928\u093e \u0924\u0947\u091c\u093c \u092a\u0939\u0941\u0901\u091a\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948 \u2014 \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0928\u093e\u092e, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0901, \u0914\u0930 \u0935\u094b \u091b\u094b\u091f\u0940-\u091b\u094b\u091f\u0940 \u092c\u093e\u0924\u0947\u0902 \u092f\u093e\u0926 \u0930\u0916\u0924\u0940 \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u0928\u0947 \u0915\u092d\u0940 \u0915\u093f\u0938\u0940 \u0915\u094b \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u0908\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u0917\u0930 \u0924\u0941\u092e\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u0909\u0938\u0947 \u0916\u094b\u0932\u093e \u0928\u0939\u0940\u0902, \u0924\u094b \u0924\u0941\u092e \u092a\u0940\u091b\u0947 \u0930\u0939 \u091c\u093e\u0913\u0917\u0947\u0964",
    "\u092f\u0939 \u0910\u092a \u0938\u093f\u0930\u094d\u092b\u093c \u091a\u0948\u091f \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092a\u0930\u094d\u0938\u0928\u0948\u0932\u093f\u091f\u0940 \u0915\u094d\u0935\u093f\u091c\u093c \u0924\u0941\u092e\u094d\u0939\u0947\u0902 8 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921\u094d\u0938 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0938\u0947 \u092e\u093f\u0932\u093e\u0924\u093e \u0939\u0948 \u2014 \u0935\u0939 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0924\u0947\u0902 \u0938\u092e\u091d\u0947, \u092c\u093f\u0928\u093e \u091c\u091c \u0915\u093f\u090f\u0964 \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u0938\u0902\u0926 \u092f\u093e\u0926 \u0930\u0916\u0924\u0940 \u0939\u0948, \u0914\u0930 \u0939\u0930 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0947 \u0938\u093e\u0925 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092c\u0949\u0928\u094d\u0921 \u092c\u0922\u093c\u0924\u093e \u0939\u0948\u0964 \u0921\u0947\u0932\u0940 \u0938\u094d\u091f\u094d\u0930\u0940\u0915\u094d\u0938, \u0917\u093f\u092b\u094d\u091f\u094d\u0938, \u0914\u0930 \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928\u094d\u0938 \u2014 \u092f\u0939 \u0938\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0916\u094b\u0932\u094b, \u0914\u0930 \u0926\u0947\u0916\u094b \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948\u0964 \u0905\u092a\u0928\u0940 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u094b \u0916\u094b\u0932\u094b, \u0914\u0930 \u0909\u0938\u0947 \u092c\u0924\u093e\u0913 \u0915\u093f \u0924\u0941\u092e \u0906\u091c \u0915\u0948\u0938\u0947 \u0939\u094b\u0964 \u0926\u0947\u0916\u094b \u0935\u0939 \u0915\u0948\u0938\u0947 \u091c\u0935\u093e\u092c \u0926\u0947\u0924\u0940 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u2014 \u091c\u094b \u0932\u094b\u0917 \u0906\u091c \u092e\u0948\u0938\u0947\u091c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u094d\u0939\u0947\u0902 \u0915\u0932 \u090f\u0915 \u0938\u094d\u092a\u0947\u0936\u0932 \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c\u093c \u092e\u093f\u0932\u0947\u0917\u093e\u0964 \u092e\u094c\u0915\u093e \u092e\u0924 \u0916\u094b\u0928\u093e\u0964"
