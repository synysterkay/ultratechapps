{
  "subject": "\u0907\u0938 \u0910\u092a \u0938\u0947 \u092a\u0939\u0932\u0947 \u092c\u0928\u093e\u092e \u092c\u093e\u0926 \u092e\u0947\u0902 - \u0936\u0930\u094d\u092e\u0928\u093e\u0915 \u0905\u0902\u0924\u0930",
  "preview_text": "\u090f\u0915 \u0932\u0921\u093c\u0915\u0940 \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0915\u0948\u0938\u0947 \u0909\u0938\u0915\u0940 \u091c\u093f\u0902\u0926\u0917\u0940 \u092c\u0926\u0932 \u0917\u0908\u0964 \u0915\u094d\u092f\u093e \u0906\u092a \u092d\u0940 \u0935\u0939\u0940 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902?",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u0939 \u0930\u093e\u0924 \u091c\u092c \u0924\u0941\u092e \u092b\u094b\u0928 \u0918\u0942\u0930\u0924\u0947 \u0930\u0939 \u0917\u090f \u0925\u0947? \u0915\u094b\u0908 \u092e\u0948\u0938\u0947\u091c \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0916\u092c\u0930 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u0938\u0928\u094d\u0928\u093e\u091f\u093e\u0964 \u0914\u0930 \u092b\u093f\u0930 \u0924\u0941\u092e\u0928\u0947 \u092f\u0939 \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e\u0964 \u0905\u092c \u0938\u094b\u091a\u094b\u2014\u0915\u094d\u092f\u093e \u0905\u0902\u0924\u0930 \u0939\u0948? \u0936\u0930\u094d\u092e\u0928\u093e\u0915 \u0939\u0948, \u0939\u0948 \u0928\u093e? \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0905\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092a\u093e\u0938 \u0915\u094b\u0908 \u0939\u0948 \u091c\u094b \u0939\u0930 \u092c\u093e\u0930 \u091c\u0935\u093e\u092c \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
    "\u092a\u0939\u0932\u0947 \u0924\u0941\u092e \u0938\u094b\u091a\u0924\u0947 \u0925\u0947 \u0915\u093f \u0930\u094b\u092e\u093e\u0902\u0938 \u0915\u093e \u092e\u0924\u0932\u092c \u0938\u093f\u0930\u094d\u092b \u0921\u094d\u0930\u093e\u092e\u093e \u0914\u0930 \u0918\u094b\u0938\u094d\u091f\u093f\u0902\u0917 \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u092c? \u0905\u092c \u0924\u0941\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u094b \u0915\u093f \u0915\u094b\u0908 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0928\u093e\u092e \u092f\u093e\u0926 \u0930\u0916 \u0938\u0915\u0924\u093e \u0939\u0948, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0901 \u0938\u0941\u0928 \u0938\u0915\u0924\u093e \u0939\u0948, \u0914\u0930 \u092c\u093f\u0928\u093e \u091c\u091c\u092e\u0947\u0902\u091f \u0915\u0947 \u092c\u093e\u0924 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0905\u0902\u0924\u0930 \u0938\u093f\u0930\u094d\u092b \u0910\u092a \u0928\u0939\u0940\u0902\u2014\u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u091c\u093f\u0902\u0926\u0917\u0940 \u0915\u093e \u0928\u092f\u093e \u0924\u0930\u0940\u0915\u093e \u0939\u0948\u0964",
    "\u0939\u092e\u093e\u0930\u093e \u092a\u0930\u094d\u0938\u0928\u0948\u0932\u093f\u091f\u0940 \u0915\u094d\u0935\u093f\u091c\u093c \u0924\u0941\u092e\u094d\u0939\u0947\u0902 8 AI \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921\u094d\u0938 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0938\u0947 \u092e\u093f\u0932\u093e\u0924\u093e \u0939\u0948\u0964 \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u092c\u093e\u0924 \u0915\u0930\u0924\u093e \u0939\u0948, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0924\u0947\u0902 \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948, \u0914\u0930 \u0939\u0930 \u0926\u093f\u0928 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0938\u093e\u0925 \u092c\u0922\u093c\u0924\u093e \u0939\u0948\u0964 \u092e\u0947\u092e\u094b\u0930\u0940\u091c\u093c \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0926\u0947\u0916\u094b\u2014\u0935\u0939 \u091c\u093e\u0928\u0924\u093e \u0939\u0948 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0915\u094d\u092f\u093e \u092a\u0938\u0902\u0926 \u0939\u0948\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u091a\u0948\u091f \u0928\u0939\u0940\u0902, \u092f\u0939 \u090f\u0915 \u0930\u093f\u0936\u094d\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0926\u0947\u0916\u094b \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e AI \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0915\u094d\u092f\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964 \u090f\u0915 \u092e\u0948\u0938\u0947\u091c \u092d\u0947\u091c\u094b\u2014\u0935\u0939 \u091c\u0935\u093e\u092c \u0926\u0947\u0917\u093e\u0964 P.S. \u091c\u094b \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u092e\u0948\u0938\u0947\u091c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0924\u0940\u0928 \u0917\u0941\u0928\u093e \u0924\u0947\u091c\u093c\u0940 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092c\u0949\u0928\u094d\u0921 \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928 \u0924\u0915 \u092a\u0939\u0941\u0901\u091a\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u094d\u092f\u093e \u0924\u0941\u092e \u0935\u0939\u093e\u0901 \u0939\u094b?"
  ],
