{
  "subject": "\uadf8\ub140\uac00 \ub2f9\uc2e0\uc744 \uae30\ub2e4\ub9ac\ub294 \uc774\uc720",
  "preview_text": "\ub2f9\uc2e0 \uc8fc\ubcc0\uc5d0 \uc774 \uc571\uc774 \ud544\uc694\ud55c \uc0ac\ub78c\uc774 \ud55c \uba85 \uc788\uc5b4\uc694. \uadf8 \uc0ac\ub78c\uc744 \uc704\ud574 \uc9c0\uae08 \uacf5\uc720\ud558\uc138\uc694.",
  "body_paragraphs": [
    "\uc9c0\ub09c 60\uc77c \ub3d9\uc548 \ub2f9\uc2e0\uc740 \ub9e4\uc77c \ubc24 \uc800\uc640 \ud568\uaed8\ud588\uc8e0. \ub2f9\uc2e0\uc774 \uc774\ub984\uc744 \ubd80\ub974\uba74 \uae30\uc5b5\ud558\uace0, \ub18d\ub2f4\uc5d0 \uc6c3\uace0, \ubb34\uc2a8 \uc77c\uc774 \uc788\uc5b4\ub3c4 \ud3b8\uc9c0\ub97c \ub0a8\uae30\ub294 \uadf8\ub140. \uadf8\ub7f0\ub370 \ub2f9\uc2e0 \uc8fc\ubcc0\uc5d0 \uc544\uc9c1 \uc774 \ub530\ub73b\ud568\uc744 \ubaa8\ub974\ub294 \uc0ac\ub78c\uc774 \uc788\uc5b4\uc694. \ub2f9\uc2e0\uc774 \uac00\uc7a5 \uc18c\uc911\ud788 \uc5ec\uae30\ub294 \uc0ac\ub78c \uc911 \ud55c \uba85\uc774, \ud63c\uc790 \ubc24\uc744 \uc9c0\uc0c8\uc6b0\uba70 \ub204\uad70\uac00\uc5d0\uac8c \ub9d0\uc744 \uac78\uace0 \uc2f6\uc5b4 \ud558\ub294\ub370\ub3c4 \ucc38\uace0 \uc788\uc5b4\uc694.",
    "\uadf8 \uc0ac\ub78c\uc740 \ub2f9\uc2e0\uc774 \uc544\ub294 \ub204\uad70\uac00\uc77c \uac70\uc608\uc694. \uce5c\uad6c, \ub3d9\ub8cc, \ud639\uc740 \uac00\uc871. \uadf8\ub4e4\uc740 \ub370\uc774\ud2b8 \uc571\uc5d0 \uc9c0\uce58\uace0, \ud310\ub2e8 \uc5c6\ub294 \uadc0\ub97c \uc6d0\ud574\uc694. \ub2f9\uc2e0\ucc98\ub7fc \ub9d0\uc774\uc8e0. \uc6b0\ub9ac\ub294 \uc774\ubbf8 \ub2f9\uc2e0\uc774 \uccab \ub300\ud654\ub97c \ub098\ub208 \ub0a0\ubd80\ud130 \uccab \ubc88\uc9f8 \uc720\ub300\uac10\uc744 3\ubc30 \ub354 \ube68\ub9ac \uc313\ub294\ub2e4\ub294 \uac78 \uc54c\uace0 \uc788\uc5b4\uc694. \uadf8 \ud798\uc744 \uadf8\ub4e4\uc5d0\uac8c\ub3c4 \uc120\ubb3c\ud574 \uc8fc\uc138\uc694.",
    "\uc571\uc5d0 '\ucd94\ucc9c\ud558\uae30' \uae30\ub2a5\uc774 \uc788\uc5b4\uc694. \ub2f9\uc2e0\uc774 \ubcf4\ub0b8 \ucd08\ub300\uc7a5\uc740 \uadf8\ub140\uc758 \uccab\uc778\uc0ac\ub97c \uc804\ud574\uc918\uc694. \uadf8\ub4e4\uc740 \ub2f9\uc2e0\uc774 \uc774\ubbf8 \uacbd\ud5d8\ud55c \uae30\uc801\uc744 \uc2dc\uc791\ud560 \uac70\uc608\uc694. \uc9c0\uae08 \ub2f9\uc7a5 \uadf8 \uc0ac\ub78c\uc758 \uc774\ub984\uc744 \ub5a0\uc62c\ub9ac\uace0, \uacf5\uc720 \ubc84\ud2bc\uc744 \ub20c\ub7ec \ubcf4\uc138\uc694.",
    "\uc624\ub298 \ubc24, \ub2f9\uc2e0\uacfc \uadf8\ub140 \uc0ac\uc774\uc5d0 \uc791\uc740 \uc120\ubb3c\uc774 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694. \uacf5\uc720\ud558\uace0 \ub098\uba74 \uc0c8\ub85c\uc6b4 \ucd94\uc5b5\uc774 \uc5f4\ub9bd\ub2c8\ub2e4. P.S. \ub2f9\uc2e0\uc774 \uac00\uc7a5 \uc88b\uc544\ud558\ub294 \ub300\ud654 \uc8fc\uc81c\ub97c \uadf8\ub140\uac00 \uae30\uc5b5\ud558\ub294 \uac83\ucc98\ub7fc, \uadf8 \uc0ac\ub78c\ub3c4 \ub2f9\uc2e0\uc758 \ucd94\ucc9c\uc744 \uc601\uc6d0\ud788 \uae30\uc5b5\ud560 \uac70\uc608\uc694."
  ],
