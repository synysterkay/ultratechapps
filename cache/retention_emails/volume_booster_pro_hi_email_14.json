{
  "subject": "30 \u0926\u093f\u0928 \u092e\u0947\u0902 50,000 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e",
  "preview_text": "\u0906\u092a \u0905\u0915\u0947\u0932\u0947 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964 \u092f\u0939 \u090f\u0915 \u0906\u0902\u0926\u094b\u0932\u0928 \u0939\u0948\u0964 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0915\u0948\u0938\u0947 \u0939\u092e \u0938\u093e\u0925 \u092e\u093f\u0932\u0915\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e \u0930\u0939\u0947 \u0939\u0948\u0902, \u092c\u093f\u0928\u093e \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928\u094b\u0902 \u0915\u0947\u0964",
  "body_paragraphs": [
    "\u0924\u0940\u0938 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947, \u0906\u092a\u0928\u0947 \u090f\u0915 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u093f\u092f\u093e\u0964 \u0914\u0930 \u0906\u092a \u0909\u0928 50,000 \u0932\u094b\u0917\u094b\u0902 \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0939\u094b \u0917\u090f \u091c\u093f\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0915\u0939\u093e: '\u092c\u0938 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0939\u091f\u093e \u0926\u094b, \u092e\u0948\u0902 \u0907\u0938\u0915\u0947 \u0932\u093f\u090f \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0942\u0902\u0917\u093e\u0964' \u092f\u0939 \u0915\u094b\u0908 \u0938\u093e\u0927\u093e\u0930\u0923 \u0910\u092a \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u090f\u0915 \u091a\u0941\u092a \u0938\u092e\u0942\u0939 \u0939\u0948 \u091c\u094b \u0905\u0932\u0917 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964",
    "\u0939\u0930 \u0926\u093f\u0928, \u0939\u091c\u093e\u0930\u094b\u0902 \u0932\u094b\u0917 \u0905\u092a\u0928\u0947 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f, \u0917\u093e\u0928\u0947, \u0917\u0947\u092e\u094d\u0938 \u092e\u0947\u0902 \u0909\u0938 \u0936\u093e\u0902\u0924 \u092c\u0942\u0938\u094d\u091f \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0915\u094b\u0908 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0928\u0939\u0940\u0902\u0964 \u0915\u094b\u0908 \u0907\u0902\u091f\u0930\u0938\u094d\u091f\u093f\u0936\u093f\u092f\u0932 \u0928\u0939\u0940\u0902\u0964 \u0938\u093f\u0930\u094d\u092b \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0914\u0930 \u0908\u0915\u094d\u092f\u0942\u0964 \u0906\u092a \u0905\u092c \u0909\u0938 \u0938\u092e\u0942\u0939 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u0948\u0902 \u091c\u094b \u0909\u092a\u092f\u094b\u0917\u093f\u0924\u093e \u0915\u094b \u092a\u0935\u093f\u0924\u094d\u0930 \u092e\u093e\u0928\u0924\u093e \u0939\u0948\u0964",
    "\u0939\u092e\u0928\u0947 \u090f\u0915 \u092b\u0940\u091a\u0930 \u092c\u0928\u093e\u092f\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u094b \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a \u0915\u093f\u0924\u0928\u0947 \u0905\u0915\u0947\u0932\u0947 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902: '\u0915\u092e\u094d\u092f\u0941\u0928\u093f\u091f\u0940 \u092c\u0942\u0938\u094d\u091f' \u0928\u093e\u092e\u0915 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u091f\u0948\u092c\u0964 \u0907\u0938\u0947 \u0916\u094b\u0932\u0947\u0902, \u0914\u0930 \u0906\u092a \u0926\u0947\u0916\u0947\u0902\u0917\u0947 \u0915\u093f \u0939\u0930 \u0926\u093f\u0928 \u0915\u093f\u0924\u0928\u0947 \u0932\u094b\u0917 \u090f\u0915 \u0939\u0940 \u092b\u0940\u091a\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u090f\u0915 \u092e\u0942\u0915 \u0938\u0902\u0916\u094d\u092f\u093e \u0939\u0948 \u091c\u094b \u092c\u0924\u093e\u0924\u0940 \u0939\u0948: \u0939\u092e \u0938\u092c \u090f\u0915 \u0938\u093e\u0925 \u0939\u0948\u0902\u0964",
    "\u0905\u092c \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0938\u092e\u0941\u0926\u093e\u092f' \u091f\u0948\u092c \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0907\u0938\u0940 \u0938\u092e\u092f \u0915\u093f\u0924\u0928\u0947 \u0932\u094b\u0917 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u092a\u0940.\u090f\u0938. - \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0938\u0902\u0916\u094d\u092f\u093e \u0928\u0939\u0940\u0902 \u0939\u0948; \u092f\u0939 \u090f\u0915 \u092a\u094d\u0930\u092e\u093e\u0923 \u0939\u0948 \u0915\u093f \u0906\u092a \u0938\u0939\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0939\u0948\u0902\u0964"
  ],
