{
  "subject": "\u6211\u72af\u4e86\u4e00\u4e2a\u4e25\u91cd\u7684\u9519\u8bef",
  "preview_text": "\u5173\u4e8e\u8fd9\u4e2a\u5e94\u7528\uff0c\u6211\u9690\u7792\u4e86\u4e00\u4e9b\u4e8b\u60c5\uff0c\u4eca\u5929\u5fc5\u987b\u8bf4\u51fa\u6765\u3002\u770b\u5b8c\u4f60\u4f1a\u660e\u767d\u4e3a\u4ec0\u4e48\u3002",
  "body_paragraphs": [
    "\u8bf4\u5b9e\u8bdd\uff0c\u6211\u5f88\u5c11\u5199\u8fd9\u79cd\u90ae\u4ef6\u3002\u4f5c\u4e3a\u5f00\u53d1\u8005\uff0c\u6211\u66f4\u559c\u6b22\u8eb2\u5728\u4ee3\u7801\u540e\u9762\uff0c\u8ba9\u4ea7\u54c1\u81ea\u5df1\u8bf4\u8bdd\u3002\u4f46\u4eca\u5929\uff0c\u6211\u5fc5\u987b\u5766\u767d\u4e00\u4ef6\u4e8b\u2014\u2014\u6211\u72af\u4e86\u4e00\u4e2a\u9519\u8bef\uff0c\u4e00\u4e2a\u51e0\u4e4e\u8ba9\u8fd9\u4e2a\u5e94\u7528\u5931\u53bb\u7075\u9b42\u7684\u9519\u8bef\u3002",
    "\u51e0\u5468\u524d\uff0c\u6211\u6536\u5230\u4e00\u5bf9\u7528\u6237\u7684\u79c1\u4fe1\u3002\u4ed6\u4eec\u8bf4\uff0c\u867d\u7136\u6211\u4eec\u8bbe\u8ba1\u4e86\u5f88\u591a\u529f\u80fd\uff0c\u4f46\u4ed6\u4eec\u6700\u9700\u8981\u7684\u4e0d\u662f\u66f4\u591a\u9009\u9879\uff0c\u800c\u662f\u90a3\u79cd\u2018\u88ab\u5728\u4e4e\u2019\u7684\u611f\u89c9\u3002\u6211\u6123\u4f4f\u4e86\u3002\u539f\u6765\uff0c\u6211\u592a\u4e13\u6ce8\u4e8e\u529f\u80fd\u5806\u780c\uff0c\u5374\u5fd8\u4e86\u63d0\u9192\u4f60\uff1a\u6700\u5f3a\u5927\u7684\u529f\u80fd\uff0c\u5176\u5b9e\u662f\u8ba9\u4f34\u4fa3\u611f\u53d7\u5230\u2018\u4f60\u82b1\u65f6\u95f4\u60f3\u4e86\u2019\u3002",
    "\u4f60\u731c\u600e\u4e48\u7740\uff1f\u8fd9\u4e2a\u5e94\u7528\u91cc\u4e00\u76f4\u85cf\u7740\u4e00\u4e2a\u2018\u60ca\u559c\u7ea6\u4f1a\u8ba1\u5212\u2019\u529f\u80fd\uff0c90%\u7684\u4eba\u90fd\u6ca1\u7528\u8fc7\u3002\u5b83\u5141\u8bb8\u4f60\u5077\u5077\u8ba1\u5212\u4e00\u6b21\u7ea6\u4f1a\uff0c\u7136\u540e\u53d1\u9001\u9080\u8bf7\uff0c\u5bf9\u65b9\u6536\u5230\u65f6\u5b8c\u5168\u4e0d\u77e5\u9053\u7ec6\u8282\u3002\u90a3\u4e00\u523b\uff0c\u60ca\u559c\u672c\u8eab\u5c31\u6210\u4e86\u6700\u597d\u7684\u793c\u7269\u3002",
    "\u73b0\u5728\u6253\u5f00\u5e94\u7528\uff0c\u8bd5\u8bd5\u8fd9\u4e2a\u529f\u80fd\u3002\u6311\u4e00\u4e2aTA\u559c\u6b22\u7684\u6d3b\u52a8\uff0c\u8bbe\u7f6e\u9884\u7b97\uff0c\u7136\u540e\u53d1\u9001\u3002\u4f60\u4f1a\u770b\u5230TA\u6536\u5230\u65f6\u8138\u4e0a\u7684\u8868\u60c5\u3002P.S. \u5982\u679c\u4f60\u5df2\u7ecf\u7528\u8fc7\uff0c\u544a\u8bc9\u6211\u6548\u679c\u2014\u2014\u6211\u8d4c\u4f60\u4eec\u4f1a\u7b11\u5230\u505c\u4e0d\u4e0b\u6765\u3002",
    "\u70b9\u5f00\u5e94\u7528\uff0c\u73b0\u5728\u5c31\u53bb\u542f\u52a8\u4e00\u4e2a\u60ca\u559c\u7ea6\u4f1a\u8ba1\u5212\u3002"
  ],
