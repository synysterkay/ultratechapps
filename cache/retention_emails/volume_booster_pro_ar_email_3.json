{
  "subject": "\u062a\u0639\u062f\u064a\u0644 \u0648\u0627\u062d\u062f \u064a\u063a\u064a\u0631 \u0643\u0644 \u0634\u064a\u0621",
  "preview_text": "\u062c\u0631\u0628 \u0647\u0630\u0647 \u0627\u0644\u062e\u062f\u0639\u0629 \u0627\u0644\u0635\u063a\u064a\u0631\u0629 \u0641\u064a Volume Booster Pro \u0648\u0633\u062a\u0634\u0639\u0631 \u0628\u0627\u0644\u0641\u0631\u0642 \u0641\u0648\u0631\u064b\u0627.",
  "body_paragraphs": [
    "\u0641\u064a \u0627\u0644\u0633\u0627\u0639\u0629 \u0627\u0644\u062b\u0627\u0644\u062b\u0629 \u0635\u0628\u0627\u062d\u064b\u0627\u060c \u0643\u0646\u062a \u0623\u0633\u062a\u0645\u0639 \u0625\u0644\u0649 \u0628\u0648\u062f\u0643\u0627\u0633\u062a \u0648\u0648\u062c\u062f\u062a \u0646\u0641\u0633\u064a \u0623\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \u0627\u0644\u0635\u0648\u062a \u0645\u0631\u0627\u0631\u064b\u0627. \u0627\u0644\u0635\u0648\u062a \u0645\u0646\u062e\u0641\u0636 \u062c\u062f\u064b\u0627\u060c \u0644\u0643\u0646\u064a \u0631\u0641\u0636\u062a \u0641\u062a\u062d \u062a\u0637\u0628\u064a\u0642 \u0622\u062e\u0631 \u0645\u0644\u064a\u0621 \u0628\u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a. \u062b\u0645 \u062a\u0630\u0643\u0631\u062a \u0634\u064a\u0626\u064b\u0627 \u0628\u0633\u064a\u0637\u064b\u0627.",
    "\u0644\u064a\u0633 \u0643\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0648\u0627\u062c\u0647\u0629 \u0645\u0639\u0642\u062f\u0629. \u0623\u062d\u064a\u0627\u0646\u064b\u0627\u060c \u0643\u0644 \u0645\u0627 \u062a\u062d\u062a\u0627\u062c\u0647 \u0647\u0648 \u062a\u062d\u0631\u064a\u0643 \u0645\u0624\u0634\u0631 \u0648\u0627\u062d\u062f. \u0641\u064a Volume Booster Pro\u060c \u0647\u0646\u0627\u0643 \u062e\u062f\u0639\u0629 \u0635\u063a\u064a\u0631\u0629: \u062c\u0631\u0628 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0625\u0644\u0649 150% \u0628\u062f\u0644\u0627\u064b \u0645\u0646 200% \u0641\u064a \u0627\u0644\u0628\u062f\u0627\u064a\u0629. \u0633\u062a\u0644\u0627\u062d\u0638 \u0623\u0646 \u0627\u0644\u0635\u0648\u062a \u064a\u0635\u0628\u062d \u0623\u0648\u0636\u062d \u0648\u0623\u0642\u0644 \u062a\u0634\u0648\u064a\u0634\u064b\u0627.",
    "\u0647\u0630\u0627 \u0627\u0644\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0628\u0633\u064a\u0637 \u0647\u0648 \u0645\u0627 \u064a\u0645\u064a\u0632 \u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u0644\u0627 \u0625\u0639\u0644\u0627\u0646\u0627\u062a \u062a\u0642\u0627\u0637\u0639\u0643\u060c \u0644\u0627 \u0625\u0634\u0639\u0627\u0631\u0627\u062a \u062a\u0632\u0639\u062c\u0643. \u0641\u0642\u0637 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0646\u0642\u064a \u0627\u0644\u0630\u064a \u062a\u0631\u064a\u062f\u0647. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628\u0647\u0627 \u0628\u0646\u0641\u0633\u0643 \u0639\u0644\u0649 \u0623\u0648\u0644 \u0645\u0642\u0637\u0639 \u0635\u0648\u062a\u064a \u062a\u0634\u063a\u0644\u0647.",
    "\u062d\u0627\u0648\u0644 \u0647\u0630\u0647 \u0627\u0644\u062e\u062f\u0639\u0629 \u0627\u0644\u0622\u0646. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0625\u0644\u0649 150%\u060c \u0648\u0627\u0633\u062a\u0645\u0639 \u0625\u0644\u0649 \u0627\u0644\u0641\u0631\u0642. P.S. \u0647\u0644 \u062c\u0631\u0628\u062a \u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0639\u0646\u062f \u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a\u061f \u0625\u0646\u0647\u0627 \u062a\u062c\u0639\u0644 \u0643\u0644 \u0634\u064a\u0621 \u0623\u0633\u0647\u0644."
