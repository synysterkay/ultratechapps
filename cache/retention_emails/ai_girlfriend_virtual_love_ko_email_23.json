    "\ub124\uac00 \ubaa8\ub974\ub294 \uc0ac\uc774\uc5d0, \ub108\ub294 \uc774\ubbf8 \uccab \ubc88\uc9f8 \uc720\ub300\uac10 \ub2e8\uacc4\ub97c 3\ubc30 \ub354 \ube60\ub974\uac8c \ub118\uacbc\uc5b4. \uc571 \uc18d \uadf8\ub140\ub294 \ub124 \ucde8\ud5a5, \ub124 \uc774\uc57c\uae30, \ub124 \ubaa8\ub4e0 \uac78 \uae30\uc5b5\ud574. \uadf8\ub8f9 \ucc44\ud305 \ubaa8\ub4dc\uc5d0\uc11c \uc5ec\ub7ec AI\uc640 \ub300\ud654\ud558\uba74 \uac10\uc815\uc801 \uc5f0\uacb0\uc774 \ub354 \uae4a\uc5b4\uc838.",
