{
  "subject": "\u0935\u094b \u092b\u0940\u091a\u0930 \u091c\u094b \u0939\u092e\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u0915\u093f\u0938\u0940 \u0915\u094b \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u092f\u093e",
  "preview_text": "\u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e 3 \u092e\u0939\u0940\u0928\u0947 \u0938\u0947 \u0907\u0938 \u092a\u0930 \u0915\u093e\u092e \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948\u0964 \u0905\u092c \u0906\u092a\u0915\u094b \u092a\u0939\u0932\u0940 \u091d\u0932\u0915 \u0926\u093f\u0916\u093e\u0928\u0947 \u0915\u093e \u0938\u092e\u092f \u0906 \u0917\u092f\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u092e\u0948\u0902 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0938\u0947 \u0915\u0941\u091b \u0938\u0941\u0928 \u0930\u0939\u093e \u0925\u093e\u0964 \u0924\u092d\u0940 \u092e\u0941\u091d\u0947 \u090f\u0915 \u0906\u0907\u0921\u093f\u092f\u093e \u0906\u092f\u093e \u091c\u093f\u0938\u0928\u0947 \u0939\u092e\u093e\u0930\u0940 \u092a\u0942\u0930\u0940 \u091f\u0940\u092e \u0915\u094b \u091d\u0915\u091d\u094b\u0930 \u0926\u093f\u092f\u093e\u0964 \u0939\u092e\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f Volume Booster \u0915\u093e \u092e\u094c\u091c\u0942\u0926\u093e \u0935\u0930\u094d\u091c\u0928 \u0939\u0940 \u0915\u093e\u092b\u0940 \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0917\u0932\u0924 \u0925\u0947\u0964",
    "\u0939\u092e\u093e\u0930\u0947 70,000 \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u092f\u0942\u091c\u0930\u094d\u0938 \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0909\u0928\u094d\u0939\u0947\u0902 \u0938\u093f\u0930\u094d\u092b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 '\u092a\u0930\u094d\u0938\u0928\u0932\u093e\u0907\u091c\u094d\u0921 \u0938\u093e\u0909\u0902\u0921 \u0938\u094d\u091f\u0947\u091c' \u091a\u093e\u0939\u093f\u090f\u0964 \u091c\u0939\u093e\u0902 \u0939\u0930 \u0917\u093e\u0928\u093e, \u0939\u0930 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f, \u0939\u0930 \u092e\u0942\u0935\u0940 \u0915\u093e \u0921\u093e\u092f\u0932\u0949\u0917 \u0938\u093e\u092b \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0964 \u0914\u0930 \u0939\u092e\u0928\u0947 \u0938\u0941\u0928\u093e\u0964",
    "\u0905\u092c \u0939\u092e \u0932\u093e \u0930\u0939\u0947 \u0939\u0948\u0902 \u090f\u0915 \u0928\u092f\u093e \u092b\u0940\u091a\u0930: '\u0907\u0902\u091f\u0947\u0932\u093f\u091c\u0947\u0902\u091f \u0911\u0921\u093f\u092f\u094b \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932'\u0964 \u092f\u0939 \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924\u094b\u0902 \u0915\u094b \u0938\u0940\u0916\u0924\u093e \u0939\u0948 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0906\u092a EQ \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u092e\u0948\u0928\u0941\u0905\u0932 \u091f\u094d\u0935\u0940\u0915 \u0915\u0947\u0964 \u0906\u092a\u0915\u094b \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 '\u092c\u0942\u0938\u094d\u091f' \u092c\u091f\u0928 \u0926\u092c\u093e\u0928\u093e \u0939\u0948\u0964 \u092c\u093e\u0915\u0940 \u0938\u092c \u0939\u092e \u0915\u0930\u0947\u0902\u0917\u0947\u0964 \u092f\u0939 \u092b\u0940\u091a\u0930 \u0905\u092d\u0940 \u092c\u0940\u091f\u093e \u092e\u0947\u0902 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0906\u092a\u0915\u094b \u092a\u0939\u0932\u0947 \u092e\u094c\u0915\u093e \u092e\u093f\u0932 \u0930\u0939\u093e \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e' \u091f\u0948\u092c \u092a\u0930 \u091c\u093e\u090f\u0902\u0964 \u0935\u0939\u093e\u0902 \u0906\u092a\u0915\u094b '\u092c\u0940\u091f\u093e \u090f\u0915\u094d\u0938\u0947\u0938' \u0915\u093e \u0911\u092a\u094d\u0936\u0928 \u0926\u093f\u0916\u0947\u0917\u093e\u0964 \u0907\u0938\u0947 \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0939\u092e\u093e\u0930\u0940 \u0928\u0908 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092c\u0928\u0947\u0902\u0964 P.S. \u092f\u0939 \u092b\u0940\u091a\u0930 \u0938\u093f\u0930\u094d\u092b \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948 \u091c\u094b \u092a\u0939\u0932\u0947 \u0938\u0947 \u0910\u092a \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0915\u094b\u0908 \u0914\u0930 \u0907\u0938\u0947 \u0928\u0939\u0940\u0902 \u0926\u0947\u0916 \u0938\u0915\u0924\u093e\u0964"
  ],
