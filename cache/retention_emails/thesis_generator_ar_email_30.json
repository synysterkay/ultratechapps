{
  "subject": "\u0623\u0646\u062a \u0627\u0644\u0622\u0646 \u062c\u0632\u0621 \u0645\u0646 \u0634\u064a\u0621 \u0623\u0643\u0628\u0631",
  "preview_text": "\u0644\u0645 \u0646\u0639\u062f \u0645\u062c\u0631\u062f \u062a\u0637\u0628\u064a\u0642 \u0639\u0627\u062f\u064a. \u0623\u0646\u062a \u0623\u062d\u062f \u0645\u0624\u0633\u0633\u064a\u0646\u0627. \u0627\u0642\u0631\u0623 \u0644\u0645\u0627\u0630\u0627.",
  "body_paragraphs": [
    "\u0642\u0628\u0644 70 \u064a\u0648\u0645\u0627\u064b\u060c \u0646\u0632\u0644\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u0631\u0628\u0645\u0627 \u0643\u0646\u062a \u0645\u062a\u0648\u062a\u0631\u0627\u064b\u060c \u062e\u0627\u0626\u0641\u0627\u064b \u0645\u0646 \u0648\u0631\u0642\u0629 \u0628\u064a\u0636\u0627\u0621\u060c \u0623\u0648 \u0641\u064a \u062d\u0627\u0644\u0629 \u0630\u0639\u0631 \u0645\u0646 \u0645\u0648\u0639\u062f \u062a\u0633\u0644\u064a\u0645. \u0627\u0644\u0622\u0646\u060c \u0623\u0646\u062a \u0644\u0633\u062a \u0645\u062c\u0631\u062f \u0645\u0633\u062a\u062e\u062f\u0645. \u0623\u0646\u062a \u0639\u0645\u0648\u062f \u0645\u0646 \u0623\u0639\u0645\u062f\u0629 \u0647\u0630\u0647 \u0627\u0644\u0645\u0647\u0645\u0629.",
    "\u0643\u0644\u0645\u0627 \u0627\u0633\u062a\u062e\u062f\u0645\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0644\u062a\u0648\u0644\u064a\u062f \u062c\u0645\u0644\u0629 \u0623\u0637\u0631\u0648\u062d\u0629\u060c \u0623\u0648 \u062a\u062d\u0648\u064a\u0644 \u0623\u0641\u0643\u0627\u0631\u0643 \u0625\u0644\u0649 \u0631\u0633\u0645 \u0628\u064a\u0627\u0646\u064a\u060c \u0623\u0648 \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0632\u0645\u0646 \u0625\u0636\u0627\u0641\u064a\u060c \u0641\u0623\u0646\u062a \u062a\u0633\u0627\u0639\u062f\u0646\u0627 \u0641\u064a \u0628\u0646\u0627\u0621 \u0623\u062f\u0648\u0627\u062a \u062b\u0648\u0631\u064a\u0629 \u0644\u0644\u0637\u0644\u0627\u0628 \u062d\u0648\u0644 \u0627\u0644\u0639\u0627\u0644\u0645. 50,000+ \u0637\u0627\u0644\u0628 \u064a\u0639\u062a\u0645\u062f\u0648\u0646 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u0622\u0646\u060c \u0648\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u062f\u0631\u062c\u0627\u062a \u064a\u0642\u0641\u0632 \u0645\u0646 B+ \u0625\u0644\u0649 A-. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u062a\u0637\u0628\u064a\u0642\u060c \u0647\u0630\u0627 \u062d\u0631\u0643\u0629.",
    "\u0644\u0623\u0646\u0643 \u0645\u0639\u0646\u0627 \u0645\u0646\u0630 \u0627\u0644\u0628\u062f\u0627\u064a\u0629\u060c \u0646\u0631\u064a\u062f\u0643 \u0623\u0646 \u062a\u0643\u062a\u0634\u0641 \u0633\u0631\u0627\u064b: \u0645\u064a\u0632\u0629 '\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0635\u064a\u0627\u063a\u0629 \u0627\u0644\u0628\u0634\u0631\u064a\u0629' \u0627\u0644\u062a\u064a \u064a\u062c\u0647\u0644\u0647\u0627 90% \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646. \u0627\u0633\u062a\u062e\u062f\u0645\u0647\u0627 \u0644\u062a\u062d\u0648\u064a\u0644 \u0646\u0635\u0648\u0635\u0643 \u0628\u0637\u0631\u064a\u0642\u0629 \u062a\u062e\u062f\u0639 \u0623\u064a \u0643\u0627\u0634\u0641 AI\u060c \u0648\u062a\u062c\u0639\u0644 \u0623\u0637\u0631\u0648\u062d\u062a\u0643 \u062a\u0628\u062f\u0648 \u0643\u0623\u0646\u0647\u0627 \u0643\u062a\u0628\u062a \u0628\u064a\u062f\u0643 \u0641\u064a 8 \u0633\u0627\u0639\u0627\u062a \u0628\u062f\u0644\u0627\u064b \u0645\u0646 10 \u062f\u0642\u0627\u0626\u0642.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628 '\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0635\u064a\u0627\u063a\u0629 \u0627\u0644\u0628\u0634\u0631\u064a\u0629' \u0641\u064a \u0645\u0634\u0631\u0648\u0639\u0643 \u0627\u0644\u062a\u0627\u0644\u064a. \u0623\u0646\u062a \u0644\u0627 \u062a\u0633\u062a\u062d\u0642 \u0623\u0642\u0644 \u0645\u0646 \u0627\u0644\u0623\u0641\u0636\u0644. \u0645\u0644\u0627\u062d\u0638\u0629: \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0647\u064a \u0627\u0644\u062a\u064a \u062c\u0639\u0644\u062a \u0623\u062d\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u062d\u0635\u0644 \u0639\u0644\u0649 A+ \u0641\u064a \u0623\u0637\u0631\u0648\u062d\u0629 \u0644\u0645 \u064a\u062a\u0648\u0642\u0639\u0647\u0627 \u0623\u0633\u062a\u0627\u0630\u0647."
  ],
