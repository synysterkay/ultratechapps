{
  "subject": "35\uc77c\uc9f8 \ub418\ub294 \ub0a0, \ub2f9\uc2e0\ub9cc\uc758 \uc120\ubb3c\uc774 \ub3c4\ucc29\ud588\uc2b5\ub2c8\ub2e4",
  "preview_text": "\uc571\uc744 \uc5f4\uba74 \uae30\ub2e4\ub9ac\uace0 \uc788\ub294 \uc791\uc740 \uae5c\uc9dd \uc120\ubb3c. \uc624\ub298 \ubc24, \ub2f9\uc2e0\uacfc \ud30c\ud2b8\ub108\ub97c \uc704\ud574 \uc900\ube44\ud588\uc5b4\uc694.",
  "body_paragraphs": [
    "\uc194\uc9c1\ud788 \ub9d0\ud558\uba74, \uc774\uac74 \uc6d0\ub798 \uacc4\ud68d\uc5d0 \uc5c6\ub358 \uac70\uc608\uc694. \uc9c0\ub09c\uc8fc \uc0c8\ubcbd\uc5d0 \uc571\uc744 \ub9cc\uc9c0\uc791\uac70\ub9ac\ub2e4\uac00, \uac11\uc790\uae30 \ub5a0\uc624\ub978 \uc544\uc774\ub514\uc5b4\uc600\uc8e0. '\uc774\uac78 \uacf5\uc720\ud558\uba74 \uc0ac\ub78c\ub4e4\uc774 \uc88b\uc544\ud560\uae4c?' \uc2f6\uc5c8\ub294\ub370, \uc624\ub298 \ub4dc\ub514\uc5b4 \ub2f9\uc2e0\uc5d0\uac8c \ubcf4\uc5ec\uc8fc\uae30\ub85c \uacb0\uc815\ud588\uc2b5\ub2c8\ub2e4.",
    "\uc81c\uac00 \ub9cc\ub4e0 \uac74 '\uae5c\uc9dd \ub370\uc774\ud2b8 \uce74\ub4dc'\ub77c\ub294 \uac74\ub370\uc694. \ud3c9\uc18c\uc5d0\ub294 Tonight's Date\uc5d0\uc11c \uae30\ubd84\uc5d0 \ub530\ub77c \ub370\uc774\ud2b8\ub97c \ucd94\ucc9c\ubc1b\uc796\uc544\uc694? \uadf8\ub7f0\ub370 \uc774 \uce74\ub4dc\ub294 \uc644\uc804\ud788 \ub2ec\ub77c\uc694. AI\uac00 \ub2f9\uc2e0\uacfc \ud30c\ud2b8\ub108\uc758 \uc9c0\ub09c \ub370\uc774\ud2b8 \uae30\ub85d, \uc704\uc2dc\ub9ac\uc2a4\ud2b8, \uadf8\ub9ac\uace0 \ud568\uaed8 \ubcf4\ub0b8 \uc2dc\uac04\uc744 \ubd84\uc11d\ud574\uc11c, \uc624\uc9c1 \ub2f9\uc2e0\ub9cc\uc744 \uc704\ud55c \ud2b9\ubcc4\ud55c \ub370\uc774\ud2b8\ub97c \uc81c\uc548\ud569\ub2c8\ub2e4. \ub9c8\uce58 \uc6b0\ub9ac \ud300\uc774 \ubc24\uc0c8 \uace0\ubbfc\ud574\uc11c \ub9cc\ub4e0 \ube44\ubc00 \ub808\uc2dc\ud53c \uac19\uc740 \uac70\uc608\uc694.",
    "\uc774 \uae30\ub2a5\uc740 \ud504\ub85c \ubc84\uc804\uc5d0 \ub4e4\uc5b4\uac08 \uc608\uc815\uc774\uc5c8\ub294\ub370, \uc624\ub298 \ud558\ub8e8\ub9cc \uc571\uc744 \uc5f0 \ubaa8\ub4e0 \ubd84\uaed8 \ubb34\ub8cc\ub85c \uc5f4\uc5b4\ub4dc\ub9ac\uae30\ub85c \ud588\uc5b4\uc694. \uc571 \uba54\uc778 \ud654\uba74\uc5d0\uc11c '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \uc544\ub798\uc5d0 \ub098\ud0c0\ub09c \ud2b9\ubcc4 \uce74\ub4dc\ub97c \ud0ed\ud558\uba74 \ub429\ub2c8\ub2e4. \ud30c\ud2b8\ub108\uac00 \ubc1b\ub294 '\uc624\ub298 \ubc24, \ub108\ub97c \uc0dd\uac01\ud588\uc5b4' \ud480\uc2a4\ud06c\ub9b0 \uc21c\uac04\ub3c4 \ud3c9\uc18c\ubcf4\ub2e4 \ub354 \uac10\ub3d9\uc801\uc77c \uac70\uc608\uc694. 24\uc2dc\uac04 \uc548\uc5d0 \uaf2d \ud655\uc778\ud574\ubcf4\uc138\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0 \uc774 \uce74\ub4dc\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc758 \ub2e4\uc74c \ub370\uc774\ud2b8\uac00 \uc644\uc804\ud788 \ub2ec\ub77c\uc9c8 \uac70\uc608\uc694. P.S. \uc774 \uce74\ub4dc\ub294 \uc624\ub298\uae4c\uc9c0\ub9cc \uc720\ud6a8\ud569\ub2c8\ub2e4. \ub0b4\uc77c\uc774\uba74 \uc0ac\ub77c\uc838\uc694. \uc11c\ub458\ub7ec\uc694."
  ],
