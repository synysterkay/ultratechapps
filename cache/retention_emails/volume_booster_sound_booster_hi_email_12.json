{
  "subject": "\u0935\u094b 2AM \u0915\u093e \u090f\u0915\u094d\u0938\u092a\u0947\u0930\u093f\u092e\u0947\u0902\u091f \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u090f\u0915 \u092f\u0942\u091c\u0930 \u0928\u0947 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0915\u0941\u091b \u091f\u094d\u0930\u093e\u0908 \u0915\u093f\u092f\u093e \u0914\u0930 \u0909\u0938\u0915\u093e \u092b\u094b\u0928 \u0939\u0940 \u092c\u0926\u0932 \u0917\u092f\u093e\u0964 \u0935\u094b \u092b\u0940\u091a\u0930 \u0905\u092c \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u092d\u0940 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c\u0947 \u0925\u0947\u0964 \u090f\u0915 \u092f\u0942\u091c\u0930 \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u0947 \u0915\u094b \u0938\u0941\u0928 \u0930\u0939\u093e \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092e\u0948\u0915\u094d\u0938 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0935\u091c\u0942\u0926 \u0906\u0935\u093e\u091c\u093c \u092c\u0947\u091c\u093e\u0928 \u0932\u0917 \u0930\u0939\u0940 \u0925\u0940\u0964 \u0909\u0938\u0928\u0947 \u092c\u094b\u0930 \u0939\u094b\u0915\u0930 \u0939\u092e\u093e\u0930\u0947 \u0910\u092a \u092e\u0947\u0902 \u090f\u0915 \u092c\u091f\u0928 \u0926\u092c\u093e\u092f\u093e \u091c\u093f\u0938\u0947 \u0909\u0938\u0928\u0947 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0928\u094b\u091f\u093f\u0938 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u092a\u0932 \u092d\u0930 \u092e\u0947\u0902, \u0909\u0938\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u090f\u0915 \u0928\u0908 \u0926\u0941\u0928\u093f\u092f\u093e \u092c\u0938 \u0917\u0908\u0964 \u092c\u093e\u0938 \u0917\u0939\u0930\u093e \u0925\u093e, \u0906\u0935\u093e\u091c\u093c \u0938\u093e\u092b \u0925\u0940, \u0914\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0907\u0924\u0928\u093e \u091c\u093c\u094b\u0930\u0926\u093e\u0930 \u0915\u093f \u092a\u0942\u0930\u093e \u0915\u092e\u0930\u093e \u0917\u0942\u0902\u091c \u0909\u0920\u093e\u0964",
    "\u0909\u0938 \u092f\u0942\u091c\u0930 \u0928\u0947 \u092c\u093e\u0926 \u092e\u0947\u0902 \u0939\u092e\u0947\u0902 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0935\u0939 \u092b\u0940\u091a\u0930 \u0909\u0938\u0915\u0947 \u0932\u093f\u090f \u0917\u0947\u092e-\u091a\u0947\u0902\u091c\u0930 \u0925\u093e\u0964 \u0935\u0939 \u0905\u092c \u0939\u0930 \u0926\u093f\u0928 \u0909\u0938\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u093e \u0939\u0948 - \u091a\u093e\u0939\u0947 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u0928\u093e \u0939\u094b, \u092f\u0942\u091f\u094d\u092f\u0942\u092c \u0926\u0947\u0916\u0928\u093e \u0939\u094b, \u092f\u093e \u0928\u0947\u091f\u092b\u094d\u0932\u093f\u0915\u094d\u0938 \u092a\u0930 \u092e\u0942\u0935\u0940\u0964 \u0909\u0938\u0928\u0947 \u0915\u0939\u093e, '\u092e\u0941\u091d\u0947 \u0932\u0917\u0924\u093e \u0925\u093e \u092e\u0947\u0930\u0947 \u092b\u094b\u0928 \u0915\u0947 \u0938\u094d\u092a\u0940\u0915\u0930 \u0916\u0930\u093e\u092c \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932 \u092e\u0947\u0902 \u092e\u0948\u0902 \u0938\u093f\u0930\u094d\u092b \u0938\u0939\u0940 \u092b\u0940\u091a\u0930 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964'",
    "\u0935\u0939 \u092b\u0940\u091a\u0930 \u0939\u0948 \u0939\u092e\u093e\u0930\u093e Bass Booster \u0914\u0930 Loudness Enhancer \u0915\u093e \u0915\u0949\u092e\u094d\u092c\u093f\u0928\u0947\u0936\u0928\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0910\u092a \u0916\u094b\u0932\u0947\u0902, Bass Booster \u0915\u094b \u0911\u0928 \u0915\u0930\u0947\u0902, \u0914\u0930 \u092b\u093f\u0930 Loudness Enhancer \u0915\u094b \u090f\u0915 \u092c\u093e\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u0906\u092a\u0915\u094b \u0932\u0917\u0947\u0917\u093e \u091c\u0948\u0938\u0947 \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u092e\u0947\u0902 \u090f\u0915 \u0928\u092f\u093e \u0938\u094d\u092a\u0940\u0915\u0930 \u0932\u0917 \u0917\u092f\u093e \u0939\u0948\u0964 \u092f\u0939 \u0938\u0947\u091f\u093f\u0902\u0917 \u0938\u093f\u0938\u094d\u091f\u092e-\u0935\u093e\u0907\u0921 \u0915\u093e\u092e \u0915\u0930\u0924\u0940 \u0939\u0948 - Spotify, YouTube, Netflix, \u0938\u092c\u092e\u0947\u0902\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0924\u094b \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0932\u0947\u0935\u0932 \u0914\u0930 \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 EQ \u092d\u0940 \u0939\u0948\u0964",
    "\u0905\u092c \u0906\u092a\u0915\u0940 \u092c\u093e\u0930\u0940 \u0939\u0948\u0964 \u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 Bass Booster + Loudness Enhancer \u0915\u094b \u090f\u0915 \u0938\u093e\u0925 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902\u0964 \u0938\u093f\u0930\u094d\u092b 10 \u0938\u0947\u0915\u0902\u0921 \u0932\u0917\u0947\u0902\u0917\u0947, \u0932\u0947\u0915\u093f\u0928 \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u092b\u093f\u0930 \u0915\u092d\u0940 \u092a\u0939\u0932\u0947 \u091c\u0948\u0938\u093e \u0928\u0939\u0940\u0902 \u0932\u0917\u0947\u0917\u093e\u0964 P.S. \u0905\u0917\u0930 \u0906\u092a \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0902, \u0924\u094b \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0932\u0947\u0935\u0932 \u0915\u0947 \u0938\u093e\u0925 \u092f\u0939 \u092b\u0940\u091a\u0930 \u0914\u0930 \u092d\u0940 \u091c\u093c\u092c\u0930\u0926\u0938\u094d\u0924 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964"
  ],
