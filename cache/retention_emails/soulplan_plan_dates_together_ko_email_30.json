{
  "subject": "\ub2f9\uc2e0\uc774 \uc6b0\ub9ac\ub97c \ubc14\uafbc \uc21c\uac04",
  "preview_text": "70\uc77c \uc804, \ub2f9\uc2e0\uc774 \ub0b4\ub9b0 \uc120\ud0dd\uc774 \uc6b0\ub9ac \uc571\uc758 \ubbf8\ub798\ub97c \ubc14\uafe8\uc5b4\uc694. \uadf8 \uc774\uc57c\uae30\ub97c \ub4e4\ub824\ub4dc\ub9b4\uac8c\uc694.",
  "body_paragraphs": [
    "70\uc77c \uc804, \ub2f9\uc2e0\uc774 SoulPlan\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud55c \uc21c\uac04, \uc6b0\ub9ac\ub294 \ub2f9\uc2e0\uc774 \ub2e8\uc21c\ud55c \uc0ac\uc6a9\uc790\uac00 \uc544\ub2c8\ub77c\ub294 \uac78 \uc54c\uc558\uc5b4\uc694. \ub2f9\uc2e0\uc740 \ub370\uc774\ud2b8\ub97c \uacc4\ud68d\ud558\ub294 \uc0ac\ub78c\uc774 \uc544\ub2c8\ub77c, \uad00\uacc4\ub97c \uc0b4\uc544 \uc228\uc26c\uac8c \ud558\ub294 \ucc3d\uc870\uc790\uc600\uc8e0. \uc624\ub298, \uc6b0\ub9ac\uac00 \ub2f9\uc2e0\uc5d0\uac8c \uac10\uc0ac\ud558\uace0 \uc2f6\uc740 \uc774\uc720\uac00 \uc788\uc2b5\ub2c8\ub2e4.",
    "\uc6b0\ub9ac\uac00 \ub9cc\ub4e0 \ubaa8\ub4e0 \uae30\ub2a5\uc740 \ub2f9\uc2e0 \uac19\uc740 \ucee4\ud50c\uc758 \uc791\uc740 \uc21c\uac04\uc5d0\uc11c \uc601\uac10\uc744 \ubc1b\uc558\uc5b4\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub294 \ub2f9\uc2e0\uc774 '\uc624\ub298\uc740 \ubb58 \ud558\uc9c0?'\ub77c\uace0 \uace0\ubbfc\ud558\ub294 \uc21c\uac04\uc5d0 \ud0dc\uc5b4\ub0ac\uace0, '\uba54\ubaa8\ub9ac \ud0c0\uc784\ub77c\uc778'\uc740 \ub2f9\uc2e0\uc774 \uc78a\uace0 \uc2f6\uc9c0 \uc54a\uc740 \ucd94\uc5b5\uc744 \uae30\ub85d\ud558\ub294 \uc2b5\uad00\uc5d0\uc11c \ube44\ub86f\ub410\uc8e0. \ub2f9\uc2e0\uc758 \ud53c\ub4dc\ubc31 \ud558\ub098\ud558\ub098\uac00 \uc6b0\ub9ac\uc758 \uae38\uc7a1\uc774\uc600\uc2b5\ub2c8\ub2e4.",
    "\uc774\uc81c, \ub2f9\uc2e0\uc740 \uc6b0\ub9ac \ucee4\ubba4\ub2c8\ud2f0\uc758 \uc77c\ubd80\uc785\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \ub370\uc774\ud2b8 \uc2a4\ud1a0\ub9ac\ub294 \ub2e4\ub978 \ucee4\ud50c\uc5d0\uac8c \uc601\uac10\uc774 \ub418\uace0, \ub2f9\uc2e0\uc758 \uc704\uc2dc\ub9ac\uc2a4\ud2b8\ub294 AI\uc758 \uc228\uaca8\uc9c4 \ub808\ud37c\ud1a0\ub9ac\uac00 \ub429\ub2c8\ub2e4. \uc6b0\ub9ac\ub294 \ub2f9\uc2e0\uc758 \ucc38\uc5ec\ub85c \ub9cc\ub4e4\uc5b4\uc9d1\ub2c8\ub2e4\u2014\ub2f9\uc2e0 \uc5c6\uc774\ub294 \uc774 \uc571\uc774 \uc644\uc131\ub418\uc9c0 \uc54a\uc544\uc694.",
    "\uc624\ub298 \ubc24, '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \uc5f4\uc5b4\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc758 \ud30c\ud2b8\ub108\uc5d0\uac8c '\uc624\ub298\uc740 \ub108\ub97c \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0b4\ub294 \uac83\ub9cc\uc73c\ub85c\ub3c4, \ub2f9\uc2e0\uc774 \uc774 \uc5ec\uc815\uc758 \uc911\uc2ec\uc5d0 \uc788\ub2e4\ub294 \uac78 \ub290\ub084 \uc218 \uc788\uc744 \uac70\uc608\uc694. P.S. \ub2f9\uc2e0\uc758 \uccab \ub370\uc774\ud2b8 \uae30\ub85d\uc774 \uc544\uc9c1 \uba54\ubaa8\ub9ac \ud0c0\uc784\ub77c\uc778\uc5d0 \uc5c6\ub2e4\uba74, \uc624\ub298 \ucd94\uac00\ud574\ubcf4\uc138\uc694. \uadf8 \uc21c\uac04\uc774 \uc601\uc6d0\ud788 \ub0a8\uc744 \uac70\uc608\uc694."
  ],
