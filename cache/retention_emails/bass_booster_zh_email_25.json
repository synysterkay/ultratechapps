{
  "subject": "\u51cc\u66683\u70b9\uff0c\u4ed6\u7528\u4f60\u7684\u4f4e\u97f3\u70ae\u542c\u4e86\u8fd9\u4e2a",
  "preview_text": "\u4e00\u4e2a\u7528\u6237\u53d1\u6765\u6d88\u606f\uff0c\u8bf4\u4ed6\u628aBass Booster\u7528\u5728\u4e86\u6700\u5947\u602a\u7684\u5730\u65b9\u2014\u2014\u7ed3\u679c\u6574\u4e2a\u516c\u5bd3\u90fd\u9707\u52a8\u4e86\u3002",
  "body_paragraphs": [
    "\u4e0a\u5468\u6536\u5230\u4e00\u5c01\u90ae\u4ef6\uff0c\u6807\u9898\u5199\u7740\uff1a'\u4f60\u7684App\u6551\u4e86\u6211\u5bb6\u6d3e\u5bf9'\u3002\u6211\u4ee5\u4e3a\u662f\u5ba2\u5957\u8bdd\uff0c\u70b9\u5f00\u4e00\u770b\uff0c\u4ed6\u53d1\u6765\u4e00\u6bb5\u89c6\u9891\u2014\u2014\u4e00\u7fa4\u4eba\u56f4\u7740\u624b\u673a\uff0c\u4f4e\u97f3\u628a\u684c\u4e0a\u7684\u676f\u5b50\u9707\u5f97\u5494\u5494\u54cd\u3002\u90a3\u4e00\u523b\u6211\u6123\u4f4f\u4e86\u3002\u6211\u8bbe\u8ba1Bass Booster\u662f\u4e3a\u4e86\u8ba9\u4f60\u5728\u901a\u52e4\u8def\u4e0a\u542cHip-Hop\u65f6\u80f8\u53e3\u6709\u9707\u52a8\uff0c\u4ece\u6ca1\u60f3\u8fc7\u6709\u4eba\u4f1a\u7528\u5b83\u6765\u5f53\u4e34\u65f6\u97f3\u54cd\u7cfb\u7edf\u3002",
    "\u4ed6\u544a\u8bc9\u6211\uff0c\u5f53\u65f6\u97f3\u54cd\u574f\u4e86\uff0c\u670b\u53cb\u4eec\u90fd\u5728\u7b49\u97f3\u4e50\u3002\u4ed6\u7075\u673a\u4e00\u52a8\uff0c\u628a\u624b\u673a\u653e\u8fdb\u4e00\u4e2a\u7a7a\u6728\u7bb1\uff0c\u6253\u5f00Bass Booster\u7684200%\u97f3\u91cf\u589e\u5f3a\u548c3D\u73af\u7ed5\u3002\u7ed3\u679c\u4f60\u731c\u600e\u4e48\u7740\uff1f\u4f4e\u97f3\u4ece\u7bb1\u5b50\u91cc\u53cd\u5f39\u51fa\u6765\uff0c\u6574\u4e2a\u623f\u95f4\u50cf\u88c5\u4e86\u4f4e\u97f3\u70ae\u3002\u4ed6\u8bf4\uff1a'\u6211\u7684\u8033\u819c\u5dee\u70b9\u62a5\u5e9f\uff0c\u4f46\u6c14\u6c1b\u71c3\u7206\u4e86\u3002'\u8fd9\u5c31\u662f\u4e3a\u4ec0\u4e48\u6211\u8ba8\u538c\u544a\u8bc9\u4f60\u600e\u4e48\u7528\u4f60\u7684App\u2014\u2014\u4f60\u603b\u4f1a\u53d1\u73b0\u6211\u60f3\u4e0d\u5230\u7684\u8def\u5b50\u3002",
    "\u90a3\u4e2a\u6a21\u5f0f\u5c31\u662f'\u6d3e\u5bf9\u6a21\u5f0f'\u7684\u96cf\u5f62\u3002\u4e0d\u662f\u5f00\u73a9\u7b11\u3002\u5728Bass Booster\u91cc\uff0c\u62d6\u4e00\u4e0b\u589e\u5f3a\u6ed1\u5757\u5230\u6700\u5927\uff0c\u7136\u540e\u6253\u5f003D\u73af\u7ed5\u3002\u4f60\u7684\u624b\u673a\u626c\u58f0\u5668\u4f1a\u88ab\u63a8\u5230\u6781\u9650\uff0c\u4f46\u4e0d\u4f1a\u7834\u97f3\u3002\u8bd5\u8bd5\u628a\u624b\u673a\u653e\u5728\u4e00\u4e2a\u6728\u7897\u6216\u7a7a\u62bd\u5c49\u91cc\u2014\u2014\u4f4e\u97f3\u4f1a\u50cf\u4ece\u5730\u5e95\u4e0b\u94bb\u51fa\u6765\u4e00\u6837\u3002",
    "\u73b0\u5728\u5c31\u53bbBass Booster\uff0c\u62d6\u589e\u5f3a\u6ed1\u5757\u5230200%\uff0c\u7136\u540e\u968f\u4fbf\u653e\u4e00\u9996Trap\u3002\u627e\u4e2a\u7a7a\u76d2\u5b50\u6216\u89d2\u843d\u653e\u624b\u673a\u3002\u542c\u90a3\u4e2a\u4f4e\u97f3\u600e\u4e48\u5f39\u56de\u6765\u3002P.S. \u5982\u679c\u90bb\u5c45\u6765\u6572\u95e8\uff0c\u544a\u8bc9\u4ed6\u4eec\u662f\u6211\u8ba9\u4f60\u8fd9\u4e48\u505a\u7684\u2014\u2014\u987a\u4fbf\u63d0\u4e00\u53e5\uff0c\u5347\u7ea7\u5230Premium\u540e\uff0c\u65e0\u9650\u589e\u5f3a\u548c10\u6bb5\u5747\u8861\u5668\u80fd\u8ba9\u8fd9\u4e2a\u6548\u679c\u518d\u7ffb\u4e00\u500d\u3002\u4f46\u4eca\u5929\uff0c\u5148\u8bd5\u8bd5\u90a3\u4e2a\u7a7a\u76d2\u5b50\u3002"
  ],
