{
  "subject": "\u0905\u092c \u092c\u093e\u0930\u093f\u0936 \u0915\u0947 \u092e\u094c\u0938\u092e \u092e\u0947\u0902 \u0917\u093e\u0928\u0947 \u0938\u0941\u0928\u0947\u0902 \u092c\u0942\u0938\u094d\u091f\u0947\u0921 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092a\u0930",
  "preview_text": "\u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u0905\u092c \u0924\u0915 \u0915\u093f\u0924\u0928\u093e \u0915\u092e\u091c\u094b\u0930 \u0932\u0917\u0924\u093e \u0939\u0948? \u091c\u093e\u0928\u093f\u090f \u0907\u0938 \u092e\u094c\u0938\u092e \u092e\u0947\u0902 \u0915\u0948\u0938\u0947 \u0915\u0930\u0947\u0902 \u0938\u093e\u0909\u0902\u0921 \u0915\u094b \u091a\u093e\u0930 \u0917\u0941\u0928\u093e \u0924\u0947\u091c\u0964",
  "body_paragraphs": [
    "\u092c\u093e\u0939\u0930 \u092c\u093e\u0930\u093f\u0936 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948, \u0914\u0930 \u0906\u092a\u0915\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u093e \u092c\u091c \u0930\u0939\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0938\u094d\u092a\u0940\u0915\u0930 \u0938\u0947 \u0906\u0935\u093e\u091c \u0907\u0924\u0928\u0940 \u0927\u0940\u092e\u0940 \u0915\u093f \u0938\u0941\u0928\u093e\u0908 \u0928\u0939\u0940\u0902 \u0926\u0947\u0924\u093e\u0964 \u092f\u0939\u0940 \u0935\u0939 \u092a\u0932 \u0939\u0948 \u091c\u092c \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u0940 \u0905\u0938\u0932\u0940 \u0924\u093e\u0915\u0924 \u092a\u0924\u093e \u091a\u0932\u0924\u0940 \u0939\u0948\u0964 \u092f\u093e \u0928\u0939\u0940\u0902 \u091a\u0932\u0924\u0940?",
    "\u0915\u0932 \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 \u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u092f\u0939\u0940 \u0905\u0928\u0941\u092d\u0935 \u0915\u093f\u092f\u093e\u0964 \u092c\u093e\u0930\u093f\u0936 \u092e\u0947\u0902 \u092c\u0948\u0920\u0947 \u0925\u0947, \u0914\u0930 \u0909\u0938\u0915\u093e \u092b\u094b\u0928 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u092c\u0947\u091c\u093e\u0928 \u0932\u0917 \u0930\u0939\u093e \u0925\u093e\u0964 \u092b\u093f\u0930 \u092e\u0948\u0902\u0928\u0947 \u0909\u0938\u0947 Volume Booster - Sound Booster \u0915\u093e Bass Booster \u092b\u0940\u091a\u0930 \u0926\u093f\u0916\u093e\u092f\u093e\u0964 \u090f\u0915 \u091f\u0948\u092a \u092e\u0947\u0902 \u0938\u093e\u0909\u0902\u0921 \u0907\u0924\u0928\u093e \u0917\u0939\u0930\u093e \u0914\u0930 \u0924\u0947\u091c \u0939\u094b \u0917\u092f\u093e \u0915\u093f \u0939\u092e \u0926\u094b\u0928\u094b\u0902 \u0939\u0948\u0930\u093e\u0928 \u0930\u0939 \u0917\u090f\u0964 \u092f\u0939 \u0915\u094b\u0908 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u092e\u0947\u0902 \u092a\u0939\u0932\u0947 \u0938\u0947 \u092e\u094c\u091c\u0942\u0926 \u090f\u0915 \u091b\u093f\u092a\u0940 \u0939\u0941\u0908 \u0915\u094d\u0937\u092e\u0924\u093e \u0939\u0948\u0964",
    "\u0907\u0938 \u092e\u094c\u0938\u092e \u092e\u0947\u0902 \u091c\u092c \u0906\u092a \u0918\u0930 \u092a\u0930 \u0939\u094b\u0902 \u092f\u093e \u092c\u093e\u0939\u0930, \u092f\u0939 \u0910\u092a \u0906\u092a\u0915\u094b \u0935\u0939 \u0915\u094d\u0935\u093e\u0932\u093f\u091f\u0940 \u0926\u0947\u0924\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u092e\u0947\u0902 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0925\u0940\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 Equalizer \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 'Rock' \u092f\u093e 'Jazz' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091a\u0941\u0928\u0947\u0902\u0964 \u0906\u092a\u0915\u094b \u0932\u0917\u0947\u0917\u093e \u0915\u093f \u0906\u092a \u0915\u0949\u0928\u094d\u0938\u0930\u094d\u091f \u092e\u0947\u0902 \u0939\u0948\u0902\u0964 \u0914\u0930 \u0939\u093e\u0901, \u092c\u093f\u0928\u093e \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0915\u0947 \u092d\u0940 \u092f\u0939 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u0917\u0930 \u0906\u092a \u0905\u0938\u0932\u0940 \u092a\u093e\u0935\u0930 \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0947\u0902\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 Bass Booster \u0915\u094b \u0911\u0928 \u0915\u0930\u0947\u0902\u0964 \u092c\u093e\u0930\u093f\u0936 \u0915\u0940 \u092c\u0942\u0902\u0926\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0905\u092a\u0928\u0947 \u0917\u093e\u0928\u0947 \u0915\u093e \u092e\u091c\u093e \u0932\u0947\u0902\u0964 P.S. - \u0905\u0917\u0930 \u0906\u092a\u0915\u094b \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u0938\u093e\u0909\u0902\u0921 \u0905\u092c \u092d\u0940 \u0915\u092e \u0939\u0948, \u0924\u094b \u0939\u092e\u093e\u0930\u0947 '\u0932\u093e\u0909\u0921\u0928\u0947\u0938 \u090f\u0928\u094d\u0939\u093e\u0902\u0938\u0930' \u0915\u094b \u090f\u0915 \u092c\u093e\u0930 \u091c\u0930\u0942\u0930 \u0906\u091c\u092e\u093e\u090f\u0902\u0964 \u092f\u0939 \u0935\u0939 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u094b \u0915\u092d\u0940 \u0928\u093f\u0930\u093e\u0936 \u0928\u0939\u0940\u0902 \u0915\u0930\u0947\u0917\u093e\u0964"
  ],
