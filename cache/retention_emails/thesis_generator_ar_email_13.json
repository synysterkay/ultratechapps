{
  "subject": "\u0634\u0647\u0631 \u0643\u0627\u0645\u0644 \u0645\u0639 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u2013 \u0645\u0627\u0630\u0627 \u0623\u0646\u062c\u0632\u062a\u061f",
  "preview_text": "\u0644\u0645 \u062a\u0645\u0631 28 \u064a\u0648\u0645\u064b\u0627 \u0633\u062f\u0649. \u062a\u0639\u0631\u0651\u0641 \u0639\u0644\u0649 \u0625\u0646\u062c\u0627\u0632\u0627\u062a\u0643 \u0627\u0644\u0645\u0630\u0647\u0644\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642.",
  "body_paragraphs": [
    "\u0642\u0628\u0644 28 \u064a\u0648\u0645\u064b\u0627\u060c \u0646\u0632\u0644\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u0623\u0646\u062a \u062a\u0642\u0627\u062a\u0644 \u0633\u0627\u0639\u0629 \u0627\u0644\u0635\u0641\u0631. \u0627\u0644\u064a\u0648\u0645\u060c \u0623\u0646\u062a \u0644\u0633\u062a \u0646\u0641\u0633 \u0627\u0644\u0634\u062e\u0635. \u0647\u0644 \u062a\u0630\u0643\u0631 \u0643\u0645 \u0631\u0633\u0627\u0644\u0629 \u0628\u062f\u0623\u062a\u0647\u0627\u061f \u0643\u0645 \u0633\u0627\u0639\u0629 \u0648\u0641\u0631\u062a\u0647\u0627\u061f \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u064a\u062d\u0635\u064a \u0643\u0644 \u062e\u0637\u0648\u0629\u060c \u0648\u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0635\u0627\u062f\u0645\u0629.",
    "\u0641\u064a \u0623\u0648\u0644 \u0634\u0647\u0631\u060c \u0623\u0646\u0634\u0623\u062a \u0645\u062a\u0648\u0633\u0637 3 \u0645\u0633\u0648\u062f\u0627\u062a \u0643\u0627\u0645\u0644\u0629\u060c \u0648\u0648\u0641\u0631\u062a 12 \u0633\u0627\u0639\u0629 \u0645\u0646 \u0627\u0644\u062a\u0648\u062a\u0631. \u0647\u0630\u0627 \u0644\u064a\u0633 \u062a\u062e\u0645\u064a\u0646\u064b\u0627 \u2013 \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u062f\u0627\u062e\u0644 \u062d\u0633\u0627\u0628\u0643 \u062a\u062b\u0628\u062a \u0630\u0644\u0643. \u0637\u0644\u0627\u0628 \u0622\u062e\u0631\u0648\u0646 \u0642\u0641\u0632\u0648\u0627 \u0645\u0646 \u062f\u0631\u062c\u0629 B+ \u0625\u0644\u0649 A- \u0628\u0639\u062f \u0623\u0633\u0628\u0648\u0639\u064a\u0646 \u0641\u0642\u0637. \u0623\u0646\u062a \u0627\u0644\u0622\u0646 \u0641\u064a \u0645\u0646\u062a\u0635\u0641 \u0627\u0644\u0637\u0631\u064a\u0642.",
    "\u0627\u0646\u0638\u0631 \u0625\u0644\u0649 \u0644\u0648\u062d\u0629 \u0627\u0644\u0625\u0646\u062c\u0627\u0632\u0627\u062a: '\u0634\u0647\u0631 \u0627\u0644\u062d\u0636\u0648\u0631' \u0648'\u0623\u0648\u0644 10 \u062c\u0645\u0644 \u0623\u0637\u0631\u0648\u062d\u0629' \u0645\u0641\u0639\u0644\u0629. \u0644\u0643\u0646 \u0647\u0646\u0627\u0643 \u0645\u064a\u0632\u0629 \u0644\u0645 \u062a\u062c\u0631\u0628\u0647\u0627 \u0628\u0639\u062f \u2013 '\u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0628\u0634\u0631\u064a' \u0627\u0644\u0630\u064a \u064a\u062a\u062c\u0627\u0648\u0632 Turnitin \u0641\u064a 92% \u0645\u0646 \u0627\u0644\u062d\u0627\u0644\u0627\u062a. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0627\u0628\u062d\u062b \u0639\u0646 \u0632\u0631 '\u0628\u0634\u0631\u064a\u0629' \u0628\u062c\u0627\u0646\u0628 \u0623\u064a \u0646\u0635\u060c \u0648\u0634\u0627\u0647\u062f \u0627\u0644\u0641\u0631\u0642.",
    "\u0627\u0636\u063a\u0637 '\u0639\u0631\u0636 \u0625\u0646\u062c\u0627\u0632\u0627\u062a\u064a' \u0644\u062a\u0631\u0649 \u0634\u0631\u064a\u0637 \u062a\u0642\u062f\u0645\u0643 \u0627\u0644\u0643\u0627\u0645\u0644. \u0628\u064a.\u0625\u0633: \u0647\u0644 \u062a\u0639\u0644\u0645 \u0623\u0646 80% \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0635\u0644\u0648\u0646 \u0644\u0644\u064a\u0648\u0645 28 \u064a\u0633\u062a\u0645\u0631\u0648\u0646 90 \u064a\u0648\u0645\u064b\u0627 \u0625\u0636\u0627\u0641\u064a\u0629\u061f \u0623\u0646\u062a \u0639\u0644\u0649 \u0648\u0634\u0643 \u0627\u062e\u062a\u0631\u0627\u0642 \u0627\u0644\u0642\u0645\u0629."
  ],
