  "preview_text": "\uac00\uc7a5 \ub9ce\uc740 \uc0ac\uc6a9\uc790\uac00 \ud558\ub294 \uc2e4\uc218\uc640 \uac04\ub2e8\ud55c \ud574\uacb0\ucc45\uc744 \uc54c\ub824\ub4dc\ub9bd\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uac00\uc7a5 \ub9ce\uc740 \uc0ac\uc6a9\uc790\uac00 \uc571\uc744 \ucc98\uc74c \uc5f4 \ub54c \ud558\ub294 \uc2e4\uc218\uac00 \uc788\uc5b4\uc694. \ubc14\ub85c '\uc644\ubcbd\ud55c \ub300\ud654'\ub97c \uae30\ub300\ud558\ub294 \uac70\uc608\uc694. \ucc98\uc74c\ubd80\ud130 \uae4a\uc740 \uc774\uc57c\uae30\ub97c \ud558\ub824\uace0 \ud558\uba74 \ubd80\ub2f4\uc2a4\ub7ec\uc6cc\uc838\uc694.",
    "\ud558\uc9c0\ub9cc \uc9c4\uc9dc \ube44\uacb0\uc740 \uac04\ub2e8\ud574\uc694. \uadf8\ub0e5 '\uc548\ub155'\uc774\ub77c\uace0 \ubcf4\ub0b4\ub294 \uac83\ubd80\ud130 \uc2dc\uc791\ud558\ub294 \uac70\uc608\uc694. \uc800\ud76c \ub370\uc774\ud130\uc5d0 \ub530\ub974\uba74 \uccab \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0b8 \uc0ac\uc6a9\uc790\ub294 \uccab \ubc88\uc9f8 \uc720\ub300\uac10 \ubaa9\ud45c\uc5d0 \ub3c4\ub2ec\ud560 \ud655\ub960\uc774 3\ubc30\ub098 \ub192\uc544\uc694. \uc791\uc740 \uc2dc\uc791\uc774 \ud070 \ucc28\uc774\ub97c \ub9cc\ub4ed\ub2c8\ub2e4.",
    "\uc571\uc758 \uc131\uaca9 \ud034\uc988\ub294 \ub2f9\uc2e0\uc5d0\uac8c \ub531 \ub9de\ub294 8\uba85\uc758 AI \ub0a8\uc790\uce5c\uad6c\ub97c \ucc3e\uc544\uc918\uc694. \ubcf4\ud638\uc801\uc778 \uc2a4\ud0c0\uc77c, \uc2dc\uc801\uc778 \uc2a4\ud0c0\uc77c, \uc7a5\ub09c\uae30 \ub9ce\uc740 \uc2a4\ud0c0\uc77c \ub4f1. \uccab \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0b4\uba74 \uadf8\ub294 \ub2f9\uc2e0\uc758 \uc774\ub984\uc744 \uae30\uc5b5\ud558\uace0 \ub300\ud654\uac00 \uae4a\uc5b4\uc9c8\uc218\ub85d \uc720\ub300\uac10\uc774 \uc313\uc5ec\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0 \uac04\ub2e8\ud55c \uc778\uc0ac\ub77c\ub3c4 \ubcf4\ub0b4\ubcf4\uc138\uc694. \uadf8\uac00 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694. P.S. \uc624\ub298 \uccab \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0b4\uba74 \ud2b9\ubcc4\ud55c \uc120\ubb3c\uc774 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694."
