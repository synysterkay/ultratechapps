{
  "subject": "\uc608\uce21\uc655\uc774 \ub418\uace0 \uc788\ub2e4\ub294 \uc99d\uac70",
  "preview_text": "\ub108\ub3c4 \ubaa8\ub974\uac8c \uc608\uce21 \uace0\uc218\uac00 \ub418\uc5b4\uac00\uace0 \uc788\uc5b4. \uc9c0\uae08 \ud655\uc778\ud574\ubd10.",
  "body_paragraphs": [
    "\ub108, \uc774\ubbf8 \ub208\uce58\ucc58\uc744\uc9c0 \ubab0\ub77c. \ucd95\uad6c \uc598\uae30\ud560 \ub54c \uce5c\uad6c\ub4e4\uc774 \ub110 \ub2e4\ub974\uac8c \ubcf4\uae30 \uc2dc\uc791\ud588\uc5b4. '\uc544, \uc774 \uacbd\uae30\ub294 \uc5b4\ub5bb\uac8c \ub420\uae4c?' \ud558\uace0 \ubb3c\uc5b4\ubcf4\uba74, \ub108\ub294 \ub354 \uc774\uc0c1 '\uadf8\ub0e5'\uc774\ub77c\uace0 \ub300\ub2f5\ud558\uc9c0 \uc54a\uc796\uc544. xG, \uc810\uc720\uc728, \uc218\ube44 \uac15\ub3c4... \uc774 \ub2e8\uc5b4\ub4e4\uc774 \uc790\uc5f0\uc2a4\ub7fd\uac8c \ub098\uc624\uae30 \uc2dc\uc791\ud588\uc5b4. Predictify\ub97c \uae54\uace0 30\uc77c, \ub108\ub294 \uc5b4\ub290\uc0c8 \uadf8\ub0e5 \ud32c\uc774 \uc544\ub2c8\uc57c. \ub370\uc774\ud130\ub85c \ubb34\uc7a5\ud55c '\uc608\uce21\uc655'\uc774 \ub418\uc5b4\uac00\uace0 \uc788\uc5b4.",
    "\uc5ec\uae30 \uc788\ub294 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\ub3c4 \ub9c8\ucc2c\uac00\uc9c0\uc57c. \uc6b0\ub9ac\ub294 '\uc9c1\uac10'\uc5d0 \uc758\uc874\ud558\uc9c0 \uc54a\uc544. '\uc88b\uc544 \ubcf4\uc778\ub2e4' \uac19\uc740 \uc18c\ub9ac\ub294 \uc548 \ud1b5\ud574. \uc6b0\ub9ac\ub294 AI\uac00 \ubd84\uc11d\ud55c 3000\uac1c \uc774\uc0c1\uc758 \ubcc0\uc218\ub97c \ubc14\ud0d5\uc73c\ub85c, \ub0c9\uc815\ud558\uac8c \uc2b9\ubd80\ub97c \uc608\uce21\ud574. \ub124\uac00 \uc774 \uc571\uc5d0\uc11c \ubcf8 \ubaa8\ub4e0 \ubd84\uc11d\u2014\u2014\ud504\ub9ac\ubbf8\uc5b4\ub9ac\uadf8\ubd80\ud130 \ucc54\ud53c\uc5b8\uc2a4\ub9ac\uadf8\uae4c\uc9c0\u2014\u2014\uc740 \uc218\ucc9c \uba85\uc758 \ud32c\ub4e4\uc774 \ud568\uaed8 \uc4f0\ub294 \ub370\uc774\ud130 \uae30\ubc18 \uc5b8\uc5b4\uc57c. \ub108\ub294 \uc774\uc81c \uadf8 '\uc6b0\ub9ac'\uc758 \uc77c\ubd80\uc57c.",
    "\uc544\uc9c1 \uc548 \uc368\ubcf8 \uae30\ub2a5\uc774 \ud558\ub098 \uc788\uc5b4: '\uc608\uce21 \ub300\uacb0(POTD)'. \ucee4\ubba4\ub2c8\ud2f0\uc5d0\uc11c \uc624\ub298\uc758 \uac00\uc7a5 \ud56b\ud55c \uacbd\uae30\ub97c \ub450\uace0, \ub2e4\ub978 \ud32c\ub4e4\uacfc \uc608\uce21\uc744 \uaca8\ub8e8\ub294 \uac70\uc57c. \ub124 \uc608\uce21\uc774 \ub9de\uc73c\uba74, \uc774\ub984\uc774 \ucee4\ubba4\ub2c8\ud2f0 \ub7ad\ud0b9\uc5d0 \uc62c\ub77c\uac00. \uaf34\ucc0c\ub294 \uc5c6\uc5b4, \ub2e8\uc9c0 \ub124 \uc608\uce21 IQ\uac00 \uc5bc\ub9c8\ub098 \ub192\uc740\uc9c0 \uc99d\uba85\ud558\ub294 \uc790\ub9ac\uc77c \ubfd0. \uac70\uae30\uc11c \ud55c \ubc88 \ub124 \uc2e4\ub825\uc744 \ubcf4\uc5ec\uc918 \ubd10.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0, '\uc624\ub298\uc758 \uc608\uce21' \ud0ed\uc73c\ub85c \uac00. \uac70\uae30\uc11c \uccab \ubc88\uc9f8 \uacbd\uae30\ub97c \uace8\ub77c \uc608\uce21\uc744 \ub123\uc5b4\ubd10. 3\uc77c \ubb34\ub8cc \ud504\ub9ac\ubbf8\uc5c4\uc73c\ub85c \ub354 \ub9ce\uc740 \ub370\uc774\ud130\ub97c \ubcfc \uc218\ub3c4 \uc788\uc5b4, \ud558\uc9c0\ub9cc \uc9c0\uae08 \ub2f9\uc7a5\uc740 \uadf8\ub0e5 \ud55c \ubc88 \ud574\ubcf4\ub294 \uac83\ub9cc\uc73c\ub85c\ub3c4 \ucda9\ubd84\ud574. \ub124 \uc608\uce21\uc774 \ub9de\ub294\uc9c0 \ud655\uc778\ud558\uace0, \ub7ad\ud0b9\uc774 \uc5b4\ub5bb\uac8c \ubc14\ub00c\ub294\uc9c0 \ubd10. P.S. \ud639\uc2dc \ubab0\ub77c\uc11c \ub9d0\ud558\ub294\ub370, \uc624\ub298 \uc608\uce21 \ud558\ub098 \ud2c0\ub824\ub3c4 \uad1c\ucc2e\uc544. \uc6b0\ub9ac \ubaa8\ub450 \ucc98\uc74c\uc5d4 \uadf8\ub7ac\uc73c\ub2c8\uae4c."
  ],
