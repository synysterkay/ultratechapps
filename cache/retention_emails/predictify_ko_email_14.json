{
  "subject": "\ub2f9\uc2e0\uc774 \uc18d\ud55c 50,000\uba85\uc758 \ucd95\uad6c \ubd84\uc11d\uac00",
  "preview_text": "\uc6b0\ub9ac\ub294 \ub2e8\uc21c\ud55c \uc571\uc774 \uc544\ub2d9\ub2c8\ub2e4. \ub370\uc774\ud130\ub85c \ubb34\uc7a5\ud55c \ucd95\uad6c \ud32c\ub4e4\uc758 \uc0c8\ub85c\uc6b4 \ubd80\uc871\uc785\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \uc790\ub9ac\uac00 \uc5ec\uae41\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uc608\uce21\uc740 \ub354 \uc774\uc0c1 \uc678\ub85c\uc6b4 \uac8c\uc784\uc774 \uc544\ub2d9\ub2c8\ub2e4. \ub9e4\uc77c \ubc24, 50,000\uba85\uc758 \ud68c\uc6d0\ub4e4\uc774 \uac19\uc740 \ub370\uc774\ud130\ub97c \ubcf4\uace0, \uac19\uc740 \uc778\uc0ac\uc774\ud2b8\ub97c \ub098\ub204\uba70, \ub354 \ub098\uc740 \uacb0\uc815\uc744 \ub0b4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\ub3c4 \uadf8 \uc911 \ud558\ub098\uc785\ub2c8\ub2e4.",
    "\uc6b0\ub9ac\ub294 '\uac10'\uc5d0 \uc758\uc874\ud558\ub294 \ucd95\uad6c \ud32c\ub4e4\uacfc \ub2e4\ub985\ub2c8\ub2e4. \uc6b0\ub9ac\ub294 xG, \uc810\uc720\uc728, \uc218\ube44 \uac15\ub3c4, \uacf5\uaca9 \ud6a8\uc728\uc131 \uac19\uc740 \uc22b\uc790\ub85c \ubb34\uc7a5\ud569\ub2c8\ub2e4. AI\uac00 \uc218\ucc9c \uac1c\uc758 \ubcc0\uc218\ub97c \ubd84\uc11d\ud574 \uc900 \uc2e0\ub8b0\ub3c4 \uc810\uc218\ub97c \ubcf4\uba74, '\uc544, \uc774\uac8c \ub9de\ub294\uad6c\ub098' \uc2f6\uc744 \uac81\ub2c8\ub2e4.",
    "\uc774\uc81c \ud63c\uc790 \uc608\uce21\ud558\uc9c0 \ub9c8\uc138\uc694. \ucee4\ubba4\ub2c8\ud2f0\uc5d0\uc11c \uc624\ub298\uc758 \uc608\uce21(POTD)\uc5d0 \ud22c\ud45c\ud558\uace0, \ub2e4\ub978 \ud32c\ub4e4\uacfc \ud1a0\ub860\ud558\uba70, \ub2f9\uc2e0\uc758 \ucd95\uad6c IQ\ub97c \uc2dc\ud5d8\ud574 \ubcf4\uc138\uc694. \ub9ac\ub354\ubcf4\ub4dc\uc5d0\uc11c \uc21c\uc704\uac00 \uc624\ub974\ub294 \uac78 \ubcf4\uba74, \uc791\uc740 \uc2b9\ub9ac\uac00 \uc313\uc5ec \ud070 \uc790\uc2e0\uac10\uc774 \ub429\ub2c8\ub2e4.",
    "\uc624\ub298 \uc571\uc744 \uc5f4\uace0, '\ucee4\ubba4\ub2c8\ud2f0' \ud0ed\uc5d0\uc11c '\uc624\ub298\uc758 \uc608\uce21'\uc5d0 \ud22c\ud45c\ud574 \ubcf4\uc138\uc694. \ub2f9\uc2e0\uc758 \ubaa9\uc18c\ub9ac\uac00 \ub370\uc774\ud130\uc758 \uc77c\ubd80\uac00 \ub429\ub2c8\ub2e4. P.S. \ub0b4\uc77c \uc788\uc744 \ub9ac\uadf8 \uacbd\uae30\uc5d0\uc11c AI\uc758 78% \uc2e0\ub8b0\ub3c4 \uc608\uce21\uc744 \ud655\uc778\ud574 \ubcf4\uc138\uc694 \u2014 \ub193\uce58\uba74 \ud6c4\ud68c\ud560 \uac81\ub2c8\ub2e4."
  ],
