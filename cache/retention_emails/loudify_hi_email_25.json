{
  "subject": "\u0935\u094b 2 \u092c\u091c\u0947 \u0930\u093e\u0924 \u0915\u093e \u0915\u093e\u092e \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u090f\u0915 \u092f\u0942\u091c\u093c\u0930 \u0928\u0947 Loudify \u0915\u094b \u0910\u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e \u091c\u093f\u0938\u0915\u0940 \u092e\u0948\u0902\u0928\u0947 \u0915\u092d\u0940 \u0915\u0932\u094d\u092a\u0928\u093e \u0928\u0939\u0940\u0902 \u0915\u0940 \u0925\u0940\u0964 \u0939\u0948\u0930\u093e\u0928 \u0915\u0930 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0940 \u0915\u0939\u093e\u0928\u0940\u0964",
  "body_paragraphs": [
    "\u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u0932\u094b\u0917 Loudify \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0938\u093f\u0930\u094d\u092b\u093c \u092e\u094d\u092f\u0942\u091c\u093c\u093f\u0915 \u092f\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u0947 \u0932\u093f\u090f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u090f\u0915 \u092f\u0942\u091c\u093c\u0930 \u0915\u093e \u092e\u0948\u0938\u0947\u091c \u0906\u092f\u093e \u091c\u093f\u0938\u0928\u0947 \u092e\u0947\u0930\u093e \u0928\u091c\u093c\u0930\u093f\u092f\u093e \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964 \u0909\u0938\u0928\u0947 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0935\u0939 \u0905\u092a\u0928\u0947 \u0915\u0941\u0924\u094d\u0924\u0947 \u0915\u0947 \u0932\u093f\u090f \u0910\u092a \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964",
    "\u0939\u093e\u0901, \u0938\u0939\u0940 \u0938\u0941\u0928\u093e\u0964 \u0909\u0938\u0915\u093e \u0915\u0941\u0924\u094d\u0924\u093e \u092c\u093f\u091c\u0932\u0940 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0938\u0947 \u0921\u0930 \u091c\u093e\u0924\u093e \u0925\u093e\u0964 \u0909\u0938\u0928\u0947 Loudify \u0915\u0947 +200% \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f \u0914\u0930 AutoEQ \u0915\u094b \u090f\u0915 \u0915\u092e\u0930\u0947 \u092e\u0947\u0902 \u0930\u0916\u093e \u0914\u0930 \u090f\u0915 \u0936\u093e\u0902\u0924, \u0938\u093e\u092b\u093c \u0906\u0935\u093e\u091c\u093c \u092c\u0928\u093e\u0908 \u091c\u093f\u0938\u0938\u0947 \u0915\u0941\u0924\u094d\u0924\u093e \u0936\u093e\u0902\u0924 \u0939\u094b \u0917\u092f\u093e\u0964 \u092e\u0941\u091d\u0947 \u092f\u0915\u0940\u0928 \u0928\u0939\u0940\u0902 \u0939\u0941\u0906\u0964 \u092e\u0948\u0902\u0928\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u0915\u094b\u0908 \u0907\u0938 \u0910\u092a \u0915\u094b \u0905\u092a\u0928\u0947 \u092a\u093e\u0932\u0924\u0942 \u091c\u093e\u0928\u0935\u0930 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0947\u0917\u093e\u0964",
    "\u092f\u0939 \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u0915\u0939\u093e\u0928\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948 \u0915\u093f Loudify \u0915\u0940 10-\u092c\u0948\u0902\u0921 EQ \u0914\u0930 \u091a\u093e\u0930 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932\u094d\u0938 (\u092e\u094d\u092f\u0942\u091c\u093c\u093f\u0915, \u092e\u0942\u0935\u0940, \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f, \u0917\u0947\u092e\u093f\u0902\u0917) \u0915\u093f\u0924\u0928\u0940 \u0932\u091a\u0940\u0932\u0940 \u0939\u0948\u0902\u0964 \u0906\u092a \u0905\u092a\u0928\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0907\u0938\u0947 \u091f\u094d\u092f\u0942\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u2014 \u091a\u093e\u0939\u0947 \u0935\u0939 \u091f\u094d\u0930\u0947\u0928 \u0915\u093e \u0936\u094b\u0930 \u0915\u092e \u0915\u0930\u0928\u093e \u0939\u094b, \u092f\u093e \u0915\u0941\u0924\u094d\u0924\u0947 \u0915\u094b \u0936\u093e\u0902\u0924 \u0915\u0930\u0928\u093e\u0964 \u0938\u093f\u0938\u094d\u091f\u092e-\u0935\u093e\u0907\u0921 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "\u0907\u0938\u0947 \u0916\u094b\u0932\u094b \u0914\u0930 \u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u090f\u0915 \u0928\u092f\u093e \u0924\u0930\u0940\u0915\u093e \u0916\u094b\u091c\u094b\u0964 \u0936\u093e\u092f\u0926 \u0906\u092a\u0915\u093e \u092d\u0940 \u0915\u094b\u0908 \u0905\u0928\u094b\u0916\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0939\u094b\u0964 P.S. \u2014 \u0905\u0917\u0930 \u0906\u092a\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u0905\u092a\u0928\u0940 \u0938\u093e\u092a\u094d\u0924\u093e\u0939\u093f\u0915 Sound DNA \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u0940, \u0924\u094b \u0935\u0939 \u0906\u092a\u0915\u0947 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924\u094b\u0902 \u0915\u093e \u0905\u0938\u0932\u0940 \u0921\u0947\u091f\u093e \u0926\u093f\u0916\u093e\u0924\u0940 \u0939\u0948\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092e\u0947\u0902 \u092f\u0939 \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940 \u0905\u0928\u0932\u0949\u0915 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964"
  ],
