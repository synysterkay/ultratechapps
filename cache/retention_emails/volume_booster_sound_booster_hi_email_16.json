{
  "subject": "\u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0917\u0932\u0924\u0940 \u0915\u0940... \u092f\u0939 \u092b\u0940\u091a\u0930 \u0936\u0947\u092f\u0930 \u0928\u0939\u0940\u0902 \u0915\u0930\u0928\u093e \u0925\u093e",
  "preview_text": "\u090f\u0915 \u0910\u0938\u093e \u0911\u0921\u093f\u092f\u094b \u0939\u0945\u0915 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0938\u093f\u0930\u094d\u092b \u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e \u0925\u093e\u0964 \u0906\u091c \u092e\u0948\u0902 \u0907\u0938\u0947 \u0906\u092a\u0915\u0947 \u0938\u093e\u0925 \u0936\u0947\u092f\u0930 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0901\u0964",
  "body_paragraphs": [
    "\u0938\u091a \u092c\u0924\u093e\u090a\u0901? \u092e\u0948\u0902 \u092f\u0939 \u0908\u092e\u0947\u0932 \u0932\u093f\u0916\u0928\u0947 \u0935\u093e\u0932\u093e \u092d\u0940 \u0928\u0939\u0940\u0902 \u0925\u093e\u0964 \u0915\u0932 \u0930\u093e\u0924 \u0926\u0947\u0930 \u0924\u0915 \u092e\u094d\u092f\u0942\u091c\u093f\u0915 \u0938\u0941\u0928 \u0930\u0939\u093e \u0925\u093e \u0914\u0930 \u090f\u0915 \u0928\u092f\u093e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0915\u093e \u0915\u0949\u092e\u094d\u092c\u093f\u0928\u0947\u0936\u0928 \u090f\u0915\u094d\u0938\u092a\u0947\u0930\u093f\u092e\u0947\u0902\u091f \u0915\u093f\u092f\u093e\u0964 \u091c\u094b \u0939\u0941\u0906, \u0909\u0938\u0928\u0947 \u092e\u0947\u0930\u093e \u0926\u093f\u092e\u093e\u0917 \u0939\u093f\u0932\u093e \u0926\u093f\u092f\u093e\u0964",
    "\u092e\u0948\u0902\u0928\u0947 \u0905\u0938\u0932 \u092e\u0947\u0902 \u092f\u0939 \u091f\u094d\u0935\u0940\u0915 \u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e \u0925\u093e - \u090f\u0915 \u092a\u0930\u094d\u0938\u0928\u0932 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091c\u094b \u092c\u093e\u0915\u0940 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u094b \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0928\u093e \u0925\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u0938\u094b\u091a\u093e, \u091c\u092c \u0906\u092a \u0907\u0924\u0928\u0947 \u0926\u093f\u0928\u094b\u0902 \u0938\u0947 \u0910\u092a \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0924\u094b \u0906\u092a \u0907\u0938\u0915\u0947 \u0939\u0915\u0926\u093e\u0930 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0906\u092a \u091c\u0948\u0938\u0947 \u0935\u092b\u093e\u0926\u093e\u0930 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0964",
    "\u0907\u0938\u0947 '\u092e\u093f\u0921\u0928\u093e\u0907\u091f \u092c\u0942\u0938\u094d\u091f' \u0928\u093e\u092e \u0926\u093f\u092f\u093e \u0939\u0948\u0964 \u092f\u0939 \u092c\u0947\u0938 \u092c\u0942\u0938\u094d\u091f\u0930 \u0914\u0930 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u0915\u094b \u090f\u0915 \u0938\u093e\u0925 \u0910\u0938\u0947 \u0915\u0949\u092e\u094d\u092c\u093e\u0907\u0928 \u0915\u0930\u0924\u093e \u0939\u0948 \u0915\u093f \u0939\u0930 \u0917\u093e\u0928\u0947 \u0915\u0940 \u0932\u092f \u0906\u092a\u0915\u0940 \u0939\u0921\u094d\u0921\u093f\u092f\u094b\u0902 \u0924\u0915 \u092e\u0939\u0938\u0942\u0938 \u0939\u094b\u0964 \u0916\u093e\u0938\u0915\u0930 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0914\u0930 \u0913\u0932\u094d\u0921 \u0938\u0949\u0928\u094d\u0917\u094d\u0938 \u092a\u0930 \u092f\u0939 \u091c\u093e\u0926\u0942 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u0938\u094d\u091f\u0942\u0921\u093f\u092f\u094b \u0938\u094d\u092a\u0940\u0915\u0930 \u091c\u0948\u0938\u093e \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0917\u093e\u0964",
    "\u0910\u092a \u0916\u094b\u0932\u093f\u090f, \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u092e\u0947\u0902 \u091c\u093e\u0907\u090f, \u0914\u0930 '\u092e\u093f\u0921\u0928\u093e\u0907\u091f \u092c\u0942\u0938\u094d\u091f' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091f\u094d\u0930\u093e\u0908 \u0915\u0940\u091c\u093f\u090f\u0964 \u092f\u0939 \u0906\u091c \u0924\u0915 \u0915\u093e \u0938\u092c\u0938\u0947 \u0930\u093f\u091a \u0938\u093e\u0909\u0902\u0921 \u0906\u092a\u0915\u094b \u092e\u093f\u0932\u0947\u0917\u093e\u0964 \u092a\u0940.\u090f\u0938. - \u092f\u0939 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0939\u092e\u0947\u0936\u093e \u0915\u0947 \u0932\u093f\u090f \u092b\u094d\u0930\u0940 \u0930\u0939\u0947\u0917\u093e\u0964 \u092e\u0947\u0930\u0940 \u0924\u0930\u092b \u0938\u0947 \u0906\u092a\u0915\u0947 35 \u0926\u093f\u0928\u094b\u0902 \u0915\u093e \u0925\u0948\u0902\u0915\u094d\u092f\u0942 \u0917\u093f\u092b\u094d\u091f\u0964"
  ],
