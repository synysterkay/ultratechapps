{
  "subject": "\u51cc\u66682\u70b9\u7684\u4ee3\u7801\u6539\u52a8",
  "preview_text": "\u4e00\u4e2a\u5076\u7136\u7684bug\uff0c\u53d8\u6210\u4e86\u4f60\u4eec\u6700\u7231\u7684\u529f\u80fd\u3002\u542c\u6211\u8bb2\u4e2a\u771f\u5b9e\u6545\u4e8b\u3002",
  "body_paragraphs": [
    "\u90a3\u5929\u665a\u4e0a\u6211\u5931\u7720\uff0c\u8eba\u5728\u6c99\u53d1\u4e0a\u5237\u7528\u6237\u53cd\u9988\u3002\u6709\u4e00\u6761\u7559\u8a00\u8bf4\uff1a\u6bcf\u6b21\u7ea6\u4f1a\u7684\u901a\u77e5\u90fd\u50cf\u4efb\u52a1\u6e05\u5355\uff0c\u6ca1\u6709\u60ca\u559c\u611f\u3002\u6211\u773c\u775b\u4e00\u4eae\uff0c\u7acb\u523b\u722c\u8d77\u6765\u6253\u5f00\u7535\u8111\u3002\u51cc\u66682\u70b9\uff0c\u6211\u5199\u4e86\u4e00\u6bb5\u4ee3\u7801\u2014\u2014\u8ba9\u4f34\u4fa3\u53d1\u9001\u7ea6\u4f1a\u65f6\uff0c\u5bf9\u65b9\u770b\u5230\u7684\u662f\u5168\u5c4f\u52a8\u753b\uff0c\u800c\u4e0d\u662f\u666e\u901a\u901a\u77e5\u3002",
    "\u7b2c\u4e8c\u5929\uff0c\u8fd9\u4e2a\u6539\u52a8\u88ab\u540c\u4e8b\u9a82\u75af\u4e86\uff1a\u4f60\u75af\u4e86\uff1f\u51cc\u6668\u6539\u751f\u4ea7\u73af\u5883\uff1f\u4f46\u6570\u636e\u4e0d\u4f1a\u8bf4\u8c0e\u3002\u90a3\u4e2a\u6708\uff0c\u53d1\u9001\u7ea6\u4f1a\u540e\u5bf9\u65b9\u6253\u5f00\u7387\u98d9\u5347\u4e864\u500d\u3002\u7528\u6237\u5f00\u59cb\u7559\u8a00\u8bf4\uff0c\u8fd9\u4e2a\u529f\u80fd\u8ba9ta\u89c9\u5f97\u88ab\u770b\u89c1\u4e86\u3002\u6211\u610f\u8bc6\u5230\uff0c\u6280\u672f\u4e0d\u662f\u51b0\u51b7\u7684\uff0c\u5b83\u53ea\u662f\u9700\u8981\u4e00\u70b9\u4eba\u60c5\u5473\u3002",
    "\u8fd9\u4e2a\u529f\u80fd\u73b0\u5728\u53eb\u4f34\u4fa3\u63d0\u8bae\u5e86\u795d\u2014\u2014\u6bcf\u6b21\u4f60\u53d1\u9001\u4e00\u4e2a\u7ea6\u4f1a\uff0c\u5bf9\u65b9\u4f1a\u770b\u5230\u5168\u5c4f\u7684\u2018\u4eca\u665a\u60f3\u7740\u4f60\u2019\u52a8\u753b\u3002\u5b83\u4e0d\u662f\u4e3a\u4e86\u70ab\u8000\u79d1\u6280\uff0c\u800c\u662f\u4e3a\u4e86\u590d\u5236\u90a3\u4e2a\u77ac\u95f4\uff1a\u5f53\u4f60\u88ab\u60f3\u8d77\u65f6\uff0c\u5fc3\u91cc\u5fae\u5fae\u53d1\u70eb\u7684\u611f\u89c9\u3002\u4f60\u7528\u8fc7\u5b83\u5417\uff1f\u5982\u679c\u8fd8\u6ca1\uff0c\u4e0b\u4e00\u6b21\u53d1\u7ea6\u4f1a\u65f6\uff0c\u770b\u770b\u5bf9\u65b9\u7684\u53cd\u5e94\u3002",
    "\u4eca\u665a\u5c31\u6253\u5f00SoulPlan\uff0c\u968f\u4fbf\u9009\u4e00\u4e2a\u7ea6\u4f1a\u53d1\u7ed9\u4f60\u7684\u4f34\u4fa3\u3002\u770b\u770b\u90a3\u4e2a\u52a8\u753b\uff0c\u7136\u540e\u544a\u8bc9\u6211ta\u7684\u53cd\u5e94\u3002P.S. \u5982\u679c\u4f60\u89c9\u5f97\u8fd9\u4e2a\u529f\u80fd\u5f88\u9177\uff0c\u8bd5\u8bd5\u4eca\u665a\u7ea6\u4f1a\u91cc\u7684\u2018\u6cbb\u6108\u2019\u6a21\u5f0f\u2014\u2014\u90a3\u662f\u53e6\u4e00\u4e2a\u51cc\u66682\u70b9\u7684\u4ea7\u7269\u3002"
  ],
