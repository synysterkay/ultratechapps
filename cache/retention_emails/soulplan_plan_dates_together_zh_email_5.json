{
  "subject": "\u6211\u51cc\u66682\u70b9\u5199\u4ee3\u7801\u65f6\u53d1\u73b0\u7684\u4e8b",
  "preview_text": "\u4e00\u4e2a\u5931\u7720\u591c\uff0c\u4e00\u4e2a\u4ee3\u7801bug\uff0c\u4e00\u4e2a\u5dee\u70b9\u5220\u9664\u7684\u529f\u80fd\uff0c\u5374\u6210\u4e86\u7528\u6237\u6700\u7231\u7684\u79d8\u5bc6\u6b66\u5668\u3002\u4f60\u731c\u662f\u4ec0\u4e48\uff1f",
  "body_paragraphs": [
    "\u90a3\u5929\u665a\u4e0a\u6211\u5931\u7720\u4e86\u3002\u76ef\u7740\u6ee1\u5c4f\u7684\u4ee3\u7801\uff0c\u7a81\u7136\u610f\u8bc6\u5230\u4e00\u4e2a\u95ee\u9898\uff1a\u6211\u4eec\u8f9b\u8f9b\u82e6\u82e6\u505a\u7684\u529f\u80fd\uff0c\u53ef\u80fd\u6839\u672c\u6ca1\u4eba\u7528\u3002\u4e0d\u662f\u56e0\u4e3a\u5b83\u4e0d\u597d\uff0c\u800c\u662f\u56e0\u4e3a\u2014\u2014\u4f60\u4eec\u4e0d\u77e5\u9053\u5b83\u80cc\u540e\u85cf\u7740\u4ec0\u4e48\u3002",
    "\u770b\uff0c\u6211\u82b1\u4e86\u6574\u6574\u4e09\u4e2a\u6708\u6253\u78e8\u4e00\u4e2a\u4e1c\u897f\u3002\u767d\u5929\u5f00\u4f1a\u3001\u6539\u9700\u6c42\u3001\u88ab\u8001\u677f\u50ac\uff0c\u4f46\u771f\u6b63\u7684\u7075\u611f\u603b\u662f\u5728\u51cc\u6668\u5192\u51fa\u6765\u3002\u90a3\u59292\u70b9\uff0c\u6211\u672c\u6765\u5728\u4fee\u4e00\u4e2abug\uff0c\u7ed3\u679c\u9b3c\u4f7f\u795e\u5dee\u5730\u52a0\u4e86\u4e2a\u9690\u85cf\u6309\u94ae\u3002\u4f60\u731c\u600e\u4e48\u7740\uff1f",
    "\u73b0\u5728\u6211\u5766\u767d\u5427\uff1a\u8fd9\u4e2a\u529f\u80fd\u5c31\u662f\u2018\u60ca\u559c\u7ea6\u4f1a\u8ba1\u5212\u2019\u3002\u539f\u672c\u53ea\u662f\u4e2a\u666e\u901a\u9009\u9879\uff0c\u4f46\u6211\u5077\u5077\u585e\u4e86\u4e2a\u5f69\u86cb\u2014\u2014\u5f53\u4f60\u7684\u53e6\u4e00\u534a\u70b9\u5f00\u7684\u90a3\u4e00\u523b\uff0c\u7cfb\u7edf\u4f1a\u5148\u53d1\u4e00\u6761\u8d85\u66a7\u6627\u7684\u63d0\u793a\u97f3\u3002\u4e0d\u662f\u5e7f\u544a\uff0c\u662f\u6211\u81ea\u5df1\u5f55\u7684\u3002\u542c\u8d77\u6765\u5f88\u50bb\uff1f\u4f46230\u591a\u5bf9\u60c5\u4fa3\u8ddf\u6211\u8bf4\uff0c\u8fd9\u62db\u8ba9\u4ed6\u4eec\u91cd\u65b0\u627e\u56de\u4e86\u521d\u543b\u65f6\u7684\u7d27\u5f20\u611f\u3002",
    "\u4eca\u665a\u5c31\u8bd5\u8bd5\u3002\u6253\u5f00SoulPlan\uff0c\u70b9\u2018\u60ca\u559c\u7ea6\u4f1a\u8ba1\u5212\u2019\uff0c\u9009\u62e9\u2018\u4e3a\u5979/\u4ed6\u7b56\u5212\u2019\uff0c\u7136\u540e\u7b49ta\u6253\u5f00\u65f6\uff0c\u7559\u610f\u90a3\u4e2a\u5c0f\u5c0f\u7684\u9707\u52a8\u53cd\u9988\u3002\u90a3\u662f\u6211\u7684\u795d\u798f\u3002P.S. \u5982\u679c\u4f60\u4e5f\u5931\u7720\uff0c\u51cc\u66682\u70b9\u7528\u8fd9\u4e2a\u529f\u80fd\uff0c\u4f1a\u6709\u4e2a\u9690\u85cf\u6b4c\u5355\u5f39\u51fa\u2014\u2014\u522b\u8bf4\u6211\u6ca1\u63d0\u9192\u4f60\u3002"
  ],
