{
  "subject": "28 \u064a\u0648\u0645\u064b\u0627 \u0645\u0646 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0646\u0642\u064a",
  "preview_text": "\u0644\u0642\u062f \u0645\u0631 \u0634\u0647\u0631 \u0639\u0644\u0649 \u062a\u062d\u0645\u064a\u0644\u0643 \u0644\u0644\u062a\u0637\u0628\u064a\u0642. \u0625\u0644\u064a\u0643 \u0645\u0627 \u062d\u0642\u0642\u062a\u0647 \u0628\u062f\u0648\u0646 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a.",
  "body_paragraphs": [
    "\u0645\u0646\u0630 28 \u064a\u0648\u0645\u064b\u0627\u060c \u0642\u0631\u0631\u062a \u0623\u0646 \u062a\u0645\u0646\u062d \u0646\u0641\u0633\u0643 \u062a\u062c\u0631\u0628\u0629 \u0635\u0648\u062a\u064a\u0629 \u0645\u062e\u062a\u0644\u0641\u0629. \u0644\u0627 \u0625\u0639\u0644\u0627\u0646\u0627\u062a \u062a\u0642\u0627\u0637\u0639 \u0628\u0648\u062f\u0643\u0627\u0633\u062a\u0643\u060c \u0644\u0627 \u0646\u0648\u0627\u0641\u0630 \u0645\u0646\u0628\u062b\u0642\u0629 \u0641\u064a \u0645\u0646\u062a\u0635\u0641 \u0623\u063a\u0646\u064a\u0629\u060c \u0641\u0642\u0637 \u0627\u0644\u0635\u0648\u062a \u0643\u0645\u0627 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646.",
    "\u062e\u0644\u0627\u0644 \u0647\u0630\u0627 \u0627\u0644\u0634\u0647\u0631\u060c \u0627\u0633\u062a\u062e\u062f\u0645\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u064a \u0623\u0643\u062b\u0631 \u0645\u0646 40 \u062c\u0644\u0633\u0629 \u0627\u0633\u062a\u0645\u0627\u0639. \u0643\u0644 \u0645\u0631\u0629\u060c \u0643\u0627\u0646 \u0627\u0644\u0645\u0646\u0632\u0644\u0642 \u064a\u0639\u0645\u0644 \u0628\u0635\u0645\u062a\u060c \u064a\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0628\u0646\u0633\u0628\u0629 200% \u062f\u0648\u0646 \u0623\u0646 \u064a\u0637\u0644\u0628 \u0645\u0646\u0643 \u0634\u064a\u0626\u064b\u0627. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0625\u0646\u062c\u0627\u0632\u064b\u0627 \u062a\u0642\u0646\u064a\u064b\u0627 \u0641\u0642\u0637\u060c \u0628\u0644 \u0647\u0648 \u0627\u0646\u062a\u0635\u0627\u0631 \u0644\u0644\u0647\u062f\u0648\u0621 \u0641\u064a \u0639\u0627\u0644\u0645 \u064a\u0635\u0631\u062e.",
    "\u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u064a \u0631\u0628\u0645\u0627 \u0644\u0645 \u062a\u062c\u0631\u0628\u0647\u0627 \u0628\u0639\u062f: \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629 \u0639\u0646\u062f \u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u060c \u0648\u0641\u0639\u0651\u0644\u0647\u0627. \u0628\u0639\u062f \u0630\u0644\u0643\u060c \u0644\u0646 \u062a\u062d\u062a\u0627\u062c \u062d\u062a\u0649 \u0644\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649. \u0641\u0642\u0637 \u0627\u0633\u0645\u0639.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0648\u062a\u0623\u0643\u062f \u0645\u0646 \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629. \u0627\u0644\u0623\u0645\u0631 \u064a\u0633\u062a\u063a\u0631\u0642 10 \u062b\u0648\u0627\u0646\u064d. \n\n\u0645\u0644\u0627\u062d\u0638\u0629: \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u0641\u0639\u0651\u0644\u0648\u0627 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0644\u0645 \u064a\u0641\u062a\u062d\u0648\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0645\u0646\u0630 \u0623\u0633\u0628\u0648\u0639\u064a\u0646. \u0627\u0644\u0635\u0648\u062a \u064a\u0639\u0645\u0644 \u0645\u0646 \u062a\u0644\u0642\u0627\u0621 \u0646\u0641\u0633\u0647."
  ],
