{
  "subject": "\u4f602\u5206\u949f\u80fd\u505a\u7684\u4e8b\uff0c\u522b\u4eba\u82b120\u5206\u949f",
  "preview_text": "\u4e00\u4e2a\u88ab\u5ffd\u7565\u7684\u8bbe\u5b9a\uff0c\u8ba9\u7ea6\u4f1a\u8ba1\u5212\u53d8\u621030\u79d2\u7684\u4eea\u5f0f\u3002\u8fd8\u6709\u7b2c32\u5929\u7684\u79d8\u5bc6\u3002",
  "body_paragraphs": [
    "\u4e0a\u5468\u4e09\u665a\u4e0a10\u70b9\uff0c\u4e00\u5bf9\u7528\u6237\u82b1\u4e862\u5206\u949f\u6253\u5f00SoulPlan\uff0c\u70b9\u4e86\u4e00\u4e0b\u2018\u4eca\u665a\u7ea6\u4f1a\u2019\u7684\u5361\u7247\uff0c\u9009\u4e86\u2018\u6cbb\u6108\u2019\u6a21\u5f0f\u3002\u7ed3\u679c\u5462\uff1f\u4ed6\u4eec\u5750\u5728\u5ba2\u5385\u6c99\u53d1\u4e0a\uff0c\u70b9\u4e86\u5916\u5356\uff0c\u770b\u4e86\u90a3\u90e8\u62d6\u4e86\u4e09\u5468\u7684\u7535\u5f71\u3002\u5979\u8bf4\uff1a\u2018\u8fd92\u5206\u949f\uff0c\u6bd4\u6211\u4e4b\u524d\u82b120\u5206\u949f\u7ffb\u653b\u7565\u3001\u5435\u67b6\u3001\u59a5\u534f\u3001\u6700\u540e\u653e\u5f03\uff0c\u503c\u592a\u591a\u4e86\u3002\u2019",
    "\u4f60\u61c2\u90a3\u79cd\u611f\u89c9\u2014\u2014\u5468\u4e94\u665a\u4e0a\uff0c\u4e24\u4e2a\u4eba\u90fd\u7d2f\uff0c\u5374\u786c\u8981\u2018\u8ba1\u5212\u70b9\u7279\u522b\u7684\u2019\u3002\u7ffb\u5c0f\u7ea2\u4e66\u3001\u67e5\u70b9\u8bc4\u3001\u95ee\u670b\u53cb\uff0c\u6700\u540e\u8981\u4e48\u9009\u4e2a\u8001\u5730\u65b9\uff0c\u8981\u4e48\u5e72\u8106\u7b97\u4e86\u3002\u8ba1\u5212\u75b2\u52b3\uff0c\u6bd4\u7ea6\u4f1a\u672c\u8eab\u66f4\u8017\u4eba\u3002",
    "\u5176\u5b9e\uff0c\u6700\u7701\u65f6\u95f4\u7684\u529e\u6cd5\uff0c\u5c31\u662f\u522b\u8ba1\u5212\u3002\u6253\u5f00SoulPlan\uff0c\u9996\u9875\u90a3\u5f20\u2018\u4eca\u665a\u7ea6\u4f1a\u2019\u5361\u7247\uff0c\u5c31\u662f\u4e3a\u4f60\u4eca\u665a\u51c6\u5907\u7684\u3002\u9009\u4e00\u4e2a\u5fc3\u60c5\u2014\u2014\u6e29\u99a8\u3001\u5192\u9669\u3001\u4fcf\u76ae\u3001\u6cbb\u6108\u2014\u2014\u7136\u540e\u653e\u624b\u300230\u79d2\uff0c\u4e00\u5f20\u5361\u7247\uff0c\u4e00\u4e2a\u5ff5\u5934\uff0c\u5bf9\u65b9\u6536\u5230\u65f6\uff0c\u662f\u4e00\u4e2a\u2018\u4eca\u665a\u60f3\u7740\u4f60\u2019\u7684\u5b8c\u6574\u753b\u9762\uff0c\u4e0d\u662f\u4e00\u6761\u5e72\u5df4\u5df4\u7684\u63d0\u9192\u3002",
    "\u660e\u5929\u665a\u4e0a\uff0c\u8bd5\u8bd5\u8fd9\u4e2a\u52a8\u4f5c\uff1a\u6253\u5f00app\uff0c\u70b9\u4e00\u4e0b\u5361\u7247\uff0c\u9009\u4e2a\u5fc3\u60c5\uff0c\u7136\u540e\u544a\u8bc9\u5bf9\u65b9\u2018\u4eca\u665a\u6211\u60f3\u2026\u2026\u2019\u30022\u5206\u949f\uff0c\u4f60\u8d62\u56de19\u5206\u949f\u7684\u8bb0\u5fc6\u3002P.S. \u7b2c32\u5929\uff0c\u4f60\u7684\u8bb0\u5fc6\u65f6\u95f4\u7ebf\u91cc\uff0c\u5df2\u7ecf\u591a\u4e86\u4e00\u683c\u7a7a\u767d\u7684\u7167\u7247\u6846\u2014\u2014\u90a3\u662f\u4f60\u8fd8\u6ca1\u586b\u7684\u2018\u90a3\u5929\u665a\u4e0a\u2019\u3002"
  ],
