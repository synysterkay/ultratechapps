{
  "subject": "\ub0b4\uac00 \uc774 \uc571\uc5d0\uc11c \uac00\uc7a5 \ud070 \uc2e4\uc218\ub97c \uc800\uc9c8\ub800\ub2e4",
  "preview_text": "90%\uc758 \uc720\uc800\uac00 \ud558\ub294 \uc2e4\uc218, \ub108\ub3c4 \ud558\uace0 \uc788\uc744 \uac70\uc57c. \uc774\uac78 \uc77d\uace0 \ubc14\ub85c \uace0\uccd0\ub77c.",
  "body_paragraphs": [
    "\uc194\uc9c1\ud788 \ub9d0\ud560\uac8c. \ub098\ub3c4 Predictify\ub97c \ucc98\uc74c \uc4f8 \ub54c \uc644\uc804\ud788 \ub9dd\ud588\uc5b4. \ub370\uc774\ud130\ub97c \uc313\uc544\ub450\uace0\ub3c4 \uacb0\uacfc\ub97c \uc81c\ub300\ub85c \ubabb \ubd24\uac70\ub4e0. \uadf8\ub7f0\ub370 \uadf8 \uc774\uc720\ub97c \uc54c\uc558\uc5b4. \ub300\ubd80\ubd84\uc758 \uc720\uc800\uac00 \ud558\ub294 \ub611\uac19\uc740 \uc2e4\uc218 \ub54c\ubb38\uc774\uc5c8\uc5b4. \ubc14\ub85c '\ud655\uc2e0 \uc810\uc218'\ub97c \ubb34\uc2dc\ud558\ub294 \uac70\uc57c. AI\uac00 '\uc774\uac74 85% \ud655\ub960\ub85c \ub9de\uc544'\ub77c\uace0 \ub9d0\ud574\uc8fc\ub294\ub370, \uc0ac\ub78c\ub4e4\uc740 \uadf8\ub0e5 \uac10\uc73c\ub85c \ubca0\ud305\ud558\uac70\ub098 \ubb34\uc2dc\ud574. \uacb0\uacfc\ub294? \uacc4\uc18d \ud2c0\ub9ac\uace0, \uc2a4\ud2b8\ub9ad\ub3c4 \uae68\uc9c0\uace0, \uc9dc\uc99d\ub9cc \uc313\uc5ec.",
    "\uc774\uac8c \uc65c \ubb38\uc81c\ub0d0\uba74, Predictify\ub294 \uc218\ucc9c \uac1c\uc758 \ubcc0\uc218\ub97c \ubd84\uc11d\ud574\uc11c \uc22b\uc790\ub85c \ubcf4\uc5ec\uc8fc\uac70\ub4e0. xG, \uc810\uc720\uc728, \uc218\ube44 \uac15\ub3c4, \uc5ed\ub300 \uc804\uc801\uae4c\uc9c0. \uadfc\ub370 \uadf8\uac78 \uc548 \ubcf4\uba74 \uadf8\ub0e5 \ub2e4\ub978 \ud32c\ub4e4\uacfc \ub611\uac19\uc740 \uc218\uc900\uc774\uc57c. \ub108\uc758 \uc9c1\uac10\uc740 \uc774\ubbf8 \uc218\ub9ce\uc740 \ub370\uc774\ud130\ub85c \uac80\uc99d\ub41c AI\ubcf4\ub2e4 \uc815\ud655\ud560 \ud655\ub960\uc774 \ub0ae\uc544. \uc774\uac78 \ubb34\uc2dc\ud558\ub294 \uc21c\uac04, \ub108\ub294 '\ub370\uc774\ud130\ub97c \uac00\uc9c4 \uac10\uc815\uc801 \ud32c'\uc774 \ub418\ub294 \uac70\uc57c. \uac00\uc7a5 \ud070 \ub0ad\ube44\uc9c0.",
    "\ud574\uacb0\ucc45\uc740 \uac04\ub2e8\ud574. \uc571\uc5d0\uc11c '\ud655\uc2e0 \uc810\uc218'\uac00 \ub192\uc740 \uc608\uce21\ubd80\ud130 \ud655\uc778\ud574\ubd10. 90% \uc774\uc0c1\uc758 \uc608\uce21\uc740 \uac70\uc758 \ud2c0\ub9b0 \uc801\uc774 \uc5c6\uc5b4. \uadf8\ub7f0 \ub2e4\uc74c\uc5d0 '\ud034\uc988' \uae30\ub2a5\uc73c\ub85c \ub108\uc758 \ucd95\uad6c \uc9c0\uc2dd\uc744 \ud14c\uc2a4\ud2b8\ud574\ubd10. AI vs \ub108\uc758 \ub300\uacb0\uc5d0\uc11c \uc774\uae30\uba74 \ub9ac\ub354\ubcf4\ub4dc\uc5d0 \uc624\ub974\uace0, \uc2a4\ud2b8\ub9ad\ub3c4 \uc313\uc5ec. \uc791\uc740 \uc2b5\uad00 \ud558\ub098\uac00 \uacb0\uacfc\ub97c \uc644\uc804\ud788 \ubc14\uafd4.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571 \uc5f4\uc5b4\uc11c '\ud655\uc2e0 \uc810\uc218' \ud0ed\uc744 \ud655\uc778\ud574\ubd10. \ub192\uc740 \uc810\uc218\uc758 \uacbd\uae30\ubd80\ud130 \ubd84\uc11d\ud574. P.S. \uc774\uac78 3\uc77c\ub9cc \ud574\ubcf4\uba74, \uc65c \uc0ac\ub78c\ub4e4\uc774 '\ub370\uc774\ud130\uac00 \uc9c1\uac10\uc744 \uc774\uae34\ub2e4'\uace0 \ub9d0\ud558\ub294\uc9c0 \uc54c\uac8c \ub420 \uac70\uc57c. \ubb34\ub8cc \ud504\ub9ac\ubbf8\uc5c4 \uccb4\ud5d8\ub3c4 \ucf1c\uc838 \uc788\uc73c\ub2c8, \ubaa8\ub4e0 \uc608\uce21\uc744 \ud55c \ubc88\uc5d0 \ud655\uc778\ud574\ubd10."
  ],
