{
  "subject": "\u7b2c14\u5929\u7684\u79d8\u5bc6\uff1a\u97f3\u91cf\u63d0\u5347200%\u7684\u771f\u6b63\u65b9\u6cd5",
  "preview_text": "\u4e00\u4e2a\u7b80\u5355\u8c03\u6574\uff0c\u8ba9\u4f60\u7684\u624b\u673a\u97f3\u91cf\u77ac\u95f4\u7ffb\u500d\uff0c\u4e0d\u518d\u88ab\u566a\u97f3\u6df9\u6ca1\u3002",
  "body_paragraphs": [
    "\u4f60\u77e5\u9053\u5417\uff1f\u5927\u591a\u6570\u97f3\u91cf\u589e\u5f3a\u5668\u53ea\u4f1a\u8ba9\u58f0\u97f3\u53d8\u5f97\u523a\u8033\uff0c\u751a\u81f3\u635f\u574f\u626c\u58f0\u5668\u3002\u6211\u5728\u901a\u52e4\u65f6\u8bd5\u8fc7\u6240\u6709\u65b9\u6cd5\uff0c\u76f4\u5230\u53d1\u73b0\u4e00\u4e2a\u7b80\u5355\u8c03\u6574\u2014\u2014\u5728Loud EQ\u91cc\u9009\u62e9\u201c\u4f18\u5316\u201d\u6309\u94ae\uff0c\u7136\u540e\u63d2\u4e0a\u8033\u673a\u3002\u4e00\u77ac\u95f4\uff0c\u58f0\u97f3\u53d8\u5f97\u6e05\u6670\u6709\u529b\uff0c\u8fde\u5730\u94c1\u566a\u97f3\u90fd\u6321\u4e0d\u4f4f\u3002",
    "\u8fd9\u4e0d\u662f\u9b54\u6cd5\uff0c\u800c\u662f\u57fa\u4e8e\u4f60\u7684\u8bbe\u5907\u81ea\u52a8\u6821\u51c6\u7684\u3002Loud EQ\u76845\u6ce2\u6bb5\u5747\u8861\u5668\u548c4\u4e2a\u97f3\u9891\u914d\u7f6e\u6587\u4ef6\uff0c\u8ba9\u97f3\u4e50\u3001\u64ad\u5ba2\u3001\u7535\u5f71\u548c\u6e38\u620f\u90fd\u5404\u6709\u6700\u4f73\u8bbe\u7f6e\u3002\u4f60\u4e0d\u9700\u8981\u662f\u97f3\u9891\u4e13\u5bb6\uff0c\u53ea\u9700\u4e00\u952e\u201c\u4f18\u5316\u201d\uff0c\u7cfb\u7edf\u4f1a\u5206\u6790\u4f60\u63d2\u4e0a\u7684\u8033\u673a\u6216\u84dd\u7259\u8bbe\u5907\uff0c\u8c03\u6574\u6bcf\u4e00\u9891\u6bb5\uff0c\u786e\u4fdd\u4eba\u58f0\u6e05\u6670\u3001\u80cc\u666f\u97f3\u4e0d\u63a9\u4e3b\u97f3\u3002",
    "\u6211\u7528\u4e86\u534a\u5e74\uff0c\u624d\u610f\u8bc6\u5230\u8fd9\u4e2a\u9690\u85cf\u6280\u5de7\uff1a\u5148\u9009\u62e9\u201c\u64ad\u5ba2\u201d\u914d\u7f6e\u6587\u4ef6\uff0c\u518d\u70b9\u51fb\u201c\u4f18\u5316\u201d\uff0c\u901a\u52e4\u65f6\u5373\u4f7f\u97f3\u91cf\u53ea\u523050%\uff0c\u4e5f\u80fd\u542c\u6e05\u6bcf\u4e2a\u5b57\u3002\u9ad8\u7ea7\u7248\u8fd8\u89e3\u9501\u5b8c\u6574\u7684200%\u589e\u5f3a\u548c\u58f0\u97f3DNA\u6821\u51c6\uff0c\u4f46\u5373\u4f7f\u514d\u8d39\u7248\uff0c\u8fd9\u4e2a\u7b80\u5355\u6b65\u9aa4\u5df2\u7ecf\u8ba9\u4f53\u9a8c\u7ffb\u500d\u3002",
    "\u8bd5\u8bd5\u8fd9\u4e2a\uff1a\u6253\u5f00Loud EQ\uff0c\u70b9\u51fb\u201c\u4f18\u5316\u201d\uff0c\u7136\u540e\u63d2\u4e0a\u8033\u673a\u3002\u4f60\u4f1a\u7acb\u523b\u611f\u53d7\u5230\u4e0d\u540c\u3002\u522b\u8ba9\u566a\u97f3\u593a\u8d70\u4f60\u7684\u5185\u5bb9\u3002P.S. \u5982\u679c\u4f60\u7684\u8033\u673a\u662fAirPods\uff0c\u4f1a\u81ea\u52a8\u9002\u914d\u2014\u2014\u8fd9\u662f\u6211\u6700\u7231\u7684\u7701\u5fc3\u529f\u80fd\u3002"
  ],
