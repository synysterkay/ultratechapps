{
  "subject": "\u0627\u0644\u064a\u0648\u0645 5000 \u0645\u0634\u062c\u0639 \u0627\u0633\u062a\u062e\u062f\u0645\u0648\u0627 Predictify \u0648\u0647\u0630\u0627 \u0645\u0627 \u062d\u0635\u0644",
  "preview_text": "\u0623\u0643\u062b\u0631 \u0645\u0646 5000 \u0645\u0634\u062c\u0639 \u0627\u0633\u062a\u062e\u062f\u0645\u0648\u0627 \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a \u0627\u0644\u0630\u0643\u064a\u0629 \u0627\u0644\u064a\u0648\u0645. \u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0627\u0644\u062a\u064a \u062d\u0635\u0644\u0648\u0627 \u0639\u0644\u064a\u0647\u0627 \u0648\u0643\u064a\u0641 \u063a\u064a\u0631\u0648\u0627 \u0637\u0631\u064a\u0642\u0629 \u0644\u0639\u0628\u0647\u0645.",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u0641\u064a \u063a\u0631\u0641\u0629 \u0627\u0644\u0645\u0644\u0627\u0628\u0633 \u0642\u0628\u0644 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u0643\u0628\u064a\u0631\u0629\u060c \u0648\u0643\u0644 \u0627\u0644\u0644\u0627\u0639\u0628\u064a\u0646 \u064a\u0639\u0631\u0641\u0648\u0646 \u0646\u0642\u0627\u0637 \u0636\u0639\u0641 \u0627\u0644\u062e\u0635\u0645 \u0628\u0627\u0644\u0636\u0628\u0637. \u0647\u0630\u0627 \u0645\u0627 \u062d\u062f\u062b \u0627\u0644\u064a\u0648\u0645 \u0644\u0623\u0643\u062b\u0631 \u0645\u0646 5000 \u0645\u0634\u062c\u0639 \u0627\u0633\u062a\u062e\u062f\u0645\u0648\u0627 Predictify. \u0644\u0645 \u064a\u0639\u062a\u0645\u062f\u0648\u0627 \u0639\u0644\u0649 \u0627\u0644\u062d\u0638 \u0623\u0648 \u0627\u0644\u062e\u0628\u0631\u0629 \u0641\u0642\u0637\u060c \u0628\u0644 \u0639\u0644\u0649 \u062a\u062d\u0644\u064a\u0644 \u0628\u064a\u0627\u0646\u0627\u062a AI \u062f\u0642\u064a\u0642 \u0644\u0643\u0644 \u0645\u0628\u0627\u0631\u0627\u0629.",
    "\u0627\u0644\u064a\u0648\u0645\u060c \u0627\u0643\u062a\u0634\u0641 \u0647\u0624\u0644\u0627\u0621 \u0627\u0644\u0645\u0634\u062c\u0639\u0648\u0646 \u0623\u0646 AI \u062a\u0648\u0642\u0639 \u0641\u0648\u0632 \u0628\u0631\u0634\u0644\u0648\u0646\u0629 \u0639\u0644\u0649 \u0631\u064a\u0627\u0644 \u0645\u062f\u0631\u064a\u062f \u0628\u062b\u0642\u0629 78%\u060c \u0628\u064a\u0646\u0645\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a \u0627\u0644\u062a\u0642\u0644\u064a\u062f\u064a\u0629 \u062a\u0634\u064a\u0631 \u0625\u0644\u0649 \u062a\u0639\u0627\u062f\u0644. \u0627\u0644\u0646\u062a\u064a\u062c\u0629\u061f \u0641\u0648\u0632 \u0628\u0631\u0634\u0644\u0648\u0646\u0629 2-1. \u062a\u062e\u064a\u0644 \u0644\u0648 \u0643\u0646\u062a \u062a\u0639\u0631\u0641 \u0647\u0630\u0647 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0629 \u0642\u0628\u0644 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629\u061f",
    "\u0627\u0644\u0623\u0645\u0631 \u0644\u0627 \u064a\u062a\u0639\u0644\u0642 \u0641\u0642\u0637 \u0628\u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a. Predictify \u064a\u0645\u0646\u062d\u0643 \u062a\u062d\u0644\u064a\u0644 \u0643\u0644 \u0644\u0627\u0639\u0628: xG\u060c \u0627\u0644\u0627\u0633\u062a\u062d\u0648\u0627\u0630\u060c \u0627\u0644\u0642\u0648\u0629 \u0627\u0644\u0647\u062c\u0648\u0645\u064a\u0629 \u0648\u0627\u0644\u062f\u0641\u0627\u0639\u064a\u0629\u060c \u0648\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0648\u0627\u062c\u0647\u0627\u062a \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629. \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 Confidence Score \u0644\u0643\u0644 \u062a\u0648\u0642\u0639\u060c \u062d\u062a\u0649 \u062a\u0639\u0631\u0641 \u0628\u0627\u0644\u0636\u0628\u0637 \u0645\u062a\u0649 \u062a\u062b\u0642 \u0628\u0627\u0644AI \u0648\u0645\u062a\u0649 \u062a\u062a\u062d\u0641\u0638. \u0647\u0630\u0627 \u0645\u0627 \u064a\u062c\u0639\u0644\u0643 \u0627\u0644\u0623\u0630\u0643\u0649 \u0628\u064a\u0646 \u0623\u0635\u062f\u0642\u0627\u0626\u0643.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628 \u0645\u064a\u0632\u0629 '\u062a\u0648\u0642\u0639 \u0627\u0644\u064a\u0648\u0645' (Prediction of the Day) \u0641\u064a \u0642\u0633\u0645 \u0627\u0644\u0645\u062c\u062a\u0645\u0639\u0627\u062a. \u0634\u0627\u0647\u062f \u0643\u064a\u0641 \u064a\u062e\u062a\u0644\u0641 \u062a\u0648\u0642\u0639 AI \u0639\u0646 \u062a\u0648\u0642\u0639 \u0627\u0644\u0645\u0634\u062c\u0639\u064a\u0646 \u0627\u0644\u0622\u062e\u0631\u064a\u0646. \u0627\u0628\u062f\u0623 \u0631\u062d\u0644\u062a\u0643 \u0646\u062d\u0648 \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a \u0627\u0644\u0630\u0643\u064a\u0629 \u0627\u0644\u064a\u0648\u0645. P.S. \u062a\u0630\u0643\u0631: \u0643\u0644 \u064a\u0648\u0645 \u062a\u0623\u062e\u064a\u0631 \u064a\u0639\u0646\u064a \u0623\u0646 \u0622\u0644\u0627\u0641 \u0627\u0644\u0645\u0634\u062c\u0639\u064a\u0646 \u064a\u0633\u0628\u0642\u0648\u0646\u0643 \u0628\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062d\u0627\u0633\u0645\u0629. \u062c\u0631\u0628 \u0627\u0644\u0628\u0631\u064a\u0645\u064a\u0648\u0645 \u0645\u062c\u0627\u0646\u0627 \u0644\u0645\u062f\u0629 3 \u0623\u064a\u0627\u0645 \u0648\u0627\u0641\u062a\u062d \u0643\u0644 \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629."
  ],
