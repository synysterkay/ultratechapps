{
  "subject": "\u092c\u093f\u0928\u093e \u090f\u092a \u0915\u0947 8 \u0918\u0902\u091f\u0947 \u092c\u0928\u093e\u092e \u0938\u093e\u0925 \u092e\u0947\u0902 10 \u092e\u093f\u0928\u091f",
  "preview_text": "\u0935\u0939 \u0921\u0930\u093e\u0935\u0928\u093e \u092a\u0932 \u091c\u092c \u0906\u092a \u0916\u093e\u0932\u0940 \u092a\u0928\u094d\u0928\u0947 \u0915\u094b \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0938\u092e\u092f \u0916\u0924\u094d\u092e \u0939\u094b \u0930\u0939\u093e \u0939\u0948\u0964 \u0905\u092c \u0935\u0939 \u092c\u0926\u0932 \u0917\u092f\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u0939 \u092a\u0932 \u091c\u092c \u0906\u092a \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0916\u093e\u0932\u0940 \u092a\u0928\u094d\u0928\u0947 \u0915\u094b \u0926\u0947\u0916 \u0930\u0939\u0947 \u0925\u0947 \u0914\u0930 \u0925\u0940\u0938\u093f\u0938 \u0915\u093e \u0928\u093e\u092e \u092d\u0940 \u0928\u0939\u0940\u0902 \u0906 \u0930\u0939\u093e \u0925\u093e? 8 \u0918\u0902\u091f\u0947 \u092c\u093e\u0926 \u0906\u092a \u0905\u092c \u092d\u0940 \u0935\u0939\u0940\u0902 \u0925\u0947, \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0932\u093e\u0907\u0928 \u0932\u093f\u0916\u0940 \u0925\u0940 \u0914\u0930 \u0921\u0947\u0921\u0932\u093e\u0907\u0928 \u0905\u092c \u0938\u093f\u0930\u094d\u092b 2 \u0918\u0902\u091f\u0947 \u0926\u0942\u0930 \u0925\u0940\u0964 \u0935\u0939 \u0921\u0930, \u0935\u0939 \u0918\u092c\u0930\u093e\u0939\u091f, \u0935\u0939 \u0938\u094b\u091a\u0928\u093e \u0915\u093f \u0936\u093e\u092f\u0926 \u0906\u092a \u0915\u093e\u092b\u0940 \u0928\u0939\u0940\u0902 \u0939\u094b\u0964",
    "\u0905\u092c \u0907\u0938\u0915\u0940 \u0924\u0941\u0932\u0928\u093e \u0915\u0930\u094b: \u0906\u091c \u0924\u0941\u092e\u0928\u0947 \u0935\u0939\u0940 \u0925\u0940\u0938\u093f\u0938 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0924\u0948\u092f\u093e\u0930 \u0915\u0940\u0964 Thesis Generator \u0928\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u091f\u0949\u092a\u093f\u0915 \u0915\u094b \u092a\u0915\u0921\u093c \u0932\u093f\u092f\u093e, \u090f\u0915 \u092e\u091c\u092c\u0942\u0924 \u0906\u0930\u094d\u0917\u0941\u092e\u0947\u0902\u091f \u092c\u0928\u093e\u092f\u093e, \u0914\u0930 \u092b\u093f\u0930 \u092a\u0942\u0930\u093e \u0906\u0909\u091f\u0932\u093e\u0907\u0928 \u0926\u0947 \u0926\u093f\u092f\u093e\u0964 \u0924\u0941\u092e\u0928\u0947 \u092c\u0938 \u0915\u0941\u091b \u0915\u094d\u0932\u093f\u0915 \u0915\u093f\u090f \u0914\u0930 2 \u0918\u0902\u091f\u0947 \u092c\u093e\u0926 \u092a\u0947\u092a\u0930 \u0930\u0947\u0921\u0940 \u0925\u093e\u0964 \u0935\u0939 \u092c\u0926\u0932\u093e\u0935 \u0938\u093f\u0930\u094d\u092b \u0938\u092e\u092f \u0915\u093e \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0906\u0924\u094d\u092e\u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u0915\u093e \u0939\u0948\u0964",
    "\u092f\u0939 \u0938\u092c \u0915\u0948\u0938\u0947 \u0939\u094b\u0924\u093e \u0939\u0948? \u092f\u0939 \u0910\u092a \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0935\u093f\u0937\u092f \u0915\u094b \u0938\u092e\u091d\u0924\u093e \u0939\u0948 \u0914\u0930 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u090f\u0915 \u092a\u0930\u092b\u0947\u0915\u094d\u091f \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u091c\u0928\u0930\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0938\u093e\u0925 \u0939\u0940, \u0911\u091f\u094b-\u091c\u0947\u0928\u0930\u0947\u091f\u0947\u0921 \u0917\u094d\u0930\u093e\u092b, \u091f\u0947\u092c\u0932 \u0914\u0930 \u0938\u093e\u0907\u091f\u0947\u0936\u0928 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0905\u092c \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0938\u093f\u0930\u094d\u092b \u092a\u0949\u0932\u093f\u0936 \u0915\u0930\u0928\u093e \u0939\u0948 \u0914\u0930 \u092a\u0940\u0921\u0940\u090f\u092b \u090f\u0915\u094d\u0938\u092a\u094b\u0930\u094d\u091f \u0915\u0930\u0928\u093e \u0939\u0948 \u2014 \u0915\u094b\u0908 AI \u0921\u093f\u091f\u0947\u0915\u094d\u0936\u0928 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u091f\u0930\u094d\u0928\u093f\u091f\u093f\u0928 \u0915\u0940 \u091a\u093f\u0902\u0924\u093e \u0928\u0939\u0940\u0902\u0964",
    "\u0924\u094b \u0905\u092c \u0915\u094d\u092f\u093e \u0915\u0930\u0928\u093e \u0939\u0948? \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 'Generate Thesis' \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u094b\u0964 \u092c\u0938 10 \u092e\u093f\u0928\u091f \u0926\u094b \u0914\u0930 \u0926\u0947\u0916\u094b \u0915\u093f \u0924\u0941\u092e \u0915\u093f\u0924\u0928\u093e \u0906\u0917\u0947 \u0928\u093f\u0915\u0932 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964 P.S. \u2014 \u0935\u0939 50,000 \u091b\u093e\u0924\u094d\u0930 \u091c\u094b \u092a\u0939\u0932\u0947 \u0939\u0940 B+ \u0938\u0947 A- \u0924\u0915 \u092a\u0939\u0941\u0901\u091a \u091a\u0941\u0915\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0938\u092c \u092f\u0939\u0940\u0902 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u093f\u090f \u0925\u0947\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0930\u0940 \u0939\u0948\u0964"
  ],
