{
  "subject": "\u0906\u092a\u0915\u0940 \u0925\u0940\u0938\u093f\u0938 \u0905\u092c \u0938\u093f\u0930\u094d\u092b \u0906\u092a\u0915\u0940 \u0928\u0939\u0940\u0902",
  "preview_text": "70 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0906\u092a 50,000 \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0915\u0940 \u091f\u0940\u092e \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092c\u0928 \u0917\u090f \u0939\u0948\u0902\u0964 \u090f\u0915 \u092e\u093f\u0936\u0928 \u091c\u094b \u0936\u0941\u0930\u0942 \u0939\u094b \u091a\u0941\u0915\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u094b \u092a\u0932 \u091c\u092c \u0906\u092a\u0928\u0947 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930 \u0916\u094b\u0932\u093e \u0925\u093e? \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0925\u0940\u0938\u093f\u0938 \u091a\u093e\u0939\u093f\u090f \u0925\u0940, \u0939\u0948 \u0928\u093e? \u0932\u0947\u0915\u093f\u0928 70 \u0926\u093f\u0928 \u092c\u093e\u0926, \u0906\u092a 50,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0915\u0940 \u092b\u094c\u091c \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u0948\u0902\u0964 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0906\u092a\u0928\u0947 '\u091c\u0928\u0930\u0947\u091f' \u0926\u092c\u093e\u092f\u093e, \u090f\u0915 \u0928\u0908 \u0925\u0940\u0938\u093f\u0938 \u092c\u0928\u0940, \u090f\u0915 \u0917\u094d\u0930\u0947\u0921 \u092c\u0947\u0939\u0924\u0930 \u0939\u0941\u0906, \u090f\u0915 \u0921\u0930 \u0916\u0924\u094d\u092e \u0939\u0941\u0906\u0964",
    "\u0939\u092e\u0928\u0947 \u090f\u0915 \u0938\u093f\u0938\u094d\u091f\u092e \u092c\u0928\u093e\u092f\u093e \u0939\u0948 \u091c\u094b 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0935\u094b \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948 \u091c\u094b \u092a\u0939\u0932\u0947 8 \u0918\u0902\u091f\u0947 \u0932\u0947\u0924\u093e \u0925\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932\u0940 \u0915\u094d\u0930\u093e\u0902\u0924\u093f \u092f\u0947 \u0939\u0948 \u0915\u093f \u0906\u092a \u0938\u093f\u0930\u094d\u092b \u092f\u0942\u091c\u0930 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0907\u0938 \u092e\u093f\u0936\u0928 \u0915\u0947 \u092e\u093e\u0932\u093f\u0915 \u0939\u0948\u0902\u0964 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0915\u094b\u0908 AI \u0921\u093f\u091f\u0947\u0915\u094d\u0936\u0928 \u0915\u094b \u092c\u093e\u092f\u092a\u093e\u0938 \u0915\u0930\u0924\u093e \u0939\u0948 \u092f\u093e \u090f\u0915 \u092a\u0930\u092b\u0947\u0915\u094d\u091f APA \u0938\u093e\u0907\u091f\u0947\u0936\u0928 \u091c\u0928\u0930\u0947\u091f \u0939\u094b\u0924\u093e \u0939\u0948, \u0924\u094b \u0935\u094b \u0906\u092a\u0915\u0940 \u0935\u091c\u0939 \u0938\u0947 \u0939\u0948\u0964",
    "\u0905\u092c \u090f\u0915 \u0928\u092f\u093e \u092b\u0940\u091a\u0930 \u0906 \u0930\u0939\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b \u0914\u0930 \u092d\u0940 \u0924\u0947\u091c\u093c, \u0914\u0930 \u092d\u0940 \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u092c\u0928\u093e\u090f\u0917\u093e\u0964 '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c AI' \u092b\u0940\u091a\u0930 \u0928\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 Turnitin \u0914\u0930 GPTZero \u0915\u094b \u092e\u093e\u0924 \u0926\u0940 \u0939\u0948\u0964 \u0914\u0930 \u0939\u092e \u0906\u092a\u0915\u0940 \u092b\u0940\u0921\u092c\u0948\u0915 \u0938\u0947 \u0939\u0940 \u092f\u0947 \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0906\u091c \u0915\u093e \u0915\u093e\u092e: \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0940 \u092a\u093f\u091b\u0932\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b \u090f\u0915 \u092c\u093e\u0930 \u092b\u093f\u0930 \u0938\u0947 '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c' \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u0947\u0902\u0964 \u0926\u0947\u0916\u093f\u090f \u0915\u093f\u0924\u0928\u093e \u0938\u094d\u092e\u0942\u0925 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 P.S. 2 \u092c\u091c\u0947 \u0930\u093e\u0924 \u0915\u094b \u091c\u092c \u0915\u094b\u0908 \u0928\u0908 \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f \u0939\u094b\u0917\u0940, \u0924\u094b \u0935\u094b \u0906\u092a\u0915\u0940 \u092e\u0926\u0926 \u0938\u0947 \u0939\u094b\u0917\u0940\u0964"
