{
  "subject": "\u0905\u091c\u092f \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u091c\u093f\u0938\u0928\u0947 \u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0915\u094b \u0930\u094b\u0915 \u0926\u093f\u092f\u093e",
  "preview_text": "55 \u0926\u093f\u0928\u094b\u0902 \u092c\u093e\u0926 \u092d\u0940 \u0935\u0939 \u0930\u094b\u091c\u093c Loudify \u0916\u094b\u0932\u0924\u093e \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0906\u092a\u0928\u0947 \u0909\u0938\u0915\u093e \u0930\u093e\u091c \u091c\u093e\u0928\u093e?",
  "body_paragraphs": [
    "\u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0938\u0941\u092c\u0939 \u0910\u0938\u0940 \u0906\u0908 \u091c\u092c \u0938\u092c \u091a\u0941\u092a \u0939\u094b \u0917\u090f\u0964 \u0905\u091c\u092f \u0928\u0947 \u0932\u093f\u0916\u093e\u2014'\u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u094b \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0938\u0939\u0940 \u0938\u0947 \u0938\u0941\u0928\u093e\u0964' \u092f\u0939 \u0915\u094b\u0908 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0928\u0939\u0940\u0902 \u0925\u093e, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u0938\u091a\u094d\u091a\u093e \u0905\u0928\u0941\u092d\u0935 \u0925\u093e \u091c\u094b 55 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0936\u0941\u0930\u0942 \u0939\u0941\u0906 \u0925\u093e\u0964",
    "\u0905\u091c\u092f \u091f\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u0930\u094b\u091c\u093c \u0911\u0921\u093f\u092f\u094b\u092c\u0941\u0915 \u0938\u0941\u0928\u0924\u093e \u0939\u0948\u0964 \u0909\u0938\u0947 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0925\u0940, \u0932\u0947\u0915\u093f\u0928 \u0921\u093e\u092f\u0932\u0949\u0917 \u0938\u093e\u092b\u093c \u0930\u0939\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u0925\u093e\u0964 \u0909\u0938\u0928\u0947 Loudify \u0915\u093e AutoEQ \u0906\u091c\u093c\u092e\u093e\u092f\u093e\u2014\u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u092e\u0949\u0921\u0932 \u0915\u0947 \u0932\u093f\u090f \u0924\u0941\u0930\u0902\u0924 \u091f\u094d\u092f\u0942\u0928 \u0939\u094b \u0917\u092f\u093e\u0964 \u0905\u092c \u0935\u0939 \u0915\u0939\u0924\u093e \u0939\u0948 '\u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u092e\u0948\u0902 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0924\u093e \u0939\u0942\u0901, \u0924\u094b \u0906\u0935\u093e\u091c\u093c \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u092a\u0930\u092b\u0947\u0915\u094d\u091f \u0939\u094b\u0924\u0940 \u0939\u0948\u0964'",
    "\u092f\u0939\u0940 \u0939\u092e\u093e\u0930\u093e \u0932\u0915\u094d\u0937\u094d\u092f \u0939\u0948\u2014\u0939\u0930 \u0915\u093f\u0938\u0940 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0910\u0938\u093e \u0905\u0928\u0941\u092d\u0935 \u091c\u094b \u0909\u0928\u0915\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u094b \u092a\u0939\u091a\u093e\u0928\u0947\u0964 \u0905\u091c\u092f \u0915\u0940 \u0924\u0930\u0939, \u0906\u092a \u092d\u0940 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0947 \u0932\u093f\u090f AutoEQ \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092e\u0947\u0902 \u092f\u0939 \u0938\u0941\u0935\u093f\u0927\u093e \u0939\u0948, \u0914\u0930 \u092f\u0939 \u0906\u092a\u0915\u0947 \u0938\u0941\u0928\u0928\u0947 \u0915\u0947 \u0924\u0930\u0940\u0915\u0947 \u0915\u094b \u092c\u0926\u0932 \u0926\u0947\u0917\u0940\u0964",
    "\u0906\u091c \u0939\u0940 Loudify \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u0940 \u091f\u094d\u092f\u0942\u0928\u093f\u0902\u0917 \u092a\u093e\u090f\u0901\u0964 P.S. \u0905\u091c\u092f \u0928\u0947 \u0905\u092a\u0928\u0940 Sound DNA \u092d\u0940 \u0926\u0947\u0916\u0940\u2014\u0909\u0938\u0928\u0947 \u092a\u093e\u092f\u093e \u0915\u093f \u0935\u0939 \u0930\u094b\u091c\u093c 2 \u0918\u0902\u091f\u0947 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0911\u0921\u093f\u092f\u094b\u092c\u0941\u0915 \u0938\u0941\u0928\u0924\u093e \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0906\u092a\u0915\u0940 Sound DNA \u0906\u092a\u0915\u094b \u091a\u094c\u0902\u0915\u093e\u090f\u0917\u0940?"
