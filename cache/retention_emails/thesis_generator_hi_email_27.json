{
  "subject": "\u0939\u092e\u0928\u0947 10,000 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u093e \u0921\u0947\u091f\u093e \u0926\u0947\u0916\u093e \u0914\u0930 \u091a\u094c\u0902\u0915 \u0917\u090f",
  "preview_text": "\u0906\u092a\u0915\u0940 \u0925\u0940\u0938\u093f\u0938 \u092e\u0947\u0902 \u090f\u0915 \u091b\u0941\u092a\u0940 \u0939\u0941\u0908 \u0917\u0932\u0924\u0940 \u0939\u0948 \u091c\u094b 90% \u091b\u093e\u0924\u094d\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u091c\u093e\u0928\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0906\u092a \u0939\u0948\u0930\u093e\u0928 \u0930\u0939 \u091c\u093e\u090f\u0902\u0917\u0947\u0964",
  "body_paragraphs": [
    "\u0939\u092e\u0928\u0947 10,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0921\u0947\u091f\u093e \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u093f\u092f\u093e, \u0914\u0930 \u091c\u094b \u0939\u092e\u0947\u0902 \u092e\u093f\u0932\u093e \u0935\u094b \u0939\u0948\u0930\u093e\u0928 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u0939\u0948\u0964 90% \u091b\u093e\u0924\u094d\u0930 \u0905\u092a\u0928\u0940 \u0925\u0940\u0938\u093f\u0938 \u092e\u0947\u0902 \u090f\u0915 \u0939\u0940 \u0917\u0932\u0924\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u0909\u0928\u0915\u0947 \u0917\u094d\u0930\u0947\u0921 \u0915\u094b \u0928\u0940\u091a\u0947 \u0916\u0940\u0902\u091a \u0926\u0947\u0924\u0940 \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0935\u0939 \u0915\u094d\u092f\u093e \u0939\u0948?",
    "\u0939\u092e\u093e\u0930\u0947 \u0921\u0947\u091f\u093e \u0938\u0947 \u092a\u0924\u093e \u091a\u0932\u093e \u0915\u093f \u091c\u093f\u0928 \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0928\u0947 \u0905\u092a\u0928\u0940 \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u0915\u094b \u0905\u0902\u0924\u093f\u092e \u0930\u0942\u092a \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u092e\u093e\u0930\u0947 '\u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930' \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e, \u0909\u0928\u0915\u0947 \u0917\u094d\u0930\u0947\u0921 \u0914\u0938\u0924\u0928 B+ \u0938\u0947 \u092c\u0922\u093c\u0915\u0930 A- \u0939\u094b \u0917\u090f\u0964 \u0932\u0947\u0915\u093f\u0928 \u091c\u093f\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0907\u0938\u0947 \u091b\u094b\u0921\u093c \u0926\u093f\u092f\u093e \u092f\u093e \u0926\u0947\u0930 \u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e, \u0909\u0928\u0915\u0947 \u0928\u0902\u092c\u0930 \u0915\u093e\u092b\u0940 \u0915\u092e \u0930\u0939\u0947\u0964 \u092f\u0939 \u0915\u094b\u0908 \u0938\u0902\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",
    "\u0939\u092e\u093e\u0930\u0947 \u0910\u092a \u092e\u0947\u0902 \u090f\u0915 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948, \u091c\u092c\u0915\u093f \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0907\u0938\u092e\u0947\u0902 8 \u0918\u0902\u091f\u0947 \u0932\u0917\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u0938\u092e\u092f \u092c\u091a\u093e\u0928\u0947 \u0935\u093e\u0932\u093e \u0928\u0939\u0940\u0902 \u0939\u0948, \u092c\u0932\u094d\u0915\u093f \u0906\u092a\u0915\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b \u0938\u091f\u0940\u0915 \u0914\u0930 \u092a\u094d\u0930\u092d\u093e\u0935\u0936\u093e\u0932\u0940 \u092c\u0928\u093e\u0928\u0947 \u0935\u093e\u0932\u093e \u0939\u0948\u0964 \u091c\u092c \u0906\u092a \u0907\u0938\u0947 \u0916\u094b\u0932\u0947\u0902\u0917\u0947, \u0924\u094b \u0906\u092a \u0926\u0947\u0916\u0947\u0902\u0917\u0947 \u0915\u093f \u092f\u0939 \u0915\u0948\u0938\u0947 \u0906\u092a\u0915\u0947 \u0935\u093f\u091a\u093e\u0930\u094b\u0902 \u0915\u094b \u090f\u0915 \u092e\u091c\u092c\u0942\u0924 \u0906\u0927\u093e\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0906\u092a\u0915\u094b \u092c\u0938 \u090f\u0915 \u0915\u093e\u092e \u0915\u0930\u0928\u093e \u0939\u0948: \u0905\u092a\u0928\u0947 \u0910\u092a \u092e\u0947\u0902 '\u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930' \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u093e \u0935\u093f\u0937\u092f \u0921\u093e\u0932\u0947\u0902\u0964 \u0926\u0947\u0916\u093f\u090f \u0915\u0948\u0938\u0947 \u092f\u0939 \u0906\u092a\u0915\u0940 \u092a\u0930\u0947\u0936\u093e\u0928\u0940 \u0915\u094b \u0916\u0924\u094d\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964 P.S. \u092f\u0939 \u092b\u0940\u091a\u0930 \u0938\u093f\u0930\u094d\u092b \u0906\u091c \u0915\u0947 \u0932\u093f\u090f \u092b\u094d\u0930\u0940 \u0939\u0948, \u0915\u0932 \u0924\u0915 \u0907\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0932\u0940\u091c\u093f\u090f\u0964"
  ],
