{
  "subject": "10,000 \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0915\u093e \u0921\u0947\u091f\u093e \u2014 \u091a\u094c\u0902\u0915\u093e\u0928\u0947 \u0935\u093e\u0932\u093e \u0938\u091a \u0938\u093e\u092e\u0928\u0947 \u0906\u092f\u093e",
  "preview_text": "\u0939\u092e\u0928\u0947 10,000 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0921\u0947\u091f\u093e \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u093f\u092f\u093e \u0914\u0930 \u092a\u093e\u092f\u093e \u0915\u093f 83% \u091b\u093e\u0924\u094d\u0930 \u090f\u0915 \u0939\u0940 \u0917\u0932\u0924\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u0909\u0928\u0915\u0947 \u0917\u094d\u0930\u0947\u0921\u094d\u0938 \u0915\u094b \u0924\u092c\u093e\u0939 \u0915\u0930 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u0938\u0941\u0928, \u0939\u092e\u0928\u0947 10,000 \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0921\u0947\u091f\u093e \u0915\u094b \u0916\u0902\u0917\u093e\u0932\u093e \u2014 \u0914\u0930 \u091c\u094b \u092e\u093f\u0932\u093e, \u0909\u0938\u0928\u0947 \u0939\u092e\u0947\u0902 \u0939\u0948\u0930\u093e\u0928 \u0915\u0930 \u0926\u093f\u092f\u093e\u0964 63% \u0932\u094b\u0917 \u0905\u092a\u0928\u093e \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u0932\u093f\u0916\u0928\u0947 \u092e\u0947\u0902 8 \u0918\u0902\u091f\u0947 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0932\u0917\u093e\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u092b\u093f\u0930 \u092d\u0940 67% \u0915\u094b \u0905\u092a\u0928\u093e \u092a\u0939\u0932\u093e \u0921\u094d\u0930\u093e\u092b\u094d\u091f \u0930\u0940\u091c\u0947\u0915\u094d\u091f \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092f\u0947 \u0915\u094b\u0908 \u0930\u0948\u0902\u0921\u092e \u0928\u0902\u092c\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948 \u2014 \u092f\u0947 \u0905\u0938\u0932 \u0932\u094b\u0917\u094b\u0902 \u0915\u093e \u0926\u0930\u094d\u0926 \u0939\u0948, \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0924\u0930\u0939 \u0939\u0940 \u0921\u0947\u0921\u0932\u093e\u0907\u0928 \u0915\u0947 \u092a\u094d\u0930\u0947\u0936\u0930 \u092e\u0947\u0902 \u0939\u0948\u0902\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u0938\u092c\u0938\u0947 \u091a\u094c\u0902\u0915\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u092c\u093e\u0924 \u092f\u0947 \u0939\u0948: \u091c\u094b \u0932\u094b\u0917 \u0939\u092e\u093e\u0930\u0947 \u0910\u092a \u0915\u093e '\u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930' \u092b\u0940\u091a\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0938\u093f\u0930\u094d\u092b 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u090f\u0915 \u0938\u0949\u0932\u093f\u0921 \u0925\u0940\u0938\u093f\u0938 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902 \u2014 \u0914\u0930 \u0909\u0928\u0915\u0947 \u0917\u094d\u0930\u0947\u0921\u094d\u0938 \u092e\u0947\u0902 B+ \u0938\u0947 A- \u0924\u0915 \u0915\u093e \u0909\u091b\u093e\u0932 \u0906\u0924\u093e \u0939\u0948\u0964 \u092f\u0947 \u0915\u094b\u0908 \u092e\u093e\u0930\u094d\u0915\u0947\u091f\u093f\u0902\u0917 \u0917\u0940\u092e\u093f\u0915 \u0928\u0939\u0940\u0902, \u092f\u0947 50,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u093e \u0930\u093f\u092f\u0932 \u0921\u0947\u091f\u093e \u0939\u0948\u0964",
    "\u0924\u094b \u0905\u092c \u0938\u094b\u091a: \u0924\u0942 \u0915\u093f\u0938 \u0915\u0948\u091f\u0947\u0917\u0930\u0940 \u092e\u0947\u0902 \u0906\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0948 \u2014 \u0935\u094b \u091c\u094b 8 \u0918\u0902\u091f\u0947 \u092c\u0930\u094d\u092c\u093e\u0926 \u0915\u0930\u0915\u0947 \u0930\u093f\u091c\u0947\u0915\u094d\u091f \u0939\u094b, \u092f\u093e \u0935\u094b \u091c\u094b 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 A \u0917\u094d\u0930\u0947\u0921 \u092a\u0915\u094d\u0915\u093e \u0915\u0930\u0947? \u0939\u092e\u093e\u0930\u093e '\u0906\u0908\u0921\u093f\u092f\u093e \u091f\u0942 \u0906\u0909\u091f\u0932\u093e\u0907\u0928' \u092b\u0940\u091a\u0930 \u0924\u0941\u091d\u0947 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u092e\u0947\u0902 \u092a\u0942\u0930\u093e \u092a\u0947\u092a\u0930 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930 \u0926\u0947\u0917\u093e \u2014 \u0917\u094d\u0930\u093e\u092b, \u091f\u0947\u092c\u0932, \u0938\u093e\u0907\u091f\u0947\u0936\u0928, \u0938\u092c \u0915\u0941\u091b\u0964",
    "\u0905\u092c \u0910\u092a \u0916\u094b\u0932 \u0914\u0930 '\u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0964 \u092c\u0938 10 \u092e\u093f\u0928\u091f \u0926\u0947, \u0914\u0930 \u0926\u0947\u0916 \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964 P.S. \u2014 \u0924\u0947\u0930\u093e \u092a\u093f\u091b\u0932\u093e \u0921\u094d\u0930\u093e\u092b\u094d\u091f \u0905\u092d\u0940 \u092d\u0940 \u0938\u0947\u0935 \u0939\u0948\u0964 \u0905\u0917\u0930 \u0924\u0942\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u0909\u0938\u0947 \u092b\u093e\u0907\u0928\u0932 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e, \u0924\u094b \u092f\u0947 \u0924\u0947\u0930\u093e \u092e\u094c\u0915\u093e \u0939\u0948 \u0909\u0938\u0947 A- \u092e\u0947\u0902 \u092c\u0926\u0932\u0928\u0947 \u0915\u093e\u0964"
  ],
