  "subject": "\u307b\u3068\u3093\u3069\u306e\u30e6\u30fc\u30b6\u30fc\u304c\u72af\u3057\u3066\u3044\u308b\u81f4\u547d\u7684\u306a\u30df\u30b9",
  "preview_text": "AI\u306e\u4e88\u6e2c\u3092\u305d\u306e\u307e\u307e\u4fe1\u3058\u3066\u3044\u308b\uff1f\u305d\u308c\u3001\u5b9f\u306f\u6700\u5927\u306e\u30c1\u30e3\u30f3\u30b9\u3092\u9003\u3057\u3066\u3044\u307e\u3059\u3002\u305f\u3063\u305f60\u79d2\u3067\u5909\u3048\u3089\u308c\u308b\u65b9\u6cd5\u3092\u6559\u3048\u307e\u3059\u3002",
  "body_paragraphs": [
    "\u5148\u9031\u306e\u30d7\u30ec\u30df\u30a2\u30ea\u30fc\u30b0\u3001\u30a2\u30fc\u30bb\u30ca\u30eb\u5bfe\u30de\u30f3\u30c1\u30a7\u30b9\u30bf\u30fc\u30fb\u30b7\u30c6\u30a3\u306e\u8a66\u5408\u3092\u899a\u3048\u3066\u3044\u307e\u3059\u304b\uff1fAI\u306f2-1\u3067\u30a2\u30fc\u30bb\u30ca\u30eb\u52dd\u5229\u306b85%\u306e\u78ba\u4fe1\u5ea6\u3092\u51fa\u3057\u3066\u3044\u307e\u3057\u305f\u3002\u3067\u3082\u3001\u3042\u308b\u300e\u3042\u308b\u3053\u3068\u300f\u3092\u30c1\u30a7\u30c3\u30af\u3057\u305f\u4eba\u306f\u3001\u5b9f\u969b\u306e1-0\u3068\u3044\u3046\u30b9\u30b3\u30a2\u3092\u307b\u307c\u4e88\u6e2c\u3067\u304d\u305f\u3093\u3067\u3059\u3002",
