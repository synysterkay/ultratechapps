{
  "subject": "\u0935\u0939 \u092b\u0940\u091a\u0930 \u091c\u094b 90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0928\u0947 \u091b\u094b\u0921\u093c \u0926\u093f\u092f\u093e",
  "preview_text": "\u0906\u092a\u0915\u0947 \u0939\u0947\u0921\u092b\u094b\u0928\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u091c\u093e\u0926\u0942 \u0939\u0948, \u091c\u094b \u0906\u092a\u0928\u0947 \u0905\u092c \u0924\u0915 \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u093e\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947 \u092f\u0939 \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947, \u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0906\u092a\u0928\u0947 Loudify \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e, \u0932\u0947\u0915\u093f\u0928 \u0936\u093e\u092f\u0926 \u090f\u0915 \u0910\u0938\u093e \u092b\u0940\u091a\u0930 \u092e\u093f\u0938 \u0915\u0930 \u0926\u093f\u092f\u093e \u091c\u094b \u0938\u092c\u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0915\u093e\u092e \u0915\u093e \u0939\u0948\u0964 \u092e\u0948\u0902 \u091c\u093e\u0928\u0924\u093e \u0939\u0942\u0901, \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u0938\u092c \u0915\u0941\u091b \u090f\u0915\u094d\u0938\u092a\u094d\u0932\u094b\u0930 \u0915\u0930\u0928\u093e \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u092f\u0915\u0940\u0928 \u092e\u093e\u0928\u093f\u090f, \u092f\u0939 \u092b\u0940\u091a\u0930 \u0906\u092a\u0915\u0947 \u0939\u0947\u0921\u092b\u094b\u0928\u094d\u0938 \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u091f\u094d\u092f\u0942\u0928 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u091d\u0902\u091d\u091f \u0915\u0947\u0964",
    "\u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0907\u0938\u0947 \u0907\u0917\u094d\u0928\u094b\u0930 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0909\u0928\u094d\u0939\u0947\u0902 \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u093e \u0939\u0940 \u0915\u093e\u092b\u0940 \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932\u0940 \u092e\u0948\u091c\u093f\u0915 \u0924\u092c \u0939\u094b\u0924\u093e \u0939\u0948 \u091c\u092c \u0906\u092a \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u094b\u0928\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0938\u0947\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092e\u0947\u091f\u094d\u0930\u094b \u0915\u093e \u0936\u094b\u0930, \u0921\u093e\u092f\u0932\u0949\u0917 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c\u2014\u0938\u092c \u0915\u0941\u091b \u0938\u093e\u092b \u0914\u0930 \u0932\u093e\u0909\u0921, \u091c\u0939\u093e\u0901 \u091c\u093c\u0930\u0942\u0930\u0924 \u0939\u0948\u0964 \u092f\u0939 \u0915\u094b\u0908 \u0938\u093e\u0927\u093e\u0930\u0923 \u092c\u0942\u0938\u094d\u091f\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948; \u092f\u0939 \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924\u094b\u0902 \u0915\u094b \u0938\u092e\u091d\u0924\u093e \u0939\u0948\u0964",
    "Loudify \u092e\u0947\u0902 \u090f\u0915 \u0939\u093f\u0921\u0928 \u092b\u0940\u091a\u0930 \u0939\u0948: AutoEQ \u091c\u094b \u0906\u092a\u0915\u0947 \u0939\u0947\u0921\u092b\u094b\u0928\u094d\u0938 \u0915\u094b \u092a\u0939\u091a\u093e\u0928\u0924\u093e \u0939\u0948 \u0914\u0930 \u0909\u0928\u094d\u0939\u0947\u0902 \u0924\u0941\u0930\u0902\u0924 \u091f\u094d\u092f\u0942\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0938\u0947\u091f \u0915\u0930\u0947\u0902, \u0914\u0930 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0906\u092a \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902\u0917\u0947, \u092f\u0939 \u0911\u091f\u094b\u092e\u0948\u091f\u093f\u0915\u0932\u0940 \u0915\u093e\u092e \u0915\u0930\u0947\u0917\u093e\u0964 \u0915\u094b\u0908 \u0938\u0947\u091f\u093f\u0902\u0917 \u092c\u0926\u0932\u0928\u0947 \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902\u0964 \u092f\u0939 \u0935\u0939 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b 90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u092e\u093f\u0938 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u092f\u0939\u0940 \u0906\u092a\u0915\u0947 \u0939\u0947\u0921\u092b\u094b\u0928\u094d\u0938 \u0915\u094b \u0905\u0932\u0917 \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0907\u0938\u0947 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902: Loudify \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 'AutoEQ' \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u091c\u093e\u090f\u0901\u0964 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u094b\u0928\u094d\u0938 \u0915\u093e \u092e\u0949\u0921\u0932 \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u092b\u0930\u094d\u0915 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0947\u0902\u0964 \u0905\u0917\u0930 \u0906\u092a \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u092f\u0939 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u092e\u0941\u092b\u094d\u0924 \u0939\u0948\u0964 P.S. \u0905\u0917\u0930 \u0906\u092a\u0915\u094b \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u0947 \u0939\u0947\u0921\u092b\u094b\u0928\u094d\u0938 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0905\u092c \u0924\u0915 \u0938\u0939\u0940 \u0928\u0939\u0940\u0902 \u0925\u0940, \u0924\u094b \u092f\u0939 \u0906\u092a\u0915\u093e \u092e\u094c\u0915\u093e \u0939\u0948\u0964"
  ],
