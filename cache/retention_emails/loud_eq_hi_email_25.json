{
  "subject": "\u0935\u094b \u0906\u0926\u092e\u0940 \u091c\u093f\u0938\u0928\u0947 \u0905\u092a\u0928\u0940 \u092c\u093f\u0932\u094d\u0932\u0940 \u0915\u0947 \u0932\u093f\u090f \u0910\u092a \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e",
  "preview_text": "\u090f\u0915 \u092f\u0942\u091c\u0930 \u0928\u0947 \u0939\u092e\u0947\u0902 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0935\u0939 \u0905\u092a\u0928\u0940 \u092c\u093f\u0932\u094d\u0932\u0940 \u0915\u094b \u0936\u093e\u0902\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f Loud EQ \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0906\u092a \u092d\u0940 \u0915\u0941\u091b \u0910\u0938\u093e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",
  "body_paragraphs": [
    "\u090f\u0915 \u092f\u0942\u091c\u0930 \u0928\u0947 \u0939\u092e\u0947\u0902 \u0908\u092e\u0947\u0932 \u0915\u093f\u092f\u093e\u0964 \u0909\u0938\u0928\u0947 \u0932\u093f\u0916\u093e \u0925\u093e, '\u092e\u0948\u0902 \u0905\u092a\u0928\u0940 \u092c\u093f\u0932\u094d\u0932\u0940 \u0915\u094b \u0936\u093e\u0902\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u093e \u0910\u092a \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u093e \u0939\u0942\u0901\u0964 \u0924\u0947\u091c\u093c \u0906\u0935\u093e\u091c\u093c \u0938\u0947 \u0935\u0939 \u0921\u0930 \u091c\u093e\u0924\u0940 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0906\u092a\u0915\u0947 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u0938\u0947 \u092e\u0948\u0902 \u0909\u0938\u0947 \u0938\u093f\u0930\u094d\u092b\u093c \u0935\u094b \u0906\u0935\u093e\u091c\u093c \u0938\u0941\u0928\u093e\u0924\u093e \u0939\u0942\u0901 \u091c\u094b \u0909\u0938\u0947 \u092a\u0938\u0902\u0926 \u0939\u0948\u0964' \u092e\u0948\u0902 \u0939\u0901\u0938 \u092a\u0921\u093c\u093e\u0964 \u092b\u093f\u0930 \u0938\u094b\u091a\u093e\u2014\u092f\u0939 \u0924\u094b \u0936\u093e\u0928\u0926\u093e\u0930 \u0906\u0907\u0921\u093f\u092f\u093e \u0939\u0948\u0964",
    "\u0906\u092a \u0936\u093e\u092f\u0926 \u0905\u092a\u0928\u0940 \u092c\u093f\u0932\u094d\u0932\u0940 \u0915\u0947 \u0932\u093f\u090f \u0910\u092a \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0928 \u0915\u0930\u0947\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u092c\u093e\u0924 \u091c\u093c\u0930\u0942\u0930 \u0939\u0948: Loud EQ \u0938\u093f\u0930\u094d\u092b\u093c \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b \u0939\u0930 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0915\u094d\u0932\u093f\u092f\u0930 \u0914\u0930 \u0915\u0902\u092b\u0930\u094d\u091f\u0947\u092c\u0932 \u092c\u0928\u093e\u0928\u0947 \u0915\u093e \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u091a\u093e\u0939\u0947 \u0906\u092a \u091f\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u0939\u094b\u0902, \u0915\u093e\u0930 \u092e\u0947\u0902 \u0939\u094b\u0902, \u092f\u093e \u0918\u0930 \u092a\u0930\u2014\u0906\u092a \u0924\u092f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0915\u094d\u092f\u093e \u0938\u0941\u0928\u0928\u093e \u0939\u0948 \u0914\u0930 \u0915\u0948\u0938\u0947 \u0938\u0941\u0928\u0928\u093e \u0939\u0948\u0964",
    "\u0939\u092e\u0928\u0947 \u0907\u0938\u0947 '\u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c' \u092b\u0940\u091a\u0930 \u0915\u0947 \u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e \u0925\u093e\u0964 \u090f\u0915 \u091f\u0948\u092a \u0938\u0947 \u0910\u092a \u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0914\u0930 \u0907\u092f\u0930\u092b\u093c\u094b\u0928 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0938\u0947\u091f\u093f\u0902\u0917 \u092c\u0926\u0932 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u091c\u0948\u0938\u0947 \u0909\u0938 \u092f\u0942\u091c\u0930 \u0928\u0947 \u0926\u093f\u0916\u093e\u092f\u093e\u2014\u0906\u092a \u0907\u0938\u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u0938 \u0910\u092a \u0916\u094b\u0932\u0947\u0902, \u090f\u0915 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u091a\u0941\u0928\u0947\u0902, \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0915\u0948\u0938\u0947 \u0939\u0930 \u091a\u0940\u091c\u093c \u0938\u093e\u092b\u093c \u0914\u0930 \u0938\u0941\u0915\u0942\u0928 \u092d\u0930\u0940 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964",
    "\u0906\u091c \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902: \u0905\u092a\u0928\u0947 \u092b\u093c\u094b\u0928 \u092a\u0930 \u0915\u094b\u0908 \u0911\u0921\u093f\u092f\u094b \u091a\u0932\u093e\u090f\u0901, Loud EQ \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f' \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u091a\u0941\u0928\u0947\u0902\u0964 \u092b\u093f\u0930 \u092c\u0924\u093e\u090f\u0901\u2014\u0915\u094d\u092f\u093e \u092f\u0939 \u092a\u0939\u0932\u0947 \u0938\u0947 \u092c\u0947\u0939\u0924\u0930 \u0932\u0917\u0924\u093e \u0939\u0948? P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u094b 200% \u0924\u0915 \u092c\u0942\u0938\u094d\u091f \u0914\u0930 \u092a\u093e\u0901\u091a \u092c\u0948\u0902\u0921 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u092b\u094d\u0930\u0940 \u0935\u0930\u094d\u091c\u093c\u0928 \u092d\u0940 \u0906\u092a\u0915\u094b \u0935\u094b \u0915\u094d\u0932\u093f\u092f\u0930\u093f\u091f\u0940 \u0926\u0947 \u0938\u0915\u0924\u093e \u0939\u0948 \u091c\u093f\u0938\u0915\u0940 \u0906\u092a\u0915\u094b \u091c\u093c\u0930\u0942\u0930\u0924 \u0939\u0948\u0964"
  ],
