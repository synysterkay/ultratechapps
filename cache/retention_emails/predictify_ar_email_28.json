{
  "subject": "\u0644\u064a\u0644\u0629 \u0627\u0644\u062f\u064a\u0631\u0628\u064a: \u062a\u0648\u0642\u0639\u0646\u0627 73% \u0641\u0648\u0632 \u0644\u0644\u0647\u0644\u0627\u0644",
  "preview_text": "\u0642\u0628\u0644 \u0633\u0627\u0639\u0627\u062a \u0645\u0646 \u0627\u0646\u0637\u0644\u0627\u0642 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u0643\u0628\u0631\u0649\u060c \u062a\u062d\u0644\u064a\u0644\u0646\u0627 \u064a\u0639\u0637\u064a \u0627\u0644\u0647\u0644\u0627\u0644 \u0641\u0631\u0635\u0629 73% \u0644\u0644\u0641\u0648\u0632. \u0627\u062f\u062e\u0644 \u0648\u0634\u0648\u0641 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644.",
  "body_paragraphs": [
    "\u0642\u0628\u0644 \u0633\u0627\u0639\u0627\u062a \u0645\u0646 \u062f\u064a\u0631\u0628\u064a \u0627\u0644\u0631\u064a\u0627\u0636\u060c \u0627\u0644\u062c\u0645\u064a\u0639 \u064a\u062a\u062d\u062f\u062b \u0639\u0646 \u0627\u0644\u062d\u062f\u0633 \u0648\u0627\u0644\u0645\u0634\u0627\u0639\u0631. \u0644\u0643\u0646 \u0639\u0646\u062f\u0646\u0627 \u0641\u064a Predictify\u060c \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u062a\u062a\u0643\u0644\u0645: \u062a\u062d\u0644\u064a\u0644\u0646\u0627 \u064a\u0639\u0637\u064a \u0627\u0644\u0647\u0644\u0627\u0644 \u0641\u0631\u0635\u0629 73% \u0644\u0644\u0641\u0648\u0632 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 15 \u0645\u062a\u063a\u064a\u0631\u0627\u064b \u0645\u0646 \u0622\u062e\u0631 10 \u0645\u0648\u0627\u062c\u0647\u0627\u062a. \u0647\u0630\u0627 \u0644\u064a\u0633 \u062a\u062e\u0645\u064a\u0646\u0627\u064b\u060c \u0647\u0630\u0627 \u0639\u0644\u0645.",
    "\u0623\u0646\u062a \u062a\u0639\u0631\u0641 \u0634\u0639\u0648\u0631 \u0627\u0644\u0641\u0631\u062d\u0629 \u0644\u0645\u0627 \u062a\u062a\u0648\u0642\u0639 \u0635\u062d \u0642\u062f\u0627\u0645 \u0623\u0635\u062d\u0627\u0628\u0643. \u0647\u0627\u0644\u0645\u0631\u0629\u060c \u0644\u0627 \u062a\u062e\u0644\u064a \u0627\u0644\u062d\u062f\u0633 \u064a\u062e\u0630\u0644\u0643. \u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u062d\u0642\u0646\u0627 \u0627\u0644\u0644\u064a \u064a\u062d\u0644\u0644 \u0622\u0644\u0627\u0641 \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0644\u0643\u0644 \u0645\u0628\u0627\u0631\u0627\u0629. \u0645\u0646 \u0646\u0633\u0628 \u0627\u0644\u0627\u0633\u062a\u062d\u0648\u0627\u0630 \u0625\u0644\u0649 \u0641\u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u0647\u062c\u0648\u0645\u2014\u0643\u0644 \u0634\u064a\u0621 \u0645\u062d\u0633\u0648\u0628 \u0639\u0634\u0627\u0646 \u062a\u0639\u0637\u064a \u062a\u0648\u0642\u0639\u0643 \u0628\u062b\u0642\u0629.",
    "\u0647\u0627\u0644\u0644\u064a\u0644\u0629\u060c \u0641\u064a\u0647 \u0645\u064a\u0632\u0629 \u0648\u062d\u062f\u0629 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u062a\u062e\u0644\u064a\u0643 \u0627\u0644\u0646\u062c\u0645 \u0628\u064a\u0646 \u0623\u0635\u062d\u0627\u0628\u0643: IQ Quiz. \u0627\u062e\u062a\u0628\u0631 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0643 \u0627\u0644\u0643\u0631\u0648\u064a\u0629 \u0636\u062f \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a\u060c \u0648\u0635\u0639\u062f \u0641\u064a \u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u062a\u0635\u062f\u0631\u064a\u0646. \u0623\u0648 \u0627\u062f\u062e\u0644 Communities \u0648\u0635\u0648\u062a \u0639\u0644\u0649 Prediction of the Day\u2014\u0634\u0648\u0641 \u0622\u0631\u0627\u0621 \u0627\u0644\u0645\u0634\u062c\u0639\u064a\u0646 \u0648\u062e\u0644\u064a \u062a\u0648\u0642\u0639\u0643 \u0647\u0648 \u0627\u0644\u0635\u062d.",
    "\u0627\u062f\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062d\u064a\u0646 \u0648\u0634\u0648\u0641 \u0627\u0644\u062a\u0648\u0642\u0639 \u0627\u0644\u0643\u0627\u0645\u0644. \u0644\u0627 \u062a\u0641\u0648\u062a \u0627\u0644\u0641\u0631\u0635\u0629 \u062a\u0643\u0648\u0646 \u0623\u0630\u0643\u0649 \u0645\u0634\u062c\u0639 \u0641\u064a \u0627\u0644\u063a\u0631\u0641\u0629. P.S. \u0644\u0648 \u062a\u0628\u063a\u0649 \u0643\u0644 \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a \u0648\u0627\u0644\u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629\u060c \u062c\u0631\u0628 Premium \u0644\u0645\u062f\u0629 3 \u0623\u064a\u0627\u0645 \u0645\u062c\u0627\u0646\u0627\u064b\u2014\u0628\u0640 12.99 \u062f\u0648\u0644\u0627\u0631 \u0634\u0647\u0631\u064a\u0627\u064b \u0628\u0639\u062f\u0647\u0627. \u0628\u0633 \u0639\u062c\u0644\u060c \u0627\u0644\u062f\u064a\u0631\u0628\u064a \u0645\u0627 \u064a\u0646\u062a\u0638\u0631."
