{
  "subject": "\u0627\u0639\u062a\u0631\u0627\u0641 \u0635\u0627\u062f\u0642: \u0647\u0630\u0627 \u0627\u0644\u062e\u0637\u0623 \u0643\u0627\u0646 \u0633\u064a\u062f\u0645\u0631 \u0627\u0644\u062a\u0637\u0628\u064a\u0642",
  "preview_text": "\u0644\u0648\u0644\u0627 \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0645\u062b\u0644\u0643\u060c \u0644\u0643\u0627\u0646 Predictify \u0645\u062c\u0631\u062f \u0641\u0643\u0631\u0629 \u0641\u064a \u0633\u0644\u0629 \u0627\u0644\u0645\u0647\u0645\u0644\u0627\u062a. \u0647\u0630\u0647 \u0642\u0635\u062a\u0646\u0627 \u0627\u0644\u0643\u0627\u0645\u0644\u0629.",
  "body_paragraphs": [
    "\u0633\u0623\u0642\u0648\u0644\u0647\u0627 \u0628\u0635\u0631\u0627\u062d\u0629: \u0642\u0628\u0644 \u0633\u0646\u0629 \u062a\u0642\u0631\u064a\u0628\u0627\u064b\u060c \u0643\u062f\u062a \u0623\u062a\u062e\u0644\u0649 \u0639\u0646 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0643\u0644\u0647. \u0633\u0627\u0639\u0627\u062a \u0644\u0627 \u062a\u0646\u062a\u0647\u064a \u0645\u0646 \u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u0623\u0643\u0648\u0627\u062f\u060c \u0648\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\u060c \u0648\u0627\u0644\u0634\u0639\u0648\u0631 \u0628\u0623\u0646\u0643 \u062a\u0628\u0646\u064a \u0634\u064a\u0626\u0627\u064b \u0644\u0627 \u064a\u0647\u0645 \u0623\u062d\u062f\u0627\u064b. \u062b\u0645 \u0641\u062a\u062d\u062a \u0627\u0644\u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a \u064a\u0648\u0645\u0627\u064b \u0648\u0631\u0623\u064a\u062a \u0623\u0648\u0644 \u0645\u0633\u062a\u062e\u062f\u0645 \u062d\u0642\u064a\u0642\u064a \u064a\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0639\u0634\u0631\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u062a \u0641\u064a \u0623\u0633\u0628\u0648\u0639 \u0648\u0627\u062d\u062f.",
    "\u0641\u064a \u062a\u0644\u0643 \u0627\u0644\u0644\u062d\u0638\u0629 \u0641\u0647\u0645\u062a \u0627\u0644\u0645\u0639\u0646\u0649 \u0627\u0644\u062d\u0642\u064a\u0642\u064a. \u0623\u0646\u062a \u0648\u0623\u0645\u062b\u0627\u0644\u0643 \u0644\u0645 \u062a\u0643\u0648\u0646\u0648\u0627 \u0645\u062c\u0631\u062f \u0623\u0631\u0642\u0627\u0645 \u0641\u064a \u062c\u062f\u0648\u0644. \u0643\u0646\u062a\u0645 \u0627\u0644\u062f\u0644\u064a\u0644 \u0639\u0644\u0649 \u0623\u0646 \u0627\u0644\u0641\u0643\u0631\u0629 \u062a\u0633\u062a\u062d\u0642 \u0627\u0644\u0639\u0646\u0627\u0621. \u0623\u0646 \u0647\u0646\u0627\u0643 \u0645\u0646 \u064a\u062a\u0623\u0644\u0645 \u0645\u0646 \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a \u0627\u0644\u0639\u0634\u0648\u0627\u0626\u064a\u0629 \u0648\u0645\u0646 \u064a\u0631\u064a\u062f \u0623\u0646 \u064a\u0641\u0647\u0645 \u0627\u0644\u0644\u0639\u0628\u0629 \u0628\u0639\u0645\u0642. \u0643\u0644 \u062a\u0646\u0628\u0624 \u062f\u0642\u064a\u0642 \u062a\u0631\u0627\u0647\u060c \u0643\u0644 \u0625\u062d\u0635\u0627\u0626\u064a\u0629\u060c \u0643\u0644 \u062a\u062d\u0644\u064a\u0644 \u062a\u0643\u062a\u064a\u0643\u064a \u2013 \u0645\u0648\u062c\u0648\u062f \u0644\u0623\u0646\u0643 \u0642\u0631\u0631\u062a \u0623\u0646 \u062a\u0639\u0637\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u0631\u0635\u0629.",
    "\u0644\u0647\u0630\u0627 \u0627\u0644\u0633\u0628\u0628 \u0628\u0627\u0644\u0630\u0627\u062a\u060c \u0631\u0643\u0632\u0646\u0627 \u0639\u0644\u0649 \u0645\u064a\u0632\u0629 '\u0646\u0642\u0627\u0637 \u0627\u0644\u062b\u0642\u0629' \u0628\u062c\u0627\u0646\u0628 \u0643\u0644 \u062a\u0648\u0642\u0639. \u0644\u0623\u0646\u0643 \u062a\u0633\u062a\u062d\u0642 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0645\u062c\u0631\u062f \u0631\u0642\u0645. \u062a\u0633\u062a\u062d\u0642 \u0623\u0646 \u062a\u0639\u0631\u0641 \u0643\u0645 \u064a\u0645\u0643\u0646\u0643 \u0623\u0646 \u062a\u062b\u0642 \u0641\u064a \u062a\u062d\u0644\u064a\u0644\u0646\u0627\u060c \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0622\u0644\u0627\u0641 \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0645\u0646 \u0642\u0648\u0629 \u0627\u0644\u062f\u0641\u0627\u0639 \u0625\u0644\u0649 xG \u0644\u0644\u0627\u0639\u0628\u064a\u0646. \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0647\u064a \u062c\u0648\u0647\u0631 \u0645\u0627 \u064a\u0645\u064a\u0632\u0646\u0627: \u0627\u0644\u0634\u0641\u0627\u0641\u064a\u0629 \u0627\u0644\u0645\u0637\u0644\u0642\u0629.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0634\u0627\u0647\u062f \u062a\u0648\u0642\u0639\u0627\u062a \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0647\u0630\u0627 \u0627\u0644\u0623\u0633\u0628\u0648\u0639. \u0627\u0646\u0638\u0631 \u0625\u0644\u0649 \u0646\u0642\u0627\u0637 \u0627\u0644\u062b\u0642\u0629 \u0628\u062c\u0627\u0646\u0628 \u0643\u0644 \u0646\u062a\u064a\u062c\u0629 \u0645\u062d\u062a\u0645\u0644\u0629. \u0633\u062a\u063a\u064a\u0631 \u0637\u0631\u064a\u0642\u0629 \u0646\u0638\u0631\u062a\u0643 \u0644\u0644\u062a\u0646\u0628\u0624\u0627\u062a \u0625\u0644\u0649 \u0627\u0644\u0623\u0628\u062f. P.S.: \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u062a\u0627\u0628\u0639\u0648\u0646 \u0646\u0642\u0627\u0637 \u0627\u0644\u062b\u0642\u0629 \u064a\u0628\u0644\u063a\u0648\u0646 \u0639\u0646 \u062f\u0642\u0629 \u062a\u0648\u0642\u0639\u0627\u062a \u0623\u0639\u0644\u0649 \u0628\u0646\u0633\u0628\u0629 73%. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0635\u062f\u0641\u0629.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0634\u0627\u0647\u062f \u062a\u0648\u0642\u0639\u0627\u062a \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0647\u0630\u0627 \u0627\u0644\u0623\u0633\u0628\u0648\u0639. \u0627\u0646\u0638\u0631 \u0625\u0644\u0649 \u0646\u0642\u0627\u0637 \u0627\u0644\u062b\u0642\u0629 \u0628\u062c\u0627\u0646\u0628 \u0643\u0644 \u0646\u062a\u064a\u062c\u0629 \u0645\u062d\u062a\u0645\u0644\u0629. \u0633\u062a\u063a\u064a\u0631 \u0637\u0631\u064a\u0642\u0629 \u0646\u0638\u0631\u062a\u0643 \u0644\u0644\u062a\u0646\u0628\u0624\u0627\u062a \u0625\u0644\u0649 \u0627\u0644\u0623\u0628\u062f. P.S.: \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u062a\u0627\u0628\u0639\u0648\u0646 \u0646\u0642\u0627\u0637 \u0627\u0644\u062b\u0642\u0629 \u064a\u0628\u0644\u063a\u0648\u0646 \u0639\u0646 \u062f\u0642\u0629 \u062a\u0648\u0642\u0639\u0627\u062a \u0623\u0639\u0644\u0649 \u0628\u0646\u0633\u0628\u0629 73%. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0635\u062f\u0641\u0629."
  ],
