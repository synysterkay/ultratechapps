{
  "subject": "\u042f \u0437\u0440\u043e\u0431\u0438\u0432 \u0432\u0435\u043b\u0438\u0447\u0435\u0437\u043d\u0443 \u043f\u043e\u043c\u0438\u043b\u043a\u0443 \u0437 \u0446\u0438\u043c \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u043c",
  "preview_text": "\u0414\u0443\u043c\u0430\u0432, \u0449\u043e \u044f \u0432\u0436\u0435 \u0432\u0441\u0435 \u0437\u043d\u0430\u044e \u043f\u0440\u043e \u0444\u0443\u0442\u0431\u043e\u043b. \u0410\u043b\u0435 \u043f\u0456\u0441\u043b\u044f 53 \u0434\u043d\u0456\u0432 \u0437 Predictify \u0441\u043e\u0440\u043e\u043c\u043d\u043e \u0437\u0433\u0430\u0434\u0443\u0432\u0430\u0442\u0438, \u044f\u043a \u044f \u0433\u0440\u0430\u0432 \u043d\u0430\u043e\u0441\u043b\u0456\u043f.",
  "body_paragraphs": [
    "\u0421\u043b\u0443\u0445\u0430\u0439, \u044f \u043d\u0435 \u0445\u043e\u0442\u0456\u0432 \u0446\u044c\u043e\u0433\u043e \u043f\u0438\u0441\u0430\u0442\u0438. \u0410\u043b\u0435 53 \u0434\u043d\u0456 \u0442\u043e\u043c\u0443 \u044f \u0434\u0443\u043c\u0430\u0432, \u0449\u043e \u044f \u0435\u043a\u0441\u043f\u0435\u0440\u0442 \u0437 \u0444\u0443\u0442\u0431\u043e\u043b\u0443. \u0421\u0432\u043e\u0457 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438 \u044f \u0431\u0443\u0434\u0443\u0432\u0430\u0432 \u043d\u0430 '\u0432\u0456\u0434\u0447\u0443\u0442\u0442\u0456', \u043d\u0430 \u0442\u043e\u043c\u0443, \u0449\u043e '\u041b\u0456\u0432\u0435\u0440\u043f\u0443\u043b\u044c \u0437\u0430\u0440\u0430\u0437 \u0443 \u0444\u043e\u0440\u043c\u0456'. \u0406 \u0437\u043d\u0430\u0454\u0448 \u0449\u043e? \u042f \u0432\u0442\u0440\u0430\u0447\u0430\u0432 \u0433\u0440\u043e\u0448\u0456, \u043d\u0435\u0440\u0432\u0438 \u0456 \u0447\u0430\u0441. \u041f\u043e\u0442\u0456\u043c \u044f \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0432 Predictify \u0456 \u0437\u0440\u043e\u0437\u0443\u043c\u0456\u0432, \u043d\u0430\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u044f \u0431\u0443\u0432 \u0441\u043b\u0456\u043f\u0438\u043c.",
    "\u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0434\u0438\u0432\u0438\u0432\u0441\u044f \u043d\u0430 \u043c\u0430\u0442\u0447 \u0456 \u0434\u0443\u043c\u0430\u0432: '\u041d\u0443, \u041c\u0430\u043d \u0421\u0456\u0442\u0456 \u043c\u0430\u0454 \u0432\u0438\u0433\u0440\u0430\u0442\u0438'. \u0422\u0435\u043f\u0435\u0440 \u044f \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u044e \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0456 \u0431\u0430\u0447\u0443: xG, \u043e\u0431\u043e\u0440\u043e\u043d\u043d\u0430 \u0441\u043b\u0430\u0431\u043a\u0456\u0441\u0442\u044c \u0441\u0443\u043f\u0435\u0440\u043d\u0438\u043a\u0430, \u0456\u0441\u0442\u043e\u0440\u0456\u044f \u043e\u0447\u043d\u0438\u0445 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0435\u0439. \u0406 \u043c\u043e\u0457 \u0441\u0442\u0430\u0432\u043a\u0438 \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435 \u0441\u0445\u043e\u0436\u0456 \u043d\u0430 \u043b\u043e\u0442\u0435\u0440\u0435\u044e. \u0420\u0456\u0437\u043d\u0438\u0446\u044f \u043c\u0456\u0436 '\u0434\u043e' \u0456 '\u043f\u0456\u0441\u043b\u044f' \u2014 \u0446\u0435 \u0441\u043e\u0440\u043e\u043c\u043d\u043e, \u0447\u0435\u0441\u043d\u043e. \u042f \u043f\u043e\u0447\u0443\u0432\u0430\u044e\u0441\u044f \u0442\u0430\u043a, \u043d\u0456\u0431\u0438 \u0433\u0440\u0430\u0432 \u0443 \u0444\u0443\u0442\u0431\u043e\u043b \u0456\u0437 \u0437\u0430\u0432'\u044f\u0437\u0430\u043d\u0438\u043c\u0438 \u043e\u0447\u0438\u043c\u0430.",
    "\u041e\u0441\u044c \u0449\u043e \u044f \u0442\u043e\u0431\u0456 \u0440\u0430\u0434\u0436\u0443: \u0432\u0456\u0434\u043a\u0440\u0438\u0439 Predictify \u043f\u0440\u044f\u043c\u043e \u0437\u0430\u0440\u0430\u0437, \u043d\u0430\u0442\u0438\u0441\u043d\u0438 \u043d\u0430 \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u043c\u0430\u0442\u0447 \u0443 \u041f\u0440\u0456\u043c\u2019\u0454\u0440-\u043b\u0456\u0437\u0456 \u0430\u0431\u043e \u041b\u0456\u0437\u0456 \u0447\u0435\u043c\u043f\u0456\u043e\u043d\u0456\u0432, \u0456 \u043f\u043e\u0434\u0438\u0432\u0438\u0441\u044f \u043d\u0430 AI \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0456\u0437 confidence score. \u041f\u043e\u0431\u0430\u0447\u0438\u0448, \u044f\u043a \u0434\u0430\u043d\u0456 \u0440\u0443\u0439\u043d\u0443\u044e\u0442\u044c \u043c\u0456\u0444\u0438. \u0406 \u044f\u043a\u0449\u043e \u0442\u0438 \u0449\u0435 \u043d\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0432\u0441\u044f AI Chat \u2014 \u0437\u0430\u043f\u0438\u0442\u0430\u0439 \u0449\u043e\u0441\u044c, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, '\u0427\u043e\u043c\u0443 \u0411\u0430\u0440\u0441\u0435\u043b\u043e\u043d\u0430 \u043f\u0440\u043e\u0433\u0440\u0430\u043b\u0430?' \u0456 \u043e\u0442\u0440\u0438\u043c\u0430\u0454\u0448 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c, \u044f\u043a\u0430 \u0437\u043c\u0456\u043d\u0438\u0442\u044c \u0442\u0432\u0456\u0439 \u043f\u043e\u0433\u043b\u044f\u0434 \u043d\u0430 \u0433\u0440\u0443.",
    "\u0412\u0456\u0434\u043a\u0440\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a, \u0437\u043d\u0430\u0439\u0434\u0438 \u043c\u0430\u0442\u0447 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456\u0448\u043d\u044c\u043e\u0433\u043e \u0434\u043d\u044f \u0456 \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u0439 \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0437 AI. \u0422\u0438 \u0431\u0443\u0434\u0435\u0448 \u0432\u0440\u0430\u0436\u0435\u043d\u0438\u0439, \u043d\u0430\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0442\u0438 \u043f\u043e\u043c\u0438\u043b\u044f\u0432\u0441\u044f. P.S. \u042f\u043a\u0449\u043e \u0445\u043e\u0447\u0435\u0448 \u0431\u0443\u0442\u0438 \u0440\u043e\u0437\u0443\u043c\u043d\u0456\u0448\u0438\u043c \u0437\u0430 90% \u0444\u0430\u043d\u0430\u0442\u0456\u0432 \u2014 \u0441\u043f\u0440\u043e\u0431\u0443\u0439 Premium \u043d\u0430 3 \u0434\u043d\u0456 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u043e. \u0412\u0430\u0440\u0442\u043e \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u0446\u0435\u043d\u0442\u0430."
