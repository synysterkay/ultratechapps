{
  "subject": "\u041c\u0456\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u043d\u0430 22-\u0433\u0443 \u0445\u0432\u0438\u043b\u0438\u043d\u0443 \u2014 67% \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u043e\u0441\u0442\u0456",
  "preview_text": "\u0422\u0438 \u0434\u043e\u0441\u0456 \u0432\u0433\u0430\u0434\u0443\u0454\u0448? \u041f\u043e\u0434\u0438\u0432\u0438\u0441\u044c, \u0449\u043e \u0431\u0443\u043b\u043e \u0434\u043e Predictify \u0456 \u043f\u0456\u0441\u043b\u044f. \u0420\u0456\u0437\u043d\u0438\u0446\u044f, \u044f\u043a\u0443 \u0441\u043e\u0440\u043e\u043c\u043d\u043e \u0432\u0438\u0437\u043d\u0430\u0442\u0438.",
  "body_paragraphs": [
    "\u041f\u0430\u043c'\u044f\u0442\u0430\u0454\u0448 \u0442\u0456 \u0432\u0435\u0447\u043e\u0440\u0438, \u043a\u043e\u043b\u0438 \u0442\u0438 \u0434\u0438\u0432\u0438\u0432\u0441\u044f \u043c\u0430\u0442\u0447 \u0456 \u0434\u0443\u043c\u0430\u0432: \u00ab\u041d\u0443, \u0437\u0430\u0440\u0430\u0437 \u0442\u043e\u0447\u043d\u043e \u0437\u0430\u0431'\u044e\u0442\u044c\u00bb? \u0410 \u043f\u043e\u0442\u0456\u043c \u2014 \u043d\u0456\u0447\u043e\u0433\u043e. \u0413\u043e\u043b\u0438\u0439 \u043d\u0443\u043b\u044c. \u0422\u0438 \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u0432, \u0441\u043f\u043e\u0434\u0456\u0432\u0430\u0432\u0441\u044f, \u043c\u043e\u043b\u0438\u0432\u0441\u044f \u043d\u0430 \u0456\u043d\u0442\u0443\u0457\u0446\u0456\u044e. \u0406 \u043f\u0440\u043e\u0433\u0440\u0430\u0432\u0430\u0432. \u0417\u043d\u043e\u0432\u0443 \u0456 \u0437\u043d\u043e\u0432\u0443. \u042f \u0442\u0435\u0436 \u0442\u0430\u043a \u0440\u043e\u0431\u0438\u0432. \u0406 \u0446\u0435 \u0431\u0443\u043b\u043e \u0442\u0443\u043f\u043e.",
    "\u0410 \u0442\u0435\u043f\u0435\u0440 \u0443\u044f\u0432\u0438: \u0442\u0438 \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454\u0448 Predictify, \u0431\u0430\u0447\u0438\u0448, \u0449\u043e AI \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0432 50 \u0437\u043c\u0456\u043d\u043d\u0438\u0445 \u2014 \u0444\u043e\u0440\u043c\u0443 \u043a\u043e\u043c\u0430\u043d\u0434, xG, \u0456\u0441\u0442\u043e\u0440\u0456\u044e \u043e\u0447\u043d\u0438\u0445 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0435\u0439, \u043d\u0430\u0432\u0456\u0442\u044c \u043f\u043e\u0433\u043e\u0434\u0443 \u043d\u0430 \u0441\u0442\u0430\u0434\u0456\u043e\u043d\u0456. \u0406 \u0432\u0438\u0434\u0430\u0454 \u0442\u043e\u0431\u0456 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0456\u0437 67% \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u043e\u0441\u0442\u0456. \u0422\u0438 \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435 \u0432\u0433\u0430\u0434\u0443\u0454\u0448. \u0422\u0438 \u0437\u043d\u0430\u0454\u0448. \u0420\u0456\u0437\u043d\u0438\u0446\u044f \u043c\u0456\u0436 \u00ab\u0434\u043e\u00bb \u0456 \u00ab\u043f\u0456\u0441\u043b\u044f\u00bb \u2014 \u0446\u0435 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043e\u0440\u043e\u043c\u043d\u043e. \u0426\u0435 \u043f\u0440\u0438\u043d\u0438\u0437\u043b\u0438\u0432\u043e. \u0411\u043e \u0442\u0438 \u043c\u0456\u0433 \u043c\u0430\u0442\u0438 \u0446\u0456 \u0434\u0430\u043d\u0456 \u0449\u0435 \u043c\u0456\u0441\u044f\u0446\u044c \u0442\u043e\u043c\u0443.",
    "\u0421\u043f\u0440\u043e\u0431\u0443\u0439 \u0437\u0430\u0440\u0430\u0437 \u0444\u0443\u043d\u043a\u0446\u0456\u044e \u00ab\u041f\u0440\u043e\u0433\u043d\u043e\u0437 \u0434\u043d\u044f\u00bb \u2014 AI \u043f\u043e\u043a\u0430\u0436\u0435 \u0442\u043e\u0431\u0456, \u044f\u043a\u0456 \u043c\u0430\u0442\u0447\u0456 \u0432\u0430\u0440\u0442\u0456 \u0443\u0432\u0430\u0433\u0438, \u0430 \u044f\u043a\u0456 \u2014 \u043d\u0456. \u0422\u0438 \u043f\u043e\u0431\u0430\u0447\u0438\u0448, \u044f\u043a \u0442\u0432\u043e\u0457 \u00ab\u0437\u0434\u043e\u0433\u0430\u0434\u0438\u00bb \u043f\u0435\u0440\u0435\u0442\u0432\u043e\u0440\u044e\u044e\u0442\u044c\u0441\u044f \u043d\u0430 \u0442\u043e\u0447\u043d\u0456 \u0447\u0438\u0441\u043b\u0430. \u0406 \u044f\u043a\u0449\u043e \u0437\u0430\u0445\u043e\u0447\u0435\u0448 \u0431\u0456\u043b\u044c\u0448\u0435 \u2014 Premium \u0432\u0456\u0434\u043a\u0440\u0438\u0454 \u0432\u0441\u0456 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438, \u0431\u0435\u0437 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u044c. \u0410\u043b\u0435 \u043f\u043e\u0447\u043d\u0438 \u0437 \u043e\u0434\u043d\u043e\u0433\u043e \u043a\u043b\u0456\u043a\u0443.",
    "\u0412\u0456\u0434\u043a\u0440\u0438\u0439 Predictify \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u0440\u0430\u0437. \u041f\u043e\u0434\u0438\u0432\u0438\u0441\u044c \u043d\u0430 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0434\u043b\u044f \u043d\u0430\u0439\u0431\u043b\u0438\u0436\u0447\u043e\u0433\u043e \u043c\u0430\u0442\u0447\u0443. \u041f\u043e\u0442\u0456\u043c \u0441\u043a\u0430\u0436\u0438 \u043c\u0435\u043d\u0456, \u0447\u0438 \u043d\u0435 \u0441\u043e\u0440\u043e\u043c\u043d\u043e \u0442\u043e\u0431\u0456, \u0449\u043e \u0442\u0438 \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u0432 \u0440\u0430\u043d\u0456\u0448\u0435.\n\nP.S. \u0414\u043e \u0440\u0435\u0447\u0456, \u0442\u0432\u0456\u0439 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e IQ-\u0442\u0435\u0441\u0442\u0443 \u0449\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u0439. \u0421\u043f\u0440\u043e\u0431\u0443\u0439 \u043e\u0431\u0456\u0433\u0440\u0430\u0442\u0438 AI \u2014 \u0456 \u043f\u043e\u0431\u0430\u0447\u0438\u0448, \u043d\u0430\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0442\u0432\u043e\u044f \u00ab\u0456\u043d\u0442\u0443\u0457\u0446\u0456\u044f\u00bb \u0434\u0430\u043b\u0435\u043a\u0430 \u0432\u0456\u0434 \u0434\u0430\u043d\u0438\u0445."
  ],
