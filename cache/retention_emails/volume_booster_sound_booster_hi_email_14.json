{
  "subject": "30 \u0926\u093f\u0928 \u092e\u0947\u0902 5000 \u0928\u090f \u0932\u094b\u0917",
  "preview_text": "\u0924\u0941\u092e \u0905\u0915\u0947\u0932\u0947 \u0928\u0939\u0940\u0902 \u0939\u094b\u0964 \u0939\u0930 \u0926\u093f\u0928 \u0939\u091c\u093e\u0930\u094b\u0902 \u0932\u094b\u0917 \u0905\u092a\u0928\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u090a\u0902\u091a\u093e \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0915\u094d\u092f\u093e \u0924\u0941\u092e\u0928\u0947 \u0906\u091c \u0905\u092a\u0928\u093e \u092c\u0942\u0938\u094d\u091f \u0915\u093f\u092f\u093e?",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 30 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902, 5000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u091c\u0941\u0921\u093c\u0915\u0930 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0928\u0908 \u090a\u0902\u091a\u093e\u0908 \u0926\u0940 \u0939\u0948\u0964 \u0924\u0941\u092e \u092d\u0940 \u0905\u092c \u0907\u0938 \u091f\u0940\u092e \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u094b\u0964 \u0935\u094b \u0932\u094b\u0917 \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0938\u0941\u0928\u0924\u0947 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0939\u0930 \u092c\u0940\u091f, \u0939\u0930 \u0936\u092c\u094d\u0926, \u0939\u0930 \u0927\u0941\u0928 \u0915\u094b \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0939\u092e \u0938\u092c \u090f\u0915 \u0939\u0940 \u092c\u093e\u0924 \u0938\u0947 \u092a\u0930\u0947\u0936\u093e\u0928 \u0925\u0947: \u092b\u094b\u0928 \u0915\u0940 \u0915\u092e \u0906\u0935\u093e\u091c\u093c, \u092c\u0947\u091c\u093e\u0928 \u0938\u094d\u092a\u0940\u0915\u0930, \u0914\u0930 \u0935\u094b \u0928\u093f\u0930\u093e\u0936\u093e \u091c\u092c \u0924\u0941\u092e \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u0947 \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u093e\u0915\u0924 \u0938\u0947 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928 \u092a\u093e\u0924\u0947\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u092c \u0939\u092e \u0905\u0932\u0917 \u0939\u0948\u0902\u0964 \u0939\u092e\u0928\u0947 Volume Booster - Sound Booster \u0915\u094b \u0905\u092a\u0928\u093e \u0939\u0925\u093f\u092f\u093e\u0930 \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964 \u0939\u0930 \u0926\u093f\u0928, \u0939\u091c\u093e\u0930\u094b\u0902 \u0932\u094b\u0917 \u0907\u0938\u0947 \u0916\u094b\u0932\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0905\u092a\u0928\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u094b \u0924\u0947\u091c\u093c \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u090f\u0915 \u0906\u0902\u0926\u094b\u0932\u0928 \u0939\u0948\u0964 \u091c\u092c \u0924\u0941\u092e Bass Booster \u0915\u094b \u0911\u0928 \u0915\u0930\u0924\u0947 \u0939\u094b, \u0924\u094b \u0924\u0941\u092e \u0938\u093f\u0930\u094d\u092b \u0906\u0935\u093e\u091c\u093c \u0928\u0939\u0940\u0902 \u092c\u0922\u093c\u093e\u0924\u0947, \u0924\u0941\u092e \u0905\u092a\u0928\u0947 \u0905\u0928\u0941\u092d\u0935 \u0915\u094b \u092c\u0926\u0932 \u0926\u0947\u0924\u0947 \u0939\u094b\u0964 \u0939\u092e\u093e\u0930\u093e \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0939\u0930 \u091c\u0949\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0926\u0947\u0924\u093e \u0939\u0948\u2014\u091a\u093e\u0939\u0947 \u0935\u094b \u0930\u0949\u0915 \u0939\u094b, \u091c\u0948\u091c\u093c \u0939\u094b, \u092f\u093e \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915\u0964 \u0924\u0941\u092e \u0905\u092c \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u0939\u094b \u091c\u094b \u0938\u092e\u091d\u094c\u0924\u093e \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964",
    "\u0906\u091c \u0939\u0940 \u090f\u0915 \u092c\u093e\u0930 \u0905\u092a\u0928\u093e Volume Booster - Sound Booster \u0916\u094b\u0932\u094b\u0964 \u092a\u0949\u092a \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u092a\u0930 \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u094b \u0914\u0930 \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u0947 \u0915\u094b \u0938\u0941\u0928\u094b\u0964 \u092b\u093f\u0930 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0913 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0915\u0948\u0938\u093e \u0932\u0917\u093e\u0964 P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0914\u0930 \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 EQ \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u2014\u0935\u094b \u092d\u0940 \u0909\u0938\u0940 \u091f\u0940\u092e \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u0948\u0902 \u091c\u094b \u0939\u0930 \u0926\u093f\u0928 \u0928\u0908 \u090a\u0902\u091a\u093e\u0907\u092f\u094b\u0902 \u0915\u094b \u091b\u0942 \u0930\u0939\u0940 \u0939\u0948\u0964"
