{
  "subject": "\u090f\u0915 \u0917\u0932\u0924\u0940 \u091c\u094b \u0939\u091c\u093e\u0930\u094b\u0902 \u0932\u094b\u0917 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902 - \u0906\u092a \u0928\u0939\u0940\u0902",
  "preview_text": "\u0906\u092a \u0905\u092c \u0909\u0938 \u091a\u0941\u0928\u093f\u0902\u0926\u093e \u0917\u094d\u0930\u0941\u092a \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u0948\u0902 \u091c\u094b \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u0905\u0932\u0917 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0938\u0941\u0928 \u0930\u0939\u093e \u0939\u0948\u0964 \u092f\u0939\u093e\u0902 \u092c\u0924\u093e\u0924\u093e \u0939\u0942\u0902 \u0915\u0948\u0938\u0947...",
  "body_paragraphs": [
    "\u0915\u0932 \u090f\u0915 \u0926\u094b\u0938\u094d\u0924 \u0928\u0947 \u0936\u093f\u0915\u093e\u092f\u0924 \u0915\u0940 \u0915\u093f \u0909\u0938\u0915\u093e \u0928\u092f\u093e \u0917\u093e\u0928\u093e \u092b\u094d\u0932\u0948\u091f \u0932\u0917 \u0930\u0939\u093e \u0939\u0948\u0964 \u092e\u0948\u0902\u0928\u0947 \u0909\u0938\u0915\u0947 \u092b\u094b\u0928 \u092a\u0930 Volume Booster \u0916\u094b\u0932\u093e \u0914\u0930 \u092c\u0938 \u090f\u0915 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091f\u0948\u092a \u0915\u093f\u092f\u093e\u0964 \u0909\u0938\u0915\u0940 \u0906\u0902\u0916\u0947\u0902 \u091a\u094c\u0921\u093c\u0940 \u0939\u094b \u0917\u0908\u0902 - '\u092f\u0939 \u0935\u0939\u0940 \u0917\u093e\u0928\u093e \u0939\u0948?'",
    "\u092f\u0939\u0940 \u0935\u0939 \u092a\u0932 \u0939\u0948 \u091c\u094b \u0939\u091c\u093e\u0930\u094b\u0902 \u092f\u0942\u091c\u0930\u094d\u0938 \u0939\u0930 \u0926\u093f\u0928 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a \u0905\u092c \u0909\u0938 \u091f\u094d\u0930\u093e\u0907\u092c \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u0948\u0902 \u091c\u094b \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u0940 \u0932\u093f\u092e\u093f\u091f \u0915\u094b \u0924\u094b\u0921\u093c\u0915\u0930 \u0938\u0941\u0928\u0924\u093e \u0939\u0948\u0964 \u091c\u094b \u092f\u0939 \u091c\u093e\u0928\u0924\u093e \u0939\u0948 \u0915\u093f \u092c\u0947\u0938 \u0938\u093f\u0930\u094d\u092b \u092c\u091c\u0928\u093e \u0928\u0939\u0940\u0902, \u092e\u0939\u0938\u0942\u0938 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u091c\u094b \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u0947 \u0939\u0930 \u0936\u092c\u094d\u0926 \u0915\u094b \u0928\u094b\u0907\u091c\u093c\u0940 \u092e\u0947\u091f\u094d\u0930\u094b \u092e\u0947\u0902 \u092d\u0940 \u0915\u0948\u091a \u0915\u0930 \u0932\u0947\u0924\u093e \u0939\u0948\u0964",
    "\u0906\u092a\u0915\u0947 \u0905\u0902\u0926\u0930 \u0915\u093e \u0911\u0921\u093f\u092f\u094b\u092b\u093e\u0907\u0932 \u091c\u093e\u0928\u0924\u093e \u0939\u0948 - \u0905\u0938\u0932\u0940 \u092e\u091c\u093e \u0924\u092c \u0906\u0924\u093e \u0939\u0948 \u091c\u092c \u0906\u092a EQ \u0915\u0947 '\u0930\u0949\u0915' \u092f\u093e '\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915' \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915\u094d\u0938\u092a\u0947\u0930\u093f\u092e\u0947\u0902\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0935\u0939 \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0939\u0948 \u091c\u094b \u0930\u0947\u0917\u0941\u0932\u0930 \u0932\u093f\u0938\u0928\u0930\u094d\u0938 \u0914\u0930 \u0939\u092e\u093e\u0930\u0947 \u091f\u094d\u0930\u093e\u0907\u092c \u092e\u0947\u0902 \u092b\u0930\u094d\u0915 \u0932\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 Volume Booster \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0935\u0939 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902 \u091c\u094b \u0906\u092a\u0915\u0940 \u092a\u0938\u0902\u0926 \u0915\u0947 \u091c\u0947\u0928\u0930 \u0915\u094b \u092a\u0930\u092b\u0947\u0915\u094d\u091f \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u0928\u092f\u093e \u0938\u093e \u0932\u0917\u0947\u0917\u093e\u0964 P.S. \u092e\u0947\u0930\u0947 \u092a\u093e\u0938 \u090f\u0915 \u0915\u0928\u094d\u092b\u0947\u0936\u0928 \u0939\u0948 - \u092e\u0948\u0902 \u0905\u0915\u094d\u0938\u0930 '\u0915\u094d\u0932\u093e\u0938\u093f\u0915\u0932' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u092a\u0930 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u0924\u093e \u0939\u0942\u0902\u0964 \u0935\u0949\u0907\u0938 \u0915\u094d\u0932\u0948\u0930\u093f\u091f\u0940 \u0907\u0924\u0928\u0940 \u0915\u094d\u0930\u093f\u0938\u094d\u092a \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948, \u0932\u0917\u0924\u093e \u0939\u0948 \u0938\u094d\u092a\u0940\u0915\u0930 \u0938\u093e\u092e\u0928\u0947 \u092c\u0948\u0920\u093e \u0939\u0948\u0964"
  ],
