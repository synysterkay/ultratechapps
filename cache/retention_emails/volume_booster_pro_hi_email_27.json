{
  "subject": "10,000 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u093e \u0921\u0947\u091f\u093e \u092c\u0924\u093e\u0924\u093e \u0939\u0948 \u090f\u0915 \u091a\u094c\u0902\u0915\u093e\u0928\u0947 \u0935\u093e\u0932\u093e \u0924\u0925\u094d\u092f",
  "preview_text": "\u0939\u092e\u0928\u0947 63 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u0906\u0902\u0915\u0921\u093c\u0947 \u0926\u0947\u0916\u0947\u2014\u0906\u092a \u092d\u0940 \u091c\u093e\u0928\u093f\u090f \u0935\u0939 \u0924\u0925\u094d\u092f \u091c\u094b 90% \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u0939\u0940\u0902 \u091c\u093e\u0928\u0924\u0947\u0964",
  "body_paragraphs": [
    "\u0939\u092e\u0928\u0947 10,000 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u0947 \u0921\u0947\u091f\u093e \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u093f\u092f\u093e\u0964 \u090f\u0915 \u091a\u0940\u091c\u093c \u0938\u093e\u092e\u0928\u0947 \u0906\u0908 \u091c\u093f\u0938\u0928\u0947 \u0939\u092e\u0947\u0902 \u0939\u0948\u0930\u093e\u0928 \u0915\u0930 \u0926\u093f\u092f\u093e\u0964",
    "63 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u092c\u093e\u0926, \u091c\u094b \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0930\u094b\u091c\u093c\u093e\u0928\u093e 5 \u092e\u093f\u0928\u091f \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u092e\u0947\u0902 \u0938\u0947 73% \u0928\u0947 \u0915\u092d\u0940 '\u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930' \u092b\u0940\u091a\u0930 \u0915\u094b \u091b\u0941\u0906 \u0939\u0940 \u0928\u0939\u0940\u0902\u0964 \u092f\u0939 \u090f\u0915 \u091a\u0942\u0915 \u0939\u0948\u0964 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u0906\u092a\u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0938\u093f\u0930\u094d\u092b\u093c \u0924\u0947\u091c\u093c \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0938\u093e\u092b\u093c \u0914\u0930 \u0917\u0939\u0930\u093e \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u2014\u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0915\u0947\u0964",
    "\u092f\u0939 \u092b\u0940\u091a\u0930 \u0906\u092a\u0915\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b\u0924\u0947 \u0939\u0940 \u0911\u091f\u094b-\u090f\u0915\u094d\u091f\u093f\u0935\u0947\u091f \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0938\u0947\u091f \u0915\u0930\u0947\u0902, \u092b\u093f\u0930 \u092d\u0942\u0932 \u091c\u093e\u090f\u0901\u0964 \u0915\u094b\u0908 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0928\u093e\u0917 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u090f\u0915 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0914\u0930 \u090f\u0915 EQ\u0964",
    "\u0905\u092c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u0915\u094b \u090f\u0915 \u092c\u093e\u0930 \u0906\u091c\u093c\u092e\u093e\u090f\u0901\u0964 \u0906\u092a\u0915\u094b \u092b\u0930\u094d\u0915 \u092a\u0924\u093e \u091a\u0932\u0947\u0917\u093e\u0964 P.S. \u092f\u0939\u093e\u0901 \u0924\u0915 \u0915\u093f \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092d\u0940 \u0907\u0938\u0947 \u0905\u0928\u0926\u0947\u0916\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u2014\u0932\u0947\u0915\u093f\u0928 \u091c\u094b \u0932\u094b\u0917 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u092f\u0939 \u0910\u092a \u0915\u093e \u0938\u092c\u0938\u0947 \u092e\u0942\u0932\u094d\u092f\u0935\u093e\u0928 \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u0948\u0964"
  ],
