{
  "subject": "\u0907\u0938 \u090f\u0915 \u0917\u0932\u0924\u0940 \u0938\u0947 \u0906\u092a\u0915\u093e \u092b\u093c\u094b\u0928 \u0906\u0927\u093e \u0939\u0940 \u092c\u091c\u093e \u0930\u0939\u093e \u0939\u0948",
  "preview_text": "90% \u0932\u094b\u0917 \u0907\u0938 \u092b\u093c\u0940\u091a\u0930 \u0915\u094b \u092e\u093f\u0938 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u093e \u0911\u0921\u093f\u092f\u094b \u0915\u093f\u0924\u0928\u093e \u0932\u093e\u0909\u0921 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948, \u092f\u0939 \u091c\u093e\u0928\u0915\u0930 \u0939\u0948\u0930\u093e\u0928 \u0930\u0939 \u091c\u093e\u090f\u0902\u0917\u0947\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u091a\u0940\u091c\u093c \u0928\u094b\u091f\u093f\u0938 \u0915\u0940\u0964 \u092e\u0947\u0930\u0947 \u0926\u094b\u0938\u094d\u0924 \u0915\u093e \u092b\u093c\u094b\u0928 \u092e\u0947\u0930\u0947 \u092b\u093c\u094b\u0928 \u0938\u0947 \u0926\u094b\u0917\u0941\u0928\u093e \u0932\u093e\u0909\u0921 \u092c\u091c \u0930\u0939\u093e \u0925\u093e\u0964 \u0935\u0939\u0940 \u0917\u093e\u0928\u093e, \u0935\u0939\u0940 \u0938\u094d\u092a\u0940\u0915\u0930\u0964 \u092e\u0948\u0902 \u0939\u0948\u0930\u093e\u0928 \u0930\u0939 \u0917\u092f\u093e\u0964 \u092b\u093f\u0930 \u092a\u0924\u093e \u091a\u0932\u093e \u0915\u093f \u092e\u0948\u0902 \u0915\u094d\u092f\u093e \u092e\u093f\u0938 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964",
    "\u0906\u092a\u0915\u0947 \u092b\u093c\u094b\u0928 \u092e\u0947\u0902 \u091b\u0941\u092a\u0940 \u0939\u0941\u0908 \u090f\u0915 \u092a\u093e\u0935\u0930 \u0939\u0948 \u091c\u094b \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u0940 \u0932\u093f\u092e\u093f\u091f \u0938\u0947 \u092d\u0940 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0928\u093f\u0915\u093e\u0932 \u0938\u0915\u0924\u0940 \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a\u0964 \u0915\u094b\u0908 \u0938\u0947\u091f\u093f\u0902\u0917 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u091d\u0902\u091d\u091f \u0928\u0939\u0940\u0902\u0964 \u0906\u092a\u0915\u093e \u092e\u094d\u092f\u0942\u091c\u093c\u093f\u0915 \u0905\u092d\u0940 \u0938\u0947 200% \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0932\u093e\u0909\u0921 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948\u0964",
    "Volume Booster \u092e\u0947\u0902 \u0938\u092c\u0938\u0947 \u090a\u092a\u0930 \u091c\u094b \u092c\u0921\u093c\u093e \u092c\u0942\u0938\u094d\u091f \u092c\u091f\u0928 \u0939\u0948, \u0909\u0938\u0947 \u091f\u091a \u0915\u0930\u0947\u0902\u0964 \u092c\u0938 \u0907\u0924\u0928\u093e \u0939\u0940\u0964 \u0905\u092c Spotify \u092f\u093e YouTube \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0935\u0939\u0940 \u0917\u093e\u0928\u093e \u0932\u0917\u093e\u090f\u0902 \u091c\u094b \u0905\u092d\u0940 \u0924\u0915 '\u092b\u094d\u0932\u0948\u091f' \u0932\u0917 \u0930\u0939\u093e \u0925\u093e\u0964 \u0905\u0902\u0924\u0930 \u0906\u092a \u0916\u0941\u0926 \u0938\u0941\u0928\u0947\u0902\u0917\u0947\u0964 \u092f\u0939 \u0938\u092c 30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964",
