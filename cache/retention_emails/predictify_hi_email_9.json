{
  "subject": "\u092e\u0948\u091a \u0915\u093e \u0905\u0938\u0932\u0940 \u0938\u094d\u0915\u094b\u0930 \u0915\u094d\u092f\u093e \u0939\u0948? 3 \u0926\u093f\u0928 \u0915\u093e \u091a\u0948\u0932\u0947\u0902\u091c",
  "preview_text": "\u0905\u092a\u0928\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u093f\u092f\u094b\u0902 \u0915\u094b \u0921\u0947\u091f\u093e \u0938\u0947 \u092a\u0915\u094d\u0915\u093e \u0915\u0930\u0947\u0902\u0964 3 \u0926\u093f\u0928 \u0915\u093e \u091a\u0948\u0932\u0947\u0902\u091c \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902 \u0914\u0930 \u092b\u0930\u094d\u0915 \u0926\u0947\u0916\u0947\u0902\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u0930 \u0932\u0940\u0917 \u0915\u093e \u092e\u0948\u091a \u0926\u0947\u0916\u093e? \u0924\u0941\u092e\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u092e\u0948\u0928 \u0938\u093f\u091f\u0940 \u091c\u0940\u0924\u0947\u0917\u0940, \u0932\u0947\u0915\u093f\u0928 AI \u0928\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u092c\u0924\u093e \u0926\u093f\u092f\u093e \u0925\u093e \u0915\u093f \u0921\u094d\u0930\u0949 \u0915\u093e 67% \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0939\u0948\u0964 \u0905\u092c \u092c\u0924\u093e\u0913, \u0915\u094c\u0928 \u0938\u0939\u0940 \u0925\u093e?",
    "\u0939\u0930 \u092b\u0948\u0928 \u0915\u0940 \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u0939\u094b\u0924\u0940 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0921\u0947\u091f\u093e \u0939\u092e\u0947\u0936\u093e \u091c\u0940\u0924\u0924\u093e \u0939\u0948\u0964 Predictify \u0915\u0947 AI \u0928\u0947 \u0939\u091c\u093e\u0930\u094b\u0902 \u0935\u0947\u0930\u093f\u090f\u092c\u0932\u094d\u0938 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0930\u0915\u0947 \u0939\u0930 \u092e\u0948\u091a \u0915\u093e \u0938\u094d\u0915\u094b\u0930, \u092a\u0949\u091c\u0947\u0936\u0928, \u0914\u0930 \u0921\u093f\u092b\u0947\u0902\u0938\u093f\u0935 \u0938\u094d\u091f\u094d\u0930\u0947\u0902\u0925 \u0928\u093f\u0915\u093e\u0932\u0940 \u0939\u0948\u0964 \u0905\u092c \u0924\u0941\u092e \u092d\u0940 \u0905\u092a\u0928\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u093f\u092f\u094b\u0902 \u0915\u094b \u0921\u0947\u091f\u093e \u0938\u0947 \u092a\u0915\u094d\u0915\u093e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964",
    "\u092f\u0939\u093e\u0901 \u090f\u0915 \u091a\u0948\u0932\u0947\u0902\u091c \u0939\u0948: \u0905\u0917\u0932\u0947 3 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0939\u0930 \u092e\u0948\u091a \u0938\u0947 \u092a\u0939\u0932\u0947 AI \u0915\u093e \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u091a\u0947\u0915 \u0915\u0930\u094b \u0914\u0930 \u0905\u092a\u0928\u0947 \u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0938\u0947 \u0936\u0930\u094d\u0924 \u0932\u0917\u093e\u0913\u0964 \u0921\u0947\u091f\u093e \u0915\u0947 \u0938\u093e\u0925 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u091c\u0940\u0924 \u0915\u093e \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 80% \u0938\u0947 \u090a\u092a\u0930 \u0939\u094b\u0917\u093e\u0964 \u092c\u0938 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '3-\u0921\u0947 \u091a\u0948\u0932\u0947\u0902\u091c' \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u091c\u093e\u0913\u0964",
    "\u0905\u092c \u0915\u094d\u092f\u093e \u0938\u094b\u091a \u0930\u0939\u0947 \u0939\u094b? \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u092a\u0939\u0932\u093e \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u091a\u0947\u0915 \u0915\u0930\u094b\u0964 P.S. \u2014 \u091c\u094b \u0932\u094b\u0917 \u092f\u0939 \u091a\u0948\u0932\u0947\u0902\u091c \u092a\u0942\u0930\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0905\u0917\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092b\u0940\u091a\u0930\u094d\u0938 \u092a\u0930 50% \u091b\u0942\u091f \u092a\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"
  ],
