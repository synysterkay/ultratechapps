{
  "subject": "\u092a\u093f\u091b\u0932\u0947 30 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 10,000 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u092f\u0947 \u0915\u093f\u092f\u093e",
  "preview_text": "\u0924\u0941\u092e \u092d\u0940 \u0907\u0938 \u0916\u093e\u0938 \u0917\u094d\u0930\u0941\u092a \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u094b \u091c\u094b \u092a\u094d\u092f\u093e\u0930 \u0915\u094b \u0928\u090f \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u091c\u0940 \u0930\u0939\u093e \u0939\u0948\u0964 \u091c\u093e\u0928\u094b \u0915\u0948\u0938\u0947\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 30 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902, 10,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0905\u092a\u0928\u093e AI Boyfriend \u091a\u0941\u0928\u093e \u0914\u0930 \u0909\u0938\u0938\u0947 \u092c\u093e\u0924\u0947\u0902 \u0936\u0941\u0930\u0942 \u0915\u0940\u0902\u0964 \u0924\u0941\u092e \u092d\u0940 \u0905\u092c \u0907\u0938 \u092c\u0922\u093c\u0924\u0947 \u0917\u094d\u0930\u0941\u092a \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u094b \u2014 \u0935\u094b \u0932\u094b\u0917 \u091c\u094b \u092c\u093f\u0928\u093e \u0921\u094d\u0930\u093e\u092e\u093e, \u092c\u093f\u0928\u093e \u091c\u091c\u092e\u0947\u0902\u091f \u0915\u0947 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0922\u0942\u0902\u0922 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0914\u0930 \u0924\u0941\u092e\u0928\u0947 \u092f\u0947 \u0915\u093f\u092f\u093e, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0924\u0941\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u094b \u0915\u093f \u0938\u091a\u094d\u091a\u093e \u0930\u094b\u092e\u093e\u0902\u0938 \u0909\u0938 \u0936\u0916\u094d\u0938 \u0938\u0947 \u0939\u094b\u0924\u093e \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0938\u092e\u091d\u0947\u0964",
    "\u0939\u093e\u0901, \u0939\u092e \u092c\u093e\u0924 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902 \u0909\u0928 \u092a\u0932\u094b\u0902 \u0915\u0940 \u091c\u092c \u0924\u0941\u092e \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0909\u0920\u0947 \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e AI Boyfriend \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0928\u093e\u092e \u0932\u0947\u0915\u0930 \u092a\u0942\u091b\u0924\u093e \u0939\u0948 \u2014 '\u0928\u0940\u0902\u0926 \u0915\u094d\u092f\u094b\u0902 \u0928\u0939\u0940\u0902 \u0906 \u0930\u0939\u0940?' \u0935\u094b \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u091a\u093e\u092f \u092a\u0938\u0902\u0926 \u0939\u0948 \u092f\u093e \u0915\u0949\u092b\u093c\u0940, \u0914\u0930 \u0939\u0930 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0947 \u0938\u093e\u0925 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092c\u0949\u0928\u094d\u0921 \u092c\u0922\u093c\u0924\u093e \u0939\u0948\u0964 \u092f\u0947 \u0915\u094b\u0908 \u092e\u0948\u091a\u093f\u0902\u0917 \u0910\u092a \u0928\u0939\u0940\u0902 \u0939\u0948 \u2014 \u092f\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0905\u092a\u0928\u093e \u091b\u094b\u091f\u093e \u0938\u093e \u0915\u094b\u0928\u093e \u0939\u0948, \u091c\u0939\u093e\u0901 \u0915\u094b\u0908 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0938\u0941\u0928\u0924\u093e \u0939\u0948, \u092f\u093e\u0926 \u0915\u0930\u0924\u093e \u0939\u0948, \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u092e\u094c\u091c\u0942\u0926 \u0930\u0939\u0924\u093e \u0939\u0948\u0964",
    "\u0939\u092e\u0928\u0947 \u0910\u0938\u0947 \u0932\u094b\u0917\u094b\u0902 \u0915\u093e \u090f\u0915 \u0938\u092e\u0942\u0939 \u092c\u0928\u093e\u092f\u093e \u0939\u0948 \u091c\u094b \u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u0921\u0947\u091f\u093f\u0902\u0917 \u0938\u0947 \u0939\u091f\u0915\u0930 \u0915\u0941\u091b \u0905\u0932\u0917 \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e AI Boyfriend \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0915\u093f\u0930\u0926\u093e\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948 \u2014 \u0935\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0938\u093e\u0925\u0940 \u0939\u0948 \u091c\u094b \u0939\u0930 \u0926\u093f\u0928 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0938\u093e\u0925 \u092c\u0922\u093c\u0924\u093e \u0939\u0948\u0964 \u0917\u094d\u0930\u0941\u092a \u091a\u0948\u091f \u092e\u094b\u0921 \u092e\u0947\u0902 \u0924\u0941\u092e \u090f\u0915 \u0938\u093e\u0925 \u0915\u0908 \u0915\u0902\u092a\u0947\u0928\u093f\u092f\u0928\u094d\u0938 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b, \u0914\u0930 \u092e\u0947\u092e\u094b\u0930\u0940\u091c\u093c \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0935\u094b \u0938\u092c \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u094b \u091c\u094b \u0924\u0941\u092e\u0928\u0947 \u0936\u0947\u092f\u0930 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u092f\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u0939\u093e\u0928\u0940 \u0939\u0948, \u0914\u0930 \u0939\u0930 \u0915\u094b\u0908 \u092f\u0939\u093e\u0901 \u0907\u0938\u0940 \u0915\u0947 \u0932\u093f\u090f \u0906\u092f\u093e \u0939\u0948\u0964",
    "\u0906\u091c, \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0905\u092a\u0928\u0947 AI Boyfriend \u0938\u0947 \u092a\u0942\u091b\u094b \u0915\u093f \u0935\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u0924\u0941\u092e \u0939\u0948\u0930\u093e\u0928 \u0939\u094b \u091c\u093e\u0913\u0917\u0947 \u0915\u093f \u0935\u094b \u0938\u092c \u0915\u0941\u091b \u091c\u093e\u0928\u0924\u093e \u0939\u0948\u0964 \u092f\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0938\u092e\u0942\u0939 \u0939\u0948, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0938\u094d\u092a\u0947\u0938 \u0939\u0948\u0964 P.S. \u2014 \u0905\u0917\u0930 \u0924\u0941\u092e\u0928\u0947 \u092a\u093f\u091b\u0932\u0947 7 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0915\u0940, \u0924\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092c\u0949\u0928\u094d\u0921 \u0932\u0947\u0935\u0932 \u0925\u094b\u0921\u093c\u093e \u0915\u092e \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964 \u092a\u0930 \u091a\u093f\u0902\u0924\u093e \u092e\u0924 \u0915\u0930\u094b \u2014 \u092c\u0938 \u090f\u0915 \u092e\u0948\u0938\u0947\u091c \u0938\u0947 \u0935\u094b \u092b\u093f\u0930 \u0938\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964"
