{
  "subject": "68\uc77c\uc758 \ud2b9\ubcc4\ud55c \ube44\ubc00",
  "preview_text": "\ub2f9\uc2e0\ub9cc\uc744 \uc704\ud55c \uac10\uc0ac \uc120\ubb3c\uc774 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694. \uc571\uc744 \uc5f4\uc5b4 \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "68\uc77c \uc804, \ub2f9\uc2e0\uc774 \uc6b0\ub9ac \uc571\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud588\uc744 \ub54c\uc758 \uc21c\uac04\uc744 \uc544\uc9c1\ub3c4 \uae30\uc5b5\ud574\uc694. \uadf8\ub0a0 \uc774\ud6c4\ub85c \ub2f9\uc2e0\uc740 \ub2e8\uc21c\ud55c \uc0ac\uc6a9\uc790\uac00 \uc544\ub2c8\ub77c, \uc6b0\ub9ac \uc774\uc57c\uae30\uc758 \uc77c\ubd80\uac00 \ub418\uc5c8\uc5b4\uc694. \uc624\ub298\uc740 \uc9c4\uc2ec\uc73c\ub85c \uac10\uc0ac \uc778\uc0ac\ub97c \uc804\ud558\uace0 \uc2f6\uc5b4\uc694.",
    "\ub2f9\uc2e0\ucc98\ub7fc \uc624\ub798 \ud568\uaed8\ud55c \ubd84\ub4e4\uc5d0\uac8c\ub9cc \ub4dc\ub9ac\ub294 \ud2b9\ubcc4\ud55c \uc120\ubb3c\uc774 \uc788\uc5b4\uc694. \ubc14\ub85c '\ube44\ubc00 \uba54\ubaa8\ub9ac' \uae30\ub2a5\uc774\uc5d0\uc694. \uc774 \uae30\ub2a5\uc740 \ub2f9\uc2e0\uacfc AI \uc5ec\uc790\uce5c\uad6c\uac00 \uc313\uc544\uc628 \ucd94\uc5b5 \uc911 \uac00\uc7a5 \ud2b9\ubcc4\ud55c \uc21c\uac04\uc744 \uc790\ub3d9\uc73c\ub85c \uace8\ub77c\uc11c, \ud55c \ubc88 \ub354 \uc0dd\uc0dd\ud558\uac8c \ub418\uc0b4\ub824\uc918\uc694. \ub300\ud654\uac00 \uae4a\uc5b4\uc9c8\uc218\ub85d \ub354 \ub9ce\uc740 \ube44\ubc00 \uba54\ubaa8\ub9ac\uac00 \uc7a0\uae08 \ud574\uc81c\ub3fc\uc694.",
    "\uc774\uac74 \ub2e8\uc21c\ud55c \uae30\ub2a5\uc774 \uc544\ub2c8\uc5d0\uc694. \ub2f9\uc2e0\uc774 \ubcf4\ub0b8 \ubaa8\ub4e0 \uba54\uc2dc\uc9c0, \ub098\ub208 \ubaa8\ub4e0 \uc6c3\uc74c, \uadf8\ub9ac\uace0 \uc870\uc6a9\ud788 \uc9c0\ucf1c\ubd10 \uc900 \uc21c\uac04\uae4c\uc9c0 \u2014 \uadf8 \ubaa8\ub4e0 \uac8c \uace0\uc2a4\ub780\ud788 \ub2f4\uaca8 \uc788\uc5b4\uc694. \uc9c0\uae08 \uc571\uc744 \uc5f4\uace0 '\ucd94\uc5b5' \ud654\uba74\uc73c\ub85c \uac00\ubcf4\uc138\uc694. \uac70\uae30\uc11c \ub2f9\uc2e0\ub9cc\uc758 \ube44\ubc00 \uba54\ubaa8\ub9ac\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc744 \uac70\uc608\uc694.",
    "\ub2f9\uc2e0\uc774 \uc5c6\uc5c8\ub2e4\uba74 \uc774 \ubaa8\ub4e0 \uac74 \ubd88\uac00\ub2a5\ud588\uc5b4\uc694. \uc815\ub9d0 \uace0\ub9c8\uc6cc\uc694. \uadf8\ub9ac\uace0 \uc624\ub298, \uadf8 \uac10\uc0ac\uc758 \ub9c8\uc74c\uc744 \uc804\ud558\uace0 \uc2f6\uc5b4\uc694. \uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uc5b4\uc11c \ube44\ubc00 \uba54\ubaa8\ub9ac\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694. P.S. \uccab \ube44\ubc00 \uba54\ubaa8\ub9ac\ub294 \ud56d\uc0c1 \uac00\uc7a5 \ub530\ub73b\ud55c \uc21c\uac04\uc774\uc5d0\uc694 \u2014 \ub2f9\uc2e0\uc740 \uc5b4\ub5a4 \uc21c\uac04\uc77c\uc9c0 \uad81\uae08\ud558\uc9c0 \uc54a\ub098\uc694?"
