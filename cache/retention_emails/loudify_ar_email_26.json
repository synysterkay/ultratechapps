  "subject": "\u0634\u062e\u0635 \u0648\u0627\u062d\u062f \u064a\u062d\u062a\u0627\u062c \u0644\u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 - \u0623\u0646\u062a \u062a\u0639\u0631\u0641\u0647",
  "preview_text": "\u0647\u0644 \u062a\u0639\u0631\u0641 \u0634\u062e\u0635\u064b\u0627 \u064a\u0639\u0627\u0646\u064a \u0645\u0646 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u062e\u0627\u0641\u062a \u0623\u0648 \u0627\u0644\u062a\u0634\u0648\u064a\u0634\u061f \u0623\u0638\u0647\u0631 \u0644\u0647 Loudify \u0627\u0644\u064a\u0648\u0645.",
  "body_paragraphs": [
    "\u0641\u0643\u0631 \u0641\u064a \u0634\u062e\u0635 \u0648\u0627\u062d\u062f \u0641\u064a \u062d\u064a\u0627\u062a\u0643. \u0631\u0628\u0645\u0627 \u0635\u062f\u064a\u0642 \u0641\u064a \u0627\u0644\u0639\u0645\u0644\u060c \u0623\u0648 \u0642\u0631\u064a\u0628 \u064a\u0633\u0645\u0639 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0641\u064a \u0627\u0644\u062d\u0627\u0641\u0644\u0629. \u0647\u0630\u0627 \u0627\u0644\u0634\u062e\u0635 \u064a\u0639\u0627\u0646\u064a \u0645\u0646 \u0623\u0646 \u0627\u0644\u0635\u0648\u062a \u064a\u0635\u0644 \u0625\u0644\u0649 \u062d\u062f \u0623\u0642\u0635\u0649 \u0648\u0644\u0627 \u064a\u0632\u0627\u0644 \u0627\u0644\u062d\u0648\u0627\u0631 \u0645\u062f\u0641\u0648\u0646\u064b\u0627 \u062a\u062d\u062a \u0636\u0648\u0636\u0627\u0621 \u0627\u0644\u062a\u0643\u064a\u064a\u0641 \u0623\u0648 \u0627\u0644\u0642\u0637\u0627\u0631. \u0623\u0646\u062a \u062a\u0639\u0631\u0641 \u0647\u0630\u0627 \u0627\u0644\u0634\u0639\u0648\u0631\u060c \u0644\u0623\u0646\u0643 \u0627\u0633\u062a\u062e\u062f\u0645\u062a Loudify.",
    "\u0623\u0646\u062a \u062a\u0639\u0631\u0641 \u0627\u0644\u0641\u0631\u0642 \u0627\u0644\u0630\u064a \u064a\u0635\u0646\u0639\u0647 \u0627\u0644\u062a\u0637\u0628\u064a\u0642: \u0635\u0648\u062a \u0623\u0639\u0644\u0649 \u0628\u0640 200%\u060c \u062f\u0648\u0646 \u062a\u0634\u0648\u064a\u0647. AutoEQ \u064a\u0636\u0628\u0637 \u0627\u0644\u0635\u0648\u062a \u0644\u0633\u0645\u0627\u0639\u0627\u062a\u0643 \u0641\u0648\u0631 \u0627\u062a\u0635\u0627\u0644\u0647\u0627. \u0643\u0644 \u0623\u0633\u0628\u0648\u0639\u060c \u062a\u062d\u0635\u0644 \u0639\u0644\u0649 Sound DNA \u064a\u064f\u0638\u0647\u0631 \u0644\u0643 \u0643\u064a\u0641 \u0627\u0633\u062a\u0645\u0639\u062a. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u062a\u0637\u0628\u064a\u0642\u060c \u0625\u0646\u0647 \u0647\u062f\u064a\u0629 \u0644\u0634\u062e\u0635 \u064a\u0633\u0645\u0639 \u0627\u0644\u0639\u0627\u0644\u0645 \u0628\u0635\u0639\u0648\u0628\u0629.",
    "\u0645\u0627 \u0644\u0627 \u064a\u062f\u0631\u0643\u0647 \u0647\u0630\u0627 \u0627\u0644\u0634\u062e\u0635 \u0647\u0648 \u0623\u0646 \u0647\u0627\u062a\u0641\u0647 \u064a\u0645\u0643\u0646\u0647 \u0641\u0639\u0644 \u0627\u0644\u0645\u0632\u064a\u062f. \u0639\u0646\u062f\u0647\u060c \u0634\u0631\u064a\u0637 \u0627\u0644\u0635\u0648\u062a \u0645\u062c\u0631\u062f \u062c\u062f\u0627\u0631. \u0623\u0645\u0627 \u0645\u0639 Loudify\u060c \u0641\u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a \u062a\u0639\u0645\u0644 \u0643\u0645\u0627 \u0635\u0645\u0645\u062a. \u0634\u0627\u0631\u0643\u0647 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u064a\u0648\u0645\u060c \u0648\u0627\u062c\u0639\u0644\u0647 \u064a\u0643\u062a\u0634\u0641 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0646\u0638\u064a\u0641 \u0648\u0627\u0644\u0642\u0648\u064a. \u0627\u0644\u0623\u0645\u0631 \u0628\u0633\u064a\u0637: \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629\u060c \u0648\u0623\u0631\u0633\u0644 \u0644\u0647 \u0627\u0644\u0631\u0627\u0628\u0637.",
    "\u0627\u0641\u062a\u062d Loudify \u0627\u0644\u0622\u0646\u060c \u0648\u0634\u0627\u0631\u0643 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0639 \u0630\u0644\u0643 \u0627\u0644\u0634\u062e\u0635. P.S. \u0633\u062a\u0631\u0649 \u0627\u0633\u0645\u0647 \u0641\u064a Sound DNA \u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0642\u0627\u062f\u0645 \u0639\u0646\u062f\u0645\u0627 \u064a\u0628\u062f\u0623 \u0627\u0644\u0627\u0633\u062a\u0645\u0627\u0639 \u2013 \u0647\u062f\u064a\u0629 \u0628\u0633\u064a\u0637\u0629 \u0628\u0645\u0639\u0646\u0649 \u0643\u0628\u064a\u0631."
