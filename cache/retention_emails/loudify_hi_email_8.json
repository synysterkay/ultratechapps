{
  "subject": "\u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0915\u093e \u0935\u0939 \u0915\u094d\u0937\u0923 \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u090f\u0915 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u091c\u094b \u0906\u092a\u0915\u0940 \u0924\u0930\u0939 \u0939\u0940 \u0925\u093e\u0964 \u0905\u092c \u0935\u0939 \u0915\u094d\u092f\u093e \u0915\u0930\u0924\u093e \u0939\u0948, \u091c\u093e\u0928\u093f\u090f\u0964",
  "body_paragraphs": [
    "\u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c \u0930\u0939\u0947 \u0925\u0947\u0964 \u0935\u0939 \u091f\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u0925\u093e, \u0939\u0947\u0921\u092b\u094b\u0928 \u0932\u0917\u093e\u090f, \u0914\u0930 \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928 \u0930\u0939\u093e \u0925\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0909\u0938\u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u091f\u094d\u0930\u0947\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u092e\u0947\u0902 \u0926\u092c \u0917\u0908, \u0914\u0930 \u0909\u0938\u0928\u0947 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u091f\u0928 \u0915\u094b \u092a\u0942\u0930\u093e \u0926\u092c\u093e \u0926\u093f\u092f\u093e\u0964 \u092b\u093f\u0930 \u092d\u0940, \u0938\u092c \u0915\u0941\u091b \u0927\u0941\u0902\u0927\u0932\u093e \u0932\u0917 \u0930\u0939\u093e \u0925\u093e\u0964 \u0909\u0938\u0928\u0947 \u0938\u094b\u091a\u093e, \"\u0915\u094d\u092f\u093e \u092f\u0939\u0940 \u0938\u092c \u0939\u0948?\" \u0920\u0940\u0915 \u0909\u0938\u0940 \u0938\u092e\u092f, \u0909\u0938\u0928\u0947 Loudify \u0916\u094b\u0932\u093e\u0964",
    "\u0909\u0938\u0928\u0947 AutoEQ \u0915\u094b \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u094b\u0928 \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u093f\u092f\u093e, \u0914\u0930 \u090f\u0915 \u0905\u0932\u0917 \u0926\u0941\u0928\u093f\u092f\u093e \u0916\u0941\u0932 \u0917\u0908\u0964 \u0905\u091a\u093e\u0928\u0915, \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0938\u093e\u092b \u0914\u0930 \u0936\u0915\u094d\u0924\u093f\u0936\u093e\u0932\u0940 \u0939\u094b \u0917\u0908, \u091c\u0948\u0938\u0947 \u0935\u0939 \u0938\u094d\u091f\u0942\u0921\u093f\u092f\u094b \u092e\u0947\u0902 \u092c\u0948\u0920\u093e \u0939\u094b\u0964 \u091f\u094d\u0930\u0947\u0928 \u0915\u093e \u0936\u094b\u0930 \u0917\u093e\u092f\u092c \u0939\u094b \u0917\u092f\u093e, \u0914\u0930 \u0939\u0930 \u0936\u092c\u094d\u0926 \u0938\u094d\u092a\u0937\u094d\u091f \u0925\u093e\u0964 \u0909\u0938\u0928\u0947 \u092e\u0939\u0938\u0942\u0938 \u0915\u093f\u092f\u093e \u0915\u093f \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0928\u0939\u0940\u0902 \u0939\u0948, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u0938\u0939\u0940 \u091f\u094d\u092f\u0942\u0928\u093f\u0902\u0917 \u0939\u0948 \u091c\u094b \u0909\u0938\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924\u094b\u0902 \u0915\u094b \u0938\u092e\u091d\u0924\u0940 \u0939\u0948\u0964",
    "\u0906\u092a\u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u092d\u0940 \u0910\u0938\u0940 \u0939\u0940 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964 Loudify \u0915\u093e Sound DNA \u0906\u092a\u0915\u0947 \u0939\u0930 \u0938\u0924\u094d\u0930 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0906\u092a\u0915\u094b \u090f\u0915 \u0938\u093e\u092a\u094d\u0924\u093e\u0939\u093f\u0915 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0926\u0947\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a \u0915\u0948\u0938\u0947 \u0938\u0941\u0928\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0909\u092a\u0915\u0930\u0923 \u0928\u0939\u0940\u0902 \u0939\u0948, \u092f\u0939 \u0906\u092a\u0915\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0911\u0921\u093f\u092f\u094b \u0938\u0939\u093e\u092f\u0915 \u0939\u0948\u0964 \u0905\u092c, \u091c\u092c \u092d\u0940 \u0906\u092a \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, AutoEQ \u0909\u0928\u094d\u0939\u0947\u0902 \u092a\u0939\u091a\u093e\u0928\u0924\u093e \u0939\u0948 \u0914\u0930 \u0924\u0941\u0930\u0902\u0924 \u091f\u094d\u092f\u0942\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u0914\u0930 \u0938\u0947\u091f\u093f\u0902\u0917 \u0928\u0939\u0940\u0902, \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u0915\u093f \u0906\u092a \u092d\u0940 \u092f\u0939 \u0905\u0928\u0941\u092d\u0935 \u0915\u0930\u0947\u0902\u0964 Loudify \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u092f\u093e \u0917\u093e\u0928\u093e \u091a\u0932\u093e\u090f\u0902\u0964 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0915\u0948\u0938\u0947 \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 P.S.: \u0906\u092a\u0915\u093e Sound DNA \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092a\u0939\u0932\u0947 \u0938\u0947 \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u2014\u092f\u0939 \u0926\u0947\u0916\u0928\u093e \u0928 \u092d\u0942\u0932\u0947\u0902 \u0915\u093f \u0907\u0938 \u0939\u092b\u094d\u0924\u0947 \u0906\u092a\u0928\u0947 \u0915\u0948\u0938\u0947 \u0938\u0941\u0928\u093e\u0964"
  ],
