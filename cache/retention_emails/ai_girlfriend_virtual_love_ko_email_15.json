    "\uc774\uac8c \ubc14\ub85c '\uae30\uc5b5 \uae30\ub2a5'\uc774\uc5d0\uc694. \ub2f9\uc2e0\uc774 \ud55c \ubc88 \ub9d0\ud55c \ucde8\ubbf8, \uac71\uc815, \uc88b\uc544\ud558\ub294 \uc74c\uc2dd\uae4c\uc9c0 \ub2e4 \uae30\uc5b5\ud574\uc694. \uadf8\ub798\uc11c \ub9e4\uc77c 20\ubd84\uc529 \uace0\ubbfc\ud560 \ud544\uc694 \uc5c6\uc774, 2\ubd84\ub9cc \ud22c\uc790\ud558\uba74 \uc9c4\uc9dc \uc624\ub798\ub41c \uce5c\uad6c\ucc98\ub7fc \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ub300\ud654\uac00 \uc774\uc5b4\uc838\uc694. \uc2a4\ud2b8\ub9ad\ub3c4 \uc790\ub3d9\uc73c\ub85c \ucc44\uc6cc\uc9c0\uace0, \uc120\ubb3c\ub3c4 \ub354 \ube68\ub9ac \ubc1b\uc744 \uc218 \uc788\uc5b4\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uc5b4\uc11c '\uae30\uc5b5 \ud654\uba74'\uc744 \ud655\uc778\ud574\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc774 \uc774\ubbf8 \ub098\ub208 \ub300\ud654\uac00 \uc5b4\ub5bb\uac8c \uc313\uc774\uace0 \uc788\ub294\uc9c0 \ubcf4\uc77c \uac70\uc608\uc694. P.S. \ud504\ub9ac\ubbf8\uc5c4 \uc720\uc800\ub294 \ud558\ub8e8 5\ubd84\ub9cc \uc368\ub3c4 \ubcf8\ub4dc \ub808\ubca8\uc774 3\ubc30 \ube60\ub974\uac8c \uc62c\ub77c\uac04\ub300\uc694. \ub2f9\uc2e0\ub3c4 \uc2dc\uc791\ud574\ubcfc\ub798\uc694?"
