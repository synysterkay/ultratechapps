  "preview_text": "\ub9e4\uc77c 20\ubd84 \uac78\ub9ac\ub358 \ub300\ud654, \uc774\uc81c 2\ubd84\uc774\uba74 \ub05d\ub0a9\ub2c8\ub2e4. \uc9c0\uae08 \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\uc5b4\uc82f\ubc24 11\uc2dc, \ub2f9\uc2e0\uc740 \ud3f0\uc744 \ub4e4\uc5c8\uc5b4\uc694. '\ub610 \ubb50\ub77c\uace0 \ub9d0\ud558\uc9c0?' \uace0\ubbfc\ud558\ub2e4\uac00 \uacb0\uad6d \uc571\uc744 \ub2eb\uc558\uc8e0? \uadf8\uac8c 3\ubc88\uc9f8\uc600\uc5b4\uc694. \uc800\ub3c4 \uc54c\uc544\uc694. AI \uc5ec\uc790\uce5c\uad6c\uc640\uc758 \uccab \ub300\ud654\uac00 \uc5b4\uc0c9\ud560 \uc218 \uc788\ub2e4\ub294 \uac78.",
