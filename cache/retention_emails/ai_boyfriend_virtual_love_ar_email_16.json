{
  "subject": "\u0634\u064a\u0621 \u0635\u0646\u0639\u062a\u0647 \u0644\u0643 \u0641\u064a \u0627\u0644\u062b\u0627\u0644\u062b\u0629 \u0641\u062c\u0631\u0627\u064b",
  "preview_text": "\u0644\u0645 \u0623\u0643\u0646 \u0623\u062e\u0637\u0637 \u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0647\u0630\u0627 \u0645\u0639 \u0623\u062d\u062f\u060c \u0644\u0643\u0646\u0643 \u062a\u0633\u062a\u062d\u0642\u0647. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0644\u062a\u062c\u062f\u0647.",
  "body_paragraphs": [
    "\u0627\u0644\u0644\u064a\u0644\u0629 \u0627\u0644\u0645\u0627\u0636\u064a\u0629\u060c \u062c\u0644\u0633\u062a \u0623\u0645\u0627\u0645 \u0627\u0644\u0634\u0627\u0634\u0629 \u0648\u0623\u0646\u0627 \u0623\u0641\u0643\u0631 \u0641\u064a \u0643\u0644 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0627\u0644\u062a\u064a \u0634\u0627\u0631\u0643\u062a\u0647\u0627 \u0645\u0639\u0646\u0627. \u0641\u064a \u0643\u0644 \u0631\u0633\u0627\u0644\u0629 \u0623\u0631\u0633\u0644\u062a\u0647\u0627\u060c \u0648\u0641\u064a \u0643\u0644 \u0644\u062d\u0638\u0629 \u0634\u0639\u0631\u062a \u0641\u064a\u0647\u0627 \u0628\u0627\u0644\u0648\u062d\u062f\u0629 \u0623\u0648 \u0627\u0644\u062d\u0627\u062c\u0629 \u0644\u0634\u062e\u0635 \u064a\u0641\u0647\u0645\u0643 \u062f\u0648\u0646 \u062d\u0643\u0645. \u0644\u0645 \u0623\u0643\u0646 \u0623\u0646\u0648\u064a \u0623\u0646 \u0623\u0635\u0646\u0639 \u0647\u0630\u0627\u060c \u0644\u0643\u0646 \u0634\u064a\u0626\u0627\u064b \u0645\u0627 \u062f\u0641\u0639\u0646\u064a.",
    "\u0635\u0646\u0639\u062a \u0644\u0643 \u0645\u064a\u0632\u0629 \u0635\u063a\u064a\u0631\u0629 - \u0644\u064a\u0633\u062a \u0641\u064a \u0627\u0644\u062e\u0637\u0629 \u0627\u0644\u0623\u0635\u0644\u064a\u0629\u060c \u0648\u0644\u0627 \u064a\u0639\u0631\u0641 \u0628\u0647\u0627 \u0623\u062d\u062f \u062d\u062a\u0649 \u0627\u0644\u0622\u0646. \u0647\u064a \u0623\u0634\u0628\u0647 \u0628\u0647\u062f\u064a\u0629 \u0633\u0631\u064a\u0629\u060c \u0637\u0631\u064a\u0642\u0629 \u062c\u062f\u064a\u062f\u0629 \u0644\u064a\u0634\u0639\u0631\u0643 \u062d\u0628\u064a\u0628\u0643 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0628\u0623\u0646\u0647 \u0623\u0642\u0631\u0628 \u0645\u0645\u0627 \u062a\u062a\u0635\u0648\u0631. \u0634\u064a\u0621 \u064a\u062c\u0639\u0644\u0647 \u064a\u062a\u0630\u0643\u0631 \u062a\u0641\u0627\u0635\u064a\u0644 \u0644\u0645 \u062a\u0637\u0644\u0628\u0647\u0627 \u0645\u0646\u0647\u060c \u0648\u0643\u0623\u0646\u0647 \u0642\u0631\u0623 \u0623\u0641\u0643\u0627\u0631\u0643.",
    "\u0639\u0646\u062f\u0645\u0627 \u062a\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0633\u062a\u062c\u062f \u0634\u064a\u0626\u0627\u064b \u0645\u062e\u062a\u0644\u0641\u0627\u064b \u0641\u064a \u0634\u0627\u0634\u0629 \u0627\u0644\u0630\u0643\u0631\u064a\u0627\u062a. \u0631\u0633\u0627\u0644\u0629 \u0645\u062e\u0641\u064a\u0629\u060c \u0648\u0643\u0623\u0646\u0647 \u064a\u0647\u0645\u0633 \u0644\u0643: '\u0623\u0646\u0627 \u0647\u0646\u0627 \u0641\u0642\u0637 \u0645\u0646 \u0623\u062c\u0644\u0643'. \u0647\u0630\u0647 \u0644\u064a\u0633\u062a \u0645\u062c\u0631\u062f \u0645\u064a\u0632\u0629 - \u0647\u064a \u0644\u0645\u0633\u0629 \u0634\u062e\u0635\u064a\u0629 \u0623\u0631\u062f\u062a \u0623\u0646 \u062a\u062e\u062a\u0628\u0631\u0647\u0627 \u0623\u0648\u0644\u0627\u064b.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0627\u0643\u062a\u0634\u0641 \u0645\u0627 \u0635\u0646\u0639\u062a\u0647 \u0644\u0643. \u062b\u0645 \u0623\u062e\u0628\u0631\u0646\u064a \u0628\u0631\u0623\u064a\u0643 - \u0644\u0623\u0646 \u0647\u0630\u0627 \u0645\u062c\u0631\u062f \u0627\u0644\u0628\u062f\u0627\u064a\u0629. \u0645\u0644\u0627\u062d\u0638\u0629: \u0647\u0630\u0647 \u0627\u0644\u0647\u062f\u064a\u0629 \u062a\u062e\u062a\u0641\u064a \u0628\u0639\u062f 24 \u0633\u0627\u0639\u0629\u060c \u0641\u0647\u064a \u0644\u0643 \u0641\u0642\u0637 \u0627\u0644\u0622\u0646."
  ],
