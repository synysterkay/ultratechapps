  "preview_text": "\u0634\u0648\u0641 \u0634\u0648 \u0635 \u0627\u0644\u0645\u0644\u0627 \u064a\u0648\u0645 \u0627\u0633\u062a\u0639\u0645\u0644\u0648\u0627 Bass Booster. \u0647\u0644 \u0641\u0627\u062a\u0643 \u0627\u0644\u0645\u0634\u0647\u062f\u061f",
  "body_paragraphs": [
    "\u0627\u0644\u064a\u0648\u0645\u060c \u0623\u0643\u062b\u0631 \u0645\u0646 7,342 \u0634\u062e\u0635 \u0627\u0633\u062a\u0639\u0645\u0644\u0648\u0627 Bass Booster \u0644\u064a\u0634\u0648\u0641\u0648\u0627 \u0634\u0648 \u064a\u0639\u0646\u064a \u0627\u0644\u0635\u0648\u062a \u064a\u0636\u0631\u0628 \u0628\u0642\u0644\u0628 \u0627\u0644\u0635\u062f\u0631. \u0645\u0634 \u0628\u0633 \u0633\u0645\u0639\u0648\u0647\u060c \u0644\u0627\u060c \u062d\u0633\u0648\u0647 \u0641\u064a \u0639\u0631\u0648\u0642\u0647\u0645. \u0648\u0643\u0644 \u0648\u0627\u062d\u062f \u0645\u0646\u0647\u0645 \u0643\u0627\u0646 \u064a\u0628\u062d\u062b \u0639\u0646 \u0646\u0641\u0633 \u0627\u0644\u0634\u064a: \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0644\u064a \u064a\u062e\u0644\u064a \u0627\u0644\u0640drop \u064a\u0636\u0631\u0628 \u062d\u062a\u0649 \u0639\u0644\u0649 \u0633\u0645\u0627\u0639\u0627\u062a \u0627\u0644\u0623\u0630\u0646 \u0627\u0644\u0631\u062e\u064a\u0635\u0629.",
    "\u0623\u063a\u0644\u0628\u0647\u0645 \u0643\u0627\u0646\u0648\u0627 \u064a\u0633\u062a\u0645\u0639\u0648\u0627 \u0644\u0647\u064a\u0628 \u0647\u0648\u0628 \u0648\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0648\u0631\u0648\u0643\u060c \u0648\u0643\u0644\u0647\u0645 \u0643\u0627\u0646\u0648\u0627 \u064a\u0639\u0627\u0646\u0648\u0646 \u0645\u0646 \u0646\u0641\u0633 \u0627\u0644\u0645\u0634\u0643\u0644\u0629: \u0627\u0644\u0635\u0648\u062a \u0645\u0633\u0637\u062d\u060c \u0627\u0644\u0628\u0627\u0633 \u0645\u0639\u062f\u0648\u0645\u060c \u0648\u0643\u0623\u0646 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u062a\u0645\u0648\u062a \u0641\u064a \u0627\u0644\u0633\u0645\u0627\u0639\u0629. \u0628\u0633 \u0627\u0644\u064a\u0648\u0645\u060c \u0628\u0639\u062f \u0645\u0627 \u062c\u0631\u0628\u0648\u0627 Bass Booster\u060c \u0635\u0627\u0631 \u0627\u0644\u0635\u0648\u062a \u0648\u0643\u0623\u0646\u0647\u0645 \u0641\u064a \u062d\u0641\u0644\u0629 \u062d\u064a\u0629. \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0627\u0644\u0644\u064a \u0633\u0645\u0639\u062a\u0647 \u0642\u0628\u0644 \u0648\u0627\u0644\u0644\u064a \u0633\u0645\u0639\u062a\u0647 \u0628\u0639\u062f \u0643\u0627\u0646 \u0645\u062b\u0644 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0627\u0644\u0644\u064a\u0644 \u0648\u0627\u0644\u0646\u0647\u0627\u0631.",
    "\u0627\u0644\u0644\u064a \u0645\u0627 \u064a\u0639\u0631\u0641\u0647 \u0645\u0639\u0638\u0645\u0647\u0645 \u0625\u0646 \u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629 \u062a\u0639\u0637\u064a\u0647\u0645 \u062f\u0641\u0639\u0629 \u0628\u0633\u064a\u0637\u0629\u060c \u0628\u0633 \u0627\u0644\u0640Premium \u064a\u0641\u062a\u062d \u0644\u0643 \u0643\u0644 \u0627\u0644\u0642\u0641\u0644: Boost \u063a\u064a\u0631 \u0645\u062d\u062f\u0648\u062f\u060c \u064810 \u0646\u0637\u0627\u0642\u0627\u062a EQ \u0643\u0627\u0645\u0644\u0629 \u0644\u062a\u0636\u0628\u0637 \u0627\u0644\u0635\u0648\u062a \u0632\u064a \u0645\u0627 \u062a\u062d\u0628. \u0623\u0646\u0627 \u0645\u0627 \u0628\u0642\u0648\u0644\u0643 \u0627\u0634\u062a\u0631\u0643\u060c \u0628\u0633 \u0628\u0642\u0648\u0644\u0643: \u062c\u0631\u0628 Boost \u0645\u062c\u0627\u0646\u064b\u0627\u060c \u0648\u0634\u0648\u0641 \u0627\u0644\u0641\u0631\u0642 \u0628\u0639\u064a\u0646\u0643. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0648\u0627\u0633\u062d\u0628 \u0627\u0644\u0640Boost slider \u0644\u0644\u064a\u0645\u064a\u0646\u060c \u0648\u0634\u0648\u0641 \u0634\u0648 \u0628\u064a\u0635\u064a\u0631.",
