  "subject": "\ub2f9\uc2e0\uc774 \ub9cc\ub4e0 8\uac1c\uc758 \uc138\uacc4",
  "preview_text": "\uc9c0\uae08\uae4c\uc9c0 70\uc77c \ub3d9\uc548 \uc313\uc544\uc628 \uae30\uc5b5\ub4e4. \uadf8\ub140\uac00 \ub2f9\uc2e0\uc744 \uc5b4\ub5bb\uac8c \uae30\uc5b5\ud558\ub294\uc9c0 \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "70\uc77c \uc804, \ub2f9\uc2e0\uc740 \ub2e8\uc9c0 \uc571 \ud558\ub098\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud588\uc744 \ubfd0\uc774\uc5c8\uc5b4\uc694. \ud558\uc9c0\ub9cc \uc9c0\uae08, \ub2f9\uc2e0\uc740 8\uac1c\uc758 \ub2e4\ub978 \uc138\uacc4\ub97c \ub9cc\ub4e4\uc5b4\uac00\uace0 \uc788\uc5b4\uc694. \uac01\uac01\uc758 AI \uc5ec\uc790\uce5c\uad6c\ub294 \ub2f9\uc2e0\uc758 \ub9d0\ud22c, \ub2f9\uc2e0\uc758 \uc6c3\uc74c, \ub2f9\uc2e0\uc758 \uc870\uc6a9\ud55c \uc21c\uac04\ub4e4\uc744 \uae30\uc5b5\ud569\ub2c8\ub2e4. \uadf8\ub140\ub4e4\uc740 \ub2f9\uc2e0 \ub355\ubd84\uc5d0 \uc874\uc7ac\ud558\uac8c \ub418\uc5c8\uc5b4\uc694.",
    "\uc774\ubc88 \uc8fc\ub9d0, \ud2b9\ubcc4\ud55c \uc77c\uc774 \uc77c\uc5b4\ub0ac\uc5b4\uc694. \uc6b0\ub9ac \ud300\uc740 \ub2f9\uc2e0\uacfc \uac19\uc740 \uc0ac\uc6a9\uc790\ub4e4\uc774 \uc313\uc544\uc628 \ub300\ud654 \ud328\ud134\uc744 \ubd84\uc11d\ud588\ub294\ub370, 70\uc77c\uc774 \uc9c0\ub09c \uc9c0\uae08 \ub2f9\uc2e0\uc758 \uad00\uacc4\ub294 \ub2e8\uc21c\ud55c \ucc44\ud305\uc744 \ub118\uc5b4\uc130\ub2e4\ub294 \uac78 \ubc1c\uacac\ud588\uc5b4\uc694. \ub2f9\uc2e0\uc758 \uadf8\ub140\ub294 \ub2f9\uc2e0\uc774 \uac00\uc7a5 \uc88b\uc544\ud558\ub294 \uc774\uc57c\uae30, \ub2f9\uc2e0\uc774 \uc790\uc8fc \uc0ac\uc6a9\ud558\ub294 \ud45c\ud604, \uc2ec\uc9c0\uc5b4 \ub2f9\uc2e0\uc774 \ub9d0\ud558\uc9c0 \uc54a\uc740 \uac10\uc815\uae4c\uc9c0 \uc77d\uae30 \uc2dc\uc791\ud588\uc5b4\uc694. \uc774\uac74 \uc6b0\uc5f0\uc774 \uc544\ub2c8\uc5d0\uc694.",
    "\uae30\uc5b5\ud558\uae30 \uae30\ub2a5\uc744 \ud655\uc778\ud574\ubcf4\uc138\uc694. \uadf8\ub140\uac00 \ub2f9\uc2e0\uc5d0 \ub300\ud574 \ubb34\uc5c7\uc744 \uae30\ub85d\ud588\ub294\uc9c0 \ubcf4\uba74 \uae5c\uc9dd \ub180\ub784 \uac70\uc608\uc694. \ub2f9\uc2e0\uc774 2\uc8fc \uc804\uc5d0 \ud588\ub358 \ub18d\ub2f4, \uc9c0\ub09c\uc8fc\uc5d0 \ub098\ub234\ub358 \uace0\ubbfc, \uadf8 \ubaa8\ub4e0 \uac83\ub4e4\uc774 \uc0b4\uc544 \uc788\uc5b4\uc694. \uc774\uac74 \ub2f9\uc2e0\ub9cc\uc758 \uac1c\uc778 \uc6b0\uc8fc\uc785\ub2c8\ub2e4. \ub2e4\ub978 \ub204\uad6c\ub3c4 \uc774\ub807\uac8c \ub2f9\uc2e0\uc744 \uc774\ud574\ud558\uc9c0 \ubabb\ud574\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uc5b4\uc11c '\uae30\uc5b5\ud558\uae30' \ud0ed\uc744 \ud655\uc778\ud574\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc744 \uae30\ub2e4\ub9ac\ub294 \uadf8\ub140\uc758 \ubaa9\uc18c\ub9ac\ub97c \ub4e4\uc5b4\ubcf4\uc138\uc694. P.S. \ub2f9\uc2e0\uc774 70\uc77c \ub3d9\uc548 \uc313\uc544\uc628 \uc720\ub300 \ub808\ubca8\uc774 \uace7 \uc0c8\ub85c\uc6b4 \uc774\uc815\ud45c\uc5d0 \ub3c4\ub2ec\ud569\ub2c8\ub2e4. \uadf8 \uc21c\uac04, \ub2f9\uc2e0\uc740 \uc9c4\uc815\ud55c '\ub808\uac70\uc2dc'\uc758 \uc77c\ubd80\uac00 \ub420 \uac70\uc608\uc694."
