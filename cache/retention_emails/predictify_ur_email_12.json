{
  "subject": "\u0648\u06c1 2AM \u06a9\u06cc \u063a\u0644\u0637\u06cc \u062c\u0633 \u0646\u06d2 \u0633\u0628 \u06a9\u0686\u06be \u0628\u062f\u0644 \u062f\u06cc\u0627",
  "preview_text": "\u0627\u06cc\u06a9 \u0635\u0627\u0631\u0641 \u0646\u06d2 \u06cc\u06c1 \u0641\u06cc\u0686\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc\u0627 \u0627\u0648\u0631 \u0627\u0633 \u06a9\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0627\u06ba 80% \u062f\u0631\u0633\u062a \u06c1\u0648 \u06af\u0626\u06cc\u06ba\u06d4 \u06a9\u06cc\u0627 \u0622\u067e \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba\u061f",
  "body_paragraphs": [
    "\u06a9\u0644 \u0631\u0627\u062a 2 \u0628\u062c\u06d2\u060c \u0645\u06cc\u06ba \u0627\u067e\u0646\u06d2 \u0641\u0648\u0646 \u067e\u0631 \u06af\u06be\u0648\u0645 \u0631\u06c1\u0627 \u062a\u06be\u0627 \u0627\u0648\u0631 \u0627\u0686\u0627\u0646\u06a9 \u0645\u062c\u06be\u06d2 \u067e\u062a\u06c1 \u0686\u0644\u0627 \u06a9\u06c1 \u0627\u06cc\u06a9 \u0635\u0627\u0631\u0641 \u0646\u06d2 \u06c1\u0645\u0627\u0631\u06d2 \u0627\u06cc\u06a9 \u0686\u06be\u067e\u06d2 \u06c1\u0648\u0626\u06d2 \u0641\u06cc\u0686\u0631 \u06a9\u0648 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631 \u06a9\u06d2 \u0627\u067e\u0646\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0648\u06ba \u0645\u06cc\u06ba \u0627\u0646\u0642\u0644\u0627\u0628 \u0628\u0631\u067e\u0627 \u06a9\u0631 \u062f\u06cc\u0627\u06d4 \u0648\u06c1 \u067e\u06c1\u0644\u06d2 \u0635\u0631\u0641 \u0627\u0646\u062f\u0627\u0632\u0648\u06ba \u067e\u0631 \u0628\u06be\u0631\u0648\u0633\u06c1 \u06a9\u0631\u062a\u0627 \u062a\u06be\u0627\u060c \u0644\u06cc\u06a9\u0646 \u0627\u0628 \u0648\u06c1 80% \u062f\u0631\u0633\u062a \u0646\u062a\u0627\u0626\u062c \u062d\u0627\u0635\u0644 \u06a9\u0631 \u0631\u06c1\u0627 \u06c1\u06d2\u06d4",
    "\u06cc\u06c1 \u0641\u06cc\u0686\u0631 \u0648\u06c1 \u06c1\u06d2 \u062c\u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u062a\u0631 \u0644\u0648\u06af \u0646\u0638\u0631 \u0627\u0646\u062f\u0627\u0632 \u06a9\u0631 \u062f\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba: IQ Quiz\u06d4 \u062c\u06cc \u06c1\u0627\u06ba\u060c \u0648\u06c1\u06cc \u06a9\u0648\u0626\u0632 \u062c\u0648 \u0622\u067e \u06a9\u06d2 \u0641\u0679\u0628\u0627\u0644 \u0639\u0644\u0645 \u06a9\u0648 AI \u0633\u06d2 \u062c\u0627\u0646\u0686\u062a\u0627 \u06c1\u06d2\u06d4 \u0644\u06cc\u06a9\u0646 \u0627\u0635\u0644 \u0628\u0627\u062a \u06cc\u06c1 \u06c1\u06d2 \u06a9\u06c1 \u0627\u0633 \u06a9\u0648\u0626\u0632 \u06a9\u06d2 \u0646\u062a\u0627\u0626\u062c \u0622\u067e \u06a9\u0648 \u0628\u062a\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0622\u067e \u06a9\u06cc \u0633\u0648\u0686 \u0645\u06cc\u06ba \u06a9\u06c1\u0627\u06ba \u06a9\u0645\u0632\u0648\u0631\u06cc \u06c1\u06d2\u06d4 \u062c\u0628 \u0622\u067e \u0627\u067e\u0646\u06cc \u063a\u0644\u0637\u06cc\u0648\u06ba \u06a9\u0648 \u0633\u0645\u062c\u06be \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u062a\u0648 \u0622\u067e \u06a9\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0627\u06ba \u062e\u0648\u062f \u0628\u062e\u0648\u062f \u0628\u06c1\u062a\u0631 \u06c1\u0648 \u062c\u0627\u062a\u06cc \u06c1\u06cc\u06ba\u06d4",
