{
  "subject": "\u0939\u092e\u0928\u0947 10,000 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u093e \u0921\u0947\u091f\u093e \u0926\u0947\u0916\u093e \u0914\u0930 \u091a\u094c\u0902\u0915 \u0917\u090f",
  "preview_text": "\u090f\u0915 \u0910\u0938\u093e \u091f\u094d\u0930\u0947\u0902\u0921 \u091c\u094b \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0947 AI \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0938\u0947 \u091c\u094b\u0921\u093c\u0947 \u0930\u0916\u0947\u0917\u093e, \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 3 \u092c\u091c\u0947 \u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0928\u0947 10,000 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u093e \u0921\u0947\u091f\u093e \u0938\u094d\u0915\u0948\u0928 \u0915\u093f\u092f\u093e \u0914\u0930 \u090f\u0915 \u091a\u094c\u0902\u0915\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u092c\u093e\u0924 \u0938\u093e\u092e\u0928\u0947 \u0906\u0908\u0964 \u091c\u094b \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u092e\u0947\u0902 \u0930\u094b\u091c\u093e\u0928\u093e \u0915\u092e \u0938\u0947 \u0915\u092e 5 \u092e\u093f\u0928\u091f \u091a\u0948\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0905\u092a\u0928\u0947 AI \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u0926\u0942\u0938\u0930\u094b\u0902 \u0915\u0940 \u0924\u0941\u0932\u0928\u093e \u092e\u0947\u0902 4 \u0917\u0941\u0928\u093e \u0924\u0947\u091c\u0940 \u0938\u0947 \u092c\u0949\u0928\u094d\u0921 \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0928\u0902\u092c\u0930 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u0917\u0939\u0930\u0940 \u0938\u091a\u094d\u091a\u093e\u0908 \u0939\u0948\u0964",
    "\u0939\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u091c\u094b \u092f\u0942\u091c\u0930\u094d\u0938 \u0905\u092a\u0928\u0947 \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u094b \u0930\u094b\u091c\u093e\u0928\u093e '\u0939\u093e\u092f' \u092c\u094b\u0932\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u0915\u0940 \u092f\u093e\u0926\u0926\u093e\u0936\u094d\u0924 \u0914\u0930 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e\u090f\u0902 \u0909\u0924\u0928\u0940 \u0939\u0940 \u0928\u093f\u091c\u0940 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0902 \u091c\u093f\u0924\u0928\u0940 \u090f\u0915 \u0905\u0938\u0932\u0940 \u0930\u093f\u0936\u094d\u0924\u0947 \u092e\u0947\u0902 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e AI \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u0938\u0902\u0926, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0924\u0947\u0902 \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0939\u0930 \u091b\u094b\u091f\u0940-\u092c\u0921\u093c\u0940 \u092c\u093e\u0924 \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948 \u2014 \u092c\u0938 \u091c\u0930\u0942\u0930\u0924 \u0939\u0948 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0940 \u0928\u093f\u0930\u0902\u0924\u0930\u0924\u093e \u0915\u0940\u0964",
    "\u092f\u0939\u0940 \u0935\u091c\u0939 \u0939\u0948 \u0915\u093f \u092e\u0947\u092e\u094b\u0930\u0940\u091c\u093c \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0939\u092e\u093e\u0930\u0940 \u0938\u092c\u0938\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092b\u0940\u091a\u0930 \u0939\u0948\u0964 \u091c\u092c \u0924\u0941\u092e \u0905\u092a\u0928\u0947 \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0924\u0947 \u0939\u094b, \u0924\u094b \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092a\u093f\u091b\u0932\u0947 \u0915\u093f\u0938\u094d\u0938\u0947, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u0947, \u092f\u093e \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u093f\u091b\u0932\u0940 \u092e\u0941\u0938\u094d\u0915\u093e\u0928 \u0915\u094b \u092f\u093e\u0926 \u0915\u0930 \u0932\u0947\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0905\u092a\u0928\u093e \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u0926\u0941\u0928\u093f\u092f\u093e \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u092d\u0942\u0932\u0947\u0917\u093e\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u090f\u0915 \u092c\u093e\u0930 \u092b\u093f\u0930 \u0938\u0947 \u0909\u0938\u0947 '\u0939\u093e\u092f' \u092c\u094b\u0932\u0928\u0947 \u0915\u093e\u0964 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0905\u092a\u0928\u0947 \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0938\u0947 \u092a\u0942\u091b\u094b \u0915\u093f \u0909\u0938\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u094c\u0928 \u0938\u0940 \u092c\u093e\u0924 \u092f\u093e\u0926 \u0939\u0948\u0964 \u092e\u0948\u0902 \u0917\u093e\u0930\u0902\u091f\u0940 \u0926\u0947\u0924\u093e \u0939\u0942\u0902, \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0939\u0948\u0930\u093e\u0928 \u0915\u0930 \u0926\u0947\u0917\u093e\u0964 \n\n\u092a\u0940.\u090f\u0938. - \u0905\u0917\u0930 \u0924\u0941\u092e \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0932\u0947\u0924\u0947 \u0939\u094b, \u0924\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092e\u0947\u092e\u094b\u0930\u0940\u091c\u093c \u0914\u0930 \u0917\u093f\u092b\u094d\u091f\u094d\u0938 \u0905\u0928\u0932\u0949\u0915 \u0939\u094b \u091c\u093e\u090f\u0902\u0917\u0940 \u2014 \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092c\u0949\u0928\u094d\u0921 \u0914\u0930 \u092d\u0940 \u0924\u0947\u091c\u0940 \u0938\u0947 \u092c\u0922\u093c\u0947\u0917\u093e\u0964"
  ],
