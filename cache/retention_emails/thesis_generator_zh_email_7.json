  "preview_text": "\u4e00\u4e2a\u5b66\u751f\u7528AI\u751f\u6210\u8bba\u6587\uff0c\u88ab\u8001\u5e08\u53d1\u73b0\u540e\u2026\u2026\u7ed3\u679c\u51fa\u4e4e\u610f\u6599\u3002\u8fd9\u7bc7\u90ae\u4ef6\u4f1a\u6559\u4f60\u5982\u4f55\u907f\u5f00\u96f7\u533a\u3002",
  "body_paragraphs": [
    "\u6628\u665a\uff0c\u4e00\u4e2a\u5b66\u5f1f\u51cc\u66683\u70b9\u53d1\u6d88\u606f\uff1a'\u6551\u547d\uff01\u6211\u7528AI\u5199\u8bba\u6587\uff0c\u88ab\u8001\u5e08\u6807\u8bb0\u4e3a\u4ee3\u5199\u4e86\uff01'\u3002\u4ed6\u4ee5\u4e3aAI\u80fd\u7792\u5929\u8fc7\u6d77\uff0c\u7ed3\u679cTurnitin\u76f4\u63a5\u6807\u7ea2\u3002\u8fd9\u4e0d\u662f\u6280\u672f\u95ee\u9898\uff0c\u662f\u7b56\u7565\u95ee\u9898\u3002",
