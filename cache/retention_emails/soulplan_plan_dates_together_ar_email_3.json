{
  "subject": "3 \u062f\u0642\u0627\u0626\u0642 \u0639\u0637\u0644\u062a \u062d\u064a\u0627\u062a\u0646\u0627",
  "preview_text": "\u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u062a\u0642\u0636\u064a 3 \u062f\u0642\u0627\u0626\u0642 \u0641\u0642\u0637 \u0641\u064a \u062a\u0637\u0628\u064a\u0642\u0646\u0627\u060c \u0648\u062a\u0631\u0649 \u0627\u0644\u0641\u0631\u0642 \u0641\u064a \u0639\u0644\u0627\u0642\u062a\u0643. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646.",
  "body_paragraphs": [
    "\u0623\u0639\u0644\u0645 \u0623\u0646\u0643 \u0645\u0634\u063a\u0648\u0644. \u0644\u0643\u0646 \u0647\u0644 \u062a\u0639\u0644\u0645 \u0623\u0646 3 \u062f\u0642\u0627\u0626\u0642 \u0641\u0642\u0637 \u0641\u064a \u062a\u0637\u0628\u064a\u0642\u0646\u0627 \u064a\u0645\u0643\u0646 \u0623\u0646 \u062a\u063a\u064a\u0631 \u0645\u0633\u0627\u0621\u0643 \u0628\u0627\u0644\u0643\u0627\u0645\u0644\u061f \u0641\u064a \u0625\u062d\u062f\u0649 \u0627\u0644\u0644\u064a\u0627\u0644\u064a\u060c \u062c\u0631\u0628\u062a \u0623\u0646\u0627 \u0648\u0634\u0631\u064a\u0643\u064a \u0647\u0630\u0647 \u0627\u0644\u062d\u064a\u0644\u0629 \u0627\u0644\u0628\u0633\u064a\u0637\u0629: \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0627\u0644\u062a\u0641\u0643\u064a\u0631 \u0641\u064a \u062e\u0637\u0637 \u0645\u0639\u0642\u062f\u0629\u060c \u0641\u062a\u062d\u0646\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u062e\u062a\u0631\u0646\u0627 \u0645\u0632\u0627\u062c '\u0645\u0631\u062d'\u060c \u0648\u0641\u064a 30 \u062b\u0627\u0646\u064a\u0629 \u0643\u0627\u0646\u062a \u0644\u062f\u064a\u0646\u0627 \u062e\u0637\u0629 \u062c\u0627\u0647\u0632\u0629. \u0627\u0644\u0641\u0631\u0642 \u0643\u0627\u0646 \u0645\u0630\u0647\u0644\u0627\u064b.",
    "\u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0644\u064a\u0633\u062a \u0641\u064a \u0642\u0644\u0629 \u0627\u0644\u0623\u0641\u0643\u0627\u0631\u060c \u0628\u0644 \u0641\u064a \u0627\u0644\u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u0630\u064a \u064a\u0633\u062a\u0646\u0632\u0641 \u0637\u0627\u0642\u062a\u0643. \u0645\u0639 '\u0645\u0648\u0639\u062f \u0627\u0644\u0644\u064a\u0644\u0629'\u060c \u0643\u0644 \u0645\u0627 \u0639\u0644\u064a\u0643 \u0647\u0648 \u0646\u0642\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0645\u0632\u0627\u062c \u0627\u0644\u0630\u064a \u064a\u0646\u0627\u0633\u0628\u0643\u0645\u0627\u060c \u0648\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u064a\u062e\u062a\u0627\u0631 \u0644\u0643 \u0641\u0643\u0631\u0629 \u0641\u0631\u064a\u062f\u0629. \u0644\u0627 \u062a\u0641\u0643\u064a\u0631\u060c \u0644\u0627 \u062a\u0631\u062a\u064a\u0628\u060c \u0644\u0627 \u0646\u062f\u0645.",
    "\u062a\u062e\u064a\u0644 \u0623\u0646 \u062a\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0644\u064a\u0644\u0629\u060c \u0648\u062a\u062c\u062f '\u0623\u0646\u062a \u0648[\u0634\u0631\u064a\u0643\u0643]' \u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629\u060c \u0645\u0639 \u0628\u0637\u0627\u0642\u0629 \u0645\u0648\u0639\u062f \u062c\u0627\u0647\u0632\u0629. \u0627\u062e\u062a\u0631 \u0627\u0644\u0645\u0632\u0627\u062c \u0627\u0644\u0630\u064a \u064a\u0639\u0643\u0633 \u062d\u0627\u0644\u062a\u0643\u0645\u0627: \u062f\u0627\u0641\u0626\u060c \u0645\u063a\u0627\u0645\u0631\u060c \u0645\u0631\u062d\u060c \u0623\u0648 \u0634\u0627\u0641\u064d. \u062e\u0644\u0627\u0644 30 \u062b\u0627\u0646\u064a\u0629\u060c \u0633\u064a\u0643\u0648\u0646 \u0644\u062f\u064a\u0643\u0645\u0627 \u062e\u0637\u0637 \u0645\u0644\u0645\u0648\u0633\u0629\u060c \u0648\u0643\u0623\u0646\u0645\u0627 \u0641\u0643\u0631 \u0623\u062d\u062f\u0643\u0645\u0627 \u0628\u0627\u0644\u0622\u062e\u0631.",
    "\u0627\u0641\u062a\u062d \u062a\u0637\u0628\u064a\u0642 SoulPlan \u0627\u0644\u0622\u0646\u060c \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 '\u0645\u0648\u0639\u062f \u0627\u0644\u0644\u064a\u0644\u0629'\u060c \u0648\u0627\u062e\u062a\u0631 \u0645\u0632\u0627\u062c\u064b\u0627. \u0641\u0642\u0637 30 \u062b\u0627\u0646\u064a\u0629\u060c \u0648\u0633\u062a\u0631\u0649 \u0627\u0644\u0641\u0631\u0642. P.S. \u0627\u0644\u0643\u062b\u064a\u0631 \u0645\u0646 \u0627\u0644\u0623\u0632\u0648\u0627\u062c \u064a\u0642\u0648\u0644\u0648\u0646 \u0625\u0646 \u0647\u0630\u0647 \u0627\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u0628\u0633\u064a\u0637\u0629 \u062c\u0639\u0644\u062a\u0647\u0645 \u064a\u0634\u0639\u0631\u0648\u0646 \u0628\u0623\u0646 \u0634\u0631\u064a\u0643\u0647\u0645 \u064a\u0641\u0643\u0631 \u0628\u0647\u0645 \u062d\u0642\u064b\u0627. \u062c\u0631\u0628\u0647\u0627 \u0648\u0642\u0644 \u0644\u064a \u0643\u064a\u0641 \u0643\u0627\u0646\u062a."
  ],
