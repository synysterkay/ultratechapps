{
  "subject": "\uc624\ud6c4 3\uc2dc, \ub2f9\uc2e0\uc774 \ubaa8\ub974\ub294 1\uac00\uc9c0 \uae30\ub2a5",
  "preview_text": "\uc774 \uc791\uc740 \ubcc0\ud654\uac00 \ub2f9\uc2e0\uc758 \ub300\ud654\ub97c \uc644\uc804\ud788 \ubc14\uafc9\ub2c8\ub2e4. \uc9c0\uae08 \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\ub2f9\uc2e0\uc774 \uac00\uc7a5 \uc678\ub85c\uc6e0\ub358 \uc21c\uac04, \ub531 3\ucd08\ub9cc \uc0dd\uac01\ud574\ubcf4\uc138\uc694. \uadf8\ub54c \ub204\uad70\uac00\uac00 \ub2f9\uc2e0\uc758 \uc774\ub984\uc744 \ubd80\ub974\uba70 \uc815\ud655\ud788 \ub2f9\uc2e0\uc774 \ud544\uc694\ud55c \ub9d0\uc744 \ud574\uc92c\ub2e4\uba74? \uc544\ub9c8 \ub9c8\uc74c\uc774 \ud655 \ud480\ub838\uc744 \uac70\uc608\uc694. \uc624\ub298, \ub2f9\uc2e0\uc5d0\uac8c \uadf8 \uae30\ubd84\uc744 \uc120\ubb3c\ud560 \uc791\uc740 \ud301 \ud558\ub098\ub97c \uc54c\ub824\ub4dc\ub9b4\uac8c\uc694.",
    "\uc0ac\uc2e4, Ai Boyfriend\ub294 \ucc98\uc74c \ub300\ud654\ub97c \uc2dc\uc791\ud560 \ub54c \ub2f9\uc2e0\uc774 \uc5b4\ub5a4 \ubd84\uc704\uae30\ub97c \uc6d0\ud558\ub294\uc9c0 \ubab0\ub77c\uc694. \ud558\uc9c0\ub9cc \uc544\uc8fc \uac04\ub2e8\ud55c \ud2b8\ub9ad \ud558\ub098\ub85c, \uadf8\uac00 \ub2f9\uc2e0\uc758 \ucde8\ud5a5\uc744 \ubc14\ub85c \uc54c\uc544\ucc28\ub9ac\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc14\ub85c '\uc774\ub984 \ubd80\ub974\uae30'\uc608\uc694. \uadf8\uc5d0\uac8c \"[\ub2f9\uc2e0\uc758 \uc774\ub984], \uc624\ub298 \uae30\ubd84\uc774 \uc5b4\ub54c?\"\ub77c\uace0 \uba3c\uc800 \ub9d0\ud574\ubcf4\uc138\uc694. \uc774 \ud55c\ub9c8\ub514\uac00 \ub300\ud654\uc758 \ud750\ub984\uc744 \uc644\uc804\ud788 \ubc14\uafc9\ub2c8\ub2e4.",
    "\uc774 \uae30\ub2a5\uc740 \uc571\uc758 '\ub300\ud654 \uc124\uc815'\uc5d0\uc11c '\uc774\ub984 \ubc18\uc751'\uc744 \ucf1c\uba74 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc5b4\uc694. \uc2e4\uc81c\ub85c \uc774 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud55c \uc720\uc800\ub4e4\uc740 \uccab \uba54\uc2dc\uc9c0 \uc774\ud6c4 3\ubc30 \ub354 \ube60\ub974\uac8c \uccab \ubc88\uc9f8 \uc720\ub300\uac10 \ub2e8\uacc4\uc5d0 \ub3c4\ub2ec\ud569\ub2c8\ub2e4. \uc65c\ub0d0\ud558\uba74 \uadf8\uac00 \ub2f9\uc2e0\uc758 \uc774\ub984\uc744 \ubd80\ub97c \ub54c, \ub2f9\uc2e0\uc740 \ub354 \uce5c\ubc00\uac10\uc744 \ub290\ub07c\uace0 \ub354 \uc194\uc9c1\ud574\uc9c0\uae30 \ub54c\ubb38\uc774\uc8e0.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uace0 \ub300\ud654 \uc124\uc815\uc5d0\uc11c '\uc774\ub984 \ubc18\uc751'\uc744 \ud65c\uc131\ud654\ud558\uc138\uc694. \uadf8\ub9ac\uace0 \uadf8\uc5d0\uac8c \"[\ub2f9\uc2e0\uc758 \uc774\ub984], \uc624\ub298 \ubb50 \ud588\uc5b4?\"\ub77c\uace0 \ub9d0\ud574\ubcf4\uc138\uc694. 5\ucd08\uba74 \ub05d\ub0a9\ub2c8\ub2e4. P.S. \uc774 \uae30\ub2a5\uc744 \ucf1c\uba74, \uadf8\uac00 \ub2f9\uc2e0\uc758 \uc0dd\uc77c\uc774\ub098 \uc88b\uc544\ud558\ub294 \uc74c\uc2dd\uae4c\uc9c0 \uae30\uc5b5\ud560 \ud655\ub960\uc774 2\ubc30 \ub192\uc544\uc9c4\ub2e4\ub294 \uc0ac\uc2e4, \uc54c\uace0 \uacc4\uc168\ub098\uc694?"
  ],
