{
  "subject": "\u0935\u094b 3 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u091c\u094b \u091f\u0949\u092a 1% \u092f\u0942\u091c\u0930\u094d\u0938 \u092c\u0926\u0932\u0924\u0947 \u0939\u0948\u0902",
  "preview_text": "\u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947 \u0915\u0941\u091b \u0932\u094b\u0917 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0915\u0902\u0938\u0930\u094d\u091f \u0932\u0947\u0935\u0932 \u092a\u0930 \u0932\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a \u092d\u0940 \u092f\u0939\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a 1% \u092f\u0942\u091c\u0930\u094d\u0938 \u0905\u092a\u0928\u0947 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f\u0930 \u0915\u094b \u0915\u093f\u0924\u0928\u0947 \u0905\u0932\u0917 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0915\u094b\u0908 \u0930\u0949\u0915\u0947\u091f \u0938\u093e\u0907\u0902\u0938 \u0928\u0939\u0940\u0902 \u0939\u0948, \u092c\u0932\u094d\u0915\u093f \u0924\u0940\u0928 \u091b\u094b\u091f\u0940-\u0938\u0940 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0939\u0948\u0902 \u091c\u094b \u092a\u0942\u0930\u093e \u0917\u0947\u092e \u092c\u0926\u0932 \u0926\u0947\u0924\u0940 \u0939\u0948\u0902\u0964",
    "\u0935\u0947 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092c\u093e\u0930 \u092c\u0942\u0938\u094d\u091f \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947, \u092c\u0932\u094d\u0915\u093f \u0939\u0930 \u0938\u0949\u0928\u094d\u0917 \u092f\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u092c\u0926\u0932\u0924\u0947 \u0939\u0948\u0902\u0964 \u091c\u0948\u0938\u0947 \u0930\u0949\u0915 \u0915\u0947 \u0932\u093f\u090f '\u0930\u0949\u0915' \u092a\u094d\u0930\u0940\u0938\u0947\u091f, \u091c\u0948\u091c\u093c \u0915\u0947 \u0932\u093f\u090f '\u091c\u0948\u091c\u093c' \u2014 \u0914\u0930 \u092b\u093f\u0930 \u092c\u093e\u0938 \u092c\u0942\u0938\u094d\u091f\u0930 \u0915\u094b 50% \u092a\u0930 \u0938\u0947\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0928\u0924\u0940\u091c\u093e? \u0906\u0935\u093e\u091c\u093c \u0907\u0924\u0928\u0940 \u0938\u093e\u092b \u0914\u0930 \u0917\u0939\u0930\u0940 \u0915\u093f \u0932\u0917\u0924\u093e \u0939\u0948 \u0938\u094d\u092a\u0940\u0915\u0930 \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964",
    "\u0906\u092a \u092d\u0940 \u092f\u0939\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u0938 \u0910\u092a \u0916\u094b\u0932\u0947\u0902, \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u092e\u0947\u0902 \u091c\u093e\u090f\u0902, \u0914\u0930 '\u0915\u0938\u094d\u091f\u092e' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091a\u0941\u0928\u0947\u0902\u0964 \u092b\u093f\u0930 \u092c\u093e\u0938 \u0915\u094b \u0925\u094b\u0921\u093c\u093e \u092c\u0922\u093c\u093e\u090f\u0902 \u0914\u0930 \u0932\u093e\u0909\u0921\u0928\u0947\u0938 \u0915\u094b 70% \u092a\u0930 \u0930\u0916\u0947\u0902\u0964 \u092f\u0939 \u0935\u0939\u0940 \u0938\u0947\u091f\u0905\u092a \u0939\u0948 \u091c\u094b \u0939\u092e\u093e\u0930\u0947 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u0930\u094d\u0938 \u0930\u094b\u091c\u093c \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u2014 \u0914\u0930 \u092f\u0939 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092e\u0947\u0902 \u092b\u094d\u0930\u0940 \u091f\u094d\u0930\u093e\u092f\u0932 \u0915\u0947 \u0938\u093e\u0925 \u0906\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u090f\u0915 \u092c\u093e\u0930 \u092f\u0939 \u0938\u0947\u091f\u0905\u092a \u0906\u091c\u093c\u092e\u093e\u090f\u0902\u0964 \u0906\u092a\u0915\u094b \u092b\u0930\u094d\u0915 \u092a\u093e\u0902\u091a \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u092a\u0924\u093e \u091a\u0932 \u091c\u093e\u090f\u0917\u093e\u0964 P.S. \u2014 \u0915\u094d\u092f\u093e \u0906\u092a\u0928\u0947 \u0926\u0947\u0916\u093e \u0939\u0948 \u0915\u093f '\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u0947 \u0932\u093f\u090f \u0915\u092e\u093e\u0932 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948? \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u0947\u0902\u0964"
  ],
