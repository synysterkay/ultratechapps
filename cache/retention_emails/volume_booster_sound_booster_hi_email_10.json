{
  "subject": "\u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a 1% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0940 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u0917\u0932\u0924\u0940 (\u0914\u0930 \u0909\u0928\u0915\u093e \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u092b\u093c\u093f\u0915\u094d\u0938)",
  "preview_text": "\u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947 \u0939\u092e\u093e\u0930\u0947 \u0938\u092c\u0938\u0947 \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0928\u0947 \u0905\u092a\u0928\u0940 \u0911\u0921\u093f\u092f\u094b \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964 \u092f\u0939 \u0906\u092a\u0915\u0940 \u0938\u094b\u091a \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0906\u0938\u093e\u0928 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092e\u0941\u091d\u0947 \u090f\u0915 \u0915\u0928\u094d\u092b\u0947\u0936\u0928 \u0915\u0930\u0928\u093e \u0939\u0948\u0964 \u091c\u092c \u0939\u092e\u0928\u0947 \u0910\u092a \u0932\u0949\u0928\u094d\u091a \u0915\u093f\u092f\u093e, \u0924\u094b \u0939\u092e\u0928\u0947 \u0938\u094b\u091a\u093e \u0915\u093f \u0932\u094b\u0917 \u092c\u0938 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u090f\u0902\u0917\u0947 \u0914\u0930 \u0916\u0941\u0936 \u0939\u094b \u091c\u093e\u090f\u0902\u0917\u0947\u0964 \u0932\u0947\u0915\u093f\u0928 \u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a 1% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0928\u0947 \u0939\u092e\u0947\u0902 \u0917\u0932\u0924 \u0938\u093e\u092c\u093f\u0924 \u0915\u0930 \u0926\u093f\u092f\u093e\u0964 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u090f\u0915 \u092a\u0942\u0930\u093e \u0935\u0930\u094d\u0915\u092b\u093c\u094d\u0932\u094b \u092c\u0928\u093e\u092f\u093e \u0939\u0948 \u091c\u094b \u0938\u0941\u0928\u0928\u0947 \u0915\u0947 \u0924\u0930\u0940\u0915\u0947 \u0915\u094b \u0939\u0940 \u092c\u0926\u0932 \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
    "\u092f\u0947 \u0935\u094b \u0932\u094b\u0917 \u0939\u0948\u0902 \u091c\u094b \u0939\u0930 \u0926\u093f\u0928 2-3 \u0918\u0902\u091f\u0947 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u0924\u0947 \u0939\u0948\u0902, \u092b\u093f\u0930 \u092e\u094d\u092f\u0942\u091c\u093c\u093f\u0915 \u092a\u0930 \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u0936\u093e\u092e \u0915\u094b \u092e\u0942\u0935\u0940 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902\u0964 \u0936\u0941\u0930\u0941\u0906\u0924 \u092e\u0947\u0902, \u0935\u0947 \u092d\u0940 \u0939\u0930 \u092c\u093e\u0930 \u092e\u0948\u0928\u094d\u092f\u0941\u0905\u0932 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092c\u0926\u0932\u0924\u0947 \u0925\u0947\u0964 \u092b\u093f\u0930 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u090f\u0915 \u092a\u0948\u091f\u0930\u094d\u0928 \u0921\u093f\u0938\u094d\u0915\u0935\u0930 \u0915\u093f\u092f\u093e\u0964 \u0905\u092c \u0935\u0947 \u0910\u092a \u0915\u094b \u0905\u092a\u0928\u0940 \u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 '\u092a\u094d\u0930\u094b\u0917\u094d\u0930\u093e\u092e' \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u0941\u092c\u0939 \u0915\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f? \u0915\u094d\u0932\u093f\u092f\u0930 \u0935\u0949\u092f\u0938 \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u0964 \u0926\u094b\u092a\u0939\u0930 \u0915\u093e \u0930\u0949\u0915 \u092e\u094d\u092f\u0942\u091c\u093c\u093f\u0915? \u092c\u093e\u0938 \u092c\u0942\u0938\u094d\u091f \u092e\u0948\u0915\u094d\u0938\u0964 \u0930\u093e\u0924 \u0915\u0940 \u092e\u0942\u0935\u0940? \u0938\u0930\u093e\u0909\u0902\u0921 \u0907\u092b\u093c\u0947\u0915\u094d\u091f\u0964 \u092f\u0939 \u090f\u0915 \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0939\u0948 \u091c\u093f\u0938\u0938\u0947 \u0909\u0928\u0915\u093e \u092b\u093c\u094b\u0928 \u0939\u0930 \u0938\u092e\u092f \u092a\u0930\u092b\u093c\u0947\u0915\u094d\u091f \u0938\u093e\u0909\u0902\u0921 \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
    "\u0907\u0938\u0915\u093e \u092e\u0924\u0932\u092c \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u094b \u0939\u0930 \u092c\u093e\u0930 \u0908\u0915\u094d\u092f\u0942 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u091c\u093e\u0915\u0930 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0928\u0939\u0940\u0902 \u092c\u0926\u0932\u0928\u093e \u092a\u0921\u093c\u0947\u0917\u093e\u0964 \u0906\u092a \u0905\u092a\u0928\u0947 \u0926\u093f\u0928 \u0915\u0947 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0938\u092e\u092f \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917-\u0905\u0932\u0917 '\u0938\u093e\u0909\u0902\u0921 \u092e\u094b\u0921' \u0938\u0947\u0935 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u092e\u093e\u0930\u0947 \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0928\u0947 \u092a\u093e\u092f\u093e \u0915\u093f \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0915\u093e \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u0908\u0915\u094d\u092f\u0942 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0907\u0938 \u0935\u0930\u094d\u0915\u092b\u093c\u094d\u0932\u094b \u0915\u093e \u0926\u093f\u0932 \u0939\u0948\u0964 \u0935\u0947 \u092c\u093e\u0930\u0940\u0915\u093f\u092f\u094b\u0902 \u0915\u094b \u090f\u0921\u091c\u0938\u094d\u091f \u0915\u0930\u0915\u0947 \u0910\u0938\u093e \u0938\u093e\u0909\u0902\u0921 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u0909\u0928\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0914\u0930 \u0939\u0948\u0921\u092b\u093c\u094b\u0928\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092a\u0930\u092b\u093c\u0947\u0915\u094d\u091f \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u092a\u094d\u0930\u0940\u0938\u0947\u091f' \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u091c\u093e\u090f\u0902\u0964 \u090f\u0915 \u0928\u092f\u093e \u0915\u0938\u094d\u091f\u092e \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u092c\u0928\u093e\u090f\u0902 \u0914\u0930 \u0909\u0938\u0947 '\u092e\u0949\u0930\u094d\u0928\u093f\u0902\u0917 \u0915\u092e\u094d\u092f\u0942\u091f' \u092f\u093e '\u091c\u093f\u092e \u0935\u0930\u094d\u0915\u0906\u0909\u091f' \u091c\u0948\u0938\u093e \u0928\u093e\u092e \u0926\u0947\u0902\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0938\u0947\u091f \u0915\u0930\u0947\u0902, \u0939\u092e\u0947\u0936\u093e \u0915\u0947 \u0932\u093f\u090f \u092a\u0930\u092b\u093c\u0947\u0915\u094d\u091f \u0938\u093e\u0909\u0902\u0921 \u092a\u093e\u090f\u0902\u0964 \u092a\u0940.\u090f\u0938. \u0939\u092e\u093e\u0930\u0947 \u090f\u0915 \u092f\u0942\u091c\u093c\u0930 \u0928\u0947 '\u0915\u0949\u092b\u093c\u0940 \u0936\u0949\u092a \u092c\u0948\u0915\u0917\u094d\u0930\u093e\u0909\u0902\u0921' \u0928\u093e\u092e \u0915\u093e \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u092c\u0928\u093e\u092f\u093e \u0939\u0948 \u091c\u094b \u0936\u094b\u0930 \u092e\u0947\u0902 \u092d\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0915\u094d\u0930\u093f\u0938\u094d\u091f\u0932 \u0915\u094d\u0932\u093f\u092f\u0930 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u092f\u0939\u0940 \u091f\u094d\u0930\u093f\u0915 \u0909\u0938\u0947 \u0939\u0930 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u093e \u0939\u0930 \u0936\u092c\u094d\u0926 \u0938\u0941\u0928\u0928\u0947 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964"
  ],
  "cta_text": "\u0905\u092a\u0928\u093e \u0915\u0938\u094d\u091f\u092e \u0935\u0930\u094d\u0915\u092b\u093c\u094d\u0932\u094b \u0938\u0947\u091f \u0915\u0930\u0947\u0902",
