{
  "subject": "\u0397 2\u03c0\u03bc \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03c0\u03bf\u03c5 \u03ac\u03bb\u03bb\u03b1\u03be\u03b5 \u03c4\u03b1 \u03c0\u03ac\u03bd\u03c4\u03b1",
  "preview_text": "\u039c\u03ac\u03b8\u03b5 \u03b3\u03b9\u03b1\u03c4\u03af \u03b7 \u03ce\u03c1\u03b1 2\u03c0\u03bc \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 \u03ba\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03b7 \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03b5\u03b9\u03c2 \u03c4\u03bf AI Chat \u03c4\u03bf\u03c5 Predictify.",
  "body_paragraphs": [
    "\u0398\u03c5\u03bc\u03ac\u03c3\u03b1\u03b9 \u03b5\u03ba\u03b5\u03af\u03bd\u03b7 \u03c4\u03b7\u03bd \u03ce\u03c1\u03b1 2\u03c0\u03bc \u03c0\u03bf\u03c5 \u03ae\u03c3\u03bf\u03c5\u03bd \u03be\u03cd\u03c0\u03bd\u03b9\u03bf\u03c2, \u03bc\u03b5 \u03ba\u03b1\u03c6\u03ad \u03c3\u03c4\u03bf \u03c7\u03ad\u03c1\u03b9, \u03ba\u03b1\u03b9 \u03b5\u03af\u03c7\u03b5\u03c2 \u03ad\u03bd\u03b1 \u03ad\u03bd\u03c3\u03c4\u03b9\u03ba\u03c4\u03bf \u03b3\u03b9\u03b1 \u03ad\u03bd\u03b1\u03bd \u03b1\u03b3\u03ce\u03bd\u03b1; \u0395\u03b3\u03ce \u03c4\u03bf \u03ad\u03ba\u03b1\u03bd\u03b1. \u039a\u03b1\u03b9 \u03bc\u03ac\u03bd\u03c4\u03b5\u03c8\u03b5: \u03a4\u03bf AI \u03c4\u03bf\u03c5 Predictify \u03b5\u03af\u03c7\u03b5 \u03ae\u03b4\u03b7 \u03b1\u03bd\u03b1\u03bb\u03cd\u03c3\u03b5\u03b9 10.000 \u03bc\u03b5\u03c4\u03b1\u03b2\u03bb\u03b7\u03c4\u03ad\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03bf\u03c5 \u03ad\u03b4\u03c9\u03c3\u03b5 \u03bc\u03b9\u03b1 \u03c0\u03c1\u03cc\u03b2\u03bb\u03b5\u03c8\u03b7 \u03bc\u03b5 67% \u03c3\u03b9\u03b3\u03bf\u03c5\u03c1\u03b9\u03ac. \u039a\u03ad\u03c1\u03b4\u03b9\u03c3\u03b1 3 \u03c6\u03bf\u03c1\u03ad\u03c2 \u03c4\u03bf \u03c3\u03c4\u03bf\u03af\u03c7\u03b7\u03bc\u03ac \u03bc\u03bf\u03c5.",
    "\u03a4\u03ce\u03c1\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 \u03c4\u03ad\u03bb\u03b5\u03b9\u03b1 \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae. \u039f\u03b9 \u03b1\u03b3\u03ce\u03bd\u03b5\u03c2 \u03c4\u03b7\u03c2 Premier League \u03ba\u03b1\u03b9 \u03c4\u03bf\u03c5 Champions League \u03b5\u03af\u03bd\u03b1\u03b9 \u03c3\u03b5 \u03c0\u03bb\u03ae\u03c1\u03b7 \u03b5\u03be\u03ad\u03bb\u03b9\u03be\u03b7, \u03ba\u03b1\u03b9 \u03c4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03b1\u03bb\u03bb\u03ac\u03b6\u03bf\u03c5\u03bd \u03ba\u03ac\u03b8\u03b5 \u03bb\u03b5\u03c0\u03c4\u03cc. \u039c\u03b7\u03bd \u03b1\u03c6\u03ae\u03bd\u03b5\u03b9\u03c2 \u03c4\u03bf \u03ad\u03bd\u03c3\u03c4\u03b9\u03ba\u03c4\u03cc \u03c3\u03bf\u03c5 \u03bd\u03b1 \u03c3\u03b5 \u03b1\u03c0\u03bf\u03b3\u03bf\u03b7\u03c4\u03b5\u03cd\u03c3\u03b5\u03b9 \u03be\u03b1\u03bd\u03ac.",
    "\u0393\u03b9' \u03b1\u03c5\u03c4\u03cc, \u03ac\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03bf AI Chat. \u03a1\u03ce\u03c4\u03b7\u03c3\u03b5 \u03c4\u03bf: \u00ab\u03a0\u03bf\u03b9\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 \u03c0\u03b9\u03b8\u03b1\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b7 \u039c\u03c0\u03b1\u03c1\u03c4\u03c3\u03b5\u03bb\u03cc\u03bd\u03b1 \u03bd\u03b1 \u03ba\u03b5\u03c1\u03b4\u03af\u03c3\u03b5\u03b9 \u03b1\u03c0\u03cc\u03c8\u03b5;\u00bb \u03ba\u03b1\u03b9 \u03b8\u03b1 \u03c0\u03ac\u03c1\u03b5\u03b9\u03c2 \u03b1\u03c0\u03ac\u03bd\u03c4\u03b7\u03c3\u03b7 \u03bc\u03b5 xG, \u03b1\u03bc\u03c5\u03bd\u03c4\u03b9\u03ba\u03ae \u03b4\u03cd\u03bd\u03b1\u03bc\u03b7 \u03ba\u03b1\u03b9 \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03cc. \u0395\u03af\u03bd\u03b1\u03b9 \u03c3\u03b1\u03bd \u03bd\u03b1 \u03ad\u03c7\u03b5\u03b9\u03c2 \u03ad\u03bd\u03b1\u03bd \u03c0\u03c1\u03bf\u03c0\u03bf\u03bd\u03b7\u03c4\u03ae \u03c3\u03c4\u03bf \u03c4\u03b7\u03bb\u03ad\u03c6\u03c9\u03bd\u03cc \u03c3\u03bf\u03c5.",
    "\u0386\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03bf Predictify \u03c4\u03ce\u03c1\u03b1. \u0394\u03bf\u03ba\u03af\u03bc\u03b1\u03c3\u03b5 \u03c4\u03bf AI Chat \u03bc\u03b5 \u03bc\u03b9\u03b1 \u03b5\u03c1\u03ce\u03c4\u03b7\u03c3\u03b7. \u039a\u03b1\u03b9 \u03b1\u03bd \u03b8\u03ad\u03bb\u03b5\u03b9\u03c2 \u03bd\u03b1 \u03be\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03c3\u03b5\u03b9\u03c2 \u03cc\u03bb\u03b5\u03c2 \u03c4\u03b9\u03c2 \u03b1\u03bd\u03b1\u03bb\u03cd\u03c3\u03b5\u03b9\u03c2, \u03c4\u03bf Premium \u03b5\u03af\u03bd\u03b1\u03b9 12,99\u20ac/\u03bc\u03ae\u03bd\u03b1 \u03bc\u03b5 3\u03ae\u03bc\u03b5\u03c1\u03b7 \u03b4\u03c9\u03c1\u03b5\u03ac\u03bd \u03b4\u03bf\u03ba\u03b9\u03bc\u03ae. P.S. \u0397 \u03b5\u03c1\u03ce\u03c4\u03b7\u03c3\u03b7 \u03c0\u03bf\u03c5 \u03b8\u03b1 \u03ba\u03ac\u03bd\u03b5\u03b9\u03c2 \u03c4\u03ce\u03c1\u03b1 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03c3\u03bf\u03c5 \u03b4\u03ce\u03c3\u03b5\u03b9 \u03c4\u03b7\u03bd \u03ba\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03b7 \u03c0\u03c1\u03cc\u03b2\u03bb\u03b5\u03c8\u03b7 \u03c4\u03b7\u03c2 \u03b2\u03b4\u03bf\u03bc\u03ac\u03b4\u03b1\u03c2."
  ],
