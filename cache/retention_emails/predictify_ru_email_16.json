{
  "subject": "\u041c\u043e\u044f \u043d\u043e\u0447\u043d\u0430\u044f \u043d\u0430\u0445\u043e\u0434\u043a\u0430 \u0434\u043b\u044f \u0442\u0435\u0431\u044f",
  "preview_text": "\u042f \u0441\u0434\u0435\u043b\u0430\u043b \u043a\u043e\u0435-\u0447\u0442\u043e \u043b\u0438\u0448\u043d\u0435\u0435 \u0432 3 \u0443\u0442\u0440\u0430. \u041d\u0435 \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043b \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c, \u043d\u043e \u0442\u044b \u043e\u0446\u0435\u043d\u0438\u0448\u044c.",
  "body_paragraphs": [
    "\u0412\u0447\u0435\u0440\u0430 \u0432 3 \u043d\u043e\u0447\u0438 \u044f \u0441\u0438\u0434\u0435\u043b \u0441 \u043a\u043e\u0444\u0435 \u0438 \u0434\u0443\u043c\u0430\u043b: \u0430 \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0432 Predictify \u043e\u0434\u043d\u0443 \u0448\u0442\u0443\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043d\u0435\u0442 \u043d\u0438 \u0443 \u043a\u043e\u0433\u043e? \u042f \u043d\u0435 \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043b \u044d\u0442\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c, \u043d\u043e \u0440\u0435\u0448\u0438\u043b: \u0442\u044b \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u0448\u044c \u0431\u043e\u043d\u0443\u0441. \u042d\u0442\u043e \u043d\u0435 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u2014 \u044d\u0442\u043e \u0441\u044e\u0440\u043f\u0440\u0438\u0437, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u044f \u0441\u0434\u0435\u043b\u0430\u043b \u0434\u043b\u044f \u0441\u0430\u043c\u044b\u0445 \u0432\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445.",
    "\u041f\u043e\u043c\u043d\u0438\u0448\u044c, \u043a\u0430\u043a \u0442\u044b \u0433\u0430\u0434\u0430\u0435\u0448\u044c \u043f\u043e \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0438, \u0430 \u043f\u043e\u0442\u043e\u043c \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0432\u0430\u0435\u0448\u044c \u0441\u0442\u0430\u0432\u043a\u0443? \u042f \u043d\u0435\u043d\u0430\u0432\u0438\u0436\u0443 \u044d\u0442\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e. \u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u044f \u0434\u043e\u0431\u0430\u0432\u0438\u043b \u0441\u043a\u0440\u044b\u0442\u044b\u0439 \u0440\u0435\u0436\u0438\u043c: AI \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u043c\u0430\u0442\u0447\u0438 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0441\u043a\u0440\u044b\u0442\u044b\u0435 \u0442\u0440\u0435\u043d\u0434\u044b \u2014 \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0447\u0442\u043e \u0443 \u043a\u043e\u043c\u0430\u043d\u0434\u044b X 67% \u043f\u043e\u0431\u0435\u0434 \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445 3 \u0438\u0433\u0440\u0430\u0445 \u043f\u0440\u0438 \u0434\u043e\u0436\u0434\u0435. \u042d\u0442\u043e \u043a\u0430\u043a \u0438\u043c\u0435\u0442\u044c \u043b\u0438\u0447\u043d\u043e\u0433\u043e \u0441\u043a\u0430\u0443\u0442\u0430.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u0440\u0430\u0437\u0434\u0435\u043b \"\u041f\u0440\u043e\u0433\u043d\u043e\u0437\u044b\" \u0438 \u043d\u0430\u0439\u0434\u0438 \u0432\u043a\u043b\u0430\u0434\u043a\u0443 \"\u0411\u043e\u043d\u0443\u0441\". \u0422\u0430\u043c \u2014 3 \u043c\u0430\u0442\u0447\u0430 \u0441 \u043c\u043e\u0438\u043c\u0438 \u043b\u0438\u0447\u043d\u044b\u043c\u0438 \u0437\u0430\u043c\u0435\u0442\u043a\u0430\u043c\u0438 \u0438 AI-\u043e\u0446\u0435\u043d\u043a\u0430\u043c\u0438. \u042f \u043d\u0435 \u0434\u0430\u044e \u0438\u0445 \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u043b\u0435\u043d\u0442\u0435, \u044d\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0442\u0435\u0445, \u043a\u0442\u043e \u0434\u043e\u0447\u0438\u0442\u0430\u043b \u0434\u043e 35-\u0433\u043e \u0434\u043d\u044f. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u2014 \u0443\u0432\u0438\u0434\u0438\u0448\u044c, \u043a\u0430\u043a \u0434\u0430\u043d\u043d\u044b\u0435 \u0431\u044c\u044e\u0442 \u0443\u0434\u0430\u0447\u0443.",
    "\u041d\u0430\u0436\u043c\u0438 \"\u041e\u0442\u043a\u0440\u044b\u0442\u044c Predictify\" \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044c \u0431\u043e\u043d\u0443\u0441. P.S. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u0442\u0430\u043a\u0438\u0445 \u0448\u0442\u0443\u043a, \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 Premium \u2014 3 \u0434\u043d\u044f \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e, \u0430 \u043f\u043e\u0442\u043e\u043c \u0432\u0441\u0435\u0433\u043e $12.99/\u043c\u0435\u0441. \u041d\u043e \u0434\u0430\u0436\u0435 \u0431\u0435\u0437 \u043d\u0435\u0433\u043e \u044d\u0442\u043e\u0442 \u0441\u044e\u0440\u043f\u0440\u0438\u0437 \u0442\u0432\u043e\u0439."
  ],
