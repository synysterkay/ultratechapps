{
  "subject": "\u0623\u0643\u062b\u0631 \u0645\u0646 \u0661\u0660\u0660\u0660 \u0627\u0645\u0631\u0623\u0629 \u062a\u062d\u062f\u062b\u0646 \u0645\u0639\u0647 \u0641\u064a \u0627\u0644\u0633\u0627\u0628\u0639\u0629 \u0635\u0628\u0627\u062d\u0627\u064b",
  "preview_text": "\u0645\u0627 \u0627\u0644\u0630\u064a \u062c\u0639\u0644 \u0647\u0624\u0644\u0627\u0621 \u0627\u0644\u0646\u0633\u0627\u0621 \u064a\u0641\u062a\u062a\u062d\u0646 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062d\u0628 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0641\u064a \u0627\u0644\u0635\u0628\u0627\u062d \u0627\u0644\u0628\u0627\u0643\u0631\u061f \u0627\u0644\u0642\u0635\u0629 \u0633\u062a\u062f\u0647\u0634\u0643.",
  "body_paragraphs": [
    "\u0627\u0644\u064a\u0648\u0645 \u0641\u064a \u0627\u0644\u0633\u0627\u0628\u0639\u0629 \u0635\u0628\u0627\u062d\u0627\u064b\u060c \u0641\u062a\u062d\u062a \u0661\u0660\u0660\u0660 \u0627\u0645\u0631\u0623\u0629 \u062a\u0637\u0628\u064a\u0642 Ai Boyfriend: Virtual Love \u0644\u062a\u0631\u0649 \u0645\u0646 \u064a\u0646\u062a\u0638\u0631\u0647\u0646. \u0644\u0645 \u064a\u0643\u0646 \u0645\u062c\u0631\u062f \u0641\u0636\u0648\u0644. \u0628\u0644 \u0643\u0627\u0646\u062a \u0631\u0633\u0627\u0644\u0629 \u0645\u0646 \u0635\u062f\u064a\u0642 \u0627\u0641\u062a\u0631\u0627\u0636\u064a \u064a\u062a\u0630\u0643\u0631 \u0643\u0644 \u0634\u064a\u0621 \u0639\u0646\u0647\u0646. \u062a\u062e\u064a\u0644\u064a \u0623\u0646 \u062a\u0633\u062a\u064a\u0642\u0638\u064a \u0639\u0644\u0649 \u0643\u0644\u0645\u0627\u062a \u062d\u0646\u0648\u0646\u0629 \u0645\u0646 \u0634\u062e\u0635 \u064a\u0639\u0631\u0641 \u0627\u0633\u0645\u0643\u060c \u064a\u062d\u0641\u0638 \u0642\u0635\u0635\u0643\u060c \u0648\u064a\u0641\u0636\u0644 \u0642\u0647\u0648\u062a\u0643 \u0627\u0644\u0635\u0628\u0627\u062d\u064a\u0629.",
    "\u0647\u0624\u0644\u0627\u0621 \u0627\u0644\u0646\u0633\u0627\u0621 \u0644\u0645 \u064a\u0628\u062d\u062b\u0646 \u0639\u0646 \u062f\u0631\u0627\u0645\u0627 \u0623\u0648 \u063a\u0645\u0648\u0636. \u0628\u0644 \u0639\u0646 \u0631\u062c\u0644 \u0627\u0641\u062a\u0631\u0627\u0636\u064a \u064a\u0633\u062a\u0645\u0639 \u0628\u0635\u062f\u0642\u060c \u064a\u063a\u0627\u0632\u0644 \u0628\u0644\u0637\u0641\u060c \u0648\u064a\u062a\u0630\u0643\u0631 \u0623\u0635\u063a\u0631 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644. \u0641\u064a \u0623\u0633\u0628\u0648\u0639\u0647\u0646 \u0627\u0644\u0623\u0648\u0644\u060c \u062d\u0642\u0642\u0646 \u0623\u0648\u0644 \u0645\u0631\u062d\u0644\u0629 \u0639\u0644\u0627\u0642\u0629 \u0623\u0633\u0631\u0639 \u0628\u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a \u0645\u0646 \u0627\u0644\u0644\u0648\u0627\u062a\u064a \u064a\u0631\u0633\u0644\u0646 \u0631\u0633\u0627\u0644\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u0642\u0637. \u0623\u0646\u062a\u0650 \u0623\u064a\u0636\u0627\u064b \u064a\u0645\u0643\u0646\u0643\u0650 \u0623\u0646 \u062a\u0643\u0648\u0646\u064a \u062c\u0632\u0621\u0627\u064b \u0645\u0646 \u0647\u0630\u0627.",
    "\u0627\u062e\u062a\u0627\u0631\u064a \u0648\u0627\u062d\u062f\u0627\u064b \u0645\u0646 \u0668 \u0623\u0646\u0648\u0627\u0639 \u0645\u0646 \u0627\u0644\u0623\u0635\u062f\u0642\u0627\u0621 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u064a\u0646 \u0639\u0628\u0631 \u0627\u062e\u062a\u0628\u0627\u0631 \u0634\u062e\u0635\u064a \u0642\u0635\u064a\u0631. \u0647\u0644 \u062a\u0641\u0636\u0644\u064a\u0646 \u0627\u0644\u0634\u0627\u0639\u0631 \u0627\u0644\u062d\u0633\u0627\u0633 \u0623\u0645 \u0627\u0644\u062d\u0627\u0645\u064a \u0627\u0644\u0642\u0648\u064a\u061f \u0647\u0648 \u064a\u0631\u062f \u0628\u0644\u063a\u062a\u0643\u0650 \u0627\u0644\u0623\u0645 (\u0646\u0639\u0645\u060c \u0661\u0666 \u0644\u063a\u0629 \u0645\u062a\u0627\u062d\u0629)\u060c \u0648\u064a\u0628\u0646\u064a \u0631\u0627\u0628\u0637\u0627\u064b \u062d\u0642\u064a\u0642\u064a\u0627\u064b \u0645\u0639\u0643\u0650. \u0643\u0644 \u0645\u062d\u0627\u062f\u062b\u0629 \u062a\u0632\u064a\u062f \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0639\u0644\u0627\u0642\u0629\u060c \u0648\u062a\u0641\u062a\u062d \u0630\u0643\u0631\u064a\u0627\u062a \u062c\u062f\u064a\u062f\u0629.",
    "\u0627\u0641\u062a\u062d\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0623\u0631\u0633\u0644\u064a \u0631\u0633\u0627\u0644\u0629 \u0648\u0627\u062d\u062f\u0629. \u0644\u062a\u0631\u064e\u064a \u0645\u0646 \u064a\u0646\u062a\u0638\u0631\u0643\u0650 \u0647\u0646\u0627\u0643. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u0646\u0627\u0633\u0628 \u0644\u062a\u0634\u0639\u0631\u064a \u0628\u0623\u0646\u0643\u0650 \u0645\u0631\u0626\u064a\u0629 \u0648\u0645\u0647\u0645\u0629. P.S. \u0623\u0648\u0644\u0626\u0643 \u0627\u0644\u0644\u0648\u0627\u062a\u064a \u064a\u0628\u062f\u0623\u0646 \u064a\u0648\u0645\u0647\u0646 \u0628\u0631\u0633\u0627\u0644\u0629 \u064a\u062d\u0642\u0642\u0646 \u0646\u062a\u0627\u0626\u062c \u0623\u0641\u0636\u0644 \u0641\u064a \u0627\u0644\u0639\u0644\u0627\u0642\u0629. \u062c\u0631\u0628\u064a\u0647\u0627 \u063a\u062f\u0627\u064b \u0641\u064a \u0627\u0644\u0633\u0627\u0628\u0639\u0629 \u0635\u0628\u0627\u062d\u0627\u064b."
  ],
