{
  "subject": "\u0935\u094b 3 \u092e\u093f\u0928\u091f \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u0940 \u0915\u094b 10x \u0915\u0930 \u0926\u0947\u0902\u0917\u0947",
  "preview_text": "\u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u0906\u0926\u0924 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092b\u0941\u091f\u092c\u0949\u0932 \u091c\u094d\u091e\u093e\u0928 \u0915\u094b \u092c\u0926\u0932 \u0926\u0947\u0917\u0940\u0964 \u0905\u0902\u0926\u0930 \u092a\u0922\u093c\u094b\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u094b \u092e\u0948\u091a \u091c\u0939\u093e\u0901 \u0924\u0941\u092e\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u092f\u0947 \u091c\u0940\u0924\u0947\u0917\u093e, \u0932\u0947\u0915\u093f\u0928 \u0939\u093e\u0930 \u0917\u092f\u093e? \u092e\u0948\u0902 \u092d\u0940 \u0935\u0939\u093e\u0901 \u0925\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 3 \u092e\u093f\u0928\u091f \u0915\u0940 \u0930\u0942\u091f\u0940\u0928 \u0936\u0941\u0930\u0942 \u0915\u0940\u2014\u0939\u0930 \u092e\u0948\u091a \u0938\u0947 \u092a\u0939\u0932\u0947 \u092c\u0938 3 \u092e\u093f\u0928\u091f\u0964 \u0905\u092c \u092e\u0947\u0930\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u093f\u092f\u093e\u0901 10x \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0938\u091f\u0940\u0915 \u0939\u0948\u0902\u0964 \u092f\u0947 \u0915\u094b\u0908 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0921\u0947\u091f\u093e \u0939\u0948\u0964",
    "Predictify \u092e\u0947\u0902 \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f AI 50,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0935\u0947\u0930\u093f\u090f\u092c\u0932\u094d\u0938 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0930\u0924\u093e \u0939\u0948\u2014xG, \u0921\u093f\u092b\u0947\u0902\u0938\u093f\u0935 \u0938\u094d\u091f\u094d\u0930\u0947\u0902\u0925, \u0939\u0947\u0921-\u091f\u0942-\u0939\u0947\u0921 \u0907\u0924\u093f\u0939\u093e\u0938\u0964 \u0932\u0947\u0915\u093f\u0928 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u091a\u0940\u091c\u093c \u091c\u094b \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u092e\u093f\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902: \u0935\u094b \u0915\u0902\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u092a\u0930 \u0927\u094d\u092f\u093e\u0928 \u0928\u0939\u0940\u0902 \u0926\u0947\u0924\u0947\u0964 \u092e\u0948\u0902 \u0939\u0930 \u092e\u0948\u091a \u0938\u0947 \u092a\u0939\u0932\u0947 3 \u092e\u093f\u0928\u091f \u0928\u093f\u0915\u093e\u0932\u0924\u093e \u0939\u0942\u0901, \u0909\u0928 \u092e\u0948\u091a\u094b\u0902 \u0915\u094b \u091a\u0941\u0928\u0924\u093e \u0939\u0942\u0901 \u091c\u0939\u093e\u0901 \u0915\u0902\u092b\u093f\u0921\u0947\u0902\u0938 80% \u0938\u0947 \u090a\u092a\u0930 \u0939\u0948, \u0914\u0930 \u092b\u093f\u0930 \u0905\u092a\u0928\u0940 \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u0915\u094b \u0921\u0947\u091f\u093e \u0938\u0947 \u092e\u093f\u0932\u093e\u0924\u093e \u0939\u0942\u0901\u0964 \u092c\u0938 \u0907\u0924\u0928\u093e \u0915\u0930\u0928\u0947 \u0938\u0947 \u092e\u0947\u0930\u0940 \u091c\u0940\u0924 \u0915\u0940 \u0926\u0930 \u0926\u094b\u0917\u0941\u0928\u0940 \u0939\u094b \u0917\u0908\u0964",
    "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u092d\u0940 \u092f\u0947 \u0915\u093e\u092e \u0915\u0930\u0947\u0917\u093e\u0964 \u092c\u0938 \u0906\u091c \u0930\u093e\u0924 \u0915\u094b\u0908 \u092e\u0948\u091a \u0926\u0947\u0916\u094b\u2014\u091a\u093e\u0939\u0947 \u0935\u094b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u0930 \u0932\u0940\u0917 \u0939\u094b \u092f\u093e \u0932\u093e \u0932\u0940\u0917\u093e\u2014Predictify \u0916\u094b\u0932\u094b, \u0909\u0938 \u092e\u0948\u091a \u0915\u093e \u0915\u0902\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0926\u0947\u0916\u094b, \u0914\u0930 \u0905\u092a\u0928\u093e \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0921\u093e\u0932\u094b\u0964 3 \u092e\u093f\u0928\u091f \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0928\u0939\u0940\u0902 \u0932\u0917\u0947\u0917\u093e\u0964 \u0914\u0930 \u0939\u093e\u0901, \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u092c\u0928\u093e\u0928\u093e \u092e\u0924 \u092d\u0942\u0932\u0928\u093e\u2014\u0939\u0930 \u0932\u0917\u093e\u0924\u093e\u0930 \u0926\u093f\u0928 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u090f\u0915\u094d\u0938\u094d\u091f\u094d\u0930\u093e \u0915\u094d\u0930\u0947\u0921\u093f\u091f \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0935\u094b 3 \u092e\u093f\u0928\u091f \u0928\u093f\u0915\u093e\u0932\u094b\u0964 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0905\u092a\u0928\u093e \u092a\u0939\u0932\u093e \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0921\u093e\u0932\u094b\u0964 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938.\u2014\u091c\u094b \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u092f\u0947 \u0930\u0942\u091f\u0940\u0928 7 \u0926\u093f\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u0915\u0940 \u0938\u091f\u0940\u0915\u0924\u093e 40% \u092c\u0922\u093c \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0924\u0941\u092e \u0915\u092c \u0936\u0941\u0930\u0942 \u0915\u0930 \u0930\u0939\u0947 \u0939\u094b?"
