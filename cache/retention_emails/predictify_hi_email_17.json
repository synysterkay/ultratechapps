{
  "subject": "90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u092f\u0939 \u0917\u0932\u0924\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 - \u092e\u0948\u0902\u0928\u0947 \u092d\u0940 \u0915\u0940 \u0925\u0940",
  "preview_text": "\u092e\u0948\u0902\u0928\u0947 \u090f\u0915 3-\u092e\u093f\u0928\u091f \u0915\u093e \u0930\u0942\u091f\u0940\u0928 \u0921\u093f\u0938\u094d\u0915\u0935\u0930 \u0915\u093f\u092f\u093e \u0939\u0948 \u091c\u094b Predictify \u0915\u094b 10 \u0917\u0941\u0928\u093e \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0905\u0938\u0930\u0926\u093e\u0930 \u092c\u0928\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u0915\u0941\u091b \u0939\u092b\u093c\u094d\u0924\u0947 \u092a\u0939\u0932\u0947 \u0924\u0915, \u092e\u0948\u0902 \u092d\u0940 \u092c\u0938 \u092e\u0948\u091a \u0938\u0947 \u092a\u0939\u0932\u0947 \u0910\u092a \u0916\u094b\u0932\u0924\u093e, \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0926\u0947\u0916\u0924\u093e \u0914\u0930 \u092c\u0902\u0926 \u0915\u0930 \u0926\u0947\u0924\u093e \u0925\u093e\u0964 \u092b\u093f\u0930 \u092e\u0941\u091d\u0947 \u090f\u0939\u0938\u093e\u0938 \u0939\u0941\u0906 \u0915\u093f \u092e\u0948\u0902 90% \u0935\u0948\u0932\u094d\u092f\u0942 \u092e\u093f\u0938 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0901\u0964 \u0905\u0938\u0932\u0940 \u092a\u093e\u0935\u0930 \u0924\u094b \u0930\u094b\u091c\u093c\u093e\u0928\u093e \u0915\u0947 \u090f\u0915 \u091b\u094b\u091f\u0947 \u0938\u0947 \u0930\u0942\u091f\u0940\u0928 \u092e\u0947\u0902 \u091b\u0941\u092a\u0940 \u0939\u0948\u0964",
    "\u092f\u0939 \u0930\u0942\u091f\u0940\u0928 \u0938\u093f\u0930\u094d\u092b\u093c 3 \u092e\u093f\u0928\u091f \u0915\u093e \u0939\u0948\u0964 \u0938\u0941\u092c\u0939 \u0915\u0940 \u091a\u093e\u092f \u0915\u0947 \u0938\u093e\u0925, \u092f\u093e \u0911\u092b\u093f\u0938 \u091c\u093e\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947\u0964 \u0907\u0938\u092e\u0947\u0902 \u0906\u092a \u092c\u0938 \u0924\u0940\u0928 \u091a\u0940\u091c\u093c\u0947\u0902 \u091a\u0947\u0915 \u0915\u0930\u0924\u0947 \u0939\u094b: \u0906\u091c \u0915\u0947 \u091f\u0949\u092a 3 \u092e\u0948\u091a\u094b\u0902 \u0915\u0947 AI \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930, \u0915\u092e\u094d\u092f\u0941\u0928\u093f\u091f\u0940 \u0915\u0940 '\u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0911\u092b \u0926 \u0921\u0947', \u0914\u0930 AI \u091a\u0948\u091f \u0938\u0947 \u090f\u0915 \u0938\u0935\u093e\u0932 \u092a\u0942\u091b\u0928\u093e\u0964 \u092f\u0939\u0940 \u0935\u094b \u0939\u0948\u092c\u093f\u091f \u0932\u0942\u092a \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u094b \u0926\u0942\u0938\u0930\u0947 \u092b\u0948\u0928\u094d\u0938 \u0938\u0947 \u0906\u0917\u0947 \u0930\u0916\u0924\u0940 \u0939\u0948 - \u0915\u094d\u092f\u0942, \u090f\u0915\u094d\u0936\u0928, \u0930\u093f\u0935\u093e\u0930\u094d\u0921\u0964",
    "\u092f\u0939 \u0930\u0942\u091f\u0940\u0928 \u0906\u092a\u0915\u0940 \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u0915\u094b \u091c\u093f\u0902\u0926\u093e \u0930\u0916\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0938\u0947 \u0906\u092a \u092b\u094d\u0930\u0940 \u0915\u094d\u0930\u0947\u0921\u093f\u091f\u094d\u0938 \u0915\u092e\u093e\u0924\u0947 \u0939\u094b\u0964 \u0938\u093e\u0925 \u0939\u0940, \u0930\u094b\u091c\u093c AI \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0906\u092a\u0915\u093e \u092b\u0941\u091f\u092c\u0949\u0932 IQ \u092c\u0922\u093c\u0924\u093e \u0939\u0948\u0964 \u0906\u092a \u0921\u0947\u091f\u093e \u0938\u0947 \u0938\u094b\u091a\u0928\u0947 \u0932\u0917\u0924\u0947 \u0939\u094b, \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u0938\u0947 \u0928\u0939\u0940\u0902\u0964 \u0914\u0930 \u0915\u092e\u094d\u092f\u0941\u0928\u093f\u091f\u0940 \u0935\u094b\u091f \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0939\u094b\u0915\u0930 \u0906\u092a \u0926\u0942\u0938\u0930\u0947 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u091f\u0930\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b\u0924\u0947 \u0939\u094b\u0964",
    "\u0906\u091c \u0939\u0940 \u092f\u0939 3-\u092e\u093f\u0928\u091f \u0930\u0942\u091f\u0940\u0928 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b\u0964 \u0910\u092a \u0916\u094b\u0932\u094b, \u0914\u0930 \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 '\u0915\u092e\u094d\u092f\u0941\u0928\u093f\u091f\u0940' \u091f\u0948\u092c \u092a\u0930 \u091c\u093e\u0915\u0930 \u0906\u091c \u0915\u0947 POTD \u092a\u0930 \u0935\u094b\u091f \u0926\u094b\u0964 \u092f\u0939\u0940 \u0935\u094b \u092a\u0939\u0932\u093e \u090f\u0915\u094d\u0936\u0928 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u094b \u0939\u0948\u092c\u093f\u091f \u092e\u0947\u0902 \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964 P.S. \u091c\u094b \u0932\u094b\u0917 \u092f\u0939 \u0930\u0942\u091f\u0940\u0928 \u092b\u0949\u0932\u094b \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u0915\u0940 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u090f\u0915\u094d\u092f\u0942\u0930\u0947\u0938\u0940 \u0914\u0938\u0924\u0928 37% \u092c\u0922\u093c \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0915\u094b\u0908 \u0915\u0949\u0907\u0928\u094d\u0938\u093f\u0921\u0947\u0902\u0938 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
