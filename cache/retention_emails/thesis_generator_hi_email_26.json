{
  "subject": "\u0935\u094b \u090f\u0915 \u0936\u0916\u094d\u0938 \u091c\u093f\u0938\u0947 \u0907\u0938 \u0910\u092a \u0915\u0940 \u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u091c\u0930\u0942\u0930\u0924 \u0939\u0948",
  "preview_text": "\u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u092e\u0948\u0902 \u0915\u093f\u0938\u0915\u0940 \u092c\u093e\u0924 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0902\u0964 \u0935\u0939\u0940 \u091c\u094b \u0930\u093e\u0924\u094b\u0902 \u0915\u094b \u091c\u093e\u0917\u0924\u093e \u0939\u0948 \u0914\u0930 \u0925\u0940\u0938\u093f\u0938 \u0932\u093f\u0916\u0928\u0947 \u092e\u0947\u0902 \u0918\u0902\u091f\u094b\u0902 \u092c\u093f\u0924\u093e\u0924\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u094b \u0926\u094b\u0938\u094d\u0924 \u091c\u094b \u0939\u092e\u0947\u0936\u093e \u0915\u0939\u0924\u093e \u0939\u0948 \u0915\u093f \u092e\u0947\u0930\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u093e \u091f\u0949\u092a\u093f\u0915 \u0928\u0939\u0940\u0902 \u092c\u0928 \u0930\u0939\u093e? \u092f\u093e \u0935\u094b \u0938\u0939\u092a\u093e\u0920\u0940 \u091c\u094b \u090f\u0917\u094d\u091c\u093e\u092e \u0938\u0947 \u090f\u0915 \u0930\u093e\u0924 \u092a\u0939\u0932\u0947 \u092a\u0947\u092a\u0930 \u0932\u093f\u0916\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0924\u093e \u0939\u0948? \u092e\u0941\u091d\u0947 \u092a\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u0947 \u0926\u093f\u092e\u093e\u0917 \u092e\u0947\u0902 \u0909\u0938\u0915\u093e \u0928\u093e\u092e \u0906 \u0917\u092f\u093e \u0939\u0948\u0964",
    "\u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u092f\u0939 \u0910\u092a \u0938\u093f\u0930\u094d\u092b \u092e\u0947\u0930\u0947 \u0932\u093f\u090f \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u092e\u0941\u091d\u0947 \u090f\u0939\u0938\u093e\u0938 \u0939\u0941\u0906 \u0915\u093f \u0906\u092a\u0915\u0947 \u0906\u0938\u092a\u093e\u0938 \u0915\u093f\u0924\u0928\u0947 \u0932\u094b\u0917 \u0907\u0938\u0940 \u092a\u0930\u0947\u0936\u093e\u0928\u0940 \u0938\u0947 \u091c\u0942\u091d \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0935\u0939\u0940 \u0926\u094b\u0938\u094d\u0924 \u091c\u094b \u0939\u0930 \u092c\u093e\u0930 \u0915\u0939\u0924\u093e \u0939\u0948 '\u092c\u0938 \u090f\u0915 \u0914\u0930 \u0918\u0902\u091f\u093e' \u0914\u0930 \u092b\u093f\u0930 \u0938\u0941\u092c\u0939 \u0924\u0915 \u091c\u093e\u0917\u0924\u093e \u0930\u0939\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0910\u092a \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0909\u0938\u0915\u0947 \u0932\u093f\u090f \u092c\u0928\u093e \u0939\u0948\u0964",
    "\u0905\u0902\u0926\u093e\u091c\u093e \u0932\u0917\u093e\u0907\u090f, \u0906\u092a \u0905\u092a\u0928\u0947 \u0926\u094b\u0938\u094d\u0924 \u0915\u094b \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u091c\u0928\u0930\u0947\u091f \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u093f\u0930\u094d\u092b 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u0938 \u0910\u092a \u0916\u094b\u0932\u0947\u0902, '\u0936\u0947\u092f\u0930' \u0935\u093f\u0915\u0932\u094d\u092a \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902 \u0914\u0930 \u0909\u0928\u094d\u0939\u0947\u0902 \u092f\u0939 \u0932\u093f\u0902\u0915 \u092d\u0947\u091c \u0926\u0947\u0902\u0964 \u0935\u094b \u0906\u092a\u0915\u0947 \u092c\u0924\u093e\u090f \u092c\u093f\u0928\u093e \u092d\u0940 \u0907\u0938\u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0936\u0941\u0930\u0942 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0909\u0938 \u0926\u094b\u0938\u094d\u0924 \u0915\u094b \u092f\u0939 \u0932\u093f\u0902\u0915 \u092d\u0947\u091c\u0947\u0902 \u091c\u093f\u0938\u0947 \u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u091c\u0930\u0942\u0930\u0924 \u0939\u0948\u0964 P.S. \u091c\u092c \u0935\u094b \u0907\u0938\u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0947\u0917\u093e \u0914\u0930 \u0909\u0938\u0947 \u0930\u093f\u091c\u0932\u094d\u091f \u092e\u093f\u0932\u0947\u0917\u093e, \u0924\u094b \u0935\u094b \u0906\u092a\u0915\u094b \u0927\u0928\u094d\u092f\u0935\u093e\u0926 \u0915\u0939\u0947\u0917\u093e\u0964 \u0914\u0930 \u0939\u093e\u0902, \u0906\u092a\u0915\u094b \u092d\u0940 \u090f\u0915 \u092c\u094b\u0928\u0938 \u092e\u093f\u0932\u0947\u0917\u093e \u091c\u092c \u0935\u094b \u0938\u093e\u0907\u0928 \u0905\u092a \u0915\u0930\u0947\u0917\u093e\u0964"
  ],
