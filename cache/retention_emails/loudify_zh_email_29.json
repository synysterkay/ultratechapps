  "preview_text": "\u611f\u8c22\u4f60\u575a\u6301\u4f7f\u7528Loudify\u8fd9\u4e48\u4e45\uff0c\u6211\u4eec\u4e3a\u4f60\u51c6\u5907\u4e86\u4e00\u4efd\u53ea\u6709\u957f\u671f\u7528\u6237\u624d\u80fd\u83b7\u5f97\u7684\u72ec\u5bb6\u5185\u6d4b\u8d44\u683c\u3002",
  "body_paragraphs": [
    "\u7b2c68\u5929\uff0c\u4f60\u8fd8\u5728\u7528Loudify\u8c03\u97f3\u3002\u8bf4\u5b9e\u8bdd\uff0c\u8fd9\u8ba9\u6211\u5f88\u610f\u5916\uff0c\u4f46\u4e5f\u7279\u522b\u611f\u52a8\u3002\u5927\u591a\u6570\u4eba\u5728\u7b2c7\u5929\u5c31\u653e\u5f03\u4e86\uff0c\u800c\u4f60\u575a\u6301\u4e86\u4e0b\u6765\uff0c\u628a\u542c\u97f3\u8fd9\u4ef6\u4e8b\u53d8\u6210\u4e86\u4e60\u60ef\u3002\u4eca\u5929\uff0c\u6211\u60f3\u8bf4\u58f0\u8c22\u8c22\uff0c\u5e76\u7ed9\u4f60\u4e00\u6837\u4e1c\u897f\u2014\u2014\u53ea\u6709\u50cf\u4f60\u8fd9\u6837\u7684\u957f\u671f\u7528\u6237\u624d\u80fd\u5f97\u5230\u7684\u3002",
