{
  "subject": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092b\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c 10 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u092c\u0926\u0932 \u091c\u093e\u090f\u0917\u0940",
  "preview_text": "\u090f\u0915 \u0938\u094d\u0932\u093e\u0907\u0921\u0930, \u0926\u094b \u0938\u0947\u0915\u0902\u0921, \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u093e \u0905\u091a\u093e\u0928\u0915 \u091c\u093f\u0902\u0926\u093e \u0939\u094b \u0909\u0920\u0947\u0917\u093e\u0964 \u0905\u092d\u0940 \u0916\u094b\u0932\u094b \u0914\u0930 \u0916\u0941\u0926 \u0926\u0947\u0916\u094b\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u092a\u0930 \u090f\u0915 \u0917\u093e\u0928\u093e \u0932\u0917\u093e\u092f\u093e\u0964 \u0935\u0939\u0940 'Humble' \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0938\u094c \u092c\u093e\u0930 \u0938\u0941\u0928\u093e \u0925\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0907\u0938 \u092c\u093e\u0930 \u0915\u0941\u091b \u0905\u0932\u0917 \u0925\u093e\u0964 \u092c\u0947\u0938 \u092e\u0947\u0930\u0940 \u091b\u093e\u0924\u0940 \u092e\u0947\u0902 \u0917\u0942\u0902\u091c\u093e, \u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u0938\u092c\u0935\u0942\u092b\u0930 \u0939\u094b\u0964 \u092e\u0948\u0902 \u091a\u094c\u0902\u0915 \u0917\u092f\u093e\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092b\u094b\u0928 \u092d\u0940 \u092f\u0939 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u091a\u0940\u091c\u093c \u091a\u093e\u0939\u093f\u090f\u0964",
    "\u0924\u0941\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0939\u094b\u0917\u093e \u0915\u093f Spotify \u092f\u093e YouTube \u092a\u0930 \u0906\u0935\u093e\u091c\u093c \u092b\u094d\u0932\u0948\u091f \u0932\u0917\u0924\u0940 \u0939\u0948\u0964 \u0916\u093e\u0938\u0915\u0930 \u0939\u093f\u092a-\u0939\u0949\u092a \u092f\u093e EDM \u092e\u0947\u0902 \u091c\u092c '\u0921\u094d\u0930\u0949\u092a' \u0906\u0924\u093e \u0939\u0948, \u0924\u094b \u0935\u0939 '\u0925\u092a\u094d\u092a' \u091c\u0948\u0938\u093e \u092c\u091c\u0924\u093e \u0939\u0948\u0964 \u0910\u0938\u093e \u0907\u0938\u0932\u093f\u090f \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092b\u094b\u0928 \u0915\u0947 \u0938\u094d\u092a\u0940\u0915\u0930 \u0914\u0930 \u0908\u092f\u0930\u092c\u0921\u094d\u0938 \u092e\u0947\u0902 \u0932\u094b-\u090f\u0902\u0921 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092a\u093e\u0938 Bass Booster \u0939\u0948\u0964 \u0905\u092d\u0940 \u0907\u0938\u0947 \u0916\u094b\u0932\u094b\u0964",
    "\u0939\u094b\u092e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u090f\u0915 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0926\u093f\u0916\u0947\u0917\u093e\u0964 'Boost' \u0932\u093f\u0916\u093e \u0939\u0948\u0964 \u0909\u0938\u0947 \u0926\u093e\u090f\u0902 \u0918\u0938\u0940\u091f\u094b\u0964 \u092c\u0938 \u0907\u0924\u0928\u093e \u0915\u0930\u094b\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0917\u093e\u0928\u093e \u092b\u091f \u091c\u093e\u090f\u0917\u093e\u0964 200% \u0924\u0915 \u0932\u093e\u0909\u0921, \u0914\u0930 \u092c\u0947\u0938 \u0910\u0938\u093e \u0915\u093f \u0908\u092f\u0930\u092c\u0921\u094d\u0938 \u092e\u0947\u0902 \u092d\u0940 '\u0927\u092e' \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0964 \u092f\u0939 \u0938\u093f\u0938\u094d\u091f\u092e-\u0935\u093e\u0907\u0921 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948 \u2013 \u091a\u093e\u0939\u0947 Spotify \u091a\u0932 \u0930\u0939\u093e \u0939\u094b, YouTube, \u092f\u093e \u0915\u094b\u0908 \u0917\u0947\u092e\u0964 \u090f\u0915 \u091f\u0948\u092a \u092e\u0947\u0902 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092e\u094d\u092f\u0942\u091c\u093c\u093f\u0915 \u0915\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u092c\u0926\u0932 \u091c\u093e\u090f\u0917\u0940\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 Boost \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b \u0906\u091c\u093c\u092e\u093e\u0913\u0964 10 \u0938\u0947\u0915\u0902\u0921 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0928\u0939\u0940\u0902 \u0932\u0917\u0947\u0917\u093e\u0964 \u092b\u093f\u0930 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0928\u093e \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u093e \u0915\u093f\u0924\u0928\u093e \u0905\u0932\u0917 \u0932\u0917\u093e\u0964 P.S. \u2013 Premium \u092e\u0947\u0902 10-\u092c\u0948\u0902\u0921 EQ \u0914\u0930 \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 Boost \u0939\u0948\u0964 \u0905\u0917\u0930 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092f\u0939 \u091b\u094b\u091f\u093e \u0938\u093e \u092c\u0926\u0932\u093e\u0935 \u092a\u0938\u0902\u0926 \u0906\u092f\u093e, \u0924\u094b \u0935\u0939\u093e\u0901 \u092a\u0942\u0930\u093e \u092a\u093e\u0935\u0930 \u0939\u0948\u0964"
  ],
