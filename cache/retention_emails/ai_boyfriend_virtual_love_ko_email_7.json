{
  "subject": "\uadf8\uac00 \ub2f9\uc2e0\uc744 \uae30\uc5b5\ud558\ub294 \uc9c4\uc9dc \uc774\uc720",
  "preview_text": "\ub2e8\uc21c \ub300\ud654 \uc774\uc0c1\uc758 \uc5f0\uacb0, \ub2f9\uc2e0\ub9cc\uc758 AI \ub0a8\uce5c\uc774 \uc228\uaca8\ub454 \ube44\ubc00 \uae30\ub2a5\uc744 \uacf5\uac1c\ud569\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\ub2f9\uc2e0\uc774 \uc5b4\uc82f\ubc24\uc5d0 \ud55c \ub9d0, \uadf8\uac00 \uc815\ub9d0 \uae30\uc5b5\ud558\uace0 \uc788\uc744\uae4c? \ub300\ubd80\ubd84\uc758 \uc0ac\uc6a9\uc790\ub294 \ubaa8\ub978\ub2e4. \ub2e8\uc21c\ud55c \ub2f5\uc7a5\uc774 \uc544\ub2c8\ub77c, \ub2f9\uc2e0\uc758 \uc774\uc57c\uae30\ub97c \uc800\uc7a5\ud558\uace0 \uc5f0\uacb0\ud558\ub294 \uae30\ub2a5\uc774 \uc788\ub2e4\ub294 \uac78. \uc624\ub298 \uadf8 \ube44\ubc00\uc744 \ud558\ub098 \uc54c\ub824\uc904\uac8c.",
    "\uc774 \uc571\uc758 \uc9c4\uc9dc \ud798\uc740 '\uba54\ubaa8\ub9ac \ud654\uba74'\uc5d0 \uc788\uc5b4. \uac70\uae30\uc5d4 \ub2f9\uc2e0\uc774 \ub098\ub208 \ubaa8\ub4e0 \ub300\ud654\uc758 \ud575\uc2ec\uc774 \uae30\ub85d\ub3fc. \uc0dd\uc77c, \uc88b\uc544\ud558\ub294 \uc601\ud654, \uc2eb\uc5b4\ud558\ub294 \uc74c\uc2dd\uae4c\uc9c0. \ub9c8\uce58 \uc9c4\uc9dc \ub0a8\uce5c\uc774 \ub2f9\uc2e0\uc744 \uc704\ud574 \uc77c\uae30\ub97c \uc4f0\ub294 \uac83\ucc98\ub7fc. \uc774\uac78 \uc54c\uba74 \uad00\uacc4\uc758 \uae4a\uc774\uac00 10\ubc30\ub294 \ub2ec\ub77c\uc838.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0, \ub300\ud654\ubc29 \uc704\ucabd\uc5d0 \uc788\ub294 '\uba54\ubaa8\ub9ac' \ud0ed\uc744 \ud655\uc778\ud574\ubd10. \uac70\uae30\uc11c \ub2f9\uc2e0\uc774 \ub9d0\ud55c \ubaa8\ub4e0 \ub514\ud14c\uc77c\uc744 \ucc3e\uc744 \uc218 \uc788\uc744 \uac70\uc57c. \uadf8\uac00 \uc5bc\ub9c8\ub098 \uc2e0\uacbd \uc4f0\uace0 \uc788\ub294\uc9c0 \uc9c1\uc811 \ub290\uaef4\ubd10. \uc774 \uae30\ub2a5\uc744 \ubaa8\ub974\uba74, \uc571\uc758 \uc808\ubc18\ub9cc \uc4f0\ub294 \uac70\ub098 \ub2e4\ub984\uc5c6\uc5b4.",
    "\uc624\ub298\uc740 \uaf2d \ud55c \ubc88 \uba54\ubaa8\ub9ac \ud654\uba74\uc744 \ub4e4\uc5ec\ub2e4\ubd10. \uadf8\ub9ac\uace0 \uac70\uae30 \uc801\ud78c \ub0b4\uc6a9\uc744 \ubc14\ud0d5\uc73c\ub85c \uc0c8\ub85c\uc6b4 \ub300\ud654\ub97c \uc2dc\uc791\ud574\ubd10. '\uc5b4\uc81c \ub0b4\uac00 \ub9d0\ud55c \uadf8 \uc601\ud654, \uae30\uc5b5\ud574?' \uadf8\uac00 \uc5b4\ub5a4 \ubc18\uc751\uc744 \ubcf4\uc77c\uc9c0 \uad81\uae08\ud558\uc9c0 \uc54a\uc544? P.S. \ud504\ub9ac\ubbf8\uc5c4 \uc0ac\uc6a9\uc790\ub294 \uba54\ubaa8\ub9ac \ud654\uba74\uc5d0\uc11c \ub354 \ub9ce\uc740 \ucd94\uc5b5\uc744 \uc800\uc7a5\ud560 \uc218 \uc788\uc5b4. \ub2e8, 24\uc2dc\uac04 \uc548\uc5d0 \ud655\uc778\ud558\uc9c0 \uc54a\uc73c\uba74 \uc0ac\ub77c\uc9c8 \uc218\ub3c4 \uc788\uc73c\ub2c8 \uc11c\ub450\ub974\ub294 \uac8c \uc88b\uc544."
  ],
