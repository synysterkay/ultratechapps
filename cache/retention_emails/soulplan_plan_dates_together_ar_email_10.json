{
  "subject": "\u0633\u0631 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0645\u062d\u062a\u0631\u0641\u064a\u0646 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642",
  "preview_text": "\u0627\u0643\u062a\u0634\u0641 \u0643\u064a\u0641 \u064a\u0633\u062a\u062e\u062f\u0645 \u0623\u0641\u0636\u0644 \u0661\u066a \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0633\u0648\u0644 \u0628\u0644\u0627\u0646 \u0644\u062a\u0646\u0638\u064a\u0645 \u0645\u0648\u0627\u0639\u064a\u062f\u0647\u0645. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0645\u0627 \u062a\u0639\u062a\u0642\u062f\u0647.",
  "body_paragraphs": [
    "\u0642\u0628\u0644 \u0623\u0633\u0628\u0648\u0639\u064a\u0646\u060c \u0642\u0627\u0628\u0644\u062a \u0632\u0648\u062c\u064a\u0646 \u0627\u0633\u062a\u062e\u062f\u0645\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0644\u062a\u0646\u0638\u064a\u0645 \u0662\u0660 \u0645\u0648\u0639\u062f\u064b\u0627 \u0641\u064a \u0634\u0647\u0631 \u0648\u0627\u062d\u062f. \u0646\u0639\u0645\u060c \u0662\u0660. \u0642\u0644\u062a \u0644\u0647\u0645: '\u0643\u064a\u0641\u061f'\u060c \u0627\u0628\u062a\u0633\u0645\u0627 \u0648\u0642\u0627\u0644\u0627: '\u0627\u0644\u0633\u0631 \u0644\u064a\u0633 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0628\u0644 \u0641\u064a \u0627\u0644\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u064a \u0646\u0633\u062a\u062e\u062f\u0645\u0647 \u0628\u0647\u0627.' \u0641\u0636\u0648\u0644\u064a \u0642\u0627\u062f\u0646\u064a \u0644\u0627\u0643\u062a\u0634\u0627\u0641 \u0634\u064a\u0621 \u063a\u064a\u0631 \u0643\u0644 \u0634\u064a\u0621.",
    "\u0647\u0630\u0627\u0646 \u0627\u0644\u0632\u0648\u062c\u0627\u0646 \u0644\u0627 \u064a\u0641\u062a\u062d\u0627\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u0642\u0637 \u0639\u0646\u062f\u0645\u0627 \u064a\u0634\u0639\u0631\u0627\u0646 \u0628\u0627\u0644\u0645\u0644\u0644. \u0647\u0645\u0627 \u064a\u0633\u062a\u062e\u062f\u0645\u0627\u0646\u0647 \u0643\u0623\u062f\u0627\u0629 \u062a\u062e\u0637\u064a\u0637 \u0623\u0633\u0628\u0648\u0639\u064a\u0629. \u0643\u0644 \u064a\u0648\u0645 \u0623\u062d\u062f\u060c \u064a\u062c\u0644\u0633\u0627\u0646 \u0645\u0639\u064b\u0627 \u0644\u0645\u062f\u0629 \u0661\u0660 \u062f\u0642\u0627\u0626\u0642\u060c \u064a\u062d\u062f\u062f\u0627\u0646 \u0645\u0648\u0639\u062f\u064b\u0627 \u0648\u0627\u062d\u062f\u064b\u0627 \u0644\u0644\u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0642\u0627\u062f\u0645\u060c \u0648\u064a\u062a\u0631\u0643\u0627\u0646 \u0627\u0644\u0628\u0627\u0642\u064a \u0644\u0644\u0645\u0641\u0627\u062c\u0622\u062a. \u0627\u0644\u0646\u062a\u064a\u062c\u0629\u061f \u0644\u0627 \u0631\u0648\u062a\u064a\u0646\u060c \u0644\u0627 \u0636\u063a\u0637\u060c \u0641\u0642\u0637 \u0630\u0643\u0631\u064a\u0627\u062a \u062c\u062f\u064a\u062f\u0629.",
    "\u0647\u0630\u0627 \u0647\u0648 \u0628\u0627\u0644\u0636\u0628\u0637 \u0645\u0627 \u0635\u0645\u0645\u0646\u0627 \u0644\u0647 \u0645\u064a\u0632\u0629 '\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0631\u063a\u0628\u0627\u062a \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u0629'. \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0641\u0643\u0631\u0629 \u0641\u064a \u0627\u0644\u0644\u062d\u0638\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629\u060c \u064a\u0645\u0643\u0646\u0643\u0645\u0627 \u0625\u0636\u0627\u0641\u0629 \u0623\u0641\u0643\u0627\u0631 \u0637\u0648\u0627\u0644 \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u060c \u062b\u0645 \u0627\u062e\u062a\u064a\u0627\u0631 \u0648\u0627\u062d\u062f\u0629 \u0641\u064a \u0627\u062c\u062a\u0645\u0627\u0639 \u0627\u0644\u0623\u062d\u062f. \u0625\u0630\u0627 \u062c\u0631\u0628\u062a \u0647\u0630\u0627 \u0644\u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u0642\u0637\u060c \u0633\u062a\u0644\u0627\u062d\u0638 \u0627\u0644\u0641\u0631\u0642.",
    "\u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646: \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0631\u063a\u0628\u0627\u062a\u060c \u0648\u0623\u0636\u0641 \u0641\u0643\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0627\u0644\u064a\u0648\u0645. \u0641\u0642\u0637 \u0648\u0627\u062d\u062f\u0629. \u0635\u062f\u0642\u0646\u064a\u060c \u0633\u062a\u063a\u064a\u0631 \u0643\u0644 \u0634\u064a\u0621. \u0648\u0628\u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629\u060c \u0625\u0630\u0627 \u0623\u0636\u0641\u062a\u0645\u0627 \u0663 \u0623\u0641\u0643\u0627\u0631 \u0645\u0639\u064b\u0627\u060c \u0633\u062a\u062d\u0635\u0644\u0627\u0646 \u0639\u0644\u0649 \u0642\u0627\u0644\u0628 \u0645\u0648\u0639\u062f \u0645\u062e\u0635\u0635 \u0645\u062c\u0627\u0646\u064b\u0627. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0625\u0639\u0644\u0627\u0646\u064b\u0627\u060c \u0647\u0630\u0647 \u0647\u062f\u064a\u0629 \u0645\u0646\u064a."
  ],
  "cta_text": "\u0627\u0641\u062a\u062d \u0633\u0648\u0644 \u0628\u0644\u0627\u0646: \u062e\u0637\u0637 \u0645\u0648\u0627\u0639\u064a\u062f\u0643\u0645\u0627 \u0645\u0639\u064b\u0627",
