{
  "subject": "\u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0630\u064a \u062a\u0648\u0642\u0641 \u0641\u064a\u0647 \u0627\u0644\u0632\u0648\u062c\u0627\u0646 \u0627\u0644\u0623\u0643\u062b\u0631 \u0646\u0634\u0627\u0637\u0627 \u0639\u0646 \u0627\u0644\u062a\u062e\u0637\u064a\u0637",
  "preview_text": "\u0643\u064a\u0641 \u064a\u0633\u062a\u062e\u062f\u0645 \u0623\u0641\u0636\u0644 1% \u0645\u0646 \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u0634\u0643\u0644 \u0645\u062e\u062a\u0644\u0641\u061f \u0627\u0644\u0633\u0631 \u0641\u064a \u0623\u0633\u0644\u0648\u0628 \u0639\u0645\u0644\u0647\u0645 \u0627\u0644\u0633\u0631\u064a.",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u062a\u062f\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0648\u062a\u062c\u062f \u0644\u064a\u0644\u0629 \u0631\u0627\u0626\u0639\u0629 \u062c\u0627\u0647\u0632\u0629 \u0644\u0643\u0645\u0627 \u0641\u064a 30 \u062b\u0627\u0646\u064a\u0629 \u0641\u0642\u0637. \u0647\u0630\u0627 \u0644\u064a\u0633 \u062e\u064a\u0627\u0644\u0627\u060c \u0628\u0644 \u0647\u0648 \u0645\u0627 \u064a\u0641\u0639\u0644\u0647 \u0623\u0641\u0636\u0644 1% \u0645\u0646 \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646\u0627 \u064a\u0648\u0645\u064a\u0627.",
    "\u0647\u0624\u0644\u0627\u0621 \u0627\u0644\u0623\u0632\u0648\u0627\u062c \u0644\u0627 \u064a\u0636\u064a\u0639\u0648\u0646 \u0648\u0642\u062a\u0647\u0645 \u0641\u064a \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0623\u0641\u0643\u0627\u0631 \u0623\u0648 \u0627\u0644\u062a\u0646\u0633\u064a\u0642 \u0628\u064a\u0646 \u062e\u0637\u0637\u0647\u0645. \u0628\u062f\u0644\u0627 \u0645\u0646 \u0630\u0644\u0643\u060c \u064a\u0639\u062a\u0645\u062f\u0648\u0646 \u0639\u0644\u0649 \u0645\u064a\u0632\u0629 \"\u0645\u0648\u0639\u062f \u0627\u0644\u0644\u064a\u0644\u0629\" \u0627\u0644\u062a\u064a \u062a\u0642\u062f\u0645 \u0644\u0647\u0645 \u0627\u0642\u062a\u0631\u0627\u062d\u0627 \u0630\u0643\u064a\u0627 \u0628\u0646\u0627\u0621 \u0639\u0644\u0649 \u0645\u0632\u0627\u062c\u0647\u0645 \u0627\u0644\u062d\u0627\u0644\u064a. \u0648\u0627\u062d\u062f \u0645\u0646\u0647\u0645 \u0623\u062e\u0628\u0631\u0646\u064a \u0623\u0646\u0647 \u0648\u0632\u0648\u062c\u062a\u0647 \u0623\u0635\u0628\u062d\u0627 \u064a\u0646\u062a\u0638\u0631\u0627\u0646 \u0647\u0630\u0647 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0628\u0641\u0627\u0631\u063a \u0627\u0644\u0635\u0628\u0631.",
    "\u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u064a \u062a\u062c\u0639\u0644 \u0647\u0630\u0627 \u0645\u0645\u0643\u0646\u0627 \u0647\u064a \"\u0628\u0637\u0627\u0642\u0629 \u0645\u0648\u0639\u062f \u0627\u0644\u0644\u064a\u0644\u0629\" \u0627\u0644\u062a\u064a \u062a\u0638\u0647\u0631 \u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629. \u0627\u062e\u062a\u0631 \u0645\u0632\u0627\u062c\u0643 (\u062f\u0627\u0641\u0626\u060c \u0645\u063a\u0627\u0645\u0631\u060c \u0645\u0631\u062d\u060c \u0623\u0648 \u0634\u0641\u0627\u0621) \u0648\u0633\u062a\u062d\u0635\u0644 \u0639\u0644\u0649 \u0627\u0642\u062a\u0631\u0627\u062d \u0643\u0627\u0645\u0644 \u0641\u064a \u062b\u0648\u0627\u0646. \u0644\u0627 \u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u0645\u0645\u0644\u060c \u0641\u0642\u0637 \u0644\u062d\u0638\u0627\u062a \u062c\u0645\u064a\u0644\u0629.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0627\u0643\u062a\u0634\u0641 \u0628\u0637\u0627\u0642\u0629 \u0645\u0648\u0639\u062f \u0627\u0644\u0644\u064a\u0644\u0629. \u062c\u0631\u0628\u0647\u0627 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u0642\u0637. P.S. \u062a\u0630\u0643\u0631 \u0623\u0646 \u0627\u0644\u0632\u0648\u062c\u064a\u0646 \u0627\u0644\u0644\u0630\u064a\u0646 \u064a\u0633\u062a\u062e\u062f\u0645\u0627\u0646 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0641\u064a \u0623\u0648\u0644 24 \u0633\u0627\u0639\u0629 \u064a\u062e\u0637\u0637\u0627\u0646 \u0644\u0640 4 \u0623\u0636\u0639\u0627\u0641 \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0641\u064a \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u062a\u0627\u0644\u064a."
  ],
