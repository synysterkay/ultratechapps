{
  "subject": "2AM \u0915\u093e \u0935\u094b \u0915\u092c\u0942\u0932\u0928\u093e\u092e\u093e \u091c\u093f\u0938\u0928\u0947 Predictify \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u092e\u0948\u0902\u0928\u0947 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u090f\u0915 \u092b\u0940\u091a\u0930 \u092c\u0928\u093e\u092f\u093e, \u0914\u0930 \u0935\u094b \u0917\u0932\u0924\u0940 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u091c\u0940\u0924 \u092c\u0928 \u0917\u0908\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947?",
  "body_paragraphs": [
    "\u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c\u0947 \u0925\u0947\u0964 \u092e\u0948\u0902 \u0905\u0915\u0947\u0932\u093e \u092c\u0948\u0920\u093e \u0925\u093e, \u0905\u092a\u0928\u0947 \u0932\u0948\u092a\u091f\u0949\u092a \u0915\u0947 \u0938\u093e\u092e\u0928\u0947, \u0914\u0930 \u092e\u0947\u0930\u0947 \u0926\u093f\u092e\u093e\u0917 \u092e\u0947\u0902 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0938\u0935\u093e\u0932 \u0925\u093e: \u0915\u094d\u092f\u094b\u0902 \u0939\u0930 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0910\u092a \u0909\u092c\u093e\u090a \u0932\u0917\u0924\u093e \u0939\u0948? \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e, \u0905\u0917\u0930 \u092e\u0948\u0902 \u0916\u0941\u0926 \u090f\u0915 \u092b\u0948\u0928 \u0939\u0942\u0902, \u0924\u094b \u092e\u0941\u091d\u0947 \u0915\u094d\u092f\u093e \u091a\u093e\u0939\u093f\u090f? \u091c\u0935\u093e\u092c \u0925\u093e: \u0915\u0941\u091b \u0905\u0938\u0932\u0940, \u0915\u0941\u091b \u0910\u0938\u093e \u091c\u094b \u092e\u0947\u0930\u0947 \u091c\u0941\u0928\u0942\u0928 \u0915\u094b \u0938\u092e\u091d\u0947\u0964 \u0924\u092c \u092e\u0948\u0902\u0928\u0947 \u0935\u094b \u092b\u0940\u091a\u0930 \u092c\u0928\u093e\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e \u091c\u094b \u0906\u091c Predictify \u0915\u093e \u0926\u093f\u0932 \u0939\u0948\u0964",
    "\u0935\u094b \u0930\u093e\u0924 \u092e\u0947\u0930\u0940 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u0917\u0932\u0924\u0940 \u0925\u0940 \u0914\u0930 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u091c\u0940\u0924\u0964 \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e, '\u0915\u094d\u092f\u094b\u0902 \u0928 AI \u0915\u094b \u0907\u0924\u0928\u093e \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u092c\u0928\u093e\u090a\u0902 \u0915\u093f \u0935\u094b \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u092a\u0940\u091b\u0947 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u092c\u0924\u093e \u0938\u0915\u0947?' \u0928 \u0938\u093f\u0930\u094d\u092b \u0938\u094d\u0915\u094b\u0930, \u092c\u0932\u094d\u0915\u093f xG, \u0921\u093f\u092b\u0947\u0902\u0938\u093f\u0935 \u0938\u094d\u091f\u094d\u0930\u0947\u0902\u0925, \u0914\u0930 \u091f\u0948\u0915\u094d\u091f\u093f\u0915\u0932 \u090f\u0928\u093e\u0932\u093f\u0938\u093f\u0938\u0964 \u0906\u092a\u0915\u093e \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u0905\u092c \u0921\u0947\u091f\u093e \u0938\u0947 \u092c\u0948\u0915\u0905\u092a \u0939\u094b\u0917\u093e\u0964 \u092f\u0939\u0940 \u0935\u094b \u092a\u0932 \u0925\u093e \u091c\u092c \u092e\u0948\u0902\u0928\u0947 \u0924\u092f \u0915\u093f\u092f\u093e: Predictify \u0906\u092a\u0915\u094b \u0938\u093f\u0930\u094d\u092b \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0928\u0939\u0940\u0902 \u0926\u0947\u0917\u093e, \u092c\u0932\u094d\u0915\u093f \u0939\u0930 \u0928\u0902\u092c\u0930 \u0915\u0947 \u092a\u0940\u091b\u0947 \u0915\u0940 \u0935\u091c\u0939 \u092c\u0924\u093e\u090f\u0917\u093e\u0964",
    "\u0906\u091c, \u091c\u092c \u0906\u092a \u0915\u093f\u0938\u0940 \u092e\u0948\u091a \u0915\u093e \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0909\u0938\u0915\u0947 \u092a\u0940\u091b\u0947 2AM \u0915\u0940 \u0935\u094b \u0930\u093e\u0924 \u0939\u0948\u0964 AI \u091a\u0948\u091f \u092e\u0947\u0902 \u092a\u0942\u091b\u093f\u090f, '\u092c\u093e\u0930\u094d\u0938\u093f\u0932\u094b\u0928\u093e \u0915\u0940 \u0921\u093f\u092b\u0947\u0902\u0938 \u0915\u093f\u0924\u0928\u0940 \u092e\u091c\u092c\u0942\u0924 \u0939\u0948?' \u0914\u0930 \u091c\u0935\u093e\u092c \u092e\u0947\u0902 \u0906\u092a\u0915\u094b \u092e\u093f\u0932\u0947\u0917\u093e \u0905\u0938\u0932\u0940 \u0921\u0947\u091f\u093e\u0964 \u092f\u093e IQ Quiz \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u092b\u0941\u091f\u092c\u0949\u0932 IQ \u091f\u0947\u0938\u094d\u091f \u0915\u0930\u0947\u0902\u0964 \u092f\u0947 \u0938\u092c \u0935\u0939\u0940\u0902 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0939\u0941\u0906 \u091c\u0939\u093e\u0902 \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e: \u092b\u0948\u0928\u094d\u0938 \u0915\u094b \u0938\u093f\u0930\u094d\u092b \u0928\u0902\u092c\u0930 \u0928\u0939\u0940\u0902, \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091a\u093e\u0939\u093f\u090f\u0964",
    "\u0905\u092c \u0906\u092a\u0915\u0940 \u092c\u093e\u0930\u0940 \u0939\u0948\u0964 \u0916\u094b\u0932\u093f\u090f Predictify \u0914\u0930 AI \u091a\u0948\u091f \u092e\u0947\u0902 \u092a\u0942\u091b\u093f\u090f: '\u0906\u091c \u0915\u0947 \u092e\u0948\u091a \u0915\u093e \u092e\u0947\u0930\u093e \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u093e \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u094d\u092f\u093e \u0939\u0948?' \u0926\u0947\u0916\u093f\u090f \u0921\u0947\u091f\u093e \u0915\u0948\u0938\u0947 \u0906\u092a\u0915\u0940 \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u0915\u094b \u0939\u0930\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0915\u0940 3-\u0926\u093f\u0928 \u0915\u0940 \u092b\u094d\u0930\u0940 \u091f\u094d\u0930\u093e\u092f\u0932 \u0905\u092d\u0940 \u092d\u0940 \u092c\u093e\u0915\u0940 \u0939\u0948\u0964 $12.99/\u092e\u0939\u0940\u0928\u093e \u092e\u0947\u0902 \u0938\u092c \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0947\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u091c\u0932\u094d\u0926\u0940 \u0915\u0930\u0947\u0902, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092f\u0947 \u0911\u092b\u0930 \u0939\u092e\u0947\u0936\u093e \u0928\u0939\u0940\u0902 \u0930\u0939\u0947\u0917\u093e\u0964"
  ],
