{
  "subject": "2\ubd84\uc774\uba74 \ub05d\ub0a9\ub2c8\ub2e4 (\uc9c4\uc9dc\uc608\uc694)",
  "preview_text": "\uc608\uc804\uc5d4 20\ubd84 \uac78\ub9ac\ub358 \ubd84\uc11d, \uc9c0\uae08\uc740 2\ubd84\uc774\uba74 \ub429\ub2c8\ub2e4. \uc774 \ube44\ubc00\uc744 \uc54c\uba74 \ub9e4\uc77c \uc2dc\uac04\uc774 \uc808\uc57d\ub429\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uc800\ub3c4 \ucc98\uc74c\uc5d4 \uc758\uc2ec\ud588\uc5b4\uc694. 'AI\uac00 \uacbd\uae30 \ubd84\uc11d\uc744 2\ubd84 \ub9cc\uc5d0 \ub05d\ub0b8\ub2e4\uace0?' \ud558\uc9c0\ub9cc \uc9c1\uc811 \ud574\ubcf4\ub2c8 \ucda9\uaca9\uc801\uc774\uc5c8\uc2b5\ub2c8\ub2e4. \uc608\uc804\uc5d4 \ud1b5\uacc4 \uc0ac\uc774\ud2b8 5\uac1c \ub3cc\uc544\ub2e4\ub2c8\uba70 20\ubd84 \ub118\uac8c \ub370\uc774\ud130 \ucc3e\uc558\ub294\ub370, \uc774\uc81c\ub294 Predictify \ud558\ub098\ub85c \ub05d\ub0a9\ub2c8\ub2e4.",
    "\uc2e4\uc81c\ub85c \uc720\uc800\ub4e4 \uc911 80%\uac00 '\uc2dc\uac04 \uc808\uc57d'\uc744 \uac00\uc7a5 \ud070 \uc7a5\uc810\uc73c\ub85c \uaf3d\ub354\uad70\uc694. AI\uac00 xG, \uc218\ube44 \ud6a8\uc728, \ud5e4\ub4dc\ud22c\ud5e4\ub4dc \uae30\ub85d \ub4f1 \ubaa8\ub4e0 \ubcc0\uc218\ub97c \ubd84\uc11d\ud574\uc918\uc11c, \uc9c4\uc9dc \ud544\uc694\ud55c \uac74 '\uc5b4\ub290 \ud300\uc5d0 \ubc30\ud305\ud560\uc9c0' \uacb0\uc815\ubfd0\uc785\ub2c8\ub2e4.",
    "\ubc14\ub85c 'AI \uc2a4\ucf54\uc5b4 \uc608\uce21' \uae30\ub2a5\uc774\uc5d0\uc694. \uc571 \uc5f4\uba74 \ub9ac\uadf8 \uc120\ud0dd\ud558\uace0, \uacbd\uae30 \ud558\ub098 \ub204\ub974\uba74 \ub05d. AI\uac00 1,000\uac1c \uc774\uc0c1\uc758 \ubcc0\uc218\ub97c \ubd84\uc11d\ud574 \uc2e0\ub8b0\ub3c4 \uc810\uc218\uae4c\uc9c0 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \uc608\uc804\ucc98\ub7fc \uc0ac\uc774\ud2b8 \ub3cc\uc544\ub2e4\ub2d0 \ud544\uc694 \uc5c6\uc5b4\uc694.",
    "\uc790, \uc774\uc81c \uc571\uc744 \uc5f4\uace0 '\ud504\ub9ac\ubbf8\uc5b4 \ub9ac\uadf8' \ub4e4\uc5b4\uac00\uc11c \uc624\ub298 \uacbd\uae30 \uc911 \ud558\ub098\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694. 2\ubd84\uc774\uba74 \ub429\ub2c8\ub2e4. P.S. 3\uc77c \ubb34\ub8cc \uccb4\ud5d8 \ub05d\ub098\uae30 \uc804\uc5d0 \ud504\ub9ac\ubbf8\uc5c4\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74, \ubaa8\ub4e0 \ub9ac\uadf8 \uc608\uce21\uacfc \uace0\uae09 \ud1b5\uacc4\uac00 \ubb34\uc81c\ud55c\uc73c\ub85c \uc5f4\ub9bd\ub2c8\ub2e4. $12.99\uba74 \ud55c \ub2ec \ub0b4\ub0b4 \uc2dc\uac04 \uc808\uc57d\ud558\uace0 \uc2b9\ub960\uae4c\uc9c0 \ub192\uc77c \uc218 \uc788\uc5b4\uc694."
