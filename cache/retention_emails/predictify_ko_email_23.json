{
  "subject": "\ub0b4\uac00 \uc571 \uc5c6\uc774 \ubcf8 \uacbd\uae30 \uacb0\uacfc\uac00 \ucc3d\ud53c\ud55c \uc774\uc720",
  "preview_text": "\ub370\uc774\ud130 \uc5c6\uc774 \ucd95\uad6c \ubcf8 \uc9c0\ub09c 53\uc77c, \ub3cc\uc544\ubcf4\ub2c8 \ud55c\uc2ec\ud560 \uc815\ub3c4\uc600\uc2b5\ub2c8\ub2e4. \uc9c0\uae08 \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\uc194\uc9c1\ud788 \ub9d0\ud574\uc11c, \uc774 \uc571\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uae30 \uc804\uae4c\uc9c0 \uc800\ub294 \ub9e4 \uacbd\uae30\ub9c8\ub2e4 '\uc774 \ud300\uc740 \ub290\ub08c\uc774 \uc88b\ub2e4'\ub294 \ub9d0\ub85c \uc608\uce21\uc744 \ud588\uc5b4\uc694. \uadf8\ub7f0\ub370 \uc9c0\ub09c 53\uc77c \ub3d9\uc548 \ub370\uc774\ud130\ub97c \ubcf4\uba74\uc11c \uacbd\uae30\ub97c \ubd84\uc11d\ud574\ubcf4\ub2c8\uae4c, \uadf8\ub3d9\uc548 \uc81c\uac00 \uc5bc\ub9c8\ub098 \ub9ce\uc740 \ub3c8\uacfc \uc2dc\uac04\uc744 \ud5c8\uacf5\uc5d0 \ub0a0\ub838\ub294\uc9c0 \uae68\ub2ec\uc558\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9e8\uc720\uac00 \uc57d\ud300\uc744 \uc0c1\ub300\ud560 \ub54c \uc800\ub294 \ud56d\uc0c1 \uc774\uae38 \uac70\ub77c\uace0 \uc0dd\uac01\ud588\uc9c0\ub9cc, AI\uac00 \ubd84\uc11d\ud55c \uc810\uc720\uc728\uacfc \uc218\ube44 \ud6a8\uc728\uc131 \ub370\uc774\ud130\ub294 \uc644\uc804\ud788 \ubc18\ub300\uc600\uc5b4\uc694.",
    "\uc774 \uc571\uc774 \uc5c6\ub358 \uc2dc\uc808\uc758 \uc800\ub294 \uadf8\ub0e5 '\ucd95\uad6c \uc880 \uc544\ub294 \ucc99'\ud558\ub294 \ud3c9\ubc94\ud55c \ud32c\uc774\uc5c8\uc5b4\uc694. \ud558\uc9c0\ub9cc \uc9c0\uae08\uc740 AI\uac00 \uc218\ucc9c \uac1c\uc758 \ubcc0\uc218\ub97c \ubd84\uc11d\ud574\uc8fc\uae30 \ub54c\ubb38\uc5d0, \uacbd\uae30 \uc804\uc5d0 \uc774\ubbf8 \ub204\uac00 \uc774\uae38\uc9c0 80% \uc774\uc0c1 \ud655\uc2e0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc81c \uce5c\uad6c\ub4e4\uc740 \uc81c\uac00 \ub9e4\ubc88 \ub9de\ud788\ub294 \uc608\uce21\uc5d0 \ub180\ub77c\uc11c '\ub108 \uc5b4\ub5bb\uac8c \uc54c\uc558\ub0d0'\uace0 \ubb3c\uc5b4\ubcf4\ub294\ub370, \uadf8\ub54c\ub9c8\ub2e4 '\ub290\ub08c\uc774\uc5c8\ub2e4'\uace0 \ub9d0\ud558\uc9c0\ub9cc \uc0ac\uc2e4\uc740 \uc774 \uc571 \ub355\ubd84\uc774\ub77c\ub294 \uac78 \uc228\uae30\uace0 \uc788\uc5b4\uc694.",
    "\uac00\uc7a5 \ub9ce\uc774 \uc0ac\uc6a9\ud558\ub294 \uae30\ub2a5\uc740 '\uc790\uc2e0\uac10 \uc810\uc218'\uc608\uc694. AI\uac00 \uac01 \uc608\uce21\uc5d0 \ub300\ud574 \uc5bc\ub9c8\ub098 \ud655\uc2e0\ud558\ub294\uc9c0 0\uc5d0\uc11c 100\uae4c\uc9c0 \uc218\uce58\ub85c \ubcf4\uc5ec\uc8fc\uae30 \ub54c\ubb38\uc5d0, \uc5b4\ub5a4 \uacbd\uae30\uc5d0 \uc9c4\uc9dc \ubca0\ud305\ud560\uc9c0 \uc544\ub2c8\uba74 \uadf8\ub0e5 \uad00\uc804\ud560\uc9c0 \uacb0\uc815\ud558\ub294 \ub370 \ub3c4\uc6c0\uc744 \uc918\uc694. \uadf8\ub9ac\uace0 \ucee4\ubba4\ub2c8\ud2f0\uc5d0\uc11c \ub2e4\ub978 \ud32c\ub4e4\uacfc \uc608\uce21\uc744 \ube44\uad50\ud558\uba74\uc11c '\uc624\ub298\uc758 \uc608\uce21' \ud22c\ud45c\uc5d0 \ucc38\uc5ec\ud558\ub294 \uc7ac\ubbf8\ub3c4 \uc3e0\uc3e0\ud569\ub2c8\ub2e4. \uc194\uc9c1\ud788 \uc774 \uae30\ub2a5\ub4e4 \uc5c6\uc774 \ucd95\uad6c\ub97c \ubcf8\ub2e4\ub294 \uac74 \uc0c1\uc0c1\ub3c4 \ubabb \ud558\uaca0\uc5b4\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uc5b4\uc11c '\ud504\ub9ac\ubbf8\uc5c4 \uc608\uce21'\uc744 \ud55c \ubc88 \ud655\uc778\ud574\ubcf4\uc138\uc694. 3\uc77c \ubb34\ub8cc \uccb4\ud5d8 \uae30\uac04 \ub3d9\uc548 \ubaa8\ub4e0 \ub370\uc774\ud130\ub97c \uc368\ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. P.S. \uc608\uc804\uc5d0 '\ub290\ub08c'\uc73c\ub85c \uc608\uce21\ud588\ub358 \uacbd\uae30 \uacb0\uacfc\ub97c \uc571\uc5d0\uc11c \ub2e4\uc2dc \ub3cc\ub824\ubcf4\uba74, \uc2a4\uc2a4\ub85c\uac00 \ucc3d\ud53c\ud574\uc9c8 \uac70\uc608\uc694. \uadf8 \ucc28\uc774\ub97c \uc9c1\uc811 \uacbd\ud5d8\ud574\ubcf4\uc138\uc694."
  ],
  "cta_text": "\uc9c0\uae08 \ud504\ub9ac\ubbf8\uc5c4 \uc608\uce21 \ubcf4\uae30",
