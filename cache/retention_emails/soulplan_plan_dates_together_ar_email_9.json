{
  "subject": "\u0633\u0631 \u0639\u0644\u0627\u0642\u0627\u062a \u0623\u0641\u0636\u0644 \u0641\u064a 3 \u0623\u064a\u0627\u0645 \u0641\u0642\u0637",
  "preview_text": "\u062c\u0631\u0628 \u0627\u0644\u062a\u062d\u062f\u064a \u0627\u0644\u0630\u064a \u063a\u064a\u0631 \u062d\u064a\u0627\u0629 230 \u0632\u0648\u062c\u064a\u0646. \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0633\u062a\u0641\u0627\u062c\u0626\u0643",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0644\u0648 \u0642\u0644\u062a \u0644\u0643 \u0625\u0646 \u0641\u064a 3 \u0623\u064a\u0627\u0645 \u0628\u0633 \u0645\u0645\u0643\u0646 \u062a\u062e\u0644\u0642 \u0630\u0643\u0631\u0649 \u062a\u0641\u0636\u0644 \u0645\u0639\u0627\u0643 \u0637\u0648\u0644 \u0627\u0644\u0639\u0645\u0631\u061f \u0623\u0646\u0627 \u0645\u0634 \u0628\u0647\u0632\u0631. \u0645\u0639\u0638\u0645 \u0627\u0644\u0623\u0632\u0648\u0627\u062c \u0627\u0644\u0644\u064a \u0628\u064a\u0633\u062a\u062e\u062f\u0645\u0648 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u064a\u0642\u0648\u0644\u0648\u0627 \u0625\u0646 \u0623\u0648\u0644 \u062a\u062d\u062f\u064d \u0644\u064a\u0647\u0645 \u0643\u0627\u0646 \u0646\u0642\u0637\u0629 \u062a\u062d\u0648\u0644 \u0641\u064a \u0639\u0644\u0627\u0642\u062a\u0647\u0645.",
    "\u0625\u064a\u0647 \u0627\u0644\u0633\u0631\u061f \u0628\u0628\u0633\u0627\u0637\u0629\u060c \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u064a\u062f\u064a\u064a\u0643 \u062a\u062d\u062f\u064a \u0628\u0633\u064a\u0637: \u062e\u0637\u0637 \u0645\u0648\u0639\u062f \u0648\u0627\u062d\u062f \u0645\u062e\u062a\u0644\u0641 \u062a\u0645\u0627\u0645\u0627\u064b \u0639\u0646 \u0627\u0644\u0644\u064a \u0625\u0646\u062a \u0645\u0639\u062a\u0627\u062f \u0639\u0644\u064a\u0647. \u0645\u0634 \u0644\u0627\u0632\u0645 \u064a\u0643\u0648\u0646 \u063a\u0627\u0644\u064a \u0623\u0648 \u0645\u0639\u0642\u062f. \u0627\u0644\u0645\u0647\u0645 \u0625\u0646\u0643 \u062a\u062e\u0631\u062c \u0645\u0646 \u0627\u0644\u0631\u0648\u062a\u064a\u0646 \u0627\u0644\u0644\u064a \u0642\u062a\u0644 \u0627\u0644\u0631\u0648\u0645\u0627\u0646\u0633\u064a\u0629 \u0639\u0646\u062f \u0643\u062a\u064a\u0631.",
    "\u0641\u064a\u0647 \u062e\u0627\u0635\u064a\u0629 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0633\u0645\u0647\u0627 '\u0627\u0644\u062a\u062d\u062f\u064a \u0627\u0644\u062b\u0644\u0627\u062b\u064a' \u0647\u062a\u062f\u064a\u064a\u0643 \u0641\u0643\u0631\u0629 \u0645\u0648\u0639\u062f \u0643\u0644 \u064a\u0648\u0645 \u0644\u0645\u062f\u0629 3 \u0623\u064a\u0627\u0645. \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u064a\u062d\u0644\u0644 \u0627\u0647\u062a\u0645\u0627\u0645\u0627\u062a\u0643 \u0648\u0627\u0647\u062a\u0645\u0627\u0645\u0627\u062a \u0634\u0631\u064a\u0643\u0643 \u0648\u064a\u0642\u062a\u0631\u062d \u062d\u0627\u062c\u0627\u062a \u0645\u0628\u062a\u0643\u0631\u0629. \u0623\u0646\u0627 \u062c\u0631\u0628\u062a\u0647 \u0648\u0635\u062f\u0642\u0646\u064a \u0627\u0644\u0641\u0631\u0642 \u0643\u0627\u0646 \u0648\u0627\u0636\u062d.",
    "\u0625\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u062f\u0644\u0648\u0642\u062a\u064a \u0648\u0627\u0628\u062d\u062b \u0639\u0646 '\u0627\u0644\u062a\u062d\u062f\u064a \u0627\u0644\u062b\u0644\u0627\u062b\u064a'. \u0625\u0628\u062f\u0623 \u0627\u0644\u0646\u0647\u0627\u0631\u062f\u0629. \u0648\u0628\u0639\u062f 3 \u0623\u064a\u0627\u0645\u060c \u0627\u0643\u062a\u0628\u0644\u064a \u0631\u0623\u064a\u0643. \u0623\u0646\u0627 \u0645\u062a\u0623\u0643\u062f \u0625\u0646\u0643 \u0647\u062a\u0633\u062a\u063a\u0631\u0628.",
    "P.S. \u0645\u0639\u0638\u0645 \u0627\u0644\u0623\u0632\u0648\u0627\u062c \u0627\u0644\u0644\u064a \u062e\u0644\u0635\u0648\u0627 \u0627\u0644\u062a\u062d\u062f\u064a \u0642\u0627\u0644\u0648\u0627 \u0625\u0646\u0647\u0645 \u062d\u0633\u0648\u0627 \u0625\u0646 \u0627\u0644\u0634\u0631\u064a\u0643 \u0628\u064a\u0647\u062a\u0645 \u0628\u064a\u0647\u0645 \u0628\u0637\u0631\u064a\u0642\u0629 \u062c\u062f\u064a\u062f\u0629. \u062c\u0631\u0628 \u0648\u0634\u0648\u0641 \u0628\u0646\u0641\u0633\u0643."
  ],
