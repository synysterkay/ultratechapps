{
  "subject": "\u0642\u0635\u0629 \u062e\u0627\u0644\u062f \u0627\u0644\u062a\u064a \u062c\u0639\u0644\u062a\u0646\u0627 \u0646\u062a\u0648\u0642\u0641 \u062c\u0645\u064a\u0639\u0627\u064b",
  "preview_text": "\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u0627\u062d\u062f \u0641\u0642\u0637 \u063a\u064a\u0651\u0631 \u0646\u0638\u0631\u062a\u0646\u0627 \u062a\u0645\u0627\u0645\u0627\u064b. \u0625\u0642\u0631\u0623 \u0642\u0635\u062a\u0647 \u0644\u062a\u0643\u062a\u0634\u0641 \u0643\u064a\u0641 \u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u0637\u0631\u064a\u0642\u0629 \u0644\u0645 \u0646\u062a\u0648\u0642\u0639\u0647\u0627 \u0623\u0628\u062f\u0627\u064b.",
  "body_paragraphs": [
    "\u0642\u0628\u0644 \u0634\u0647\u0631\u060c \u062a\u0644\u0642\u064a\u0646\u0627 \u0631\u0633\u0627\u0644\u0629 \u0645\u0646 \u062e\u0627\u0644\u062f. \u0643\u0627\u0646 \u064a\u0643\u062a\u0628\u0647\u0627 \u0641\u064a \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0635\u0628\u0627\u062d\u0627\u064b\u060c \u0645\u062a\u062d\u0645\u0633\u0627\u064b \u0644\u062f\u0631\u062c\u0629 \u0623\u0646\u0647 \u0644\u0645 \u064a\u0633\u062a\u0637\u0639 \u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0631 \u062d\u062a\u0649 \u0627\u0644\u0635\u0628\u0627\u062d. \u0642\u0627\u0644: '\u0645\u0646\u0630 \u0623\u0646 \u0627\u0634\u062a\u0631\u064a\u062a \u0647\u0627\u062a\u0641\u064a \u0627\u0644\u062c\u062f\u064a\u062f\u060c \u0643\u0646\u062a \u0623\u0634\u0639\u0631 \u0623\u0646 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0645\u064a\u062a\u0629. \u0627\u0644\u0635\u0648\u062a \u0636\u0639\u064a\u0641\u060c \u0627\u0644\u0628\u0627\u0633 \u0645\u062e\u062a\u0641\u064a\u060c \u0648\u0643\u0644 \u0634\u064a\u0621 \u064a\u0628\u062f\u0648 \u0643\u0635\u0646\u062f\u0648\u0642 \u0643\u0631\u062a\u0648\u0646.' \u062b\u0645 \u0623\u0636\u0627\u0641: '\u0644\u0643\u0646 \u0627\u0644\u064a\u0648\u0645\u060c \u0648\u0644\u0623\u0648\u0644 \u0645\u0631\u0629\u060c \u0634\u0639\u0631\u062a \u0623\u0646\u0646\u064a \u0641\u064a \u062d\u0641\u0644\u0629 \u062d\u0642\u064a\u0642\u064a\u0629.' \u0647\u0630\u0647 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u062c\u0639\u0644\u062a \u0641\u0631\u064a\u0642\u064a \u064a\u062a\u0648\u0642\u0641 \u0639\u0646 \u0627\u0644\u0639\u0645\u0644 \u0648\u064a\u0642\u0631\u0623\u0647\u0627 \u0628\u0635\u0648\u062a \u0639\u0627\u0644\u064d.",
    "\u062e\u0627\u0644\u062f \u0644\u064a\u0633 \u0645\u0647\u0646\u062f\u0633 \u0635\u0648\u062a\u060c \u0648\u0644\u0627 \u062d\u062a\u0649 \u0645\u0646 \u0639\u0634\u0627\u0642 \u0627\u0644\u062a\u0642\u0646\u064a\u0629. \u0647\u0648 \u0623\u0628 \u064a\u0639\u0645\u0644 \u0641\u064a \u0645\u062c\u0627\u0644 \u0627\u0644\u0628\u0646\u0627\u0621\u060c \u064a\u062d\u0628 \u0627\u0644\u0627\u0633\u062a\u0645\u0627\u0639 \u0625\u0644\u0649 \u0627\u0644\u0628\u0648\u062f\u0643\u0627\u0633\u062a \u0623\u062b\u0646\u0627\u0621 \u0642\u064a\u0627\u062f\u062a\u0647\u060c \u0648\u0625\u0644\u0649 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0643\u0644\u0627\u0633\u064a\u0643\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u0633\u0627\u0621. \u0644\u0643\u0646 \u0645\u0634\u0643\u0644\u062a\u0647 \u0643\u0627\u0646\u062a \u0628\u0633\u064a\u0637\u0629: \u0647\u0627\u062a\u0641\u0647 \u0644\u0627 \u064a\u0639\u0637\u064a \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0630\u064a \u064a\u0633\u062a\u062d\u0642\u0647. \u062c\u0631\u0628 \u0643\u0644 \u0634\u064a\u0621 - \u0633\u0645\u0627\u0639\u0627\u062a \u0631\u062e\u064a\u0635\u0629\u060c \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0645\u0632\u064a\u0641\u0629\u060c \u0648\u062d\u062a\u0649 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0625\u0644\u0649 \u0623\u0642\u0635\u0649 \u062d\u062f - \u0644\u0643\u0646 \u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0643\u0627\u0646\u062a \u062f\u0627\u0626\u0645\u0627\u064b \u0635\u0648\u062a\u0627\u064b \u0645\u0634\u0648\u0647\u0627\u064b \u0648\u0636\u0639\u064a\u0641\u0627\u064b.",
    "\u062b\u0645 \u0627\u0643\u062a\u0634\u0641 \u0634\u064a\u0626\u0627\u064b \u0648\u0627\u062d\u062f\u0627\u064b \u0641\u064a \u062a\u0637\u0628\u064a\u0642\u0646\u0627: \u062e\u0627\u0635\u064a\u0629 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0628\u0646\u0642\u0631\u0629 \u0648\u0627\u062d\u062f\u0629. \u0644\u0643\u0646 \u0644\u064a\u0633 \u0641\u0642\u0637 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a - \u0628\u0644 \u0645\u0639\u0627\u062f\u0644 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u062f\u0645\u062c. \u0627\u062e\u062a\u0627\u0631 \u0625\u0639\u062f\u0627\u062f '\u0643\u0644\u0627\u0633\u064a\u0643' \u0644\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c \u0648\u0641\u062c\u0623\u0629 \u0633\u0645\u0639 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062a\u064a \u0643\u0627\u0646 \u064a\u0641\u062a\u0642\u062f\u0647\u0627: \u0639\u0632\u0641 \u0627\u0644\u0639\u0648\u062f \u0627\u0644\u0639\u0645\u064a\u0642\u060c \u0635\u0648\u062a \u0627\u0644\u0645\u0637\u0631\u0628 \u0627\u0644\u0648\u0627\u0636\u062d\u060c \u062d\u062a\u0649 \u062a\u0646\u0641\u0633\u0627\u062a \u0627\u0644\u0645\u063a\u0646\u064a. \u0642\u0627\u0644 \u0644\u0646\u0627: '\u0647\u0627\u062a\u0641\u064a \u0627\u0644\u0622\u0646 \u064a\u0628\u062f\u0648 \u0643\u062c\u0647\u0627\u0632 \u062c\u062f\u064a\u062f.'",
    "\u062c\u0631\u0628 \u0647\u0630\u0647 \u0627\u0644\u062e\u0627\u0635\u064a\u0629 \u0627\u0644\u0622\u0646: \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u062e\u062a\u0631 \u0623\u063a\u0646\u064a\u0629 \u0623\u0648 \u0628\u0648\u062f\u0643\u0627\u0633\u062a\u060c \u062b\u0645 \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a. \u0628\u0639\u062f\u0647\u0627\u060c \u062c\u0631\u0628 \u0625\u0639\u062f\u0627\u062f '\u062c\u0627\u0632' \u0623\u0648 '\u0628\u0648\u0628' \u0645\u0646 \u0645\u0639\u0627\u062f\u0644 \u0627\u0644\u0635\u0648\u062a. \u0633\u062a\u0634\u0639\u0631 \u0628\u0627\u0644\u0641\u0631\u0642 \u0641\u064a \u062b\u0648\u0627\u0646\u064d. \u0623\u0646\u062a \u0623\u064a\u0636\u0627\u064b \u062a\u0633\u062a\u062d\u0642 \u0623\u0646 \u062a\u0633\u0645\u0639 \u0635\u0648\u062a\u0643 \u0627\u0644\u062d\u0642\u064a\u0642\u064a.\n\n\u0645\u0644\u0627\u062d\u0638\u0629: \u062e\u0627\u0644\u062f \u0627\u0644\u0622\u0646 \u0645\u0634\u062a\u0631\u0643 \u0645\u0645\u064a\u0632\u060c \u0648\u064a\u0642\u0648\u0644 \u0625\u0646 \u062e\u0627\u0635\u064a\u0629 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u063a\u064a\u0631 \u0627\u0644\u0645\u062d\u062f\u0648\u062f\u0629 \u062c\u0639\u0644\u062a\u0647 \u0644\u0627 \u064a\u0639\u0648\u062f \u0623\u0628\u062f\u0627\u064b. \u062c\u0631\u0628\u0647\u0627 \u0645\u062c\u0627\u0646\u0627\u064b \u0644\u0645\u062f\u0629 7 \u0623\u064a\u0627\u0645."
  ],
  "cta_text": "\u0627\u0641\u062a\u062d \u0645\u0643\u0628\u0631 \u0627\u0644\u0635\u0648\u062a - \u0645\u0639\u0632\u0632 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0622\u0646",
