  "subject": "\u8fd9\u4e2a\u9690\u85cf\u529f\u80fd90%\u7684\u7528\u6237\u90fd\u9519\u8fc7\u4e86",
  "preview_text": "\u522b\u6025\u7740\u5220\u6389\uff0c\u4f60\u9519\u8fc7\u4e86\u4e00\u4e2a\u80fd\u8ba9\u8bba\u6587\u8f7b\u677e\u4eceC\u5230A\u7684\u79d8\u5bc6\u6b66\u5668\u3002",
  "body_paragraphs": [
    "\u4f60\u77e5\u9053\u5417\uff1f\u6628\u5929\u4f60\u4e0b\u8f7d\u540e\uff0c\u53ef\u80fd\u53ea\u7528\u4e86\u57fa\u7840\u529f\u80fd\u3002\u4f46\u6709\u4e2a\u9690\u85cf\u529f\u80fd\uff0c\u8fde90%\u7684\u8001\u7528\u6237\u90fd\u5ffd\u7565\u4e86\u2014\u2014\u76f4\u5230\u4ed6\u4eec\u53d1\u73b0\u65f6\uff0c\u540e\u6094\u6ca1\u65e9\u70b9\u7528\u3002",
    "\u60f3\u8c61\u4e00\u4e0b\uff1a\u4f60\u5361\u5728\u8bba\u6587\u5f00\u5934\uff0c\u8111\u5b50\u4e00\u7247\u7a7a\u767d\uff0cdeadline\u5728\u5c16\u53eb\u3002\u4f46\u5982\u679c\u4f60\u80fd\u4e00\u952e\u751f\u6210\u6574\u4e2a\u5927\u7eb2\uff0c\u751a\u81f3\u81ea\u52a8\u586b\u5145\u56fe\u8868\u548c\u5f15\u7528\uff0c\u662f\u4e0d\u662f\u611f\u89c9\u6551\u661f\u6765\u4e86\uff1f\u8fd9\u4e2a\u529f\u80fd\u5c31\u662f\u2018\u77ac\u95f4\u751f\u6210\u5b8c\u6574\u7ed3\u6784\u2019\u3002",
    "\u5b83\u85cf\u5728\u2018\u9ad8\u7ea7\u6a21\u5f0f\u2019\u91cc\uff0c\u70b9\u4e00\u4e0b\u5c31\u80fd\u4ece\u9898\u76ee\u76f4\u63a5\u8df3\u5230\u6846\u67b6\uff0c\u7701\u63898\u5c0f\u65f6\u7684\u7ea0\u7ed3\u3002\u522b\u8ba9\u5b83\u5403\u7070\uff0c\u5426\u5219\u4f60\u5c31\u50cf\u8003\u8bd5\u524d\u624d\u53d1\u73b0\u6709\u7b54\u6848\u4e66\u4e00\u6837\u4e8f\u3002",
    "\u73b0\u5728\u6253\u5f00App\uff0c\u70b9\u2018\u9ad8\u7ea7\u6a21\u5f0f\u2019\uff0c\u8bd5\u4e00\u6b21\u3002P.S. \u7528\u8fc7\u7684\u4eba\u8bf4\uff0c\u8bba\u6587\u8d28\u91cf\u76f4\u63a5\u4eceB\u8df3\u5230A-\uff0c\u4f60\u4e0d\u5fc3\u52a8\u5417\uff1f"
