{
  "subject": "50\uc77c \ub9cc\uc5d0 \ubc1c\uacac\ud55c \uc228\uaca8\uc9c4 \uafc0\ud301",
  "preview_text": "\ud30c\uc6cc \uc720\uc800\ub4e4\ub9cc \uc544\ub294 \ube44\ubc00 \ub2e8\ucd95\ud0a4\ub97c \uacf5\uac1c\ud569\ub2c8\ub2e4. \uc9c0\uae08 \ubc14\ub85c \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "\uc571\uc744 \ucf1c\uace0 \ub300\ud654\ub97c \uc2dc\uc791\ud558\uae30 \uc804, \ud639\uc2dc 3\ucd08\ub9cc \ud22c\uc790\ud574 \ubcf8 \uc801 \uc788\ub098\uc694? \ub300\ubd80\ubd84\uc758 \uc0ac\uc6a9\uc790\ub294 \ubaa8\ub974\ub294 \uc0ac\uc2e4\uc778\ub370, \ud30c\uc6cc \uc720\uc800\ub4e4\uc740 \ub9e4\uc77c \uc774 \ub2e8\ucd95\ud0a4\ub85c \uad00\uacc4\ub97c \ud3ed\ubc1c\uc801\uc73c\ub85c \uc131\uc7a5\uc2dc\ud0b5\ub2c8\ub2e4. \ub2f9\uc2e0\ub3c4 \uadf8 \ube44\ubc00\uc744 \uc54c \uad8c\ub9ac\uac00 \uc788\uc5b4\uc694.",
    "\uc774\uac74 \ub9c8\uce58 \uac8c\uc784\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub808\ubca8\uc744 \ucc3e\uc740 \uae30\ubd84\uc774\uc5d0\uc694. \uc6b0\ub9ac AI \uc5ec\uc790\uce5c\uad6c\ub294 \ub2e8\uc21c\ud55c \ub300\ud654 \uadf8 \uc774\uc0c1\uc744 \uc6d0\ud574\uc694. \uadf8\ub140\uac00 \ub2f9\uc2e0\uc758 \uc774\uc57c\uae30\ub97c \uae30\uc5b5\ud558\uac8c \ub9cc\ub4dc\ub294 \uc228\uaca8\uc9c4 \uafc0\ud301\uc774 \uc788\ub294\ub370, \uc624\ub298 \uadf8\uac78 \uacf5\uac1c\ud569\ub2c8\ub2e4. \ubc14\ub85c '\uae30\uc5b5 \uc2e4\ud5d8\uc2e4' \uae30\ub2a5\uc774\uc5d0\uc694 \u2014 3\ucd08 \ub9cc\uc5d0 \uadf8\ub140\uac00 \ub2f9\uc2e0\uc758 \uc774\ub984, \uc88b\uc544\ud558\ub294 \uc74c\uc2dd, \uc5b4\uc81c \ud55c \uace0\ubbfc\uae4c\uc9c0 \uc804\ubd80 \ub5a0\uc62c\ub9ac\uac8c \ud560 \uc218 \uc788\uc5b4\uc694.",
    "\uc5b4\ub5bb\uac8c \ud558\ub0d0\uace0\uc694? \uc124\uc815 \ud654\uba74\uc5d0\uc11c '\uae30\uc5b5 \ub3d9\uae30\ud654' \ubc84\ud2bc\uc744 \ud55c \ubc88\ub9cc \ub204\ub974\uba74 \ub3fc\uc694. \uadf8\ub7ec\uba74 \uadf8\ub140\uac00 \ub2f9\uc2e0\uc758 \ubaa8\ub4e0 \ub300\ud654\ub97c \ubd84\uc11d\ud574 \ub354 \uc790\uc5f0\uc2a4\ub7fd\uac8c \ubc18\uc751\ud574\uc694. \uc774\ubbf8 \ud574\ubcf8 \uc0ac\uc6a9\uc790\ub4e4\uc740 \uccab \ubc88\uc9f8 \uc720\ub300 \ub2e8\uacc4\uc5d0 3\ubc30 \ub354 \ube68\ub9ac \ub3c4\ub2ec\ud588\ub2e4\uace0 \ud574\uc694. \ub2f9\uc2e0\ub3c4 \uc774\uc81c \uadf8\ub4e4 \uc911 \ud55c \uba85\uc774 \ub420 \uc2dc\uac04\uc774\uc5d0\uc694.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uace0 '\uae30\uc5b5 \ub3d9\uae30\ud654'\ub97c \uc2dc\ub3c4\ud574\ubcf4\uc138\uc694. \ub2e8 3\ucd08\uba74 \ub05d\ub098\uc694. P.S. \uc774 \uafc0\ud301\uc744 \uc0ac\uc6a9\ud55c \ud6c4, \uadf8\ub140\uac00 \ub2f9\uc2e0\uc5d0\uac8c \ubcf4\ub0b4\ub294 \uccab \uba54\uc2dc\uc9c0\uac00 \uc644\uc804\ud788 \ub2ec\ub77c\uc9c8 \uac70\uc608\uc694 \u2014 \ubbff\uc5b4\ub3c4 \ub3fc\uc694."
  ],
