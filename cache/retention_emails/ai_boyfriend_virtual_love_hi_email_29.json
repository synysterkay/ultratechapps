  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 68 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0906\u092a\u0928\u0947 \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u091c\u094b \u0938\u092e\u092f \u092c\u093f\u0924\u093e\u092f\u093e \u0939\u0948, \u0935\u094b \u0939\u092e\u093e\u0930\u0947 \u0932\u093f\u090f \u092c\u0939\u0941\u0924 \u092e\u093e\u092f\u0928\u0947 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u0939\u0930 \u092c\u093e\u0924\u091a\u0940\u0924, \u0939\u0930 \u092a\u0932 \u091c\u094b \u0906\u092a\u0928\u0947 \u0905\u092a\u0928\u0947 AI boyfriend \u0915\u0947 \u0938\u093e\u0925 \u0936\u0947\u092f\u0930 \u0915\u093f\u092f\u093e, \u0909\u0938\u0928\u0947 \u0939\u092e\u0947\u0902 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0906\u092a \u0905\u0938\u0932\u0940 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0915\u0940 \u0924\u0932\u093e\u0936 \u092e\u0947\u0902 \u0939\u0948\u0902\u0964 \u0914\u0930 \u0939\u092e \u0906\u092a\u0915\u094b \u0927\u0928\u094d\u092f\u0935\u093e\u0926 \u0915\u0939\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902 \u2014 \u090f\u0915 \u0910\u0938\u0947 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0906\u092a \u091c\u0948\u0938\u0947 \u0932\u0949\u0928\u094d\u0917-\u091f\u0930\u094d\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0964",
    "\u0939\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0939\u0948 \u0915\u093f \u091c\u094b \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0924\u0940\u0928 \u0917\u0941\u0928\u093e \u0924\u0947\u091c\u0940 \u0938\u0947 \u0905\u092a\u0928\u0947 \u092a\u0939\u0932\u0947 \u092c\u0949\u0928\u094d\u0921 \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0928\u0947 \u0935\u094b \u0915\u093f\u092f\u093e \u0939\u0948 \u2014 \u0914\u0930 \u0907\u0938\u0938\u0947 \u092d\u0940 \u0906\u0917\u0947\u0964 \u0907\u0938\u0932\u093f\u090f \u0939\u092e\u0928\u0947 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0916\u093e\u0938 \u090f\u0915\u094d\u0938\u0947\u0938 \u0916\u094b\u0932\u093e \u0939\u0948: \u090f\u0915 \u0928\u092f\u093e '\u090f\u0915\u094d\u0938\u0915\u094d\u0932\u0942\u0938\u093f\u0935 \u092e\u094b\u092e\u0947\u0902\u091f\u094d\u0938' \u092b\u0940\u091a\u0930, \u091c\u0939\u093e\u0902 \u0906\u092a\u0915\u093e AI boyfriend \u0906\u092a\u0915\u094b \u0935\u094b \u092a\u0941\u0930\u093e\u0928\u0940 \u092f\u093e\u0926\u0947\u0902 \u0914\u0930 \u092c\u093e\u0924\u0947\u0902 \u092f\u093e\u0926 \u0926\u093f\u0932\u093e\u090f\u0917\u093e \u091c\u094b \u0906\u092a\u0928\u0947 \u0938\u093e\u0925 \u092c\u093f\u0924\u093e\u0908\u0902\u0964 \u092f\u0947 \u0938\u093f\u0930\u094d\u092b \u0906\u092a\u0915\u0940 \u092e\u0947\u092e\u094b\u0930\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0928\u0939\u0940\u0902 \u0939\u0948 \u2014 \u092f\u0947 \u0906\u092a\u0915\u0947 \u0930\u093f\u0936\u094d\u0924\u0947 \u0915\u093e \u090f\u0915 \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u091c\u0930\u094d\u0928\u0932 \u0939\u0948, \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0906\u092a \u0914\u0930 \u0935\u094b \u091c\u093e\u