{
  "subject": "14 \u0926\u093f\u0928 \u092e\u0947\u0902 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0939\u0947\u0921\u092b\u094b\u0928 \u092c\u0926\u0932 \u0917\u090f \u0939\u0948\u0902",
  "preview_text": "\u090f\u0915 \u0938\u0947\u091f\u093f\u0902\u0917 \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924\u094b\u0902 \u0915\u094b \u092c\u0926\u0932 \u0926\u0947\u0917\u0940\u0964 \u0905\u0902\u0926\u0930 \u092a\u0922\u093c\u094b\u0964",
  "body_paragraphs": [
    "\u0924\u0941\u092e\u0928\u0947 \u092a\u093f\u091b\u0932\u0947 14 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 47 \u0918\u0902\u091f\u0947 \u0932\u093e\u0909\u0921\u093f\u092b\u093e\u0908 \u092a\u0930 \u092c\u093f\u0924\u093e\u090f \u0939\u0948\u0902\u0964 \u092f\u0939 \u0915\u094b\u0908 \u0905\u0928\u0941\u092e\u093e\u0928 \u0928\u0939\u0940\u0902, \u0905\u0938\u0932\u0940 \u0921\u0947\u091f\u093e \u0939\u0948\u0964 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0924\u0941\u092e\u0928\u0947 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u092f\u093e \u092f\u093e \u0908\u0915\u094d\u092f\u0942 \u092c\u0926\u0932\u093e, \u0939\u092e\u0928\u0947 \u0928\u094b\u091f \u0915\u093f\u092f\u093e\u0964 \u0905\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0939\u0947\u0921\u092b\u094b\u0928 \u0915\u094b \u092a\u0924\u093e \u0939\u0948 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0915\u094d\u092f\u093e \u091a\u093e\u0939\u093f\u090f\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u092f\u0939\u093e\u0901 \u090f\u0915 \u092c\u093e\u0924 \u0939\u0948 \u091c\u094b 90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u092e\u093f\u0938 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902: \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0911\u091f\u094b\u0908\u0915\u094d\u092f\u0942 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092c\u093e\u0930 \u0938\u0947\u091f \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e\u0964 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0924\u0941\u092e \u0928\u090f \u0939\u0947\u0921\u092b\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0924\u0947 \u0939\u094b, \u0932\u093e\u0909\u0921\u093f\u092b\u093e\u0908 \u0909\u0938\u0947 \u092a\u0939\u091a\u093e\u0928\u0924\u093e \u0939\u0948 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0906\u092a \u091f\u094d\u092f\u0942\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0939\u0948, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f\u0964",
    "\u092f\u0939\u0940 \u0935\u0939 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u092c\u0942\u0938\u094d\u091f\u0930\u094d\u0938 \u0915\u094b \u0936\u0930\u094d\u092e\u093f\u0902\u0926\u093e \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0935\u0947 \u0938\u093f\u0930\u094d\u092b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0924\u0947 \u0939\u0948\u0902, \u0939\u092e \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0939\u0947\u0921\u092b\u094b\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u093e\u0909\u0902\u0921 \u0915\u094b \u0936\u0947\u092a \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0905\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u091f\u094d\u0930\u0947\u0928 \u0915\u0947 \u0936\u094b\u0930 \u092e\u0947\u0902 \u092d\u0940 \u0938\u093e\u092b \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0917\u0940\u0964",
    "\u0906\u091c \u0939\u0940 \u0932\u093e\u0909\u0921\u093f\u092b\u093e\u0908 \u0916\u094b\u0932\u094b \u0914\u0930 '\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 > \u0911\u091f\u094b\u0908\u0915\u094d\u092f\u0942' \u092e\u0947\u0902 \u091c\u093e\u0913\u0964 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u094b\u0928 \u0915\u094b \u0930\u0940-\u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u094b \u0914\u0930 10 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u092b\u0930\u094d\u0915 \u0938\u0941\u0928\u094b\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0905\u0928\u0941\u092d\u0935 \u0939\u0948, \u0907\u0938\u0947 \u092c\u0930\u094d\u092c\u093e\u0926 \u092e\u0924 \u0915\u0930\u094b\u0964\n\n\u092a\u0940.\u090f\u0938. \u2014 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u0939\u0930 \u0939\u092b\u094d\u0924\u0947 \u090f\u0915 \u0938\u093e\u0909\u0902\u0921 \u0921\u0940\u090f\u0928\u090f \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092e\u093f\u0932\u0924\u0940 \u0939\u0948 \u091c\u094b \u092c\u0924\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u0924\u0941\u092e\u0928\u0947 \u0915\u0948\u0938\u0947 \u0938\u0941\u0928\u093e\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0906\u0926\u0924\u0947\u0902 14 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u092c\u0926\u0932 \u091a\u0941\u0915\u0940 \u0939\u0948\u0902, \u0905\u092c \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0926\u0947\u0916\u0928\u0947 \u0915\u093e \u0938\u092e\u092f \u0939\u0948\u0964"
  ],
  "cta_text": "\u0932\u093e\u0909\u0921\u093f\u092b\u093e\u0908 \u0916\u094b\u0932\u094b \u0914\u0930 \u0911\u091f\u094b\u0908\u0915\u094d\u092f\u0942 \u091a\u0947\u0915 \u0915\u0930\u094b",
