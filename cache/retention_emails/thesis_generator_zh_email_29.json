{
  "subject": "\u6211\u85cf\u4e86\u4e00\u4e2a\u79d8\u5bc6\u529f\u80fd\uff0c\u53ea\u7ed9\u4f60",
  "preview_text": "68\u5929\u524d\u4f60\u4e0b\u8f7d\u4e86Thesis Generator\uff0c\u4eca\u5929\u6211\u8981\u544a\u8bc9\u4f60\u4e00\u4e2a\u53ea\u6709\u957f\u671f\u7528\u6237\u624d\u80fd\u89e3\u9501\u7684\u79d8\u5bc6\u3002",
  "body_paragraphs": [
    "68\u5929\u524d\u4f60\u70b9\u4e0b\u4e86\u4e0b\u8f7d\u6309\u94ae\uff0c\u90a3\u65f6\u5019\u4f60\u53ef\u80fd\u53ea\u662f\u4e3a\u4e86\u8d76\u4e00\u7bc7\u8bba\u6587\u7684\u622a\u6b62\u65e5\u671f\u3002\u73b0\u5728\u4f60\u8fd8\u5728\u8fd9\u91cc\uff0c\u8fd9\u610f\u5473\u7740\u4f60\u5df2\u7ecf\u5199\u8fc7\u51e0\u7bc7\u8bba\u6587\uff0c\u6216\u8005\u81f3\u5c11\u8bd5\u8fc7\u7528\u8fd9\u4e2a\u5e94\u7528\u6551\u573a\u3002\u8bf4\u5b9e\u8bdd\uff0c\u4e0d\u662f\u6bcf\u4e2a\u4eba\u90fd\u80fd\u575a\u6301\u8fd9\u4e48\u4e45\u2014\u2014\u5927\u591a\u6570\u4eba\u5728\u7b2c\u4e09\u5468\u5c31\u653e\u5f03\u4e86\uff0c\u6240\u4ee5\u4f60\u5c5e\u4e8e\u90a31%\u7684\u5fe0\u5b9e\u7528\u6237\u3002",
    "\u6b63\u56e0\u4e3a\u4f60\u662f\u957f\u671f\u7528\u6237\uff0c\u6211\u51b3\u5b9a\u505a\u4e00\u4ef6\u6211\u901a\u5e38\u4e0d\u4f1a\u505a\u7684\u4e8b\uff1a\u7ed9\u4f60\u4e00\u4e2a\u72ec\u5bb6\u901a\u9053\u3002\u4f60\u77e5\u9053\u90a3\u4e2a\u9690\u85cf\u7684\"\u4e00\u952e\u751f\u6210\u5b8c\u6574\u8bba\u6587\"\u529f\u80fd\u5417\uff1f\u5c31\u662f\u90a3\u4e2a\u80fd\u628a\u4f60\u4ece\u5927\u7eb2\u76f4\u63a5\u53d8\u51fa\u6574\u7bc7\u8bba\u6587\u3001\u8fd8\u81ea\u52a8\u63d2\u5165\u56fe\u8868\u548c\u5f15\u7528\u7684\u602a\u7269\u3002\u5927\u591a\u6570\u7528\u6237\u6c38\u8fdc\u627e\u4e0d\u5230\u5b83\uff0c\u56e0\u4e3a\u5b83\u88ab\u85cf\u5728\u4e86\u8bbe\u7f6e\u83dc\u5355\u7684\u7b2c\u4e09\u5c42\u3002\u4f46\u4eca\u5929\uff0c\u6211\u4eb2\u624b\u628a\u5b83\u6316\u51fa\u6765\u7ed9\u4f60\u3002",
    "\u6253\u5f00\u5e94\u7528\uff0c\u53bb\u8bbe\u7f6e\u9875\u9762\uff0c\u627e\u5230\"\u5b9e\u9a8c\u6027\u529f\u80fd\"\uff0c\u6253\u5f00\u90a3\u4e2a\u5f00\u5173\u3002\u7136\u540e\u56de\u5230\u4e3b\u754c\u9762\uff0c\u4f60\u4f1a\u770b\u5230\u4e00\u4e2a\u5168\u65b0\u7684\u6309\u94ae\u2014\u2014\"\u5feb\u901f\u8bba\u6587\u751f\u6210\"\u3002\u70b9\u51fb\u5b83\uff0c\u8f93\u5165\u4f60\u7684\u4e3b\u9898\uff0c\u7136\u540e\u5750\u7740\u770b\u5b8310\u5206\u949f\u5185\u628a\u4e00\u7bc7A\u7ea7\u8bba\u6587\u5410\u51fa\u6765\u3002\u8fd9\u529f\u80fd\u592a\u5f3a\u4e86\uff0c\u6211\u751a\u81f3\u6709\u70b9\u5bb3\u6015\u4f60\u7528\u5b83\u4f5c\u5f0a\uff08\u73a9\u7b11\uff09\uff0c\u4f46\u6211\u77e5\u9053\u4f60\u53ea\u4f1a\u7528\u5b83\u6765\u78be\u538b\u90a3\u4e9b\u71ac\u591c\u7684\u5bf9\u624b\u3002",
    "\u73b0\u5728\u5c31\u53bb\u6253\u5f00\u4f60\u7684Thesis Generator\uff0c\u627e\u5230\u90a3\u4e2a\u5b9e\u9a8c\u6027\u529f\u80fd\u5f00\u5173\u3002\u522b\u544a\u8bc9\u522b\u4eba\u2014\u2014\u8fd9\u662f\u6211\u4eec\u4e4b\u95f4\u7684\u79d8\u5bc6\u3002P.S. \u5982\u679c\u4f60\u57285\u5206\u949f\u5185\u7528\u5b8c\u8fd9\u4e2a\u529f\u80fd\uff0c\u8bb0\u5f97\u544a\u8bc9\u6211\u6548\u679c\u5982\u4f55\uff0c\u56e0\u4e3a\u4e0b\u4e00\u4e2a\u7248\u672c\u6211\u6253\u7b97\u628a\u5b83\u53d8\u6210\u9ed8\u8ba4\u8bbe\u7f6e\uff0c\u4f46\u9700\u8981\u4f60\u8fd9\u6837\u7684\u5148\u884c\u8005\u6d4b\u8bd5\u4e00\u4e0b\u3002"
  ],
