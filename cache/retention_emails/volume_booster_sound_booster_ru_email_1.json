{
  "subject": "\u041a\u043e\u043d\u0446\u0435\u0440\u0442 \u0432 \u043a\u0430\u0440\u043c\u0430\u043d\u0435 \u2014 1 \u043a\u0430\u0441\u0430\u043d\u0438\u0435",
  "preview_text": "\u0422\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0437\u0432\u0443\u0447\u0438\u0442 \u043a\u0430\u043a \u0434\u0435\u0448\u0435\u0432\u043e\u0435 \u0440\u0430\u0434\u0438\u043e. \u041e\u0434\u043d\u043e \u043d\u0430\u0436\u0430\u0442\u0438\u0435 \u0432\u0441\u0451 \u043c\u0435\u043d\u044f\u0435\u0442. \u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0441\u0435\u0439\u0447\u0430\u0441.",
  "body_paragraphs": [
    "\u042f \u0437\u043d\u0430\u044e, \u0442\u044b \u0441\u043a\u0430\u0447\u0430\u043b Volume Booster, \u043d\u043e \u043f\u043e\u043a\u0430 \u043d\u0435 \u043e\u0442\u043a\u0440\u044b\u043b. \u0418 \u044f \u043f\u043e\u043d\u0438\u043c\u0430\u044e \u2014 \u0443 \u0442\u0435\u0431\u044f \u043a\u0443\u0447\u0430 \u0434\u0435\u043b, \u043b\u0435\u043d\u044c \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044c\u0441\u044f. \u041d\u043e \u0432\u043e\u0442 \u0447\u0442\u043e: \u0442\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0441\u0435\u0439\u0447\u0430\u0441 \u0437\u0432\u0443\u0447\u0438\u0442 \u0442\u0438\u0448\u0435, \u0447\u0435\u043c \u043c\u043e\u0433 \u0431\u044b. \u041d\u0430 200% \u0442\u0438\u0448\u0435. \u042d\u0442\u043e \u043a\u0430\u043a \u0441\u043b\u0443\u0448\u0430\u0442\u044c \u043b\u044e\u0431\u0438\u043c\u044b\u0439 \u0442\u0440\u0435\u043a \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u0435\u043d\u0443.",
    "\u042f \u0441\u0430\u043c \u0431\u0435\u0441\u0438\u043b\u0441\u044f, \u043a\u043e\u0433\u0434\u0430 \u0432 \u043c\u0435\u0442\u0440\u043e \u0438\u043b\u0438 \u043a\u0430\u0444\u0435 \u043d\u0435 \u0441\u043b\u044b\u0448\u0430\u043b \u043f\u043e\u0434\u043a\u0430\u0441\u0442, \u0430 \u043c\u0443\u0437\u044b\u043a\u0430 \u043d\u0430 Spotify \u0437\u0432\u0443\u0447\u0430\u043b\u0430 \u043f\u043b\u043e\u0441\u043a\u043e, \u0431\u0435\u0437 \u0431\u0430\u0441\u0430. \u041e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f, \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0440\u0435\u0436\u0435\u0442 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c, \u0447\u0442\u043e\u0431\u044b \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438 \u043d\u0435 \u0441\u0433\u043e\u0440\u0435\u043b\u0438. \u041d\u043e \u0435\u0441\u0442\u044c \u043b\u0430\u0437\u0435\u0439\u043a\u0430 \u2014 \u043e\u0434\u0438\u043d \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043d\u0438\u043c\u0430\u0435\u0442 \u044d\u0442\u043e\u0442 \u0431\u043b\u043e\u043a.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Volume Booster, \u043d\u0430\u0436\u043c\u0438 \u043a\u043d\u043e\u043f\u043a\u0443 \u00ab\u0423\u0441\u0438\u043b\u0438\u0442\u044c\u00bb \u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u043a\u0440\u0443\u0442\u0438 \u043d\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0443. \u0411\u0435\u0437 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a, \u0431\u0435\u0437 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438. \u0422\u044b \u0443\u0441\u043b\u044b\u0448\u0438\u0448\u044c \u0440\u0430\u0437\u043d\u0438\u0446\u0443 \u0437\u0430 10 \u0441\u0435\u043a\u0443\u043d\u0434 \u2014 \u0431\u0430\u0441 \u043f\u043e\u044f\u0432\u0438\u0442\u0441\u044f, \u0433\u043e\u043b\u043e\u0441\u0430 \u0441\u0442\u0430\u043d\u0443\u0442 \u0447\u0435\u0442\u0447\u0435, \u0430 \u0437\u0432\u0443\u043a \u043d\u0430\u043f\u043e\u043b\u043d\u0438\u0442 \u043a\u043e\u043c\u043d\u0430\u0442\u0443. \u042d\u0442\u043e \u043a\u0430\u043a \u0441\u043d\u044f\u0442\u044c \u0432\u0430\u0442\u0443 \u0441 \u0443\u0448\u0435\u0439.",
    "\u0421\u0434\u0435\u043b\u0430\u0439 \u044d\u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441, \u043f\u043e\u043a\u0430 \u043d\u0435 \u0437\u0430\u0431\u044b\u043b. \u041f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u043d\u0430\u0436\u043c\u0438 \u00ab\u0423\u0441\u0438\u043b\u0438\u0442\u044c\u00bb. P.S. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u043a\u0430\u0447\u0430\u0442\u044c \u0437\u0432\u0443\u043a \u2014 \u0437\u0430\u0439\u0434\u0438 \u0432 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u0438 \u0432\u044b\u0431\u0435\u0440\u0438 \u043f\u0440\u0435\u0441\u0435\u0442 \u00ab\u0420\u043e\u043a\u00bb. \u0422\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0437\u0430\u0437\u0432\u0443\u0447\u0438\u0442 \u043a\u0430\u043a \u043a\u043e\u043d\u0446\u0435\u0440\u0442\u043d\u0430\u044f \u043a\u043e\u043b\u043e\u043d\u043a\u0430."
  ],
