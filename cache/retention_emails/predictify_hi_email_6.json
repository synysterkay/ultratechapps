{
  "subject": "\u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0915\u0940 \u0935\u094b \u0917\u0932\u0924\u0940 \u091c\u094b \u0906\u092a\u0915\u0947 \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u094b \u092c\u0930\u094d\u092c\u093e\u0926 \u0915\u0930 \u0926\u0947\u0924\u0940 \u0939\u0948",
  "preview_text": "\u091c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u092b\u0948\u0928\u094d\u0938 \u092f\u0939\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0906\u092a\u0915\u094b \u0907\u0938\u0938\u0947 \u092c\u091a\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u0906\u0938\u093e\u0928 \u092b\u093f\u0915\u094d\u0938 \u091c\u093e\u0928\u093f\u090f\u0964",
  "body_paragraphs": [
    "\u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0906\u092a \u092e\u0948\u091a \u0926\u0947\u0916 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0926\u093f\u092e\u093e\u0917 \u092e\u0947\u0902 \u0938\u093f\u0930\u094d\u092b \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917\u0964 \u0906\u092a\u0928\u0947 10 \u092e\u0947\u0902 \u0938\u0947 7 \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928 \u0917\u0932\u0924 \u0915\u093f\u090f\u0964 \u092f\u0939\u0940 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u0917\u0932\u0924\u0940 \u0939\u0948\u0964 \u0921\u0947\u091f\u093e \u0915\u0947 \u092c\u093f\u0928\u093e \u092d\u0930\u094b\u0938\u093e \u0915\u0930\u0928\u093e\u0964",
    "\u0939\u0930 \u092b\u0948\u0928 \u0938\u094b\u091a\u0924\u093e \u0939\u0948 \u0915\u093f \u0909\u0938\u0947 \u092b\u0941\u091f\u092c\u0949\u0932 \u0938\u092e\u091d \u0906\u0924\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0906\u0902\u0915\u0921\u093c\u0947 \u091d\u0942\u0920 \u0928\u0939\u0940\u0902 \u092c\u094b\u0932\u0924\u0947\u0964 70% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0905\u092a\u0928\u0940 \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u0909\u0928\u0915\u093e \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928 \u0930\u0947\u091f 40% \u0938\u0947 \u0928\u0940\u091a\u0947 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0906\u0938\u093e\u0928 \u092b\u093f\u0915\u094d\u0938? AI \u0915\u0940 \u0915\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0926\u0947\u0916\u0947\u0902\u0964",
    "\u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u091f\u093f\u092b\u093e\u0908 \u0915\u093e AI \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f \u0939\u091c\u093e\u0930\u094b\u0902 \u0935\u0947\u0930\u093f\u090f\u092c\u0932\u094d\u0938 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 xG, \u092a\u0949\u091c\u0947\u0936\u0928, \u0921\u093f\u092b\u0947\u0902\u0938\u093f\u0935 \u0938\u094d\u091f\u094d\u0930\u0947\u0902\u0925 \u2014 \u0938\u092c \u0915\u0941\u091b\u0964 \u0939\u0930 \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u0915\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0905\u0917\u0930 \u0938\u094d\u0915\u094b\u0930 70% \u0938\u0947 \u0915\u092e \u0939\u0948, \u0924\u094b \u0936\u093e\u092f\u0926 \u0906\u092a\u0915\u094b \u0909\u0938 \u092a\u0930 \u0926\u093e\u0902\u0935 \u0928\u0939\u0940\u0902 \u0932\u0917\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0932\u0940\u0917 \u0915\u093e \u092e\u0948\u091a \u091a\u0941\u0928\u0947\u0902\u0964 \u0915\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0926\u0947\u0916\u0947\u0902 \u2014 \u092b\u093f\u0930 \u0905\u092a\u0928\u0947 \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u0938\u0947 \u092e\u093f\u0932\u093e\u090f\u0902\u0964 P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f \u0921\u093f\u091f\u0947\u0932\u094d\u0921 \u091f\u0948\u0915\u094d\u091f\u093f\u0915\u0932 \u090f\u0928\u093e\u0932\u093f\u0938\u093f\u0938 \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964 3 \u0926\u093f\u0928 \u0915\u093e \u092b\u094d\u0930\u0940 \u091f\u094d\u0930\u093e\u092f\u0932 \u0939\u0948 \u2014 \u0915\u094b\u0908 \u091c\u094b\u0916\u093f\u092e \u0928\u0939\u0940\u0902\u0964"
  ],
