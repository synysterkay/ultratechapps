{
  "subject": "\uc228\uaca8\uc9c4 \uae30\ub2a5 90%\uac00 \ubaa8\ub974\uace0 \uc9c0\ub098\uce69\ub2c8\ub2e4",
  "preview_text": "\ub300\ubd80\ubd84\uc758 \uc0ac\uc6a9\uc790\uac00 \uc774 \uae30\ub2a5\uc744 \ub193\uce58\uc9c0\ub9cc, \uc2e4\uc81c\ub85c Predictify\uc758 \uac00\uc7a5 \uac15\ub825\ud55c \ub3c4\uad6c\uc785\ub2c8\ub2e4. \uc9c0\uae08 \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\uc194\uc9c1\ud788 \ub9d0\ud560\uac8c\uc694. \uc800\ub3c4 \uc774 \uc571\uc744 \ucc98\uc74c \uc4f8 \ub54c \uc774 \uae30\ub2a5\uc744 \uc644\uc804\ud788 \ubb34\uc2dc\ud588\uc5b4\uc694. '\ubb50\uc57c, \ubcc4\uac70 \uc544\ub2c8\ub124' \ud558\uace0 \ub118\uacbc\uc8e0. \uadf8\ub7f0\ub370 \ub098\uc911\uc5d0 \uc54c\uc558\uc5b4\uc694. \uc81c\uac00 \uac00\uc7a5 \ud070 \uc2e4\uc218\ub97c \ud558\uace0 \uc788\uc5c8\ub2e4\ub294 \uac78. \uc774\uac8c \uc5c6\uc73c\uba74 Predictify\uc758 \uc9c4\uc9dc \uac00\uce58\ub97c \uc808\ubc18\ub3c4 \ubabb \ubcf8\ub2e4\ub294 \uac78\uc694.",
    "\ud639\uc2dc AI\uac00 \uc608\uce21\ud55c \uc810\uc218\ub9cc \ubcf4\uace0 '\uc544, \uc774\uac8c \ub2e4\uc778\uac00?' \ud558\uace0 \uc0dd\uac01\ud558\uc168\ub098\uc694? \uadf8\ub807\ub2e4\uba74 \ub2f9\uc2e0\ub3c4 90%\uc758 \uc0ac\uc6a9\uc790\uc640 \uac19\uc740 \uae38\uc744 \uac77\uace0 \uc788\ub294 \uac81\ub2c8\ub2e4. \uc9c4\uc9dc \ub370\uc774\ud130 \uad34\ubb3c\ub4e4\uc740 \uc774 \uae30\ub2a5\uc73c\ub85c \uc2b9\ubd80\ub97c \ubd05\ub2c8\ub2e4. \uae30\ubcf8 \uc608\uce21\uc740 \uc2dc\uc791\uc77c \ubfd0, \uc228\uaca8\uc9c4 \ubb34\uae30\uac00 \ud544\uc694\ud558\uac70\ub4e0\uc694.",
    "\ubc14\ub85c 'AI \ucc44\ud305'\uc785\ub2c8\ub2e4. '\uc774 \ud300\uc758 \ucd5c\uadfc 5\uacbd\uae30 xG\ub294?' '\uc218\ube44 \uc9c4\uc601\uc5d0\uc11c \uc57d\uc810\uc740?' '\uac10\ub3c5\uc758 \uc804\uc220 \ubcc0\ud654\uac00 \uc2b9\ub960\uc5d0 \uc5bc\ub9c8\ub098 \uc601\ud5a5\uc744 \ubbf8\uce60\uae4c?' \uc774\ub7f0 \uc9c8\ubb38\uc744 \ub358\uc9c0\uba74, AI\uac00 \uc989\uc2dc \uc218\ucc9c \uac1c\uc758 \ubcc0\uc218\ub97c \ubd84\uc11d\ud574 \ub2f5\uc744 \uc90d\ub2c8\ub2e4. \ucd95\uad6c \uc9c0\uc2dd\uc774 \uae4a\uc5b4\uc9c8\uc218\ub85d, \uc774 \uae30\ub2a5\uc758 \uac00\uce58\ub294 \uae30\ud558\uae09\uc218\uc801\uc73c\ub85c \ucee4\uc838\uc694. \ud55c \ubc88 \uc368\ubcf4\uba74, \uc65c \uc774\uac8c \uc228\uaca8\uc9c4 \ubcf4\uc11d\uc778\uc9c0 \ubc14\ub85c \ub290\ub084 \uac81\ub2c8\ub2e4.",
    "\uc9c0\uae08 Predictify\ub97c \uc5f4\uace0 AI \ucc44\ud305\uc5d0 '\uc624\ub298 \uacbd\uae30\uc5d0\uc11c \uac00\uc7a5 \uacfc\uc18c\ud3c9\uac00\ub41c \ud300\uc740?'\uc774\ub77c\uace0 \ubb3c\uc5b4\ubcf4\uc138\uc694. \uadf8\ub9ac\uace0 \uadf8 \ub2f5\uc744 \uc9c1\uc811 \uacbd\uae30 \uacb0\uacfc\uc640 \ube44\uad50\ud574\ubcf4\uc138\uc694. \uadf8\ub7ec\uba74 \uc81c\uac00 \uc65c \uc774 \uc774\uba54\uc77c\uc744 \ubcf4\ub0c8\ub294\uc9c0 \uc774\ud574\ud558\uc2e4 \uac70\uc608\uc694. P.S. \uc774 \uae30\ub2a5\uc740 \ud504\ub9ac\ubbf8\uc5c4 \uc0ac\uc6a9\uc790\uc5d0\uac8c \uc644\uc804\ud788 \uc5f4\ub824\uc788\uc2b5\ub2c8\ub2e4. 3\uc77c \ubb34\ub8cc \uccb4\ud5d8\uc73c\ub85c \uc9c0\uae08 \ubc14\ub85c \uc2dc\uc791\ud558\uc138\uc694. \ub2e8, \uc774 \uba54\uc2dc\uc9c0\ub97c \ubb34\uc2dc\ud558\uba74 \ud6c4\ud68c\ud560 \uc218\ub3c4 \uc788\uc5b4\uc694."
