  "subject": "30 \u0926\u093f\u0928 \u092e\u0947\u0902 9000 \u0928\u090f \u0932\u094b\u0917",
  "preview_text": "\u0924\u0941\u092e \u0905\u0915\u0947\u0932\u0947 \u0928\u0939\u0940\u0902 \u0939\u094b\u0964 \u0939\u0930 \u0930\u094b\u091c 300 \u0932\u094b\u0917 \u0907\u0938 \u092c\u0926\u0932\u093e\u0935 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092c\u0928 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 30 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 9000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u092c\u093e\u0938 \u092c\u0942\u0938\u094d\u091f\u0930 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u0914\u0930 \u0939\u093e\u0901, \u0935\u0947 \u0938\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0924\u0930\u0939 \u0939\u0940 \u0939\u0948\u0902 \u2014 \u0935\u0947 \u0932\u094b\u0917 \u091c\u094b \u0939\u093f\u092a-\u0939\u0949\u092a, EDM \u092f\u093e \u0930\u0949\u0915 \u0938\u0941\u0928\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0921\u094d\u0930\u0949\u092a \u0909\u0928\u0915\u0947 \u0938\u0940\u0928\u0947 \u092e\u0947\u0902 \u0917\u0942\u0902\u091c\u0947, \u0928 \u0915\u093f \u0938\u093f\u0930\u094d\u092b \u0915\u093e\u0928\u094b\u0902 \u092e\u0947\u0902\u0964 \u0924\u0941\u092e \u0905\u092c \u090f\u0915 \u0910\u0938\u0940 \u091f\u0940\u092e \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u094b \u091c\u094b \u092b\u094d\u0932\u0948\u091f, \u092c\u0947\u091c\u093e\u0928 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0928\u0915\u093e\u0930\u0924\u0940 \u0939\u0948\u0964",
    "\u092f\u0947 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0947 \u090f\u0915 \u0906\u0902\u0926\u094b\u0932\u0928 \u0939\u0948\u0964 \u0939\u0930 \u0926\u093f\u0928 300 \u0928\u090f \u0932\u094b\u0917 \u091c\u0941\u0921\u093c\u0924\u0947 \u0939\u0948\u0902 \u2014 \u0935\u0947 \u0938\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0924\u0930\u0939 \u0939\u0940 \u092c\u093e\u0938 \u0915\u094b \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902, \u091a\u093e\u0939\u0947 \u0935\u094b \u092b\u094b\u0928 \u0915\u0947 \u0938\u094d\u092a\u0940\u0915\u0930 \u092a\u0930 \u0939\u094b \u092f\u093e \u0908\u092f\u0930\u092c\u0921\u094d\u0938 \u092e\u0947\u0902\u0964 \u091c\u092c \u0924\u0941\u092e Bass Virtualizer \u091a\u093e\u0932\u0942 \u0915\u0930\u0924\u0947 \u0939\u094b \u0914\u0930 200% \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f \u0915\u0947 \u0938\u093e\u0925 \u0905\u092a\u0928\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u093e \u0938\u0941\u0928\u0924\u0947 \u0939\u094b, \u0924\u094b \u0924\u0941\u092e \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092f\u0942\u091c\u093c\u0930 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0907\u0938 \u092c\u0926\u0932\u093e\u0935 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092c\u0928\u0924\u0947 \u0939\u094b\u0964",
    "\u0939\u092e\u0928\u0947 Bass Virtualizer \u0914\u0930 3D Surround \u0915\u094b \u0907\u0938\u0940 \u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e \u0939\u0948 \u2014 \u0924\u093e\u0915\u093f \u0924\u0941\u092e \u0939\u0930 \u092c\u0940\u091f \u0915\u094b \u0905\u092a\u0928\u0947 \u0938\u0940\u0928\u0947 \u092e\u0947\u0902 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930 \u0938\u0915\u094b\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0938\u0947 Boost Slider \u0915\u094b \u0916\u0940\u0902\u091a\u094b \u0914\u0930 \u0926\u0947\u0916\u094b \u0915\u0948\u0938\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092b\u094b\u0928 \u090f\u0915 \u0938\u092c\u0935\u0942\u092b\u0930 \u092e\u0947\u0902 \u092c\u0926\u0932 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0924\u094b \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u092b\u0941\u0932 10-\u092c\u0948\u0902\u0921 EQ \u0915\u093e \u092e\u091c\u093c\u093e \u0932\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902 \u2014 \u0935\u0947 \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0905\u0938\u0932\u0940 \u0924\u093e\u0915\u0924 \u0915\u0939\u093e\u0901 \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 Bass Virtualizer \u0915\u094b \u0911\u0928 \u0915\u0930\u094b\u0964 \u092b\u093f\u0930 \u0905\u092a\u0928\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091f\u094d\u0930\u0948\u0915 \u0932\u0917\u093e\u0913 \u2014 \u0935\u094b \u0921\u094d\u0930\u0949\u092a \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0939\u093f\u0932\u093e \u0926\u0947\u0917\u093e\u0964 P.S. \u2014 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0905\u092c \u092d\u0940 \u0916\u0941\u0932\u093e \u0939\u0948\u0964 \u090f\u0915 \u092c\u093e\u0930 3D Surround \u0906\u091c\u093c\u092e\u093e\u0913, \u0924\u0941\u092e \u0915\u092d\u0940 \u092a\u0940\u091b\u0947 \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u094b\u0917\u0947\u0964"
