{
  "subject": "\u0627\u0634\u062a\u0628\u0627\u0647 \u06f9\u06f0\u066a \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u062f\u0631 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u0628\u0627\u0632\u06cc\u200c\u0647\u0627",
  "preview_text": "\u0628\u0628\u06cc\u0646 \u0686\u0637\u0648\u0631 \u06cc\u06a9 \u062a\u063a\u06cc\u06cc\u0631 \u06a9\u0648\u0686\u06a9 \u062f\u0631 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a\u062a \u0645\u06cc\u200c\u062a\u0648\u0646\u0647 \u0646\u062a\u0627\u06cc\u062c \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc\u200c\u0647\u0627\u062a \u0631\u0648 \u0645\u062a\u062d\u0648\u0644 \u06a9\u0646\u0647.",
  "body_paragraphs": [
    "\u0628\u06cc\u0634\u062a\u0631 \u06a9\u0627\u0631\u0628\u0631\u0627 \u0641\u06a9\u0631 \u0645\u06cc\u200c\u06a9\u0646\u0646 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u062f\u0631\u0633\u062a \u06cc\u0639\u0646\u06cc \u062f\u0646\u0628\u0627\u0644 \u06a9\u0631\u062f\u0646 \u062d\u0633 \u062f\u0631\u0648\u0646\u06cc\u0634\u0648\u0646. \u0648\u0644\u06cc \u062d\u0642\u06cc\u0642\u062a \u0627\u06cc\u0646\u0647 \u06a9\u0647 \u06f9\u06f0\u066a \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 Predictify \u0627\u0648\u0644\u06cc\u0646 \u0627\u0634\u062a\u0628\u0627\u0647 \u0631\u0648 \u062f\u0642\u06cc\u0642\u0627\u064b \u0647\u0645\u06cc\u0646\u062c\u0627 \u0645\u06cc\u200c\u06a9\u0646\u0646: \u0627\u0639\u062a\u0645\u0627\u062f \u0628\u0647 \u063a\u0631\u06cc\u0632\u0647 \u0628\u0647 \u062c\u0627\u06cc \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0648\u0627\u0642\u0639\u06cc. \u062a\u0627\u0632\u0647 \u0641\u0647\u0645\u06cc\u062f\u0645 \u06a9\u0647 \u0686\u0642\u062f\u0631 \u0631\u0627\u062d\u062a \u0645\u06cc\u200c\u0634\u0647 \u0628\u0627 \u06cc\u06a9 \u062a\u063a\u06cc\u06cc\u0631 \u06a9\u0648\u0686\u06cc\u06a9 \u0646\u062a\u0627\u06cc\u062c \u0631\u0648 \u0628\u0647\u062a\u0631 \u06a9\u0631\u062f.",
    "\u0627\u0634\u062a\u0628\u0627\u0647 \u0634\u0645\u0627\u0631\u0647 \u06cc\u06a9 \u0627\u06cc\u0646\u0647 \u06a9\u0647 \u067e\u06cc\u0634 \u0627\u0632 \u0628\u0627\u0632\u06cc \u0628\u0647 \u0633\u0631\u0627\u063a \u0646\u0638\u0631\u0633\u0646\u062c\u06cc\u200c\u0647\u0627\u06cc \u0627\u06cc\u0646\u0633\u062a\u0627\u06af\u0631\u0627\u0645 \u06cc\u0627 \u0646\u0638\u0631 \u062f\u0648\u0633\u062a\u0627\u062a \u0645\u06cc\u200c\u0631\u06cc\u060c \u062f\u0631 \u062d\u0627\u0644\u06cc \u06a9\u0647 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u0645\u0627 \u0647\u0632\u0627\u0631\u0627\u0646 \u0645\u062a\u063a\u06cc\u0631 \u0631\u0648 \u0628\u0631\u0627\u06cc \u0647\u0631 \u0645\u0633\u0627\u0628\u0642\u0647 \u062a\u062d\u0644\u06cc\u0644 \u0645\u06cc\u200c\u06a9\u0646\u0647. \u0645\u062b\u0644\u0627\u064b \u062a\u0648\u06cc \u0628\u0627\u0632\u06cc \u062f\u06cc\u0634\u0628 \u0645\u0646\u0686\u0633\u062a\u0631 \u0633\u06cc\u062a\u06cc \u0645\u0642\u0627\u0628\u0644 \u0622\u0631\u0633\u0646\u0627\u0644\u060c \u062e\u06cc\u0644\u06cc\u200c\u0647\u0627 \u0631\u0648\u06cc \u0628\u0631\u062f \u0633\u06cc\u062a\u06cc \u0634\u0631\u0637 \u0628\u0633\u062a\u0646\u060c \u0627\u0645\u0627 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc AI \u0646\u0634\u0648\u0646 \u0645\u06cc\u200c\u062f\u0627\u062f \u06a9\u0647 \u0622\u0631\u0633\u0646\u0627\u0644 \u062f\u0631 \u062e\u0637 \u062d\u0645\u0644\u0647 \u0628\u0647\u062a\u0631 \u0639\u0645\u0644 \u0645\u06cc\u200c\u06a9\u0646\u0647 \u0648 \u0646\u062a\u06cc\u062c\u0647 \u06f2-\u06f2 \u0634\u062f. \u0628\u0627 \u0627\u0639\u062a\u0645\u0627\u062f \u0628\u0647 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u060c \u0645\u06cc\u200c\u062a\u0648\u0646\u0633\u062a\u06cc \u0627\u0632 \u0627\u06cc\u0646 \u0627\u0634\u062a\u0628\u0627\u0647 \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u06a9\u0646\u06cc.",
    "\u0631\u0627\u0647 \u062d\u0644 \u0633\u0627\u062f\u0647\u200c\u0633\u062a: \u0642\u0628\u0644 \u0627\u0632 \u0647\u0631 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc\u060c \u0646\u06af\u0627\u0647\u06cc \u0628\u0647 \u0628\u062e\u0634 Confidence Score \u062f\u0631 \u0627\u067e \u0628\u0646\u062f\u0627\u0632. \u0627\u06cc\u0646 \u0627\u0645\u062a\u06cc\u0627\u0632 \u062f\u0642\u06cc\u0642\u0627\u064b \u0628\u0647\u062a \u0645\u06cc\u200c\u06af\u0647 \u06a9\u0647 AI \u0686\u0642\u062f\u0631 \u0627\u0632 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u062e\u0648\u062f\u0634 \u0645\u0637\u0645\u0626\u0646\u0647. \u0627\u06af\u0647 \u0627\u0645\u062a\u06cc\u0627\u0632 \u0628\u0627\u0644\u0627\u06cc \u06f7\u06f0\u066a \u0628\u0648\u062f\u060c \u0628\u0627 \u062e\u06cc\u0627\u0644 \u0631\u0627\u062d\u062a \u0645\u06cc\u200c\u062a\u0648\u0646\u06cc \u0631\u0648\u0634 \u062d\u0633\u0627\u0628 \u06a9\u0646\u06cc. \u0628\u0631\u0627\u06cc \u0628\u0627\u0632\u06cc\u200c\u0647\u0627\u06cc \u0628\u0627 \u0627\u0645\u062a\u06cc\u0627\u0632 \u067e\u0627\u06cc\u06cc\u0646\u200c\u062a\u0631\u060c \u0628\u0647\u062a\u0631\u0647 \u0627\u0632 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc\u200c\u0647\u0627\u06cc \u062f\u06cc\u06af\u0647 \u06a9\u0645\u06a9 \u0628\u06af\u06cc\u0631\u06cc.",
    "\u0627\u0644\u0627\u0646 \u0628\u0631\u0648 \u062a\u0648\u06cc \u0627\u067e\u060c \u06cc\u06a9 \u0645\u0633\u0627\u0628\u0642\u0647 \u0627\u0632 \u0644\u06cc\u06af \u0628\u0631\u062a\u0631 \u06cc\u0627 \u0644\u0627\u0644\u06cc\u06af\u0627 \u0631\u0648 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646 \u0648 \u0628\u0628\u06cc\u0646 Confidence Score \u0686\u0642\u062f\u0631\u0647. \u0628\u0639\u062f \u0628\u0627 \u062f\u0648\u0633\u062a\u0627\u062a \u062a\u0648\u06cc \u0628\u062e\u0634 \u062c\u0648\u0627\u0645\u0639 \u0628\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0628\u0630\u0627\u0631 \u0648 \u0646\u0638\u0631 \u0628\u062f\u0647. P.S: \u0647\u0646\u0648\u0632 \u0633\u0647 \u0631\u0648\u0632 \u0645\u0647\u0644\u062a \u062f\u0627\u0631\u06cc \u062a\u0627 \u067e\u0631\u06cc\u0645\u06cc\u0648\u0645 \u0631\u0648 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0627\u0645\u062a\u062d\u0627\u0646 \u06a9\u0646\u06cc \u0648 \u0628\u0647 \u0647\u0645\u0647 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc\u200c\u0647\u0627\u06cc \u0628\u0627 \u0627\u0645\u062a\u06cc\u0627\u0632 \u0628\u0627\u0644\u0627 \u062f\u0633\u062a\u0631\u0633\u06cc \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc."
  ],
