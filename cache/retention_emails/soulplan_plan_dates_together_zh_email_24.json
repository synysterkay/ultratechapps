{
  "subject": "\u6211\u4eec\u56e2\u961f\u90fd\u770b\u54ed\u4e86\u7684\u7528\u6237\u6545\u4e8b",
  "preview_text": "\u4e00\u4f4d\u7528\u6237\u5206\u4eab\u4e86\u4ed6\u548c\u4f34\u4fa3\u7684\u79d8\u5bc6\u3002\u770b\u5b8c\u540e\uff0c\u6211\u4eec\u6574\u4e2a\u56e2\u961f\u90fd\u6c89\u9ed8\u4e86\u3002\u8fd9\u4e5f\u8bb8\u662f\u4f60\u9700\u8981\u7684\u63d0\u9192\u3002",
  "body_paragraphs": [
    "\u4e0a\u5468\uff0c\u4e00\u4f4d\u7528\u6237\u53d1\u6765\u6d88\u606f\uff0c\u8bf4\u4ed6\u5dee\u70b9\u5378\u8f7dSoulPlan\u3002\u76f4\u5230\u6709\u4e00\u5929\uff0c\u4ed6\u5077\u5077\u7528\u6211\u4eec\u7684\u201c\u60ca\u559c\u7ea6\u4f1a\u201d\u529f\u80fd\uff0c\u4e3a\u59bb\u5b50\u7b56\u5212\u4e86\u4e00\u573a0\u5143\u7ea6\u4f1a\u2014\u2014\u53ea\u662f\u7528\u5bb6\u91cc\u7684\u65e7\u6bef\u5b50\u5728\u9633\u53f0\u4e0a\u770b\u661f\u661f\u3002\u4ed6\u544a\u8bc9\u6211\uff0c\u90a3\u665a\u4ed6\u4eec\u804a\u4e86\u4e09\u4e2a\u5c0f\u65f6\uff0c\u7834\u5929\u8352\u5730\u6ca1\u770b\u624b\u673a\u3002",
    "\u4ed6\u8bf4\uff0c\u534a\u5e74\u540e\u59bb\u5b50\u8fd8\u5728\u63d0\u90a3\u4e2a\u665a\u4e0a\u3002\u800c\u4ed6\u4eec\u4e4b\u524d\u53bb\u8fc7\u7684\u6602\u8d35\u9910\u5385\uff0c\u5979\u4e00\u4e2a\u90fd\u8bb0\u4e0d\u4f4f\u3002\u6211\u4eec\u7684\u56e2\u961f\u8bfb\u5230\u8fd9\u91cc\uff0c\u6240\u6709\u4eba\u90fd\u505c\u4e0b\u5de5\u4f5c\u3002\u8fd9\u4e0d\u662f\u7b2c\u4e00\u6b21\u4e86\u3002230\u591a\u5bf9\u592b\u5987\u7528SoulPlan\u91cd\u65b0\u627e\u5230\u4e86\u706b\u82b1\uff0c\u4f46\u8fd9\u4e2a\u6545\u4e8b\u7279\u522b\u51fb\u4e2d\u6211\u4eec\u2014\u2014\u56e0\u4e3a\u5b83\u8bc1\u660e\u4e86\uff0c\u6d6a\u6f2b\u4e0d\u5728\u4e8e\u82b1\u591a\u5c11\u94b1\uff0c\u800c\u5728\u4e8e\u4f60\u6709\u6ca1\u6709\u7528\u5fc3\u3002",
    "\u6211\u4eec\u8bbe\u8ba1\u4e86\u4e00\u4e2a\u9690\u85cf\u5f88\u6df1\u7684\u529f\u80fd\uff0c\u53eb\u201c\u5171\u4eab\u5fc3\u613f\u6e05\u5355\u201d\u3002\u4e0d\u662f\u8ba9\u4f60\u968f\u4fbf\u5199\u5199\uff0c\u800c\u662f\u8ba9\u4f60\u4eec\u628a\u5f7c\u6b64\u6700\u75af\u72c2\u7684\u7ea6\u4f1a\u68a6\u90fd\u653e\u8fdb\u53bb\u3002\u6bd4\u5982\u201c\u5047\u88c5\u7b2c\u4e00\u6b21\u89c1\u9762\u201d\u6216\u8005\u201c\u534a\u591c\u53bb\u5403\u8def\u8fb9\u644a\u201d\u3002\u7136\u540eSoulPlan\u4f1a\u5077\u5077\u5e2e\u4f60\u63d0\u793a\uff0c\u54ea\u5929\u5b9e\u73b0\u8fd9\u4e2a\u68a6\u6700\u5b8c\u7f8e\u3002",
    "\u73b0\u5728\u5c31\u6253\u5f00SoulPlan\uff0c\u53bb\u201c\u5171\u4eab\u5fc3\u613f\u6e05\u5355\u201d\u91cc\u5199\u4e00\u4e2a\u4f60\u4e00\u76f4\u60f3\u4f46\u6ca1\u6562\u8bf4\u7684\u7ea6\u4f1a\u70b9\u5b50\u3002\u54ea\u6015\u53ea\u662f\u201c\u4e00\u8d77\u770b\u65e5\u843d\u201d\u3002\u6211\u4fdd\u8bc1\uff0c\u4f60\u4f1a\u770b\u5230\u4e00\u4e2a\u4e0d\u4e00\u6837\u7684\u4ed6\u3002P.S. \u8bb0\u5f97\u6253\u5f00\u901a\u77e5\uff0c\u56e0\u4e3a\u7cfb\u7edf\u4f1a\u6084\u6084\u63d0\u9192\u4f60\uff1a\u4e0b\u5468\u4e09\u662f\u5b9e\u73b0\u5b83\u7684\u6700\u4f73\u65f6\u673a\u3002"
  ],
