{
  "subject": "\u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u0938\u0947 \u0906\u0935\u093e\u091c\u093c \u0916\u0930\u093e\u092c \u0939\u094b\u0924\u0940 \u0939\u0948 \u2014 \u091d\u0942\u0920 \u0939\u0948",
  "preview_text": "\u0939\u0930 \u0915\u094b\u0908 \u0915\u0939\u0924\u093e \u0939\u0948 \u0915\u093f \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0915\u093e \u092e\u0924\u0932\u092c \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0939\u0948\u0964 \u0939\u092e\u0928\u0947 100,000 \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u0938\u093e\u092c\u093f\u0924 \u0915\u093f\u092f\u093e \u0915\u093f \u092f\u0939 \u0938\u091a \u0928\u0939\u0940\u0902\u0964",
  "body_paragraphs": [
    "\u0924\u0941\u092e\u0928\u0947 \u0938\u0941\u0928\u093e \u0939\u094b\u0917\u093e: '\u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0913\u0917\u0947 \u0924\u094b \u0906\u0935\u093e\u091c\u093c \u092b\u091f \u091c\u093e\u090f\u0917\u0940\u0964' \u092f\u0939 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u092e\u093f\u0925\u0915 \u0939\u0948\u0964 \u092e\u0948\u0902 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092c\u0924\u093e\u0924\u093e \u0939\u0942\u0901 \u0915\u094d\u092f\u094b\u0902 \u2014 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0924\u0941\u092e \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e 100% \u092a\u0930 \u0932\u0917\u093e\u0924\u0947 \u0939\u094b, \u0924\u094b \u0910\u092a\u094d\u0938 \u0914\u0930 \u092b\u094b\u0928 \u092e\u093f\u0932\u0915\u0930 \u0915\u094d\u0932\u093f\u092a\u093f\u0902\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0915\u093e \u0905\u0938\u0932\u0940 \u0915\u093e\u0930\u0923 \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 Loudify \u0915\u093e +200% \u092c\u0942\u0938\u094d\u091f \u0905\u0932\u0917 \u0939\u0948\u0964 \u092f\u0939 \u0938\u0949\u092b\u094d\u091f\u0935\u0947\u092f\u0930 \u0932\u0947\u0935\u0932 \u092a\u0930 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948 \u2014 \u0939\u093e\u0930\u094d\u0921\u0935\u0947\u092f\u0930 \u0915\u094b \u0928\u0939\u0940\u0902 \u091b\u0947\u0921\u093c\u0924\u093e\u0964 \u0928\u0924\u0940\u091c\u093e? \u0938\u093e\u092b, \u0936\u0915\u094d\u0924\u093f\u0936\u093e\u0932\u0940 \u0906\u0935\u093e\u091c\u093c, \u092c\u093f\u0928\u093e \u090f\u0915 \u092d\u0940 \u0915\u094d\u0930\u0948\u0915\u0932 \u0915\u0947\u0964",
    "\u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0928\u0947 \u0939\u091c\u093e\u0930\u094b\u0902 \u0939\u0947\u0921\u092b\u094b\u0928 \u092e\u0949\u0921\u0932\u094d\u0938 \u0915\u094b \u091f\u0947\u0938\u094d\u091f \u0915\u093f\u092f\u093e \u0939\u0948\u0964 AutoEQ \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938 \u0939\u0930 \u092e\u0949\u0921\u0932 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917-\u0905\u0932\u0917 \u092b\u094d\u0930\u0940\u0915\u094d\u0935\u0947\u0902\u0938\u0940 \u0930\u093f\u0938\u094d\u092a\u0949\u0928\u094d\u0938 \u0915\u094b \u0920\u0940\u0915 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u091c\u092c \u0924\u0941\u092e \u092e\u094d\u092f\u0942\u091c\u093c\u093f\u0915 \u092e\u094b\u0921 \u092e\u0947\u0902 \u091c\u093e\u0924\u0947 \u0939\u094b, \u0924\u094b \u092c\u093e\u0938 \u0914\u0930 \u0935\u094b\u0915\u0932\u094d\u0938 \u092c\u0948\u0932\u0947\u0902\u0938 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u092e\u094b\u0921 \u092e\u0947\u0902 \u0921\u093e\u092f\u0932\u0949\u0917 \u0915\u094d\u0930\u093f\u0938\u094d\u092a \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0917\u0947\u092e\u093f\u0902\u0917 \u092e\u094b\u0921 \u092e\u0947\u0902 \u092b\u0941\u091f\u0938\u094d\u091f\u0947\u092a\u094d\u0938 \u0938\u093e\u092b \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0915\u094b\u0908 \u092e\u0948\u091c\u093f\u0915 \u0928\u0939\u0940\u0902 \u2014 \u092f\u0939 \u0921\u0947\u091f\u093e \u0939\u0948\u0964",
    "\u0939\u0930 \u0939\u092b\u094d\u0924\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 Sound DNA \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092c\u0924\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u0924\u0941\u092e\u0928\u0947 \u0915\u0948\u0938\u0947 \u0938\u0941\u0928\u093e\u0964 \u092f\u0939 \u090f\u0915 \u092a\u0930\u094d\u0938\u0928\u0932 \u0911\u0921\u093f\u092f\u094b \u0921\u093e\u092f\u0930\u0940 \u0939\u0948\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948 \u2014 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u094b \u0915\u093f \u092a\u093f\u091b\u0932\u0947 \u092e\u0939\u0940\u0928\u0947 \u0915\u093f\u0938 \u092e\u094b\u0921 \u092e\u0947\u0902 \u0938\u092c\u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0938\u092e\u092f \u092c\u093f\u0924\u093e\u092f\u093e\u0964 \u0915\u0932 \u0936\u093e\u092e 2AM \u092a\u0930 \u092e\u0948\u0902\u0928\u0947 \u0916\u0941\u0926 \u0917\u0947\u092e\u093f\u0902\u0917 \u092e\u094b\u0921 \u092e\u0947\u0902 +200% \u092c\u0942\u0938\u094d\u091f \u0915\u0947 \u0938\u093e\u0925 Valorant \u0916\u0947\u0932\u093e \u2014 \u090f\u0915 \u092d\u0940 \u0915\u094d\u0930\u0948\u0915\u0932 \u0928\u0939\u0940\u0902, \u0938\u093f\u0930\u094d\u092b \u0915\u094d\u0932\u0940\u0928 \u0939\u0947\u0921\u0936\u0949\u091f\u094d\u0938\u0964",
    "\u0906\u091c \u0930\u093e\u0924, \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u094b \u0914\u0930 Loudify \u0916\u094b\u0932\u094b\u0964 \u092e\u094d\u092f\u0942\u091c\u093c\u093f\u0915 \u092e\u094b\u0921 \u092e\u0947\u0902 \u091c\u093e\u0913, \u092b\u093f\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0915\u094b +150% \u092a\u0930 \u0932\u0947 \u091c\u093e\u0913\u0964 \u0938\u0941\u0928\u094b \u2014 \u0915\u094b\u0908 \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0928\u0939\u0940\u0902\u0964 \u092f\u0939 \u092e\u093f\u0925\u0915 \u0905\u092c \u0916\u0924\u094d\u092e\u0964 P.S. \u0905\u0917\u0930 \u0924\u0941\u092e \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0936\u0941\u0930\u0942 \u0915\u0930\u094b\u0917\u0947, \u0924\u094b AutoEQ \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0939\u0947\u0921\u092b\u094b\u0928 \u0915\u094b \u092a\u0939\u091a\u093e\u0928 \u0932\u0947\u0917\u093e \u2014 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u0947\u0964"
  ],
