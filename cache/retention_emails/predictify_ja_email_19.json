{
  "subject": "\u6765\u6708\u306e\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3067\u5168\u3066\u304c\u5909\u308f\u308b\u3002\u4eca\u3060\u3051\u306e\u5185\u7dd2\u8a71",
  "preview_text": "\u958b\u767a\u30c1\u30fc\u30e0\u304b\u3089\u30ea\u30fc\u30af\u60c5\u5831\u3002\u6b21\u306e\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3067\u4e88\u6e2c\u6a5f\u80fd\u304c\u6839\u672c\u304b\u3089\u9032\u5316\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u8ab0\u306b\u3082\u8a00\u308f\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002",
  "body_paragraphs": [
    "\u5b9f\u306f\u4eca\u3001\u958b\u767a\u30c1\u30fc\u30e0\u5185\u3067\u3061\u3087\u3063\u3068\u3057\u305f\u9a12\u304e\u306b\u306a\u3063\u3066\u3044\u308b\u3093\u3060\u3002\u6765\u6708\u306e\u30e1\u30b8\u30e3\u30fc\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u306e\u5185\u5bb9\u3092\u3001\u4e00\u90e8\u306e\u30e6\u30fc\u30b6\u30fc\u306b\u3060\u3051\u5148\u306b\u8a71\u3059\u3053\u3068\u306b\u306a\u3063\u305f\u304b\u3089\u3055\u3002\u3082\u3061\u308d\u3093\u3001\u541b\u306f\u305d\u306e\u9078\u3070\u308c\u305f\u4e00\u4eba\u3060\u3002",
    "\u4eca\u307e\u3067\u306eAI\u4e88\u6e2c\u306f\u3001\u904e\u53bb\u306e\u30c7\u30fc\u30bf\u5206\u6790\u304c\u4e2d\u5fc3\u3060\u3063\u305f\u3002\u3067\u3082\u6b21\u306f\u9055\u3046\u3002\u8a66\u5408\u4e2d\u306e\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u5909\u52d5\u3092\u5b66\u7fd2\u3057\u3001\u4e88\u6e2c\u3092\u305d\u306e\u5834\u3067\u66f4\u65b0\u3059\u308b\u300e\u30e9\u30a4\u30d6\u9069\u5fdc\u30a8\u30f3\u30b8\u30f3\u300f\u3092\u642d\u8f09\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u524d\u534a\u3067\u4e3b\u529b\u9078\u624b\u304c\u8ca0\u50b7\u9000\u5834\u3057\u305f\u77ac\u9593\u3001AI\u304c\u5373\u5ea7\u306b\u52dd\u7387\u8a08\u7b97\u3092\u66f8\u304d\u63db\u3048\u308b\u3093\u3060\u3002",
    "\u3053\u308c\u304c\u610f\u5473\u3059\u308b\u306e\u306f\u3001\u4eca\u307e\u3067\u4ee5\u4e0a\u306b\u7cbe\u5ea6\u306e\u9ad8\u3044\u300e\u751f\u304d\u3066\u3044\u308b\u4e88\u6e2c\u300f\u304c\u624b\u306b\u5165\u308b\u3053\u3068\u3060\u3002\u7279\u306b\u30d7\u30ec\u30df\u30a2\u30e0\u30e6\u30fc\u30b6\u30fc\u306f\u3001\u3053\u306e\u65b0\u30a8\u30f3\u30b8\u30f3\u306b\u3088\u308b\u7279\u5225\u306a\u300e\u30e9\u30a4\u30d6\u30a4\u30f3\u30b5\u30a4\u30c8\u300f\u30d1\u30cd\u30eb\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u3002\u8a66\u5408\u306e\u6d41\u308c\u304c\u5909\u308f\u308b\u305f\u3073\u306b\u3001AI\u304c\u6b21\u306e\u5c55\u958b\u3092\u5148\u8aad\u307f\u3057\u3066\u6559\u3048\u3066\u304f\u308c\u308b\u3002",
    "\u30a2\u30d7\u30ea\u3092\u958b\u3044\u3066\u3001\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u306e\u300e\u958b\u767a\u8005\u30c0\u30a4\u30a2\u30ed\u30b0\u300f\u3092\u30c1\u30a7\u30c3\u30af\u3057\u3066\u307b\u3057\u3044\u3002\u305d\u3053\u3067\u3060\u3051\u3001\u3053\u306e\u65b0\u6a5f\u80fd\u306e\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\u3092\u516c\u958b\u3057\u3066\u3044\u308b\u3002\u898b\u305f\u3089\u5206\u304b\u308b\u3051\u3069\u3001\u3053\u308c\u306f\u672c\u5f53\u306b\u5168\u3066\u3092\u5909\u3048\u308b\u3002P.S. \u3053\u306e\u60c5\u5831\u306f\u6b63\u5f0f\u30ea\u30ea\u30fc\u30b9\u307e\u3067\u6975\u79d8\u6271\u3044\u3060\u3002\u4ed6\u306e\u30e6\u30fc\u30b6\u30fc\u306b\u306f\u81ea\u6162\u3057\u306a\u3044\u3067\u304f\u308c\u3002",
