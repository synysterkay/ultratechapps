  "subject": "\u3042\u306a\u305f\u3060\u3051\u306b\u6559\u3048\u308b\u65b0\u6a5f\u80fd",
  "preview_text": "\u307e\u3060\u8ab0\u3082\u77e5\u3089\u306a\u3044\u3001\u6b21\u306e\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3067\u8ffd\u52a0\u3055\u308c\u308b\u79d8\u5bc6\u306e\u6a5f\u80fd\u3092\u3042\u306a\u305f\u3060\u3051\u306b\u5148\u51fa\u3057\u3002\u30d5\u30a1\u30f3\u3068\u3057\u3066\u306e\u77e5\u8b58\u304c\u8a66\u3055\u308c\u308b\u6642\u3002",
  "body_paragraphs": [
    "\u5148\u9031\u306e\u706b\u66dc\u65e5\u3001\u5348\u524d3\u6642\u306b\u958b\u767a\u30c1\u30fc\u30e0\u304c\u3053\u3063\u305d\u308a\u30c6\u30b9\u30c8\u3057\u3066\u3044\u305f\u3082\u306e\u3092\u898b\u3064\u3051\u3066\u3057\u307e\u3063\u305f\u3002\u307e\u3060\u30a2\u30d7\u30ea\u306b\u306f\u53cd\u6620\u3055\u308c\u3066\u3044\u306a\u3044\u3001\u3068\u3042\u308b\u6a5f\u80fd\u3060\u3002\u305d\u306e\u6a5f\u80fd\u3092\u4f7f\u3048\u3070\u3001\u8a66\u5408\u524d\u306e\u30c7\u30fc\u30bf\u3060\u3051\u3067\u306f\u7d76\u5bfe\u306b\u6c17\u3065\u3051\u306a\u3044\u3001\u9078\u624b\u306e\u96a0\u308c\u305f\u30d1\u30bf\u30fc\u30f3\u304c\u624b\u306b\u53d6\u308b\u3088\u3046\u306b\u5206\u304b\u308b\u3088\u3046\u306b\u306a\u308b\u3002",
    "\u50d5\u305f\u3061\u306f\u3044\u3064\u3082\u30c7\u30fc\u30bf\u3067\u76f4\u611f\u3092\u88cf\u4ed8\u3051\u308b\u3053\u3068\u3092\u5927\u4e8b\u306b\u3057\u3066\u304d\u305f\u3002\u3067\u3082\u3001\u3053\u306e\u65b0\u6a5f\u80fd\u306f\u9055\u3046\u3002AI\u304c\u8a66\u5408\u4e2d\u306e\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u30c7\u30fc\u30bf\u3092\u89e3\u6790\u3057\u3001\u3042\u306a\u305f\u306e\u4e88\u60f3\u304c\u3069\u308c\u3060\u3051\u6b63\u78ba\u304b\u3001\u305d\u306e\u5834\u3067\u30c1\u30e3\u30ec\u30f3\u30b8\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308b\u3093\u3060\u3002\u307e\u308b\u3067\u3001\u30b9\u30bf\u30b8\u30a2\u30e0\u306e\u89b3\u5ba2\u306e\u4e2d\u3067\u552f\u4e00\u3001\u6b21\u306e\u30d7\u30ec\u30fc\u3092\u898b\u629c\u3051\u308b\u4eba\u9593\u306b\u306a\u308b\u611f\u899a\u3060\u3002",
    "\u3053\u308c\u307e\u3067\u306b\u4f55\u5343\u3082\u306e\u8a66\u5408\u3092\u5206\u6790\u3057\u3066\u304d\u305fAI\u304c\u3001\u6b21\u306f\u3042\u306a\u305f\u306e\u30d5\u30a1\u30f3\u3068\u3057\u3066\u306e\u77e5\u8b58\u3092\u76f4\u63a5\u8a66\u3059\u3002\u5177\u4f53\u7684\u306b\u306f\u3001\u8a66\u5408\u4e2d\u306e\u7279\u5b9a\u306e\u5834\u9762\u3067\u300c\u6b21\u306e\u30b7\u30e5\u30fc\u30c8\u306f\u30b4\u30fc\u30eb\u306b\u306a\u308b\u78ba\u7387\u306f\uff1f\u300d\u3068\u3044\u3063\u305f\u30af\u30a4\u30ba\u304c\u98db\u3093\u3067\u304f\u308b\u3002IQ Quiz\u306e\u9032\u5316\u7248\u3060\u3068\u601d\u3063\u3066\u304f\u308c\u3002\u6b63\u89e3\u3059\u308c\u3070\u30ec\u30a2\u306a\u30d0\u30c3\u30b8\u3092\u7372\u5f97\u3067\u304d\u3001\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3067\u81ea\u6162\u3067\u304d\u308b\u3002\u3053\u306e\u6a5f\u80fd\u306f\u307e\u3060\u30d9\u30fc\u30bf\u7248\u3067\u3001\u4eca\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u306e\u306f\u3054\u304f\u4e00\u90e8\u306e\u30e6\u30fc\u30b6\u30fc\u3060\u3051\u3002",
    "\u4eca\u3059\u3050\u30a2\u30d7\u30ea\u3092\u958b\u3044\u3066\u3001\u8a2d\u5b9a\u753b\u9762\u306b\u3042\u308b\u300c\u65e9\u671f\u30a2\u30af\u30bb\u30b9\u300d\u3092\u30bf\u30c3\u30d7\u3057\u3066\u307b\u3057\u3044\u3002\u305d\u3053\u3067\u3053\u306e\u6a5f\u80fd\u3092\u8a66\u3059\u3053\u3068\u304c\u3067\u304d\u3001\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u3092\u9001\u308c\u3070\u3001\u6b63\u5f0f\u30ea\u30ea\u30fc\u30b9\u6642\u306b\u3042\u306a\u305f\u306e\u540d\u524d\u304c\u30af\u30ec\u30b8\u30c3\u30c8\u306b\u8f09\u308b\u304b\u3082\u3057\u308c\u306a\u3044\u3002P.S. \u3053\u306e\u30e1\u30fc\u30eb\u3092\u898b\u305f\u306e\u306f\u3042\u306a\u305f\u3060\u3051\u3002\u4ed6\u306e\u30e6\u30fc\u30b6\u30fc\u306b\u306f\u307e\u3060\u901a\u77e5\u3057\u3066\u3044\u306a\u3044\u3002\u3053\u3053\u3060\u3051\u306e\u8a71\u3001\u3053\u306e\u6a5f\u80fd\u3092\u8a66\u3057\u305f\u4eba\u306e\u3046\u3061\u300167%\u304c\u4e88\u60f3\u7cbe\u5ea6\u309210%\u4ee5\u4e0a\u5411\u4e0a\u3055\u305b\u3066\u3044\u308b\u3068\u3044\u3046\u30c7\u30fc\u30bf\u3082\u3042\u308b\u3002"
