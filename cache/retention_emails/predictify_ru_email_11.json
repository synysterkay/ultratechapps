{
  "subject": "\u041c\u0438\u0444 \u043e 70% \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u044f \u043c\u044f\u0447\u043e\u043c, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u0435\u0440\u044f\u0442 \u0432\u0441\u0435",
  "preview_text": "\u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u0444\u0430\u043d\u0430\u0442\u043e\u0432 \u0434\u0443\u043c\u0430\u044e\u0442, \u0447\u0442\u043e \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u0435 = \u043f\u043e\u0431\u0435\u0434\u0430. \u0414\u0430\u043d\u043d\u044b\u0435 Predictify \u0433\u043e\u0432\u043e\u0440\u044f\u0442 \u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0435. \u041f\u0440\u043e\u0432\u0435\u0440\u044c \u0441\u0430\u043c.",
  "body_paragraphs": [
    "\u0422\u044b \u043d\u0430\u0432\u0435\u0440\u043d\u044f\u043a\u0430 \u0441\u043b\u044b\u0448\u0430\u043b \u044d\u0442\u043e \u0441\u043e\u0442\u043d\u0438 \u0440\u0430\u0437: '\u041a\u043e\u043c\u0430\u043d\u0434\u0430 X \u0434\u043e\u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043b\u0430 \u2014 \u0443 \u043d\u0438\u0445 \u0431\u044b\u043b\u043e 70% \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u044f, \u043e\u043d\u0438 \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u043b\u0438 \u043f\u043e\u0431\u0435\u0434\u0443'. \u0417\u0432\u0443\u0447\u0438\u0442 \u043b\u043e\u0433\u0438\u0447\u043d\u043e, \u043f\u0440\u0430\u0432\u0434\u0430? \u0422\u043e\u043b\u044c\u043a\u043e \u0432\u043e\u0442 \u0434\u0430\u043d\u043d\u044b\u0435 \u0433\u043e\u0432\u043e\u0440\u044f\u0442 \u043e\u0431\u0440\u0430\u0442\u043d\u043e\u0435. \u041c\u044b \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b\u0438 500+ \u043c\u0430\u0442\u0447\u0435\u0439 \u0410\u041f\u041b \u0438 \u041b\u0430 \u041b\u0438\u0433\u0438 \u0437\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0441\u0435\u0437\u043e\u043d, \u0438 \u0437\u043d\u0430\u0435\u0448\u044c \u0447\u0442\u043e? \u0412 \u043c\u0430\u0442\u0447\u0430\u0445, \u0433\u0434\u0435 \u043e\u0434\u043d\u0430 \u043a\u043e\u043c\u0430\u043d\u0434\u0430 \u0432\u043b\u0430\u0434\u0435\u043b\u0430 \u043c\u044f\u0447\u043e\u043c 65%+ \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u043e\u043d\u0430 \u0432\u044b\u0438\u0433\u0440\u044b\u0432\u0430\u043b\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 38% \u0441\u043b\u0443\u0447\u0430\u0435\u0432. \u041e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u2014 \u043d\u0438\u0447\u044c\u0438 \u0438\u043b\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f.",
    "\u041f\u043e\u0447\u0435\u043c\u0443 \u0442\u0430\u043a? \u0412\u043b\u0430\u0434\u0435\u043d\u0438\u0435 \u0431\u0435\u0437 \u0443\u0434\u0430\u0440\u043e\u0432 \u043f\u043e \u0432\u043e\u0440\u043e\u0442\u0430\u043c \u2014 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0435\u0440\u0435\u043a\u0430\u0442 \u043c\u044f\u0447\u0430. \u0420\u0435\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u0432\u0440\u043e\u0434\u0435 xG (\u043e\u0436\u0438\u0434\u0430\u0435\u043c\u044b\u0435 \u0433\u043e\u043b\u044b), \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0443\u0434\u0430\u0440\u043e\u0432 \u0432 \u0441\u0442\u0432\u043e\u0440 \u0438 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0435\u0441\u0441\u0438\u043d\u0433\u0430 \u0434\u0430\u044e\u0442 \u0432 \u0440\u0430\u0437\u044b \u0431\u043e\u043b\u044c\u0448\u0435 \u043f\u043e\u043b\u044c\u0437\u044b. \u041c\u044b \u0432 Predictify \u044d\u0442\u043e \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u043c: \u043d\u0430\u0448\u0430 \u043c\u043e\u0434\u0435\u043b\u044c \u0441\u043c\u043e\u0442\u0440\u0438\u0442 \u043d\u0430 50+ \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445, \u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u044b. \u0418 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u2014 \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u044b \u0441 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e \u0432\u044b\u0448\u0435 82% \u0432 \u0442\u043e\u043f-5 \u043b\u0438\u0433\u0430\u0445.",
    "\u0425\u043e\u0447\u0435\u0448\u044c \u0441\u0430\u043c \u0443\u0431\u0435\u0434\u0438\u0442\u044c\u0441\u044f? \u041e\u0442\u043a\u0440\u043e\u0439 \u043b\u044e\u0431\u043e\u0439 \u043c\u0430\u0442\u0447 \u0432 Predictify \u2014 \u0432\u0438\u0434\u0438\u0448\u044c \u043a\u043e\u043b\u043e\u043d\u043a\u0443 '\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u043a\u0430'? \u0422\u0430\u043c \u0440\u0430\u0437\u0431\u043e\u0440 \u043f\u043e xG, \u0443\u0434\u0430\u0440\u0430\u043c, \u043e\u0431\u043e\u0440\u043e\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0441\u0438\u043b\u0435. \u0421\u0440\u0430\u0432\u043d\u0438 \u044d\u0442\u043e \u0441 '\u0433\u043e\u043b\u044b\u043c' \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u0435\u043c \u2014 \u0440\u0430\u0437\u043d\u0438\u0446\u0430 \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u0430. \u0410 \u0435\u0449\u0435 \u043c\u043e\u0436\u0435\u0448\u044c \u0441\u043f\u0440\u043e\u0441\u0438\u0442\u044c AI-\u0447\u0430\u0442: '\u041f\u043e\u0447\u0435\u043c\u0443 \u0411\u0430\u0440\u0441\u0435\u043b\u043e\u043d\u0430 \u043f\u0440\u043e\u0438\u0433\u0440\u0430\u043b\u0430 \u043f\u0440\u0438 70% \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u044f?' \u2014 \u043e\u043d \u0432\u044b\u0434\u0430\u0441\u0442 \u0442\u0435\u0431\u0435 \u0440\u0430\u0441\u043a\u043b\u0430\u0434 \u0437\u0430 \u0441\u0435\u043a\u0443\u043d\u0434\u0443.",
    "\u0425\u0432\u0430\u0442\u0438\u0442 \u0432\u0435\u0440\u0438\u0442\u044c \u043c\u0438\u0444\u0430\u043c. \u0417\u0430\u0439\u0434\u0438 \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441, \u0432\u044b\u0431\u0435\u0440\u0438 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0438\u0439 \u043c\u0430\u0442\u0447 \u0438 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438. P.S. \u041a\u0441\u0442\u0430\u0442\u0438, \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u041f\u0440\u0435\u043c\u0438\u0443\u043c \u0432\u0438\u0434\u044f\u0442 \u0435\u0449\u0435 \u0438 \u0441\u043a\u0440\u044b\u0442\u044b\u0435 \u043f\u0430\u0442\u0442\u0435\u0440\u043d\u044b \u2014 \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0447\u0442\u043e \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u0441 \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u0435\u043c 55-60% \u0432\u044b\u0438\u0433\u0440\u044b\u0432\u0430\u044e\u0442 \u0447\u0430\u0449\u0435, \u0447\u0435\u043c \u0442\u0435, \u043a\u0442\u043e '\u0432\u043b\u0430\u0434\u0435\u0435\u0442' 70%+. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 3 \u0434\u043d\u044f \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e \u2014 \u0441\u0430\u043c \u0432\u0441\u0435 \u0443\u0432\u0438\u0434\u0438\u0448\u044c."
  ],
