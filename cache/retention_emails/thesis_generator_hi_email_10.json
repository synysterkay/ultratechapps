{
  "subject": "\u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u092b\u0940\u091a\u0930 3 \u092e\u0939\u0940\u0928\u0947 \u092c\u093e\u0926 \u0916\u094b\u091c\u093e, \u0924\u0941\u092e \u0905\u092d\u0940 \u0915\u0930\u094b",
  "preview_text": "\u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a 1% \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0940 \u0935\u0930\u094d\u0915\u092b\u094d\u0932\u094b \u0915\u0940 \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u091f\u094d\u0930\u093f\u0915, \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0938\u092e\u092f \u092c\u091a\u093e\u090f\u0917\u0940 \u0914\u0930 \u0917\u094d\u0930\u0947\u0921 \u0938\u0941\u0927\u093e\u0930\u0947\u0917\u0940\u0964",
  "body_paragraphs": [
    "\u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u0939\u0948, \u092e\u0948\u0902\u0928\u0947 Thesis Generator \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0924\u094b \u0938\u094b\u091a\u093e \u092c\u0938 \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u092c\u0928\u093e\u0928\u0947 \u0915\u093e \u091f\u0942\u0932 \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a 1% \u092f\u0942\u091c\u0930\u094d\u0938 \u0907\u0938\u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0948\u0938\u0947 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u2014\u0914\u0930 \u092e\u0947\u0930\u093e \u092e\u0928 \u0915\u0930 \u0917\u092f\u093e\u0964 \u0935\u0947 \u0932\u094b\u0917 \u090f\u0915 \u0916\u093e\u0938 \u0935\u0930\u094d\u0915\u092b\u094d\u0932\u094b \u092b\u0949\u0932\u094b \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092d\u0940 \u092c\u0926\u0932 \u0938\u0915\u0924\u093e \u0939\u0948\u0964",
    "\u0935\u0947 \u0938\u0940\u0927\u0947 \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u092a\u0942\u0930\u0947 \u092a\u0947\u092a\u0930 \u0915\u093e \u0906\u0909\u091f\u0932\u093e\u0907\u0928 \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f 'Outline to Full Paper' \u092b\u0940\u091a\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938\u0938\u0947 \u0935\u0947 \u0918\u0902\u091f\u094b\u0902 \u0915\u0940 \u092e\u0947\u0939\u0928\u0924 \u0915\u094b \u092e\u093f\u0928\u091f\u094b\u0902 \u092e\u0947\u0902 \u092c\u0926\u0932 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u092b\u093f\u0930, \u0935\u0947 'Humanize AI Text' \u0915\u094b \u0911\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u093e\u0915\u093f \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u091f\u0930\u094d\u0928\u093f\u091f\u093f\u0928 \u0914\u0930 GPTZero \u092e\u0947\u0902 \u092a\u0915\u0921\u093c\u093e \u0928 \u091c\u093e\u090f\u0964 \u092f\u0939\u0940 \u0935\u091c\u0939 \u0939\u0948 \u0915\u093f \u0909\u0928\u0915\u0947 \u0917\u094d\u0930\u0947\u0921 B+ \u0938\u0947 A- \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u092f\u0939 \u092b\u0940\u091a\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0910\u092a \u092e\u0947\u0902 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0948\u2014\u092c\u0938 'Outline to Full Paper' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u094b \u0914\u0930 \u0905\u092a\u0928\u093e \u0906\u0907\u0921\u093f\u092f\u093e \u0921\u093e\u0932\u094b\u0964 \u092b\u093f\u0930 'Humanize' \u092c\u091f\u0928 \u0926\u092c\u093e\u0913\u0964 \u092f\u0939 \u0935\u0939 \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0939\u0948 \u091c\u094b 90% \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u094b \u0928\u0939\u0940\u0902 \u092a\u0924\u093e\u0964",
    "\u0905\u092c \u0938\u0947\u0915\u0902\u0921 \u092c\u0930\u094d\u092c\u093e\u0926 \u092e\u0924 \u0915\u0930\u094b\u0964 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0907\u0938 \u0935\u0930\u094d\u0915\u092b\u094d\u0932\u094b \u0915\u094b \u0906\u091c\u092e\u093e\u0913\u0964 P.S. \u0905\u0917\u0930 \u0924\u0941\u092e\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 'Auto-Citations' \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e, \u0924\u094b \u0935\u0939 \u092d\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e APA/MLA \u092b\u0949\u0930\u094d\u092e\u0947\u091f\u093f\u0902\u0917 \u0915\u093e \u0938\u093f\u0930\u0926\u0930\u094d\u0926 \u0916\u0924\u094d\u092e \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964"
