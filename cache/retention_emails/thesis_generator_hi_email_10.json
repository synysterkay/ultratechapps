{
  "subject": "\u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0915\u0940 \u0935\u094b \u0917\u0932\u0924\u0940 \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a 1% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0940 \u0935\u0930\u094d\u0915\u092b\u093c\u094d\u0932\u094b \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u091c\u093e\u0928\u093f\u090f \u2014 \u091c\u094b \u0906\u092a\u0915\u094b \u090f-\u0917\u094d\u0930\u0947\u0921 \u0926\u093f\u0932\u093e\u090f\u0917\u093e\u0964",
  "body_paragraphs": [
    "\u090f\u0915 \u092c\u093e\u0930 \u092e\u0948\u0902 \u092d\u0940 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0916\u093e\u0932\u0940 \u092a\u0928\u094d\u0928\u0947 \u0915\u094b \u0918\u0942\u0930 \u0930\u0939\u093e \u0925\u093e, \u0938\u094b\u091a \u0930\u0939\u093e \u0925\u093e \u0915\u093f \u092f\u0947 \u0925\u0940\u0938\u093f\u0938 \u0915\u092d\u0940 \u0916\u0924\u094d\u092e \u0939\u094b\u0917\u0940 \u092d\u0940 \u092f\u093e \u0928\u0939\u0940\u0902\u0964 \u0924\u092c \u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a 1% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0941\u091b \u0905\u0932\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u2014 \u0935\u094b \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u093e \u0935\u0930\u094d\u0915\u092b\u093c\u094d\u0932\u094b \u0938\u0947\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u092b\u093f\u0930 \u0932\u093f\u0916\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0935\u094b \u0938\u0940\u0927\u0947 \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u092a\u0930 \u0928\u0939\u0940\u0902 \u091c\u093e\u0924\u0947\u0964 \u092a\u0939\u0932\u0947 \u0935\u094b \u0905\u092a\u0928\u0947 \u0938\u092c\u0938\u0947 \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0938\u0935\u093e\u0932 \u0915\u094b \u0922\u0942\u0902\u0922\u0924\u0947 \u0939\u0948\u0902, \u092b\u093f\u0930 \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930 \u0915\u094b \u0909\u0938\u0940 \u092a\u0930 \u092b\u094b\u0915\u0938 \u0915\u0930\u0928\u0947 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0928\u0924\u0940\u091c\u093e? 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u090f\u0915 \u092e\u091c\u092c\u0942\u0924 \u0925\u0940\u0938\u093f\u0938, \u091c\u094b 8 \u0918\u0902\u091f\u0947 \u0915\u0940 \u092e\u0947\u0939\u0928\u0924 \u0938\u0947 \u092d\u0940 \u092c\u0947\u0939\u0924\u0930 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939\u0940 \u0935\u094b \u0907\u0928\u0938\u093e\u0907\u0921\u0930 \u0928\u0949\u0932\u0947\u091c \u0939\u0948 \u091c\u094b \u0909\u0928\u094d\u0939\u0947\u0902 \u0906\u092a\u0938\u0947 \u0906\u0917\u0947 \u0930\u0916\u0924\u0940 \u0939\u0948\u0964",
    "\u0906\u092a\u0915\u093e \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930 \u0910\u092a \u0907\u0938\u0940 \u0915\u0947 \u0932\u093f\u090f \u092c\u0928\u093e \u0939\u0948 \u2014 \u0905\u092a\u0928\u0947 \u091f\u0949\u092a\u093f\u0915 \u0915\u094b \u0921\u093e\u0932\u0947\u0902, '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c' \u092b\u0940\u091a\u0930 \u0911\u0928 \u0915\u0930\u0947\u0902, \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0915\u0948\u0938\u0947 AI \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0915\u094b \u091f\u0930\u094d\u0928\u093f\u091f\u093f\u0928-\u092a\u094d\u0930\u0942\u092b \u092c\u0928\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0935\u094b \u091f\u0942\u0932 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u094b \u0921\u0947\u0921\u0932\u093e\u0907\u0928 \u092a\u0948\u0928\u093f\u0915 \u0938\u0947 \u092c\u091a\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0906\u092a\u0915\u094b \u0915\u0949\u092e\u094d\u092a\u093f\u091f\u093f\u091f\u093f\u0935 \u090f\u091c \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902, \u0905\u092a\u0928\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0935\u093f\u0937\u092f \u091a\u0941\u0928\u0947\u0902, \u0914\u0930 '\u092a\u094d\u0930\u094b \u0935\u0930\u094d\u0915\u092b\u093c\u094d\u0932\u094b' \u091f\u094d\u0930\u093e\u092f \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b 2 \u092e\u093f\u0928\u091f \u0915\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092f\u0939 \u0906\u092a\u0915\u0947 \u092a\u0942\u0930\u0947 \u092a\u0947\u092a\u0930 \u0915\u094b \u092c\u0926\u0932 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 P.S. \u2014 \u0935\u094b '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c' \u092c\u091f\u0928 \u0926\u092c\u093e\u0928\u093e \u092e\u0924 \u092d\u0942\u0932\u0928\u093e \u2014 \u092f\u0939\u0940 \u0935\u094b \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0939\u0948 \u091c\u094b 90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u0928\u0939\u0940\u0902 \u092a\u0924\u093e\u0964"
  ],
  "cta_text": "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u092a\u094d\u0930\u094b \u0935\u0930\u094d\u0915\u092b\u093c\u094d\u0932\u094b \u091f\u094d\u0930\u093e\u092f \u0915\u0930\u0947\u0902",
