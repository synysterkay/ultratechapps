{
  "subject": "\u042f \u0437\u0440\u043e\u0431\u0438\u0432 \u0432\u0435\u043b\u0438\u0447\u0435\u0437\u043d\u0443 \u043f\u043e\u043c\u0438\u043b\u043a\u0443 \u0437 \u0446\u0438\u043c \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u043c",
  "preview_text": "\u0422\u0435, \u0449\u043e \u044f \u0432\u0438\u044f\u0432\u0438\u0432 \u043f\u0456\u0441\u043b\u044f 48 \u0434\u043d\u0456\u0432 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f, \u0437\u043c\u0456\u043d\u0438\u0442\u044c \u0432\u0430\u0448\u0435 \u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0434\u043e \u0444\u0443\u0442\u0431\u043e\u043b\u0443. \u041d\u0435 \u0447\u0438\u0442\u0430\u0439\u0442\u0435, \u044f\u043a\u0449\u043e \u043d\u0435 \u0433\u043e\u0442\u043e\u0432\u0456.",
  "body_paragraphs": [
    "\u042f \u0431\u0443\u0432 \u0443\u043f\u0435\u0432\u043d\u0435\u043d\u0438\u0439, \u0449\u043e \u0437\u043d\u0430\u044e \u0444\u0443\u0442\u0431\u043e\u043b. \u0410 \u043f\u043e\u0442\u0456\u043c \u0437\u0430\u043b\u0456\u0437 \u0443 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u0439 \u0437\u0440\u043e\u0437\u0443\u043c\u0456\u0432, \u0449\u043e 90% \u043c\u043e\u0457\u0445 \u00ab\u0456\u043d\u0442\u0443\u0457\u0442\u0438\u0432\u043d\u0438\u0445\u00bb \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0456\u0432 \u2014 \u0446\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0435\u0437\u0456\u043d\u043d\u044f. \u0412\u0438 \u043a\u043e\u043b\u0438-\u043d\u0435\u0431\u0443\u0434\u044c \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u043b\u0438, \u0449\u043e \u0432\u0430\u0448\u0430 \u0456\u043d\u0442\u0443\u0457\u0446\u0456\u044f \u043f\u0456\u0434\u0432\u043e\u0434\u0438\u0442\u044c \u0443 \u043d\u0430\u0439\u0432\u0430\u0436\u043b\u0438\u0432\u0456\u0448\u0438\u0439 \u043c\u043e\u043c\u0435\u043d\u0442?",
    "\u0417\u0430 \u0446\u0456 48 \u0434\u043d\u0456\u0432 \u044f \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0432 \u0442\u0438\u0441\u044f\u0447\u0456 \u043c\u0430\u0442\u0447\u0456\u0432. \u0406 \u0432\u0438\u044f\u0432\u0438\u0432 \u043e\u0434\u043d\u0443 \u0440\u0456\u0447: AI Predictify \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0454 \u0431\u0456\u043b\u044c\u0448\u0435 \u0437\u043c\u0456\u043d\u043d\u0438\u0445 \u0437\u0430 \u0441\u0435\u043a\u0443\u043d\u0434\u0443, \u043d\u0456\u0436 \u044f \u0437\u0430 \u0432\u0441\u0435 \u0436\u0438\u0442\u0442\u044f. \u0412\u0456\u043d \u0431\u0430\u0447\u0438\u0442\u044c \u0442\u0435, \u0449\u043e \u043c\u0438 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u0454\u043c\u043e: \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0456\u0440\u043d\u043e\u0441\u0442\u0456 \u0432 xG, \u0441\u043b\u0430\u0431\u043a\u0456 \u043c\u0456\u0441\u0446\u044f \u0432 \u043e\u0431\u043e\u0440\u043e\u043d\u0456, \u043d\u0430\u0432\u0456\u0442\u044c \u0442\u0435, \u044f\u043a \u043f\u043e\u0433\u043e\u0434\u0430 \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0410\u043b\u0435 \u043d\u0430\u0439\u0441\u0442\u0440\u0430\u0448\u043d\u0456\u0448\u0435 \u2014 \u0432\u0456\u043d \u043f\u0440\u0430\u0432\u0438\u0439 \u0443 73% \u0432\u0438\u043f\u0430\u0434\u043a\u0456\u0432.",
    "\u0423\u044f\u0432\u0456\u0442\u044c: \u0432\u0438 \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454\u0442\u0435 \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0456 \u0431\u0430\u0447\u0438\u0442\u0435 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u043e\u0433\u043d\u043e\u0437, \u0430 \u0442\u043e\u0447\u043d\u0438\u0439 \u0430\u043d\u0430\u043b\u0456\u0437 \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u043c\u0430\u0442\u0447\u0443. \u0417\u0432\u0456\u0434\u043a\u0438 \u0437\u043d\u0430\u0454\u0442\u0435, \u0449\u043e \u0441\u0442\u0430\u0432\u043a\u0430 \u0432\u0430\u0440\u0442\u0430 \u0440\u0438\u0437\u0438\u043a\u0443? \u0422\u043e\u043c\u0443 \u0449\u043e AI \u0434\u0430\u0454 \u0432\u0430\u043c confidence score \u2014 \u0441\u0442\u0443\u043f\u0456\u043d\u044c \u0443\u043f\u0435\u0432\u043d\u0435\u043d\u043e\u0441\u0442\u0456. \u042f \u043f\u043e\u0447\u0430\u0432 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0446\u0435, \u0456 \u043c\u043e\u0457 \u0441\u0442\u0430\u0432\u043a\u0438 \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435 \u00ab\u043d\u0430\u043e\u0441\u043b\u0456\u043f\u00bb. \u0410 \u0449\u0435 \u0454 \u0442\u0435\u0441\u0442 IQ \u2014 \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438, \u0447\u0438 \u0437\u043d\u0430\u0454\u0442\u0435 \u0444\u0443\u0442\u0431\u043e\u043b \u043a\u0440\u0430\u0449\u0435 \u0437\u0430 AI. \u0406 \u0437\u043d\u0430\u0454\u0442\u0435 \u0449\u043e? \u042f \u043f\u0440\u043e\u0433\u0440\u0430\u0432. \u0410\u043b\u0435 \u0442\u0435\u043f\u0435\u0440 \u044f \u0437\u043d\u0430\u044e, \u0434\u0435 \u043f\u043e\u043c\u0438\u043b\u044f\u044e\u0441\u044f.",
    "\u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 Predictify \u0437\u0430\u0440\u0430\u0437. \u041f\u043e\u0434\u0438\u0432\u0456\u0442\u044c\u0441\u044f \u043d\u0430 \u0441\u0432\u0456\u0439 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0456 \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u0439\u0442\u0435 \u0439\u043e\u0433\u043e \u0437 AI. \u0412\u0438 \u0431\u0443\u0434\u0435\u0442\u0435 \u0432\u0440\u0430\u0436\u0435\u043d\u0456. P.S. \u042f\u043a\u0449\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u0441\u043f\u0440\u043e\u0431\u0443\u0432\u0430\u0442\u0438 Premium, \u0443 \u0432\u0430\u0441 \u0454 3 \u0434\u043d\u0456 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u043e \u2014 \u0446\u0435 \u0454\u0434\u0438\u043d\u0438\u0439 \u0441\u043f\u043e\u0441\u0456\u0431 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438 \u0432\u0441\u0456 \u0430\u043d\u0430\u043b\u0456\u0437\u0438. \u0410\u043b\u0435 \u043d\u0435 \u043a\u0430\u0436\u0456\u0442\u044c, \u0449\u043e \u044f \u0432\u0430\u0441 \u043d\u0435 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432."
  ],
