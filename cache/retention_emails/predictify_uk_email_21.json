{
  "subject": "48 \u0434\u043d\u0456\u0432 \u0442\u043e\u043c\u0443 \u0432\u0438 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u043b\u0438 Predictify",
  "preview_text": "\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443 AI \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0432 12 000 \u043d\u043e\u0432\u0438\u0445 \u043c\u0430\u0442\u0447\u0456\u0432. \u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435, \u0449\u043e\u0431 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438, \u0449\u043e \u0437\u043c\u0456\u043d\u0438\u043b\u043e\u0441\u044f.",
  "body_paragraphs": [
    "48 \u0434\u043d\u0456\u0432. \u0421\u0430\u043c\u0435 \u0441\u0442\u0456\u043b\u044c\u043a\u0438 \u043c\u0438\u043d\u0443\u043b\u043e \u0432\u0456\u0434\u0442\u043e\u0434\u0456, \u044f\u043a \u0432\u0438 \u0432\u043f\u0435\u0440\u0448\u0435 \u0432\u0456\u0434\u043a\u0440\u0438\u043b\u0438 Predictify. \u0417\u0430 \u0446\u0435\u0439 \u0447\u0430\u0441 \u043d\u0430\u0448\u0430 AI \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u043b\u0430 \u043f\u043e\u043d\u0430\u0434 12 000 \u043d\u043e\u0432\u0438\u0445 \u043c\u0430\u0442\u0447\u0456\u0432 \u2014 \u0432\u0456\u0434 \u041b\u0430 \u041b\u0456\u0433\u0438 \u0434\u043e \u0427\u0435\u043c\u043f\u0456\u043e\u043d\u0448\u0438\u043f\u0443. \u0406 \u0434\u0435\u0441\u044c \u0442\u0430\u043c, \u0443 \u0442\u0438\u0445 \u0434\u0430\u043d\u0438\u0445, \u0454 \u043f\u0440\u043e\u0433\u043d\u043e\u0437, \u044f\u043a\u0438\u0439 \u043c\u0456\u0433 \u0431\u0438 \u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u0432\u0430\u0448\u0443 \u0441\u0442\u0430\u0432\u043a\u0443 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456.",
    "\u0410\u043b\u0435 \u043e\u0441\u044c \u0449\u043e \u0446\u0456\u043a\u0430\u0432\u043e: \u0432\u0438 \u043d\u0435 \u0431\u0430\u0447\u0438\u043b\u0438, \u044f\u043a \u0437\u043c\u0456\u043d\u0438\u043b\u0430\u0441\u044f \u0433\u0440\u0430. \u041c\u0438 \u0434\u043e\u0434\u0430\u043b\u0438 \u043d\u043e\u0432\u0456 \u043c\u0435\u0442\u0440\u0438\u043a\u0438 \u2014 \u0442\u0435\u043f\u0435\u0440 AI \u0432\u0440\u0430\u0445\u043e\u0432\u0443\u0454 \u043d\u0430\u0432\u0456\u0442\u044c \u043f\u043e\u0433\u043e\u0434\u0443 \u043d\u0430 \u0441\u0442\u0430\u0434\u0456\u043e\u043d\u0456 \u0442\u0430 \u0444\u043e\u0440\u043c\u0443 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u0443 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456\u0445 5 \u043c\u0430\u0442\u0447\u0430\u0445. \u0426\u0435 \u043e\u0437\u043d\u0430\u0447\u0430\u0454, \u0449\u043e \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438 \u0441\u0442\u0430\u043b\u0438 \u0442\u043e\u0447\u043d\u0456\u0448\u0438\u043c\u0438 \u043d\u0430 18% \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043e \u0437 \u0442\u0438\u043c, \u0449\u043e \u0432\u0438 \u0431\u0430\u0447\u0438\u043b\u0438 \u0432\u043e\u0441\u0442\u0430\u043d\u043d\u0454.",
    "\u041d\u0430\u0439\u043a\u0440\u0443\u0442\u0456\u0448\u0435 \u2014 \u043d\u043e\u0432\u0438\u0439 \u0440\u043e\u0437\u0434\u0456\u043b '\u0410\u043d\u0430\u043b\u0456\u0442\u0438\u043a\u0430 \u043c\u0430\u0442\u0447\u0443'. \u0422\u0435\u043f\u0435\u0440 \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438, \u0447\u043e\u043c\u0443 AI \u0441\u0442\u0430\u0432\u0438\u0442\u044c 67% \u043d\u0430 \u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0443 '\u0420\u0435\u0430\u043b\u0430', \u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0447\u0438\u0441\u043b\u043e. \u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u0434\u043e\u0434\u0430\u0442\u043e\u043a, \u0437\u043d\u0430\u0439\u0434\u0456\u0442\u044c \u043c\u0430\u0442\u0447, \u044f\u043a\u0438\u0439 \u0432\u0430\u0441 \u0446\u0456\u043a\u0430\u0432\u0438\u0442\u044c, \u0456 \u043f\u043e\u0434\u0438\u0432\u0456\u0442\u044c\u0441\u044f \u043d\u0430 \u0446\u0456 \u0434\u0430\u043d\u0456 \u2014 \u0432\u043e\u043d\u0438 \u0437\u043c\u0456\u043d\u044f\u0442\u044c \u0432\u0430\u0448\u0435 \u0443\u044f\u0432\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u043e \u0433\u0440\u0443.",
    "\u041e\u0434\u043d\u0435 \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f \u2014 \u0456 \u0432\u0438 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0435, \u0449\u043e \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u043b\u0438. \u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 Predictify \u0437\u0430\u0440\u0430\u0437 \u0456 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u043d\u0430 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456\u0448\u043d\u0456\u0439 \u043c\u0430\u0442\u0447. P.S. \u0412\u0430\u0448\u0456 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0456 \u043a\u0440\u0435\u0434\u0438\u0442\u0438 \u0432\u0441\u0435 \u0449\u0435 \u0447\u0435\u043a\u0430\u044e\u0442\u044c \u2014 \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0434\u043e 10 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0456\u0432 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u043e, \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u0439\u0448\u043e\u0432\u0448\u0438.",
    "P.P.S. \u042f\u043a\u0449\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u0441\u043f\u0440\u043e\u0431\u0443\u0432\u0430\u0442\u0438 Premium \u2014 3 \u0434\u043d\u0456 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u043e, \u043f\u043e\u0442\u0456\u043c \u043b\u0438\u0448\u0435 $12.99 \u043d\u0430 \u043c\u0456\u0441\u044f\u0446\u044c. \u0410\u043b\u0435 \u043d\u0430\u0432\u0456\u0442\u044c \u0431\u0435\u0437 \u043d\u044c\u043e\u0433\u043e \u0432\u0438 \u0437\u043d\u0430\u0439\u0434\u0435\u0442\u0435 \u0449\u043e\u0441\u044c \u043d\u043e\u0432\u0435."
  ],
