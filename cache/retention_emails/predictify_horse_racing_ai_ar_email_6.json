{
  "subject": "\u0627\u0644\u062e\u0637\u0623 \u0627\u0644\u0630\u064a \u064a\u062e\u0633\u0631\u0643 \u0627\u0644\u0631\u0647\u0627\u0646 \u0641\u064a \u0627\u0644\u062f\u0642\u064a\u0642\u0629 15",
  "preview_text": "\u0627\u0643\u062a\u0634\u0641 \u0644\u0645\u0627\u0630\u0627 80% \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u062e\u0633\u0631\u0648\u0646 \u0628\u0633\u0628\u0628 \u0647\u0630\u0627 \u0627\u0644\u062e\u0637\u0623 \u0627\u0644\u0628\u0633\u064a\u0637 \u0648\u0643\u064a\u0641 \u064a\u062a\u062c\u0646\u0628\u0647 \u0627\u0644\u0645\u062d\u062a\u0631\u0641\u0648\u0646",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u062c\u0627\u0644\u0633 \u0641\u064a \u0627\u0644\u0645\u062f\u0631\u062c\u0627\u062a\u060c \u0627\u0644\u062d\u0635\u0627\u0646 \u0627\u0644\u0645\u0641\u0636\u0644 \u0644\u062f\u064a\u0643 \u064a\u062a\u0642\u062f\u0645 \u0628\u0641\u0627\u0631\u0642 3 \u0623\u0637\u0648\u0627\u0644\u060c \u0648\u062a\u0634\u0639\u0631 \u0623\u0646 \u0627\u0644\u0641\u0648\u0632 \u0645\u062d\u0633\u0648\u0645. \u0644\u0643\u0646 \u0641\u062c\u0623\u0629\u060c \u0641\u064a \u0627\u0644\u062f\u0642\u064a\u0642\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629\u060c \u064a\u062a\u0639\u062b\u0631 \u0648\u064a\u0641\u0642\u062f \u0643\u0644 \u0634\u064a\u0621. \u0647\u0630\u0627 \u0644\u064a\u0633 \u062d\u0638\u064b\u0627 \u0633\u064a\u0626\u064b\u0627\u060c \u0628\u0644 \u0647\u0648 \u0627\u0644\u062e\u0637\u0623 \u0627\u0644\u0634\u0627\u0626\u0639 \u0627\u0644\u0630\u064a \u064a\u0642\u0639 \u0641\u064a\u0647 \u0645\u0639\u0638\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646: \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0639\u0644\u0649 \u0627\u0644\u062d\u062f\u0633 \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a. \u0641\u064a Predictify\u060c \u0631\u0623\u064a\u0646\u0627 \u0622\u0644\u0627\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u062e\u0633\u0631\u0648\u0646 \u0631\u0647\u0627\u0646\u0627\u062a\u0647\u0645 \u0644\u064a\u0633 \u0644\u0623\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u062e\u0637\u0623\u060c \u0628\u0644 \u0644\u0623\u0646\u0647\u0645 \u064a\u062a\u062c\u0627\u0647\u0644\u0648\u0646 \u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0633\u0631\u0639\u0629 \u0648\u0627\u0644\u0648\u0632\u0646.",
    "\u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0623\u0646 \u0627\u0644\u0639\u0642\u0644 \u0627\u0644\u0628\u0634\u0631\u064a \u064a\u062d\u0628 \u0627\u0644\u0642\u0635\u0635\u2014\u062a\u0631\u0649 \u062d\u0635\u0627\u0646\u064b\u0627 \u0641\u0627\u0632 \u0641\u064a \u0622\u062e\u0631 3 \u0633\u0628\u0627\u0642\u0627\u062a \u0648\u062a\u0638\u0646 \u0623\u0646\u0647 \u0644\u0627 \u064a\u064f\u0642\u0647\u0631. \u0644\u0643\u0646 \u0627\u0644\u062d\u0642\u064a\u0642\u0629 \u0623\u0646 \u0627\u0644\u0633\u0628\u0627\u0642 \u0627\u0644\u0623\u062e\u064a\u0631 \u0643\u0627\u0646 \u0639\u0644\u0649 \u0623\u0631\u0636\u064a\u0629 \u0645\u062e\u062a\u0644\u0641\u0629\u060c \u0648\u0627\u0644\u0648\u0632\u0646 \u062a\u063a\u064a\u0631\u060c \u0648\u0627\u0644\u062d\u0635\u0627\u0646 \u0627\u0644\u0645\u0646\u0627\u0641\u0633 \u0623\u0642\u0648\u0649. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u062e\u0637\u0623 \u0631\u0642\u0645 1: \u0627\u0644\u062b\u0642\u0629 \u0641\u064a \u0627\u0644\u0645\u0634\u0627\u0639\u0631 \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0627\u0644\u0623\u0631\u0642\u0627\u0645. \u0627\u0644\u0645\u062d\u062a\u0631\u0641\u0648\u0646 \u0644\u0627 \u064a\u062e\u0645\u0646\u0648\u0646\u2014\u064a\u062d\u0644\u0644\u0648\u0646 \u0622\u0644\u0627\u0641 \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0641\u064a \u062b\u0648\u0627\u0646\u064d.",
    "\u0647\u0630\u0627 \u0628\u0627\u0644\u0636\u0628\u0637 \u0645\u0627 \u064a\u0641\u0639\u0644\u0647 \u062a\u0637\u0628\u064a\u0642\u0646\u0627. \u0639\u0646\u062f\u0645\u0627 \u062a\u0641\u062a\u062d \u062a\u062d\u0644\u064a\u0644 \u0623\u064a \u0633\u0628\u0627\u0642\u060c \u062a\u0631\u0649 \u062f\u0631\u062c\u0629 \u0627\u0644\u062b\u0642\u0629\u2014\u0646\u0633\u0628\u0629 \u0645\u0626\u0648\u064a\u0629 \u0645\u0628\u0646\u064a\u0629 \u0639\u0644\u0649 10,000+ \u0645\u062a\u063a\u064a\u0631: \u0633\u0631\u0639\u0629 \u0627\u0644\u062d\u0635\u0627\u0646\u060c \u0623\u062f\u0627\u0621 \u0627\u0644\u0645\u062f\u0631\u0628\u060c \u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0636\u0645\u0627\u0631\u060c \u0648\u062d\u062a\u0649 \u0627\u0644\u0637\u0642\u0633. \u0644\u0627 \u062a\u0642\u0644\u0642 \u0625\u0630\u0627 \u0644\u0645 \u062a\u0641\u0647\u0645 \u0643\u0644 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644\u2014\u0641\u0642\u0637 \u0627\u062a\u0628\u0639 \u062f\u0631\u062c\u0629 \u0627\u0644\u062b\u0642\u0629. \u062c\u0631\u0651\u0628\u0647\u0627 \u0641\u064a \u0633\u0628\u0627\u0642 \u0627\u0644\u064a\u0648\u0645: \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u062e\u062a\u0631 \u0633\u0628\u0627\u0642\u064b\u0627\u060c \u0648\u0627\u0646\u0638\u0631 \u0625\u0644\u0649 \u062f\u0631\u062c\u0629 \u0627\u0644\u062b\u0642\u0629 \u0642\u0628\u0644 \u0623\u0646 \u062a\u0631\u0627\u0647\u0646.",
    "\u0627\u0641\u062a\u062d Predictify \u0627\u0644\u0622\u0646 \u0648\u0627\u062e\u062a\u0631 \u0623\u064a \u0633\u0628\u0627\u0642. \u0627\u0628\u062f\u0623 \u0628\u062f\u0631\u062c\u0629 \u0627\u0644\u062b\u0642\u0629\u2014\u062f\u0639 \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u062a\u0642\u0648\u062f\u0643. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0627\u0644\u062e\u0633\u0627\u0631\u0629 \u0648\u0627\u0644\u0641\u0648\u0632. P.S. \u0647\u0644 \u062a\u0639\u0644\u0645 \u0623\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0645\u0645\u064a\u0632\u064a\u0646 \u064a\u062d\u0635\u0644\u0648\u0646 \u0639\u0644\u0649 \u062a\u062d\u0644\u064a\u0644\u0627\u062a \u0623\u0639\u0645\u0642 \u0628\u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a\u061f \u062c\u0631\u0651\u0628 \u0627\u0644\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0645\u0645\u064a\u0632 \u0645\u062c\u0627\u0646\u064b\u0627 \u0644\u0645\u062f\u0629 3 \u0623\u064a\u0627\u0645 \u0648\u0634\u0627\u0647\u062f \u0627\u0644\u0641\u0631\u0642 \u0628\u0646\u0641\u0633\u0643."
  ],
