{
  "subject": "\u0622\u067e \u06a9\u0627 \u067e\u06c1\u0644\u0627 \u0645\u06cc\u0686 \u2014 \u0627\u06cc\u06a9 \u0646\u0626\u06cc \u0634\u0631\u0648\u0639\u0627\u062a",
  "preview_text": "\u0622\u067e \u0627\u06a9\u06cc\u0644\u06d2 \u0646\u06c1\u06cc\u06ba \u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1 \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u06a9\u06c1 \u06a9\u06cc\u0633\u06d2 10,000 \u0634\u0627\u0626\u0642\u06cc\u0646 \u06c1\u0631 \u06c1\u0641\u062a\u06d2 \u0628\u062f\u0644\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",
  "body_paragraphs": [
    "\u062a\u0645 \u0646\u06d2 \u0633\u0648\u0686\u0627 \u062a\u06be\u0627 \u06a9\u06c1 \u062a\u0645 \u0635\u0631\u0641 \u0627\u06cc\u06a9 \u0627\u06cc\u067e \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u0631 \u0631\u06c1\u06d2 \u06c1\u0648\u06d4 \u0644\u06cc\u06a9\u0646 \u062d\u0642\u06cc\u0642\u062a \u0645\u06cc\u06ba\u060c \u062a\u0645 \u0627\u06cc\u06a9 \u0627\u06cc\u0633\u06cc \u062a\u062d\u0631\u06cc\u06a9 \u06a9\u0627 \u062d\u0635\u06c1 \u0628\u0646 \u06af\u0626\u06d2 \u06c1\u0648 \u062c\u06c1\u0627\u06ba 10,000 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u0634\u0627\u0626\u0642\u06cc\u0646 \u06c1\u0631 \u06c1\u0641\u062a\u06d2 \u0627\u067e\u0646\u06d2 \u0627\u0646\u062f\u0627\u0632\u06d2 \u06a9\u0648 \u0688\u06cc\u0679\u0627 \u0633\u06d2 \u0628\u062f\u0644 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1 \u0635\u0631\u0641 \u067e\u06cc\u0634\u06a9\u0634\u0648\u06ba \u06a9\u06cc \u0628\u0627\u062a \u0646\u06c1\u06cc\u06ba \u2014 \u06cc\u06c1 \u0627\u0633 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u06c1\u06d2 \u06a9\u06c1 \u062a\u0645 \u06a9\u06cc\u0633\u06d2 \u0633\u0648\u0686\u062a\u06d2 \u06c1\u0648\u06d4",
    "\u06a9\u0644 \u0631\u0627\u062a\u060c \u0645\u06cc\u06ba \u0646\u06d2 \u0627\u067e\u0646\u06d2 \u062f\u0648\u0633\u062a \u06a9\u0648 \u0628\u062a\u0627\u06cc\u0627 \u06a9\u06c1 \u0628\u0627\u0631\u0633\u0644\u0648\u0646\u0627 \u06a9\u06d2 \u067e\u0627\u0633 67% \u062c\u06cc\u062a\u0646\u06d2 \u06a9\u0627 \u0627\u0645\u06a9\u0627\u0646 \u06c1\u06d2\u06d4 \u0627\u0633 \u0646\u06d2 \u06c1\u0646\u0633 \u06a9\u0631 \u06a9\u06c1\u0627 '\u06cc\u06c1 \u0635\u0631\u0641 \u0627\u06cc\u06a9 \u0646\u0645\u0628\u0631 \u06c1\u06d2'\u06d4 \u0644\u06cc\u06a9\u0646 \u062c\u0628 \u0645\u06cc\u0686 \u062e\u062a\u0645 \u06c1\u0648\u0627\u060c \u0648\u06c1 \u062e\u0627\u0645\u0648\u0634 \u062a\u06be\u0627\u06d4 \u062a\u0645 \u0628\u06be\u06cc \u0648\u06c1\u06cc \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u0648 \u2014 \u0627\u067e\u0646\u06d2 \u06af\u0679 \u0641\u06cc\u0644\u0646\u06af \u06a9\u0648 \u0688\u06cc\u0679\u0627 \u0633\u06d2 \u0628\u062f\u0644 \u06a9\u0631\u060c \u0627\u0648\u0631 \u062f\u06cc\u06a9\u06be\u0648 \u06a9\u06c1 \u062a\u0645\u06c1\u0627\u0631\u06cc \u067e\u06cc\u0634\u06a9\u0634\u06cc\u06ba \u06a9\u06cc\u0633\u06d2 \u0628\u062f\u0644 \u062c\u0627\u062a\u06cc \u06c1\u06cc\u06ba\u06d4",
    "\u0622\u062c\u060c \u06c1\u0645 \u0646\u06d2 \u0627\u06cc\u06a9 \u0646\u06cc\u0627 \u0641\u06cc\u0686\u0631 \u0644\u0627\u0646\u0686 \u06a9\u06cc\u0627 \u06c1\u06d2: '\u067e\u06cc\u0634\u0646 \u0622\u0641 \u062f\u06cc \u0688\u06d2 (POTD) \u0648\u0648\u0679\u0646\u06af'\u06d4 \u062a\u0645 \u0627\u067e\u0646\u06cc \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0645\u0644 \u06a9\u0631 \u0628\u06c1\u062a\u0631\u06cc\u0646 \u067e\u06cc\u0634\u06a9\u0634 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u0648\u060c \u0627\u0648\u0631 \u062f\u06cc\u06a9\u06be \u0633\u06a9\u062a\u06d2 \u06c1\u0648 \u06a9\u06c1 \u062a\u0645\u06c1\u0627\u0631\u06cc \u0631\u0627\u0626\u06d2 \u062f\u0648\u0633\u0631\u0648\u06ba \u0633\u06d2 \u06a9\u06cc\u0633\u06d2 \u0645\u0648\u0627\u0632\u0646\u06c1 \u06a9\u0631\u062a\u06cc \u06c1\u06d2\u06d4 \u06cc\u06c1 \u0635\u0631\u0641 \u0627\u06cc\u06a9 \u06a9\u06be\u06cc\u0644 \u0646\u06c1\u06cc\u06ba \u2014 \u06cc\u06c1 \u062a\u0645\u06c1\u0627\u0631\u06cc \u0641\u0679\u0628\u0627\u0644 \u0622\u0626\u06cc \u06a9\u06cc\u0648 \u06a9\u0648 \u062b\u0627\u0628\u062a \u06a9\u0631\u0646\u06d2 \u06a9\u0627 \u0645\u0648\u0642\u0639 \u06c1\u06d2\u06d4",
    "\u0627\u0628\u06be\u06cc \u0627\u06cc\u067e \u06a9\u06be\u0648\u0644\u0648 \u0627\u0648\u0631 POTD \u0633\u06cc\u06a9\u0634\u0646 \u0645\u06cc\u06ba \u062c\u0627\u0624\u06d4 \u0627\u067e\u0646\u06cc \u067e\u06cc\u0634\u06a9\u0634 \u0688\u0627\u0644\u0648 \u0627\u0648\u0631 \u062f\u06cc\u06a9\u06be\u0648 \u06a9\u06c1 \u062a\u0645\u06c1\u0627\u0631\u06cc \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc \u06a9\u06cc\u0627 \u06a9\u06c1\u062a\u06cc \u06c1\u06d2\u06d4 P.S. \u2014 \u06a9\u0644 \u0627\u06cc\u06a9 \u0628\u0691\u0627 \u0645\u06cc\u0686 \u06c1\u06d2: \u0645\u0627\u0646\u0686\u0633\u0679\u0631 \u0633\u0679\u06cc \u0628\u0645\u0642\u0627\u0628\u0644\u06c1 \u0644\u06cc\u0648\u0631\u067e\u0648\u0644\u06d4 \u06c1\u0645\u0627\u0631\u06d2 AI \u0646\u06d2 72% \u06a9\u0627\u0646\u0641\u06cc\u0688\u0646\u0633 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0627\u06cc\u06a9 \u067e\u06cc\u0634\u06a9\u0634 \u062f\u06cc \u06c1\u06d2\u06d4 \u06a9\u06cc\u0627 \u062a\u0645 \u0627\u0633\u06d2 \u0634\u06a9\u0633\u062a \u062f\u06d2 \u0633\u06a9\u062a\u06d2 \u06c1\u0648\u061f"
  ],
