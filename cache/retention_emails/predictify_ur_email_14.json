{
  "subject": "\u0622\u067e \u0646\u06d2 \u0627\u0628\u06be\u06cc \u062a\u06a9 \u06a9\u0686\u06be \u0646\u06c1\u06cc\u06ba \u062f\u06cc\u06a9\u06be\u0627",
  "preview_text": "\u0627\u06cc\u06a9 \u0627\u06cc\u0633\u06cc \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc \u06a9\u0627 \u062d\u0635\u06c1 \u0628\u0646\u06cc\u06ba \u062c\u0648 \u0641\u0679 \u0628\u0627\u0644 \u06a9\u0648 \u0646\u0626\u06d2 \u0632\u0627\u0648\u06cc\u06d2 \u0633\u06d2 \u062f\u06cc\u06a9\u06be\u062a\u06cc \u06c1\u06d2\u06d4 \u06cc\u06c1 \u0648\u06c1 \u0631\u0627\u0632 \u06c1\u06d2 \u062c\u0648 90% \u0635\u0627\u0631\u0641\u06cc\u0646 \u0686\u06be\u0648\u0691 \u062f\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",
  "body_paragraphs": [
    "\u06a9\u06cc\u0627 \u0622\u067e \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 Predictify \u06a9\u06d2 \u0635\u0631\u0641 10% \u0635\u0627\u0631\u0641\u06cc\u0646 \u0648\u06c1 \u0641\u06cc\u0686\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u0648 \u0627\u0646\u06c1\u06cc\u06ba \u0627\u06cc\u06a9 \u0646\u06cc\u0627 \u0641\u0679 \u0628\u0627\u0644 \u06a9\u0627 \u062a\u062c\u0631\u0628\u06c1 \u062f\u06cc\u062a\u0627 \u06c1\u06d2\u061f \u0645\u06cc\u06ba \u0628\u06be\u06cc \u0648\u06c1\u06cc \u063a\u0644\u0637\u06cc \u06a9\u0631 \u0631\u06c1\u0627 \u062a\u06be\u0627 \u062c\u0628 \u062a\u06a9 \u06a9\u06c1 \u0645\u06cc\u06ba \u0646\u06d2 \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc\u0632 \u06a9\u0648 \u062f\u0631\u06cc\u0627\u0641\u062a \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627\u06d4 \u0622\u062c \u0622\u067e \u0627\u0633 \u06a9\u0627 \u062d\u0635\u06c1 \u06c1\u06cc\u06ba\u06d4",
    "\u06cc\u06c1 \u0635\u0631\u0641 \u0627\u06cc\u06a9 \u0627\u06cc\u067e \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u060c \u06cc\u06c1 \u0627\u06cc\u06a9 \u062a\u062d\u0631\u06cc\u06a9 \u06c1\u06d2\u06d4 \u06c1\u0631 \u0631\u0648\u0632 \u06c1\u0632\u0627\u0631\u0648\u06ba \u0634\u0627\u0626\u0642\u06cc\u0646 \u0627\u067e\u0646\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0648\u06ba \u06a9\u0648 \u0688\u06cc\u0679\u0627 \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631 \u0628\u06c1\u062a\u0631 \u0628\u0646\u0627 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba\u060c \u0627\u0648\u0631 \u0622\u067e \u0628\u06be\u06cc \u0627\u0646 \u0645\u06cc\u06ba \u0634\u0627\u0645\u0644 \u06c1\u06cc\u06ba\u06d4 \u062c\u0628 \u0622\u067e \u06a9\u0633\u06cc \u0645\u06cc\u0686 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0628\u062d\u062b \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u062a\u0648 \u0635\u0631\u0641 \u062c\u0630\u0628\u0627\u062a \u0646\u06c1\u06cc\u06ba\u060c \u0628\u0644\u06a9\u06c1 \u0627\u0639\u062f\u0627\u062f \u0648 \u0634\u0645\u0627\u0631 \u0622\u067e \u06a9\u06cc \u0637\u0627\u0642\u062a \u0628\u0646 \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",
    "\u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc\u0632 \u0645\u06cc\u06ba \u0634\u0627\u0645\u0644 \u06c1\u0648 \u06a9\u0631 \u0622\u067e Prediction of the Day \u067e\u0631 \u0648\u0648\u0679 \u062f\u06d2 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0627\u067e\u0646\u06d2 \u067e\u0633\u0646\u062f\u06cc\u062f\u06c1 \u06a9\u0644\u0628 \u06a9\u06d2 \u06af\u0631\u0648\u067e \u0645\u06cc\u06ba \u0634\u0627\u0645\u0644 \u06c1\u0648 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0627\u0648\u0631 \u062f\u0648\u0633\u0631\u06d2 \u0634\u0627\u0626\u0642\u06cc\u0646 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0645\u06cc\u0686\u0648\u06ba \u067e\u0631 \u0628\u062d\u062b \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1 \u0648\u06c1 \u062c\u06af\u06c1 \u06c1\u06d2 \u062c\u06c1\u0627\u06ba \u0622\u067e \u06a9\u06cc \u0631\u0627\u0626\u06d2 \u06a9\u0648 \u0627\u0639\u062f\u0627\u062f \u0648 \u0634\u0645\u0627\u0631 \u06a9\u06cc \u067e\u0634\u062a \u067e\u0646\u0627\u06c1\u06cc \u0645\u0644\u062a\u06cc \u06c1\u06d2\u060c \u0627\u0648\u0631 \u0622\u067e \u06a9\u0648 \u0627\u06cc\u06a9 \u062d\u0642\u06cc\u0642\u06cc '\u0641\u0679 \u0628\u0631\u06cc\u0646' \u06a9\u06cc \u067e\u06c1\u0686\u0627\u0646 \u0645\u0644\u062a\u06cc \u06c1\u06d2\u06d4",
    "\u0622\u062c \u06c1\u06cc \u0627\u067e\u0646\u06cc \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc \u0645\u06cc\u06ba \u0634\u0627\u0645\u0644 \u06c1\u0648\u06ba \u0627\u0648\u0631 \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u06a9\u06c1 \u0622\u067e \u06a9\u062a\u0646\u06d2 \u0645\u06cc\u0686\u0648\u06ba \u06a9\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc \u062f\u0631\u0633\u062a \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 CTA: '\u0627\u067e\u0646\u06cc \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc \u0645\u06cc\u06ba \u0634\u0627\u0645\u0644 \u06c1\u0648\u06ba' \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 P.S. \u06a9\u06cc\u0627 \u0622\u067e \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u062c\u0646 \u0635\u0627\u0631\u0641\u06cc\u0646 \u0646\u06d2 \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc\u0632 \u0645\u06cc\u06ba \u062d\u0635\u06c1 \u0644\u06cc\u0627\u060c \u0627\u0646 \u06a9\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0648\u06ba \u06a9\u06cc \u062f\u0631\u0633\u062a\u06af\u06cc \u0645\u06cc\u06ba 40% \u0627\u0636\u0627\u0641\u06c1 \u06c1\u0648\u0627\u061f \u06cc\u06c1 \u0645\u0648\u0642\u0639 \u0645\u062a \u0686\u06be\u0648\u0691\u06cc\u06ba\u06d4"
