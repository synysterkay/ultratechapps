  "subject": "\u6211\u4eec\u5206\u6790\u4e8610,000\u4e2a\u7528\u6237\uff0c\u53d1\u73b0\u4e86\u4e00\u4e2a\u79d8\u5bc6",
  "preview_text": "\u4e00\u4e2a\u6570\u636e\u70b9\uff0c\u53ef\u80fd\u6539\u53d8\u4f60\u4f7f\u7528\u97f3\u91cf\u589e\u5f3a\u5668\u7684\u65b9\u5f0f\u3002\u6253\u5f00\u770b\u770b\u3002",
  "body_paragraphs": [
    "\u6211\u4eec\u5206\u6790\u4e8610,000\u4e2a\u7528\u6237\u7684\u97f3\u91cf\u4f7f\u7528\u4e60\u60ef\uff0c\u53d1\u73b0\u4e86\u4e00\u4e2a\u4ee4\u4eba\u9707\u60ca\u7684\u4e8b\u5b9e\uff1a\u90a3\u4e9b\u575a\u6301\u4f7f\u7528\u514d\u8d39\u7248\u3001\u5fcd\u53d7\u5e7f\u544a\u7684\u7528\u6237\uff0c\u5e73\u5747\u6bcf\u5929\u53ea\u8c03\u6574\u97f3\u91cf\u4e00\u6b21\u3002\u800c\u4ed8\u8d39\u7528\u6237\uff0c\u6bcf\u5929\u8c03\u6574\u4e09\u6b21\u4ee5\u4e0a\u3002",
    "\u8fd9\u4e0d\u662f\u5de7\u5408\u3002\u514d\u8d39\u7248\u7684\u5e7f\u544a\u548c\u901a\u77e5\u6253\u65ad\u4e86\u4f60\u7684\u4f7f\u7528\u8282\u594f\uff0c\u8ba9\u4f60\u6bcf\u6b21\u6253\u5f00\u90fd\u60f3\u5c3d\u5feb\u5173\u6389\u3002\u4f46\u9ad8\u7ea7\u7248\u7684\u8bbe\u8ba1\u2014\u2014\u90a3\u4e2a\u5e72\u51c0\u7684\u6ed1\u5757\uff0c\u6ca1\u6709\u5e72\u6270\u2014\u2014\u8ba9\u4f60\u81ea\u7136\u5730\u3001\u9891\u7e41\u5730\u8c03\u6574\uff0c\u76f4\u5230\u5b8c\u7f8e\u3002",
    "\u8fd9\u4e2a\u5dee\u5f02\u7684\u6838\u5fc3\uff0c\u662f\u6211\u4eec\u7684\u201c\u81ea\u52a8\u5e94\u7528\u201d\u529f\u80fd\u3002\u5f53\u8033\u673a\u8fde\u63a5\u65f6\uff0c\u97f3\u91cf\u81ea\u52a8\u8c03\u6574\u5230\u4f60\u7684\u504f\u597d\u8bbe\u7f6e\u3002\u9ad8\u7ea7\u7528\u6237\u4f9d\u8d56\u5b83\uff0c\u514d\u8d39\u7528\u6237\u5374\u4ece\u672a\u4f53\u9a8c\u8fc7\u3002\u4f60\u6253\u5f00\u5e94\u7528\uff0c\u8bbe\u7f6e\u4e00\u6b21\uff0c\u7136\u540e\u5fd8\u6389\u5b83\u3002\u7cfb\u7edf\u81ea\u52a8\u63a5\u7ba1\u3002",
    "\u4eca\u5929\uff0c\u8bd5\u8bd5\u8fd9\u4e2a\uff1a\u6253\u5f00\u5e94\u7528\uff0c\u8bbe\u7f6e\u4f60\u7684\u9ed8\u8ba4\u97f3\u91cf\uff0c\u7136\u540e\u8fde\u63a5\u8033\u673a\u3002\u770b\u5b83\u5982\u4f55\u65e0\u7f1d\u5de5\u4f5c\u3002P.S. \u90a3\u4e2a\u6570\u636e\u70b9\u8fd8\u544a\u8bc9\u6211\u4eec\uff0c\u9ad8\u7ea7\u7528\u6237\u542c\u97f3\u4e50\u7684\u65f6\u95f4\u6bd4\u514d\u8d39\u7528\u6237\u591a40%\u3002\u4e0d\u662f\u5de7\u5408\u3002"
  ],
