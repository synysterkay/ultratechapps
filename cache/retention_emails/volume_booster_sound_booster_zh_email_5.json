{
  "subject": "\u51cc\u66682\u70b9\u72af\u4e86\u4e2a\u9519\uff0c\u5374\u505a\u51fa\u4e86\u8fd9\u4e2a\u529f\u80fd",
  "preview_text": "\u672c\u6765\u53ea\u60f3\u8c03\u4e2a\u95f9\u949f\uff0c\u7ed3\u679c\u624b\u6ed1\u6253\u5f00\u4e86\u53e6\u4e00\u4e2a\u4e1c\u897f\uff0c\u7136\u540e\u4e00\u5207\u90fd\u53d8\u4e86\u3002",
  "body_paragraphs": [
    "\u51cc\u6668\u4e24\u70b9\u534a\uff0c\u6211\u6234\u7740\u8033\u673a\uff0c\u5728\u6c99\u53d1\u4e0a\u5feb\u7761\u7740\u4e86\u3002\u672c\u6765\u53ea\u662f\u60f3\u8c03\u4e2a\u660e\u5929\u65e9\u4e0a\u7684\u95f9\u949f\uff0c\u7ed3\u679c\u624b\u6307\u4e00\u6ed1\uff0c\u70b9\u5f00\u4e86\u624b\u673a\u91cc\u4e00\u4e2a\u534a\u6210\u54c1\u7684\u97f3\u9891\u6d4b\u8bd5\u6587\u4ef6\u3002",
    "\u90a3\u4e2a\u77ac\u95f4\uff0c\u4e00\u6bb5\u6211\u542c\u4e86\u65e0\u6570\u904d\u3001\u719f\u6089\u5230\u9ebb\u6728\u7684\u5409\u4ed6solo\uff0c\u7a81\u7136\u50cf\u88ab\u6495\u5f00\u4e86\u4e00\u5c42\u8584\u819c\uff0c\u76f4\u63a5\u649e\u8fdb\u8033\u6735\u91cc\u3002\u4e0d\u662f\u97f3\u91cf\u53d8\u5927\u4e86\uff0c\u662f\u58f0\u97f3\u2018\u6d3b\u2019\u4e86\u3002\u6bcf\u4e00\u4e2a\u62e8\u5f26\u7684\u7ec6\u8282\uff0c\u624b\u6307\u5728\u7434\u5f26\u4e0a\u8f7b\u5fae\u7684\u6469\u64e6\uff0c\u97f3\u7bb1\u540e\u7a7a\u6c14\u7684\u9707\u52a8\uff0c\u5168\u90fd\u6e05\u6e05\u695a\u695a\u3002\u6211\u4e00\u4e0b\u5b50\u5750\u76f4\u4e86\uff0c\u7761\u610f\u5168\u65e0\u3002\u90a3\u4e00\u523b\u6211\u624d\u660e\u767d\uff0c\u6211\u4eec\u7f3a\u7684\u4e0d\u662f\u97f3\u91cf\uff0c\u662f\u58f0\u97f3\u7684\u2018\u751f\u547d\u611f\u2019\u3002",
    "\u90a3\u4e2a\u534a\u6210\u54c1\uff0c\u540e\u6765\u5c31\u6210\u4e86\u5e94\u7528\u91cc\u2018\u9ad8\u7ea7EQ\u63a7\u5236\u2019\u7684\u96cf\u5f62\u3002\u5b83\u4e0d\u662f\u7b80\u5355\u7684\u63a8\u5b50\uff0c\u800c\u662f\u8ba9\u4f60\u80fd\u50cf\u624b\u672f\u5200\u4e00\u6837\uff0c\u7cbe\u51c6\u5730\u627e\u56de\u90a3\u4e9b\u88ab\u8bbe\u5907\u5403\u6389\u7684\u7ec6\u8282\u548c\u8d28\u611f\u3002\u85cf\u5728\u2018\u8bbe\u7f6e\u2019\u6df1\u5904\uff0c\u5f88\u591a\u4eba\u53ef\u80fd\u90fd\u6ca1\u53d1\u73b0\u3002",
    "\u5982\u679c\u4f60\u4e5f\u597d\u5947\uff0c\u4f60\u624b\u673a\u91cc\u7684\u58f0\u97f3\u5230\u5e95\u80fd\u2018\u6d3b\u2019\u6210\u4ec0\u4e48\u6837\uff0c\u73b0\u5728\u5c31\u53bb\u6253\u5f00\u5e94\u7528\uff0c\u70b9\u5f00\u8bbe\u7f6e\uff0c\u627e\u5230\u90a3\u4e2a\u2018\u9ad8\u7ea7EQ\u2019\u3002\u8bd5\u8bd5\u5fae\u8c03\u4e2d\u9ad8\u9891\uff0c\u542c\u542c\u4eba\u58f0\u662f\u4e0d\u662f\u7acb\u523b\u6709\u4e86\u547c\u5438\u3002P.S. \u514d\u8d39\u7248\u4e5f\u80fd\u8c03\uff0c\u4f46\u89e3\u9501\u9ad8\u7ea7\u7248\uff0c\u4f60\u624d\u80fd\u771f\u7684\u628a\u90a3\u628a\u2018\u624b\u672f\u5200\u2019\u63e1\u5728\u624b\u91cc\u3002",
    "\u6253\u5f00\u5e94\u7528\uff0c\u627e\u5230\u9ad8\u7ea7EQ"
  ],
