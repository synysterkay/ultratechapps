{
  "subject": "\u0930\u093e\u091c \u0915\u093e \u0915\u093f\u0938\u094d\u0938\u093e \u091c\u093f\u0938\u0928\u0947 \u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0915\u094b \u0930\u094b\u0915 \u0926\u093f\u092f\u093e",
  "preview_text": "\u090f\u0915 \u092f\u0942\u091c\u093c\u0930 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u091c\u094b \u0939\u092e \u0938\u092c\u0915\u094b \u092f\u093e\u0926 \u0939\u0948\u0964 \u0935\u094b \u092c\u093e\u0938 \u0915\u0948\u0938\u0947 \u092e\u0939\u0938\u0942\u0938 \u0939\u0941\u0906, \u092a\u0922\u093c\u093f\u090f\u0964",
  "body_paragraphs": [
    "\u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0915\u0947 \u0932\u093f\u090f \u092f\u0939 \u090f\u0915 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0938\u0941\u092c\u0939 \u0925\u0940\u0964 \u0924\u092d\u0940 \u090f\u0915 \u0908\u092e\u0947\u0932 \u0906\u092f\u093e\u0964 \u0930\u093e\u091c \u0928\u093e\u092e \u0915\u0947 \u092f\u0942\u091c\u093c\u0930 \u0928\u0947 \u0932\u093f\u0916\u093e \u0925\u093e \u0915\u093f \u0909\u0938\u0928\u0947 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u092a\u0930 \u0915\u094b\u0908 \u0917\u093e\u0928\u093e \u0938\u0941\u0928\u093e \u0914\u0930 \u0909\u0938\u0947 \u0932\u0917\u093e \u091c\u0948\u0938\u0947 \u0909\u0938\u0915\u0940 \u091b\u093e\u0924\u0940 \u092e\u0947\u0902 \u092c\u093e\u0938 \u0917\u0942\u0902\u091c \u0930\u0939\u093e \u0939\u0948\u0964 \u0939\u092e \u0938\u092c \u0930\u0941\u0915 \u0917\u090f\u0964",
    "\u0930\u093e\u091c \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0935\u0939 \u0939\u092e\u0947\u0936\u093e \u0908\u092f\u0930\u092b\u093c\u094b\u0928 \u092a\u0930 \u092b\u094d\u0932\u0948\u091f, \u092c\u0947\u091c\u093e\u0928 \u0906\u0935\u093e\u091c\u093c \u0938\u0947 \u092a\u0930\u0947\u0936\u093e\u0928 \u0925\u093e\u0964 \u0939\u093f\u092a-\u0939\u0949\u092a \u0915\u0947 \u0921\u094d\u0930\u0949\u092a \u0909\u0938\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0932\u0917\u0924\u0947 \u0925\u0947\u0964 \u092b\u093f\u0930 \u0909\u0938\u0928\u0947 Bass Booster \u0915\u093e Bass Virtualizer \u0906\u091c\u093c\u092e\u093e\u092f\u093e\u0964 \u090f\u0915 \u092c\u093e\u0930\u0964 \u092c\u0938\u0964 \u0905\u092c \u0935\u0939 \u0939\u0930 \u0917\u093e\u0928\u0947 \u092e\u0947\u0902 \u0935\u0939\u0940 '\u091b\u093e\u0924\u0940 \u092e\u0947\u0902 \u0917\u0942\u0902\u091c' \u091a\u093e\u0939\u0924\u093e \u0939\u0948\u0964",
    "\u0939\u092e\u0928\u0947 \u092f\u0939 \u092b\u0940\u091a\u0930 \u0907\u0938\u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e \u0925\u093e \u0924\u093e\u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0908\u092f\u0930\u092b\u093c\u094b\u0928 \u092e\u0947\u0902 \u092d\u0940 \u0935\u0939\u0940 \u0915\u092e\u093e\u0932 \u0939\u094b\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0938\u0947 3D Surround \u0911\u0928 \u0915\u0930\u094b\u0964 \u0921\u094d\u0930\u0949\u092a \u0915\u094b \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u094b, \u091c\u0948\u0938\u0947 \u0930\u093e\u091c \u0928\u0947 \u0915\u093f\u092f\u093e\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092b\u094b\u0928 \u092b\u094d\u0932\u0948\u091f \u0928\u0939\u0940\u0902 \u0930\u0939\u0947\u0917\u093e\u0964",
    "\u0905\u092c \u092c\u093e\u0930\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0939\u0948\u0964 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 Bass Virtualizer \u0915\u094b 3D Surround \u0915\u0947 \u0938\u093e\u0925 \u091f\u094d\u0930\u093e\u092f \u0915\u0930\u094b\u0964 P.S. \u0930\u093e\u091c \u0905\u092c \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930 \u0939\u0948 \u2014 \u0909\u0938\u0928\u0947 \u0915\u0939\u093e, '\u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0915\u0947 \u092c\u093f\u0928\u093e \u091c\u0940\u0935\u0928 \u0905\u0927\u0942\u0930\u093e \u0939\u0948\u0964' \u0924\u0941\u092e \u092d\u0940 \u0926\u0947\u0916\u094b\u0964"
  ],
