{
  "subject": "\u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0642\u0628\u0644 \u0648\u0628\u0639\u062f \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u062d\u0631\u062c",
  "preview_text": "\u0642\u0628\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0643\u0646\u062a \u062a\u0642\u0636\u064a \u0633\u0627\u0639\u0627\u062a \u0641\u064a \u0627\u0644\u0643\u062a\u0627\u0628\u0629\u061f \u0628\u0639\u062f \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u0646\u062a \u062a\u0646\u062c\u0632 \u0641\u064a \u062f\u0642\u0627\u0626\u0642. \u0627\u0644\u0641\u0631\u0642 \u0645\u062d\u0631\u062c \u0644\u0643\u0646\u0647 \u062d\u0642\u064a\u0642\u064a.",
  "body_paragraphs": [
    "\u0623\u062a\u0630\u0643\u0631 \u0623\u0648\u0644 \u0645\u0631\u0629 \u0627\u0633\u062a\u062e\u062f\u0645\u062a \u0641\u064a\u0647\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u061f \u0643\u0646\u062a \u062c\u0627\u0644\u0633 \u0642\u062f\u0627\u0645 \u0634\u0627\u0634\u0629 \u0628\u064a\u0636\u0627\u0621\u060c \u0627\u0644\u0633\u0627\u0639\u0629 3 \u0627\u0644\u0641\u062c\u0631\u060c \u0648\u0627\u0644\u0645\u0648\u0639\u062f \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u0628\u0639\u062f 8 \u0633\u0627\u0639\u0627\u062a. \u0643\u0646\u062a \u0623\u0643\u062a\u0628 \u062c\u0645\u0644\u0629 \u0648\u0627\u0645\u0633\u062d\u0647\u0627\u060c \u0623\u062d\u0633 \u0623\u0646\u064a \u0641\u0627\u0634\u0644. \u0628\u0639\u062f \u0633\u0627\u0639\u062a\u064a\u0646\u060c \u0645\u0627 \u0643\u062a\u0628\u062a \u063a\u064a\u0631 \u0639\u0646\u0648\u0627\u0646. \u0628\u0639\u062f \u0645\u0627 \u062c\u0631\u0628\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u061f \u0635\u0627\u0631 \u0639\u0646\u062f\u064a \u0623\u0637\u0631\u0648\u062d\u0629 \u0643\u0627\u0645\u0644\u0629 \u0641\u064a 10 \u062f\u0642\u0627\u0626\u0642. \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0642\u0628\u0644 \u0648\u0628\u0639\u062f \u0645\u062d\u0631\u062c. \u0645\u062d\u0631\u062c \u0625\u0646\u064a \u0643\u0646\u062a \u0623\u0636\u064a\u0639 \u0648\u0642\u062a\u064a \u0642\u0628\u0644.",
    "\u062a\u062e\u064a\u0644 \u0644\u0648 \u0643\u0644 \u0623\u0637\u0631\u0648\u062d\u0629 \u062a\u0643\u062a\u0628\u0647\u0627 \u062a\u0623\u062e\u0630 \u0645\u0646\u0643 10 \u062f\u0642\u0627\u0626\u0642 \u0628\u062f\u0644 8 \u0633\u0627\u0639\u0627\u062a. \u062a\u062e\u064a\u0644 \u0644\u0648 \u062a\u0642\u062f\u0631 \u062a\u0648\u0644\u062f \u0631\u0633\u0648\u0645 \u0628\u064a\u0627\u0646\u064a\u0629 \u0648\u062c\u062f\u0627\u0648\u0644 \u0648\u0645\u0631\u0627\u062c\u0639 \u0628\u0636\u063a\u0637\u0629 \u0632\u0631. \u0647\u0630\u0627 \u0645\u0648 \u0633\u062d\u0631\u060c \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642. 50,000 \u0637\u0627\u0644\u0628 \u0627\u0633\u062a\u062e\u062f\u0645\u0648\u0647\u060c \u0648\u0645\u0639\u062f\u0644 \u0627\u0644\u062f\u0631\u062c\u0627\u062a \u062a\u062d\u0633\u0646 \u0645\u0646 B+ \u0625\u0644\u0649 A-. \u0623\u0646\u062a \u0644\u064a\u0634 \u0644\u0633\u0627 \u0645\u0627 \u062c\u0631\u0628\u062a\u061f",
    "\u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u064a\u0647 \u062e\u0627\u0635\u064a\u0629 '\u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0623\u0637\u0631\u0648\u062d\u0629 \u0627\u0644\u0630\u0643\u064a\u0629'. \u062a\u0641\u062a\u062d\u0647\u0627\u060c \u062a\u0643\u062a\u0628 \u0645\u0648\u0636\u0648\u0639\u0643\u060c \u0648\u062a\u0636\u063a\u0637 \u0632\u0631. \u0628\u0639\u062f 10 \u062f\u0642\u0627\u0626\u0642 \u0639\u0646\u062f\u0643 \u0623\u0637\u0631\u0648\u062d\u0629 \u0643\u0627\u0645\u0644\u0629 \u0628\u0645\u0631\u0627\u062c\u0639 APA \u0623\u0648 MLA \u0623\u0648 \u0634\u064a\u0643\u0627\u063a\u0648. \u062d\u062a\u0649 \u0627\u0644\u0646\u0635\u0648\u0635 \u062a\u0637\u0644\u0639 \u0637\u0628\u064a\u0639\u064a\u0629\u060c \u0645\u0627 \u062a\u0646\u0643\u0634\u0641 \u0641\u064a Turnitin \u0623\u0648 GPTZero. \u062c\u0631\u0628\u0647\u0627 \u0645\u0631\u0629 \u0648\u062d\u062f\u0629\u060c \u0648\u0634\u0648\u0641 \u0627\u0644\u0641\u0631\u0642.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062d\u064a\u0646\u060c \u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u062e\u0627\u0635\u064a\u0629 '\u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0623\u0637\u0631\u0648\u062d\u0629 \u0627\u0644\u0630\u0643\u064a\u0629'\u060c \u0648\u062c\u0631\u0628\u0647\u0627 \u0639\u0644\u0649 \u0645\u0648\u0636\u0648\u0639\u0643 \u0627\u0644\u0642\u0627\u062f\u0645. \u0645\u0648 \u0644\u0627\u0632\u0645 \u062a\u0643\u062a\u0628 \u0643\u0644\u0634\u064a\u060c \u0641\u0642\u0637 \u0627\u0628\u062f\u0623. P.S. \u0623\u0646\u0627 \u0645\u0627 \u0643\u0646\u062a \u062d\u0627\u0628\u0628 \u0623\u0631\u0633\u0644 \u0647\u0627\u0644\u0625\u064a\u0645\u064a\u0644\u060c \u0644\u0643\u0646 \u0627\u0644\u0641\u0631\u0642 \u0643\u0628\u064a\u0631 \u0644\u062f\u0631\u062c\u0629 \u0625\u0646\u0647 \u0645\u062d\u0631\u062c \u0625\u0646\u0643 \u0645\u0627 \u062a\u0633\u062a\u0641\u064a\u062f."
  ],
