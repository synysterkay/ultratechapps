  "subject": "10,000 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u093e \u0921\u0947\u091f\u093e \u2014 \u091a\u094c\u0902\u0915\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u092c\u093e\u0924",
  "preview_text": "\u0939\u092e\u0928\u0947 10,000 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u092c\u093e\u0938 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u093f\u092f\u093e\u0964 63 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u092c\u093e\u0926 \u091c\u094b \u0938\u091a \u0938\u093e\u092e\u0928\u0947 \u0906\u092f\u093e, \u0935\u094b \u0906\u092a\u0915\u094b \u0939\u0948\u0930\u093e\u0928 \u0915\u0930 \u0926\u0947\u0917\u093e\u0964",
  "body_paragraphs": [
    "\u092f\u0947 \u0938\u0941\u0928\u094b\u0964 \u0939\u092e\u0928\u0947 10,000 Bass Booster \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u093e \u0921\u0947\u091f\u093e \u0916\u0902\u0917\u093e\u0932\u093e\u0964 63 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u092c\u093e\u0926 \u091c\u094b \u092a\u0948\u091f\u0930\u094d\u0928 \u0928\u093f\u0915\u0932\u093e, \u0935\u094b \u0939\u092e\u0947\u0902 \u092d\u0940 \u0928\u0939\u0940\u0902 \u092a\u0924\u093e \u0925\u093e\u0964 78% \u0932\u094b\u0917 \u091c\u094b \u092a\u0939\u0932\u0947 14 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 Bass Boost slider \u0915\u094b 50% \u0938\u0947 \u090a\u092a\u0930 \u0932\u0947 \u0917\u090f, \u0935\u0947 2 \u092e\u0939\u0940\u0928\u0947 \u092c\u093e\u0926 \u092d\u0940 \u0910\u092a \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u0930\u0939\u0947 \u0925\u0947\u0964 \u092c\u093e\u0915\u0940 \u0915\u0947 22% \u0928\u0947 \u0910\u092a \u0915\u094b \u091b\u094b\u0921\u093c \u0926\u093f\u092f\u093e\u0964 \u092e\u0924\u0932\u092c, \u091c\u093f\u0924\u0928\u093e \u091c\u093c\u094b\u0930 \u0938\u0947 \u092c\u093e\u0938 \u092c\u0922\u093c\u093e\u0913\u0917\u0947, \u0909\u0924\u0928\u0940 \u0939\u0940 \u0917\u0939\u0930\u0940 \u0932\u0924 \u0932\u0917\u0947\u0917\u0940\u0964",
    "\u0924\u094b \u092f\u0947 \u0915\u094b\u0908 \u092e\u0948\u091c\u093f\u0915 \u0928\u0939\u0940\u0902\u0964 \u092f\u0947 \u0938\u093e\u0907\u0902\u0938 \u0939\u0948\u0964 \u091c\u092c \u0924\u0941\u092e \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u0947 \u0938\u094d\u092a\u0940\u0915\u0930 \u092f\u093e \u0908\u092f\u0930\u092c\u0921\u094d\u0938 \u092a\u0930 \u092c\u093e\u0938 \u0915\u094b \u092b\u0940\u0932 \u0915\u0930\u0924\u0947 \u0939\u094b, \u0924\u094b \u0926\u093f\u092e\u093e\u0917 \u0915\u093e \u0935\u0939\u0940 \u0939\u093f\u0938\u094d\u0938\u093e \u091c\u093e\u0917\u0924\u093e \u0939\u0948 \u091c\u094b \u0905\u0938\u0932\u0940 \u0938\u092c\u0935\u0942\u092b\u0930 \u0938\u0941\u0928\u0928\u0947 \u092a\u0930 \u091c\u093e\u0917\u0924\u093e \u0939\u0948\u0964 \u0939\u092e\u093e\u0930\u0947 \u0921\u0947\u091f\u093e \u0928\u0947 \u0938\u093e\u092c\u093f\u0924 \u0915\u093f\u092f\u093e \u0915\u093f \u091c\u094b \u0932\u094b\u0917 Bass Boost \u0915\u094b \u090f\u0915 \u092c\u093e\u0930 70% \u0938\u0947 \u090a\u092a\u0930 \u0932\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0935\u093e\u092a\u0938 \u0932\u094c\u091f\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092b\u094d\u0932\u0948\u091f, \u092c\u0947\u091c\u093e\u0928 \u0906\u0935\u093e\u091c\u093c \u0905\u092c \u092c\u0930\u094d\u0926\u093e\u0936\u094d\u0924 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940\u0964",
    "\u0914\u0930 \u092f\u0939\u0940 \u0939\u0948 \u0939\u092e\u093e\u0930\u093e Bass Virtualizer \u092b\u0940\u091a\u0930\u0964 \u092f\u0947 \u0938\u093f\u0930\u094d\u092b\u093c \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0928\u0939\u0940\u0902 \u092c\u0922\u093c\u093e\u0924\u093e, \u092c\u0932\u094d\u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0908\u092f\u0930\u092c\u0921\u094d\u0938 \u092e\u0947\u0902 \u0921\u094d\u0930\u0949\u092a \u0915\u094b \u0910\u0938\u0947 \u092b\u0940\u0932 \u0915\u0930\u093e\u0924\u093e \u0939\u0948 \u091c\u0948\u0938\u0947 \u0924\u0941\u092e \u0915\u094d\u0932\u092c \u092e\u0947\u0902 \u0916\u0921\u093c\u0947 \u0939\u094b\u0964 10-\u092c\u0948\u0902\u0921 EQ \u0915\u0947 \u0938\u093e\u0925 \u092e\u093f\u0932\u0915\u0930 \u092f\u0947 \u0939\u0930 Hip-Hop, EDM \u092f\u093e Rock \u091f\u094d\u0930\u0948\u0915 \u0915\u094b \u091c\u093c\u093f\u0902\u0926\u093e \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u2014 Boost slider \u0915\u094b \u0926\u093e\u090f\u0902 \u0918\u0938\u0940\u091f\u094b\u0964 \u092b\u093f\u0930 \u092c\u0924\u093e\u0928\u093e \u0915\u0948\u0938\u093e \u0932\u0917\u093e\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b\u0964 Bass Boost slider \u0915\u094b 70% \u0938\u0947 \u090a\u092a\u0930 \u0932\u0947 \u091c\u093e\u0913\u0964 \u0905\u092a\u0928\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u093e \u0932\u0917\u093e\u0913\u0964 \u092b\u093f\u0930 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0928\u093e \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u091b\u093e\u0924\u0940 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u0939\u0941\u0906\u0964 P.S. \u2014 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u092a\u0930 Unlimited Boost \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u0939\u092e\u093e\u0930\u0947 9,000 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0905\u092d\u0940 \u0907\u0938\u0940 \u092a\u0932 \u092c\u0942\u0938\u094d\u091f \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e \u0915\u0939\u093e\u0901 \u0939\u094b?"
