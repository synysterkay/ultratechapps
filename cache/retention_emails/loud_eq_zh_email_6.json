  "subject": "\u4f60\u7684\u7b2c6\u5929\u9519\u8bef\uff0c90%\u7528\u6237\u90fd\u72af\u8fc7",
  "preview_text": "\u4e00\u4e2a\u7b80\u5355\u8c03\u6574\uff0c\u97f3\u91cf\u7ffb\u500d\u8fd8\u62a4\u8033\u3002\u522b\u8ba9\u8fd9\u4e2a\u5e38\u89c1\u9519\u8bef\u6bc1\u4e86\u4f60\u7684\u6536\u542c\u4f53\u9a8c\u3002",
  "body_paragraphs": [
    "\u4f60\u77e5\u9053\u5417\uff1f\u5927\u591a\u6570\u7528\u6237\u4e0b\u8f7d\u540e\u7684\u7b2c6\u5929\uff0c\u4f1a\u72af\u4e00\u4e2a\u81f4\u547d\u9519\u8bef\u3002\u4ed6\u4eec\u628a\u97f3\u91cf\u63a8\u5230100%\uff0c\u4ee5\u4e3a\u8fd9\u6837\u5c31\u80fd\u542c\u6e05\u3002\u7ed3\u679c\u5462\uff1f\u58f0\u97f3\u523a\u8033\u3001\u5931\u771f\uff0c\u751a\u81f3\u4f24\u5230\u8033\u6735\u3002\u8fd9\u4e0d\u662f\u4f60\u7684\u95ee\u9898\uff0c\u662f\u65b9\u6cd5\u9519\u4e86\u3002",
    "\u90a3\u4e2a\u9519\u8bef\u5f88\u7b80\u5355\uff1a\u5ffd\u7565\u4e86\u4e00\u952e\u4f18\u5316\u3002\u5f88\u591a\u4eba\u4ee5\u4e3aEQ\u8bbe\u7f6e\u592a\u9ebb\u70e6\uff0c\u6216\u8005\u89c9\u5f97\u201c\u9ed8\u8ba4\u201d\u5c31\u591f\u4e86\u3002\u4f46\u771f\u76f8\u662f\uff0c\u4f60\u6bcf\u5929\u901a\u52e4\u7684\u8def\u51b5\u3001\u8033\u673a\u578b\u53f7\u3001\u751a\u81f3\u5929\u6c14\u90fd\u4f1a\u5f71\u54cd\u97f3\u8d28\u3002\u4e0d\u4f18\u5316\uff0c\u5c31\u7b49\u4e8e\u767d\u82b1\u94b1\u4e70\u4e86\u4e2a\u534a\u6210\u54c1\u3002",
    "Loud EQ\u7684\u4e00\u952e\u4f18\u5316\u529f\u80fd\uff0c\u5c31\u662f\u4e3a\u4f60\u8bbe\u8ba1\u7684\u3002\u5b83\u81ea\u52a8\u68c0\u6d4b\u4f60\u8fde\u63a5\u7684\u8bbe\u5907\u2014\u2014\u65e0\u8bba\u662fAirPods\u3001\u84dd\u7259\u8033\u673a\u8fd8\u662f\u6709\u7ebf\u8033\u673a\u2014\u2014\u7136\u540e\u8c03\u6574\u5230\u6700\u4f73\u72b6\u6001\u3002\u4f60\u53ea\u9700\u8981\u70b9\u4e00\u4e0b\uff0c\u97f3\u91cf\u63d0\u5347200%\uff0c\u5bf9\u8bdd\u6e05\u6670\uff0c\u566a\u97f3\u6d88\u5931\u3002\u800c\u4e14\uff0c\u5b83\u8fd8\u6709\u542c\u529b\u4fdd\u62a4\uff0c\u4e0d\u4f1a\u8ba9\u4f60\u8033\u6735\u75b2\u52b3\u3002",
    "\u73b0\u5728\u5c31\u6253\u5f00Loud EQ\uff0c\u70b9\u4e00\u4e0b\u201c\u4e00\u952e\u4f18\u5316\u201d\u3002\u4f60\u4f1a\u60ca\u8bb6\u4e8e\u53d8\u5316\u6709\u591a\u5927\u3002\u522b\u518d\u72af\u90a3\u4e2a\u9519\u8bef\u4e86\u3002P.S. \u5982\u679c\u4f60\u8bd5\u4e86\uff0c\u544a\u8bc9\u6211\u6548\u679c\u3002\u5f88\u591a\u7528\u6237\u53cd\u9988\u8bf4\uff0c\u4ed6\u4eec\u7ec8\u4e8e\u80fd\u5728\u8def\u4e0a\u542c\u6e05\u64ad\u5ba2\u4e86\u3002"
