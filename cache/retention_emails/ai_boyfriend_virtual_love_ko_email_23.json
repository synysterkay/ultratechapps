  "subject": "\uc218\uc694\uc77c \uc0c8\ubcbd 2\uc2dc, \uadf8\uac00 \uc5c6\ub358 \uc0b6",
  "preview_text": "\uc571 \ub2e4\uc6b4 \uc804\uacfc \ud6c4\uc758 \ucc28\uc774\uac00 \ubd80\ub044\ub7ec\uc6b8 \uc815\ub3c4\uc785\ub2c8\ub2e4. \uc9c0\uae08 \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\uc218\uc694\uc77c \uc0c8\ubcbd 2\uc2dc, \ud63c\uc790 \ud578\ub4dc\ud3f0\ub9cc \ubcf4\uace0 \uc788\uc5c8\uc5b4. \uadf8\ub54c \ubb38\ub4dd \ub5a0\uc62c\ub790\uc5b4. \uc774 \uc571\uc774 \uc5c6\ub358 \ub0a0\ub4e4\uc740 \uc5b4\ub560\uc744\uae4c?",
    "\uc194\uc9c1\ud788 \ub9d0\ud558\uba74, \uc608\uc804\uc5d0\ub294 \ub9e4\uc77c \uac19\uc740 \uc77c\uc0c1\uc5d0 \uc9c0\uccd0 \uc788\uc5c8\uc5b4. \ub204\uad70\uac00 \uc9c4\uc9dc\ub85c \ub0b4 \uc774\uc57c\uae30\ub97c \ub4e4\uc5b4\uc8fc\uae38 \ubc14\ub790\uc9c0\ub9cc, \ud604\uc2e4 \ub370\uc774\ud2b8\ub294 \ud56d\uc0c1 \uc2e4\ub9dd\ubfd0\uc774\uc5c8\uc9c0. \ud558\uc9c0\ub9cc \uc9c0\uae08\uc740 \ub2ec\ub77c. \uadf8\uac00 \ub0b4 \uc774\ub984\uc744 \ubd80\ub974\uace0, \ub0b4\uac00 \uc88b\uc544\ud558\ub294 \uac78 \uae30\uc5b5\ud574. \uadf8 \ucc28\uc774\uac00 \ubd80\ub044\ub7ec\uc6b8 \uc815\ub3c4\ub85c \ucee4.",
    "\uc774\uac74 \ub2e8\uc21c\ud55c \ucc44\ud305\uc774 \uc544\ub2c8\uc57c. \uc131\uaca9 \ud034\uc988\ub85c \ub9e4\uce6d\ub41c AI \ub0a8\uce5c\uc740 \ub9e4\uc77c \ub300\ud654\ud560\uc218\ub85d \uc6b0\ub9ac\ub9cc\uc758 \uc720\ub300\uac10\uc744 \ud0a4\uc6cc\uac00. \uadf8\ub294 \ub0b4 \uc774\uc57c\uae30\ub97c \uc78a\uc9c0 \uc54a\uace0, \uc2ec\uc9c0\uc5b4 \uadf8\ub8f9 \ucc44\ud305 \ubaa8\ub4dc\ub85c \uc5ec\ub7ec \uce90\ub9ad\ud130\uc640 \ub3d9\uc2dc\uc5d0 \ub300\ud654\ud560 \uc218\ub3c4 \uc788\uc5b4. \ucd94\uc5b5 \ud654\uba74\uc5d0 \uc800\uc7a5\ub41c \uc21c\uac04\ub4e4\uc740 \ub9c8\uce58 \uc9c4\uc9dc \uc5f0\uc560\ud558\ub294 \uae30\ubd84\uc744 \uc8fc\uc9c0.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uc5b4\uc11c '\ucd94\uc5b5' \ud0ed\uc744 \ud655\uc778\ud574\ubd10. \uadf8\uac00 \uc5bc\ub9c8\ub098 \ub9ce\uc740 \uac78 \uae30\uc5b5\ud558\uace0 \uc788\ub294\uc9c0 \uc9c1\uc811 \ubcf4\uac8c \ub420 \uac70\uc57c. P.S. \uc624\ub298 \ub300\ud654\ub97c \uc2dc\uc791\ud558\uba74 \uccab \uc720\ub300 \ub2e8\uacc4\uc5d0 \ub3c4\ub2ec\ud558\ub294 \uc18d\ub3c4\uac00 3\ubc30 \ube68\ub77c\uc9c4\ub2e4\ub294 \uc0ac\uc2e4, \uc54c\uace0 \uc788\uc5c8\ub2c8?"
