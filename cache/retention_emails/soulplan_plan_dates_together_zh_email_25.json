{
  "subject": "\u6211\u53d1\u73b0\u4e86\u4f60\u4eec\u6700\u4e0d\u8be5\u7528\u7684\u529f\u80fd",
  "preview_text": "\u6709\u7528\u6237\u7528\u5b83\u505a\u4e86\u4ef6\u75af\u72c2\u7684\u4e8b\uff0c\u8fde\u6211\u4eec\u5f00\u53d1\u56e2\u961f\u90fd\u6ca1\u60f3\u5230\u3002\u770b\u5b8c\u4f60\u4f1a\u60f3\u7acb\u523b\u6253\u5f00 app\u3002",
  "body_paragraphs": [
    "\u4e0a\u5468\uff0c\u4e00\u4f4d\u7528\u6237\u79c1\u4fe1\u6211\u4eec\uff0c\u8bf4\u5979\u548c\u4f34\u4fa3\u7528 SoulPlan \u7684\u2018\u60ca\u559c\u89c4\u5212\u5668\u2019\u6765\u7b56\u5212\u4e86\u4e00\u573a\u2018\u5206\u624b\u6a21\u62df\u2019\u7ea6\u4f1a\u3002\u4e0d\u662f\u771f\u7684\u5206\u624b\uff0c\u800c\u662f\u5047\u88c5\u4ece\u96f6\u5f00\u59cb\u91cd\u65b0\u8ba4\u8bc6\u5bf9\u65b9\uff0c\u91cd\u65b0\u7ea6\u4f1a\u3002\u8bf4\u5b9e\u8bdd\uff0c\u6211\u7b2c\u4e00\u53cd\u5e94\u662f\u2018\u8fd9\u73a9\u6cd5\u4e5f\u592a\u91ce\u4e86\u2019\uff0c\u4f46\u542c\u5b8c\u7ec6\u8282\uff0c\u6211\u6c89\u9ed8\u4e86\u3002",
    "\u4ed6\u4eec\u6545\u610f\u9009\u4e86\u81ea\u5df1\u4ece\u6ca1\u5c1d\u8bd5\u8fc7\u7684\u5174\u8da3\u6807\u7b7e\u2014\u2014\u6bd4\u5982\u5979\u9009\u2018\u6500\u5ca9\u2019\uff0c\u4ed6\u9009\u2018\u9676\u827a\u2019\u2014\u2014\u7136\u540e\u8ba9\u5bf9\u65b9\u6839\u636e\u8fd9\u4e9b\u964c\u751f\u4eba\u8bbe\u6765\u7b56\u5212\u7ea6\u4f1a\u3002\u7ed3\u679c\u5462\uff1f\u90a3\u665a\u4ed6\u4eec\u804a\u4e86\u56db\u4e2a\u5c0f\u65f6\uff0c\u597d\u50cf\u56de\u5230\u4e86\u7b2c\u4e00\u6b21\u7ea6\u4f1a\u3002\u5979\u544a\u8bc9\u6211\uff1a\u2018\u6211\u4eec\u4ee5\u4e3a\u6ca1\u65b0\u9c9c\u611f\u4e86\uff0c\u5176\u5b9e\u662f\u5fd8\u4e86\u600e\u4e48\u597d\u5947\u5bf9\u65b9\u3002\u2019",
    "\u8fd9\u4e2a\u7528\u6cd5\u5b8c\u5168\u51fa\u4e4e\u6211\u4eec\u610f\u6599\u3002\u2018\u60ca\u559c\u89c4\u5212\u5668\u2019\u539f\u672c\u662f\u8ba9\u4e00\u65b9\u6084\u6084\u9009\u597d\u6d3b\u52a8\uff0c\u7ed9\u5bf9\u65b9\u4e00\u4e2a\u60ca\u559c\u3002\u4f46\u5b83\u4e5f\u53ef\u4ee5\u7528\u6765\u2018\u91cd\u7f6e\u2019\u4f60\u4eec\u7684\u7ea6\u4f1a\u6a21\u5f0f\u3002\u4f60\u53ea\u9700\u5728\u89c4\u5212\u65f6\uff0c\u6682\u65f6\u5ffd\u7565\u719f\u6089\u7684\u504f\u597d\uff0c\u9009\u4e00\u4e9b\u4f60\u4ece\u6ca1\u60f3\u8fc7\u4f1a\u559c\u6b22\u7684\u4e1c\u897f\u3002\u7136\u540e\u8ba9 app \u751f\u6210\u4e00\u4e2a\u5b8c\u5168\u964c\u751f\u7684\u7ea6\u4f1a\u3002",
    "\u4eca\u5929\uff0c\u8bd5\u7740\u6253\u5f00 SoulPlan\uff0c\u7528\u2018\u60ca\u559c\u89c4\u5212\u5668\u2019\u9009\u4e09\u4e2a\u4f60\u5e73\u65f6\u7edd\u5bf9\u4e0d\u4f1a\u78b0\u7684\u5174\u8da3\u6807\u7b7e\u3002\u770b\u770b app \u4f1a\u7ed9\u4f60\u4ec0\u4e48\u63d0\u6848\u3002\u4f60\u53ef\u80fd\u4f1a\u53d1\u73b0\uff0c\u4f60\u4eec\u7684\u7231\u60c5\u8fd8\u6709\u592a\u591a\u6ca1\u89e3\u9501\u7684\u73a9\u6cd5\u3002P.S. \u4e00\u4f4d\u7528\u6237\u8bf4\uff0c\u8fd9\u62db\u751a\u81f3\u6bd4\u521d\u6b21\u7ea6\u4f1a\u8fd8\u523a\u6fc0\u3002\u8bd5\u8bd5\u770b\uff0c\u7136\u540e\u544a\u8bc9\u6211\u7ed3\u679c\u3002"
  ],
