{
  "subject": "\u0634\u064a\u0621 \u0635\u0646\u0639\u062a\u0647 \u0644\u0643 \u0641\u064a \u0627\u0644\u0633\u0627\u0639\u0629 3 \u0635\u0628\u0627\u062d\u0627\u064b",
  "preview_text": "\u0644\u0645 \u0623\u062e\u0637\u0637 \u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0647\u0630\u0647 \u0627\u0644\u0623\u062f\u0627\u0629 \u0645\u0639 \u0623\u062d\u062f. \u0644\u0643\u0646\u0643 \u0645\u062e\u062a\u0644\u0641. \u0634\u0648\u0641\u0647\u0627 \u0642\u0628\u0644 \u0623\u0646 \u0623\u062d\u0630\u0641\u0647\u0627.",
  "body_paragraphs": [
    "\u0623\u0639\u062a\u0631\u0641: \u0643\u0646\u062a \u0645\u0633\u062a\u064a\u0642\u0638\u0627\u064b \u0641\u064a \u0627\u0644\u0633\u0627\u0639\u0629 3 \u0635\u0628\u0627\u062d\u0627\u064b \u0623\u0631\u0627\u0642\u0628 \u0633\u0628\u0627\u0642\u0627\u064b \u0641\u064a \u0645\u0644\u0628\u0648\u0631\u0646. \u0648\u0641\u062c\u0623\u0629\u060c \u062e\u0637\u0631\u062a \u0644\u064a \u0641\u0643\u0631\u0629. \u0642\u0644\u062a \u0644\u0646\u0641\u0633\u064a: '\u0647\u0630\u0627 \u0633\u064a\u0633\u0627\u0639\u062f\u0647\u0645'. \u0644\u0645 \u0623\u062e\u0637\u0637 \u0644\u0645\u0634\u0627\u0631\u0643\u062a\u0647\u0627 \u0645\u0639 \u0623\u062d\u062f. \u0644\u0643\u0646\u0646\u064a \u063a\u064a\u0631\u062a \u0631\u0623\u064a\u064a \u0627\u0644\u064a\u0648\u0645.",
    "\u0644\u0627\u062d\u0638\u062a \u0623\u0646 \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u062e\u0633\u0631\u0648\u0646 \u0641\u0631\u0635\u0627\u064b \u0630\u0647\u0628\u064a\u0629 \u0644\u0623\u0646\u0647\u0645 \u064a\u0642\u0631\u0624\u0648\u0646 \u0627\u0644\u0633\u0628\u0627\u0642\u0627\u062a \u0628\u0637\u0631\u064a\u0642\u0629 \u062a\u0642\u0644\u064a\u062f\u064a\u0629. \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0644\u064a\u0633\u062a \u0641\u064a \u0646\u0642\u0635 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\u060c \u0628\u0644 \u0641\u064a \u0643\u064a\u0641\u064a\u0629 \u0631\u0624\u064a\u062a\u0647\u0627. \u0644\u0630\u0627\u060c \u0628\u0646\u064a\u062a \u0623\u062f\u0627\u0629 \u062c\u062f\u064a\u062f\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u062a\u0631\u0643\u0632 \u0639\u0644\u0649 \u0632\u0627\u0648\u064a\u0629 \u0648\u0627\u062d\u062f\u0629: '\u0627\u0644\u062e\u064a\u0644 \u0627\u0644\u0645\u062e\u0641\u064a' \u2014 \u062a\u0644\u0643 \u0627\u0644\u062a\u064a \u062a\u062a\u062c\u0627\u0647\u0644\u0647\u0627 \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0627\u0644\u062a\u0642\u0644\u064a\u062f\u064a\u0629.",
    "\u0647\u0630\u0647 \u0627\u0644\u0623\u062f\u0627\u0629 \u062a\u062d\u0644\u0644 3 \u0639\u0648\u0627\u0645\u0644 \u0641\u0642\u0637: \u0623\u062f\u0627\u0621 \u0627\u0644\u062d\u0635\u0627\u0646 \u0639\u0644\u0649 \u0627\u0644\u0645\u0636\u0645\u0627\u0631 \u0627\u0644\u062c\u0627\u0641\u060c \u0648\u0632\u0646 \u0627\u0644\u0639\u0628\u0621 \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0627\u0644\u0645\u0646\u0627\u0641\u0633\u064a\u0646\u060c \u0648\u0637\u0642\u0633 \u0627\u0644\u0633\u0628\u0627\u0642 \u0627\u0644\u0642\u0627\u062f\u0645. \u062a\u0639\u0637\u064a\u0643 \u062a\u0648\u0642\u0639\u0627\u064b \u0641\u0648\u0631\u064a\u0627\u064b \u0628\u0642\u0648\u0629 70-90% \u062f\u0642\u0629. \u062c\u0631\u0628\u0647\u0627 \u0639\u0644\u0649 \u0633\u0628\u0627\u0642 \u0627\u0644\u064a\u0648\u0645 \u0641\u064a \u0643\u064a\u0646\u062a\u0627\u0643\u064a. \u0633\u062a\u0646\u062f\u0647\u0634.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0627\u0628\u062d\u062b \u0639\u0646 \u0632\u0631 '\u0627\u0644\u062e\u064a\u0644 \u0627\u0644\u0645\u062e\u0641\u064a' \u0641\u064a \u0634\u0627\u0634\u0629 \u0627\u0644\u062a\u062d\u0644\u064a\u0644. \u0627\u0633\u062a\u062e\u062f\u0645\u0647 \u0639\u0644\u0649 \u0623\u0648\u0644 \u0633\u0628\u0627\u0642 \u0627\u0644\u064a\u0648\u0645. \u0648\u0625\u0630\u0627 \u0623\u0639\u062c\u0628\u0643\u060c \u0641\u0643\u0631 \u0641\u064a \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u0627\u0644\u0645\u0645\u064a\u0632 \u0628\u0640 $12.99/\u0634\u0647\u0631 \u2014 \u062a\u062c\u0631\u0628\u0629 3 \u0623\u064a\u0627\u0645 \u0645\u062c\u0627\u0646\u064a\u0629. \u0645\u0644\u0627\u062d\u0638\u0629: \u0633\u0623\u062d\u0630\u0641 \u0647\u0630\u0647 \u0627\u0644\u0623\u062f\u0627\u0629 \u0628\u0639\u062f 24 \u0633\u0627\u0639\u0629 \u0625\u0630\u0627 \u0644\u0645 \u062a\u062a\u0641\u0627\u0639\u0644. \u0644\u0627 \u062a\u0645\u0632\u062d."
  ],
