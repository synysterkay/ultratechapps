{
  "subject": "\u0422\u0432\u043e\u0439 \u0431\u0438\u0442 \u0437\u0432\u0443\u0447\u0438\u0442 \u043f\u043b\u043e\u0441\u043a\u043e \u2014 \u0432\u043e\u0442 \u0444\u0438\u043a\u0441 \u0437\u0430 10 \u0441\u0435\u043a\u0443\u043d\u0434",
  "preview_text": "\u041e\u0434\u0438\u043d \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0442\u0432\u043e\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438 \u0432 \u0441\u0430\u0431\u0432\u0443\u0444\u0435\u0440. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441.",
  "body_paragraphs": [
    "\u0422\u044b \u0441\u043a\u0430\u0447\u0430\u043b Bass Booster, \u043d\u043e \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043d\u0435 \u0443\u0441\u043b\u044b\u0448\u0430\u043b \u0440\u0430\u0437\u043d\u0438\u0446\u0443? \u042f \u0437\u043d\u0430\u044e, \u0432 \u0447\u0435\u043c \u0434\u0435\u043b\u043e. \u0422\u0432\u043e\u0439 \u0442\u0440\u0435\u043a \u0437\u0432\u0443\u0447\u0438\u0442 \u043a\u0430\u043a \u0438\u0437 \u043a\u0430\u0440\u0442\u043e\u043d\u043d\u043e\u0439 \u043a\u043e\u0440\u043e\u0431\u043a\u0438 \u2014 \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0442\u044b \u043d\u0435 \u0442\u0440\u043e\u043d\u0443\u043b \u043e\u0434\u0438\u043d \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a.",
    "\u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0443 10 \u043f\u043e\u043b\u043e\u0441 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440\u0430. \u042d\u0442\u043e \u043f\u0440\u043e \u043e\u0434\u043d\u0443 \u0448\u0442\u0443\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u0437\u0430 \u0441\u0435\u043a\u0443\u043d\u0434\u0443 \u0438 \u043c\u0435\u043d\u044f\u0435\u0442 \u0432\u0441\u0451. \u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044c: \u0442\u044b \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0448\u044c \u0442\u0440\u0435\u043a \u2014 \u0438 \u0431\u0430\u0441 \u0431\u044c\u0451\u0442 \u043d\u0435 \u043f\u043e \u0443\u0448\u0430\u043c, \u0430 \u0432 \u0433\u0440\u0443\u0434\u044c. \u0414\u0430\u0436\u0435 \u043d\u0430 \u0434\u0435\u0448\u0451\u0432\u044b\u0445 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u0445.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043d\u0430\u0439\u0434\u0438 \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a \"Boost\" \u0432\u043d\u0438\u0437\u0443 \u044d\u043a\u0440\u0430\u043d\u0430. \u041f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0442\u044f\u043d\u0438 \u0435\u0433\u043e \u0432\u043f\u0440\u0430\u0432\u043e \u0434\u043e \u0443\u043f\u043e\u0440\u0430. \u0412\u0441\u0451. \u0422\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0437\u0432\u0443\u0447\u0438\u0442 \u043f\u043b\u043e\u0441\u043a\u043e. \u041a\u0430\u0436\u0434\u044b\u0439 \u0443\u0434\u0430\u0440 \u0431\u043e\u0447\u043a\u0438 \u2014 \u044d\u0442\u043e \u0443\u0434\u0430\u0440 \u043f\u043e \u0442\u0432\u043e\u0438\u043c \u043a\u043e\u043b\u043e\u043d\u043a\u0430\u043c. Hip-Hop, EDM, \u0440\u043e\u043a \u2014 \u043b\u044e\u0431\u043e\u0439 \u0436\u0430\u043d\u0440 \u0437\u0430\u0438\u0433\u0440\u0430\u0435\u0442 \u043f\u043e-\u043d\u043e\u0432\u043e\u043c\u0443.",
    "\u0421\u0434\u0435\u043b\u0430\u0439 \u044d\u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041e\u0442\u043a\u0440\u043e\u0439 Bass Booster, \u0432\u043a\u043b\u044e\u0447\u0438 \u043b\u044e\u0431\u043e\u0439 \u0442\u0440\u0435\u043a \u0438 \u043f\u043e\u0434\u0432\u0438\u043d\u044c Boost \u0432\u043f\u0440\u0430\u0432\u043e. \u041f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0439 \u0440\u0430\u0437\u043d\u0438\u0446\u0443. P.S. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u0435\u0449\u0451 \u0431\u043e\u043b\u044c\u0448\u0435 \u0431\u0430\u0441\u0430 \u2014 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u043f\u0440\u0435\u043c\u0438\u0443\u043c. \u0422\u0430\u043c \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d, \u0438 \u0431\u0430\u0441 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u0435\u0437\u0443\u043c\u043d\u044b\u043c."
