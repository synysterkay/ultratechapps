{
  "subject": "\u042f \u0437\u0440\u043e\u0431\u0438\u0432 \u0432\u0435\u043b\u0438\u0447\u0435\u0437\u043d\u0443 \u043f\u043e\u043c\u0438\u043b\u043a\u0443 \u0437 \u0446\u0438\u043c \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u043c",
  "preview_text": "\u0412\u0438 \u0434\u0443\u043c\u0430\u0454\u0442\u0435, \u0449\u043e \u0437\u043d\u0430\u0454\u0442\u0435 \u0444\u0443\u0442\u0431\u043e\u043b? \u042f \u0442\u0435\u0436 \u0442\u0430\u043a \u0434\u0443\u043c\u0430\u0432, \u043f\u043e\u043a\u0438 \u043d\u0435 \u043f\u043e\u0431\u0430\u0447\u0438\u0432 \u043f\u0440\u0430\u0432\u0434\u0443. \u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435, \u0449\u043e\u0431 \u0434\u0456\u0437\u043d\u0430\u0442\u0438\u0441\u044f, \u0447\u043e\u043c\u0443 90% \u0444\u0430\u043d\u0430\u0442\u0456\u0432 \u043f\u043e\u043c\u0438\u043b\u044f\u044e\u0442\u044c\u0441\u044f.",
  "body_paragraphs": [
    "\u042f \u0437\u0456\u0437\u043d\u0430\u044e\u0441\u044f: \u044f \u0434\u0443\u043c\u0430\u0432, \u0449\u043e \u0446\u0435\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0456\u0432. \u0410\u043b\u0435 \u0432\u0438\u044f\u0432\u0438\u043b\u043e\u0441\u044f, \u0449\u043e \u044f \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0432 \u043d\u0430\u0439\u0432\u0430\u0436\u043b\u0438\u0432\u0456\u0448\u0435 \u2014 \u044f \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447, \u044f \u0447\u0430\u0441\u0442\u0438\u043d\u0430 \u0447\u043e\u0433\u043e\u0441\u044c \u043d\u0430\u0431\u0430\u0433\u0430\u0442\u043e \u0431\u0456\u043b\u044c\u0448\u043e\u0433\u043e. \u041a\u043e\u043b\u0438 \u044f \u043f\u043e\u0431\u0430\u0447\u0438\u0432, \u044f\u043a \u043d\u0430\u0448\u0456 \u0434\u0430\u043d\u0456 \u0437\u043c\u0456\u043d\u044e\u044e\u0442\u044c \u0433\u0440\u0443 \u0434\u043b\u044f \u0442\u0438\u0441\u044f\u0447 \u0444\u0430\u043d\u0430\u0442\u0456\u0432 \u043f\u043e \u0432\u0441\u044c\u043e\u043c\u0443 \u0441\u0432\u0456\u0442\u0443, \u044f \u0437\u0440\u043e\u0437\u0443\u043c\u0456\u0432, \u0449\u043e \u043c\u0438 \u0431\u0443\u0434\u0443\u0454\u043c\u043e \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0443, \u044f\u043a\u0430 \u0437\u043c\u0456\u043d\u044e\u0454 \u0444\u0443\u0442\u0431\u043e\u043b.",
    "\u0423\u044f\u0432\u0456\u0442\u044c: \u0432\u0438 \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435 \u0433\u0430\u0434\u0430\u0454\u0442\u0435, \u0447\u0438 \u0432\u0430\u0440\u0442\u043e \u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u043d\u0430 \u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0443 \u00ab\u0411\u0430\u0440\u0441\u0435\u043b\u043e\u043d\u0438\u00bb. \u0423 \u0432\u0430\u0441 \u0454 AI, \u044f\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0454 \u0442\u0438\u0441\u044f\u0447\u0456 \u0437\u043c\u0456\u043d\u043d\u0438\u0445 \u2014 \u0432\u0456\u0434 xG \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u0434\u043e \u0442\u0430\u043a\u0442\u0438\u0447\u043d\u0438\u0445 \u0441\u0445\u0435\u043c \u0441\u0443\u043f\u0435\u0440\u043d\u0438\u043a\u0430. \u0412\u0438 \u0437\u043d\u0430\u0454\u0442\u0435, \u043a\u043e\u043b\u0438 \u0434\u043e\u0432\u0456\u0440\u044f\u0442\u0438 \u0456\u043d\u0442\u0443\u0457\u0446\u0456\u0457, \u0430 \u043a\u043e\u043b\u0438 \u2014 \u0434\u0430\u043d\u0438\u043c. \u0406 \u0446\u0435 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442, \u0446\u0435 \u0432\u0430\u0448\u0430 \u043f\u0435\u0440\u0435\u0432\u0430\u0433\u0430 \u0432 \u043a\u043e\u0436\u043d\u0456\u0439 \u0440\u043e\u0437\u043c\u043e\u0432\u0456 \u0437 \u0434\u0440\u0443\u0437\u044f\u043c\u0438.",
    "\u0410\u043b\u0435 \u0441\u043f\u0440\u0430\u0432\u0436\u043d\u0456\u0439 \u0441\u0435\u043a\u0440\u0435\u0442 \u2014 \u0446\u0435 \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0430. \u041c\u0438 \u0441\u0442\u0432\u043e\u0440\u0438\u043b\u0438 \u00ab\u0421\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0438\u00bb \u0442\u0430 \u00ab\u041f\u0440\u043e\u0433\u043d\u043e\u0437 \u0434\u043d\u044f\u00bb, \u0434\u0435 \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0433\u043e\u043b\u043e\u0441\u0443\u0432\u0430\u0442\u0438, \u043e\u0431\u0433\u043e\u0432\u043e\u0440\u044e\u0432\u0430\u0442\u0438 \u043c\u0430\u0442\u0447\u0456 \u0442\u0430 \u0434\u043e\u0432\u043e\u0434\u0438\u0442\u0438, \u0449\u043e \u0432\u0430\u0448 \u0444\u0443\u0442\u0431\u043e\u043b\u044c\u043d\u0438\u0439 IQ \u2014 \u043d\u0430\u0439\u0432\u0438\u0449\u0438\u0439. \u0406 \u043a\u043e\u043b\u0438 \u0432\u0438 \u0431\u0430\u0447\u0438\u0442\u0435, \u044f\u043a \u0432\u0430\u0448 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0441\u0442\u0430\u0454 \u043a\u0440\u0430\u0449\u0438\u043c \u0437\u0430 AI, \u0432\u0438 \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0442\u0435 \u0441\u0435\u0431\u0435 \u0447\u0430\u0441\u0442\u0438\u043d\u043e\u044e \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0456\u0457.",
    "\u0422\u043e\u043c\u0443 \u0437\u0440\u043e\u0431\u0456\u0442\u044c \u043a\u0440\u043e\u043a: \u0432\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0456 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u043d\u0430 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456\u0448\u043d\u0456\u0439 \u043c\u0430\u0442\u0447 \u041b\u0456\u0433\u0438 \u0447\u0435\u043c\u043f\u0456\u043e\u043d\u0456\u0432. \u041f\u043e\u0431\u0430\u0447\u0438\u0442\u0435, \u044f\u043a \u0434\u0430\u043d\u0456 \u0437\u043c\u0456\u043d\u044e\u044e\u0442\u044c \u0432\u0430\u0448\u0443 \u0433\u0440\u0443. P.S. \u042f\u043a\u0449\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u0431\u0435\u0437\u043b\u0456\u043c\u0456\u0442\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0432\u0441\u0456\u0445 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0456\u0432 \u0442\u0430 \u0430\u043d\u0430\u043b\u0456\u0442\u0438\u043a\u0438, \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 Premium \u0437\u0430 $12.99/\u043c\u0456\u0441 \u2014 \u043f\u0435\u0440\u0448\u0456 3 \u0434\u043d\u0456 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u043e. \u0410\u043b\u0435 \u043d\u0435 \u043a\u0430\u0436\u0456\u0442\u044c, \u0449\u043e \u044f \u0432\u0430\u0441 \u043d\u0435 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u0438\u0432."
