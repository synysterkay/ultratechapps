{
  "subject": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0915\u093e\u0928 53 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0915\u094d\u092f\u093e \u0938\u0941\u0928 \u0930\u0939\u0947 \u0925\u0947",
  "preview_text": "\u0935\u0939 \u0906\u0935\u093e\u091c\u093c \u091c\u094b \u0939\u0930 \u092c\u093e\u0930 HVAC \u092e\u0947\u0902 \u0921\u0942\u092c \u091c\u093e\u0924\u0940 \u0925\u0940, \u0905\u092c \u0938\u093e\u092b\u093c \u0939\u0948\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u0941\u0930\u093e\u0928\u093e \u0938\u0947\u091f\u0905\u092a \u0936\u0930\u094d\u092e\u093f\u0902\u0926\u093e \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "53 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947, \u0924\u0941\u092e Loudify \u0915\u0947 \u092c\u093f\u0928\u093e \u0925\u0947\u0964 \u092f\u093e\u0926 \u0939\u0948 \u0935\u0939 \u092a\u0932 \u091c\u092c \u0924\u0941\u092e\u0928\u0947 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0915\u094b \u092a\u0942\u0930\u093e \u092c\u0922\u093c\u093e\u092f\u093e, \u0914\u0930 \u0921\u093e\u092f\u0932\u0949\u0917 \u092b\u093f\u0930 \u092d\u0940 \u091f\u094d\u0930\u0947\u0928 \u0915\u0947 \u0936\u094b\u0930 \u092e\u0947\u0902 \u0917\u093e\u092f\u092c \u0939\u094b \u0917\u092f\u093e? \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 '\u0928\u0949\u0930\u094d\u092e\u0932' \u0932\u093e\u0907\u092b \u0925\u0940\u0964 \u0905\u092c \u0938\u094b\u091a\u094b: \u0924\u0941\u092e \u0915\u093f\u0924\u0928\u0940 \u092c\u093e\u0930 \u092c\u0938 '\u092c\u0922\u093c\u093f\u092f\u093e' \u0938\u0947\u091f\u093f\u0902\u0917 \u0938\u0947 \u0938\u0902\u0924\u0941\u0937\u094d\u091f \u0939\u094b \u0917\u090f, \u091c\u092c\u0915\u093f \u0905\u0938\u0932\u0940 \u0915\u094d\u0932\u0940\u0928\u093f\u091f\u0940 \u0914\u0930 \u0932\u093e\u0909\u0921\u0928\u0947\u0938 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0926\u0942\u0930 \u0925\u0940?",
    "\u092f\u0939 \u0905\u0902\u0924\u0930 \u0939\u0940 \u0936\u0930\u094d\u092e\u093f\u0902\u0926\u093e \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u0939\u0948\u0964 \u092c\u093f\u0928\u093e Loudify \u0915\u0947, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0939\u0930 \u092c\u093e\u0930 \u0935\u0939\u0940 \u092a\u0941\u0930\u093e\u0928\u0940 \u0915\u0939\u093e\u0928\u0940 \u0938\u0941\u0928\u093e\u0924\u0947 \u0925\u0947\u2014\u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0926\u0940\u0935\u093e\u0930 \u0938\u0947 \u091f\u0915\u0930\u093e\u0924\u093e, \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0906\u0924\u093e, \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0932\u0917\u0924\u093e \u0915\u093f \u092f\u0939\u0940 \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u092c? \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e AutoEQ \u0939\u0930 \u092c\u093e\u0930 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b\u0924\u0947 \u0939\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u094b \u092a\u0939\u091a\u093e\u0928\u0924\u093e \u0939\u0948\u0964 \u0935\u0939 +200% \u092c\u0942\u0938\u094d\u091f \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0939\u093e\u0930\u094d\u0936\u0928\u0947\u0938 \u0915\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0924\u0941\u092e \u0938\u093f\u0930\u094d\u092b\u093c '\u0938\u0941\u0928' \u0928\u0939\u0940\u0902 \u0930\u0939\u0947\u2014\u0924\u0941\u092e '\u091f\u094d\u092f\u0942\u0928' \u0915\u0930 \u0930\u0939\u0947 \u0939\u094b\u0964",
    "\u092f\u0939\u093e\u0901 \u0905\u0938\u0932\u0940 \u092c\u093e\u0924 \u0939\u0948: Loudify \u0915\u093e Sound DNA \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0939\u0930 \u0939\u092b\u093c\u094d\u0924\u0947 \u092c\u0924\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0924\u0941\u092e\u0928\u0947 \u0915\u0948\u0938\u0947 \u0938\u0941\u0928\u093e\u0964 \u0915\u094c\u0928 \u0938\u093e \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0938\u092c\u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0939\u0941\u0906? \u0915\u093f\u0924\u0928\u0940 \u092c\u093e\u0930 \u0924\u0941\u092e\u0928\u0947 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0915\u094b \u0905\u0938\u0932\u0940 \u0938\u0940\u092e\u093e \u0924\u0915 \u0927\u0915\u0947\u0932\u093e? \u092f\u0939 \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0928\u0939\u0940\u0902\u2014\u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924\u094b\u0902 \u0915\u093e \u0906\u0907\u0928\u093e \u0939\u0948\u0964 \u0914\u0930 Top Streaks \u0932\u0940\u0921\u0930\u092c\u094b\u0930\u094d\u0921? \u0935\u0939 \u0930\u094b\u091c\u093c\u093e\u0928\u093e \u0915\u0940 \u091c\u0935\u093e\u092c\u0926\u0947\u0939\u0940 \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0938\u0941\u0938\u094d\u0924 \u0928\u0939\u0940\u0902 \u092a\u0921\u093c\u0928\u0947 \u0926\u0947\u0924\u0940\u0964",
    "\u0905\u092c \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0930\u094b: Loudify \u0916\u094b\u0932\u094b \u0914\u0930 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u094b \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u094b\u0964 \u0926\u0947\u0916\u094b \u0915\u093f AutoEQ \u0924\u0941\u0930\u0902\u0924 \u0915\u0948\u0938\u0947 \u091f\u094d\u092f\u0942\u0928 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092b\u093f\u0930 \u090f\u0915 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u091a\u0941\u0928\u094b\u2014\u091a\u093e\u0939\u0947 \u092e\u094d\u092f\u0942\u091c\u093c\u093f\u0915 \u0939\u094b \u092f\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f\u2014\u0914\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0915\u094b +200% \u092a\u0930 \u0932\u0947 \u091c\u093e\u0913\u0964 \u092f\u0939 \u0935\u0939\u0940 \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0915\u093e\u0928 \u0939\u092e\u0947\u0936\u093e \u0938\u0947 \u091a\u093e\u0939\u0924\u0947 \u0925\u0947\u0964 P.S. \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u0941\u0930\u093e\u0928\u093e \u0938\u0947\u091f\u0905\u092a \u0905\u092c \u0924\u0941\u092e\u0915\u094b \u0936\u0930\u094d\u092e\u093f\u0902\u0926\u093e \u0915\u0930\u0947\u0917\u093e\u2014\u0932\u0947\u0915\u093f\u0928 \u092f\u0939 \u0920\u0940\u0915 \u0939\u0948, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0924\u0941\u092e \u0905\u092c \u092c\u0926\u0932 \u091a\u0941\u0915\u0947 \u0939\u094b\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0915\u0947 \u0938\u093e\u0925 \u092a\u0942\u0930\u0940 AutoEQ \u0932\u093e\u0907\u092c\u094d\u0930\u0947\u0930\u0940 \u0914\u0930 Sound DNA \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u094b\u2014\u092f\u0939\u0940 \u0905\u0938\u0932\u0940 \u092b\u0930\u094d\u0915 \u0939\u0948\u0964"
  ],
