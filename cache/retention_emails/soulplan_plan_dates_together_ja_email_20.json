  "body_paragraphs": [
    "\u3042\u306a\u305f\u306f\u3082\u3046\u521d\u5fc3\u8005\u3058\u3083\u306a\u3044\u300245\u65e5\u9593\u3001\u4e00\u7dd2\u306b\u65e5\u4ed8\u3092\u8a08\u753b\u3057\u3066\u304d\u305f\u3002\u3067\u3082\u3001\u307e\u3060\u898b\u305f\u3053\u3068\u306e\u306a\u3044\u6249\u304c\u3042\u308b\u3002\u305d\u308c\u306f\u300c\u30b5\u30d7\u30e9\u30a4\u30ba\u30c7\u30fc\u30c8\u30d7\u30e9\u30f3\u30ca\u30fc\u300d\u306e\u5965\u306b\u96a0\u308c\u305f\u3001\u30d1\u30fc\u30c8\u30ca\u30fc\u3092\u672c\u5f53\u306b\u9a5a\u304b\u305b\u308b\u6a5f\u80fd\u3002",
