    "\u4eca\u3059\u3050\u30a2\u30d7\u30ea\u3092\u958b\u3044\u3066\u3001\u300c\u30b5\u30d7\u30e9\u30a4\u30ba\u30d7\u30e9\u30f3\u300d\u3067\u65b0\u3057\u3044\u30c7\u30fc\u30c8\u3092\u4ed5\u639b\u3051\u3066\u307f\u3066\u3002\u30d1\u30fc\u30c8\u30ca\u30fc\u304c\u901a\u77e5\u3092\u898b\u305f\u6642\u306e\u9854\u3092\u60f3\u50cf\u3057\u3066\u3054\u3089\u3093\u3002\u305d\u306e\u77ac\u9593\u3001\u3042\u306a\u305f\u306f\u305f\u3060\u306e\u30e6\u30fc\u30b6\u30fc\u3067\u306f\u306a\u304f\u3001\u95a2\u4fc2\u306e\u30d7\u30ed\u30c7\u30e5\u30fc\u30b5\u30fc\u306b\u306a\u308b\u3002",
    "\u3053\u306e\u30e1\u30fc\u30eb\u3067\u30b7\u30ea\u30fc\u30ba\u306f\u7d42\u4e86\u3002\u3067\u3082\u3001\u3042\u306a\u305f\u306e\u65c5\u306f\u3053\u3053\u304b\u3089\u3002\u6700\u5f8c\u306b\u4e00\u3064\u3060\u3051\uff1a\u5fd8\u308c\u305a\u306b\u300c\u30c7\u30fc\u30c8\u5c65\u6b74\u300d\u3092\u898b\u8fd4\u3057\u3066\u3002\u3042\u306e\u6700\u9ad8\u306e\u591c\u3092\u518d\u73fe\u3067\u304d\u308b\u30d2\u30f3\u30c8\u304c\u96a0\u308c\u3066\u3044\u308b\u3002\u3055\u3042\u3001\u4eca\u3059\u3050\u884c\u52d5\u3092\u3002 P.S. \u3053\u306e\u30e1\u30fc\u30eb\u3092\u8aad\u3093\u3060\u3089\u3001\u30d1\u30fc\u30c8\u30ca\u30fc\u306b\u300c\u4eca\u65e5\u306f\u4ffa/\u79c1\u304c\u8a08\u753b\u3059\u308b\u300d\u3068\u8a00\u3063\u3066\u307f\u3066\u3002\u305d\u306e\u4e00\u8a00\u304c\u3001\u706b\u82b1\u3092\u518d\u3073\u71c3\u3048\u4e0a\u304c\u3089\u305b\u308b\u3002"
