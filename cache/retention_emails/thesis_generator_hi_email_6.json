{
  "subject": "\u0935\u094b 2 \u092c\u091c\u0947 \u0930\u093e\u0924 \u0915\u093e \u092e\u0948\u0938\u0947\u091c \u091c\u094b \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u0926\u0947\u0924\u093e \u0939\u0948",
  "preview_text": "\u091c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u091b\u093e\u0924\u094d\u0930 \u092f\u0939\u0940 \u0917\u0932\u0924\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092b\u093f\u0930 \u092a\u091b\u0924\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u094b \u092a\u0924\u093e \u0939\u0948 \u0915\u094d\u092f\u093e?",
  "body_paragraphs": [
    "\u0924\u0941\u092e\u0928\u0947 \u0915\u0932 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0925\u0940\u0938\u093f\u0938 \u0932\u093f\u0916\u0928\u0940 \u0936\u0941\u0930\u0942 \u0915\u0940, \u0939\u0948 \u0928? \u092e\u0948\u0902 \u091c\u093e\u0928\u0924\u093e \u0939\u0942\u0901 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092e\u0948\u0902\u0928\u0947 \u092d\u0940 \u0935\u0939\u0940 \u0915\u093f\u092f\u093e\u0964 \u092a\u0930 \u092f\u0939\u093e\u0901 \u090f\u0915 \u092c\u093e\u0924 \u0939\u0948 \u091c\u094b 90% \u091b\u093e\u0924\u094d\u0930 \u0917\u0932\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u2013 \u0935\u094b \u0938\u0940\u0927\u0947 \u0932\u093f\u0916\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902 \u092c\u093f\u0928\u093e \u0915\u094b\u0908 \u0938\u094d\u091f\u094d\u0930\u0915\u094d\u091a\u0930 \u092c\u0928\u093e\u090f\u0964 \u0914\u0930 \u092b\u093f\u0930 8 \u0918\u0902\u091f\u0947 \u092c\u093e\u0926 \u092d\u0940 \u092a\u0939\u0932\u093e \u092a\u0948\u0930\u093e\u0917\u094d\u0930\u093e\u092b \u0905\u0927\u0942\u0930\u093e \u0930\u0939 \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u092f\u0939 \u0928\u0902\u092c\u0930 \u0935\u0928 \u092e\u093f\u0938\u094d\u091f\u0947\u0915 \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0930\u093f\u091c\u0932\u094d\u091f\u094d\u0938 \u0915\u094b \u092c\u0930\u094d\u092c\u093e\u0926 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0924\u0941\u092e \u0938\u094b\u091a\u0924\u0947 \u0939\u094b \u0915\u093f \u0932\u093f\u0916\u0928\u093e \u0906\u0938\u093e\u0928 \u0939\u0948, \u092a\u0930 \u0905\u0938\u0932 \u092e\u0947\u0902 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092a\u0939\u0932\u0947 \u090f\u0915 \u092e\u091c\u092c\u0942\u0924 \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u091a\u093e\u0939\u093f\u090f\u0964 \u092c\u093f\u0928\u093e \u0909\u0938\u0915\u0947, \u0924\u0941\u092e \u092c\u0938 \u0905\u0902\u0927\u0947\u0930\u0947 \u092e\u0947\u0902 \u0924\u0940\u0930 \u091a\u0932\u093e \u0930\u0939\u0947 \u0939\u094b\u0964 \u0914\u0930 \u092b\u093f\u0930 \u0921\u0947\u0921\u0932\u093e\u0907\u0928 \u0915\u093e \u092a\u094d\u0930\u0947\u0936\u0930, AI \u0921\u093f\u091f\u0947\u0915\u094d\u0936\u0928 \u0915\u093e \u0921\u0930 \u2013 \u0938\u092c \u0915\u0941\u091b \u090f\u0915 \u0938\u093e\u0925 \u0906 \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u092f\u0939\u093e\u0901 \u092a\u0930 \u0925\u0940\u0938\u093f\u0938 \u091c\u0947\u0928\u0930\u0947\u091f\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092c\u0947\u0938\u094d\u091f \u092b\u094d\u0930\u0947\u0902\u0921 \u0939\u0948\u0964 \u092c\u0938 \u0905\u092a\u0928\u093e \u091f\u0949\u092a\u093f\u0915 \u0921\u093e\u0932\u094b, \u0914\u0930 \u0939\u092e 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u090f\u0915 \u092a\u0930\u092b\u0947\u0915\u094d\u091f \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u092c\u0928\u093e \u0926\u0947\u0902\u0917\u0947\u0964 \u092b\u093f\u0930 \u0909\u0938\u0947 \u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c \u0915\u0930\u094b \u0924\u093e\u0915\u093f \u091f\u0930\u094d\u0928\u093f\u091f\u093f\u0928 \u0915\u094b \u092a\u0924\u093e \u092d\u0940 \u0928 \u091a\u0932\u0947\u0964 \u0914\u0930 \u0939\u093e\u0901, \u0917\u094d\u0930\u093e\u092b, \u091f\u0947\u092c\u0932\u094d\u0938, \u0938\u093f\u091f\u0947\u0936\u0902\u0938 \u2013 \u0938\u092c \u0911\u091f\u094b\u092e\u0947\u091f\u093f\u0915\u0964 \u0924\u0941\u092e \u092c\u0938 \u092b\u094b\u0915\u0938 \u0915\u0930\u094b \u0905\u092a\u0928\u0947 \u0906\u0907\u0921\u093f\u092f\u093e\u091c \u092a\u0930\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u090f\u0915\u094d\u0936\u0928 \u0932\u0947\u0928\u0947 \u0915\u093e\u0964 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u0925\u0940\u0938\u093f\u0938 \u091c\u0947\u0928\u0930\u0947\u091f' \u092b\u0940\u091a\u0930 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u094b\u0964 \u0906\u091c \u0939\u0940 \u0905\u092a\u0928\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b \u090f\u0915 \u0938\u094d\u091f\u094d\u0930\u0915\u094d\u091a\u0930 \u0926\u094b\u0964 P.S. \u2013 \u092e\u0948\u0902\u0928\u0947 \u0916\u0941\u0926 \u0907\u0938 \u092b\u0940\u091a\u0930 \u0938\u0947 \u0905\u092a\u0928\u093e \u0917\u094d\u0930\u0947\u0921 B+ \u0938\u0947 A- \u0915\u0930 \u0932\u093f\u092f\u093e\u0964 \u0924\u0941\u092e \u092d\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964"
  ],
