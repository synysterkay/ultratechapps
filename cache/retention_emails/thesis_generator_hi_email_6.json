{
  "subject": "\u0935\u094b \u090f\u0915 \u0917\u0932\u0924\u0940 \u091c\u094b 90% \u091b\u093e\u0924\u094d\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902",
  "preview_text": "\u092f\u0939 \u0908\u092e\u0947\u0932 \u092a\u0922\u093c\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u0947 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b \u0938\u0947\u0935 \u0915\u0930 \u0932\u0947\u0902\u0964 \u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0917\u0932\u0924\u0940 \u0915\u0940 \u0914\u0930 \u092e\u0947\u0930\u0947 \u0930\u093f\u091c\u0932\u094d\u091f \u0916\u0930\u093e\u092c \u0939\u094b \u0917\u090f\u0964",
  "body_paragraphs": [
    "\u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u092f\u0939 \u0910\u092a \u0938\u093f\u0930\u094d\u092b \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092e\u0948\u0902 \u0917\u0932\u0924 \u0925\u093e\u0964 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u092c\u0921\u093c\u0940 \u0917\u0932\u0924\u0940 \u0915\u0940 \u091c\u093f\u0938\u0928\u0947 \u092e\u0947\u0930\u0947 \u092a\u0942\u0930\u0947 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0915\u094b \u092c\u0930\u094d\u092c\u093e\u0926 \u0915\u0930 \u0926\u093f\u092f\u093e\u0964 \u092e\u0948\u0902\u0928\u0947 \u0938\u0940\u0927\u0947 '\u091c\u0928\u0930\u0947\u091f' \u092c\u091f\u0928 \u0926\u092c\u093e\u092f\u093e \u0914\u0930 \u0938\u094b\u091a\u093e \u0915\u093f \u0915\u093e\u092e \u0939\u094b \u0917\u092f\u093e\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932\u0940 \u091c\u093e\u0926\u0942 \u0924\u094b '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c' \u092b\u0940\u091a\u0930 \u092e\u0947\u0902 \u091b\u093f\u092a\u093e \u0939\u0948\u0964 \u091c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u091b\u093e\u0924\u094d\u0930 \u0907\u0938\u0947 \u0938\u094d\u0915\u093f\u092a \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u092b\u093f\u0930 \u0909\u0928\u0915\u0947 \u092a\u0947\u092a\u0930 AI \u0921\u093f\u091f\u0947\u0915\u094d\u091f\u0930 \u092e\u0947\u0902 \u092a\u0915\u0921\u093c\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u092e\u0948\u0902\u0928\u0947 \u092d\u0940 \u092f\u0939\u0940 \u0915\u093f\u092f\u093e \u0914\u0930 \u092e\u0947\u0930\u0947 \u0917\u094d\u0930\u0947\u0921\u094d\u0938 \u0917\u093f\u0930 \u0917\u090f\u0964",
    "\u0905\u092c \u092e\u0948\u0902 \u0939\u0930 \u092c\u093e\u0930 \u092a\u0939\u0932\u0947 \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0942\u0902, \u092b\u093f\u0930 '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c' \u092c\u091f\u0928 \u0926\u092c\u093e\u0924\u093e \u0939\u0942\u0902\u0964 \u092f\u0939 \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0915\u094b \u0907\u0924\u0928\u093e \u0928\u0947\u091a\u0941\u0930\u0932 \u092c\u0928\u093e \u0926\u0947\u0924\u093e \u0939\u0948 \u0915\u093f Turnitin \u0914\u0930 GPTZero \u092d\u0940 \u0928\u0939\u0940\u0902 \u092a\u0915\u0921\u093c \u0938\u0915\u0924\u0947\u0964 \u0914\u0930 \u092b\u093f\u0930 '\u090f\u0915\u094d\u0938\u092a\u094b\u0930\u094d\u091f PDF' \u0938\u0947 \u0938\u0940\u0927\u0947 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964",
    "\u0905\u092c \u0924\u0941\u092e \u092d\u0940 \u092f\u0939 \u0917\u0932\u0924\u0940 \u092e\u0924 \u0915\u0930\u094b\u0964 \u0910\u092a \u0916\u094b\u0932\u094b, \u0905\u092a\u0928\u0940 \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f \u0915\u0930\u094b, \u0914\u0930 \u092b\u093f\u0930 '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c' \u092b\u0940\u091a\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u094b\u0964 P.S. \u092f\u0939 \u092b\u0940\u091a\u0930 \u0938\u093f\u0930\u094d\u092b 24 \u0918\u0902\u091f\u0947 \u0915\u0947 \u0932\u093f\u090f \u092b\u094d\u0930\u0940 \u0939\u0948, \u092b\u093f\u0930 \u092f\u0939 \u0932\u0949\u0915 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964 \u0906\u091c \u0939\u0940 \u0907\u0938\u0947 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b\u0964"
  ],
