{
  "subject": "\u0627\u06cc\u06a9 \u0686\u06be\u0648\u0679\u06cc \u0633\u06cc \u0686\u0627\u0644 \u062c\u0648 \u0622\u067e \u06a9\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0627\u06ba \u0628\u062f\u0644 \u062f\u06d2 \u06af\u06cc",
  "preview_text": "\u06cc\u06c1 60 \u0633\u06cc\u06a9\u0646\u0688 \u06a9\u0627 \u0679\u067e \u0622\u067e \u06a9\u0648 \u06c1\u0631 \u0645\u06cc\u0686 \u0645\u06cc\u06ba \u0628\u0631\u062a\u0631\u06cc \u062f\u06d2 \u06af\u0627\u06d4 \u06a9\u06be\u0648\u0644\u06cc\u06ba \u0627\u0648\u0631 \u062f\u06cc\u06a9\u06be\u06cc\u06ba\u06d4",
  "body_paragraphs": [
    "\u06a9\u06cc\u0627 \u0622\u067e \u0646\u06d2 \u06a9\u0628\u06be\u06cc \u0645\u062d\u0633\u0648\u0633 \u06a9\u06cc\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u06a9\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0627\u06ba \u0635\u0631\u0641 \u0642\u0633\u0645\u062a \u067e\u0631 \u0645\u0628\u0646\u06cc \u06c1\u0648\u062a\u06cc \u06c1\u06cc\u06ba\u061f \u0645\u06cc\u06ba \u0628\u06be\u06cc \u0627\u06cc\u0633\u0627 \u06c1\u06cc \u0633\u0648\u0686\u062a\u0627 \u062a\u06be\u0627\u060c \u062c\u0628 \u062a\u06a9 \u0645\u06cc\u06ba \u0646\u06d2 \u0627\u06cc\u06a9 \u0686\u06be\u0648\u0679\u06cc \u0633\u06cc \u0686\u0627\u0644 \u0646\u06c1\u06cc\u06ba \u0633\u06cc\u06a9\u06be \u0644\u06cc\u06d4 \u06cc\u06c1 \u0686\u0627\u0644 \u0645\u062c\u06be\u06d2 \u06c1\u0631 \u0645\u06cc\u0686 \u0645\u06cc\u06ba 10 \u0645\u0646\u0679 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u0648\u0642\u062a \u0628\u0686\u0627\u062a\u06cc \u06c1\u06d2 \u0627\u0648\u0631 \u0645\u06cc\u0631\u06d2 \u0641\u06cc\u0635\u0644\u0648\u06ba \u06a9\u0648 \u0632\u06cc\u0627\u062f\u06c1 \u062f\u0631\u0633\u062a \u0628\u0646\u0627\u062a\u06cc \u06c1\u06d2\u06d4",
    "\u0648\u06c1 \u0686\u0627\u0644 \u06c1\u06d2: \u0635\u0631\u0641 \u062f\u0648 \u0627\u0639\u062f\u0627\u062f \u0648 \u0634\u0645\u0627\u0631 \u067e\u0631 \u062a\u0648\u062c\u06c1 \u062f\u06cc\u0646\u0627 \u2014 \u0679\u06cc\u0645 \u06a9\u06cc \u062d\u0627\u0644\u06cc\u06c1 \u0641\u0627\u0631\u0645 \u0627\u0648\u0631 \u06af\u06be\u0631\u06cc\u0644\u0648 \u0645\u06cc\u0686\u0648\u06ba \u0645\u06cc\u06ba \u06a9\u0627\u0631\u06a9\u0631\u062f\u06af\u06cc\u06d4 \u06cc\u06c1 \u062f\u0648 \u0686\u06cc\u0632\u06cc\u06ba 80% \u06a9\u06cc\u0633\u0632 \u0645\u06cc\u06ba \u0641\u0627\u0626\u0646\u0644 \u0627\u0633\u06a9\u0648\u0631 \u06a9\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc \u06a9\u0631 \u0633\u06a9\u062a\u06cc \u06c1\u06cc\u06ba\u06d4 Predictify \u0645\u06cc\u06ba \u0622\u067e \u0627\u0646 \u0627\u0639\u062f\u0627\u062f \u0648 \u0634\u0645\u0627\u0631 \u06a9\u0648 \u0627\u06cc\u06a9 \u06a9\u0644\u06a9 \u0645\u06cc\u06ba \u062f\u06cc\u06a9\u06be \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u062c\u06cc\u0633\u06d2 'Team Form' \u0627\u0648\u0631 'Home Advantage' \u06a9\u06d2 \u0633\u06cc\u06a9\u0634\u0646\u0632\u06d4",
    "\u06c1\u0645\u0627\u0631\u06d2 AI \u0646\u06d2 \u06c1\u0632\u0627\u0631\u0648\u06ba \u0645\u06cc\u0686\u0648\u06ba \u06a9\u0627 \u062a\u062c\u0632\u06cc\u06c1 \u06a9\u06cc\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u067e\u0627\u06cc\u0627 \u06c1\u06d2 \u06a9\u06c1 \u06cc\u06c1 \u062f\u0648 \u0645\u062a\u063a\u06cc\u0631 \u0633\u0628 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u0645\u0624\u062b\u0631 \u06c1\u06cc\u06ba\u06d4 \u062c\u0628 \u0622\u067e \u0627\u067e\u0646\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0627\u06ba \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u062a\u0648 \u0635\u0631\u0641 \u0627\u0646 \u062f\u0648 \u0686\u06cc\u0632\u0648\u06ba \u067e\u0631 \u062a\u0648\u062c\u06c1 \u062f\u06cc\u06ba\u06d4 \u0622\u067e \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u06af\u06d2 \u06a9\u06c1 \u0622\u067e \u06a9\u06cc \u062f\u0631\u0633\u062a\u06af\u06cc \u0645\u06cc\u06ba \u0641\u0648\u0631\u06cc \u0641\u0631\u0642 \u0622\u0626\u06d2 \u06af\u0627\u06d4",
