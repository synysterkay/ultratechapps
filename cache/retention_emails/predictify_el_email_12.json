{
  "subject": "\u0397 \u03b2\u03cc\u03bb\u03c4\u03b1 \u03c0\u03bf\u03c5 \u03bc\u03bf\u03c5 \u03ac\u03bb\u03bb\u03b1\u03be\u03b5 \u03c4\u03b1 \u03c0\u03c1\u03bf\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03ac",
  "preview_text": "\u0388\u03bd\u03b1\u03c2 \u03c6\u03af\u03bb\u03bf\u03c2 \u03bc\u03bf\u03c5 \u03b5\u03af\u03c7\u03b5 15 \u03c3\u03c5\u03bd\u03b5\u03c7\u03cc\u03bc\u03b5\u03bd\u03b5\u03c2 \u03c3\u03c9\u03c3\u03c4\u03ad\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ad\u03c8\u03b5\u03b9\u03c2. \u0394\u03b5\u03bd \u03ae\u03c4\u03b1\u03bd \u03c4\u03cd\u03c7\u03b7. \u0394\u03b5\u03c2 \u03c4\u03b9 \u03b1\u03bd\u03b1\u03ba\u03ac\u03bb\u03c5\u03c8\u03b5.",
  "body_paragraphs": [
    "\u03a0\u03c1\u03b9\u03bd \u03b4\u03cd\u03bf \u03b5\u03b2\u03b4\u03bf\u03bc\u03ac\u03b4\u03b5\u03c2, \u03ad\u03bd\u03b1\u03c2 \u03c6\u03af\u03bb\u03bf\u03c2 \u03bc\u03bf\u03c5 \u03c0\u03ae\u03b3\u03b5 \u03b2\u03cc\u03bb\u03c4\u03b1 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03c3\u03ba\u03cd\u03bb\u03bf \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b9\u03c2 3 \u03c4\u03bf \u03c0\u03c1\u03c9\u03af. \u0394\u03b5\u03bd \u03ae\u03c4\u03b1\u03bd \u03b3\u03b9\u03b1 \u03c4\u03c1\u03ad\u03bb\u03b1. \u0389\u03c4\u03b1\u03bd \u03b3\u03b9\u03b1\u03c4\u03af \u03b5\u03af\u03c7\u03b5 \u03b2\u03c1\u03b5\u03b9 \u03ba\u03ac\u03c4\u03b9 \u03bc\u03ad\u03c3\u03b1 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03c0\u03bf\u03c5 \u03c4\u03bf\u03c5 \u03ac\u03bb\u03bb\u03b1\u03be\u03b5 \u03c4\u03b5\u03bb\u03b5\u03af\u03c9\u03c2 \u03c4\u03b7\u03bd \u03bf\u03c0\u03c4\u03b9\u03ba\u03ae. \u039e\u03b5\u03ba\u03af\u03bd\u03b7\u03c3\u03b5 \u03bd\u03b1 \u03c0\u03bf\u03bd\u03c4\u03ac\u03c1\u03b5\u03b9 \u03bc\u03b5 \u03b2\u03ac\u03c3\u03b7 \u03c4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03ba\u03b1\u03b9 \u03ad\u03ba\u03b1\u03bd\u03b5 15 \u03c3\u03c4\u03b1 15 \u03c3\u03c9\u03c3\u03c4\u03ac \u03c0\u03c1\u03bf\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03ac. \u0394\u03b5\u03bd \u03ae\u03c4\u03b1\u03bd \u03c4\u03c5\u03c7\u03b1\u03af\u03bf.",
    "\u03a4\u03bf \u03bc\u03c5\u03c3\u03c4\u03b9\u03ba\u03cc \u03c4\u03bf\u03c5; \u0394\u03b5\u03bd \u03ba\u03bf\u03b9\u03c4\u03bf\u03cd\u03c3\u03b5 \u03bc\u03cc\u03bd\u03bf \u03c4\u03b9\u03c2 \u03b2\u03b1\u03b8\u03bc\u03bf\u03bb\u03bf\u03b3\u03af\u03b5\u03c2. \u0386\u03bd\u03bf\u03b9\u03be\u03b5 \u03ad\u03bd\u03b1 \u03b5\u03c1\u03b3\u03b1\u03bb\u03b5\u03af\u03bf \u03c0\u03bf\u03c5 \u03b5\u03af\u03c7\u03b5 \u03b1\u03b3\u03bd\u03bf\u03ae\u03c3\u03b5\u03b9 \u03b3\u03b9\u03b1 \u03bc\u03ae\u03bd\u03b5\u03c2. \u0395\u03ba\u03b5\u03af, \u03b7 \u03c4\u03b5\u03c7\u03bd\u03b7\u03c4\u03ae \u03bd\u03bf\u03b7\u03bc\u03bf\u03c3\u03cd\u03bd\u03b7 \u03c4\u03bf\u03c5 \u03ad\u03b4\u03b5\u03b9\u03c7\u03bd\u03b5 \u03ba\u03ac\u03b8\u03b5 \u03bb\u03b5\u03c0\u03c4\u03cc \u03c4\u03b7\u03c2 \u03b1\u03bd\u03b1\u03bc\u03ad\u03c4\u03c1\u03b7\u03c3\u03b7\u03c2 \u2014 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03bf\u03c7\u03ae \u03bc\u03ad\u03c7\u03c1\u03b9 \u03c4\u03b7\u03bd \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u03c4\u03c9\u03bd \u03b5\u03c0\u03b9\u03b8\u03b5\u03c4\u03b9\u03ba\u03ce\u03bd. \u0388\u03b2\u03bb\u03b5\u03c0\u03b5 \u03c0\u03bf\u03b9\u03b1 \u03bf\u03bc\u03ac\u03b4\u03b1 \u03b5\u03af\u03c7\u03b5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc \u03c0\u03bb\u03b5\u03bf\u03bd\u03ad\u03ba\u03c4\u03b7\u03bc\u03b1, \u03cc\u03c7\u03b9 \u03b1\u03c5\u03c4\u03cc \u03c0\u03bf\u03c5 \u03bd\u03cc\u03bc\u03b9\u03b6\u03b5.",
    "\u0391\u03c5\u03c4\u03cc \u03c4\u03bf \u03b5\u03c1\u03b3\u03b1\u03bb\u03b5\u03af\u03bf \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 \u03b1\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u03b1\u03b3\u03ce\u03bd\u03b1 \u03bb\u03b5\u03c0\u03c4\u03cc \u03c0\u03c1\u03bf\u03c2 \u03bb\u03b5\u03c0\u03c4\u03cc. \u039c\u03ad\u03c3\u03b1 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae, \u03c0\u03b1\u03c4\u03ac\u03c2 \u03c3\u03b5 \u03ad\u03bd\u03b1 \u03bc\u03b1\u03c4\u03c2 \u03ba\u03b1\u03b9 \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9\u03c2 \u03b3\u03c1\u03b1\u03c6\u03ae\u03bc\u03b1\u03c4\u03b1 \u03c0\u03bf\u03c5 \u03c3\u03bf\u03c5 \u03b4\u03b5\u03af\u03c7\u03bd\u03bf\u03c5\u03bd \u03b1\u03ba\u03c1\u03b9\u03b2\u03ce\u03c2 \u03c0\u03cc\u03c4\u03b5 \u03bc\u03b9\u03b1 \u03bf\u03bc\u03ac\u03b4\u03b1 \u03c0\u03b9\u03ad\u03b6\u03b5\u03b9, \u03c0\u03cc\u03c4\u03b5 \u03ba\u03bf\u03c5\u03c1\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9, \u03ba\u03b1\u03b9 \u03c0\u03bf\u03cd \u03ba\u03c1\u03cd\u03b2\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c4\u03b1 value bets. \u0394\u03b5\u03bd \u03c7\u03c1\u03b5\u03b9\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 \u03bd\u03b1 \u03b5\u03af\u03c3\u03b1\u03b9 \u03c0\u03c1\u03bf\u03c0\u03bf\u03bd\u03b7\u03c4\u03ae\u03c2 \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03c4\u03bf \u03ba\u03b1\u03c4\u03b1\u03bb\u03ac\u03b2\u03b5\u03b9\u03c2.",
    "\u0386\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03bf Predictify \u03c4\u03ce\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03c0\u03ae\u03b3\u03b1\u03b9\u03bd\u03b5 \u03c3\u03b5 \u03ad\u03bd\u03b1 \u03bc\u03b1\u03c4\u03c2 \u03c4\u03b7\u03c2 Premier League \u03ae \u03c4\u03bf\u03c5 Champions League. \u03a0\u03ac\u03c4\u03b7\u03c3\u03b5 \u03c4\u03bf \u03ba\u03bf\u03c5\u03bc\u03c0\u03af '\u0391\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u039b\u03b5\u03c0\u03c4\u03cc \u03c0\u03c1\u03bf\u03c2 \u039b\u03b5\u03c0\u03c4\u03cc' \u03ba\u03b1\u03b9 \u03b4\u03b5\u03c2 \u03bc\u03cc\u03bd\u03bf\u03c2 \u03c3\u03bf\u03c5. \u0391\u03bd \u03b8\u03b5\u03c2 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b1, \u03b4\u03bf\u03ba\u03af\u03bc\u03b1\u03c3\u03b5 \u03c4\u03bf Premium \u03b3\u03b9\u03b1 3 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03b4\u03c9\u03c1\u03b5\u03ac\u03bd \u2014 \u03be\u03b5\u03ba\u03bb\u03b5\u03af\u03b4\u03c9\u03c3\u03b5 \u03cc\u03bb\u03b5\u03c2 \u03c4\u03b9\u03c2 \u03b1\u03bd\u03b1\u03bb\u03cd\u03c3\u03b5\u03b9\u03c2. P.S. \u039f \u03c6\u03af\u03bb\u03bf\u03c2 \u03bc\u03bf\u03c5 \u03c4\u03ce\u03c1\u03b1 \u03bb\u03ad\u03b5\u03b9 \u03c3\u03b5 \u03cc\u03bb\u03bf\u03c5\u03c2 \u03cc\u03c4\u03b9 \u03b7 \u03c4\u03cd\u03c7\u03b7 \u03c5\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9 \u03bc\u03cc\u03bd\u03bf \u03b3\u03b9\u03b1 \u03cc\u03c3\u03bf\u03c5\u03c2 \u03b4\u03b5\u03bd \u03ad\u03c7\u03bf\u03c5\u03bd \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1."
  ],
