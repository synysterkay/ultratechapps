{
  "subject": "\u0986\u09ae\u09be\u09b0 \u09e8\u099f\u09be\u09b0 \u09b0\u09be\u09a4\u09c7\u09b0 \u09ad\u09c1\u09b2 \u09af\u09be \u09b8\u09ac \u09ac\u09a6\u09b2\u09c7 \u09a6\u09bf\u09b2",
  "preview_text": "\u0986\u09ae\u09bf \u09b8\u09be\u09a7\u09be\u09b0\u09a3\u09a4 \u098f \u09b0\u0995\u09ae \u0987\u09ae\u09c7\u0987\u09b2 \u09b2\u09bf\u0996\u09bf \u09a8\u09be, \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u099c \u09b8\u09a4\u09cd\u09af\u09bf \u09ac\u09b2\u099b\u09bf...",
  "body_paragraphs": [
    "\u0997\u09a4 \u09b8\u09aa\u09cd\u09a4\u09be\u09b9\u09c7 \u09b0\u09be\u09a4 \u09e8\u099f\u09be\u09af\u09bc \u09ac\u09b8\u09c7 \u099b\u09bf\u09b2\u09be\u09ae, \u0986\u09b0 \u09ac\u09c1\u099d\u09b2\u09be\u09ae \u2014 Predictify-\u09a4\u09c7 \u09b9\u09be\u099c\u09be\u09b0 \u09b9\u09be\u099c\u09be\u09b0 \u09ae\u09cd\u09af\u09be\u099a \u0985\u09cd\u09af\u09be\u09a8\u09be\u09b2\u09be\u0987\u09b8\u09bf\u09b8 \u0995\u09b0\u09be\u09b0 \u09aa\u09b0\u0993 \u0986\u09ae\u09bf \u09a8\u09bf\u099c\u09c7 \u09ad\u09c1\u09b2 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u09a6\u09bf\u099a\u09cd\u099b\u09bf\u0964 \u09b9\u09cd\u09af\u09be\u0981, \u0986\u09ae\u09bf \u09af\u09bf\u09a8\u09bf \u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa \u09ac\u09be\u09a8\u09bf\u09af\u09bc\u09c7\u099b\u09bf\u0964 \u0995\u09be\u09b0\u09a3 \u0986\u09ae\u09bf \u09a1\u09c7\u099f\u09be \u09a8\u09bf\u09af\u09bc\u09c7 \u098f\u09a4\u099f\u09be\u0987 \u09ae\u09c7\u09a4\u09c7 \u099b\u09bf\u09b2\u09be\u09ae \u09af\u09c7 \u09ad\u09c1\u09b2\u09c7 \u0997\u09bf\u09af\u09bc\u09c7\u099b\u09bf\u09b2\u09be\u09ae: \u0986\u09b8\u09b2 \u09ab\u09c1\u099f\u09ac\u09b2 \u09ae\u09be\u09a8\u09c7 \u09b6\u09c1\u09a7\u09c1 \u09b8\u0982\u0996\u09cd\u09af\u09be \u09a8\u09af\u09bc, \u098f\u099f\u09be \u0985\u09a8\u09c1\u09ad\u09c2\u09a4\u09bf\u09b0\u0993 \u09ac\u09cd\u09af\u09be\u09aa\u09be\u09b0\u0964",
    "\u0986\u09ae\u09bf \u09b8\u09be\u09a7\u09be\u09b0\u09a3\u09a4 \u098f \u09b0\u0995\u09ae \u0987\u09ae\u09c7\u0987\u09b2 \u09b2\u09bf\u0996\u09bf \u09a8\u09be, \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u099c \u09b8\u09a4\u09cd\u09af\u09bf \u09ac\u09b2\u099b\u09bf \u2014 \u0986\u09ae\u09bf \u099a\u09be\u0987 \u09a4\u09c1\u09ae\u09bf \u09b6\u09c1\u09a7\u09c1 \u09ad\u0995\u09cd\u09a4 \u09a8\u09be \u09b9\u0993, \u09a4\u09c1\u09ae\u09bf \u09b9\u0993 \u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u09b8\u09cd\u09ae\u09be\u09b0\u09cd\u099f \u09ad\u0995\u09cd\u09a4\u0964 \u0986\u09b0 \u09b8\u09c7\u099f\u09be \u09b9\u09a4\u09c7 \u0997\u09c7\u09b2\u09c7 \u09b6\u09c1\u09a7\u09c1 AI-\u09b0 \u0993\u09aa\u09b0 \u09ad\u09b0\u09b8\u09be \u0995\u09b0\u09b2\u09c7\u0987 \u09b9\u09ac\u09c7 \u09a8\u09be, \u09a8\u09bf\u099c\u09c7\u09b0 \u099c\u09cd\u099e\u09be\u09a8\u0993 \u0995\u09be\u099c\u09c7 \u09b2\u09be\u0997\u09be\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 Predictify-\u09b0 IQ Quiz \u09ab\u09bf\u099a\u09be\u09b0\u099f\u09be \u09a0\u09bf\u0995 \u09b8\u09c7\u099f\u09be\u0987 \u0995\u09b0\u09c7: \u09a4\u09c1\u09ae\u09bf AI-\u098f\u09b0 \u09ac\u09bf\u09b0\u09c1\u09a6\u09cd\u09a7\u09c7 \u099f\u09c7\u09b8\u09cd\u099f \u09a6\u09be\u0993, \u0986\u09b0 \u09b2\u09bf\u09a1\u09be\u09b0\u09ac\u09cb\u09b0\u09cd\u09a1\u09c7 \u09a8\u09bf\u099c\u09c7\u09b0 \u09a8\u09be\u09ae \u09a4\u09c1\u09b2\u09c7 \u09a6\u09be\u0993\u0964",
    "\u09ae\u09a8\u09c7 \u0995\u09b0\u09cb, \u09a4\u09c1\u09ae\u09bf \u09ac\u09b8\u09c7 \u0986\u099b\u09cb \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u0986\u0997\u09c7, \u0986\u09b0 \u09a4\u09c1\u09ae\u09bf \u099c\u09be\u09a8\u09cb \u0995\u09cb\u09a8 \u09a6\u09b2\u09c7\u09b0 xG \u09ac\u09c7\u09b6\u09bf, \u0995\u09be\u09b0 \u09a1\u09bf\u09ab\u09c7\u09a8\u09cd\u09b8 \u09b6\u0995\u09cd\u09a4, \u0986\u09b0 \u09b9\u09c7\u09a1-\u099f\u09c1-\u09b9\u09c7\u09a1 \u0987\u09a4\u09bf\u09b9\u09be\u09b8 \u0995\u09c0 \u09ac\u09b2\u099b\u09c7\u0964 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09a4\u09be\u09b0\u09aa\u09b0\u0993 \u09a4\u09c1\u09ae\u09bf \u098f\u0995\u099f\u09be \u09ad\u09c1\u09b2 \u0995\u09b0\u09cb \u2014 \u0995\u09be\u09b0\u09a3 '\u0997\u09be\u099f \u09ab\u09bf\u09b2\u09bf\u0982'-\u098f\u09b0 \u0993\u09aa\u09b0 \u09ad\u09b0\u09b8\u09be \u0995\u09b0\u09cb\u0964 IQ Quiz \u09a0\u09bf\u0995 \u098f\u0987 \u099c\u09be\u09af\u09bc\u0997\u09be\u099f\u09be \u09a7\u09b0\u09c7: \u09a4\u09c1\u09ae\u09bf \u09b6\u09bf\u0996\u09ac\u09c7 \u0995\u0996\u09a8 \u09a1\u09c7\u099f\u09be \u09ae\u09be\u09a8\u09a4\u09c7 \u09b9\u09ac\u09c7, \u0986\u09b0 \u0995\u0996\u09a8 \u09a8\u09bf\u099c\u09c7\u09b0 \u0987\u09a8\u09cd\u09b8\u099f\u09bf\u0982\u0995\u09cd\u099f\u0995\u09c7 \u09ac\u09bf\u09b6\u09cd\u09ac\u09be\u09b8 \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964",
    "\u098f\u0996\u09a8\u0987 Predictify \u0996\u09c1\u09b2\u09c7 IQ Quiz-\u098f \u0985\u0982\u09b6 \u09a8\u09be\u0993\u0964 \u09a6\u09c7\u0996\u09cb \u09a4\u09c1\u09ae\u09bf \u0995\u09a4\u099f\u09be \u099c\u09be\u09a8\u09cb, \u0986\u09b0 AI-\u0995\u09c7 \u099a\u09cd\u09af\u09be\u09b2\u09c7\u099e\u09cd\u099c \u0995\u09b0\u09cb\u0964 \u09aa\u09bf.\u098f\u09b8.: \u09e9 \u09a6\u09bf\u09a8\u09c7\u09b0 \u09ab\u09cd\u09b0\u09bf \u099f\u09cd\u09b0\u09be\u09af\u09bc\u09be\u09b2\u09c7 \u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09af\u09bc\u09be\u09ae \u0986\u09a8\u09b2\u0995 \u0995\u09b0\u09cb \u2014 \u09b8\u09ac \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8, \u0985\u09cd\u09af\u09be\u09a1\u09ad\u09be\u09a8\u09cd\u09b8\u09a1 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u099f\u09b8, \u0986\u09b0 \u0986\u09a8\u09b2\u09bf\u09ae\u09bf\u099f\u09c7\u09a1 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8 \u09aa\u09be\u09ac\u09c7\u0964 \u09b6\u09c1\u09a7\u09c1 $\u09e7\u09e8.\u09ef\u09ef/\u09ae\u09be\u09b8\u09c7 \u09a4\u09cb\u09ae\u09be\u09b0 \u09ab\u09c1\u099f\u09ac\u09b2 \u099c\u09cd\u099e\u09be\u09a8\u0995\u09c7 \u09aa\u09b0\u09c7\u09b0 \u09b2\u09c7\u09ad\u09c7\u09b2\u09c7 \u09a8\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u0993\u0964"
  ],
