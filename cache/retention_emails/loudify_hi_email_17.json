{
  "subject": "\u0935\u0939 3 \u092e\u093f\u0928\u091f \u0915\u093e \u0930\u0942\u091f\u0940\u0928 \u091c\u094b \u0910\u092a \u0915\u094b 10x \u092c\u0928\u093e\u0924\u093e \u0939\u0948",
  "preview_text": "\u0939\u0930 \u0926\u093f\u0928 \u0938\u093f\u0930\u094d\u092b 3 \u092e\u093f\u0928\u091f \u0932\u0917\u093e\u0907\u090f, \u0914\u0930 \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924 \u092c\u0926\u0932 \u091c\u093e\u090f\u0917\u0940\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947, \u090f\u0915 \u092f\u0942\u091c\u093c\u0930 \u0928\u0947 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0935\u0939 \u0939\u0930 \u0926\u093f\u0928 \u0938\u093f\u0930\u094d\u092b 3 \u092e\u093f\u0928\u091f Loudify \u0916\u094b\u0932\u0924\u093e \u0939\u0948 \u2014 \u0914\u0930 \u0909\u0938\u0915\u0940 \u0911\u0921\u093f\u092f\u094b \u0926\u0941\u0928\u093f\u092f\u093e \u092c\u0926\u0932 \u0917\u0908\u0964 \u0935\u0939 \u0915\u0939\u0924\u093e \u0939\u0948, '\u092a\u0939\u0932\u0947 \u092e\u0948\u0902 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u092e\u0947\u0902 \u0939\u0940 \u092b\u0902\u0938 \u091c\u093e\u0924\u093e \u0925\u093e, \u0905\u092c \u092e\u0948\u0902 \u0939\u0930 \u0938\u094d\u0930\u094b\u0924 \u0915\u094b \u0938\u093e\u092b \u0914\u0930 \u0924\u0947\u091c \u0938\u0941\u0928\u0924\u093e \u0939\u0942\u0902\u0964' \u092f\u0939 \u0915\u094b\u0908 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902 \u0939\u0948; \u092f\u0939 \u090f\u0915 \u0930\u0942\u091f\u0940\u0928 \u0939\u0948 \u091c\u093f\u0938\u0947 \u0939\u092e\u0928\u0947 \u092c\u0928\u093e\u092f\u093e \u0939\u0948 \u2014 \u0939\u0930 \u0926\u093f\u0928 \u0924\u0940\u0928 \u092e\u093f\u0928\u091f: \u090f\u0915 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u091a\u0941\u0928\u0947\u0902, AutoEQ \u0915\u094b \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u092a\u0939\u091a\u093e\u0928\u0928\u0947 \u0926\u0947\u0902, \u0914\u0930 \u092b\u093f\u0930 \u092c\u0942\u0938\u094d\u091f \u0915\u0930\u0947\u0902\u0964",
    "\u092f\u0939 \u0930\u0942\u091f\u0940\u0928 \u0906\u092a\u0915\u0940 \u0906\u0926\u0924 \u0915\u094b \u092e\u091c\u092c\u0942\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u091c\u092c \u0906\u092a \u0930\u094b\u091c\u093c Loudify \u0916\u094b\u0932\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0906\u092a\u0915\u093e \u0926\u093f\u092e\u093e\u0917 \u0907\u0938\u0947 '\u0938\u0941\u0928\u0928\u0947 \u0915\u093e \u0938\u0939\u0940 \u0924\u0930\u0940\u0915\u093e' \u092e\u093e\u0928\u0928\u0947 \u0932\u0917\u0924\u093e \u0939\u0948\u0964 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0906\u092a \u091f\u094d\u0930\u0947\u0928, \u0915\u0949\u092b\u0940 \u0936\u0949\u092a \u092f\u093e \u0918\u0930 \u092a\u0930 \u0939\u094b\u0902, \u090f\u0915 \u091f\u0948\u092a \u0938\u0947 \u0906\u092a\u0915\u094b \u0935\u0939 \u092e\u093f\u0932\u0924\u093e \u0939\u0948 \u091c\u094b \u0906\u092a \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902 \u2014 \u0938\u093e\u092b \u0914\u0930 \u0924\u0947\u091c\u0964 \u092f\u0939 \u0906\u092a\u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u092c\u0928 \u091c\u093e\u0924\u093e \u0939\u0948: '\u092e\u0948\u0902 \u0935\u0939 \u0939\u0942\u0902 \u091c\u094b \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u0938\u0939\u0940 \u0938\u0947 \u091f\u094d\u092f\u0942\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964'",
    "\u0939\u092e\u093e\u0930\u093e Sound DNA \u0906\u092a\u0915\u094b \u0939\u0930 \u0939\u092b\u094d\u0924\u0947 \u092c\u0924\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0928\u0947 \u0915\u0948\u0938\u0947 \u0938\u0941\u0928\u093e \u2014 \u0915\u094c\u0928 \u0938\u0947 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932, \u0915\u093f\u0924\u0928\u0940 \u092c\u093e\u0930, \u0915\u093f\u0938 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092a\u0930\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u0939\u0948; \u092f\u0939 \u0906\u092a\u0915\u0940 \u0906\u0926\u0924 \u0915\u093e \u0906\u0907\u0928\u093e \u0939\u0948\u0964 \u0914\u0930 Top Streaks \u0932\u0940\u0921\u0930\u092c\u094b\u0930\u094d\u0921 \u0906\u092a\u0915\u094b \u0939\u0930 \u0926\u093f\u0928 \u091c\u0935\u093e\u092c\u0926\u0947\u0939 \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u092f\u0939 \u0938\u092c \u092e\u093f\u0932\u0924\u093e \u0939\u0948 \u2014 AutoEQ \u092a\u094d\u0930\u0940\u0938\u0947\u091f, \u092a\u0942\u0930\u093e +200% \u092c\u0942\u0938\u094d\u091f, \u0914\u0930 Sound DNA \u0915\u093e \u092a\u0942\u0930\u093e \u0907\u0924\u093f\u0939\u093e\u0938\u0964",
    "\u0906\u091c \u0939\u0940 Loudify \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u093e 3 \u092e\u093f\u0928\u091f \u0915\u093e \u0930\u0942\u091f\u0940\u0928 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0964 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u091a\u0941\u0928\u0947\u0902, AutoEQ \u0915\u094b \u0915\u093e\u092e \u0915\u0930\u0928\u0947 \u0926\u0947\u0902, \u0914\u0930 \u092b\u093f\u0930 \u092c\u0942\u0938\u094d\u091f \u0915\u0930\u0947\u0902\u0964 \u092a\u0940.\u090f\u0938. \u2014 \u0915\u094d\u092f\u093e \u0906\u092a\u0928\u0947 \u0905\u092a\u0928\u0947 Sound DNA \u0915\u0940 \u092a\u093f\u091b\u0932\u0940 \u0939\u092b\u094d\u0924\u0947 \u0915\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0926\u0947\u0916\u0940? \u0935\u0939 \u0906\u092a\u0915\u094b \u092c\u0924\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u0915\u094c\u0928 \u0938\u093e \u0938\u092e\u092f \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u093e \u0930\u0939\u093e\u0964"
  ],
