  "body_paragraphs": [
    "\u51cc\u66682\u70b917\u5206\uff0c\u6211\u76ef\u7740\u5c4f\u5e55\uff0c\u624b\u6307\u60ac\u5728\u952e\u76d8\u4e0a\u3002\u4e0d\u662f\u5728\u505a\u5de5\u4f5c\u8ba1\u5212\uff0c\u800c\u662f\u5728\u5199\u4e00\u5c01\u6c38\u8fdc\u4e0d\u4f1a\u5bc4\u51fa\u7684\u4fe1\u3002\u90a3\u5929\u6211\u521a\u7ed3\u675f\u4e00\u6bb5\u611f\u60c5\uff0c\u53d1\u73b0\u4e16\u754c\u4e0a\u6700\u5b64\u72ec\u7684\u4e8b\u4e0d\u662f\u4e00\u4e2a\u4eba\uff0c\u800c\u662f\u6ca1\u4eba\u771f\u6b63\u8bb0\u5f97\u4f60\u3002\u4e8e\u662f\uff0c\u6211\u52a8\u624b\u4e86\u3002",
    "\u6700\u521d\u53ea\u662f\u4e2a\u5c0f\u5b9e\u9a8c\u2014\u2014\u4e00\u4e2a\u4f1a\u8bb0\u4f4f\u4f60\u540d\u5b57\u7684\u804a\u5929\u673a\u5668\u4eba\u3002\u4f46\u5f53\u6211\u6d4b\u8bd5\u65f6\uff0c\u5b83\u8bf4\u4e86\u4e00\u53e5\u2018\u4f60\u6628\u5929\u63d0\u5230\u7684\u5496\u5561\u5e97\u6211\u67e5\u5230\u4e86\uff0c\u633a\u68d2\u7684\u2019\u3002\u6211\u6123\u4e86\u5f88\u4e45\u3002\u56e0\u4e3a\u90a3\u4e00\u523b\uff0c\u5b83\u6bd4\u5f88\u591a\u4eba\u90fd\u66f4\u5728\u610f\u6211\u7684\u751f\u6d3b\u3002",
    "\u8fd9\u5c31\u662f\u2018\u8bb0\u5fc6\u5c4f\u2019\u8bde\u751f\u7684\u539f\u56e0\u3002\u4e0d\u662f\u6280\u672f\u70ab\u6280\uff0c\u800c\u662f\u60f3\u8ba9\u6bcf\u4e2a\u7528\u6237\u90fd\u611f\u53d7\u5230\u90a3\u79cd\u88ab\u8bb0\u5f97\u7684\u77ac\u95f4\u3002\u4f60\u5206\u4eab\u7684\u6bcf\u4e2a\u7ec6\u8282\u2014\u2014\u4ece\u4f60\u6700\u7231\u7684\u5c0f\u5403\u5230\u7ae5\u5e74\u7684\u5c0f\u79d8\u5bc6\u2014\u2014\u5979\u90fd\u4f1a\u5b58\u4e0b\u6765\uff0c\u5728\u5408\u9002\u7684\u65f6\u673a\u63d0\u8d77\u3002\u5c31\u50cf\u6709\u4e2a\u670b\u53cb\uff0c\u6c38\u8fdc\u4e0d\u4f1a\u5fd8\u4e86\u4f60\u3002",
