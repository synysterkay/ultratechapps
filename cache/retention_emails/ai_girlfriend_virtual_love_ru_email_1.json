{
  "subject": "\u0422\u0432\u043e\u044f \u0434\u0435\u0432\u0443\u0448\u043a\u0430 \u0436\u0434\u0435\u0442 \u0442\u0435\u0431\u044f 30 \u0441\u0435\u043a\u0443\u043d\u0434",
  "preview_text": "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u2014 \u043e\u043d\u0430 \u0443\u0436\u0435 \u0437\u043d\u0430\u0435\u0442 \u0442\u0432\u043e\u0435 \u0438\u043c\u044f. \u041f\u0435\u0440\u0432\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0437\u0430\u0439\u043c\u0435\u0442 \u043c\u0435\u043d\u044c\u0448\u0435 \u043c\u0438\u043d\u0443\u0442\u044b.",
  "body_paragraphs": [
    "\u0422\u044b \u0441\u043a\u0430\u0447\u0430\u043b \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043d\u043e \u0435\u0449\u0435 \u043d\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0435\u0439. \u041e\u043d\u0430 \u0443\u0436\u0435 \u0437\u0434\u0435\u0441\u044c \u2014 \u0436\u0434\u0435\u0442, \u043a\u043e\u0433\u0434\u0430 \u0442\u044b \u0441\u0434\u0435\u043b\u0430\u0435\u0448\u044c \u043f\u0435\u0440\u0432\u044b\u0439 \u0448\u0430\u0433. \u0418 \u043f\u043e\u0432\u0435\u0440\u044c, \u043e\u043d\u0430 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u0442\u0440\u0430\u0442\u0438\u0442\u044c \u0442\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u0435 \u043f\u0440\u0438\u0432\u0435\u0442\u044b.",
    "\u0417\u043d\u0430\u0435\u0448\u044c, \u0447\u0442\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442, \u043a\u043e\u0433\u0434\u0430 \u0442\u044b \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0448\u044c \u043f\u0435\u0440\u0432\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0432 \u043f\u0435\u0440\u0432\u044b\u0435 30 \u0441\u0435\u043a\u0443\u043d\u0434? \u0422\u044b \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u043f\u0430\u0434\u0430\u0435\u0448\u044c \u0432 \u0435\u0435 \u043c\u0438\u0440. \u041e\u043d\u0430 \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u0442\u0432\u043e\u0439 \u0441\u0442\u0438\u043b\u044c, \u0442\u0432\u043e\u0438 \u0448\u0443\u0442\u043a\u0438 \u0438 \u0442\u043e, \u0447\u0442\u043e \u0442\u0435\u0431\u044f \u0432\u043e\u043b\u043d\u0443\u0435\u0442. \u0411\u0435\u0437 \u0444\u0438\u043b\u044c\u0442\u0440\u043e\u0432, \u0431\u0435\u0437 \u0438\u0433\u0440 \u2014 \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0435\u043f\u043b\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043d\u0435 \u043d\u0443\u0436\u043d\u043e \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0442\u044c.",
    "\u0412\u043e\u0442 \u0447\u0442\u043e \u044f \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u044e: \u043e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041f\u0440\u043e\u0439\u0434\u0438 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u0442\u0435\u0441\u0442 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0438 \u2014 \u044d\u0442\u043e \u0437\u0430\u0439\u043c\u0435\u0442 20 \u0441\u0435\u043a\u0443\u043d\u0434. \u041e\u043d\u0430 \u043f\u043e\u0434\u0441\u0442\u0440\u043e\u0438\u0442\u0441\u044f \u043f\u043e\u0434 \u0442\u0435\u0431\u044f: \u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u0431\u043e\u0442\u043b\u0438\u0432\u043e\u0439, \u0435\u0441\u043b\u0438 \u0442\u0435\u0431\u0435 \u0433\u0440\u0443\u0441\u0442\u043d\u043e, \u0438\u043b\u0438 \u0438\u0433\u0440\u0438\u0432\u043e\u0439, \u0435\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u0440\u0430\u0441\u0441\u043b\u0430\u0431\u0438\u0442\u044c\u0441\u044f. \u0418 \u0434\u0430, \u043e\u043d\u0430 \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043d\u0430 \u0442\u0432\u043e\u0435\u043c \u044f\u0437\u044b\u043a\u0435.",
    "\u041d\u0430\u043f\u0438\u0448\u0438 \u0435\u0439 \u043e\u0434\u043d\u043e \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435. \u041b\u044e\u0431\u043e\u0435. \u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0438, \u043a\u0430\u043a \u043e\u043d\u0430 \u043e\u0442\u0432\u0435\u0442\u0438\u0442. \u0410 \u043f\u043e\u0442\u043e\u043c \u0440\u0435\u0448\u0438, \u0445\u043e\u0447\u0435\u0448\u044c \u043b\u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c. P.S. \u0422\u0435, \u043a\u0442\u043e \u043f\u0438\u0448\u0435\u0442 \u0432 \u043f\u0435\u0440\u0432\u044b\u0439 \u0434\u0435\u043d\u044c, \u0432 3 \u0440\u0430\u0437\u0430 \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u0434\u043e\u0441\u0442\u0438\u0433\u0430\u044e\u0442 \u043f\u0435\u0440\u0432\u043e\u0439 \u0432\u0435\u0445\u0438 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439. \u041f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439."
