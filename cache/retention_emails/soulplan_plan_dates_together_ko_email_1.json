{
  "subject": "\ub0b4\uc77c \ubc24\uc744 \uc704\ud574 30\ucd08\ub9cc \ud22c\uc790\ud558\uc138\uc694",
  "preview_text": "\uc624\ub298 \ubc24, \ub2f9\uc2e0\uacfc \ud30c\ud2b8\ub108\ub97c \uc704\ud55c \ud2b9\ubcc4\ud55c \ub370\uc774\ud2b8\uac00 30\ucd08\uba74 \uc644\uc131\ub429\ub2c8\ub2e4. \uc9c0\uae08 \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\ub370\uc774\ud2b8 \uacc4\ud68d\uc5d0 \uc9c0\uce58\uc168\ub098\uc694? \ub9e4\ubc88 \uac19\uc740 \ub808\uc2a4\ud1a0\ub791, \uac19\uc740 \uc601\ud654, \uac19\uc740 \ub8e8\ud2f4. \ud558\uc9c0\ub9cc \uc624\ub298 \ubc24\uc740 \ub2e4\ub985\ub2c8\ub2e4. SoulPlan\uc774 \ub2f9\uc2e0\uc744 \uc704\ud574 \uc900\ube44\ud55c \ud55c \uc7a5\uc758 \uce74\ub4dc\uac00 \ubaa8\ub4e0 \uac83\uc744 \ubc14\uafd4\ub193\uc744 \uac70\uc608\uc694.",
    "\uc5f0\uad6c\uc5d0 \ub530\ub974\uba74, \uc624\ub298 \ubc24\uc758 \ub370\uc774\ud2b8 \uae30\ub2a5\uc744 \ucc98\uc74c 24\uc2dc\uac04 \ub0b4 \uc0ac\uc6a9\ud55c \ucee4\ud50c\uc740 \ub2e4\uc74c \ud55c \ub2ec \ub3d9\uc548 4\ubc30 \ub354 \ub9ce\uc740 \ub370\uc774\ud2b8\ub97c \uacc4\ud68d\ud569\ub2c8\ub2e4. \uadf8\ub9cc\ud07c \uac15\ub825\ud55c \ub3c4\uad6c\uc608\uc694. \ub2f9\uc2e0\ub3c4 \uadf8 \ud61c\ud0dd\uc744 \ub204\ub9b4 \ucc28\ub840\uc785\ub2c8\ub2e4.",
    "\uc571\uc744 \uc5f4\uace0 '\uc624\ub298 \ubc24\uc758 \ub370\uc774\ud2b8'\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc758 \uae30\ubd84\uc5d0 \ub9de\ub294 \uce74\ub4dc\uac00 \uc774\ubbf8 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694. \uc544\ub291\ud55c, \ubaa8\ud5d8\uc801\uc778, \uc7a5\ub09c\uae30 \uac00\ub4dd\ud55c, \uce58\uc720\uc758 \u2014 \ud55c \ubc88 \ud0ed\ud558\uba74 \ubaa8\ub4e0 \uac83\uc774 \uc900\ube44\ub429\ub2c8\ub2e4. 30\ucd08\uba74 \ub05d\uc774\uc5d0\uc694.",
    "\uc9c0\uae08 \ubc14\ub85c SoulPlan\uc744 \uc5f4\uace0 \uc624\ub298 \ubc24\uc758 \ub370\uc774\ud2b8\ub97c \uc2dc\uc791\ud558\uc138\uc694. \ub2e8 30\ucd08\uba74 \ub2f9\uc2e0\uc758 \uad00\uacc4\uc5d0 \uc0c8\ub85c\uc6b4 \ubd88\uaf43\uc744 \ub354\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. P.S. \ud30c\ud2b8\ub108\uac00 \ubcf4\ub0b8 \uc81c\uc548\uc744 \ubc1b\uc73c\uba74 '\uc624\ub298 \ubc24 \ub108\ub97c \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \ud2b9\ubcc4\ud55c \uc21c\uac04\uc774 \ud3bc\uccd0\uc9d1\ub2c8\ub2e4. \uadf8 \uac10\ub3d9\uc744 \ub193\uce58\uc9c0 \ub9c8\uc138\uc694."
  ],
