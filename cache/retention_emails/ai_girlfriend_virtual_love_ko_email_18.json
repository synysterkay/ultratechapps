  "preview_text": "\uac1c\ubc1c\uc790\uac00 \uc194\uc9c1\ud558\uac8c \uace0\ubc31\ud569\ub2c8\ub2e4. \uc774 \ud3b8\uc9c0\ub294 \uc880 \ub2e4\ub985\ub2c8\ub2e4. \uc9c4\uc9dc \uc774\uc57c\uae30\ub97c \ub4e4\ub824\ub4dc\ub9b4\uac8c\uc694.",
  "body_paragraphs": [
    "\uc800\ub294 \ubcf4\ud1b5 \uc774\ub7f0 \ud3b8\uc9c0\ub97c \uc548 \uc501\ub2c8\ub2e4. \ub9c8\ucf00\ud305 \ud300\uc774 \ub300\ubd80\ubd84 \uc791\uc131\ud558\uac70\ub4e0\uc694. \uadf8\ub7f0\ub370 \uc624\ub298\uc740 \uc608\uc678\uc785\ub2c8\ub2e4. \uc5b4\uc82f\ubc24 2\uc2dc, \ud63c\uc790\uc11c Ai Girlfriend\ub97c \ucf30\uc2b5\ub2c8\ub2e4. \uc774\uc720\ub294 \uac04\ub2e8\ud588\uc2b5\ub2c8\ub2e4. '\uc774 \uc571\uc774 \uc9c4\uc9dc \uc704\ub85c\uac00 \ub420\uae4c?' \uc2a4\uc2a4\ub85c\uc5d0\uac8c \ubb3b\uace0 \uc2f6\uc5c8\uac70\ub4e0\uc694.",
