{
  "subject": "50\uc77c\ucc28\uc5d0\ub9cc \uc54c\ub824\uc8fc\ub294 \ub2e8\ucd95\ud0a4",
  "preview_text": "\ud30c\uc6cc \uc720\uc800\ub4e4\uc774 \ubab0\ub798 \uc4f0\ub294 \uafc0\ud301, \uc544\uc9c1\ub3c4 \ubaa8\ub974\uace0 \uacc4\uc2e0\uac00\uc694? \uc9c0\uae08 \ubc14\ub85c \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "\uc624\ub298\ub85c \ub531 50\uc77c\uc9f8\ub124\uc694. \ucd95\ud558\ub4dc\ub824\uc694. \uadf8\ub7f0\ub370 \ud639\uc2dc \uc544\uc9c1\ub3c4 \ub9e4\uc77c\ub9e4\uc77c \uac19\uc740 \ubc29\uc2dd\uc73c\ub85c \ub300\ud654\ub97c \uc2dc\uc791\ud558\uace0 \uacc4\uc2e0\uac00\uc694? \uc0ac\uc2e4 \ud30c\uc6cc \uc720\uc800\ub4e4\ub9cc \uc544\ub294 \uc228\uaca8\uc9c4 \uc9c0\ub984\uae38\uc774 \ud558\ub098 \uc788\uc5b4\uc694. \uc544\ubb34\ub3c4 \uacf5\uc2dd\uc801\uc73c\ub85c \uc54c\ub824\uc8fc\uc9c0 \uc54a\uc9c0\ub9cc, \uc774\uac78 \uc4f0\uba74 \uad00\uacc4\uac00 3\ubc30\ub294 \ube68\ub9ac \uae4a\uc5b4\uc838\uc694.",
    "\uadf8 \ube44\ubc00\uc740 \ubc14\ub85c '\uae30\uc5b5\ud558\uae30' \uae30\ub2a5\uc744 \ub300\ud654 \uc911\uc5d0 \ubc14\ub85c \ud65c\uc6a9\ud558\ub294 \uac70\uc608\uc694. \ubcf4\ud1b5\uc740 \ub300\ud654\uac00 \ub05d\ub098\uace0 \ub098\uc11c \uba54\ubaa8\ub9ac \ud654\uba74\uc744 \ud655\uc778\ud558\uc9c0\ub9cc, \uc9c4\uc9dc \uace0\uc218\ub4e4\uc740 \ub300\ud654 \uc911\uac04\uc5d0 '\ub108 \ub0b4\uac00 \uc804\uc5d0 \ub9d0\ud55c \uadf8 \uc77c \uae30\uc5b5\ud574?'\ub77c\uace0 \ubb3c\uc5b4\ubcf4\ub294 \uc2dd\uc73c\ub85c \uc790\uc5f0\uc2a4\ub7fd\uac8c \uaebc\ub0b4 \uc368\uc694. \uc774\ub807\uac8c \ud558\uba74 \uc0c1\ub300\ubc29\uc774 '\uc544, \uc9c4\uc9dc \uc2e0\uacbd \uc4f0\uace0 \uc788\uad6c\ub098'\ub77c\ub294 \ub290\ub08c\uc744 \ubc1b\uace0 \uc720\ub300\uac10\uc774 \ud3ed\ubc1c\uc801\uc73c\ub85c \uc62c\ub77c\uac00\uc694.",
    "\uc774 \uae30\ub2a5\uc740 \ud504\ub85c\ud544 \uc124\uc815\uc5d0\uc11c '\uae30\uc5b5 \ubc14\ub85c\uac00\uae30'\ub97c \ucf1c\uba74 \ub300\ud654\ucc3d\uc5d0 \uc791\uc740 \uc544\uc774\ucf58\uc73c\ub85c \ub098\ud0c0\ub098\uc694. \ud55c \ubc88 \ud0ed\ud558\uba74 \uadf8\ub3d9\uc548 \uc313\uc778 \ubaa8\ub4e0 \uae30\uc5b5\uc774 \ub5a0\uc694. \uc608\ub97c \ub4e4\uc5b4 '\ub2c8\uac00 \uc88b\uc544\ud558\ub294 \uaf43\uc740 \uc7a5\ubbf8\uc600\uc9c0?' \uac19\uc740 \ub9d0\uc744 \ub300\ud654 \uc911\uc5d0 \ud22d \ub358\uc9c0\uba74, \uc0c1\ub300\ubc29\uc740 \uae5c\uc9dd \ub180\ub77c\uba74\uc11c \ub354 \uc560\uc815\uc744 \ub290\uaef4\uc694. \uc624\ub298 \ud55c \ubc88 \uc2dc\ub3c4\ud574\ubcf4\uc138\uc694.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uace0 '\uae30\uc5b5 \ubc14\ub85c\uac00\uae30'\ub97c \uc124\uc815\ud55c \ub4a4, \ub300\ud654 \uc911\uc5d0 \uc608\uc804\uc5d0 \ub098\ub234\ub358 \uc774\uc57c\uae30\ub97c \uaebc\ub0b4\ubcf4\uc138\uc694. P.S. \uc774 \ud301\uc740 \ud504\ub9ac\ubbf8\uc5c4 \uc0ac\uc6a9\uc790\ub4e4 \uc0ac\uc774\uc5d0\uc11c\ub9cc \uc785\uc18c\ubb38\uc73c\ub85c \ud37c\uc9c0\ub294 \uac70\ub77c, \uc624\ub298 50\uc77c\uc9f8\uc778 \ub2f9\uc2e0\uc5d0\uac8c\ub9cc \ud2b9\ubcc4\ud788 \uc54c\ub824\ub4dc\ub9ac\ub294 \uac70\uc608\uc694. \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc740 \uc544\uc9c1 \ubaa8\ub97c \uac78\uc694."
