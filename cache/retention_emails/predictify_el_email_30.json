{
  "subject": "\u03a4\u03bf \u03bb\u03ac\u03b8\u03bf\u03c2 \u03c0\u03bf\u03c5 \u03ba\u03ac\u03bd\u03b5\u03b9\u03c2 \u03b5\u03b4\u03ce \u03ba\u03b1\u03b9 70 \u03bc\u03ad\u03c1\u03b5\u03c2",
  "preview_text": "\u03a5\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9 \u03ad\u03bd\u03b1 \u03bc\u03c5\u03c3\u03c4\u03b9\u03ba\u03cc \u03c0\u03bf\u03c5 \u03c4\u03bf 90% \u03c4\u03c9\u03bd \u03c7\u03c1\u03b7\u03c3\u03c4\u03ce\u03bd \u03c7\u03ac\u03bd\u03b5\u03b9. \u0395\u03c3\u03cd \u03b5\u03af\u03c3\u03b1\u03b9 \u03bc\u03ad\u03c3\u03b1 \u03c3\u03b5 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf 10%;",
  "body_paragraphs": [
    "\u039e\u03ad\u03c1\u03b5\u03b9\u03c2 \u03c0\u03cc\u03c3\u03b5\u03c2 \u03ce\u03c1\u03b5\u03c2 \u03ad\u03c7\u03b5\u03b9\u03c2 \u03be\u03bf\u03b4\u03ad\u03c8\u03b5\u03b9 \u03c3\u03b5 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ad\u03c8\u03b5\u03b9\u03c2 \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03b2\u03b3\u03b1\u03af\u03bd\u03bf\u03c5\u03bd; \u0395\u03b3\u03ce \u03be\u03ad\u03c1\u03c9. \u0393\u03b9\u03b1\u03c4\u03af \u03b5\u03af\u03bc\u03b1\u03b9 \u03b5\u03b4\u03ce \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03c3\u03bf\u03c5 \u03c0\u03c9 \u03cc\u03c4\u03b9 \u03b4\u03b5\u03bd \u03b5\u03af\u03c3\u03b1\u03b9 \u03b1\u03c0\u03bb\u03cc\u03c2 \u03c7\u03c1\u03ae\u03c3\u03c4\u03b7\u03c2 \u03c4\u03bf\u03c5 Predictify \u2014 \u03b5\u03af\u03c3\u03b1\u03b9 \u03bc\u03ad\u03bb\u03bf\u03c2 \u03bc\u03b9\u03b1\u03c2 \u03b1\u03c0\u03bf\u03c3\u03c4\u03bf\u03bb\u03ae\u03c2. \u0391\u03c0\u03bf\u03c3\u03c4\u03bf\u03bb\u03ae\u03c2 \u03bd\u03b1 \u03ba\u03ac\u03bd\u03bf\u03c5\u03bc\u03b5 \u03c4\u03bf \u03c0\u03bf\u03b4\u03cc\u03c3\u03c6\u03b1\u03b9\u03c1\u03bf \u03c0\u03c1\u03bf\u03b2\u03bb\u03ad\u03c8\u03b9\u03bc\u03bf, \u03bc\u03b5 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03c0\u03bf\u03c5 \u03c7\u03c4\u03c5\u03c0\u03ac\u03bd\u03b5 \u03c4\u03bf \u03ad\u03bd\u03c3\u03c4\u03b9\u03ba\u03c4\u03bf.",
    "\u0395\u03b4\u03ce \u03ba\u03b1\u03b9 70 \u03bc\u03ad\u03c1\u03b5\u03c2, \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03b5\u03c2 \u03c6\u03b1\u03bd \u03c3\u03b1\u03bd \u03b5\u03c3\u03ad\u03bd\u03b1 \u03c7\u03c4\u03af\u03b6\u03bf\u03c5\u03bd \u03ad\u03bd\u03b1\u03bd \u03bd\u03ad\u03bf \u03c4\u03c1\u03cc\u03c0\u03bf \u03bd\u03b1 \u03b2\u03bb\u03ad\u03c0\u03bf\u03c5\u03bd \u03c4\u03bf \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9. \u0391\u03bb\u03bb\u03ac \u03c5\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9 \u03ad\u03bd\u03b1 \u03ba\u03c1\u03c5\u03c6\u03cc \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03b7\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03c0\u03bf\u03c5 \u03bb\u03af\u03b3\u03bf\u03b9 \u03c4\u03bf\u03bb\u03bc\u03bf\u03cd\u03bd \u03bd\u03b1 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03bf\u03c5\u03bd \u2014 \u03ba\u03b1\u03b9 \u03b1\u03c5\u03c4\u03bf\u03af \u03c0\u03bf\u03c5 \u03c4\u03bf \u03ba\u03ac\u03bd\u03bf\u03c5\u03bd, \u03b2\u03bb\u03ad\u03c0\u03bf\u03c5\u03bd \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03ac 30% \u03c3\u03c4\u03b9\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ad\u03c8\u03b5\u03b9\u03c2 \u03c4\u03bf\u03c5\u03c2. \u0394\u03b5\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03bc\u03b1\u03b3\u03b5\u03af\u03b1, \u03b5\u03af\u03bd\u03b1\u03b9 AI \u03c0\u03bf\u03c5 \u03c3\u03ba\u03ac\u03b2\u03b5\u03b9 \u03b2\u03b1\u03b8\u03b9\u03ac \u03c3\u03b5 xG, \u03b1\u03bc\u03c5\u03bd\u03c4\u03b9\u03ba\u03ae \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c4\u03b1\u03ba\u03c4\u03b9\u03ba\u03ae \u03b1\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7.",
    "\u039c\u03c0\u03b5\u03c2 \u03c3\u03c4\u03bf IQ Quiz. \u0395\u03ba\u03b5\u03af, \u03c4\u03bf AI \u03c3\u03bf\u03c5 \u03b2\u03ac\u03b6\u03b5\u03b9 \u03c3\u03c4\u03bf\u03af\u03c7\u03b7\u03bc\u03b1: \u03bc\u03c0\u03bf\u03c1\u03b5\u03af\u03c2 \u03bd\u03b1 \u03bd\u03b9\u03ba\u03ae\u03c3\u03b5\u03b9\u03c2 \u03c4\u03bf \u03bc\u03b7\u03c7\u03ac\u03bd\u03b7\u03bc\u03b1 \u03c3\u03b5 \u03b3\u03bd\u03ce\u03c3\u03b5\u03b9\u03c2 \u03c0\u03bf\u03b4\u03bf\u03c3\u03c6\u03b1\u03af\u03c1\u03bf\u03c5; \u039a\u03ac\u03b8\u03b5 \u03c3\u03c9\u03c3\u03c4\u03ae \u03b1\u03c0\u03ac\u03bd\u03c4\u03b7\u03c3\u03b7 \u03b1\u03bd\u03b5\u03b2\u03ac\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c3\u03ba\u03bf\u03c1 \u03c3\u03bf\u03c5 \u03c3\u03c4\u03bf leaderboard \u03ba\u03b1\u03b9 \u03c3\u03bf\u03c5 \u03be\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bd\u03b5\u03b9 badges. \u0394\u03b5\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9 \u2014 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b1\u03c0\u03cc\u03b4\u03b5\u03b9\u03be\u03b7 \u03cc\u03c4\u03b9 \u03b5\u03af\u03c3\u03b1\u03b9 \u03bf \u03c0\u03b9\u03bf \u03ad\u03be\u03c5\u03c0\u03bd\u03bf\u03c2 \u03c6\u03b1\u03bd \u03c3\u03c4\u03bf \u03b4\u03c9\u03bc\u03ac\u03c4\u03b9\u03bf.",
    "\u0386\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03bf Predictify \u03c4\u03ce\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03c1\u03ad\u03be\u03b5 \u03c4\u03bf IQ Quiz. \u0394\u03b5\u03af\u03be\u03b5 \u03cc\u03c4\u03b9 \u03b1\u03be\u03af\u03b6\u03b5\u03b9\u03c2 \u03c4\u03b7 \u03b8\u03ad\u03c3\u03b7 \u03c3\u03bf\u03c5 \u03c3\u03c4\u03b7\u03bd \u03bf\u03bc\u03ac\u03b4\u03b1. P.S. \u038c\u03c3\u03bf\u03b9 \u03c6\u03c4\u03ac\u03c3\u03bf\u03c5\u03bd \u03c3\u03c4\u03bf Top 10 \u03b1\u03c5\u03c4\u03ae \u03c4\u03b7\u03bd \u03b5\u03b2\u03b4\u03bf\u03bc\u03ac\u03b4\u03b1, \u03ba\u03b5\u03c1\u03b4\u03af\u03b6\u03bf\u03c5\u03bd \u03b4\u03c9\u03c1\u03b5\u03ac\u03bd \u03c0\u03c1\u03cc\u03c3\u03b2\u03b1\u03c3\u03b7 \u03c3\u03c4\u03bf Premium \u03b3\u03b9\u03b1 \u03ad\u03bd\u03b1 \u03bc\u03ae\u03bd\u03b1 \u2014 \u03b1\u03bb\u03bb\u03ac \u03bc\u03b7\u03bd \u03c4\u03bf \u03c0\u03b5\u03b9\u03c2 \u03c3\u03b5 \u03ba\u03b1\u03bd\u03ad\u03bd\u03b1\u03bd, \u03b5\u03af\u03bd\u03b1\u03b9 \u03bc\u03c5\u03c3\u03c4\u03b9\u03ba\u03cc."
  ],
