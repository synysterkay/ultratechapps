{
  "subject": "\u0627\u0644\u0633\u0631 \u0627\u0644\u0630\u064a \u0646\u0633\u062a\u062e\u062f\u0645\u0647 \u0644\u0640 4 \u0645\u0648\u0627\u0639\u064a\u062f \u0641\u064a \u0627\u0644\u0634\u0647\u0631",
  "preview_text": "\u0647\u0630\u0627 \u0627\u0644\u062e\u062f\u0639\u0629 \u0627\u0644\u0635\u063a\u064a\u0631\u0629 \u0633\u062a\u063a\u064a\u0631 \u0637\u0631\u064a\u0642\u0629 \u062a\u062e\u0637\u064a\u0637\u0643\u0645\u0627 \u0644\u0644\u0645\u0648\u0627\u0639\u064a\u062f. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0644\u064a\u0644\u0629.",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0623\u0646 \u0644\u062f\u064a\u0643\u0645 \u0645\u0648\u0639\u062f\u064a\u0646 \u0641\u064a \u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u062f\u0648\u0646 \u0623\u064a \u062a\u062e\u0637\u064a\u0637\u060c \u0648\u062f\u0648\u0646 \u0623\u0646 \u064a\u0634\u0639\u0631 \u0623\u062d\u062f\u0643\u0645\u0627 \u0628\u0627\u0644\u062a\u0642\u0635\u064a\u0631. \u0645\u0639\u0638\u0645 \u0627\u0644\u0623\u0632\u0648\u0627\u062c \u064a\u062e\u0637\u0637\u0648\u0646 \u0645\u0648\u0639\u062f\u064b\u0627 \u0648\u0627\u062d\u062f\u064b\u0627 \u0641\u0642\u0637 \u0641\u064a \u0627\u0644\u0634\u0647\u0631\u060c \u0644\u0643\u0646 \u0645\u0639 \u0647\u0630\u0647 \u0627\u0644\u062e\u062f\u0639\u0629\u060c \u064a\u0645\u0643\u0646\u0643\u0645 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 4 \u0645\u0648\u0627\u0639\u064a\u062f \u0628\u0633\u0647\u0648\u0644\u0629.",
    "\u0627\u0644\u0633\u0631 \u0647\u0648 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u064a\u0632\u0629 '\u0645\u0648\u0639\u062f \u0627\u0644\u0644\u064a\u0644\u0629' \u0628\u0637\u0631\u064a\u0642\u0629 \u0630\u0643\u064a\u0629: \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0627\u062e\u062a\u064a\u0627\u0631 \u0645\u0632\u0627\u062c \u0648\u0627\u062d\u062f\u060c \u0627\u062e\u062a\u0627\u0631\u0648\u0627 \u0645\u0632\u0627\u062c\u064a\u0646 \u0645\u062e\u062a\u0644\u0641\u064a\u0646 \u0643\u0644 \u0623\u0633\u0628\u0648\u0639\u064a\u0646. \u0645\u062b\u0644\u0627\u064b\u060c \u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0623\u0648\u0644 '\u0645\u063a\u0627\u0645\u0631'\u060c \u0648\u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u062b\u0627\u0646\u064a '\u062f\u0627\u0641\u0626'. \u0647\u0630\u0627 \u064a\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u0627\u0644\u0625\u062b\u0627\u0631\u0629 \u0648\u064a\u0645\u0646\u0639 \u0627\u0644\u0631\u0648\u062a\u064a\u0646.",
    "\u0641\u064a \u062a\u0637\u0628\u064a\u0642 SoulPlan\u060c \u0639\u0646\u062f\u0645\u0627 \u062a\u0641\u062a\u062d '\u0645\u0648\u0639\u062f \u0627\u0644\u0644\u064a\u0644\u0629' \u0648\u062a\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u0645\u0632\u0627\u062c\u060c \u064a\u062e\u062a\u0627\u0631 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0641\u0643\u0631\u0629 \u0645\u0648\u0639\u062f \u0645\u062b\u0627\u0644\u064a\u0629 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u062a\u0627\u0631\u064a\u062e\u0643\u0645\u0627. \u062b\u0645 \u0623\u0631\u0633\u0644\u0647\u0627 \u0644\u0634\u0631\u064a\u0643\u0643\u060c \u0648\u0634\u0627\u0647\u062f \u0627\u0644\u0644\u062d\u0638\u0629 \u0627\u0644\u062c\u0645\u064a\u0644\u0629 \u0639\u0646\u062f\u0645\u0627 \u062a\u0638\u0647\u0631 \u0644\u0647 \u0631\u0633\u0627\u0644\u0629 '\u0641\u0643\u0631\u062a \u0641\u064a\u0643 \u0627\u0644\u0644\u064a\u0644\u0629' \u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0643\u0627\u0645\u0644\u0629.",
    "\u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0644\u064a\u0644\u0629: \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u062e\u062a\u0631 \u0645\u0632\u0627\u062c\u064b\u0627 \u063a\u064a\u0631 \u0627\u0644\u0630\u064a \u0627\u0639\u062a\u062f\u062a\u0645\u0627 \u0639\u0644\u064a\u0647\u060c \u0648\u0623\u0631\u0633\u0644 \u0627\u0644\u0645\u0648\u0639\u062f. \u0633\u062a\u064f\u0641\u0627\u062c\u0623 \u0628\u0643\u0645 \u0627\u0644\u0631\u062f\u0648\u062f \u0627\u0644\u062d\u0645\u0627\u0633\u064a\u0629. P.S. \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0645\u0633\u062a\u0648\u062d\u0627\u0629 \u0645\u0646 \u0623\u0632\u0648\u0627\u062c \u064a\u062e\u0637\u0637\u0648\u0646 4 \u0645\u0648\u0627\u0639\u064a\u062f \u0634\u0647\u0631\u064a\u064b\u0627 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0627 \u0641\u0642\u0637."
  ],
