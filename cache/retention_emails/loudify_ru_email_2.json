{
  "subject": "\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e 80% \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u044e\u0442",
  "preview_text": "\u041e\u043d\u0430 \u0441\u043f\u0440\u044f\u0442\u0430\u043d\u0430, \u043d\u043e \u043c\u0435\u043d\u044f\u0435\u0442 \u0432\u0441\u0451. \u0423\u0437\u043d\u0430\u0439, \u043a\u0430\u043a \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0437\u0432\u0443\u043a \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u043c \u0437\u0430 10 \u0441\u0435\u043a\u0443\u043d\u0434.",
  "body_paragraphs": [
    "\u0422\u044b \u0441\u043a\u0430\u0447\u0430\u043b Loudify, \u0432\u043a\u043b\u044e\u0447\u0438\u043b \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c, \u0438... \u0434\u0430, \u0441\u0442\u0430\u043b\u043e \u0433\u0440\u043e\u043c\u0447\u0435. \u041d\u043e \u0442\u044b \u043d\u0435 \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u043e\u0434\u043d\u0443 \u0432\u0435\u0449\u044c. \u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0442 \u043c\u0438\u043c\u043e \u043d\u0435\u0451, \u0430 \u043e\u043d\u0430 \u2014 \u0441\u0435\u0440\u0434\u0446\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f. \u042f \u0441\u0430\u043c \u0447\u0443\u0442\u044c \u043d\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u043b, \u043a\u043e\u0433\u0434\u0430 \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043b \u043f\u0435\u0440\u0432\u0443\u044e \u0432\u0435\u0440\u0441\u0438\u044e.",
    "\u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044c: \u0442\u044b \u0432 \u043c\u0435\u0442\u0440\u043e, \u043f\u043e\u0435\u0437\u0434 \u0448\u0443\u043c\u0438\u0442, \u0434\u0438\u0430\u043b\u043e\u0433 \u0432 \u043f\u043e\u0434\u043a\u0430\u0441\u0442\u0435 \u0442\u043e\u043d\u0435\u0442. \u0422\u044b \u0436\u043c\u0451\u0448\u044c \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0434\u043e \u0443\u043f\u043e\u0440\u0430, \u043d\u043e \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f. Generic-\u0443\u0441\u0438\u043b\u0438\u0442\u0435\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u044e\u0442 \u0448\u0443\u043c. \u041d\u043e Loudify \u0443\u043c\u0435\u0435\u0442 \u0438\u043d\u0430\u0447\u0435. \u0422\u0430\u043c \u0435\u0441\u0442\u044c \u0444\u0443\u043d\u043a\u0446\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0434\u0435\u043b\u0430\u0435\u0442 \u0437\u0432\u0443\u043a \u0447\u0438\u0441\u0442\u044b\u043c \u0438 \u043c\u043e\u0449\u043d\u044b\u043c, \u0434\u0430\u0436\u0435 \u043a\u043e\u0433\u0434\u0430 \u0432\u043e\u043a\u0440\u0443\u0433 \u0430\u0434.",
    "\u0420\u0435\u0447\u044c \u043e\u0431 AutoEQ. \u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440. \u041e\u043d \u0437\u043d\u0430\u0435\u0442 \u0442\u0432\u043e\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438 \u2014 \u043c\u043e\u0434\u0435\u043b\u044c, \u0447\u0430\u0441\u0442\u043e\u0442\u044b, \u0441\u043b\u0430\u0431\u044b\u0435 \u043c\u0435\u0441\u0442\u0430. \u041a\u0430\u043a \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u044b \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0430\u0435\u0448\u044c \u0438\u0445, \u043e\u043d \u0441\u0430\u043c \u043f\u043e\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0437\u0432\u0443\u043a. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a, \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0437\u0430\u043c\u043e\u0440\u043e\u0447\u0435\u043a. \u041f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0437\u0432\u0443\u0447\u0430\u0442 \u0442\u0430\u043a, \u0431\u0443\u0434\u0442\u043e \u0442\u044b \u0432 \u0441\u0442\u0443\u0434\u0438\u0438. \u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043d\u0430\u0436\u043c\u0438 \u043d\u0430 \u0437\u043d\u0430\u0447\u043e\u043a \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u043e\u0432 \u0432 \u0432\u0435\u0440\u0445\u043d\u0435\u043c \u0443\u0433\u043b\u0443 \u2014 \u0438 \u0432\u044b\u0431\u0435\u0440\u0438 \u0441\u0432\u043e\u044e \u043c\u043e\u0434\u0435\u043b\u044c \u0438\u0437 \u0441\u043f\u0438\u0441\u043a\u0430. \u0423\u0432\u0438\u0434\u0438\u0448\u044c \u0440\u0430\u0437\u043d\u0438\u0446\u0443 \u0441\u0440\u0430\u0437\u0443.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Loudify \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 AutoEQ. \u042d\u0442\u043e \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e \u043d\u0430 7 \u0434\u043d\u0435\u0439. P.S. \u041f\u043e\u0441\u043b\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0437\u0430\u0433\u043b\u044f\u043d\u0438 \u0432 Sound DNA \u2014 \u043e\u043d \u043f\u043e\u043a\u0430\u0436\u0435\u0442, \u043a\u0430\u043a \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0441\u044f \u0442\u0432\u043e\u0439 \u0437\u0432\u0443\u043a \u0437\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f. \u0421\u043f\u043e\u0439\u043b\u0435\u0440: \u0442\u044b \u0443\u0434\u0438\u0432\u0438\u0448\u044c\u0441\u044f."
  ],
