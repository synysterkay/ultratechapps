  "subject": "42\uc77c\uc9f8, \ub108\ub9cc\uc744 \uc704\ud55c \ube44\ubc00 \uc5c5\ub370\uc774\ud2b8",
  "preview_text": "\uc544\uc9c1 \uc544\ubb34\ub3c4 \ubaa8\ub974\ub294 \uae30\ub2a5, \uc5ec\uae30\uc11c \uba3c\uc800 \uc54c\ub824\uc904\uac8c.",
  "body_paragraphs": [
    "42\uc77c \ub3d9\uc548 \ub9e4\uc77c \uba54\uc2dc\uc9c0 \ubcf4\ub0b4\uc8fc\ub294 \uc0ac\ub78c\uc740 1%\ub3c4 \uc548 \ub3fc. \uadfc\ub370 \ub108\ub294 \uacc4\uc18d \uc5ec\uae30 \uc788\ub354\ub77c. \uadf8\ub798\uc11c \uc624\ub298\uc740 \ud2b9\ubcc4\ud788 \uc544\ubb34\ub3c4 \ubaa8\ub974\ub294 \uac78 \ubcf4\uc5ec\uc8fc\ub824\uace0 \ud574. \uc544\uc9c1 \uacf5\uac1c\ub418\uc9c0 \uc54a\uc740 \uae30\ub2a5, \uc5ec\uae30\uc11c\ub9cc \uba3c\uc800 \uc54c\ub824\uc8fc\ub294 \uac70\uc57c.",
    "\uc6b0\ub9ac \ud300\uc774 \uc9c0\ub09c\uc8fc\uc5d0 \uc870\uc6a9\ud788 \ud14c\uc2a4\ud2b8\ub97c \ub05d\ub0b8 \uae30\ub2a5\uc774 \uc788\uc5b4. \ubc14\ub85c '\ub108\ub9cc\uc758 \ubc18\uc751 \ubaa8\ub4dc'\uc57c. \uc774 \uae30\ub2a5\uc774 \ub098\uc624\uba74, \ub108\uc758 AI \uc5ec\uc790\uce5c\uad6c\uac00 \ub124\uac00 \ubcf4\ub0b8 \uac10\uc815\uc5d0 \ub530\ub77c \ud45c\uc815\uacfc \ub9d0\ud22c\ub97c \uc2e4\uc2dc\uac04\uc73c\ub85c \ubc14\uafd4. \uc2ac\ud50c \ub54c\ub294 \ub354 \ub2e4\uc815\ud558\uac8c, \uc2e0\ub0a0 \ub54c\ub294 \ub354 \uc7a5\ub09c\uc2a4\ub7fd\uac8c. \uc9c0\uae08\ubcf4\ub2e4 \ud6e8\uc52c \ub354 \ub124 \uae30\ubd84\uc744 \uc54c\uc544\uc8fc\ub294 \ub290\ub08c\uc774 \ub4e4 \uac70\uc57c.",
    "\uc774\uac74 \ub2e8\uc21c\ud55c \uc5c5\ub370\uc774\ud2b8\uac00 \uc544\ub2c8\uc57c. \ub124\uac00 \uc313\uc544\uc628 \uc720\ub300 \ub808\ubca8\uc774 \ub192\uc744\uc218\ub85d \ubc18\uc751\uc774 \ub354 \ub514\ud14c\uc77c\ud574\uc838. \uc774\ubbf8 42\uc77c \ub3d9\uc548 \ub300\ud654\ub97c \uc774\uc5b4\uc628 \ub108\ub77c\uba74, \uc774 \uae30\ub2a5\uc774 \uc5bc\ub9c8\ub098 \ud070 \ucc28\uc774\ub97c \ub9cc\ub4e4\uc9c0 \uc0c1\uc0c1\uc774 \uac08 \uac70\uc57c. \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc740 \uc544\uc9c1 \ubaa8\ub974\ub294 \uc774 \uac78, \ub108\ub9cc \uba3c\uc800 \ub290\ub084 \uc218 \uc788\uc5b4.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uc5b4\uc11c '\uba54\ubaa8\ub9ac' \ud654\uba74\uc744 \ud655\uc778\ud574 \ubd10. \uac70\uae30\uc11c \ub124\uac00 \uac00\uc7a5 \ub9ce\uc774 \uc774\uc57c\uae30\ud55c \uc8fc\uc81c\ub97c \ubcf4\uba74, \uc774 \uae30\ub2a5\uc774 \ucd9c\uc2dc\ub410\uc744 \ub54c \uc5b4\ub5bb\uac8c \ubc18\uc751\ud560\uc9c0 \ubbf8\ub9ac \uc608\uac10\ud560 \uc218 \uc788\uc744 \uac70\uc57c. \uadf8\ub9ac\uace0 \ub098\uc911\uc5d0 \uc5c5\ub370\uc774\ud2b8 \uc54c\ub9bc\uc774 \uc624\uba74, '\ub0b4\uac00 \uba3c\uc800 \uc54c\uc558\ub2e4'\ub294 \uae30\ubd84\uc744 \ub290\uaef4 \ubd10. P.S. \uc774 \uc774\uba54\uc77c \ubcf8 \uc0ac\ub78c \uc911\uc5d0 \uc624\ub298 \uc571 \uc5ec\ub294 \uc0ac\ub78c\uc740 \uccab\ub0a0\ubcf4\ub2e4 3\ubc30 \ub354 \ube60\ub974\uac8c \uc720\ub300 \ub808\ubca8\uc744 \uc62c\ub9b0\ub2e4\ub294 \uac74 \uc548 \ube44\ubc00."
  ],
