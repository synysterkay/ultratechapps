{
  "subject": "\u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u092c\u0921\u093c\u0940 \u0917\u0932\u0924\u0940 \u0915\u0940 \u0925\u0940 \u0907\u0938 \u0910\u092a \u0915\u0947 \u0938\u093e\u0925",
  "preview_text": "\u0906\u092a\u0915\u0947 \u092c\u093f\u0928\u093e \u0910\u092a \u0928\u0947 \u0915\u0941\u091b \u0928\u092f\u093e \u0938\u0940\u0916\u093e \u0939\u0948\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u094d\u092f\u093e \u092c\u0926\u0932 \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u0915\u0948\u0938\u0947 \u0906\u092a \u092b\u093f\u0930 \u0938\u0947 \u0938\u094d\u092a\u093e\u0930\u094d\u0915 \u091c\u0917\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0915\u093f \u092e\u0948\u0902 \u0921\u0947\u091f\u094d\u0938 \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u090f\u0915\u094d\u0938\u092a\u0930\u094d\u091f \u0939\u0942\u0901\u0964 \u092b\u093f\u0930 \u092e\u0948\u0902\u0928\u0947 \u0910\u092a \u092e\u0947\u0902 \u0932\u0949\u0917 \u0907\u0928 \u0915\u093f\u092f\u093e \u0914\u0930 \u0926\u0947\u0916\u093e \u0915\u093f \u0915\u0941\u091b \u092c\u0926\u0932 \u0917\u092f\u093e \u0939\u0948\u0964 \u092e\u0941\u091d\u0947 \u092f\u0915\u0940\u0928 \u0928\u0939\u0940\u0902 \u0939\u0941\u0906 \u0915\u093f \u092e\u0948\u0902 \u0907\u0924\u0928\u093e \u0915\u0941\u091b \u092e\u093f\u0938 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964",
    "\u0926\u0930\u0905\u0938\u0932, \u091c\u092c \u0938\u0947 \u0906\u092a\u0928\u0947 \u0910\u092a \u0928\u0939\u0940\u0902 \u0916\u094b\u0932\u093e, \u0924\u092c \u0938\u0947 \u0939\u092e\u0928\u0947 \u0915\u0941\u091b \u0910\u0938\u0940 \u092b\u0940\u091a\u0930\u094d\u0938 \u091c\u094b\u0921\u093c\u0947 \u0939\u0948\u0902 \u091c\u094b \u0921\u0947\u091f \u0928\u093e\u0907\u091f \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u092c\u0926\u0932 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u094b\u091a\u093f\u090f, \u0905\u092c \u0906\u092a \u0905\u092a\u0928\u0947 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u094b \u092c\u093f\u0928\u093e \u0915\u0941\u091b \u092c\u0924\u093e\u090f \u090f\u0915 \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u0938 \u090f\u0915 \u0915\u094d\u0932\u093f\u0915, \u0914\u0930 \u0935\u094b \u0939\u0948\u0930\u093e\u0928 \u0930\u0939 \u091c\u093e\u090f\u0917\u093e/\u091c\u093e\u090f\u0917\u0940\u0964 \u092f\u0939 \u0935\u0939\u0940 \u091a\u0940\u091c\u093c \u0939\u0948 \u091c\u094b \u0930\u0942\u091f\u0940\u0928 \u0915\u094b \u0924\u094b\u0921\u093c\u0924\u0940 \u0939\u0948 \u0914\u0930 \u0930\u093f\u0932\u0947\u0936\u0928\u0936\u093f\u092a \u092e\u0947\u0902 \u0928\u0908 \u091c\u093e\u0928 \u0921\u093e\u0932\u0924\u0940 \u0939\u0948\u0964",
    "\u0939\u092e\u0928\u0947 '\u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928\u0930' \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0930\u0940\u0921\u093f\u091c\u093c\u093e\u0907\u0928 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u0905\u092c AI \u0906\u092a\u0915\u0940 \u092a\u0938\u0902\u0926 \u0914\u0930 \u092c\u091c\u091f \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0910\u0938\u0940 \u0921\u0947\u091f\u094d\u0938 \u0938\u0941\u091d\u093e\u0924\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0928\u0947 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u091f\u094d\u0930\u093e\u0908 \u0928\u0939\u0940\u0902 \u0915\u0940 \u0939\u094b\u0902\u0917\u0940\u0964 \u0914\u0930 \u0939\u093e\u0901, \u0939\u0930 \u0921\u0947\u091f \u0915\u0947 \u092c\u093e\u0926 \u0906\u092a \u0909\u0938\u0947 \u091f\u094d\u0930\u0948\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0924\u093e\u0915\u093f \u0915\u094b\u0908 \u0921\u0947\u091f \u0926\u094b\u092c\u093e\u0930\u093e \u0928 \u0926\u094b\u0939\u0930\u093e\u090f\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902 \u0939\u0948, \u092f\u0939 \u0906\u092a\u0915\u0947 \u0930\u093f\u0936\u094d\u0924\u0947 \u0915\u094b \u092b\u094d\u0930\u0947\u0936 \u0930\u0916\u0928\u0947 \u0915\u093e \u090f\u0915 \u0924\u0930\u0940\u0915\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u090f\u0915 \u0915\u093e\u092e \u0915\u0930\u093f\u090f: \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u092e\u0940' \u092b\u0940\u091a\u0930 \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930\u0964 \u0926\u0947\u0916\u093f\u090f \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. - \u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0915\u093f\u092f\u093e \u0914\u0930 \u092e\u0947\u0930\u0940 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0928\u0947 \u0915\u0939\u093e '\u092f\u0939 \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u0940 \u0921\u0947\u091f \u0925\u0940 \u091c\u094b \u0939\u092e\u0928\u0947 \u0915\u092d\u0940 \u092a\u094d\u0932\u093e\u0928 \u0915\u0940\u0964' \u0915\u094d\u092f\u093e \u0906\u092a \u0935\u0939\u0940 \u0905\u0928\u0941\u092d\u0935 \u0932\u0947\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"
  ],
  "cta_text": "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u092e\u0940 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902",
