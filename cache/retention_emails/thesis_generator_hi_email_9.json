  "body_paragraphs": [
    "\u092e\u0941\u091d\u0947 \u092a\u0924\u093e \u0939\u0948 \u0906\u092a \u0905\u092d\u0940 \u092d\u0940 \u0921\u0947\u0921\u0932\u093e\u0907\u0928 \u0915\u0947 \u0921\u0930 \u0938\u0947 \u091c\u0942\u091d \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u0915\u094d\u092f\u093e \u0906\u092a\u0928\u0947 \u0915\u092d\u0940 \u0938\u094b\u091a\u093e \u0939\u0948 \u0915\u093f \u0938\u093f\u0930\u094d\u092b 3 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0906\u092a \u0905\u092a\u0928\u093e \u092a\u0942\u0930\u093e \u092a\u0947\u092a\u0930 \u0932\u093f\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902? \u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u091a\u0948\u0932\u0947\u0902\u091c \u0916\u0941\u0926 \u091f\u094d\u0930\u093e\u0908 \u0915\u093f\u092f\u093e \u0914\u0930 \u0939\u0948\u0930\u093e\u0928 \u0930\u0939 \u0917\u092f\u093e\u0964",
