{
  "subject": "\u0924\u0940\u0928 \u0926\u093f\u0928, \u0924\u0940\u0928 \u0925\u0940\u0938\u093f\u0938 \u2013 \u0926\u0947\u0916\u094b \u092b\u0930\u094d\u0915",
  "preview_text": "\u0938\u093f\u0930\u094d\u092b 3 \u0926\u093f\u0928 \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b \u092c\u0926\u0932\u094b\u0964 50,000 \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0928\u0947 \u092f\u0947 \u091a\u0948\u0932\u0947\u0902\u091c \u0915\u093f\u092f\u093e, \u0905\u092c \u0924\u0941\u092e \u0915\u0930\u094b\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u094b \u0930\u093e\u0924 \u091c\u092c \u0924\u0941\u092e \u0916\u093e\u0932\u0940 \u092a\u0947\u091c \u0915\u094b \u0918\u0942\u0930 \u0930\u0939\u0947 \u0925\u0947 \u0914\u0930 \u0921\u0947\u0921\u0932\u093e\u0907\u0928 \u0938\u093f\u0930 \u092a\u0930 \u0925\u0940? \u092e\u0948\u0902 \u0935\u0939\u093e\u0901 \u0925\u093e \u2013 \u0914\u0930 \u092e\u0948\u0902\u0928\u0947 \u0915\u0941\u091b \u0905\u0932\u0917 \u0915\u0930\u0928\u0947 \u0915\u093e \u092b\u0948\u0938\u0932\u093e \u0915\u093f\u092f\u093e\u0964 \u0906\u091c \u092e\u0948\u0902 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u090f\u0915 3-\u0926\u093f\u0928 \u0915\u093e \u091a\u0948\u0932\u0947\u0902\u091c \u0926\u0947 \u0930\u0939\u093e \u0939\u0942\u0901 \u091c\u094b \u092e\u0947\u0930\u093e \u0917\u094d\u0930\u0947\u0921 B+ \u0938\u0947 A- \u092e\u0947\u0902 \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964 \u092c\u0938 \u0924\u0940\u0928 \u0926\u093f\u0928, \u0930\u094b\u091c\u093c \u090f\u0915 \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u092c\u0928\u093e\u0913, \u0914\u0930 \u0916\u0941\u0926 \u0926\u0947\u0916\u094b \u0915\u094d\u092f\u093e \u092c\u0926\u0932\u0924\u093e \u0939\u0948\u0964",
    "\u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0932\u0917\u0947\u0917\u093e \u092f\u0947 \u0924\u094b \u0906\u0938\u093e\u0928 \u0939\u0948\u0964 \u0926\u0942\u0938\u0930\u0947 \u0926\u093f\u0928 \u0924\u0941\u092e \u092a\u093e\u0913\u0917\u0947 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0925\u0940\u0938\u093f\u0938 \u092a\u0939\u0932\u0947 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0938\u091f\u0940\u0915 \u0914\u0930 \u0936\u0915\u094d\u0924\u093f\u0936\u093e\u0932\u0940 \u0939\u0948\u0964 \u0924\u0940\u0938\u0930\u0947 \u0926\u093f\u0928 \u2013 \u091c\u092c \u0924\u0941\u092e \u0905\u092a\u0928\u0940 \u092b\u093e\u0907\u0928\u0932 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b \u092a\u0949\u0932\u093f\u0936\u094d\u0921 PDF \u092e\u0947\u0902 \u090f\u0915\u094d\u0938\u092a\u094b\u0930\u094d\u091f \u0915\u0930\u094b\u0917\u0947 \u2013 \u0924\u0941\u092e \u0938\u092e\u091d \u091c\u093e\u0913\u0917\u0947 \u0915\u093f \u0915\u094d\u092f\u094b\u0902 50,000 \u091b\u093e\u0924\u094d\u0930 \u0907\u0938 \u0910\u092a \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0921\u0947\u0921\u0932\u093e\u0907\u0928 \u092a\u0948\u0928\u093f\u0915 \u0914\u0930 \u0907\u092e\u094d\u092a\u094b\u0938\u094d\u091f\u0930 \u0938\u093f\u0902\u0921\u094d\u0930\u094b\u092e \u0915\u094b \u0905\u0932\u0935\u093f\u0926\u093e \u0915\u0939\u094b\u0964",
    "\u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930 \u0915\u0940 \u0916\u093e\u0938 \u092c\u093e\u0924 \u092f\u0947 \u0939\u0948 \u0915\u093f \u092f\u0947 \u0938\u093f\u0930\u094d\u092b 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0935\u094b \u0925\u0940\u0938\u093f\u0938 \u092c\u0928\u093e \u0926\u0947\u0924\u093e \u0939\u0948 \u091c\u094b \u092a\u0939\u0932\u0947 8 \u0918\u0902\u091f\u0947 \u0932\u0947\u0924\u0940 \u0925\u0940\u0964 \u0911\u091f\u094b-\u091c\u0928\u0930\u0947\u091f\u0947\u0921 \u0917\u094d\u0930\u093e\u092b, \u091f\u0947\u092c\u0932, \u0914\u0930 \u0938\u093e\u0907\u091f\u0947\u0936\u0928 \u2013 \u0938\u092c \u0915\u0941\u091b \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u092e\u0947\u0902\u0964 \u0914\u0930 \u0939\u093e\u0901, AI \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0915\u094b \u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c \u0915\u0930\u0915\u0947 Turnitin/GPTZero \u0915\u094b \u092c\u093e\u092f\u092a\u093e\u0938 \u0915\u0930\u0928\u093e \u092d\u0940 \u0906\u0938\u093e\u0928 \u0939\u0948\u0964 \u092f\u0947 \u091a\u0948\u0932\u0947\u0902\u091c \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0926\u093f\u0916\u093e\u090f\u0917\u093e \u0915\u093f \u0924\u0941\u092e \u0915\u093f\u0924\u0928\u0940 \u091c\u0932\u094d\u0926\u0940 \u0914\u0930 \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0932\u093f\u0916 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964",
    "\u0905\u092c \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u0925\u094d\u0930\u0940-\u0921\u0947 \u091a\u0948\u0932\u0947\u0902\u091c' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u094b\u0964 \u092a\u0939\u0932\u0940 \u0925\u0940\u0938\u093f\u0938 \u0906\u091c \u0939\u0940 \u092c\u0928\u093e\u0913\u0964 P.S. \u2013 \u091c\u094b \u0932\u094b\u0917 \u092f\u0947 \u091a\u0948\u0932\u0947\u0902\u091c \u092a\u0942\u0930\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u0915\u0947 \u0917\u094d\u0930\u0947\u0921 \u092e\u0947\u0902 \u0914\u0938\u0924\u0928 \u090f\u0915 \u0917\u094d\u0930\u0947\u0921 \u0915\u093e \u0938\u0941\u0927\u093e\u0930 \u0906\u0924\u093e \u0939\u0948\u0964 \u0924\u0941\u092e \u092d\u0940 \u0935\u094b \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964"
  ],
