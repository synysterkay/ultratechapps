{
  "subject": "3 \u0926\u093f\u0928 \u0915\u093e \u091a\u0948\u0932\u0947\u0902\u091c, \u0905\u092a\u0928\u0947 \u0915\u093e\u0928 \u092c\u0926\u0932 \u0926\u0947\u0902\u0917\u0947",
  "preview_text": "\u0915\u094d\u092f\u093e \u0906\u092a\u0915\u0940 \u0911\u0921\u093f\u092f\u094b \u0905\u092c \u092d\u0940 \u0915\u092e\u091c\u093c\u094b\u0930 \u0939\u0948? 3 \u0926\u093f\u0928 \u092e\u0947\u0902 \u092b\u0930\u094d\u0915 \u0926\u0947\u0916\u0947\u0902\u0964",
  "body_paragraphs": [
    "\u092e\u0948\u0902 \u091c\u093e\u0928\u0924\u093e \u0939\u0942\u0901, \u0906\u092a\u0928\u0947 Loud EQ \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0914\u0930 \u0936\u093e\u092f\u0926 \u090f\u0915 \u092c\u093e\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0915\u094d\u092f\u093e \u0906\u092a\u0928\u0947 \u0938\u091a \u092e\u0947\u0902 \u0935\u094b \u092b\u0930\u094d\u0915 \u0926\u0947\u0916\u093e \u091c\u094b \u092f\u0939 \u0910\u092a \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948? \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u091a\u0948\u0932\u0947\u0902\u091c \u0932\u0947\u0902: \u0905\u0917\u0932\u0947 3 \u0926\u093f\u0928, \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0906\u092a \u0915\u092e\u094d\u092f\u0942\u091f \u0915\u0930\u0947\u0902 \u092f\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u0947\u0902, \u0924\u094b Loud EQ \u0915\u093e 'Optimize' \u092c\u091f\u0928 \u0926\u092c\u093e\u090f\u0902\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a\u0964",
    "\u0924\u0940\u0938\u0930\u0947 \u0926\u093f\u0928, \u0906\u092a \u0916\u0941\u0926 \u0915\u094b \u092a\u093e\u090f\u0902\u0917\u0947 \u0915\u093f \u0906\u092a \u0935\u0949\u0932\u094d\u092f\u0942\u092e 100% \u092a\u0930 \u0928\u0939\u0940\u0902 \u0932\u0947 \u091c\u093e \u0930\u0939\u0947\u0964 \u0906\u0935\u093e\u091c\u093c \u0938\u093e\u092b\u093c \u0914\u0930 \u0924\u0947\u091c\u093c \u0939\u094b\u0917\u0940, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0915\u0947\u0964 \u0930\u094b\u0921 \u0928\u0949\u0907\u091c\u093c \u092e\u0947\u0902 \u092d\u0940 \u0939\u0930 \u0936\u092c\u094d\u0926 \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0917\u093e\u0964 \u092f\u0939 \u0915\u094b\u0908 \u092e\u093e\u0930\u094d\u0915\u0947\u091f\u093f\u0902\u0917 \u0928\u0939\u0940\u0902, \u092f\u0939 \u090f\u0915 \u0935\u093e\u0926\u093e \u0939\u0948: \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924 \u092c\u0926\u0932 \u091c\u093e\u090f\u0917\u0940\u0964",
    "\u092f\u0939 \u0938\u092c 'One-tap Optimize' \u092b\u0940\u091a\u0930 \u0938\u0947 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u091c\u0948\u0938\u0947 \u0939\u0940 \u0906\u092a \u0905\u092a\u0928\u0947 AirPods \u092f\u093e \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0910\u092a \u0905\u092a\u0928\u0947 \u0906\u092a \u091f\u094d\u092f\u0942\u0928 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 5-band EQ \u0914\u0930 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932\u094d\u0938 (\u092e\u094d\u092f\u0942\u091c\u093c\u093f\u0915, \u092e\u0942\u0935\u0940, \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f, \u0917\u0947\u092e\u093f\u0902\u0917) \u0915\u0947 \u0938\u093e\u0925, \u0906\u092a\u0915\u094b \u0939\u0930 \u091a\u0940\u091c\u093c \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964 \u0914\u0930 \u0939\u093e\u0901, \u092f\u0939 \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092d\u0940 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0930\u0947\u0902: \u0906\u091c \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0964 Loud EQ \u0916\u094b\u0932\u0947\u0902, 'Optimize' \u0926\u092c\u093e\u090f\u0902, \u0914\u0930 3 \u0926\u093f\u0928 \u092c\u093e\u0926 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u090f\u0902 \u0915\u093f \u0915\u0948\u0938\u093e \u0932\u0917\u093e\u0964 P.S. \u0905\u0917\u0930 \u0906\u092a \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u092a\u0942\u0930\u093e +200% \u092c\u0942\u0938\u094d\u091f \u0914\u0930 \u0938\u092d\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932\u094d\u0938 \u0905\u0928\u0932\u0949\u0915 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u092e\u094c\u0915\u093e \u0939\u093e\u0925 \u0938\u0947 \u0928 \u091c\u093e\u0928\u0947 \u0926\u0947\u0902\u0964"
  ],
