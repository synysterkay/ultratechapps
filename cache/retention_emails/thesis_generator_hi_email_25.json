{
  "subject": "\u090f\u0915 \u0930\u093e\u091c \u091c\u094b 90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u0928\u0939\u0940\u0902 \u092a\u0924\u093e",
  "preview_text": "\u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u092f\u0939 \u0910\u092a \u0938\u093f\u0930\u094d\u092b \u0925\u0940\u0938\u093f\u0938 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u091b\u093e\u0924\u094d\u0930 \u0928\u0947 \u092e\u0941\u091d\u0947 \u091a\u094c\u0902\u0915\u093e \u0926\u093f\u092f\u093e\u0964 \u0939\u0948\u0930\u093e\u0928 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932\u0964",
  "body_paragraphs": [
    "\u092e\u0948\u0902 \u0906\u092a\u0915\u094b \u090f\u0915 \u0915\u0939\u093e\u0928\u0940 \u0938\u0941\u0928\u093e\u0924\u093e \u0939\u0942\u0901\u0964 \u0915\u0932 \u090f\u0915 \u092f\u0942\u091c\u093c\u0930 \u0928\u0947 \u092e\u0941\u091d\u0947 \u092e\u0948\u0938\u0947\u091c \u0915\u093f\u092f\u093e \u2013 '\u092d\u093e\u0908, \u092f\u0939 \u0910\u092a \u0924\u094b \u0915\u092e\u093e\u0932 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092e\u0948\u0902\u0928\u0947 \u0907\u0938\u0947 \u0905\u092a\u0928\u0940 \u092c\u093e\u092f\u094b\u0917\u094d\u0930\u093e\u092b\u0940 \u0932\u093f\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e\u0964' \u092e\u0948\u0902 \u091a\u094c\u0902\u0915 \u0917\u092f\u093e\u0964 \u0905\u0938\u0932\u0940 \u092e\u0947\u0902? \u0925\u0940\u0938\u093f\u0938 \u091c\u0947\u0928\u0930\u0947\u091f\u0930 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0916\u0941\u0926 \u0915\u0940 \u091c\u093c\u093f\u0902\u0926\u0917\u0940 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u0932\u093f\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f? \u092e\u0948\u0902\u0928\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u0915\u094b\u0908 \u0907\u0938\u0947 \u0907\u0938 \u0924\u0930\u0939 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0947\u0917\u093e\u0964",
    "\u0909\u0938\u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0909\u0938\u0947 \u090f\u0915 \u0915\u0935\u0930 \u0932\u0947\u091f\u0930 \u0932\u093f\u0916\u0928\u093e \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u0909\u0938\u0915\u0947 \u092a\u093e\u0938 \u0915\u094b\u0908 \u0906\u0907\u0921\u093f\u092f\u093e \u0928\u0939\u0940\u0902 \u0925\u093e\u0964 \u0924\u094b \u0909\u0938\u0928\u0947 \u0910\u092a \u092e\u0947\u0902 '\u092c\u093e\u092f\u094b\u0917\u094d\u0930\u093e\u092b\u0940' \u0925\u0940\u092e \u091a\u0941\u0928\u0940, \u0914\u0930 \u0915\u0941\u091b \u092e\u093f\u0928\u091f\u094b\u0902 \u092e\u0947\u0902 \u090f\u0915 \u092a\u094d\u0930\u094b\u092b\u0947\u0936\u0928\u0932 \u0921\u094d\u0930\u093e\u092b\u094d\u091f \u0924\u0948\u092f\u093e\u0930 \u0939\u094b \u0917\u092f\u093e\u0964 \u092b\u093f\u0930 \u0909\u0938\u0928\u0947 '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c \u090f\u0906\u0908 \u091f\u0947\u0915\u094d\u0938\u094d\u091f' \u092b\u0940\u091a\u0930 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e \u0924\u093e\u0915\u093f \u0935\u0939 \u090f\u091a\u0906\u0930 \u0915\u094b \u0905\u0938\u0932\u0940 \u0932\u0917\u0947\u0964 \u0909\u0938\u0947 \u0928\u094c\u0915\u0930\u0940 \u092e\u093f\u0932 \u0917\u0908\u0964",
    "\u092f\u0939 \u0938\u0941\u0928\u0915\u0930 \u092e\u0941\u091d\u0947 \u090f\u0939\u0938\u093e\u0938 \u0939\u0941\u0906 \u0915\u093f \u0939\u092e\u093e\u0930\u093e \u0910\u092a \u0938\u093f\u0930\u094d\u092b \u0925\u0940\u0938\u093f\u0938 \u092f\u093e \u092a\u0947\u092a\u0930 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0906\u092a \u0907\u0938\u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0935\u0930 \u0932\u0947\u091f\u0930, \u0930\u093f\u091c\u093c\u094d\u092f\u0942\u092e\u0947, \u092a\u0930\u093f\u091a\u092f \u092a\u0924\u094d\u0930, \u092f\u093e \u092f\u0939\u093e\u0902 \u0924\u0915 \u0915\u093f \u090f\u0915 \u092e\u094b\u091f\u093f\u0935\u0947\u0936\u0928\u0932 \u0938\u094d\u092a\u0940\u091a \u0932\u093f\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u0938 '\u0925\u0940\u092e' \u092f\u093e '\u091f\u094b\u0928' \u0938\u0947\u091f \u0915\u0930\u0947\u0902, \u0914\u0930 \u0910\u092a \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0915\u093e\u092e \u0915\u0930\u0947\u0917\u093e\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0928\u094d\u092f\u0942 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f' \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u092b\u093f\u0930 '\u0925\u0940\u092e' \u092e\u0947\u0902 '\u0915\u0938\u094d\u091f\u092e' \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0915\u0941\u091b \u0905\u0932\u0917 \u091f\u093e\u0907\u092a \u0915\u0930\u0947\u0902 \u2013 \u091c\u0948\u0938\u0947 '\u092a\u0930\u094d\u0938\u0928\u0932 \u092c\u093e\u092f\u094b\u0917\u094d\u0930\u093e\u092b\u0940' \u092f\u093e '\u0915\u0935\u0930 \u0932\u0947\u091f\u0930'\u0964 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u092f\u0939 \u0915\u0948\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u2013 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0907\u090f \u0915\u093f \u0906\u092a\u0928\u0947 \u0915\u094d\u092f\u093e \u092c\u0928\u093e\u092f\u093e, \u092e\u0948\u0902 \u0906\u092a\u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u0938\u0941\u0928\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0901\u0964"
  ],
  "cta_text": "\u0905\u092c \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0915\u0941\u091b \u0928\u092f\u093e \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902",
