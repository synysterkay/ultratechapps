{
  "subject": "\u0906\u092a\u0915\u0940 \u0925\u0940\u0938\u093f\u0938 \u0938\u0947 \u092d\u0940 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0905\u0928\u094b\u0916\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932",
  "preview_text": "\u090f\u0915 \u091b\u093e\u0924\u094d\u0930 \u0928\u0947 \u0939\u092e\u093e\u0930\u0947 \u0910\u092a \u0915\u093e \u0910\u0938\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e \u091c\u093f\u0938\u0915\u0940 \u0939\u092e\u0928\u0947 \u0915\u092d\u0940 \u0915\u0932\u094d\u092a\u0928\u093e \u0928\u0939\u0940\u0902 \u0915\u0940 \u0925\u0940\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947\u0964",
  "body_paragraphs": [
    "\u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u0906\u092a \u0938\u093f\u0930\u094d\u092b\u093c \u0925\u0940\u0938\u093f\u0938 \u0932\u093f\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u0940 \u0939\u092e\u093e\u0930\u093e \u0910\u092a \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0947\u0902\u0917\u0947\u0964 \u0932\u0947\u0915\u093f\u0928 \u0915\u0932 \u090f\u0915 \u091b\u093e\u0924\u094d\u0930 \u0928\u0947 \u092e\u0941\u091d\u0947 \u091a\u094c\u0902\u0915\u093e \u0926\u093f\u092f\u093e\u0964 \u0909\u0938\u0928\u0947 \u0915\u0939\u093e \u0915\u093f \u0935\u0939 \u0905\u092a\u0928\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u0947 \u0924\u0930\u094d\u0915 \u0915\u094b \u090f\u0915 \u0921\u093f\u092c\u0947\u091f \u092e\u0947\u0902 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e, \u0914\u0930 \u0909\u0938\u0928\u0947 \u091c\u0940\u0924 \u0932\u093f\u092f\u093e\u0964 \u092e\u0948\u0902\u0928\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u0915\u094b\u0908 \u0907\u0938 \u0910\u092a \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0907\u0938 \u0924\u0930\u0939 \u0915\u0930\u0947\u0917\u093e\u0964",
    "\u0909\u0938\u0928\u0947 \u092e\u0941\u091d\u0947 \u0938\u092e\u091d\u093e\u092f\u093e \u0915\u093f \u0915\u0948\u0938\u0947 \u0909\u0938\u0928\u0947 \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930 \u0915\u0947 '\u0906\u0909\u091f\u0932\u093e\u0907\u0928 \u091f\u0942 \u092b\u0941\u0932 \u092a\u0947\u092a\u0930' \u092b\u0940\u091a\u0930 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u0947 \u0924\u0930\u094d\u0915 \u0915\u094b \u0938\u094d\u091f\u094d\u0930\u0915\u094d\u091a\u0930 \u0915\u093f\u092f\u093e\u0964 \u0909\u0938\u0928\u0947 \u0915\u0939\u093e \u0915\u093f \u0907\u0938\u0938\u0947 \u0909\u0938\u0915\u0947 \u0935\u093f\u091a\u093e\u0930 \u0907\u0924\u0928\u0947 \u0938\u094d\u092a\u0937\u094d\u091f \u0939\u094b \u0917\u090f \u0915\u093f \u0935\u0939 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0924\u0948\u092f\u093e\u0930\u0940 \u0915\u0947 \u0921\u093f\u092c\u0947\u091f \u092e\u0947\u0902 \u0916\u0921\u093c\u093e \u0939\u094b \u0917\u092f\u093e\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b\u093c \u0925\u0940\u0938\u093f\u0938 \u0928\u0939\u0940\u0902 \u0939\u0948\u2014\u092f\u0939 \u090f\u0915 \u0938\u094b\u091a\u0928\u0947 \u0915\u093e \u0924\u0930\u0940\u0915\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u092e\u0948\u0902 \u0938\u094b\u091a \u0930\u0939\u093e \u0939\u0942\u0901: \u0906\u092a \u0907\u0938 \u0910\u092a \u0915\u093e \u0914\u0930 \u0915\u094d\u092f\u093e-\u0915\u094d\u092f\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902? \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a \u0905\u092a\u0928\u0947 \u0930\u093f\u0938\u0930\u094d\u091a \u092a\u0947\u092a\u0930 \u0915\u0947 \u0932\u093f\u090f \u0917\u094d\u0930\u093e\u092b\u093c \u091c\u0947\u0928\u0930\u0947\u091f \u0915\u0930\u0947\u0902, \u092f\u093e \u0915\u093f\u0938\u0940 \u092a\u094d\u0930\u0947\u091c\u0947\u0902\u091f\u0947\u0936\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u093f\u091f\u0947\u0936\u0928\u094d\u0938 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u0947\u0902\u0964 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0915\u094b\u0908 \u0928\u092f\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0926\u0947\u0916\u0924\u093e \u0939\u0942\u0901, \u0924\u094b \u092e\u0941\u091d\u0947 \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u092f\u0939 \u0910\u092a \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0915\u0940 \u0938\u094b\u091a \u0938\u0947 \u0915\u0939\u0940\u0902 \u0906\u0917\u0947 \u0928\u093f\u0915\u0932 \u0917\u092f\u093e \u0939\u0948\u0964",
    "\u0924\u094b \u0906\u091c \u0930\u093e\u0924, \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u090f\u0915 \u0928\u092f\u093e \u092b\u0940\u091a\u0930 \u0906\u091c\u093c\u092e\u093e\u090f\u0901\u0964 \u0936\u093e\u092f\u0926 \u0917\u094d\u0930\u093e\u092b\u093c \u091c\u0947\u0928\u0930\u0947\u091f\u0930 \u092f\u093e \u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c\u0930\u2014\u091c\u094b \u092d\u0940 \u0906\u092a\u0915\u094b \u091a\u094c\u0902\u0915\u093e\u090f\u0964 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0907\u090f \u0915\u093f \u0906\u092a\u0915\u094b \u0915\u0948\u0938\u093e \u0932\u0917\u093e\u0964 P.S. \u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f 50,000+ \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0928\u0947 \u0905\u092a\u0928\u0947 \u0917\u094d\u0930\u0947\u0921 B+ \u0938\u0947 A- \u0924\u0915 \u0938\u0941\u0927\u093e\u0930\u0947 \u0939\u0948\u0902? \u092f\u0939 \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902 \u0939\u0948\u2014\u092f\u0939 \u0906\u092a\u0915\u0940 \u091c\u0940\u0924 \u0915\u093e \u0939\u0925\u093f\u092f\u093e\u0930 \u0939\u0948\u0964"
  ],
