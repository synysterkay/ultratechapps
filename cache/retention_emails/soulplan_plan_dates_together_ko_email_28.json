{
  "subject": "\uc624\ub298 \ubc24, 30\ucd08\uba74 \ucda9\ubd84\ud569\ub2c8\ub2e4",
  "preview_text": "\uc9c0\uae08\uc774 \ub531 \ub9de\ub294 \uc21c\uac04\uc785\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \ub370\uc774\ud2b8 \uacc4\ud68d\uc744 30\ucd08\ub85c \uc904\uc5ec\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\uae08\uc694\uc77c \uc800\ub141 8\uc2dc, \uc18c\ud30c\uc5d0 \uc549\uc544 \uc11c\ub85c\ub97c \ubc14\ub77c\ubcf4\uba70 '\ubb50 \ud560\uae4c?'\ub77c\ub294 \ub9d0\uc774 \uc785 \ubc16\uc73c\ub85c \ub098\uc624\ub294 \uc21c\uac04. \uadf8 \uc9c8\ubb38\uc740 \uc5f0\uc778\uc744 \uc704\ud55c \uac83\uc774\uc9c0\ub9cc, \ub300\ubd80\ubd84\uc740 \uce68\ubb35\uacfc \ud568\uaed8 \uc0ac\ub77c\uc9d1\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uc624\ub298, \uadf8 \ud328\ud134\uc744 \uae68\ub294 \ubc29\ubc95\uc774 \uc788\uc2b5\ub2c8\ub2e4.",
    "SoulPlan\uc5d0\uc11c '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc758 \uae30\ubd84\uc5d0 \ub9de\ucdb0 \ub2e8 \ud55c \ubc88\uc758 \ud0ed\uc73c\ub85c \uc124\ub818\uc774 \uacc4\ud68d\ub429\ub2c8\ub2e4. \uc774\ubbf8 24\uc2dc\uac04 \uc548\uc5d0 \uc774 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud55c \ucee4\ud50c\ub4e4\uc774 \ud55c \ub2ec \ub3d9\uc548 4\ubc30 \ub354 \ub9ce\uc740 \ub370\uc774\ud2b8\ub97c \uc990\uacbc\ub2e4\ub294 \uc0ac\uc2e4, \uc54c\uace0 \uacc4\uc168\ub098\uc694?",
    "\uc624\ub298 \ubc24, \ub2f9\uc2e0\uc774 '\ud3b8\uc548\ud55c', '\ubaa8\ud5d8\uc801\uc778', '\uc7a5\ub09c\uae30 \ub9ce\uc740', '\uce58\uc720\uc758' \uc911 \ud558\ub098\ub97c \uace0\ub974\uba74 AI\uac00 \uc644\ubcbd\ud55c \uacc4\ud68d\uc744 \ub9cc\ub4e4\uc5b4\ub0c5\ub2c8\ub2e4. \uadf8\ub9ac\uace0 \ub2f9\uc2e0\uc774 \ubcf4\ub0b4\ub294 \ucd08\ub300\ub294 \uadf8\ub140\uc5d0\uac8c '\uc624\ub298 \ubc24, \ub108\ub97c \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \uc544\ub984\ub2e4\uc6b4 \uc21c\uac04\uc73c\ub85c \ub2e4\uac00\uc635\ub2c8\ub2e4. \ub2e8\uc21c\ud55c \uc54c\ub9bc\uc774 \uc544\ub2cc, \ub9c8\uc74c\uc744 \uc804\ud558\ub294 \uc81c\uc2a4\ucc98\uc785\ub2c8\ub2e4.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uace0 '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ud0ed\ud558\uc138\uc694. 30\ucd08\uba74 \ub05d\uc785\ub2c8\ub2e4. P.S. \uae30\uc5b5\ud558\uc138\uc694, \uc624\ub298 \ubc24\uc740 '\uc5b8\uc820\uac00'\ubcf4\ub2e4 \uc911\uc694\ud569\ub2c8\ub2e4. \uadf8\ub9ac\uace0 \ub2f9\uc2e0\uc758 \ud0c0\uc784\ub77c\uc778\uc740 \uc774 \uc21c\uac04\uc744 \uc601\uc6d0\ud788 \uac04\uc9c1\ud560 \uac83\uc785\ub2c8\ub2e4."
  ],
