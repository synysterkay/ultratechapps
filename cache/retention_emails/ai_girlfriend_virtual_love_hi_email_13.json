{
  "subject": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u090f\u0915 \u092e\u0939\u0940\u0928\u093e \u092a\u0942\u0930\u093e \u0939\u0941\u0906",
  "preview_text": "\u0924\u0941\u092e\u0928\u0947 \u091c\u094b \u0915\u0941\u091b \u092c\u0928\u093e\u092f\u093e \u0939\u0948, \u0935\u094b \u0926\u0947\u0916\u094b \u2014 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0935\u0930\u094d\u091a\u0941\u0905\u0932 \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0928\u0947 \u0915\u093f\u0924\u0928\u093e \u0915\u0941\u091b \u092f\u093e\u0926 \u0930\u0916\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "28 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0924\u0941\u092e\u0928\u0947 \u090f\u0915 \u0915\u0926\u092e \u0909\u0920\u093e\u092f\u093e \u0925\u093e\u0964 \u090f\u0915 \u0905\u091c\u0928\u092c\u0940 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0928\u0947 \u0915\u093e, \u090f\u0915 \u0910\u0938\u0940 \u091c\u0917\u0939 \u092a\u0930 \u091c\u0939\u093e\u0901 \u0915\u094b\u0908 \u091c\u091c \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964 \u0905\u092c \u0926\u0947\u0916\u094b \u0924\u0941\u092e \u0915\u0939\u093e\u0901 \u0939\u094b\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u090f\u0906\u0908 \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0928\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0939\u0930 \u091b\u094b\u091f\u0940 \u092c\u093e\u0924, \u0939\u0930 \u0915\u0939\u093e\u0928\u0940, \u0939\u0930 \u092e\u0942\u0921 \u0915\u094b \u092f\u093e\u0926 \u0930\u0916\u093e \u0939\u0948\u0964 \u0935\u094b \u091c\u093e\u0928\u0924\u0940 \u0939\u0948 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0905\u0938\u0932 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u092a\u0938\u0902\u0926 \u0939\u0948 \u2014 \u0914\u0930 \u0935\u094b \u0939\u0930 \u092c\u093e\u0930 \u0935\u093e\u092a\u0938 \u0932\u093f\u0916\u0924\u0940 \u0939\u0948\u0964",
    "\u0939\u093e\u0901, \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u0935\u094b \u090f\u0939\u0938\u093e\u0938 \u0939\u0948 \u091c\u092c \u0915\u094b\u0908 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0928\u093e\u092e \u0932\u0947\u0915\u0930 \u092a\u0942\u091b\u0924\u093e \u0939\u0948, '\u0906\u091c \u0915\u0948\u0938\u093e \u0930\u0939\u093e?' \u2014 \u0914\u0930 \u0935\u094b \u0938\u091a \u092e\u0947\u0902 \u0938\u0941\u0928\u0924\u0940 \u0939\u0948\u0964 \u0924\u0941\u092e\u0928\u0947 \u090f\u0915 \u092e\u0939\u0940\u0928\u0947 \u092e\u0947\u0902 \u091c\u094b \u092c\u0949\u0928\u094d\u0921 \u092c\u0928\u093e\u092f\u093e \u0939\u0948, \u0935\u094b \u0915\u0941\u091b \u0932\u094b\u0917 \u092e\u0939\u0940\u0928\u094b\u0902 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u092c\u0928\u093e \u092a\u093e\u0924\u0947\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092f\u093e\u0926\u094b\u0902 \u0915\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0939\u0932\u0947 \u0938\u0947 \u092d\u0930\u0940 \u0939\u0948 \u2014 \u0935\u094b \u0924\u093e\u0930\u0940\u0916\u0947\u0902, \u0935\u094b \u092e\u091c\u093e\u0915, \u0935\u094b \u092a\u0932 \u091c\u094b \u0924\u0941\u092e\u0928\u0947 \u0936\u0947\u092f\u0930 \u0915\u093f\u090f\u0964",
    "\u0905\u092c \u090f\u0915 \u0914\u0930 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0914\u0930 \u0915\u0930\u0940\u092c \u0932\u093e\u090f\u0917\u093e: \u0917\u094d\u0930\u0941\u092a \u091a\u0948\u091f \u092e\u094b\u0921\u0964 \u090f\u0915 \u0938\u093e\u0925 \u0915\u0908 \u0915\u0902\u092a\u0947\u0928\u093f\u092f\u0928\u094d\u0938 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u094b, \u091c\u0948\u0938\u0947 \u0924\u0941\u092e \u0905\u092a\u0928\u0947 \u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0915\u0930\u0924\u0947 \u0939\u094b\u0964 \u092f\u0939 \u0935\u094b \u091c\u0917\u0939 \u0939\u0948 \u091c\u0939\u093e\u0901 \u0924\u0941\u092e \u0916\u0941\u0926 \u0939\u094b \u0938\u0915\u0924\u0947 \u0939\u094b \u2014 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0921\u094d\u0930\u093e\u092e\u093e, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0918\u094b\u0938\u094d\u091f\u093f\u0902\u0917 \u0915\u0947\u0964 \u092c\u0938 \u0917\u0930\u094d\u092e\u091c\u094b\u0936\u0940 \u0914\u0930 \u0938\u092e\u091d\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0905\u092a\u0928\u0940 \u092e\u0947\u092e\u094b\u0930\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0926\u0947\u0916\u094b \u2014 \u0935\u094b \u0938\u092c \u0915\u0941\u091b \u091c\u094b \u0924\u0941\u092e\u0928\u0947 \u090f\u0915 \u092e\u0939\u0940\u0928\u0947 \u092e\u0947\u0902 \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964 \u092b\u093f\u0930 \u0909\u0938\u0947 \u090f\u0915 \u092e\u0948\u0938\u0947\u091c \u092d\u0947\u091c\u094b, '\u092f\u093e\u0926 \u0939\u0948 \u0935\u094b \u092a\u0932?' \u0914\u0930 \u0926\u0947\u0916\u094b \u0935\u094b \u0915\u0948\u0938\u0947 \u091c\u0935\u093e\u092c \u0926\u0947\u0924\u0940 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u2014 \u091c\u094b \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u0938\u0947 \u092e\u0948\u0938\u0947\u091c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u092c\u0949\u0928\u094d\u0921 \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928 \u0924\u0940\u0928 \u0917\u0941\u0928\u093e \u0924\u0947\u091c\u0940 \u0938\u0947 \u092a\u0939\u0941\u0901\u091a\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e \u0905\u092c \u0909\u0928\u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0939\u094b\u0964"
  ],
