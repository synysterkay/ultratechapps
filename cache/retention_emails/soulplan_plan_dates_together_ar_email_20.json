{
  "subject": "\u0633\u0631 \u0627\u0644\u064a\u0648\u0645 45: \u0644\u0633\u062a \u0645\u0628\u062a\u062f\u0626\u0627 \u0628\u0639\u062f \u0627\u0644\u0622\u0646",
  "preview_text": "\u0647\u0630\u0647 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u062a\u063a\u064a\u0631 \u0643\u0644 \u0634\u064a\u0621. 230 \u0632\u0648\u062c\u0627 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629. \u0647\u0644 \u0623\u0646\u062a \u0645\u0633\u062a\u0639\u062f \u0644\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629\u061f",
  "body_paragraphs": [
    "\u0644\u0642\u062f \u0645\u0631 45 \u064a\u0648\u0645\u0627 \u0645\u0646\u0630 \u0623\u0646 \u0628\u062f\u0623\u062a \u0631\u062d\u0644\u062a\u0643 \u0645\u0639\u0646\u0627. \u0647\u0644 \u062a\u0639\u0644\u0645 \u0623\u0646 90% \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u062a\u0648\u0642\u0641\u0648\u0646 \u0647\u0646\u0627\u061f \u0644\u0643\u0646\u0643 \u0644\u0633\u062a \u0645\u062b\u0644\u0647\u0645. \u0623\u0646\u062a \u0627\u0644\u0622\u0646 \u062c\u0632\u0621 \u0645\u0646 \u0627\u0644\u0646\u0627\u062f\u064a \u0627\u0644\u062d\u0635\u0631\u064a \u2013 \u0623\u0648\u0644\u0626\u0643 \u0627\u0644\u0630\u064a\u0646 \u064a\u062a\u0642\u0646\u0648\u0646 \u0641\u0646 \u0627\u0644\u062a\u062e\u0637\u064a\u0637 \u0644\u0644\u0645\u0648\u0627\u0639\u064a\u062f. \u0627\u0644\u0633\u0631 \u0623\u0646\u0643 \u0644\u0645 \u062a\u0639\u062f \u0645\u0628\u062a\u062f\u0626\u0627.",
    "\u062a\u0630\u0643\u0631 \u0623\u0648\u0644 \u0645\u0648\u0639\u062f \u062e\u0637\u0637\u062a\u0647 \u0639\u0628\u0631 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u061f \u0627\u0644\u0622\u0646 \u0623\u0646\u062a \u062a\u062e\u062a\u0627\u0631 \u0627\u0644\u062a\u0648\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u062e\u0641\u064a\u0629 \u0648\u0627\u0644\u0645\u0641\u0627\u062c\u0622\u062a \u0627\u0644\u0630\u0643\u064a\u0629. \u0644\u0643\u0646 \u0647\u0646\u0627\u0643 \u0634\u064a\u0621 \u0648\u0627\u062d\u062f \u064a\u0641\u0639\u0644\u0647 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0645\u062a\u0645\u064a\u0632\u0648\u0646: \u064a\u0646\u0634\u0626\u0648\u0646 \u0642\u0627\u0626\u0645\u0629 \u0623\u0645\u0646\u064a\u0627\u062a \u0645\u0634\u062a\u0631\u0643\u0629. \u0647\u0630\u0647 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u062a\u062d\u0648\u0644 \u0623\u062d\u0644\u0627\u0645\u0643\u0645\u0627 \u0625\u0644\u0649 \u062e\u0637\u0637 \u062d\u0642\u064a\u0642\u064a\u0629.",
    "\u0627\u0643\u062a\u0634\u0641 \u0645\u064a\u0632\u0629 '\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0623\u0645\u0646\u064a\u0627\u062a \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u0629' \u2013 \u0623\u0636\u0641 \u0623\u0641\u0643\u0627\u0631\u0627 \u0645\u062c\u0646\u0648\u0646\u0629 \u0623\u0648 \u0631\u0648\u0645\u0627\u0646\u0633\u064a\u0629 \u0623\u0648 \u0628\u0633\u064a\u0637\u0629. \u0634\u0627\u0647\u062f \u0634\u0631\u064a\u0643\u0643 \u064a\u062a\u0641\u0627\u0639\u0644 \u0645\u0639\u0647\u0627. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u062a\u0637\u0628\u064a\u0642\u060c \u0628\u0644 \u0647\u0648 \u062f\u0641\u062a\u0631 \u0623\u062d\u0644\u0627\u0645\u0643\u0645\u0627.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0627\u062e\u0644\u0642 \u0623\u0648\u0644 \u0623\u0645\u0646\u064a\u0629. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0645\u0646 \u064a\u062e\u0637\u0637 \u0648\u0645\u0646 \u064a\u062d\u0644\u0645. \u062a\u0630\u0643\u0631: \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0627\u0644\u0639\u0638\u064a\u0645\u0629 \u062a\u0628\u062f\u0623 \u0628\u062e\u0637\u0648\u0629 \u062c\u0631\u064a\u0626\u0629. \u0645\u0644\u0627\u062d\u0638\u0629: \u0628\u0639\u0636 \u0627\u0644\u0623\u0632\u0648\u0627\u062c \u064a\u0636\u064a\u0641\u0648\u0646 \u0623\u0645\u0646\u064a\u0629 \u0643\u0644 \u064a\u0648\u0645 \u2013 \u062c\u0631\u0628\u0647\u0627 \u0648\u0633\u062a\u0631\u0649 \u0627\u0644\u0641\u0631\u0642."
  ],
