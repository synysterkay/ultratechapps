{
  "subject": "\u064a\u0648\u0645 45 \u0645\u0639 \u0633\u0648\u0644\u0628\u0644\u0627\u0646: \u0645\u0627\u0630\u0627 \u0628\u0639\u062f\u061f",
  "preview_text": "\u0644\u0645 \u062a\u0639\u062f \u0645\u0633\u062a\u062e\u062f\u0645\u0627\u064b \u062c\u062f\u064a\u062f\u0627\u064b. \u0647\u0646\u0627 \u062a\u0628\u062f\u0623 \u0631\u062d\u0644\u062a\u0643 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629 \u0645\u0639 \u062a\u0637\u0628\u064a\u0642\u0646\u0627.",
  "body_paragraphs": [
    "\u0642\u0628\u0644 45 \u064a\u0648\u0645\u0627\u064b\u060c \u0646\u0632\u0644\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u0628\u062f\u0623\u062a \u0631\u062d\u0644\u0629 \u0645\u0639 \u0634\u0631\u064a\u0643\u0643. \u0627\u0644\u064a\u0648\u0645\u060c \u0623\u0646\u062a \u0644\u0633\u062a \u0645\u0633\u062a\u062e\u062f\u0645\u0627\u064b \u062c\u062f\u064a\u062f\u0627\u064b \u0628\u0639\u062f \u0627\u0644\u0622\u0646. \u0623\u0646\u062a \u062c\u0632\u0621 \u0645\u0646 \u0645\u062c\u062a\u0645\u0639 \u064a\u062e\u0637\u0637 \u0644\u0644\u062d\u0638\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0647\u0645 \u062d\u0642\u0627\u064b.",
    "\u0647\u0644 \u062a\u0630\u0643\u0631 \u0623\u0648\u0644 \u0645\u0648\u0639\u062f \u062e\u0637\u0637\u062a\u0647 \u0645\u0639 \u0633\u0648\u0644\u0628\u0644\u0627\u0646\u061f \u0631\u0628\u0645\u0627 \u0643\u0627\u0646 \u0628\u0633\u064a\u0637\u0627\u064b\u060c \u0648\u0644\u0643\u0646 \u062a\u0644\u0643 \u0627\u0644\u0644\u064a\u0644\u0629 \u063a\u064a\u0631\u062a \u0634\u064a\u0626\u0627\u064b \u0641\u064a \u0639\u0644\u0627\u0642\u062a\u0643. \u0627\u0644\u0622\u0646\u060c \u062d\u0627\u0646 \u0627\u0644\u0648\u0642\u062a \u0644\u062a\u0623\u062e\u0630 \u062e\u0637\u0648\u0629 \u0623\u0628\u0639\u062f.",
    "\u062a\u062e\u064a\u0644 \u0623\u0646 \u062a\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u064a\u0648\u0645 \u0648\u062a\u062c\u062f \"\u0645\u0648\u0639\u062f \u0627\u0644\u0644\u064a\u0644\u0629\" \u064a\u0646\u062a\u0638\u0631\u0643\u060c \u0628\u0646\u0642\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0645\u0632\u0627\u062c \u0627\u0644\u0630\u064a \u064a\u0646\u0627\u0633\u0628\u0643\u0645\u0627. \u0623\u0648 \u0623\u0646 \u062a\u0631\u0633\u0644 \u0644\u0634\u0631\u064a\u0643\u0643 \u0627\u0642\u062a\u0631\u0627\u062d\u0627\u064b\u060c \u0648\u064a\u0633\u062a\u0642\u0628\u0644\u0647 \u0628\u0644\u062d\u0638\u0629 \"\u0641\u0643\u0631\u062a \u0641\u064a\u0643 \u0627\u0644\u0644\u064a\u0644\u0629\" \u0627\u0644\u0643\u0627\u0645\u0644\u0629. \u0647\u0630\u0647 \u0647\u064a \u0627\u0644\u0642\u0648\u0629 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629: \u0644\u064a\u0633\u062a \u0645\u062c\u0631\u062f \u062e\u0637\u0629\u060c \u0628\u0644 \u0630\u0643\u0631\u064a\u0627\u062a \u062a\u062a\u0631\u0627\u0643\u0645 \u0641\u064a \u0634\u0631\u064a\u0637 \u0627\u0644\u0630\u0627\u0643\u0631\u0629.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0648\u0627\u062c\u0639\u0644 \u0627\u0644\u0644\u064a\u0644\u0629 \u0627\u0644\u0642\u0627\u062f\u0645\u0629 \u0647\u064a \u0627\u0644\u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629. \u0644\u0627 \u062a\u062a\u0631\u0643 \u0627\u0644\u0634\u0631\u0627\u0631\u0629 \u062a\u0646\u062a\u0638\u0631. P.S. \u0628\u0639\u0636 \u0627\u0644\u0623\u0632\u0648\u0627\u062c \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0645\u064a\u0632\u0629 \"\u0627\u0644\u0631\u063a\u0628\u0627\u062a\" \u0644\u0625\u0631\u0633\u0627\u0644 \u0645\u0641\u0627\u062c\u0622\u062a \u063a\u064a\u0631 \u0645\u062a\u0648\u0642\u0639\u0629. \u062c\u0631\u0628\u0647\u0627."
  ],
  "cta_text": "\u0627\u0641\u062a\u062d \u0633\u0648\u0644\u0628\u0644\u0627\u0646 \u0627\u0644\u0622\u0646",
