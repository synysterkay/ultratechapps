{
  "subject": "\u0421\u0435\u043a\u0440\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043f\u0430\u0441 \u0438\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f",
  "preview_text": "\u041e\u043d\u0438 \u0431\u044b\u043b\u0438 \u043d\u0430 \u0433\u0440\u0430\u043d\u0438 \u0440\u0430\u0437\u0440\u044b\u0432\u0430, \u043d\u043e \u043d\u0430\u0448\u043b\u0438 \u0432\u044b\u0445\u043e\u0434. \u0423\u0437\u043d\u0430\u0439\u0442\u0435, \u0447\u0442\u043e \u043f\u043e\u043c\u043e\u0433\u043b\u043e \u0438\u043c \u0432\u0435\u0440\u043d\u0443\u0442\u044c \u0438\u0441\u043a\u0440\u0443.",
  "body_paragraphs": [
    "\u0412 \u043f\u0440\u043e\u0448\u043b\u043e\u043c \u043c\u0435\u0441\u044f\u0446\u0435 \u043a\u043e \u043c\u043d\u0435 \u043f\u0440\u0438\u0448\u043b\u0430 \u043f\u0430\u0440\u0430 \u2014 \u043d\u0430\u0437\u043e\u0432\u0435\u043c \u0438\u0445 \u0410\u043d\u044f \u0438 \u0414\u0438\u043c\u0430. \u0422\u0440\u0438 \u0433\u043e\u0434\u0430 \u0432\u043c\u0435\u0441\u0442\u0435, \u043d\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u043f\u043e\u043b\u0433\u043e\u0434\u0430 \u043e\u043d\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438, \u0447\u0442\u043e \u043c\u0435\u0436\u0434\u0443 \u043d\u0438\u043c\u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043b\u0430\u0441\u044c \u0441\u0442\u0435\u043d\u0430. \u0412\u0435\u0447\u0435\u0440\u0430 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b\u0438 \u0432 \u043c\u043e\u043b\u0447\u0430\u043d\u0438\u0438, \u0430 \u043f\u043e\u043f\u044b\u0442\u043a\u0438 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u0442\u044c, \u043a\u0443\u0434\u0430 \u043f\u043e\u0439\u0442\u0438, \u0437\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u043b\u0438\u0441\u044c \u0441\u0441\u043e\u0440\u0430\u043c\u0438. \u0410\u043d\u044f \u0441\u043a\u0430\u0437\u0430\u043b\u0430: '\u042f \u043b\u044e\u0431\u043b\u044e \u0435\u0433\u043e, \u043d\u043e \u043c\u043d\u0435 \u043a\u0430\u0436\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u043c\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u043c \u0440\u044f\u0434\u043e\u043c'. \u0417\u043d\u0430\u043a\u043e\u043c\u043e?",
    "\u041e\u043d\u0438 \u0441\u043a\u0430\u0447\u0430\u043b\u0438 SoulPlan \u043f\u043e\u0447\u0442\u0438 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e, \u043d\u043e \u043e\u0434\u043d\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430 \u0432\u0441\u0451. \u0414\u0438\u043c\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b '\u041f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0449\u0438\u043a \u0441\u044e\u0440\u043f\u0440\u0438\u0437\u043e\u0432' \u2014 \u043e\u043d \u0432\u044b\u0431\u0440\u0430\u043b \u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u0432 \u0431\u044e\u0434\u0436\u0435\u0442\u0435 \u0434\u043e 2000 \u0440\u0443\u0431\u043b\u0435\u0439, \u0430 \u0410\u043d\u044f \u043d\u0435 \u0437\u043d\u0430\u043b\u0430, \u0447\u0442\u043e \u0435\u0451 \u0436\u0434\u0451\u0442. \u042d\u0442\u043e \u0431\u044b\u043b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0436\u0438\u043d, \u0430 \u0432\u0435\u0447\u0435\u0440 \u0441 \u043a\u0432\u0435\u0441\u0442\u0430\u043c\u0438 \u043f\u043e \u043b\u044e\u0431\u0438\u043c\u044b\u043c \u043c\u0435\u0441\u0442\u0430\u043c \u0438\u0445 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u044f. \u0427\u0435\u0440\u0435\u0437 \u043d\u0435\u0434\u0435\u043b\u044e \u0410\u043d\u044f \u043d\u0430\u043f\u0438\u0441\u0430\u043b\u0430 \u043c\u043d\u0435: '\u041c\u044b \u0441\u043d\u043e\u0432\u0430 \u0441\u043c\u0435\u044f\u043b\u0438\u0441\u044c, \u043a\u0430\u043a \u0432 \u043d\u0430\u0447\u0430\u043b\u0435'. 92% \u043f\u0430\u0440, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0449\u0438\u0445 \u044d\u0442\u0443 \u0444\u0443\u043d\u043a\u0446\u0438\u044e, \u0433\u043e\u0432\u043e\u0440\u044f\u0442, \u0447\u0442\u043e \u0438\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441\u0442\u0430\u043b\u0438 \u044f\u0440\u0447\u0435.",
    "\u0412\u043e\u0442 \u0432 \u0447\u0451\u043c \u0434\u0435\u043b\u043e: \u0440\u0443\u0442\u0438\u043d\u0430 \u0443\u0431\u0438\u0432\u0430\u0435\u0442 \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u043a\u0443 \u043d\u0435 \u043f\u043e\u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u0432\u044b \u0440\u0430\u0437\u043b\u044e\u0431\u0438\u043b\u0438, \u0430 \u043f\u043e\u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u043c\u043e\u0437\u0433 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u0451\u0442 \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u043d\u043e\u0432\u0438\u0437\u043d\u0443. \u041d\u0430\u0448 AI \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u0432\u0430\u0448\u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b \u0438 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442 \u0438\u0434\u0435\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b \u0431\u044b \u0441\u0430\u043c\u0438 \u043d\u0435 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b\u0438. \u041e\u0442 \u0431\u044e\u0434\u0436\u0435\u0442\u043d\u044b\u0445 \u043f\u0438\u043a\u043d\u0438\u043a\u043e\u0432 \u0434\u043e \u0440\u043e\u0441\u043a\u043e\u0448\u043d\u044b\u0445 \u0443\u0438\u043a\u0435\u043d\u0434\u043e\u0432 \u2014 \u0432\u0441\u0451, \u0447\u0442\u043e\u0431\u044b \u0432\u044b \u0441\u043d\u043e\u0432\u0430 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u044d\u0442\u043e\u0442 \u0442\u0440\u0435\u043f\u0435\u0442. \u0418 \u0434\u0430, \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f, \u0447\u0442\u043e\u0431\u044b \u0432\u044b \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e \u043d\u0435 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u043b\u0438 \u043f\u0440\u043e\u0448\u043b\u043e\u0433\u043e\u0434\u043d\u0438\u0439 \u043f\u0440\u043e\u0432\u0430\u043b.",
    "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043d\u0430\u0436\u043c\u0438\u0442\u0435 '\u0421\u043e\u0437\u0434\u0430\u0442\u044c \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u0435'. \u041f\u0443\u0441\u0442\u044c \u0432\u0430\u0448 \u043f\u0430\u0440\u0442\u043d\u0451\u0440 \u0443\u0434\u0438\u0432\u0438\u0442\u0441\u044f. P.S. \u0415\u0441\u043b\u0438 \u043d\u0435 \u0437\u043d\u0430\u0435\u0442\u0435, \u0441 \u0447\u0435\u0433\u043e \u043d\u0430\u0447\u0430\u0442\u044c, \u0437\u0430\u0433\u043b\u044f\u043d\u0438\u0442\u0435 \u0432 '\u041e\u0431\u0449\u0438\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u0436\u0435\u043b\u0430\u043d\u0438\u0439' \u2014 \u0442\u0430\u043c \u0432\u044b \u043d\u0430\u0439\u0434\u0451\u0442\u0435 \u0442\u043e, \u043e \u0447\u0451\u043c \u043c\u0435\u0447\u0442\u0430\u0435\u0442\u0435 \u043e\u0431\u0430."
  ],
