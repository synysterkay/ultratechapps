{
  "subject": "\u0410\u043d\u043d\u0430 \u0438 \u0414\u043c\u0438\u0442\u0440\u0438\u0439: \u0438\u0445 3 \u043c\u0438\u043d\u0443\u0442\u044b \u0432\u0435\u0447\u0435\u0440\u043e\u043c",
  "preview_text": "\u041e\u043d\u0438 \u0447\u0443\u0442\u044c \u043d\u0435 \u043e\u0442\u043c\u0435\u043d\u0438\u043b\u0438 \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u0435. \u0410 \u043f\u043e\u0442\u043e\u043c \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e \u0442\u043e, \u0447\u0442\u043e \u0441\u043f\u0430\u0441\u043b\u043e \u0438\u0445 \u0432\u0435\u0447\u0435\u0440.",
  "body_paragraphs": [
    "\u0410\u043d\u043d\u0430 \u0438 \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u043d\u0435 \u0441\u0441\u043e\u0440\u0438\u043b\u0438\u0441\u044c. \u041e\u043d\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0441\u0442\u0430\u043b\u0438. \u041f\u044f\u0442\u043d\u0438\u0446\u0430, 19:42, \u043e\u0431\u0430 \u0432\u0430\u043b\u044f\u0442\u0441\u044f \u0441 \u043d\u043e\u0433 \u043f\u043e\u0441\u043b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b. \u0414\u0438\u043c \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u0435 \u043d\u0430 \u0432\u044b\u0445\u043e\u0434\u043d\u044b\u0435 \u2014 \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0437. \u0410\u043d\u043d\u0430 \u043c\u043e\u043b\u0447\u0438\u0442, \u043d\u043e \u0432\u043d\u0443\u0442\u0440\u0438 \u0447\u0442\u043e-\u0442\u043e \u0441\u0436\u0438\u043c\u0430\u0435\u0442\u0441\u044f: '\u041d\u0435\u0443\u0436\u0435\u043b\u0438 \u043c\u044b \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u043c\u0441\u044f \u0432 \u0442\u0435\u0445, \u043a\u0442\u043e \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u0442, \u0437\u0430\u0447\u0435\u043c \u043e\u043d\u0438 \u0432\u043c\u0435\u0441\u0442\u0435?' \u0412 \u044d\u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442 \u043e\u043d\u0430 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 SoulPlan \u0438 \u0432\u0438\u0434\u0438\u0442 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0443 \u043d\u0430 \u0433\u043b\u0430\u0432\u043d\u043e\u043c \u044d\u043a\u0440\u0430\u043d\u0435. \u041d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f, \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0441\u043f\u0438\u0441\u043a\u043e\u0432. \u041e\u0434\u0438\u043d \u043a\u043b\u0438\u043a \u2014 \u0438 \u0432\u0441\u0451.",
    "\u0427\u0435\u0440\u0435\u0437 20 \u043c\u0438\u043d\u0443\u0442 \u043e\u043d\u0438 \u0441\u0438\u0434\u044f\u0442 \u043d\u0430 \u0431\u0430\u043b\u043a\u043e\u043d\u0435 \u0441 \u0447\u0430\u0435\u043c \u0438 \u043f\u043b\u0435\u0434\u043e\u043c, \u0441\u043b\u0443\u0448\u0430\u044e\u0442 \u0441\u0442\u0430\u0440\u044b\u0435 \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u043a\u0438. \u041d\u0435 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d, \u043d\u0435 \u043a\u0432\u0435\u0441\u0442, \u043d\u0435 \u043a\u0438\u043d\u043e. \u041f\u0440\u043e\u0441\u0442\u043e \u043e\u043d\u0438 \u0432\u0434\u0432\u043e\u0451\u043c, \u0431\u0435\u0437 \u044d\u043a\u0440\u0430\u043d\u043e\u0432 \u0438 \u0441\u0443\u0435\u0442\u044b. \u0410\u043d\u043d\u0430 \u043f\u043e\u0442\u043e\u043c \u043d\u0430\u043f\u0438\u0448\u0435\u0442 \u0432 \u043d\u0430\u0448\u0435\u0439 \u043f\u0430\u043c\u044f\u0442\u0438: '\u041c\u044b \u043d\u0435 \u0432\u044b\u0445\u043e\u0434\u0438\u043b\u0438 \u0438\u0437 \u0434\u043e\u043c\u0430, \u043d\u043e \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u043b\u0443\u0447\u0448\u0435\u0435 \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u0435 \u0437\u0430 \u043c\u0435\u0441\u044f\u0446'. \u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e \u0440\u043e\u0441\u043a\u043e\u0448\u044c. \u042d\u0442\u043e \u043f\u0440\u043e \u0442\u043e, \u0447\u0442\u043e \u0438\u043d\u043e\u0433\u0434\u0430 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043e\u0434\u043d\u043e\u0433\u043e \u0436\u0435\u0441\u0442\u0430, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u043f\u043e\u043c\u043d\u0438\u0442\u044c: '\u042f \u0437\u0434\u0435\u0441\u044c, \u044f \u0434\u0443\u043c\u0430\u044e \u043e \u0442\u0435\u0431\u0435'.",
    "\u0412\u043e\u0442 \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430 '\u0421\u0432\u0438\u0434\u0430\u043d\u0438\u0435 \u043d\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f' \u0432 SoulPlan. \u0412\u044b\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435 \u2014 \u0443\u044e\u0442\u043d\u043e\u0435, \u0438\u0433\u0440\u0438\u0432\u043e\u0435, Healing \u2014 \u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u0434\u043a\u0438\u0434\u044b\u0432\u0430\u0435\u0442 \u0438\u0434\u0435\u044e \u0437\u0430 30 \u0441\u0435\u043a\u0443\u043d\u0434. \u0411\u0435\u0437 \u043b\u0438\u0448\u043d\u0438\u0445 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439. \u0411\u0435\u0437 '\u0430 \u0447\u0442\u043e \u0442\u044b \u0445\u043e\u0447\u0435\u0448\u044c?'. \u041f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u0432\u0430\u0448\u0443 \u0436\u0438\u0437\u043d\u044c \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u0418 \u043a\u043e\u0433\u0434\u0430 \u043f\u0430\u0440\u0442\u043d\u0451\u0440 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435 \u2014 \u043d\u0435 \u0433\u043e\u043b\u043e\u0435 \u043e\u043f\u043e\u0432\u0435\u0449\u0435\u043d\u0438\u0435, \u0430 \u043f\u043e\u043b\u043d\u044b\u0439 \u044d\u043a\u0440\u0430\u043d \u0441 \u0444\u0440\u0430\u0437\u043e\u0439 '\u0414\u0443\u043c\u0430\u043b(\u0430) \u043e \u0442\u0435\u0431\u0435 \u0441\u0435\u0433\u043e\u0434\u043d\u044f' \u2014 \u044d\u0442\u043e \u043c\u0435\u043d\u044f\u0435\u0442 \u0432\u0441\u0451.",
    "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 SoulPlan \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0443 '\u0421\u0432\u0438\u0434\u0430\u043d\u0438\u0435 \u043d\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f', \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435 \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u044c\u0442\u0435 \u043f\u0430\u0440\u0442\u043d\u0451\u0440\u0443. \u041d\u0435 \u043e\u0442\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0439\u0442\u0435 \u043d\u0430 \u0437\u0430\u0432\u0442\u0440\u0430 \u2014 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c 3 \u043c\u0438\u043d\u0443\u0442\u044b, \u0447\u0442\u043e\u0431\u044b \u0432\u0435\u0440\u043d\u0443\u0442\u044c \u0438\u0441\u043a\u0440\u0443. P.S. \u0410\u043d\u043d\u0430 \u0438 \u0414\u0438\u043c \u0442\u0435\u043f\u0435\u0440\u044c \u0445\u0440\u0430\u043d\u044f\u0442 \u043a\u0430\u0436\u0434\u043e\u0435 \u0442\u0430\u043a\u043e\u0435 \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u0435 \u0432 \u043b\u0435\u043d\u0442\u0435 \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0439 \u2014 \u0447\u0435\u0440\u0435\u0437 \u0433\u043e\u0434 \u044d\u0442\u043e \u0431\u0443\u0434\u0435\u0442 \u0438\u0445 \u043b\u0438\u0447\u043d\u044b\u0439 \u0430\u043b\u044c\u0431\u043e\u043c '\u041c\u044b \u043d\u0435 \u0441\u0434\u0430\u043b\u0438\u0441\u044c'. \u041f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u044f\u0439\u0442\u0435\u0441\u044c."
  ],
