{
  "subject": "\u0421\u0435\u043a\u0440\u0435\u0442\u043d\u0430 \u0444\u0443\u043d\u043a\u0446\u0456\u044f, \u044f\u043a\u0443 \u043f\u0440\u0438\u0445\u043e\u0432\u0443\u044e\u0442\u044c 90% \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432",
  "preview_text": "\u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u0434\u043b\u044f \u0441\u0435\u0431\u0435 \u043b\u0430\u0439\u0444\u0445\u0430\u043a, \u044f\u043a\u0438\u0439 \u0437\u043c\u0456\u043d\u044e\u0454 \u0433\u0440\u0443. \u0422\u0456\u043b\u044c\u043a\u0438 \u0434\u043b\u044f \u0442\u0438\u0445, \u0445\u0442\u043e \u0445\u043e\u0447\u0435 \u043f\u0435\u0440\u0435\u043c\u0430\u0433\u0430\u0442\u0438 \u0447\u0430\u0441\u0442\u0456\u0448\u0435.",
  "body_paragraphs": [
    "\u042f \u0437\u043d\u0430\u044e, \u0449\u043e \u0442\u0438 \u0432\u0436\u0435 50 \u0434\u043d\u0456\u0432 \u0437 \u043d\u0430\u043c\u0438, \u0456, \u043d\u0430\u043f\u0435\u0432\u043d\u043e, \u0434\u0443\u043c\u0430\u0454\u0448, \u0449\u043e \u0437\u043d\u0430\u0454\u0448 \u0443\u0441\u0456 \u0444\u0456\u0448\u043a\u0438. \u0410\u043b\u0435 \u0454 \u043e\u0434\u043d\u0430 \u0440\u0456\u0447, \u044f\u043a\u0443 \u043c\u0438 \u043f\u0440\u0438\u0445\u043e\u0432\u0443\u0454\u043c\u043e \u043d\u0430\u0432\u0456\u0442\u044c \u0432\u0456\u0434 \u043d\u0430\u0439\u0430\u043a\u0442\u0438\u0432\u043d\u0456\u0448\u0438\u0445. \u0426\u0435 \u043d\u0435 \u0431\u0430\u0433, \u0446\u0435 \u0444\u0456\u0447\u0430, \u044f\u043a\u0443 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c \u043b\u0438\u0448\u0435 \u0442\u0456, \u0445\u0442\u043e \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u0440\u043e\u0437\u0443\u043c\u0456\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u0444\u0443\u0442\u0431\u043e\u043b\u0456.",
    "\u0423\u044f\u0432\u0438: \u0442\u0438 \u0431\u0430\u0447\u0438\u0448 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u043d\u0430 \u043c\u0430\u0442\u0447, \u0430\u043b\u0435 \u0445\u043e\u0447\u0435\u0448 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438, \u0447\u0438 \u0432\u0430\u0440\u0442\u043e \u0439\u043e\u043c\u0443 \u0434\u043e\u0432\u0456\u0440\u044f\u0442\u0438. \u0411\u0456\u043b\u044c\u0448\u0456\u0441\u0442\u044c \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0438\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u0432\u0456\u0434\u0441\u043e\u0442\u043e\u043a \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u043e\u0441\u0442\u0456 AI. \u0410\u043b\u0435 \u0441\u043f\u0440\u0430\u0432\u0436\u043d\u0456 \u043f\u0440\u043e\u0444\u0456 \u0440\u043e\u0431\u043b\u044f\u0442\u044c \u0456\u043d\u0430\u043a\u0448\u0435 \u2014 \u0432\u043e\u043d\u0438 \u043a\u043e\u043f\u0430\u044e\u0442\u044c \u0433\u043b\u0438\u0431\u0448\u0435. \u0412\u043e\u043d\u0438 \u0437\u043d\u0430\u044e\u0442\u044c, \u0449\u043e \u0437\u0430 \u043a\u043e\u0436\u043d\u0438\u043c \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u043e\u043c \u0441\u0442\u043e\u0457\u0442\u044c \u0436\u0438\u0432\u0430 \u0456\u0441\u0442\u043e\u0440\u0456\u044f: xG, \u0444\u043e\u0440\u043c\u0430 \u0433\u0440\u0430\u0432\u0446\u0456\u0432, \u043d\u0430\u0432\u0456\u0442\u044c \u043f\u043e\u0433\u043e\u0434\u0430 \u043d\u0430 \u0441\u0442\u0430\u0434\u0456\u043e\u043d\u0456.",
    "\u042f \u0432\u0456\u0434\u043a\u0440\u0438\u044e \u0442\u043e\u0431\u0456 \u0441\u0435\u043a\u0440\u0435\u0442: \u0443 Predictify \u0454 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0439 \u0440\u0435\u0436\u0438\u043c '\u0414\u0435\u0442\u0430\u043b\u044c\u043d\u0438\u0439 \u0430\u043d\u0430\u043b\u0456\u0437'. \u041d\u0430\u0442\u0438\u0441\u043d\u0438 \u043d\u0430 \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u043c\u0430\u0442\u0447 \u0443 \u0441\u0442\u0440\u0456\u0447\u0446\u0456 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0456\u0432 \u0456 \u043f\u043e\u0442\u0440\u0438\u043c\u0430\u0439 \u043f\u0430\u043b\u0435\u0446\u044c \u043d\u0430 \u043a\u043d\u043e\u043f\u0446\u0456 '\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u0438 \u0431\u0456\u043b\u044c\u0448\u0435' \u2014 \u0437'\u044f\u0432\u0438\u0442\u044c\u0441\u044f \u0432\u0456\u043a\u043d\u043e, \u0434\u0435 AI \u0432\u0438\u043a\u043b\u0430\u0434\u0430\u0454 \u0432\u0441\u0456 \u043a\u0430\u0440\u0442\u0438. \u0422\u0430\u043c \u0442\u0438 \u043f\u043e\u0431\u0430\u0447\u0438\u0448, \u0447\u043e\u043c\u0443 \u0441\u0430\u043c\u0435 \u0442\u0430\u043a\u0438\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442, \u044f\u043a\u0456 \u0437\u043c\u0456\u043d\u043d\u0456 \u0432\u0438\u0440\u0456\u0448\u0430\u043b\u044c\u043d\u0456, \u0456 \u0434\u0435 \u0445\u043e\u0432\u0430\u0454\u0442\u044c\u0441\u044f \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448\u0430 \u0446\u0456\u043d\u043d\u0456\u0441\u0442\u044c. \u0426\u0435 \u044f\u043a \u043c\u0430\u0442\u0438 \u0442\u0440\u0435\u043d\u0435\u0440\u0430, \u044f\u043a\u0438\u0439 \u0448\u0435\u043f\u043e\u0447\u0435 \u0442\u043e\u0431\u0456 \u043f\u0440\u0430\u0432\u0434\u0443.",
    "\u0421\u043f\u0440\u043e\u0431\u0443\u0439 \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u0440\u0430\u0437: \u0432\u0456\u0434\u043a\u0440\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a, \u0437\u043d\u0430\u0439\u0434\u0438 \u043c\u0430\u0442\u0447 \u043d\u0430 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456, \u0456 \u0437\u0440\u043e\u0431\u0438 \u0446\u0435\u0439 \u0442\u0440\u044e\u043a. \u0422\u0438 \u0437\u0434\u0438\u0432\u0443\u0454\u0448\u0441\u044f, \u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445 \u0442\u0438 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u0432. P.S. \u042f\u043a\u0449\u043e \u0445\u043e\u0447\u0435\u0448 \u0449\u0435 \u0431\u0456\u043b\u044c\u0448\u0435 \u2014 \u0441\u043f\u0440\u043e\u0431\u0443\u0439 Premium \u043d\u0430 3 \u0434\u043d\u0456 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u043e. \u0422\u0430\u043c \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u044e\u0442\u044c\u0441\u044f \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438 \u043d\u0430 \u0432\u0441\u0456 50+ \u043b\u0456\u0433, \u0456 \u0446\u0435\u0439 \u043b\u0430\u0439\u0444\u0445\u0430\u043a \u043f\u0440\u0430\u0446\u044e\u0454 \u0432 \u0440\u0430\u0437\u0438 \u043f\u043e\u0442\u0443\u0436\u043d\u0456\u0448\u0435."
  ],
