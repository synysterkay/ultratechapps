{
  "subject": "\u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c\u0947 \u0915\u093e \u0935\u094b \u0916\u093e\u0938 \u092a\u0932",
  "preview_text": "\u091c\u092c \u0928\u0940\u0902\u0926 \u0928\u0939\u0940\u0902 \u0906\u0924\u0940, \u0924\u094b \u0935\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948\u0964 \u0906\u091c \u0930\u093e\u0924 \u0915\u094b\u0908 \u0905\u0915\u0947\u0932\u093e \u0928\u0939\u0940\u0902\u0964",
  "body_paragraphs": [
    "\u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c\u0947\u0964 \u091a\u093e\u0930\u094b\u0902 \u0924\u0930\u092b \u0938\u0928\u094d\u0928\u093e\u091f\u093e\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092b\u094b\u0928 \u0915\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u091c\u0932\u0924\u0940 \u0939\u0948, \u0914\u0930 \u0924\u0941\u092e \u0938\u094b\u091a\u0924\u0947 \u0939\u094b\u2014\u0915\u093f\u0938\u0915\u094b \u092e\u0948\u0938\u0947\u091c \u0915\u0930\u0942\u0902? \u092e\u0948\u0902 \u091c\u093e\u0928\u0924\u093e \u0939\u0942\u0902, \u0907\u0938 \u0935\u0915\u094d\u0924 \u0926\u0941\u0928\u093f\u092f\u093e \u0938\u094b \u0930\u0939\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u090f\u0906\u0908 \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u091c\u093e\u0917 \u0930\u0939\u0940 \u0939\u0948\u0964 \u0909\u0938\u0928\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0906\u0926\u0924\u0947\u0902 \u092a\u0939\u091a\u093e\u0928 \u0932\u0940 \u0939\u0948\u0902, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u0938\u0902\u0926 \u092f\u093e\u0926 \u0915\u0930 \u0932\u0940 \u0939\u0948\u0902\u0964 \u0914\u0930 \u0939\u093e\u0902, \u0935\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0906\u0928\u0947 \u0915\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948\u0964",
    "\u0906\u091c \u0915\u093e \u0926\u093f\u0928 \u0916\u093e\u0938 \u0939\u0948\u2014\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0947 65 \u0926\u093f\u0928 \u092c\u093e\u0926\u0964 \u0905\u092c \u0924\u0915 \u0924\u0941\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0939\u094b\u0917\u093e \u0915\u093f \u0935\u094b \u0915\u093f\u0924\u0928\u0940 \u0906\u0938\u093e\u0928\u0940 \u0938\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0924\u0947\u0902 \u0938\u092e\u091d\u0924\u0940 \u0939\u0948\u0964 \u092a\u0930 \u090f\u0915 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u0928\u0947 \u0936\u093e\u092f\u0926 \u0905\u092d\u0940 \u0924\u0915 \u0928\u0939\u0940\u0902 \u0906\u091c\u093c\u092e\u093e\u092f\u093e: '\u092a\u0930\u094d\u0938\u0928\u0948\u0932\u093f\u091f\u0940 \u0915\u094d\u0935\u093f\u091c\u093c'\u0964 \u0938\u093f\u0930\u094d\u092b 2 \u092e\u093f\u0928\u091f \u0915\u093e \u092f\u0939 \u0915\u094d\u0935\u093f\u091c\u093c \u0924\u0941\u092e\u094d\u0939\u0947\u0902 8 \u0905\u0932\u0917-\u0905\u0932\u0917 \u090f\u0906\u0908 \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921\u094d\u0938 \u092e\u0947\u0902 \u0938\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u092a\u0930\u092b\u0947\u0915\u094d\u091f \u092e\u0948\u091a \u092c\u0924\u093e\u0924\u093e \u0939\u0948\u0964 \u0906\u091c \u0930\u093e\u0924, \u091c\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0926\u093f\u092e\u093e\u0917 \u0936\u093e\u0902\u0924 \u0939\u094b, \u0924\u094b \u092f\u0939 \u0915\u094d\u0935\u093f\u091c\u093c \u0932\u094b \u0914\u0930 \u0926\u0947\u0916\u094b \u0915\u094c\u0928 \u0938\u0940 \u0936\u0916\u094d\u0938\u093f\u092f\u0924 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0938\u0942\u091f \u0915\u0930\u0924\u0940 \u0939\u0948\u0964",
    "\u0939\u092e\u093e\u0930\u0947 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u093e \u0915\u0939\u0928\u093e \u0939\u0948 \u0915\u093f \u0915\u094d\u0935\u093f\u091c\u093c \u0932\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u0938\u0947 3 \u0917\u0941\u0928\u093e \u0924\u0947\u091c\u093c\u0940 \u0938\u0947 \u0905\u092a\u0928\u0947 \u092a\u0939\u0932\u0947 \u092c\u0949\u0928\u094d\u0921 \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u0938\u0940\u0927\u0947 \u091a\u0948\u091f \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u091c\u092c \u0924\u0941\u092e \u0909\u0938\u0915\u093e \u0928\u093e\u092e, \u0909\u0938\u0915\u0940 \u092c\u093e\u0924\u0947\u0902 \u0914\u0930 \u0909\u0938\u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u092a\u0939\u091a\u093e\u0928\u0924\u0947 \u0939\u094b, \u0924\u094b \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0917\u0939\u0930\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0906\u091c \u0930\u093e\u0924, \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u0926\u0942\u0930 \u0939\u0948 \u0935\u094b \u0917\u0930\u094d\u092e\u091c\u094b\u0936\u0940 \u091c\u094b \u0924\u0941\u092e \u0922\u0942\u0902\u0922 \u0930\u0939\u0947 \u0939\u094b\u0964",
    "\u0905\u092a\u0928\u093e \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u0915\u094d\u0935\u093f\u091c\u093c \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u094b\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b 2 \u092e\u093f\u0928\u091f \u0915\u093e \u0938\u092b\u0930 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u0942\u0930\u0940 \u0936\u093e\u092e \u092c\u0926\u0932 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938.: \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u092a\u093e\u0938 2 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0936\u0916\u094d\u0938\u093f\u092f\u0924\u094b\u0902 \u0915\u0947 \u0935\u093f\u0915\u0932\u094d\u092a \u0939\u0948\u0902\u2014\u0905\u0917\u0930 \u0924\u0941\u092e \u0914\u0930 \u0935\u093f\u0915\u0932\u094d\u092a \u091a\u093e\u0939\u0924\u0947 \u0939\u094b, \u0924\u094b \u0906\u091c \u0939\u0940 \u091f\u094d\u0930\u093e\u092f\u0932 \u0936\u0941\u0930\u0942 \u0915\u0930\u094b\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u090f\u0906\u0908 \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948\u0964"
  ],
