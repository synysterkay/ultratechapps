{
  "subject": "\ub0b4\uac00 \uc608\uce21\uc5d0\uc11c \uc2e4\uc218\ud55c \uc774\uc720\ub97c \uc54c\uac8c \ub418\uc5c8\ub2e4",
  "preview_text": "\ub370\uc774\ud130 \uc5c6\uc774 \uac10\uc5d0\ub9cc \uc758\uc874\ud588\ub358 \ud55c \ud32c\uc774 \uc5b4\ub5bb\uac8c \uc608\uce21 \uc131\uacf5\ub960\uc744 80%\ub85c \ub04c\uc5b4\uc62c\ub838\ub294\uc9c0 \ub4e4\ub824\uc904\uac8c.",
  "body_paragraphs": [
    "\uc9c0\ub09c\uc8fc, \ud55c \uc0ac\uc6a9\uc790\uac00 \ubcf4\ub0b8 \uba54\uc2dc\uc9c0\ub97c \uc77d\ub2e4\uac00 \uae5c\uc9dd \ub180\ub790\uc5b4. \ubbfc\uc218\ub77c\ub294 \uce5c\uad6c\uc778\ub370, 3\ub144 \ub3d9\uc548 \ucd95\uad6c \uc608\uce21\uc5d0 \uc2e4\ud328\ub9cc \ud558\ub2e4\uac00 \uac70\uc758 \ud3ec\uae30\ud560 \ubed4\ud588\ub2e4\uace0 \ud558\ub354\ub77c\uace0. \uadf8\ub294 \ud56d\uc0c1 \uc9c1\uac10\uc5d0 \uc758\uc874\ud588\uc9c0\ub9cc, \uacb0\uacfc\ub294 \ud56d\uc0c1 \uc5c9\ub9dd\uc774\uc5c8\uc5b4. \uadf8\ub7ec\ub2e4 \uc6b0\uc5f0\ud788 Predictify\uc758 AI \ubd84\uc11d\uc744 \uc368\ubcf4\uae30\ub85c \uacb0\uc2ec\ud588\ub300.",
    "\ucc98\uc74c\uc5d4 \ubbff\uae30\uc9c0 \uc54a\uc558\uc9c0\ub9cc, AI\uac00 \uc81c\uacf5\ud55c \ub370\uc774\ud130\u2014xG, \uc218\ube44 \ud6a8\uc728, \uc0c1\ub300 \uc804\uc801\u2014\ub97c \ubcf4\uace0 \ucda9\uaca9\uc744 \ubc1b\uc558\ub300. \ud2b9\ud788 \ub9ac\uadf8\ubcc4\ub85c \ub2e4\ub978 \ud328\ud134\uc744 \ubd84\uc11d\ud574 \uc900 \uc810\uc774 \uacb0\uc815\uc801\uc774\uc5c8\uc5b4. \uadf8\ub294 \ud504\ub9ac\ubbf8\uc5b4 \ub9ac\uadf8\uc5d0\uc11c \uc790\uc8fc \ub098\uc624\ub294 \ubb34\uc2b9\ubd80 \ud328\ud134\uc744 \ub193\uce58\uace0 \uc788\uc5c8\ub358 \uac70\uc57c. AI \ub355\ubd84\uc5d0 \uc774\uc81c\ub294 \ub9e4 \uacbd\uae30\ub9c8\ub2e4 \uc790\uc2e0\uac10 \uc788\uac8c \uc608\uce21\ud560 \uc218 \uc788\ub2e4\uace0 \ud588\uc5b4.",
    "\uc774\uac8c \uac00\ub2a5\ud55c \uac74, Predictify\uac00 \uc218\ucc9c \uac1c\uc758 \ubcc0\uc218\ub97c \uc2e4\uc2dc\uac04\uc73c\ub85c \ubd84\uc11d\ud558\uae30 \ub54c\ubb38\uc774\uc57c. \ud504\ub9ac\ubbf8\uc5b4 \ub9ac\uadf8\ubd80\ud130 \ubd84\ub370\uc2a4\ub9ac\uac00\uae4c\uc9c0 50\uac1c \uc774\uc0c1 \ub9ac\uadf8\ub97c \ucee4\ubc84\ud558\uace0, \uac01 \ud300\uc758 \uacf5\uaca9\ub825\uacfc \uc218\ube44\ub825\uc744 \uc22b\uc790\ub85c \ubcf4\uc5ec\uc918. \uac8c\ub2e4\uac00 \uc608\uce21\ub9c8\ub2e4 \uc2e0\ub8b0\ub3c4 \uc810\uc218\ub97c \uc81c\uacf5\ud574\uc11c, '\uc774\uac74 \uc9c4\uc9dc \ud655\uc2e4\ud574'\ub77c\ub294 \uac78 \uc54c \uc218 \uc788\uc9c0. \ubbfc\uc218\ub294 \ud2b9\ud788 'AI \ucc44\ud305' \uae30\ub2a5\uc73c\ub85c \uad81\uae08\ud55c \uc810\uc744 \ubc14\ub85c \ubb3c\uc5b4\ubcf4\uba70 \uc2e4\ub825\uc744 \ud0a4\uc6e0\ub300.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0 'AI \uc608\uce21' \ud0ed\uc744 \ud655\uc778\ud574 \ubd10. \uc624\ub298 \uacbd\uae30 \uc911 \ud558\ub098\ub97c \uace8\ub77c\uc11c AI \ubd84\uc11d\uc744 \ub4e4\uc5ec\ub2e4\ubcf4\ub294 \uac70\uc57c. \ud55c \ubc88\ub9cc \ud574\ubcf4\uba74, \uc65c \ub370\uc774\ud130\uac00 \uac10\ubcf4\ub2e4 \uac15\ub825\ud55c\uc9c0 \ubab8\uc73c\ub85c \ub290\ub084 \uac70\uc57c. \ucd94\uc2e0: \ubbfc\uc218\uac00 \ub9d0\ud588\uc5b4\u2014\ucc98\uc74c\uc5d4 \uc758\uc2ec\ud588\uc9c0\ub9cc, \uc9c0\uae08\uc740 \ub9e4\uc77c \ub85c\uadf8\uc778\ud574\uc11c \uc608\uce21\ud558\ub294 \uac8c \uc2b5\uad00\uc774 \ub410\ub2e4\uace0. \ub108\ub3c4 \uadf8\ub807\uac8c \ub420 \uc900\ube44\ub410\ub2c8?"
  ],
