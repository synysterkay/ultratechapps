{
  "subject": "3 \u043c\u0438\u043d\u0443\u0442\u044b, \u043c\u0435\u043d\u044f\u044e\u0449\u0438\u0435 \u0432\u0441\u0451",
  "preview_text": "\u041a\u0430\u043a \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u0443\u0442\u0440\u0435\u043d\u043d\u044e\u044e \u0440\u0443\u0442\u0438\u043d\u0443 \u0432 \u043c\u043e\u0449\u043d\u044b\u0439 \u0431\u0430\u0441\u043e\u0432\u044b\u0439 \u0443\u0434\u0430\u0440. \u0421\u043f\u043e\u0439\u043b\u0435\u0440: \u044d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442.",
  "body_paragraphs": [
    "\u0422\u044b \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0448\u044c Bass Booster, \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0448\u044c \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u0438 \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u0448\u044c. \u041f\u0440\u043e\u0445\u043e\u0434\u0438\u0442 \u043d\u0435\u0434\u0435\u043b\u044f \u2014 \u0437\u0432\u0443\u043a \u0441\u043d\u043e\u0432\u0430 \u043f\u043b\u043e\u0441\u043a\u0438\u0439. \u0417\u043d\u0430\u043a\u043e\u043c\u043e?",
    "\u0414\u0435\u043b\u043e \u043d\u0435 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445. \u0414\u0435\u043b\u043e \u0432 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0435. \u042f \u0437\u0430\u043c\u0435\u0442\u0438\u043b: \u0442\u0435, \u043a\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0447\u0430\u0441\u0442\u044c\u044e \u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0433\u043e \u0440\u0438\u0442\u0443\u0430\u043b\u0430, \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 \u0432 10 \u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448\u0435 \u043a\u0430\u0439\u0444\u0430. \u0422\u0440\u0435\u043a\u0438 \u0437\u0432\u0443\u0447\u0430\u0442 \u043a\u0430\u043a \u0436\u0438\u0432\u044b\u0435, \u0434\u0430\u0436\u0435 \u043d\u0430 \u0434\u0435\u0448\u0451\u0432\u044b\u0445 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u0445.",
    "\u0412\u043e\u0442 \u0447\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442: \u043a\u0430\u0436\u0434\u043e\u0435 \u0443\u0442\u0440\u043e, \u043f\u0435\u0440\u0435\u0434 \u0442\u0435\u043c \u043a\u0430\u043a \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c Spotify, \u043e\u0442\u043a\u0440\u043e\u0439 Bass Booster \u0438 \u0432\u043a\u043b\u044e\u0447\u0438 Bass Virtualizer \u043d\u0430 3 \u043c\u0438\u043d\u0443\u0442\u044b. \u041f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0434\u043d\u0438\u043c\u0438 \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a Boost \u0434\u043e 80% \u2014 \u0438 \u0441\u043b\u0443\u0448\u0430\u0439 \u0441\u0432\u043e\u0439 \u043b\u044e\u0431\u0438\u043c\u044b\u0439 \u0442\u0440\u0435\u043a. \u042d\u0442\u043e \u043d\u0435 \u043c\u0430\u0433\u0438\u044f, \u044d\u0442\u043e \u0444\u0438\u0437\u0438\u043a\u0430 \u0437\u0432\u0443\u043a\u0430. \u0422\u0432\u043e\u0439 \u043c\u043e\u0437\u0433 \u043f\u0440\u0438\u0432\u044b\u043a\u0430\u0435\u0442 \u043a \u0433\u043b\u0443\u0431\u0438\u043d\u0435, \u0438 \u043f\u043e\u0442\u043e\u043c \u043a\u0430\u0436\u0434\u044b\u0439 \u0442\u0440\u0435\u043a \u0431\u044c\u0451\u0442 \u0432 \u0433\u0440\u0443\u0434\u044c.",
    "\u0421\u0434\u0435\u043b\u0430\u0439 \u044d\u0442\u043e \u0437\u0430\u0432\u0442\u0440\u0430. \u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0432\u043a\u043b\u044e\u0447\u0438 Boost \u0438 Bass Virtualizer. \u0412\u0441\u0435\u0433\u043e 3 \u043c\u0438\u043d\u0443\u0442\u044b. P.S. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c \u2014 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 Premium \u043d\u0430 \u043d\u0435\u0434\u0435\u043b\u044e. \u041f\u043e\u043b\u043d\u044b\u0439 10-\u043f\u043e\u043b\u043e\u0441\u043d\u044b\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u0438 \u043d\u0435\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0439 \u0431\u0443\u0441\u0442. \u041d\u043e \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0447\u043d\u0438.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Bass Booster \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u0432\u043a\u043b\u044e\u0447\u0438 Bass Virtualizer \u043d\u0430 3 \u043c\u0438\u043d\u0443\u0442\u044b. \u041f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0439 \u0440\u0430\u0437\u043d\u0438\u0446\u0443."
