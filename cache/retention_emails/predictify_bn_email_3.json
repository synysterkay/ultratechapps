{
  "subject": "\u09a6\u09c1\u0987 \u09ae\u09bf\u09a8\u09bf\u099f\u09c7\u09b0 \u099f\u09cd\u09b0\u09bf\u0995 \u09af\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09ad\u09ac\u09bf\u09b7\u09cd\u09af\u09a6\u09cd\u09ac\u09be\u09a3\u09c0 \u09ac\u09a6\u09b2\u09c7 \u09a6\u09c7\u09ac\u09c7",
  "preview_text": "\u098f\u0995\u099f\u09bf \u09b8\u09b9\u099c \u0995\u09cc\u09b6\u09b2 \u09af\u09be \u0986\u099c\u0987 \u0986\u09aa\u09a8\u09be\u09b0 \u09ae\u09cd\u09af\u09be\u099a \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8\u0995\u09c7 \u0986\u09b0\u0993 \u09a8\u09bf\u09b0\u09cd\u09ad\u09c1\u09b2 \u0995\u09b0\u09ac\u09c7\u0964",
  "body_paragraphs": [
    "\u09a7\u09b0\u09c1\u09a8, \u0986\u09aa\u09a8\u09bf \u0986\u099c \u09b0\u09be\u09a4\u09c7 \u09b2\u09bf\u09ad\u09be\u09b0\u09aa\u09c1\u09b2 \u09ac\u09a8\u09be\u09ae \u0986\u09b0\u09cd\u09b8\u09c7\u09a8\u09be\u09b2 \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u09a6\u09bf\u09a4\u09c7 \u09ac\u09b8\u09c7\u099b\u09c7\u09a8\u0964 \u0986\u09aa\u09a8\u09bf \u099c\u09be\u09a8\u09c7\u09a8, \u09b2\u09bf\u09ad\u09be\u09b0\u09aa\u09c1\u09b2\u09c7\u09b0 \u0986\u0995\u09cd\u09b0\u09ae\u09a3 \u09b6\u0995\u09cd\u09a4\u09bf\u09b6\u09be\u09b2\u09c0, \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u09b0\u09cd\u09b8\u09c7\u09a8\u09be\u09b2\u09c7\u09b0 \u09a1\u09bf\u09ab\u09c7\u09a8\u09cd\u09b8\u0993 \u0995\u09ae \u09af\u09be\u099a\u09cd\u099b\u09c7 \u09a8\u09be\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u0997\u09be\u099f \u09ab\u09bf\u09b2\u09bf\u0982 \u09ac\u09b2\u099b\u09c7 \u09e8-\u09e7 \u0997\u09cb\u09b2 \u09b9\u09ac\u09c7\u0964 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u09b8\u09b2 \u0995\u09a5\u09be \u09b9\u09b2, \u0997\u09be\u099f \u09ab\u09bf\u09b2\u09bf\u0982 \u09aa\u09cd\u09b0\u09be\u09af\u09bc\u0987 \u09ad\u09c1\u09b2 \u0995\u09b0\u09c7\u0964",
    "\u098f\u0995\u099f\u09bf \u099b\u09cb\u099f \u0995\u09cc\u09b6\u09b2 \u0986\u099b\u09c7 \u09af\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8\u0995\u09c7 \u0986\u09b0\u0993 \u09a1\u09c7\u099f\u09be-\u09ac\u09cd\u09af\u09be\u0995\u09a1 \u0995\u09b0\u09c7 \u09a4\u09c1\u09b2\u09ac\u09c7: \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u0986\u0997\u09c7 Predictify-\u09a4\u09c7 \"\u09b9\u09c7\u09a1-\u099f\u09c1-\u09b9\u09c7\u09a1 \u09b9\u09bf\u09b8\u09cd\u099f\u09cd\u09b0\u09bf\" \u098f\u09ac\u0982 \"xG\" (\u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u09b6\u09bf\u09a4 \u0997\u09cb\u09b2) \u09a1\u09c7\u099f\u09be \u09a6\u09c7\u0996\u09c1\u09a8\u0964 \u098f\u0996\u09be\u09a8\u09c7 \u0986\u09aa\u09a8\u09bf \u09aa\u09be\u09ac\u09c7\u09a8 \u099f\u09bf\u09ae\u0997\u09c1\u09b2\u09cb\u09b0 \u09b8\u09be\u09ae\u09cd\u09aa\u09cd\u09b0\u09a4\u09bf\u0995 \u09ab\u09b0\u09cd\u09ae, \u0986\u0995\u09cd\u09b0\u09ae\u09a3 \u0993 \u09a1\u09bf\u09ab\u09c7\u09a8\u09cd\u09b8\u09c7\u09b0 \u09a6\u0995\u09cd\u09b7\u09a4\u09be, \u098f\u09ac\u0982 \u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3\u2014\u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09a6\u09b2\u09c7\u09b0 \u0997\u09a1\u09bc xG\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, \u09af\u09a6\u09bf \u09b2\u09bf\u09ad\u09be\u09b0\u09aa\u09c1\u09b2\u09c7\u09b0 xG \u09e8.\u09e7 \u09b9\u09af\u09bc \u098f\u09ac\u0982 \u0986\u09b0\u09cd\u09b8\u09c7\u09a8\u09be\u09b2\u09c7\u09b0 xG \u09e7.\u09ee \u09b9\u09af\u09bc, \u09a4\u09be\u09b9\u09b2\u09c7 \u09e8-\u09e7 \u09ac\u09be \u09e8-\u09e8 \u09b8\u09cd\u0995\u09cb\u09b0 \u09b9\u0993\u09af\u09bc\u09be\u09b0 \u09b8\u09ae\u09cd\u09ad\u09be\u09ac\u09a8\u09be \u0985\u09a8\u09c7\u0995 \u09ac\u09c7\u09a1\u09bc\u09c7 \u09af\u09be\u09af\u09bc\u0964",
    "\u098f\u0987 \u098f\u0995 \u099f\u09cd\u09b0\u09bf\u0995 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09bf \u09b6\u09c1\u09a7\u09c1 \u0997\u09be\u099f \u09ab\u09bf\u09b2\u09bf\u0982\u09af\u09bc\u09c7\u09b0 \u09a5\u09c7\u0995\u09c7 \u09a1\u09c7\u099f\u09be\u09b0 \u09b6\u0995\u09cd\u09a4\u09bf\u09a4\u09c7 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u09a6\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8\u0964 Predictify-\u09b0 AI \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b9\u09be\u099c\u09be\u09b0\u09cb \u09ad\u09c7\u09b0\u09bf\u09af\u09bc\u09c7\u09ac\u09b2 \u0985\u09cd\u09af\u09be\u09a8\u09be\u09b2\u09be\u0987\u099c \u0995\u09b0\u09c7, \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u09aa\u09a8\u09bf \u09a8\u09bf\u099c\u09c7\u0993 \u098f\u0987 \u09b8\u09b9\u099c \u09a1\u09c7\u099f\u09be \u09a6\u09c7\u0996\u09c7 \u0986\u09b0\u0993 \u09b8\u09cd\u09ae\u09be\u09b0\u09cd\u099f \u09b8\u09bf\u09a6\u09cd\u09a7\u09be\u09a8\u09cd\u09a4 \u09a8\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u09b8\u09cd\u0995\u09cb\u09b0\u0993 \u09a6\u09c7\u0996\u09a4\u09c7 \u09ad\u09c1\u09b2\u09ac\u09c7\u09a8 \u09a8\u09be\u2014\u098f\u099f\u09be \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09ac\u09b2\u09c7 \u09a6\u09c7\u09ac\u09c7 AI \u0995\u09a4\u099f\u09be \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u09a4\u09be\u09b0 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u09a8\u09bf\u09af\u09bc\u09c7\u0964",
    "\u0986\u099c\u0987 Predictify \u0996\u09c1\u09b2\u09c1\u09a8 \u098f\u09ac\u0982 \u098f\u0995\u099f\u09bf \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b9\u09c7\u09a1-\u099f\u09c1-\u09b9\u09c7\u09a1 \u0993 xG \u09a1\u09c7\u099f\u09be \u099a\u09c7\u0995 \u0995\u09b0\u09c1\u09a8\u0964 \u09a4\u09be\u09b0\u09aa\u09b0 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u09a6\u09bf\u09a8 \u098f\u09ac\u0982 \u09a6\u09c7\u0996\u09c1\u09a8 \u0995\u09a4\u099f\u09be \u0989\u09a8\u09cd\u09a8\u09a4\u09bf \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964 P.S. \u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09af\u09bc\u09be\u09ae \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0\u09be \u0986\u09b0\u0993 \u0985\u09cd\u09af\u09be\u09a1\u09ad\u09be\u09a8\u09cd\u09b8\u09a1 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u099f\u09b8 \u09aa\u09be\u09af\u09bc\u2014\u09af\u09c7\u09ae\u09a8 \u09aa\u099c\u09c7\u09b6\u09a8 \u0985\u09cd\u09af\u09be\u09a8\u09be\u09b2\u09be\u0987\u09b8\u09bf\u09b8 \u0993 \u09a1\u09bf\u09ab\u09c7\u09a8\u09cd\u09b8\u09bf\u09ad \u09b8\u09cd\u099f\u09cd\u09b0\u09c7\u0982\u09a5\u0964 \u09e9 \u09a6\u09bf\u09a8\u09c7\u09b0 \u09ab\u09cd\u09b0\u09bf \u099f\u09cd\u09b0\u09be\u09af\u09bc\u09be\u09b2\u09c7 \u098f\u0996\u09a8\u0987 \u09a6\u09c7\u0996\u09c7 \u09a8\u09bf\u09a8\u0964"
  ],
