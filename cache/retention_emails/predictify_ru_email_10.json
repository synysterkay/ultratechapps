{
  "subject": "\u041a\u0430\u043a \u0442\u043e\u043f-1% \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044e\u0442 Predictify",
  "preview_text": "\u0423 \u043d\u0438\u0445 \u043d\u0435\u0442 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043d\u0430 \u0434\u043e\u0433\u0430\u0434\u043a\u0438. \u0423\u0437\u043d\u0430\u0439, \u043a\u0430\u043a \u043e\u043d\u0438 \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 \u0434\u0430\u043d\u043d\u044b\u0435 \u0434\u043e \u043c\u0430\u0442\u0447\u0430 \u2014 \u0438 \u043f\u043e\u0447\u0435\u043c\u0443 \u0442\u044b \u043e\u0442\u0441\u0442\u0430\u0435\u0448\u044c.",
  "body_paragraphs": [
    "\u0412 \u043f\u0440\u043e\u0448\u043b\u044b\u0439 \u0432\u0442\u043e\u0440\u043d\u0438\u043a \u0432 3 \u0443\u0442\u0440\u0430 \u043e\u0434\u0438\u043d \u043f\u0430\u0440\u0435\u043d\u044c \u0438\u0437 \u043d\u0430\u0448\u0435\u0433\u043e \u0442\u043e\u043f-1% \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b \u0441\u043a\u0440\u0438\u043d\u0448\u043e\u0442 \u0432 \u0447\u0430\u0442: 12 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u043e\u0432 \u043f\u043e\u0434\u0440\u044f\u0434 \u0431\u0435\u0437 \u043f\u0440\u043e\u043c\u0430\u0445\u0430. \u041d\u0435 \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u043d \u0433\u0435\u043d\u0438\u0439 \u2014 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u043d \u0437\u043d\u0430\u0435\u0442, \u043a\u0430\u043a \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0440\u0430\u0431\u043e\u0447\u0443\u044e \u0446\u0435\u043f\u043e\u0447\u043a\u0443. \u0410 \u0442\u044b?",
    "\u041e\u043d\u0438 \u043d\u0435 \u0442\u0440\u0430\u0442\u044f\u0442 \u0432\u0440\u0435\u043c\u044f \u043d\u0430 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0439 \u0441\u043a\u0440\u043e\u043b\u043b \u043d\u043e\u0432\u043e\u0441\u0442\u0435\u0439. \u0412\u043c\u0435\u0441\u0442\u043e \u044d\u0442\u043e\u0433\u043e \u043e\u043d\u0438 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442 Predictify, \u0432\u044b\u0431\u0438\u0440\u0430\u044e\u0442 \u043c\u0430\u0442\u0447 \u0434\u043d\u044f \u0438 \u0441\u043c\u043e\u0442\u0440\u044f\u0442 \u043d\u0430 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u0438. \u0415\u0441\u043b\u0438 \u043e\u043d \u0432\u044b\u0448\u0435 75% \u2014 \u0441\u0442\u0430\u0432\u044f\u0442 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435. \u0415\u0441\u043b\u0438 \u043d\u0438\u0436\u0435 \u2014 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u0441\u044f \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u0439 \u043c\u0430\u0442\u0447. \u042d\u0442\u043e \u043d\u0435 \u043c\u0430\u0433\u0438\u044f, \u044d\u0442\u043e \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c: \u0434\u0430\u043d\u043d\u044b\u0435 \u0431\u044c\u044e\u0442 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044e \u0432 8 \u0438\u0437 10 \u0441\u043b\u0443\u0447\u0430\u0435\u0432.",
    "\u0424\u0438\u0448\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d\u0438 \u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0442: \u0432\u043a\u043b\u0430\u0434\u043a\u0430 \u00ab\u041c\u0430\u0442\u0447\u0438\u00bb \u0441 \u0444\u0438\u043b\u044c\u0442\u0440\u043e\u043c \u043f\u043e \u043b\u0438\u0433\u0430\u043c. \u041e\u043d\u0438 \u0432\u044b\u0431\u0438\u0440\u0430\u044e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u043f-5 \u043b\u0438\u0433 (\u0410\u041f\u041b, \u041b\u0430 \u041b\u0438\u0433\u0430, \u0411\u0443\u043d\u0434\u0435\u0441\u043b\u0438\u0433\u0430, \u0421\u0435\u0440\u0438\u044f \u0410, \u041b\u0438\u0433\u0430 \u0447\u0435\u043c\u043f\u0438\u043e\u043d\u043e\u0432) \u0438 \u0441\u043c\u043e\u0442\u0440\u044f\u0442 \u043d\u0430 xG \u0438 \u0442\u0430\u043a\u0442\u0438\u043a\u0443. \u0417\u0430 2 \u043c\u0438\u043d\u0443\u0442\u044b \u0443 \u043d\u0438\u0445 \u0433\u043e\u0442\u043e\u0432 \u043f\u043b\u0430\u043d \u043d\u0430 \u0432\u0435\u0447\u0435\u0440. \u0410 \u0442\u044b \u0432\u0441\u0451 \u0435\u0449\u0435 \u0433\u0430\u0434\u0430\u0435\u0448\u044c \u043d\u0430 \u043a\u043e\u0444\u0435\u0439\u043d\u043e\u0439 \u0433\u0443\u0449\u0435.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Predictify \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439 \u0441\u0432\u043e\u0439 \u0444\u0438\u043b\u044c\u0442\u0440: \u0432\u044b\u0431\u0435\u0440\u0438 \u043e\u0434\u043d\u0443 \u043b\u0438\u0433\u0443, \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0441 \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e \u0432\u044b\u0448\u0435 80% \u0438 \u043d\u0430\u0436\u043c\u0438 \u00ab\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0432 \u0438\u0437\u0431\u0440\u0430\u043d\u043d\u043e\u0435\u00bb. \u041f\u0435\u0440\u0432\u044b\u0439 \u0448\u0430\u0433 \u043a \u0442\u043e\u043f-1% \u2014 \u044d\u0442\u043e 30 \u0441\u0435\u043a\u0443\u043d\u0434. P.S. \u0422\u0432\u043e\u0439 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u043f\u043e \u00ab\u0420\u0435\u0430\u043b\u0443\u00bb \u0431\u044b\u043b \u043d\u0430 45% \u2014 \u0432 Premium \u0442\u044b \u0431\u044b \u0443\u0432\u0438\u0434\u0435\u043b, \u0447\u0442\u043e \u043e\u0448\u0438\u0431\u043a\u0430 \u0432 \u0442\u0430\u043a\u0442\u0438\u043a\u0435."
  ],
