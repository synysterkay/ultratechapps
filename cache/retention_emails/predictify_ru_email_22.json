{
  "subject": "\u0421\u0435\u043a\u0440\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u043f\u0440\u043e\u0444\u0438",
  "preview_text": "\u0422\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0448\u044c Predictify \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e. \u0412\u043e\u0442 \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 1% \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439, \u0447\u0442\u043e\u0431\u044b \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044b\u0442\u044c \u043d\u0430 \u0448\u0430\u0433 \u0432\u043f\u0435\u0440\u0435\u0434\u0438.",
  "body_paragraphs": [
    "\u042f \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u043a\u043e\u0435-\u0447\u0442\u043e \u0441\u0442\u0440\u0430\u043d\u043d\u043e\u0435. 90% \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0441\u043c\u043e\u0442\u0440\u044f\u0442 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u044b \u043d\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0438 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u044e\u0442. \u0410 \u043f\u043e\u0442\u043e\u043c \u0443\u0434\u0438\u0432\u043b\u044f\u044e\u0442\u0441\u044f, \u043f\u043e\u0447\u0435\u043c\u0443 \u0438\u0445 \u0441\u0442\u0430\u0432\u043a\u0438 \u043d\u0435 \u0437\u0430\u0445\u043e\u0434\u044f\u0442. \u041d\u043e \u0435\u0441\u0442\u044c \u043e\u0434\u043d\u0430 \u0444\u0438\u0448\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0430\u043c\u044b\u0435 \u0445\u0438\u0442\u0440\u044b\u0435 \u2014 \u0438 \u043e\u043d\u0430 \u043c\u0435\u043d\u044f\u0435\u0442 \u0432\u0441\u0451.",
    "\u0414\u0435\u043b\u043e \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e Predictify \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u0442\u044b\u0441\u044f\u0447\u0438 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u043d\u0430 \u043c\u0430\u0442\u0447, \u043d\u043e \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u0434\u0430\u0436\u0435 \u043d\u0435 \u0437\u0430\u0433\u043b\u044f\u0434\u044b\u0432\u0430\u0435\u0442 \u0432 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u0443\u044e \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443. \u0410 \u0437\u0440\u044f. \u041a\u043e\u0433\u0434\u0430 \u0442\u044b \u0441\u043c\u043e\u0442\u0440\u0438\u0448\u044c \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430 \u0441\u0447\u0451\u0442, \u0430 \u043d\u0430 xG, \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u0435 \u0438 \u043e\u0431\u043e\u0440\u043e\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438, \u0442\u044b \u0432\u0438\u0434\u0438\u0448\u044c \u043a\u0430\u0440\u0442\u0438\u043d\u0443 \u0446\u0435\u043b\u0438\u043a\u043e\u043c. \u041f\u0440\u043e\u0444\u0438 \u0437\u043d\u0430\u044e\u0442: \u043e\u0434\u0438\u043d \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c \u043c\u043e\u0436\u0435\u0442 \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u0442\u044c \u043f\u0440\u043e\u0433\u043d\u043e\u0437.",
    "\u0412\u043e\u0442 \u043b\u0430\u0439\u0444\u0445\u0430\u043a, \u043e \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043c\u043e\u043b\u0447\u0430\u0442: \u043e\u0442\u043a\u0440\u043e\u0439 \u043b\u044e\u0431\u043e\u0439 \u043c\u0430\u0442\u0447 \u0438 \u043d\u0430\u0436\u043c\u0438 \u043d\u0430 \u00ab\u0413\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437\u00bb. \u0422\u0430\u043c AI \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u043a\u0430\u043a\u0438\u0435 \u0444\u0430\u043a\u0442\u043e\u0440\u044b \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u0438 \u043d\u0430 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u2014 \u043e\u0442 \u0444\u043e\u0440\u043c\u044b \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0434\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043b\u0438\u0447\u043d\u044b\u0445 \u0432\u0441\u0442\u0440\u0435\u0447. \u042d\u0442\u043e \u043a\u0430\u043a \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043a\u0430\u0440\u0442\u044b \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u043f\u0435\u0440\u0435\u0434 \u0438\u0433\u0440\u043e\u0439. \u041f\u0430\u0440\u0430 \u043c\u0438\u043d\u0443\u0442 \u2014 \u0438 \u0442\u044b \u0432\u0438\u0434\u0438\u0448\u044c, \u0433\u0434\u0435 \u0431\u0443\u043a\u043c\u0435\u043a\u0435\u0440\u044b \u043e\u0448\u0438\u0431\u0430\u044e\u0442\u0441\u044f.",
    "\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441: \u043e\u0442\u043a\u0440\u043e\u0439 Predictify, \u0432\u044b\u0431\u0435\u0440\u0438 \u043b\u044e\u0431\u043e\u0439 \u043c\u0430\u0442\u0447 \u0438\u0437 \u0442\u043e\u043f-\u043b\u0438\u0433\u0438 \u0438 \u043d\u0430\u0436\u043c\u0438 \u043d\u0430 \u00ab\u0413\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437\u00bb. \u0423\u0432\u0438\u0434\u0438\u0448\u044c \u0440\u0430\u0437\u043d\u0438\u0446\u0443. P.S. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u0435\u0449\u0451 \u0431\u043e\u043b\u044c\u0448\u0435 \u0438\u043d\u0441\u0430\u0439\u0442\u043e\u0432 \u2014 \u0432\u043a\u043b\u044e\u0447\u0438 \u043f\u0440\u0435\u043c\u0438\u0443\u043c \u043d\u0430 3 \u0434\u043d\u044f \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e. \u0422\u0430\u043c \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0432\u0441\u0435 \u0441\u043a\u0440\u044b\u0442\u044b\u0435 \u043c\u0435\u0442\u0440\u0438\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e 1% \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439."
  ],
