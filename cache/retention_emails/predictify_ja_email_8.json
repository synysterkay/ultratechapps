{
  "subject": "\u3042\u308b\u30e6\u30fc\u30b6\u30fc\u304c\u72af\u3057\u305f\u81f4\u547d\u7684\u306a\u30df\u30b9\u3068\u3001\u305d\u306e\u5f8c\u306e\u9a5a\u304f\u3079\u304d\u767a\u898b",
  "preview_text": "\u5f7c\u306f\u6700\u521d\u3001AI\u306e\u4e88\u6e2c\u3092\u7121\u8996\u3057\u307e\u3057\u305f\u3002\u305d\u306e\u7d50\u679c\u3001\u5927\u304d\u306a\u30c1\u30e3\u30f3\u30b9\u3092\u9003\u3057\u305f\u306e\u3067\u3059\u3002\u3057\u304b\u3057\u3001\u305d\u306e\u5f8c\u3042\u308b\u3053\u3068\u306b\u6c17\u3065\u304d\u2026",
  "body_paragraphs": [
    "\u5c71\u7530\u3055\u3093\uff08\u4eee\u540d\uff09\u306f\u3001\u3042\u306a\u305f\u3068\u540c\u3058\u304f\u71b1\u72c2\u7684\u306a\u30b5\u30c3\u30ab\u30fc\u30d5\u30a1\u30f3\u3067\u3057\u305f\u3002\u3044\u3064\u3082\u4ef2\u9593\u3068\u4e88\u60f3\u3092\u7af6\u3044\u3001\u81ea\u5206\u306e\u300c\u52d8\u300d\u3092\u4fe1\u3058\u3066\u3044\u307e\u3057\u305f\u3002\u3042\u308b\u65e5\u3001Predictify\u304c\u300c\u3042\u308b\u8a66\u5408\u300d\u3067\u9ad8\u78ba\u5ea6\u306eAI\u4e88\u6e2c\u3092\u51fa\u3057\u305f\u3068\u304d\u3001\u5f7c\u306f\u3053\u3046\u8a00\u3063\u305f\u3093\u3067\u3059\u3002\u300c\u30c7\u30fc\u30bf\u306a\u3093\u3066\u95a2\u4fc2\u306a\u3044\u3001\u4ffa\u306e\u611f\u899a\u304c\u6b63\u3057\u3044\u300d\u3068\u3002",
    "\u7d50\u679c\u306f\u60e8\u6557\u3067\u3057\u305f\u3002\u5f7c\u304c\u4fe1\u3058\u305f\u30c1\u30fc\u30e0\u306f0-3\u3067\u8ca0\u3051\u3001AI\u304c\u793a\u3057\u305f\u300c\u4fa1\u5024\u3042\u308b\u8ced\u3051\u300d\u306e\u30c1\u30e3\u30f3\u30b9\u3092\u5b8c\u5168\u306b\u898b\u9003\u3057\u3066\u3057\u307e\u3063\u305f\u306e\u3067\u3059\u3002\u5f7c\u306f\u5f8c\u6094\u3057\u3001\u300c\u306a\u305c\u3042\u306e\u30c7\u30fc\u30bf\u3092\u898b\u306a\u304b\u3063\u305f\u306e\u304b\u300d\u3068\u4f55\u5ea6\u3082\u81ea\u5206\u306b\u554f\u3044\u307e\u3057\u305f\u3002\u3067\u3082\u3001\u3053\u3053\u304b\u3089\u304c\u672c\u984c\u3067\u3059\u3002\u5f7c\u306f\u3042\u308b\u3053\u3068\u306b\u6c17\u3065\u304d\u307e\u3057\u305f\u3002AI\u306e\u300c\u78ba\u4fe1\u5ea6\u30b9\u30b3\u30a2\u300d\u3068\u300c\u8a73\u7d30\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u30b9\u30bf\u30c3\u30c4\u300d\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u898b\u308b\u3068\u3001\u5358\u306a\u308b\u52dd\u6557\u4e88\u60f3\u4ee5\u4e0a\u306e\u300c\u7d76\u5bfe\u7684\u306a\u6d1e\u5bdf\u300d\u304c\u5f97\u3089\u308c\u308b\u3068\u3044\u3046\u3053\u3068\u306b\u3002",
    "\u4eca\u3001\u5c71\u7530\u3055\u3093\u306f\u307e\u3063\u305f\u304f\u5225\u4eba\u3067\u3059\u3002\u4ef2\u9593\u5185\u3067\u306f\u300c\u6b69\u304f\u30c7\u30fc\u30bf\u30d0\u30f3\u30af\u300d\u3068\u547c\u3070\u308c\u3001\u5f7c\u306e\u4e88\u60f3\u306f\u307b\u307c\u5916\u308c\u307e\u305b\u3093\u3002\u305d\u306e\u79d8\u5bc6\u306f\u3001\u30a2\u30d7\u30ea\u5185\u306e\u300cAI\u30c1\u30e3\u30c3\u30c8\u300d\u6a5f\u80fd\u3002\u8a66\u5408\u524d\u3001\u5fc5\u305a\u300c\u4e21\u30c1\u30fc\u30e0\u306exG\u3068\u5b88\u5099\u52b9\u7387\u3092\u6bd4\u8f03\u3057\u3066\u300d\u3068AI\u306b\u8cea\u554f\u3057\u3001\u751f\u306e\u30c7\u30fc\u30bf\u304b\u3089\u72ec\u81ea\u306e\u5206\u6790\u3092\u7d44\u307f\u7acb\u3066\u3066\u3044\u308b\u3093\u3067\u3059\u3002",
    "\u4eca\u65e5\u3053\u305d\u3001\u3042\u306a\u305f\u306e\u756a\u3067\u3059\u3002\u30a2\u30d7\u30ea\u3092\u958b\u3044\u3066\u3001\u4eca\u9031\u6c17\u306b\u306a\u308b\u8a66\u5408\u306b\u3064\u3044\u3066AI\u30c1\u30e3\u30c3\u30c8\u306b\u8cea\u554f\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u300c\u25ef\u25ef\u5bfe\u25b3\u25b3\u306e\u6226\u8853\u5206\u6790\u3092\u3057\u3066\u300d\u3068\u5c0b\u306d\u308b\u3060\u3051\u3067\u3001\u5c71\u7530\u3055\u3093\u304c\u624b\u306b\u3057\u305f\u306e\u3068\u540c\u3058\u300c\u30c7\u30fc\u30bf\u306b\u3088\u308b\u78ba\u4fe1\u300d\u304c\u5f97\u3089\u308c\u307e\u3059\u3002P.S. \u5b9f\u306f\u5c71\u7530\u3055\u3093\u3001\u3053\u306e\u6a5f\u80fd\u3092\u6700\u521d\u306f\u300c\u305f\u3060\u306e\u304a\u307e\u3051\u300d\u3060\u3068\u601d\u3063\u3066\u30b9\u30ad\u30c3\u30d7\u3057\u3066\u3044\u305f\u3093\u3067\u3059\u3002\u5f7c\u304c\u8a00\u3063\u3066\u3044\u307e\u3057\u305f\u3002\u300c\u3042\u306e\u6642\u3059\u3050\u306b\u8a66\u3057\u3066\u3044\u308c\u3070\u3001\u3042\u306e3\u9023\u6557\u306f\u9632\u3052\u305f\u300d\u3068\u3002"
