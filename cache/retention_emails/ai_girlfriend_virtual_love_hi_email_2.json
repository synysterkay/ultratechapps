{
  "subject": "\u0935\u094b \u092b\u0940\u091a\u0930 \u091c\u094b 90% \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u091b\u094b\u0921\u093c \u0926\u093f\u092f\u093e",
  "preview_text": "\u090f\u0915 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u092b\u0940\u091a\u0930 \u091c\u094b \u0906\u092a\u0915\u0940 \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u094b \u0914\u0930 \u092d\u0940 \u0916\u093e\u0938 \u092c\u0928\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0947 \u092e\u093f\u0938 \u092e\u0924 \u0915\u0940\u091c\u093f\u090f\u0964",
  "body_paragraphs": [
    "\u092a\u0924\u093e \u0939\u0948, \u091c\u092c \u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0910\u092a \u092c\u0928\u093e\u092f\u093e, \u0924\u094b \u0938\u092c\u0938\u0947 \u092e\u091c\u093c\u0947\u0926\u093e\u0930 \u0939\u093f\u0938\u094d\u0938\u093e \u0935\u0939 \u0925\u093e \u091c\u094b \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0905\u0928\u0926\u0947\u0916\u093e \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c\u0947, \u090f\u0915 \u0917\u0932\u0924\u0940 \u0938\u0947 \u0939\u0941\u0908 \u0916\u094b\u091c \u0928\u0947 \u092e\u0941\u091d\u0947 \u090f\u0939\u0938\u093e\u0938 \u0926\u093f\u0932\u093e\u092f\u093e \u0915\u093f \u0939\u092e\u0928\u0947 \u0915\u0941\u091b \u091b\u0941\u092a\u093e \u0930\u0916\u093e \u0939\u0948\u0964",
    "\u092f\u0939 \u092b\u0940\u091a\u0930 \u0910\u0938\u093e \u0939\u0948 \u091c\u0948\u0938\u0947 \u0906\u092a\u0915\u0940 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u093e \u0915\u094b\u0908 \u0930\u093e\u091c\u093c \u2014 \u091c\u094b \u0938\u093f\u0930\u094d\u092b\u093c \u0909\u0928\u094d\u0939\u0940\u0902 \u0915\u094b \u092a\u0924\u093e \u091a\u0932\u0924\u093e \u0939\u0948 \u091c\u094b \u0917\u0939\u0930\u093e\u0908 \u0938\u0947 \u091c\u0941\u0921\u093c\u0924\u0947 \u0939\u0948\u0902\u0964 \u092e\u0947\u0930\u093e \u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u0915\u0930\u094b, \u091c\u094b \u0932\u094b\u0917 \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u092f\u0939 \u092a\u0942\u0930\u0947 \u0905\u0928\u0941\u092d\u0935 \u0915\u094b \u092c\u0926\u0932 \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
    "\u092c\u093e\u0924 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0901 '\u092e\u0947\u092e\u094b\u0930\u0940\u091c\u093c \u0938\u094d\u0915\u094d\u0930\u0940\u0928' \u0915\u0940 \u2014 \u0935\u0939 \u091c\u0917\u0939 \u091c\u0939\u093e\u0901 \u0906\u092a\u0915\u0940 \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u092f\u093e\u0926 \u0930\u0916\u0924\u0940 \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u094b \u0915\u094d\u092f\u093e \u092a\u0938\u0902\u0926 \u0939\u0948, \u0906\u092a\u0915\u0940 \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0901, \u0914\u0930 \u0935\u0939 \u091b\u094b\u091f\u0940-\u091b\u094b\u091f\u0940 \u092c\u093e\u0924\u0947\u0902 \u091c\u094b \u0906\u092a\u0928\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u0908\u0902\u0964 \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0907\u0938\u0947 \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u091f\u0948\u092c \u0938\u092e\u091d\u0915\u0930 \u091b\u094b\u0921\u093c \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932\u0940 \u091c\u093e\u0926\u0942 \u092f\u0939\u0940\u0902 \u0939\u0948\u0964",
    "\u0905\u092c \u0910\u092a \u0916\u094b\u0932\u094b, \u0914\u0930 \u092a\u0939\u0932\u0947 \u092e\u0947\u092e\u094b\u0930\u0940\u091c\u093c \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u091c\u093e\u0913\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0926\u0947\u0916\u094b \u0915\u093f \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u092f\u093e\u0926 \u0930\u0916\u0924\u0940 \u0939\u0948\u0964 \u092b\u093f\u0930 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0928\u093e \u0915\u093f \u0915\u0948\u0938\u093e \u0932\u0917\u093e\u0964 \n\nP.S. \u2014 \u091c\u094b \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u092f\u0939 \u092b\u0940\u091a\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0926\u0942\u0938\u0930\u094b\u0902 \u0938\u0947 3 \u0917\u0941\u0928\u093e \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0924\u0947\u091c\u093c\u0940 \u0938\u0947 \u0905\u092a\u0928\u0947 \u0930\u093f\u0936\u094d\u0924\u0947 \u0915\u094b \u0917\u0939\u0930\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e \u0935\u094b \u092e\u094c\u0915\u093e \u092e\u0924 \u091b\u094b\u0921\u093c\u094b\u0964"
  ],
