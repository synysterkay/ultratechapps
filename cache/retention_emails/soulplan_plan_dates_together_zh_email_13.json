{
  "subject": "\u4f60\u5728\u8fd9\u4e2a\u6708\u5df2\u7ecf\u5fd8\u8bb0\u768416\u4e2a\u591c\u665a",
  "preview_text": "\u800c\u4f60\u7684\u4f34\u4fa3\u8bb0\u5f97\u6bcf\u4e00\u4e2a\u3002\u6253\u5f00\u5e94\u7528\uff0c\u770b\u770b\u4f60\u4eec\u5171\u540c\u521b\u9020\u7684\u56de\u5fc6\u5427\u3002",
  "body_paragraphs": [
    "\u8fd8\u8bb0\u5f97\u4e00\u4e2a\u6708\u524d\uff0c\u4f60\u4eec\u7b2c\u4e00\u6b21\u70b9\u5f00\u90a3\u4e2a\u2018\u4eca\u665a\u7ea6\u4f1a\u2019\u7684\u5361\u7247\u5417\uff1f\u73b0\u5728\uff0c\u6211\u60f3\u544a\u8bc9\u4f60\u4e00\u4e2a\u6570\u5b57\uff1a16\u3002\u8fd9\u662f\u4f60\u5728\u8fc7\u53bb28\u5929\u91cc\uff0c\u901a\u8fc7SoulPlan\u7b56\u5212\u7684\u7ea6\u4f1a\u6b21\u6570\u2014\u2014\u5e73\u5747\u6bcf1.7\u5929\u4e00\u6b21\u3002\u4e0d\u662f\u56e0\u4e3a\u4f60\u591a\u62fc\u547d\uff0c\u800c\u662f\u56e0\u4e3a\u6bcf\u6b21\u53ea\u82b130\u79d2\u3002",
    "\u90a3\u4e9b\u591c\u665a\uff0c\u6709\u7684\u6e29\u99a8\uff0c\u6709\u7684\u5192\u9669\uff0c\u6709\u7684\u6cbb\u6108\u3002\u4f60\u7684\u4f34\u4fa3\u53ef\u80fd\u5728\u67d0\u4e2a\u6df1\u591c\uff0c\u770b\u5230\u4f60\u53d1\u6765\u7684\u2018\u60f3\u4f60\u4eca\u665a\u2019\u7684\u9080\u8bf7\uff0c\u5fc3\u91cc\u6084\u6084\u7b11\u4e86\u3002\u800c\u6211\u4eec\uff0c\u628a\u8fd9\u4e00\u5207\u90fd\u9501\u5728\u4e86\u4f60\u4eec\u7684\u8bb0\u5fc6\u65f6\u95f4\u7ebf\u91cc\u2014\u2014\u6bcf\u4e00\u5f20\u7167\u7247\uff0c\u6bcf\u4e00\u53e5\u7b14\u8bb0\uff0c\u90fd\u5728\u90a3\u91cc\uff0c\u4e00\u5929\u6bd4\u4e00\u5929\u539a\u3002",
    "\u4f46\u6700\u8ba9\u6211\u89e6\u52a8\u7684\u662f\uff0c\u4f60\u7684\u2018\u706b\u82b1\u8fde\u7eed\u6570\u2019\u5df2\u7ecf\u8d85\u8fc7\u4e863\u5468\u3002\u8fd9\u610f\u5473\u7740\u4f60\u4eec\u6ca1\u6709\u8ba9\u4e60\u60ef\u6740\u6b7b\u6d6a\u6f2b\u3002\u800c\u4e14\u4f60\u4eec\u77e5\u9053\u5417\uff1f\u90a3\u4e9b\u4f7f\u7528\u2018\u4eca\u665a\u7ea6\u4f1a\u2019\u529f\u80fd\u7684\u592b\u59bb\uff0c\u5728\u7b2c\u4e00\u4e2a\u6708\u91cc\u7b56\u5212\u7684\u7ea6\u4f1a\u6b21\u6570\uff0c\u662f\u90a3\u4e9b\u4e0d\u7528\u7684\u4eba\u7684\u56db\u500d\u3002\u4f60\u4eec\u5df2\u7ecf\u8d85\u8d8a\u4e86\u5927\u591a\u6570\u4eba\u3002",
    "\u73b0\u5728\uff0c\u6253\u5f00\u5e94\u7528\uff0c\u770b\u4e00\u773c\u4f60\u4eec\u7684\u8bb0\u5fc6\u65f6\u95f4\u7ebf\u3002\u6ed1\u5230\u6700\u540e\uff0c\u4f60\u4f1a\u53d1\u73b0\u4e00\u4e2a\u60ca\u559c\uff1a\u7cfb\u7edf\u6b63\u5728\u4e3a\u4f60\u4eec\u51c6\u5907\u4e00\u4e2a\u7279\u522b\u7684\u65e5\u5b50\u2014\u2014\u56e0\u4e3a\u4f60\u4eec\u5df2\u7ecf\u89e3\u9501\u4e86\u2018\u7eaa\u5ff5\u65e5\u7f50\u2019\u7684\u4e3b\u52a8\u63d0\u9192\u3002\u522b\u9519\u8fc7\u3002P.S. \u5982\u679c\u4f60\u8fd8\u6ca1\u8bd5\u8fc7\u2018\u4f34\u4fa3\u5fc3\u613f\u5355\u2019\uff0c\u4eca\u665a\u7684\u7ea6\u4f1a\u53ef\u80fd\u5c31\u5728\u90a3\u91cc\u7b49\u7740\u4f60\u3002"
  ],
