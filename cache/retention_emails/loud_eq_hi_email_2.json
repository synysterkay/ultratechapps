{
  "subject": "\u0935\u0939 \u092b\u0940\u091a\u0930 \u091c\u094b 90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e",
  "preview_text": "\u091c\u092c \u0906\u092a\u0928\u0947 \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e, \u0924\u094b \u090f\u0915 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u092b\u0940\u091a\u0930 \u0925\u093e\u0964 \u0905\u092c \u092c\u0924\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",
  "body_paragraphs": [
    "\u0939\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0939\u0948 \u0915\u093f \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 Loud EQ \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0938\u093f\u0930\u094d\u092b\u093c \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b \u0938\u092c\u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0915\u093e\u092e \u0915\u093e \u0939\u0948, \u0914\u0930 90% \u0932\u094b\u0917 \u0907\u0938\u0947 \u091b\u094b\u0921\u093c \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u094d\u092f\u093e \u0906\u092a\u0928\u0947 '\u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c' \u092c\u091f\u0928 \u0926\u0947\u0916\u093e \u0939\u0948? \u0935\u0939 \u091b\u094b\u091f\u093e \u0938\u093e \u092c\u091f\u0928 \u091c\u094b \u0906\u092a\u0915\u0947 \u0908\u092f\u0930\u092b\u093c\u094b\u0928 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0938\u093e\u0909\u0902\u0921 \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "\u092f\u0939 \u092b\u0940\u091a\u0930 \u0906\u092a\u0915\u0940 \u092e\u0947\u0939\u0928\u0924 \u092c\u091a\u093e\u0924\u093e \u0939\u0948\u0964 \u091c\u092c \u0906\u092a \u092e\u0947\u091f\u094d\u0930\u094b \u092e\u0947\u0902 \u0939\u094b\u0902 \u092f\u093e \u0917\u093e\u0921\u093c\u0940 \u091a\u0932\u093e \u0930\u0939\u0947 \u0939\u094b\u0902, \u0924\u094b \u0939\u0930 \u0936\u094b\u0930 \u0915\u0947 \u092c\u0940\u091a \u0921\u093e\u092f\u0932\u0949\u0917 \u0938\u093e\u092b\u093c \u0938\u0941\u0928\u0928\u093e \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 '\u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c' \u090f\u0915 \u091f\u0948\u092a \u092e\u0947\u0902 \u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u094b \u092a\u0939\u091a\u093e\u0928\u0924\u093e \u0939\u0948 \u0914\u0930 \u0938\u093e\u0909\u0902\u0921 \u0915\u094b \u0920\u0940\u0915 \u0915\u0930\u0924\u093e \u0939\u0948\u2014\u0924\u0947\u091c\u093c \u092d\u0940, \u0938\u093e\u092b\u093c \u092d\u0940\u0964 \u0915\u094b\u0908 \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0939\u0930\u094d\u0936\u0928\u0947\u0938 \u0928\u0939\u0940\u0902\u0964",
    "\u0939\u092e\u0928\u0947 \u0907\u0938\u0947 \u0907\u0938\u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e \u0924\u093e\u0915\u093f \u0906\u092a\u0915\u094b \u0939\u0930 \u092c\u093e\u0930 EQ \u0938\u0947\u091f \u0928 \u0915\u0930\u0928\u093e \u092a\u0921\u093c\u0947\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c \u0915\u0930\u0947\u0902, \u0914\u0930 \u092b\u093f\u0930 \u091c\u092c \u092d\u0940 \u0906\u092a \u0905\u092a\u0928\u0947 AirPods \u092f\u093e \u0935\u093e\u092f\u0930\u094d\u0921 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902\u0917\u0947, \u0910\u092a \u0905\u092a\u0928\u0947 \u0906\u092a \u0909\u0938\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u092a\u0930 \u0906 \u091c\u093e\u090f\u0917\u093e\u0964 \u092f\u0939 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u092b\u0940\u091a\u0930 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0938\u092c\u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u092a\u0938\u0902\u0926 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c' \u092c\u091f\u0928 \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0906\u091c\u093c\u092e\u093e\u0907\u090f, \u092b\u093f\u0930 \u0926\u0947\u0916\u093f\u090f \u0915\u093f\u0924\u0928\u093e \u092b\u093c\u0930\u094d\u0915 \u092a\u0921\u093c\u0924\u093e \u0939\u0948\u0964 P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f '\u0938\u093e\u0909\u0902\u0921 DNA' \u092b\u0940\u091a\u0930 \u0914\u0930 \u092d\u0940 \u0917\u0939\u0930\u093e \u0915\u0938\u094d\u091f\u092e\u093e\u0907\u091c\u093c\u0947\u0936\u0928 \u0926\u0947\u0924\u093e \u0939\u0948\u2014\u0905\u0917\u0930 \u0906\u092a\u0915\u094b \u092f\u0939 \u092a\u0938\u0902\u0926 \u0906\u092f\u093e, \u0924\u094b \u0935\u0939 \u0905\u0917\u0932\u093e \u0932\u0947\u0935\u0932 \u0939\u0948\u0964"
  ],
  "cta_text": "\u0905\u092c \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c' \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902",
