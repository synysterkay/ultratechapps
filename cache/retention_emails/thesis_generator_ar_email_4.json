{
  "subject": "500 \u0637\u0627\u0644\u0628 \u0628\u062f\u0623\u0648\u0627 \u0623\u0645\u0633 - \u0648\u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0635\u062f\u0645\u062a \u0627\u0644\u062c\u0645\u064a\u0639",
  "preview_text": "\u0647\u0630\u0627 \u0645\u0627 \u062d\u062f\u062b \u0639\u0646\u062f\u0645\u0627 \u0627\u0633\u062a\u062e\u062f\u0645 500 \u0637\u0627\u0644\u0628 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u064a \u0644\u064a\u0644\u0629 \u0648\u0627\u062d\u062f\u0629. \u0647\u0644 \u062a\u0639\u0644\u0645 \u0623\u0646 80% \u0645\u0646\u0647\u0645 \u0623\u0646\u0647\u0648\u0627 \u0623\u0637\u0631\u0648\u062d\u0627\u062a\u0647\u0645 \u0642\u0628\u0644 \u0627\u0644\u0645\u0648\u0639\u062f\u061f",
  "body_paragraphs": [
    "\u0623\u0645\u0633\u060c \u0641\u064a \u0627\u0644\u0633\u0627\u0639\u0629 2 \u0635\u0628\u0627\u062d\u064b\u0627\u060c \u0634\u0647\u062f\u0646\u0627 \u0634\u064a\u0626\u064b\u0627 \u063a\u064a\u0631 \u0645\u062a\u0648\u0642\u0639. \u0623\u0643\u062b\u0631 \u0645\u0646 500 \u0637\u0627\u0644\u0628 \u0641\u062a\u062d\u0648\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u064a \u0646\u0641\u0633 \u0627\u0644\u0648\u0642\u062a\u060c \u0643\u0644\u0647\u0645 \u064a\u0643\u0627\u0641\u062d\u0648\u0646 \u0645\u0639 \u0627\u0644\u0645\u0648\u0639\u062f \u0627\u0644\u0646\u0647\u0627\u0626\u064a. \u0648\u0628\u0639\u062f 30 \u062f\u0642\u064a\u0642\u0629 \u0641\u0642\u0637\u060c \u0628\u062f\u0623\u062a \u062a\u0638\u0647\u0631 \u0627\u0644\u0646\u062a\u0627\u0626\u062c - \u0623\u0637\u0631\u0648\u062d\u0627\u062a \u0643\u0627\u0645\u0644\u0629\u060c \u0645\u062e\u0637\u0637\u0627\u062a \u0627\u062d\u062a\u0631\u0627\u0641\u064a\u0629\u060c \u0648\u0627\u0633\u062a\u0634\u0647\u0627\u062f\u0627\u062a \u062c\u0627\u0647\u0632\u0629.",
    "\u062a\u062e\u064a\u0644 \u0647\u0630\u0627: \u0623\u0646\u062a \u062a\u062c\u0644\u0633 \u0623\u0645\u0627\u0645 \u0627\u0644\u0634\u0627\u0634\u0629\u060c \u0648\u0627\u0644\u0648\u0642\u062a \u064a\u0645\u0631\u060c \u0648\u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0644\u0627 \u062a\u0623\u062a\u064a. \u0644\u0643\u0646 \u0647\u0624\u0644\u0627\u0621 \u0627\u0644\u0637\u0644\u0627\u0628 \u0644\u0645 \u064a\u0633\u062a\u0633\u0644\u0645\u0648\u0627. \u0627\u0633\u062a\u062e\u062f\u0645\u0648\u0627 \u0645\u064a\u0632\u0629 \u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0623\u0637\u0631\u0648\u062d\u0627\u062a \u062e\u0644\u0627\u0644 10 \u062f\u0642\u0627\u0626\u0642 \u0628\u062f\u0644\u0627\u064b \u0645\u0646 8 \u0633\u0627\u0639\u0627\u062a\u060c \u062b\u0645 \u0623\u0636\u0627\u0641\u0648\u0627 \u0627\u0644\u0631\u0633\u0648\u0645 \u0627\u0644\u0628\u064a\u0627\u0646\u064a\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u062f\u0648\u0646 \u0639\u0646\u0627\u0621.",
    "\u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0645\u0646 \u064a\u0646\u062a\u0638\u0631 \u0648\u0645\u0646 \u064a\u062a\u062d\u0631\u0643. \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0644\u0627 \u064a\u0643\u062a\u0628 \u0644\u0643 \u0641\u0642\u0637\u060c \u0628\u0644 \u064a\u0636\u0645\u0646 \u0623\u0646 \u0639\u0645\u0644\u0643 \u064a\u0628\u062f\u0648 \u0628\u0634\u0631\u064a\u064b\u0627 \u0648\u064a\u062a\u062c\u0646\u0628 \u0627\u0643\u062a\u0634\u0627\u0641 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a. \u0648\u0643\u0644 \u0647\u0630\u0627 \u0645\u0639 \u062a\u0646\u0633\u064a\u0642 APA \u0623\u0648 MLA \u0623\u0648 Chicago \u0628\u0646\u0642\u0631\u0629 \u0648\u0627\u062d\u062f\u0629.",
    "\u0644\u0627 \u062a\u062a\u0631\u0643 \u0623\u0637\u0631\u0648\u062d\u062a\u0643 \u0644\u0644\u0635\u062f\u0641\u0629. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0648\u0627\u0633\u062a\u062e\u062f\u0645 \u0645\u064a\u0632\u0629 '\u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0623\u0637\u0631\u0648\u062d\u0629' - \u0633\u062a\u0631\u0649 \u0643\u064a\u0641 \u064a\u062a\u062d\u0648\u0644 \u0627\u0644\u0642\u0644\u0642 \u0625\u0644\u0649 \u062b\u0642\u0629 \u0641\u064a \u062f\u0642\u0627\u0626\u0642. \u0645\u0644\u0627\u062d\u0638\u0629: \u0627\u0644\u0637\u0644\u0627\u0628 \u0627\u0644\u0630\u064a\u0646 \u0627\u0633\u062a\u062e\u062f\u0645\u0648\u0647\u0627 \u0623\u0645\u0633 \u062d\u0635\u0644\u0648\u0627 \u0639\u0644\u0649 \u0645\u062a\u0648\u0633\u0637 \u062f\u0631\u062c\u0627\u062a A- \u0628\u062f\u0644\u0627\u064b \u0645\u0646 B+."
