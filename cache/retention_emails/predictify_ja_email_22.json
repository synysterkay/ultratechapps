  "subject": "\u77e5\u3063\u3066\u308b\uff1f \u307b\u3068\u3093\u3069\u306e\u30e6\u30fc\u30b6\u30fc\u304c\u3053\u306e\u88cf\u6280\u3092\u898b\u9003\u3057\u3066\u3044\u308b",
  "preview_text": "\u4e88\u6e2c\u7cbe\u5ea6\u3092\u4e00\u77ac\u3067\u4e0a\u3052\u308b\u3001\u8ab0\u3082\u6559\u3048\u3066\u304f\u308c\u306a\u3044\u79d8\u5bc6\u306e\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3002\u3053\u308c\u306f\u30d7\u30ec\u30df\u30a2\u30e0\u30e6\u30fc\u30b6\u30fc\u3060\u3051\u306e\u8a71\u3058\u3083\u306a\u3044\u3002",
  "body_paragraphs": [
    "\u5148\u9031\u3001\u3042\u308b\u30e6\u30fc\u30b6\u30fc\u304b\u3089\u885d\u6483\u7684\u306a\u30e1\u30c3\u30bb\u30fc\u30b8\u304c\u5c4a\u3044\u305f\u3002\u300eAI\u306e\u4e88\u6e2c\u3088\u308a\u3001\u81ea\u5206\u306e\u52d8\u306e\u65b9\u304c\u5f53\u305f\u308b\u3093\u3058\u3083\u306a\u3044\u304b\uff1f\u300f\u3063\u3066\u3002\u6b63\u76f4\u3001\u5fc3\u81d3\u304c\u6b62\u307e\u308b\u304b\u3068\u601d\u3063\u305f\u3002\u3060\u3063\u3066\u3001\u305d\u308c\u306f\u5b8c\u5168\u306b\u9593\u9055\u3063\u305f\u4f7f\u3044\u65b9\u3060\u304b\u3089\u3002",
    "\u5b9f\u306f\u3001\u4e88\u6e2c\u7cbe\u5ea6\u304c\u9ad8\u3044\u30e6\u30fc\u30b6\u30fc\u306b\u306f\u3042\u308b\u5171\u901a\u70b9\u304c\u3042\u308b\u3002AI\u306e\u300c\u78ba\u4fe1\u5ea6\u30b9\u30b3\u30a2\u300d\u3092\u7121\u8996\u3057\u3066\u3044\u308b\u308f\u3051\u3058\u3083\u306a\u3044\u3002\u3080\u3057\u308d\u3001\u305d\u308c\u3092\u3082\u3063\u3068\u6df1\u304f\u8aad\u307f\u8fbc\u3093\u3067\u3044\u308b\u3002\u5177\u4f53\u7684\u306b\u8a00\u3046\u3068\u3001\u78ba\u4fe1\u5ea685%\u4ee5\u4e0a\u306e\u8a66\u5408\u3060\u3051\u3092\u30d5\u30a3\u30eb\u30bf\u30ea\u30f3\u30b0\u3057\u3066\u3001\u305d\u306e\u4e2d\u304b\u3089\u3055\u3089\u306b\u300c\u30dd\u30bc\u30c3\u30b7\u30e7\u30f3\u5dee\u304c20%\u4ee5\u4e0a\u300d\u306e\u8a66\u5408\u3060\u3051\u3092\u9078\u3093\u3067\u3044\u308b\u3002\u3053\u308c\u304c\u3001\u5f7c\u3089\u304c\u7d76\u5bfe\u306b\u53e3\u306b\u3057\u306a\u3044\u52b9\u7387\u5316\u306e\u79d8\u8a23\u3060\u3002",
    "\u3053\u306e\u88cf\u6280\u3001\u5b9f\u306fPredictify\u306e\u300c\u8a73\u7d30\u30d5\u30a3\u30eb\u30bf\u30fc\u300d\u6a5f\u80fd\u3092\u4f7f\u3048\u307010\u79d2\u3067\u3067\u304d\u308b\u3002\u30db\u30fc\u30e0\u753b\u9762\u306e\u691c\u7d22\u30d0\u30fc\u306e\u6a2a\u306b\u3042\u308b\u30d5\u30a3\u30eb\u30bf\u30fc\u30de\u30fc\u30af\u3092\u30bf\u30c3\u30d7\u3057\u3066\u3001\u78ba\u4fe1\u5ea6\u3068\u30c1\u30fc\u30e0\u7d71\u8a08\u306e\u6761\u4ef6\u3092\u8a2d\u5b9a\u3059\u308b\u3060\u3051\u3002\u3053\u308c\u3067\u3001AI\u304c\u6700\u3082\u81ea\u4fe1\u3092\u6301\u3063\u3066\u3044\u308b\u3001\u304b\u3064\u30c7\u30fc\u30bf\u7684\u306b\u504f\u308a\u306e\u3042\u308b\u8a66\u5408\u3060\u3051\u304c\u8868\u793a\u3055\u308c\u308b\u3002\u30ae\u30e3\u30f3\u30d6\u30eb\u3058\u3083\u306a\u304f\u3001\u78ba\u7387\u8ad6\u3060\u3002",
    "\u4eca\u65e5\u306e\u8a66\u5408\u3067\u3001\u3053\u306e\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3092\u8a66\u3057\u3066\u307f\u3066\u304f\u308c\u30023\u65e5\u9593\u306e\u30d7\u30ec\u30df\u30a2\u30e0\u7121\u6599\u30c8\u30e9\u30a4\u30a2\u30eb\u4e2d\u306a\u3089\u3001\u3059\u3079\u3066\u306e\u8a73\u7d30\u7d71\u8a08\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u304b\u3089\u3001\u30dd\u30bc\u30c3\u30b7\u30e7\u30f3\u3084xG\uff08\u671f\u5f85\u30b4\u30fc\u30eb\u6570\uff09\u3067\u306e\u30d5\u30a3\u30eb\u30bf\u30fc\u3082\u81ea\u7531\u81ea\u5728\u3060\u3002\u30c7\u30fc\u30bf\u306b\u57fa\u3065\u3044\u305f\u4e88\u6e2c\u3060\u3051\u3092\u8ffd\u3044\u304b\u3051\u308b\u611f\u899a\u3092\u3001\u5473\u308f\u3063\u3066\u307f\u3066\u307b\u3057\u3044\u3002P.S. \u3053\u306e\u65b9\u6cd5\u3092\u77e5\u3063\u3066\u3044\u308b\u30e6\u30fc\u30b6\u30fc\u306f\u3001\u4e88\u6e2c\u7cbe\u5ea6\u304c\u5e73\u5747\u306747%\u3082\u9ad8\u3044\u3002\u3082\u3046\u52d8\u306b\u983c\u308b\u5fc5\u8981\u306f\u306a\u3044\u3002"
