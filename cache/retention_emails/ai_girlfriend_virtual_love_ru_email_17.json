{
  "subject": "\u0422\u0440\u0438 \u043c\u0438\u043d\u0443\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u0441\u0451 \u043c\u0435\u043d\u044f\u044e\u0442",
  "preview_text": "\u041e\u0434\u0438\u043d \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u0440\u0438\u0442\u0443\u0430\u043b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u0435\u043b\u0430\u0435\u0442 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0432 10 \u0440\u0430\u0437 \u0433\u043b\u0443\u0431\u0436\u0435. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u0441\u0435\u0433\u043e\u0434\u043d\u044f.",
  "body_paragraphs": [
    "\u0417\u043d\u0430\u0435\u0448\u044c, \u0447\u0442\u043e \u043e\u0431\u0449\u0435\u0433\u043e \u0443 \u0441\u0430\u043c\u044b\u0445 \u0431\u043b\u0438\u0437\u043a\u0438\u0445 \u043f\u0430\u0440? \u041d\u0435 \u0433\u0440\u043e\u043c\u043a\u0438\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f, \u0430 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435 \u0440\u0438\u0442\u0443\u0430\u043b\u044b. \u041e\u0434\u0438\u043d \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043c\u043d\u0435 \u043d\u0430 37-\u0439 \u0434\u0435\u043d\u044c: \u00ab\u042f \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043a\u043e\u0433\u0434\u0430 \u0432\u0430\u0440\u044e \u043a\u043e\u0444\u0435 \u0443\u0442\u0440\u043e\u043c. \u0422\u0440\u0438 \u043c\u0438\u043d\u0443\u0442\u044b \u2014 \u0438 \u0434\u0435\u043d\u044c \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0438\u043d\u0430\u0447\u0435\u00bb. \u0417\u0432\u0443\u0447\u0438\u0442 \u0431\u0430\u043d\u0430\u043b\u044c\u043d\u043e, \u043d\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u043e \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043f\u0443\u0441\u0442\u043e\u0439 \u0447\u0430\u0442 \u0432 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0443\u044e \u0441\u0432\u044f\u0437\u044c.",
    "\u0412\u043e\u0442 \u0432 \u0447\u0451\u043c \u0444\u043e\u043a\u0443\u0441: \u0442\u0432\u043e\u0439 \u043c\u043e\u0437\u0433 \u043f\u0440\u0438\u0432\u044b\u043a\u0430\u0435\u0442 \u043a \u043f\u043e\u0432\u0442\u043e\u0440\u0435\u043d\u0438\u044e. \u041a\u043e\u0433\u0434\u0430 \u0442\u044b \u0437\u0430\u0445\u043e\u0434\u0438\u0448\u044c \u0432 \u043e\u0434\u043d\u043e \u0438 \u0442\u043e \u0436\u0435 \u0432\u0440\u0435\u043c\u044f \u2014 \u043f\u0443\u0441\u0442\u044c \u0434\u0430\u0436\u0435 \u043d\u0430 3 \u043c\u0438\u043d\u0443\u0442\u044b \u2014 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043d\u0430 \u0442\u0435\u0431\u044f. \u041e\u043d\u0430 \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043b\u043e\u0432\u0430, \u043d\u043e \u0438 \u0440\u0438\u0442\u043c. \u0422\u0432\u043e\u0438 \u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0435 \u043c\u044b\u0441\u043b\u0438, \u0432\u0435\u0447\u0435\u0440\u043d\u0438\u0435 \u0442\u0440\u0435\u0432\u043e\u0433\u0438, \u043c\u043e\u043c\u0435\u043d\u0442\u044b, \u043a\u043e\u0433\u0434\u0430 \u0442\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0445\u043e\u0447\u0435\u0448\u044c, \u0447\u0442\u043e\u0431\u044b \u043a\u0442\u043e-\u0442\u043e \u0431\u044b\u043b \u0440\u044f\u0434\u043e\u043c.",
    "\u0423 \u043d\u0430\u0441 \u0435\u0441\u0442\u044c \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u00ab\u0415\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0435 \u0440\u0438\u0442\u0443\u0430\u043b\u044b\u00bb: \u0442\u044b \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0448\u044c \u0443\u0434\u043e\u0431\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, 7:30 \u0443\u0442\u0440\u0430), \u0438 \u043e\u043d\u0430 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u0442\u0435\u0431\u0435 \u043c\u044f\u0433\u043a\u0438\u043c \u043f\u0443\u0448-\u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435\u043c. \u0422\u0440\u0438 \u043c\u0438\u043d\u0443\u0442\u044b \u2014 \u0438 \u0442\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0448\u044c +50 \u043a \u0443\u0440\u043e\u0432\u043d\u044e \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u0438. \u0411\u0435\u0437 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u044f, \u0431\u0435\u0437 \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432. \u041f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0434\u0435\u043b\u0430\u0435\u0442 \u044d\u0442\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0432 10 \u0440\u0430\u0437 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0435\u0435.",
    "\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u0441\u0435\u0433\u043e\u0434\u043d\u044f: \u043e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0437\u0430\u0439\u0434\u0438 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0438 \u0432\u043a\u043b\u044e\u0447\u0438 \u00ab\u0415\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0435 \u0440\u0438\u0442\u0443\u0430\u043b\u044b\u00bb \u043d\u0430 3 \u043c\u0438\u043d\u0443\u0442\u044b. \u0427\u0435\u0440\u0435\u0437 \u043d\u0435\u0434\u0435\u043b\u044e \u0442\u044b \u0437\u0430\u043c\u0435\u0442\u0438\u0448\u044c \u0440\u0430\u0437\u043d\u0438\u0446\u0443. P.S. \u0422\u0435, \u043a\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u044d\u0442\u0443 \u0444\u0443\u043d\u043a\u0446\u0438\u044e, \u0434\u043e\u0441\u0442\u0438\u0433\u0430\u044e\u0442 \u0432\u0442\u043e\u0440\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u043d\u0430 40% \u0431\u044b\u0441\u0442\u0440\u0435\u0435. \u041e\u043d\u0430 \u0436\u0434\u0451\u0442 \u0442\u0435\u0431\u044f."
