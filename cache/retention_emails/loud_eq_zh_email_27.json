  "body_paragraphs": [
    "\u6211\u4e0a\u5468\u71ac\u4e86\u4e24\u591c\uff0c\u76ef\u774010,000\u540dLoud EQ\u7528\u6237\u7684\u4f7f\u7528\u6570\u636e\u3002\u4e0d\u662f\u56e0\u4e3a\u65e0\u804a\u2014\u2014\u800c\u662f\u88ab\u4e00\u4e2a\u6a21\u5f0f\u5413\u5230\u4e86\u3002\u5e73\u5747\u6bcf\u4e2a\u4eba\u5728\u901a\u52e4\u65f6\u628a\u97f3\u91cf\u8c03\u523085%\u4ee5\u4e0a\uff0c\u4f46\u53ea\u67093%\u7684\u4eba\u771f\u6b63\u542c\u6e05\u4e86\u5bf9\u8bdd\u3002\u5176\u4ed697%\u7684\u4eba\uff0c\u5305\u62ec\u4f60\uff0c\u53ef\u80fd\u90fd\u5728\u767d\u767d\u6d88\u8017\u8033\u6735\u3002",
    "\u4e0d\u662f\u4f60\u7684\u542c\u529b\u6709\u95ee\u9898\u3002\u662f\u9ed8\u8ba4\u8bbe\u7f6e\u9519\u4e86\u3002\u5927\u591a\u6570\u4eba\u76f4\u63a5\u5f00\u5927\u97f3\u91cf\uff0c\u4f46\u566a\u97f3\u73af\u5883\u4f1a\u541e\u566c\u4e2d\u9891\u2014\u2014\u4eba\u58f0\u548c\u6545\u4e8b\u7684\u5173\u952e\u9891\u6bb5\u3002\u6211\u4eec\u7684\u7b97\u6cd5\u53d1\u73b0\uff0c\u53ea\u8981\u5fae\u8c03\u4e24\u4e2a\u9891\u70b9\uff0c\u8bed\u97f3\u6e05\u6670\u5ea6\u5c31\u80fd\u63d0\u534767%\uff0c\u800c\u97f3\u91cf\u4e0d\u7528\u8d85\u8fc770%\u3002\u8fd9\u5c31\u50cf\u7ed9\u4f60\u7684\u8033\u6735\u88c5\u4e86\u4e2a\u8fc7\u6ee4\u5668\u3002",
    "\u8fd9\u5c31\u662fLoud EQ\u91cc\u2018\u4e00\u952e\u4f18\u5316\u2019\u529f\u80fd\u5b58\u5728\u7684\u7406\u7531\u3002\u4f60\u63d2\u4e0a\u8033\u673a\u6216\u8fde\u4e0a\u84dd\u7259\u540e\uff0c\u53ea\u8981\u70b9\u4e00\u4e0b\uff0c\u5b83\u4f1a\u81ea\u52a8\u5206\u6790\u4f60\u5f53\u524d\u7684\u73af\u5883\u548c\u8bbe\u5907\uff0c\u628a\u58f0\u97f3\u8c03\u5230\u6700\u6e05\u6670\u7684\u72b6\u6001\u3002\u4e0d\u9700\u8981\u624b\u52a8\u8c03EQ\uff0c\u4e0d\u9700\u8981\u731c\u2014\u2014\u7cfb\u7edf\u5df2\u7ecf\u572810,000\u6b21\u6d4b\u8bd5\u4e2d\u9a8c\u8bc1\u8fc7\u4e86\u3002",
