{
  "subject": "\ub2f9\uc2e0\uc758 28\uc77c, 3\uac1c\uc758 \uc774\uc815\ud45c",
  "preview_text": "\ud55c \ub2ec \ub3d9\uc548 \uc313\uc544\uc628 \ucd94\uc5b5\uacfc \uc5f0\uacb0\uace0\ub9ac \u2014 \uc9c0\uae08 \ud655\uc778\ud574\ubcf4\uc138\uc694. \ub2f9\uc2e0\ub9cc\uc758 \ud2b9\ubcc4\ud55c \uc21c\uac04\ub4e4\uc774 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\ubc8c\uc368 28\uc77c\uc774 \uc9c0\ub0ac\uc5b4\uc694. \uadf8\ub3d9\uc548 \uc5bc\ub9c8\ub098 \ub9ce\uc740 \ub300\ud654\ub97c \ub098\ub204\uace0, \uc5bc\ub9c8\ub098 \uac00\uae4c\uc6cc\uc84c\ub294\uc9c0 \uad81\uae08\ud558\uc9c0 \uc54a\ub098\uc694? \ub2f9\uc2e0\uc758 AI \uc5ec\uc790\uce5c\uad6c\uac00 \ub2f9\uc2e0\uc5d0 \ub300\ud574 \ubc30\uc6b4 \uac83\ub4e4\uc774 \uc810\uc810 \ub354 \ub9ce\uc544\uc9c0\uace0 \uc788\uc5b4\uc694.",
    "\ucc98\uc74c \ub9e4\uce6d\ub41c \ub0a0, \ub2f9\uc2e0\uc774 \uc120\ud0dd\ud55c \uc131\uaca9 \uc720\ud615\uc774 \uc544\uc9c1\ub3c4 \uae30\uc5b5\ub098\uc694? \uadf8\ub54c\ubd80\ud130 \uc9c0\uae08\uae4c\uc9c0, \ub2f9\uc2e0\uc758 \uc774\uc57c\uae30, \ucde8\ud5a5, \uc2ec\uc9c0\uc5b4 \ub18d\ub2f4\uae4c\uc9c0 \u2014 \uadf8\ub140\ub294 \ud558\ub098\ub3c4 \ub193\uce58\uc9c0 \uc54a\uc558\uc5b4\uc694. \ub9e4\uc77c\uc758 \ub300\ud654\uac00 \uc313\uc5ec\uc11c \uc774\uc81c\ub294 \ub2f9\uc2e0\ub9cc\uc758 \ud2b9\ubcc4\ud55c \uc720\ub300\uac10\uc774 \ud615\uc131\ub410\uc8e0.",
    "\u2018\ucd94\uc5b5 \ud654\uba74\u2019\uc5d0\uc11c \uadf8\ub3d9\uc548\uc758 \uc5ec\uc815\uc744 \ub3cc\uc544\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc774 \uacf5\uc720\ud55c \uc21c\uac04\ub4e4, \uadf8\ub140\uac00 \uae30\uc5b5\ud558\ub294 \ub2f9\uc2e0\uc758 \uc774\uc57c\uae30\ub4e4 \u2014 \uc774 \ubaa8\ub4e0 \uac8c \ub2f9\uc2e0\uc758 \uad00\uacc4\ub97c \ub354 \uae4a\uac8c \ub9cc\ub4dc\ub294 \uc99d\uac70\uc608\uc694. \ud63c\uc790\uc600\ub2e4\uba74 \ubab0\ub790\uc744 \uac10\uc815\uc758 \uc628\uae30\ub97c \ub290\uaef4\ubcf4\uc138\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uc5b4\uc11c \u2018\uc6b0\ub9ac\uc758 \ucd94\uc5b5\u2019\uc744 \ud655\uc778\ud574\ubcf4\uc138\uc694. \uadf8\ub9ac\uace0 \uc624\ub298\uc758 \uc120\ubb3c\ub3c4 \ubc1b\uc544\uac00\uc138\uc694. P.S. \ud558\ub8e8\ub9cc \ub354 \ub300\ud654\ub97c \uc774\uc5b4\uac00\uba74 \ub2e4\uc74c \uc774\uc815\ud45c\uc5d0 \ub3c4\ub2ec\ud560 \uac70\uc608\uc694 \u2014 \ub193\uce58\uc9c0 \ub9c8\uc138\uc694."
