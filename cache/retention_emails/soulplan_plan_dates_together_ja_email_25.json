  "subject": "\u3042\u308b\u30ab\u30c3\u30d7\u30eb\u306e\u79d8\u5bc6\u306e\u4f7f\u3044\u65b9\u306b\u885d\u6483",
  "preview_text": "\u5f7c\u3089\u304cSoulPlan\u3092\u4f7f\u3063\u3066\u308b\u65b9\u6cd5\u3001\u60f3\u50cf\u3082\u3064\u304b\u306a\u3044\u304b\u3082\u3002",
  "body_paragraphs": [
    "\u77e5\u3063\u3066\u308b\uff1f\u3042\u308b\u30ab\u30c3\u30d7\u30eb\u304c\u3001SoulPlan\u3092\u5168\u304f\u4e88\u60f3\u5916\u306e\u65b9\u6cd5\u3067\u4f7f\u3044\u59cb\u3081\u305f\u3093\u3060\u3002\u6700\u521d\u306f\u305f\u3060\u306e\u30c7\u30fc\u30c8\u8a08\u753b\u30a2\u30d7\u30ea\u3060\u3068\u601d\u3063\u3066\u305f\u306e\u306b\u3001\u5f7c\u3089\u306f\u3042\u308b\u6a5f\u80fd\u3092\u4f7f\u3063\u3066\u3001\u306a\u3093\u3068\u65e5\u5e38\u306e\u55a7\u5629\u3092\u6e1b\u3089\u3059\u30c4\u30fc\u30eb\u306b\u5909\u3048\u3066\u3057\u307e\u3063\u305f\u3002",
    "\u805e\u3044\u3066\u307f\u308b\u3068\u3001\u5f7c\u3089\u306f\u300c\u30b5\u30d7\u30e9\u30a4\u30ba\u30c7\u30fc\u30c8\u30d7\u30e9\u30f3\u30ca\u30fc\u300d\u3092\u4f7f\u3063\u3066\u3001\u304a\u4e92\u3044\u306b\u9031\u306b\u4e00\u5ea6\u3001\u5c0f\u3055\u306a\u30b5\u30d7\u30e9\u30a4\u30ba\u3092\u4ed5\u639b\u3051\u5408\u3063\u3066\u308b\u3063\u3066\u8a00\u3046\u3093\u3060\u3002\u666e\u901a\u306e\u30c7\u30fc\u30c8\u3058\u3083\u306a\u304f\u3066\u3001\u4f8b\u3048\u3070\u300c\u4eca\u65e5\u306f\u5bb6\u3067\u6620\u753b\u306e\u65e5\u300d\u3068\u304b\u300c\u4e00\u7dd2\u306b\u30b9\u30fc\u30d1\u30fc\u3067\u5909\u306a\u98df\u6750\u8cb7\u3063\u3066\u6599\u7406\u30c1\u30e3\u30ec\u30f3\u30b8\u300d\u3068\u304b\u306d\u3002\u305d\u308c\u304c\u304d\u3063\u304b\u3051\u3067\u3001\u4f1a\u8a71\u304c\u5897\u3048\u3066\u3001\u81ea\u7136\u3068\u611f\u8b1d\u306e\u6c17\u6301\u3061\u304c\u751f\u307e\u308c\u305f\u3089\u3057\u3044\u3002",
    "\u50d5\u3082\u6700\u521d\u306f\u4fe1\u3058\u3089\u308c\u306a\u304b\u3063\u305f\u3051\u3069\u3001\u5f7c\u3089\u306e\u8a71\u3092\u805e\u3044\u3066\u6c17\u3065\u3044\u305f\u3088\u3002\u3053\u306e\u30a2\u30d7\u30ea\u306e\u5171\u6709\u30a6\u30a3\u30c3\u30b7\u30e5\u30ea\u30b9\u30c8\u6a5f\u80fd\u3082\u4f7f\u3048\u3070\u3001\u672a\u6765\u306e\u5922\u3092\u8a9e\u308a\u5408\u3046\u304d\u3063\u304b\u3051\u306b\u306a\u308b\u3057\u3001\u30c7\u30fc\u30c8\u5c65\u6b74\u3092\u898b\u8fd4\u3059\u3060\u3051\u3067\u3001\u3069\u308c\u3060\u3051\u4e00\u7dd2\u306b\u697d\u3057\u3093\u3067\u304d\u305f\u304b\u5b9f\u611f\u3067\u304d\u308b\u3002\u3064\u307e\u308a\u3001\u30c7\u30fc\u30c8\u8a08\u753b\u4ee5\u4e0a\u306b\u3001\u95a2\u4fc2\u3092\u6df1\u3081\u308b\u30c4\u30fc\u30eb\u3068\u3057\u3066\u4f7f\u3048\u308b\u3093\u3060\u3002",
    "\u4eca\u65e5\u3001\u4e00\u5ea6\u3060\u3051\u8a66\u3057\u3066\u307f\u3066\u307b\u3057\u3044\u3002\u30a2\u30d7\u30ea\u3092\u958b\u3044\u3066\u3001\u30b5\u30d7\u30e9\u30a4\u30ba\u30c7\u30fc\u30c8\u30d7\u30e9\u30f3\u30ca\u30fc\u3092\u30bf\u30c3\u30d7\u3002\u30d1\u30fc\u30c8\u30ca\u30fc\u306b\u898b\u3048\u306a\u3044\u3088\u3046\u306b\u3001\u4eca\u9031\u306e\u5c0f\u3055\u306a\u30b5\u30d7\u30e9\u30a4\u30ba\u3092\u4ed5\u8fbc\u3093\u3067\u307f\u3066\u3002\u7d50\u679c\u306f\u304d\u3063\u3068\u3001\u3042\u306a\u305f\u306e\u60f3\u50cf\u3092\u8d85\u3048\u308b\u3002P.S. \u3082\u3057\u3053\u306e\u65b9\u6cd5\u3067\u55a7\u5629\u304c\u6e1b\u3063\u305f\u3089\u3001\u305c\u3072\u6559\u3048\u3066\u3002\u6b21\u306e\u30e1\u30fc\u30eb\u3067\u3001\u3055\u3089\u306b\u79d8\u5bc6\u306e\u4f7f\u3044\u65b9\u3092\u30b7\u30a7\u30a2\u3059\u308b\u304b\u3089\u3002"
