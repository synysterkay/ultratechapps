{
  "subject": "\u0906\u092a\u0915\u0947 28 \u0926\u093f\u0928 - 200% \u0924\u0947\u091c \u0906\u0935\u093e\u091c",
  "preview_text": "\u092a\u093f\u091b\u0932\u0947 \u092e\u0939\u0940\u0928\u0947 \u0906\u092a\u0928\u0947 \u0915\u093f\u0924\u0928\u0940 \u092c\u093e\u0930 \u0905\u092a\u0928\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u092f\u093e? \u092f\u0939 \u0906\u0902\u0915\u0921\u093c\u093e \u0926\u0947\u0916\u0915\u0930 \u0939\u0948\u0930\u093e\u0928 \u0930\u0939 \u091c\u093e\u090f\u0902\u0917\u0947\u0964",
  "body_paragraphs": [
    "28 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0906\u092a\u0928\u0947 Volume Booster \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e\u0964 \u0924\u092c \u0938\u0947 \u0906\u092a\u0928\u0947 \u0914\u0938\u0924\u0928 200% \u091c\u094d\u092f\u093e\u0926\u093e \u0906\u0935\u093e\u091c \u0915\u0947 \u0938\u093e\u0925 \u0917\u093e\u0928\u0947 \u0938\u0941\u0928\u0947, \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u0947 \u0914\u0930 \u0935\u0940\u0921\u093f\u092f\u094b \u0926\u0947\u0916\u0947\u0964 \u092f\u0939 \u0915\u094b\u0908 \u092e\u093e\u092e\u0942\u0932\u0940 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",
    "\u092e\u0948\u0902\u0928\u0947 \u0906\u092a\u0915\u0947 \u0921\u0947\u091f\u093e \u092a\u0930 \u0928\u091c\u093c\u0930 \u0921\u093e\u0932\u0940 - \u0906\u092a\u0928\u0947 \u092a\u093f\u091b\u0932\u0947 \u092e\u0939\u0940\u0928\u0947 \u0915\u0930\u0940\u092c 50 \u092c\u093e\u0930 \u092c\u0942\u0938\u094d\u091f \u092c\u091f\u0928 \u0926\u092c\u093e\u092f\u093e\u0964 \u0907\u0938\u0915\u093e \u092e\u0924\u0932\u092c \u0939\u0948 \u0915\u093f \u0906\u092a \u0939\u0930 \u0926\u093f\u0928 \u0915\u092e \u0938\u0947 \u0915\u092e \u090f\u0915 \u092c\u093e\u0930 \u0905\u092a\u0928\u0947 \u092b\u093c\u094b\u0928 \u0915\u0940 \u0905\u0938\u0932\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u093e \u0905\u0928\u0941\u092d\u0935 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0935\u0939 \u092c\u0947\u0938 \u091c\u094b \u092a\u0939\u0932\u0947 \u0917\u093e\u092f\u092c \u0925\u093e, \u0935\u0939 \u0905\u092c \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0917\u0942\u0902\u091c\u0924\u093e \u0939\u0948\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u0905\u092d\u0940 \u0914\u0930 \u092d\u0940 \u0915\u0941\u091b \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0906\u092a\u0928\u0947 EQ \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938 \u0915\u094b \u091f\u094d\u0930\u093e\u0908 \u0915\u093f\u092f\u093e? '\u0930\u0949\u0915' \u092f\u093e '\u091c\u0948\u091c\u093c' \u092a\u0930 \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u0938\u0947 \u0906\u092a\u0915\u093e \u0917\u093e\u0928\u093e \u092c\u0926\u0932 \u091c\u093e\u0924\u093e \u0939\u0948 - \u0914\u0930 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092e\u0947\u0902 \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0932\u0947\u0935\u0932 \u0939\u0948\u0902, \u091c\u094b \u0906\u092a\u0915\u094b \u0915\u0902\u0938\u0930\u094d\u091f \u091c\u0948\u0938\u093e \u0905\u0928\u0941\u092d\u0935 \u0926\u0947\u0902\u0917\u0947\u0964 \u0906\u092a\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u0915\u0947\u0935\u0932 30% \u092b\u0940\u091a\u0930\u094d\u0938 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e \u0939\u0948\u0964",
    "\u0906\u091c \u090f\u0915 \u0915\u093e\u092e \u0915\u0930\u0947\u0902: \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u092b\u093f\u0930 '\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u093e \u0932\u0917\u093e\u090f\u0902\u0964 \u092e\u0948\u0902 \u0917\u093e\u0930\u0902\u091f\u0940 \u0926\u0947\u0924\u093e \u0939\u0942\u0902, \u0906\u092a\u0915\u093e \u092b\u093c\u094b\u0928 \u0928\u092f\u093e \u0932\u0917\u0947\u0917\u093e\u0964 P.S. - \u0905\u0917\u0932\u0947 24 \u0918\u0902\u091f\u0947 \u092e\u0947\u0902 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0916\u0941\u0932\u093e \u0939\u0948, \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0926\u0942\u0930\u0964"
  ],
