{
  "subject": "\u090f\u0915 \u092e\u0939\u0940\u0928\u0947 \u092e\u0947\u0902 \u0906\u092a\u0928\u0947 \u092f\u0939 \u0917\u0932\u0924\u0940 \u0905\u0935\u0936\u094d\u092f \u0915\u0940 \u0939\u094b\u0917\u0940",
  "preview_text": "28 \u0926\u093f\u0928, \u0914\u0930 \u0906\u092a\u0915\u0947 \u0911\u0921\u093f\u092f\u094b \u092e\u0947\u0902 \u0905\u092d\u0940 \u092d\u0940 \u0915\u0941\u091b \u0915\u092e\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0930\u0939\u093e \u0935\u0939 \u0938\u091a \u091c\u094b \u0906\u092a\u0915\u094b \u092a\u0924\u093e \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964",
  "body_paragraphs": [
    "\u090f\u0915 \u092e\u0939\u0940\u0928\u093e \u092a\u0942\u0930\u093e \u0939\u094b \u0917\u092f\u093e\u0964 \u0906\u092a\u0928\u0947 Volume Booster \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e, \u0936\u093e\u092f\u0926 \u0915\u0941\u091b \u092c\u093e\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e, \u0914\u0930 \u092b\u093f\u0930 \u092d\u0942\u0932 \u0917\u090f\u0964 \u092f\u0939\u0940 \u0935\u0939 \u0917\u0932\u0924\u0940 \u0939\u0948 \u091c\u094b 90% \u0932\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u0947 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u092c\u0926\u0932\u0928\u0947 \u0915\u093e \u092e\u094c\u0915\u093e \u0939\u093e\u0925 \u0938\u0947 \u091c\u093e\u0928\u0947 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u092a\u0930 \u0938\u094b\u091a\u093f\u090f, \u0907\u0928 28 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0906\u092a\u0928\u0947 \u0915\u094d\u092f\u093e \u0939\u093e\u0938\u093f\u0932 \u0915\u093f\u092f\u093e? \u0906\u092a\u0928\u0947 \u090f\u0915 \u0910\u0938\u093e \u091f\u0942\u0932 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u091c\u094b \u0906\u092a\u0915\u0940 \u0939\u0930 \u0917\u093e\u0928\u0947, \u0939\u0930 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f, \u0939\u0930 \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u092c\u0926\u0932 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0906\u092a\u0928\u0947 \u0907\u0938\u092e\u0947\u0902 \u0938\u092e\u092f \u0932\u0917\u093e\u092f\u093e\u0964 \u0905\u092c \u092f\u0939 \u0938\u092e\u092f \u0939\u0948 \u0915\u093f \u0906\u092a \u0909\u0938 \u0928\u093f\u0935\u0947\u0936 \u0915\u093e \u092a\u0942\u0930\u093e \u092b\u093e\u092f\u0926\u093e \u0909\u0920\u093e\u090f\u0902\u0964 \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u0905\u092d\u0940 \u092d\u0940 \u0935\u0948\u0938\u093e \u0939\u0940 \u092c\u091c \u0930\u0939\u093e \u0939\u0948 \u091c\u0948\u0938\u093e \u090f\u0915 \u092e\u0939\u0940\u0928\u0947 \u092a\u0939\u0932\u0947 \u092c\u091c\u0924\u093e \u0925\u093e? \u092f\u0939 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964",
    "\u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u0935\u0939 \u091a\u093e\u092c\u0940 \u0939\u0948 \u091c\u094b \u0924\u093e\u0932\u0947 \u0915\u094b \u0916\u094b\u0932 \u0938\u0915\u0924\u0940 \u0939\u0948: \u092c\u093f\u0932\u094d\u091f-\u0907\u0928 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930\u0964 \u0906\u092a\u0928\u0947 \u0936\u093e\u092f\u0926 \u0907\u0938\u0947 \u091f\u094d\u0930\u093e\u0908 \u092d\u0940 \u0915\u093f\u092f\u093e \u0939\u094b\u0964 \u0932\u0947\u0915\u093f\u0928 \u0915\u094d\u092f\u093e \u0906\u092a\u0928\u0947 '\u092c\u093e\u0938 \u092c\u0942\u0938\u094d\u091f\u0930' \u0915\u0947 \u0938\u093e\u0925 '\u0932\u093e\u0909\u0921\u0928\u0947\u0938 \u090f\u0928\u094d\u0939\u093e\u0902\u0938\u0930' \u0915\u094b \u090f\u0915 \u0938\u093e\u0925 \u091a\u0932\u093e\u092f\u093e \u0939\u0948? \u092f\u0939 \u0935\u0939 \u0915\u0949\u092e\u094d\u092c\u094b \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u0938\u091a\u092e\u0941\u091a '\u0928\u092f\u093e \u0921\u093f\u0935\u093e\u0907\u0938' \u091c\u0948\u0938\u093e \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u093e\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0935\u0939 \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0939\u0948 \u091c\u094b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0930\u094b\u091c\u093e\u0928\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902\u0964 \u092a\u0949\u092a \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091a\u0941\u0928\u0947\u0902, \u092c\u093e\u0938 \u092c\u0942\u0938\u094d\u091f\u0930 \u0915\u094b \u092e\u0948\u0915\u094d\u0938 \u092a\u0930 \u0915\u0930\u0947\u0902, \u0914\u0930 \u0932\u093e\u0909\u0921\u0928\u0947\u0938 \u090f\u0928\u094d\u0939\u093e\u0902\u0938\u0930 \u0911\u0928 \u0915\u0930 \u0926\u0947\u0902\u0964 \u092b\u093f\u0930 \u0915\u094b\u0908 \u092d\u0940 \u0917\u093e\u0928\u093e \u0932\u0917\u093e\u090f\u0902\u0964 \u0906\u092a\u0915\u094b \u092a\u0939\u0932\u0947 10 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0939\u0940 \u092b\u0930\u094d\u0915 \u092a\u0924\u093e \u091a\u0932 \u091c\u093e\u090f\u0917\u093e\u0964 \u092f\u0939 \u0906\u092a\u0915\u093e '\u0935\u0928 \u092e\u0902\u0925 \u090f\u0928\u093f\u0935\u0930\u094d\u0938\u0930\u0940 \u091f\u0947\u0938\u094d\u091f' \u0939\u0948\u0964 \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u093f\u090f\u0964 P.S. \u090f\u0915 \u092c\u093e\u0924 \u0914\u0930: \u091c\u094b \u0932\u094b\u0917 \u0907\u0938 \u0915\u0949\u092e\u094d\u092c\u094b \u0915\u094b \u0906\u091c\u092e\u093e\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u092e\u0947\u0902 \u0938\u0947 70% \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0915\u0940 \u092b\u094d\u0930\u0940 \u091f\u094d\u0930\u093e\u092f\u0932 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u093f\u0930\u094d\u092b \u0907\u0938\u0932\u093f\u090f \u0928\u0939\u0940\u0902 \u0915\u093f \u092f\u0939 \u092c\u0947\u0939\u0924\u0930 \u0939\u0948, \u092c\u0932\u094d\u0915\u093f \u0907\u0938\u0932\u093f\u090f \u0915\u093f \u0935\u0947 \u0935\u093e\u092a\u0938 \u0909\u0938 \u092b\u0940\u0915\u0947 \u0938\u093e\u0909\u0902\u0921 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947\u0964"
  ],
  "cta_text": "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u091f\u0947\u0938\u094d\u091f \u0915\u0930\u0947\u0902",
