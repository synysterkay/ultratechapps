{
  "subject": "\u090f\u0915 \u092e\u0939\u0940\u0928\u0947 \u092e\u0947\u0902 \u0924\u0941\u092e\u0928\u0947 \u0915\u094d\u092f\u093e \u0939\u093e\u0938\u093f\u0932 \u0915\u093f\u092f\u093e",
  "preview_text": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930 \u0938\u092b\u0930: \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u0938\u0947 \u0906\u091c \u0924\u0915 \u0915\u093e \u0921\u0947\u091f\u093e \u0905\u0902\u0926\u0930 \u0939\u0948",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u092a\u093f\u091b\u0932\u0947 \u092e\u0939\u0940\u0928\u0947 \u0907\u0938\u0940 \u0938\u092e\u092f \u0924\u0941\u092e \u0915\u0939\u093e\u0901 \u0925\u0947? \u0938\u0902\u092d\u0935\u0924\u0903 \u090f\u0915 \u0916\u093e\u0932\u0940 \u092a\u0947\u091c \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u092c\u0948\u0920\u0947, \u0938\u094b\u091a \u0930\u0939\u0947 \u0925\u0947 \u0915\u093f \u0925\u0940\u0938\u093f\u0938 \u0915\u0948\u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0964 \u0906\u091c, 28 \u0926\u093f\u0928 \u092c\u093e\u0926, \u0924\u0941\u092e\u0928\u0947 \u0935\u094b \u0915\u0930 \u0926\u093f\u0916\u093e\u092f\u093e \u091c\u094b \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u0930 \u092a\u093e\u0924\u0947\u2014\u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e \u0914\u0930 \u0906\u0917\u0947 \u092c\u0922\u093c\u0947\u0964",
    "\u0939\u092e\u0928\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0921\u0947\u091f\u093e \u092a\u0930 \u0928\u091c\u093c\u0930 \u0921\u093e\u0932\u0940: \u0924\u0941\u092e\u0928\u0947 \u0932\u0917\u092d\u0917 10 \u0918\u0902\u091f\u0947 \u0915\u0940 \u092e\u0947\u0939\u0928\u0924 \u092c\u091a\u093e\u0908 \u0939\u0948\u0964 \u0935\u094b 10 \u0918\u0902\u091f\u0947 \u091c\u094b \u0924\u0941\u092e\u0928\u0947 \u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u092c\u093f\u0924\u093e\u090f, \u0938\u094b\u0928\u0947 \u092e\u0947\u0902, \u092f\u093e \u092c\u0938 \u0938\u093e\u0901\u0938 \u0932\u0947\u0928\u0947 \u092e\u0947\u0902\u0964 \u0914\u0930 \u0905\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0917\u094d\u0930\u0947\u0921 B+ \u0938\u0947 A- \u0915\u0940 \u0913\u0930 \u092c\u0922\u093c \u0930\u0939\u093e \u0939\u0948\u2014\u092c\u0938 \u0907\u0938 \u0910\u092a \u0915\u0940 \u0935\u091c\u0939 \u0938\u0947\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932\u0940 \u091c\u093e\u0926\u0942 \u0924\u094b \u0905\u092d\u0940 \u092c\u093e\u0915\u0940 \u0939\u0948\u0964 \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930 \u0915\u093e '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c \u090f\u0906\u0908 \u091f\u0947\u0915\u094d\u0938\u094d\u091f' \u092b\u0940\u091a\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e? \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0921\u094d\u0930\u093e\u092b\u094d\u091f \u0915\u094b \u0910\u0938\u093e \u092c\u0928\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u091f\u0930\u094d\u0928\u093f\u091f\u093f\u0928 \u092f\u093e GPTZero \u092d\u0940 \u0928\u0939\u0940\u0902 \u092a\u0915\u0921\u093c \u0938\u0915\u0924\u093e\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0906\u091c\u093c\u092e\u093e\u0913\u2014\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0906\u0916\u093f\u0930\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b \u092c\u0938 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0930\u0940\u0930\u093e\u0907\u091f \u0915\u0930 \u0926\u0942\u0901\u0917\u093e\u0964",
    "\u0905\u092c \u0905\u0917\u0932\u093e \u0915\u0926\u092e: \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u090f\u0915\u094d\u0938\u092a\u094b\u0930\u094d\u091f \u092a\u0940\u0921\u0940\u090f\u092b' \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u094b\u0964 \u0905\u092a\u0928\u0940 \u092a\u093f\u091b\u0932\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b \u092a\u0940\u0921\u0940\u090f\u092b \u092e\u0947\u0902 \u092c\u0926\u0932\u094b\u2014\u092f\u0939 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938.: \u0924\u0941\u092e\u0928\u0947 \u091c\u094b '\u0906\u0909\u091f\u0932\u093e\u0907\u0928 \u091f\u0942 \u092b\u0941\u0932 \u092a\u0947\u092a\u0930' \u092b\u0940\u091a\u0930 \u091b\u094b\u0921\u093c\u093e \u0925\u093e, \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0915\u0940 \u0938\u093e\u0930\u0940 \u092e\u0947\u0939\u0928\u0924 \u0915\u094b \u0906\u0927\u093e \u0915\u0930 \u0926\u0947\u0917\u093e\u0964 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u094b\u2014\u092e\u0941\u092b\u094d\u0924 \u0939\u0948\u0964"
  ],
