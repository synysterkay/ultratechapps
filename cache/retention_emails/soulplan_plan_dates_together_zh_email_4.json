  "subject": "\u5468\u4e09\u665a\u4e0a\uff0c37\u5bf9\u60c5\u4fa3\u505a\u4e86\u540c\u4e00\u4ef6\u4e8b",
  "preview_text": "\u4f60\u731c\u540e\u6765\u53d1\u751f\u4e86\u4ec0\u4e48\uff1f\u4ed6\u4eec\u7684\u7ea6\u4f1a\u8d28\u91cf\u63d0\u5347\u4e86\u6574\u6574\u4e00\u500d\u3002\u4eca\u665a\uff0c\u4f60\u4e5f\u53ef\u4ee5\u52a0\u5165\u4ed6\u4eec\u3002",
  "body_paragraphs": [
    "\u4e0a\u5468\u4e09\u665a\u4e0a9\u70b9\uff0c\u670937\u5bf9\u60c5\u4fa3\u5728SoulPlan\u4e0a\u70b9\u4e0b\u4e86\u540c\u4e00\u4e2a\u6309\u94ae\u3002\u4ed6\u4eec\u6ca1\u82b1\u65f6\u95f4\u8ba8\u8bba\u53bb\u54ea\u3001\u5403\u4ec0\u4e48\u3001\u7a7f\u4ec0\u4e48\u300230\u79d2\u540e\uff0c\u4ed6\u4eec\u653e\u4e0b\u624b\u673a\uff0c\u76f4\u63a5\u8d70\u8fdb\u4e86\u7ea6\u4f1a\u3002",
    "\u8fd9\u4e9b\u60c5\u4fa3\u5728\u63a5\u4e0b\u6765\u768424\u5c0f\u65f6\u5185\uff0c\u53d1\u9001\u4e86\u6bd4\u5e73\u65f6\u591a4\u500d\u7684\u7ea6\u4f1a\u9080\u8bf7\u3002\u4ed6\u4eec\u4e0d\u662f\u66f4\u6d6a\u6f2b\uff0c\u53ea\u662f\u627e\u5230\u4e86\u4e00\u4e2a\u8ba9\u8ba1\u5212\u6d88\u5931\u7684\u65b9\u6cd5\u3002\u800c\u90a3\u4e2a\u6309\u94ae\uff0c\u5c31\u5728\u4f60\u6bcf\u6b21\u6253\u5f00App\u65f6\u7684\u9996\u9875\u6b63\u4e2d\u95f4\u3002",
    "\u5b83\u53eb\u201c\u4eca\u665a\u7684\u7ea6\u4f1a\u201d\u3002\u4f60\u9009\u4e00\u4e2a\u5fc3\u60c5\uff1a\u6e29\u99a8\u3001\u5192\u9669\u3001\u4fcf\u76ae\u3001\u6cbb\u6108\uff0cAI\u7acb\u523b\u7ed9\u4f60\u4e00\u5f20\u5361\u7247\u3002\u4f60\u53d1\u9001\uff0c\u5bf9\u65b9\u6536\u5230\u7684\u4e0d\u53ea\u662f\u901a\u77e5\u2014\u2014\u662f\u4e00\u4e2a\u201c\u4eca\u665a\u60f3\u4f60\u201d\u7684\u5168\u5c4f\u77ac\u95f4\u3002\u6ca1\u6709\u7ea0\u7ed3\uff0c\u6ca1\u6709\u62d6\u5ef6\u3002",
    "\u6253\u5f00SoulPlan\uff0c\u70b9\u4e00\u4e0b\u201c\u4eca\u665a\u7684\u7ea6\u4f1a\u201d\u300230\u79d2\u540e\uff0c\u4f60\u5c31\u80fd\u544a\u8bc9\u4f34\u4fa3\uff1a\u4eca\u665a\u6709\u5b89\u6392\u3002P.S. \u90a3\u4e2a\u514d\u8d39\u7684\u8bb0\u5fc6\u65f6\u95f4\u8f74\uff0c\u53ea\u6709\u5728\u4f60\u4eec\u5f00\u59cb\u7ea6\u4f1a\u540e\u624d\u4f1a\u81ea\u52a8\u751f\u957f\u2014\u2014\u522b\u8ba9\u5b83\u7a7a\u7740\u3002"
