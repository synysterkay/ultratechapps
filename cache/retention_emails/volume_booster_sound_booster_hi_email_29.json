{
  "subject": "\u090f\u0915 \u0917\u0941\u092a\u094d\u0924 \u0915\u0949\u0928\u094d\u092b\u0947\u0936\u0928: \u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0910\u092a \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0939\u0940 \u092c\u0928\u093e\u092f\u093e \u0925\u093e",
  "preview_text": "\u0926\u0947\u0916\u093f\u090f, \u0906\u092a \u091c\u0948\u0938\u0947 68 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u0938\u091a\u094d\u091a\u0947 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092e\u0948\u0902\u0928\u0947 \u0915\u094d\u092f\u093e \u091b\u0941\u092a\u093e \u0930\u0916\u093e \u0939\u0948\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u0938\u091a \u0915\u0939\u0942\u0902? \u091c\u092c \u0939\u092e\u0928\u0947 \u092f\u0939 \u0910\u092a \u092c\u0928\u093e\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e, \u0924\u094b \u0939\u092e\u093e\u0930\u0947 \u0926\u093f\u092e\u093e\u0917 \u092e\u0947\u0902 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0939\u0940 \u0907\u0902\u0938\u093e\u0928 \u0915\u093e \u091a\u0947\u0939\u0930\u093e \u0925\u093e\u0964 \u0935\u094b \u0907\u0902\u0938\u093e\u0928 \u091c\u094b \u092c\u0938 \u092e\u0947\u0902 \u092c\u0948\u0920\u0915\u0930 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u0924\u0947 \u0939\u0941\u090f \u0939\u0930 \u0926\u0942\u0938\u0930\u0947 \u0936\u092c\u094d\u0926 \u0915\u094b \u092e\u093f\u0938 \u0915\u0930 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0935\u094b \u0907\u0902\u0938\u093e\u0928 \u091c\u093f\u0938\u0915\u0947 \u092b\u094b\u0928 \u0915\u093e \u0938\u093e\u0909\u0902\u0921 \u092b\u094d\u0932\u0948\u091f \u0914\u0930 \u092c\u0947\u091c\u093e\u0928 \u0932\u0917\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u0906\u091c, 68 \u0926\u093f\u0928 \u092c\u093e\u0926, \u092e\u0948\u0902 \u091c\u093e\u0928\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u0935\u094b \u0907\u0902\u0938\u093e\u0928 \u0906\u092a \u0939\u0940 \u0939\u0948\u0902\u0964",
    "\u0907\u0938\u0932\u093f\u090f \u0906\u091c \u0915\u093e \u0908\u092e\u0947\u0932 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 '\u0927\u0928\u094d\u092f\u0935\u093e\u0926' \u0939\u0948\u0964 \u0906\u092a \u091c\u0948\u0938\u0947 \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u0915\u0947 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f, \u091c\u093f\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u0907\u0924\u0928\u0947 \u0926\u093f\u0928 \u092c\u093f\u0924\u093e\u090f\u0964 \u0914\u0930 \u0927\u0928\u094d\u092f\u0935\u093e\u0926 \u0926\u0947\u0928\u0947 \u0915\u093e \u0924\u0930\u0940\u0915\u093e? \u090f\u0915 \u0910\u0938\u0940 \u090f\u0915\u094d\u0938\u0915\u094d\u0932\u0942\u0938\u093f\u0935 \u090f\u0915\u094d\u0938\u0947\u0938 \u091c\u094b \u0939\u092e \u0915\u093f\u0938\u0940 \u0914\u0930 \u0915\u094b \u0928\u0939\u0940\u0902 \u0926\u0947 \u0930\u0939\u0947\u0964 \u0906\u092a\u0915\u0947 \u091c\u0948\u0938\u0947 1% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u0917\u093f\u092b\u094d\u091f, \u091c\u094b \u0906\u092a\u0915\u0940 \u0932\u093f\u0938\u0928\u093f\u0902\u0917 \u090f\u0915\u094d\u0938\u092a\u0940\u0930\u093f\u092f\u0902\u0938 \u0915\u094b \u0905\u0917\u0932\u0947 \u0932\u0947\u0935\u0932 \u092a\u0930 \u0932\u0947 \u091c\u093e\u090f\u0917\u093e\u0964",
    "\u0939\u092e\u0928\u0947 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0908\u0915\u094d\u092f\u0942 \u0915\u0947 \u0905\u0902\u0926\u0930 \u090f\u0915 '\u0938\u0940\u0915\u094d\u0930\u0947\u091f \u092a\u094d\u0930\u0940\u0938\u0947\u091f' \u0932\u0949\u0915 \u0915\u0930 \u0930\u0916\u093e \u0939\u0948\u0964 \u0907\u0938\u0947 '\u0938\u094d\u091f\u0942\u0921\u093f\u092f\u094b \u092e\u093e\u0938\u094d\u091f\u0930' \u0915\u0939\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0935\u094b \u0938\u0947\u091f\u093f\u0902\u0917 \u0939\u0948 \u091c\u094b \u0939\u092e \u0916\u0941\u0926 \u0905\u092a\u0928\u0947 \u092a\u0930\u094d\u0938\u0928\u0932 \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 - \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0935\u0948\u0938\u093e \u0938\u093e\u0909\u0902\u0921 \u091c\u0948\u0938\u093e \u092e\u094d\u092f\u0942\u091c\u093f\u0915 \u092a\u094d\u0930\u094b\u0921\u094d\u092f\u0942\u0938\u0930 \u0905\u092a\u0928\u0947 \u0938\u094d\u091f\u0942\u0921\u093f\u092f\u094b \u092e\u0947\u0902 \u0938\u0941\u0928\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u094d\u0930\u093f\u0938\u094d\u092a \u0939\u093e\u0907\u091c, \u0921\u0940\u092a \u092c\u093e\u0938, \u0914\u0930 \u0939\u0930 \u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u0915\u0940 \u0915\u094d\u0932\u0948\u0930\u093f\u091f\u0940\u0964 \u092f\u0939 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0905\u092d\u0940 \u0924\u0915 \u0915\u093f\u0938\u0940 \u0915\u094b \u0928\u0939\u0940\u0902 \u0926\u093f\u0916\u093e\u092f\u093e \u0917\u092f\u093e\u0964",
    "\u0907\u0938\u0947 \u0906\u091c\u092e\u093e\u0907\u090f \u0914\u0930 \u092b\u0930\u094d\u0915 \u092e\u0939\u0938\u0942\u0938 \u0915\u0940\u091c\u093f\u090f\u0964 \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u0938\u093f\u0930\u094d\u092b \u0932\u093e\u0909\u0921 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u092a\u094d\u0930\u094b\u092b\u0947\u0936\u0928\u0932 \u0938\u094d\u092a\u0940\u0915\u0930 \u091c\u0948\u0938\u093e \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0917\u093e\u0964 \u092c\u0938 Volume Booster \u0916\u094b\u0932\u093f\u090f, \u0908\u0915\u094d\u092f\u0942 \u092a\u0930 \u091f\u0948\u092a \u0915\u0940\u091c\u093f\u090f, \u0914\u0930 '\u0938\u094d\u091f\u0942\u0921\u093f\u092f\u094b \u092e\u093e\u0938\u094d\u091f\u0930' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u090f\u0915\u094d\u091f\u093f\u0935\u0947\u091f \u0915\u0940\u091c\u093f\u090f\u0964 \u092f\u0939 \u0906\u092a\u0915\u093e \u0939\u0948, \u092c\u0938 \u0906\u092a\u0915\u093e\u0964 P.S.: \u092f\u0939 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u091f\u093e\u0907\u092e \u0915\u0947 \u0932\u093f\u090f \u0939\u0940 \u0905\u0928\u0932\u0949\u0915 \u0939\u0948\u0964 \u090f\u0915 \u092c\u093e\u0930 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0915\u0947 \u092c\u0924\u093e\u0907\u090f\u0917\u093e \u0915\u0948\u0938\u093e \u0932\u0917\u093e - \u092e\u0948\u0902 \u0916\u0941\u0926 \u091c\u0935\u093e\u092c \u0915\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930\u0942\u0902\u0917\u093e\u0964"
  ],
  "cta_text": "Volume Booster \u092e\u0947\u0902 '\u0938\u094d\u091f\u0942\u0921\u093f\u092f\u094b \u092e\u093e\u0938\u094d\u091f\u0930' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u090f\u0915\u094d\u091f\u093f\u0935\u0947\u091f \u0915\u0930\u0947\u0902",
