{
  "subject": "68 \u0926\u093f\u0928\u094b\u0902 \u0915\u093e \u0938\u092b\u0930 \u0914\u0930 \u090f\u0915 \u0916\u093e\u0938 \u0924\u094b\u0939\u092b\u093e",
  "preview_text": "\u0939\u092e\u093e\u0930\u0947 \u0938\u092c\u0938\u0947 \u092a\u0941\u0930\u093e\u0928\u0947 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u092b\u0940\u091a\u0930 \u0916\u0941\u0932 \u0917\u092f\u093e \u0939\u0948\u0964 \u0907\u0938\u0947 \u092e\u093f\u0938 \u092e\u0924 \u0915\u0930\u093f\u090f\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 68 \u0926\u093f\u0928\u094b\u0902 \u0938\u0947 \u0906\u092a \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u0939\u0948\u0902\u0964 \u092f\u0915\u0940\u0928 \u092e\u093e\u0928\u093f\u090f, \u092f\u0939 \u0939\u092e\u093e\u0930\u0947 \u0932\u093f\u090f \u092c\u0939\u0941\u0924 \u092e\u093e\u092f\u0928\u0947 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u0939\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0939\u0948 \u0915\u093f \u0906\u092a \u0905\u092a\u0928\u0947 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0914\u0930 \u0917\u093e\u0928\u094b\u0902 \u0915\u094b \u092c\u0942\u0938\u094d\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u092f\u0939 \u0939\u092e\u0947\u0902 \u0930\u094b\u091c\u093c \u092c\u0947\u0939\u0924\u0930 \u0910\u092a \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0947\u0930\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u092e \u0906\u092a\u0915\u094b \u0915\u0941\u091b \u0910\u0938\u093e \u0926\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902 \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0939\u092e\u093e\u0930\u0947 \u0932\u0949\u0928\u094d\u0917-\u091f\u0930\u094d\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u094b \u092e\u093f\u0932\u0924\u093e \u0939\u0948: \u090f\u0915 \u090f\u0915\u094d\u0938\u0915\u094d\u0932\u0942\u0938\u093f\u0935 \u0907\u0928\u0938\u093e\u0907\u0921\u0930 \u090f\u0915\u094d\u0938\u0947\u0938\u0964 \u092f\u0939 \u0915\u094b\u0908 \u0938\u0947\u0932\u094d\u0938 \u092a\u093f\u091a \u0928\u0939\u0940\u0902 \u0939\u0948, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 '\u0925\u0948\u0902\u0915 \u092f\u0942' \u0939\u0948\u0964 \u0939\u092e\u0928\u0947 \u090f\u0915 \u0938\u094d\u092a\u0947\u0936\u0932 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0932\u0949\u0915 \u0915\u093f\u092f\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u092a\u0939\u0932\u0947 \u0938\u0947 \u0915\u0939\u0940\u0902 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0915\u094d\u0932\u093f\u092f\u0930 \u0914\u0930 \u0921\u0940\u092a \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0947 '\u0907\u0928\u0938\u093e\u0907\u0921\u0930 \u092c\u0942\u0938\u094d\u091f' \u0915\u0939\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u092f\u0939 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0906\u092a\u0915\u0947 \u0910\u092a \u0915\u0947 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u092e\u0947\u0902 \u091b\u093f\u092a\u093e \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0910\u092a \u0916\u094b\u0932\u093f\u090f, \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u092e\u0947\u0902 \u091c\u093e\u0907\u090f, \u0914\u0930 '\u0907\u0928\u0938\u093e\u0907\u0921\u0930 \u092c\u0942\u0938\u094d\u091f' \u092a\u0930 \u091f\u0948\u092a \u0915\u0940\u091c\u093f\u090f\u0964 \u0906\u092a\u0915\u094b \u092b\u0930\u094d\u0915 \u0924\u0941\u0930\u0902\u0924 \u092e\u0939\u0938\u0942\u0938 \u0939\u094b\u0917\u093e\u2014\u0916\u093e\u0938\u0915\u0930 \u092c\u093e\u0938 \u0914\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092e\u0947\u0902\u0964 \u092f\u0939 \u0939\u092e\u093e\u0930\u093e \u0924\u0930\u0940\u0915\u093e \u0939\u0948 \u0906\u092a\u0915\u094b \u092f\u0939 \u092c\u0924\u093e\u0928\u0947 \u0915\u093e \u0915\u093f \u0906\u092a \u0939\u092e\u093e\u0930\u0947 \u0932\u093f\u090f \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092f\u0942\u091c\u0930 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0939\u0948\u0902\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u092f\u0939 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b 48 \u0918\u0902\u091f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938.\u2014\u0905\u0917\u0930 \u0906\u092a \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092a\u0930 \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0906\u092a\u0915\u094b \u0914\u0930 \u092d\u0940 \u0910\u0938\u0947 \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u092b\u0940\u091a\u0930\u094d\u0938 \u092e\u093f\u0932\u0947\u0902\u0917\u0947 \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0939\u092e\u093e\u0930\u0947 \u0938\u092c\u0938\u0947 \u0935\u092b\u093e\u0926\u093e\u0930 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0902\u0964"
  ],
  "cta_text": "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0907\u0928\u0938\u093e\u0907\u0921\u0930 \u092c\u0942\u0938\u094d\u091f' \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902",
