{
  "subject": "28 \u0434\u043d\u0435\u0439 \u0441 Loudify \u2014 \u0442\u0432\u043e\u0439 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u043e\u0442\u0447\u0451\u0442",
  "preview_text": "\u0422\u044b \u0443\u0436\u0435 \u043c\u0435\u0441\u044f\u0446 \u0441 \u043d\u0430\u043c\u0438. \u0412\u043d\u0443\u0442\u0440\u0438 \u2014 \u0447\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e\u0441\u044c \u0432 \u0442\u0432\u043e\u0438\u0445 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u0445 \u0438 \u0447\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u0443\u043b\u0443\u0447\u0448\u0438\u0442\u044c.",
  "body_paragraphs": [
    "\u041c\u0435\u0441\u044f\u0446 \u043d\u0430\u0437\u0430\u0434 \u0442\u044b \u0441\u043a\u0430\u0447\u0430\u043b Loudify. \u0421 \u0442\u0435\u0445 \u043f\u043e\u0440 \u0442\u0432\u043e\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438 \u043f\u0440\u043e\u0436\u0438\u043b\u0438 \u0446\u0435\u043b\u0443\u044e \u0436\u0438\u0437\u043d\u044c \u2014 \u043f\u043e\u0435\u0437\u0434\u0430, \u043a\u0430\u0444\u0435, \u043d\u043e\u0447\u043d\u044b\u0435 \u0438\u0433\u0440\u044b, \u043f\u043e\u0434\u043a\u0430\u0441\u0442\u044b \u0434\u043e \u0443\u0442\u0440\u0430. \u0418 \u044f \u043d\u0435 \u0448\u0443\u0447\u0443: \u0442\u0432\u043e\u0439 Sound DNA \u0443\u0436\u0435 \u0441\u043e\u0431\u0440\u0430\u043b \u0434\u0430\u043d\u043d\u044b\u0435 \u0437\u0430 28 \u0434\u043d\u0435\u0439. \u0417\u043d\u0430\u0435\u0448\u044c, \u043a\u0430\u043a\u043e\u0439 \u0442\u0440\u0435\u043a \u0442\u044b \u0441\u043b\u0443\u0448\u0430\u043b \u0433\u0440\u043e\u043c\u0447\u0435 \u0432\u0441\u0435\u0433\u043e?",
    "\u041f\u043e\u043a\u0430 \u0434\u0440\u0443\u0433\u0438\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u044e\u0442 \u0433\u0440\u044f\u0437\u044c, Loudify \u0432\u044b\u0442\u044f\u0433\u0438\u0432\u0430\u0435\u0442 \u0434\u0438\u0430\u043b\u043e\u0433\u0438 \u0438\u0437 \u0448\u0443\u043c\u0430 \u0438 \u0434\u0430\u0451\u0442 +200% \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438 \u0431\u0435\u0437 \u0438\u0441\u043a\u0430\u0436\u0435\u043d\u0438\u0439. \u0422\u044b \u044d\u0442\u043e \u0443\u0436\u0435 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b. \u041d\u043e \u0432\u043e\u0442 \u0447\u0442\u043e \u044f \u0437\u0430\u043c\u0435\u0442\u0438\u043b: \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u043d\u0430 28-\u0439 \u0434\u0435\u043d\u044c \u043d\u0435 \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442 AutoEQ. \u0410 \u0437\u0440\u044f \u2014 \u044d\u0442\u043e \u043a\u0430\u043a \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u043a\u043e\u043b\u043e\u043d\u043a\u0438 \u043f\u043e\u0434 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0443\u044e \u043a\u043e\u043c\u043d\u0430\u0442\u0443. \u0422\u0432\u043e\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438 \u0436\u0434\u0443\u0442.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435. \u0422\u0430\u043c \u0435\u0441\u0442\u044c \u0440\u0430\u0437\u0434\u0435\u043b \u00ab\u0417\u0432\u0443\u043a\u043e\u0432\u0430\u044f \u0414\u041d\u041a\u00bb \u2014 \u0442\u0432\u043e\u0439 \u0435\u0436\u0435\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u043e\u0442\u0447\u0451\u0442. \u041e\u043d \u043f\u043e\u043a\u0430\u0436\u0435\u0442, \u043a\u0430\u043a\u0438\u0435 \u0447\u0430\u0441\u0442\u043e\u0442\u044b \u0442\u044b \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u0435\u0448\u044c, \u0433\u0434\u0435 Loudify \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0430 \u043f\u043e\u043b\u043d\u0443\u044e, \u0438 \u0433\u0434\u0435 \u043c\u043e\u0436\u043d\u043e \u0434\u043e\u043a\u0440\u0443\u0442\u0438\u0442\u044c. \u042d\u0442\u043e \u043d\u0435 \u043c\u0430\u0440\u043a\u0435\u0442\u0438\u043d\u0433 \u2014 \u044d\u0442\u043e \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u0442\u044b \u0441\u043b\u0443\u0448\u0430\u0435\u0448\u044c.",
    "\u0417\u0430\u0439\u0434\u0438 \u0432 Loudify \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u0433\u043b\u044f\u043d\u044c \u0441\u0432\u043e\u0439 Sound DNA \u0437\u0430 \u043c\u0435\u0441\u044f\u0446. \u0415\u0441\u043b\u0438 \u0437\u0430\u0445\u043e\u0447\u0435\u0448\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u2014 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 Premium: \u043f\u043e\u043b\u043d\u044b\u0439 AutoEQ, \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0437\u0430 \u0432\u0441\u0451 \u0432\u0440\u0435\u043c\u044f \u0438 \u0431\u0435\u0437\u043b\u0438\u043c\u0438\u0442\u043d\u044b\u0439 \u0431\u0443\u0441\u0442. P.S. \u041a\u0441\u0442\u0430\u0442\u0438, \u0442\u0432\u043e\u0439 \u0442\u043e\u043f-5 \u0442\u0440\u0435\u043a\u043e\u0432 \u0437\u0430 \u043c\u0435\u0441\u044f\u0446 \u043c\u043e\u0436\u0435\u0442 \u0442\u0435\u0431\u044f \u0443\u0434\u0438\u0432\u0438\u0442\u044c. \u041f\u0440\u043e\u0432\u0435\u0440\u044c."
  ],
