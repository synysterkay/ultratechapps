{
  "subject": "\u062a\u062d\u0630\u064a\u0631: 90% \u0645\u0646 \u0627\u0644\u0645\u0634\u062c\u0639\u064a\u0646 \u064a\u0631\u062a\u0643\u0628\u0648\u0646 \u0647\u0630\u0627 \u0627\u0644\u062e\u0637\u0623 \u0627\u0644\u0641\u0627\u062f\u062d",
  "preview_text": "\u0643\u0644 \u0645\u0627 \u062a\u0639\u0631\u0641\u0647 \u0639\u0646 \u062a\u0648\u0642\u0639\u0627\u062a \u0627\u0644\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u062e\u0627\u0637\u0626. \u0627\u0643\u062a\u0634\u0641 \u0627\u0644\u062d\u0642\u064a\u0642\u0629 \u0627\u0644\u0645\u062e\u0641\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u063a\u064a\u0631 \u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0644\u0639\u0628\u0629.",
  "body_paragraphs": [
    "\u0647\u0644 \u062a\u0639\u062a\u0642\u062f \u0623\u0646 \u0627\u0644\u0641\u0631\u064a\u0642 \u0635\u0627\u062d\u0628 \u0627\u0644\u0647\u062c\u0648\u0645 \u0627\u0644\u0623\u0642\u0648\u0649 \u062f\u0627\u0626\u0645\u0627\u064b \u064a\u0641\u0648\u0632\u061f \u0647\u0630\u0627 \u0623\u0643\u0628\u0631 \u0648\u0647\u0645 \u0641\u064a \u0639\u0627\u0644\u0645 \u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645. \u0627\u0644\u062c\u0645\u064a\u0639 \u064a\u0635\u062f\u0642 \u0630\u0644\u0643\u060c \u0644\u0643\u0646 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u062a\u0643\u0634\u0641 \u0642\u0635\u0629 \u0645\u062e\u062a\u0644\u0641\u0629 \u062a\u0645\u0627\u0645\u0627\u064b.",
    "\u0644\u0642\u062f \u062d\u0644\u0644\u0646\u0627 \u0622\u0644\u0627\u0641 \u0627\u0644\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0648\u0648\u062c\u062f\u0646\u0627 \u0645\u0641\u0627\u062c\u0623\u0629 \u0635\u0627\u062f\u0645\u0629: \u0641\u064a 43% \u0645\u0646 \u0627\u0644\u0645\u0628\u0627\u0631\u064a\u0627\u062a\u060c \u0627\u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0623\u0642\u0644 \u0647\u062c\u0648\u0645\u0627\u064b \u064a\u0641\u0648\u0632 \u0623\u0648 \u064a\u062a\u0639\u0627\u062f\u0644. \u0627\u0644\u0633\u0631\u061f \u0627\u0644\u0642\u0648\u0629 \u0627\u0644\u062f\u0641\u0627\u0639\u064a\u0629 \u0648\u0627\u0644\u0627\u0633\u062a\u062d\u0648\u0627\u0630 \u0627\u0644\u0630\u0643\u064a. \u0627\u0644\u0623\u0645\u062b\u0644\u0629 \u0644\u0627 \u062a\u062d\u0635\u0649: \u0623\u062a\u0644\u062a\u064a\u0643\u0648 \u0645\u062f\u0631\u064a\u062f\u060c \u0625\u064a\u0637\u0627\u0644\u064a\u0627 2006\u060c \u0644\u064a\u0633\u062a\u0631 \u0633\u064a\u062a\u064a. \u0627\u0644\u063a\u0631\u064a\u0632\u0629 \u062a\u062e\u0648\u0646\u0643\u060c \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0644\u0627 \u062a\u0643\u0630\u0628 \u0623\u0628\u062f\u0627\u064b.",
    "\u0647\u0630\u0627 \u0628\u0627\u0644\u0636\u0628\u0637 \u0633\u0628\u0628 \u0648\u062c\u0648\u062f \u0645\u064a\u0632\u0629 '\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0642\u0648\u0629 \u0627\u0644\u062f\u0641\u0627\u0639\u064a\u0629' \u0641\u064a Predictify. \u0644\u0627 \u0646\u0646\u0638\u0631 \u0641\u0642\u0637 \u0644\u0644\u0623\u0647\u062f\u0627\u0641\u060c \u0646\u062d\u0644\u0644 \u0639\u0645\u0642 \u0627\u0644\u062f\u0641\u0627\u0639\u060c \u0636\u063a\u0637 \u0627\u0644\u0644\u0627\u0639\u0628\u064a\u0646\u060c \u0646\u0633\u0628\u0629 \u0627\u0644\u0627\u0633\u062a\u0631\u062c\u0627\u0639. \u0646\u0639\u0637\u064a\u0643 \u062f\u0631\u062c\u0629 \u062b\u0642\u0629 \u0645\u0628\u0646\u064a\u0629 \u0639\u0644\u0649 127 \u0645\u062a\u063a\u064a\u0631\u0627\u064b \u062f\u0641\u0627\u0639\u064a\u0627\u064b \u0644\u0627 \u064a\u0631\u0627\u0647\u0627 \u0623\u062d\u062f.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0634\u0627\u0647\u062f \u062a\u062d\u0644\u064a\u0644 \u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u0644\u064a\u0644\u0629. \u0633\u062a\u062a\u0641\u0627\u062c\u0623 \u0645\u0646 \u0627\u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0630\u064a \u062a\u0639\u0637\u064a\u0647 \u062e\u0648\u0627\u0631\u0632\u0645\u064a\u062a\u0646\u0627 \u0627\u0644\u0623\u0641\u0636\u0644\u064a\u0629 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629. P.S: \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0645\u0645\u064a\u0632\u0648\u0646 \u064a\u0631\u0648\u0646 \u0647\u0630\u0647 \u0627\u0644\u062a\u062d\u0644\u064a\u0644\u0627\u062a \u0627\u0644\u062f\u0641\u0627\u0639\u064a\u0629 \u0642\u0628\u0644 24 \u0633\u0627\u0639\u0629 \u0645\u0646 \u0627\u0644\u062c\u0645\u064a\u0639 - \u062c\u0631\u0628\u0647\u0627 3 \u0623\u064a\u0627\u0645 \u0645\u062c\u0627\u0646\u0627\u064b.",
    ""
  ],
