{
  "subject": "\u0642\u0635\u0629 \u0633\u0627\u0645\u0631 \u0645\u0639 \u0627\u0644\u0636\u0648\u0636\u0627\u0621 \u0641\u064a \u0627\u0644\u0645\u062a\u0631\u0648",
  "preview_text": "\u0643\u0627\u0646 \u0643\u0644 \u064a\u0648\u0645 \u064a\u0639\u0627\u0646\u064a \u0645\u0646 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u062e\u0627\u0641\u062a. \u062b\u0645 \u0627\u0643\u062a\u0634\u0641 \u0634\u064a\u0626\u064b\u0627 \u063a\u064a\u0651\u0631 \u0643\u0644 \u0634\u064a\u0621.",
  "body_paragraphs": [
    "\u0633\u0627\u0645\u0631\u060c \u0645\u062b\u0644\u0643 \u062a\u0645\u0627\u0645\u064b\u0627\u060c \u0643\u0627\u0646 \u064a\u0631\u0643\u0628 \u0627\u0644\u0645\u062a\u0631\u0648 \u0643\u0644 \u0635\u0628\u0627\u062d. \u064a\u0636\u0639 \u0633\u0645\u0627\u0639\u0627\u062a\u0647\u060c \u064a\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0644\u0623\u0642\u0635\u0649 \u062d\u062f\u060c \u0644\u0643\u0646 \u0627\u0644\u062d\u0648\u0627\u0631 \u064a\u0636\u064a\u0639 \u062a\u062d\u062a \u0636\u0648\u0636\u0627\u0621 \u0627\u0644\u0642\u0637\u0627\u0631 \u0648\u0627\u0644\u0645\u0643\u064a\u0641. \u0643\u0627\u0646 \u064a\u0634\u0639\u0631 \u0623\u0646 \u0627\u0644\u0635\u0648\u062a \u0645\u0633\u0631\u0648\u0642 \u0645\u0646\u0647.",
    "\u062c\u0631\u0628 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a\u060c \u0644\u0643\u0646\u0647\u0627 \u0643\u0627\u0646\u062a \u062a\u0634\u0648\u0647 \u0643\u0644 \u0634\u064a\u0621. \u062d\u062a\u0649 AutoEQ \u0641\u064a Loudify \u062c\u0631\u0628\u0647\u0627\u060c \u0644\u0643\u0646\u0647 \u0643\u0627\u0646 \u064a\u0637\u0641\u0626\u0647\u0627 \u0643\u0644 \u064a\u0648\u0645 \u0644\u0623\u0646\u0647 \u0646\u0633\u064a \u0623\u0646 \u064a\u0648\u0635\u0651\u0644 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a \u0645\u0631\u0629 \u0623\u062e\u0631\u0649. \u0634\u0639\u0631 \u0628\u0627\u0644\u0625\u062d\u0628\u0627\u0637.",
    "\u062b\u0645 \u0641\u064a \u064a\u0648\u0645 \u0645\u0645\u0637\u0631\u060c \u0644\u0627\u062d\u0638 \u0634\u064a\u0626\u064b\u0627. \u0628\u0639\u062f \u0623\u0646 \u0631\u0628\u0637 \u0633\u0645\u0627\u0639\u0627\u062a\u0647 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629\u060c \u062a\u0630\u0643\u0631 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u0646\u0647 \u064a\u0645\u0644\u0643 \u0633\u0645\u0627\u0639\u0627\u062a Sony WH-1000XM4\u060c \u0648\u0636\u0628\u0637 \u0627\u0644\u0635\u0648\u062a \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627. \u0644\u0623\u0648\u0644 \u0645\u0631\u0629\u060c \u0633\u0645\u0639 \u0627\u0644\u062d\u0648\u0627\u0631 \u0648\u0627\u0636\u062d\u064b\u0627\u060c \u0648\u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0642\u0648\u064a\u0629 \u062f\u0648\u0646 \u062a\u0634\u0648\u064a\u0647. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0641\u0631\u0642.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0648\u0634\u0648\u0641 \u0625\u0630\u0627 \u0643\u0627\u0646 AutoEQ \u064a\u0639\u0631\u0641 \u0633\u0645\u0627\u0639\u0627\u062a\u0643. \u0644\u0648 \u0645\u0627 \u062c\u0631\u0628\u062a Sound DNA \u0628\u0639\u062f\u060c \u0627\u0633\u0645\u0639 \u062a\u0642\u0631\u064a\u0631 \u0623\u0633\u0628\u0648\u0639\u0643 \u0627\u0644\u0623\u0648\u0644. \u0647\u062a\u0646\u062f\u0647\u0634 \u0645\u0646 \u0643\u0645\u064a\u0629 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0644\u064a \u0641\u0627\u062a\u062a\u0643.\n\n\u0645\u0644\u0627\u062d\u0638\u0629: \u0644\u0648 \u0639\u0646\u062f\u0643 \u0633\u0645\u0627\u0639\u0627\u062a \u0623\u062e\u0631\u0649\u060c \u062c\u0631\u0628 \u062a\u0631\u0628\u0637\u0647\u0627. \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u064a\u062a\u0630\u0643\u0631 \u0643\u0644 \u0648\u0627\u062d\u062f\u0629 \u0639\u0644\u0649 \u062d\u062f\u0629."
  ],
