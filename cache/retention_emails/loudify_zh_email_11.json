    "\u6211\u4eec\u7684AutoEQ\u6bcf\u6b21\u8fde\u63a5\u8033\u673a\u65f6\u81ea\u52a8\u8c03\u6821\uff0c\u786e\u4fdd+200%\u7684\u5e72\u51c0\u97f3\u91cf\u3002\u6ca1\u6709\u5931\u771f\uff0c\u6ca1\u6709\u5e95\u566a\uff0c\u53ea\u6709\u4f60\u672c\u8be5\u542c\u5230\u7684\u7ec6\u8282\u3002\u542c\u64ad\u5ba2\u65f6\u5bf9\u8bdd\u6e05\u6670\u5f97\u5413\u4eba\uff0c\u542c\u97f3\u4e50\u65f6\u9f13\u70b9\u7838\u8fdb\u80f8\u53e3\u3002",
