{
  "subject": "37 \u0434\u043d\u0435\u0439 \u2014 \u0438 3 \u043c\u0438\u043d\u0443\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u0435\u043d\u044f\u044e\u0442 \u0432\u0441\u0451",
  "preview_text": "\u0422\u044b \u0443\u0436\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435. \u041e\u043d\u043e \u0442\u0438\u0445\u043e \u043b\u0435\u0436\u0438\u0442 \u0432 \u043f\u0430\u043f\u043a\u0435. \u041d\u043e \u0435\u0441\u043b\u0438 \u043d\u0435 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u044d\u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441...",
  "body_paragraphs": [
    "\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044c \u0441\u0435\u043c\u044c \u0434\u043d\u0435\u0439 \u043d\u0430\u0437\u0430\u0434 \u0442\u044b \u0441\u043a\u0430\u0447\u0430\u043b Volume Booster Pro. \u0421\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u043e\u0442\u043a\u0440\u044b\u043b \u0440\u0430\u0437, \u043f\u043e\u043a\u0440\u0443\u0442\u0438\u043b \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a \u0438 \u0437\u0430\u0431\u044b\u043b. \u042f \u043d\u0435 \u043e\u0441\u0443\u0436\u0434\u0430\u044e. \u0423\u0442\u0438\u043b\u0438\u0442\u044b \u2014 \u043e\u043d\u0438 \u0442\u0430\u043a\u0438\u0435. \u0420\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u0432 \u0444\u043e\u043d\u0435, \u043f\u043e\u043a\u0430 \u043d\u0435 \u043f\u043e\u043d\u0430\u0434\u043e\u0431\u044f\u0442\u0441\u044f. \u041d\u043e \u0435\u0441\u0442\u044c \u043e\u0434\u0438\u043d \u043d\u044e\u0430\u043d\u0441: \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c, \u043d\u0443\u0436\u043d\u043e \u0440\u043e\u0432\u043d\u043e \u0442\u0440\u0438 \u043c\u0438\u043d\u0443\u0442\u044b \u0432 \u0434\u0435\u043d\u044c.",
    "\u0412\u043e\u0442 \u043a\u0430\u043a \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0434\u0435\u043b\u0430\u0435\u0442 \u0431\u0443\u0441\u0442\u0435\u0440 \u0432 10 \u0440\u0430\u0437 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0435\u0435: \u043a\u0430\u0436\u0434\u044b\u0439 \u0432\u0435\u0447\u0435\u0440, \u043f\u0435\u0440\u0435\u0434 \u0442\u0435\u043c \u043a\u0430\u043a \u0432\u043e\u0442\u043a\u043d\u0443\u0442\u044c \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438, \u043e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435. \u041d\u0435 \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u0447\u0442\u043e-\u0442\u043e \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044c \u2014 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u044c, \u0447\u0442\u043e \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a \u043d\u0430 200%. \u0418 \u043d\u0430\u0436\u043c\u0438 \u00ab\u0410\u0432\u0442\u043e\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435\u00bb. \u042d\u0442\u043e \u0432\u0441\u0451. \u0417\u0430\u043d\u0438\u043c\u0430\u0435\u0442 \u043c\u0435\u043d\u044c\u0448\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0447\u0435\u043c \u0437\u0430\u0432\u0430\u0440\u0438\u0442\u044c \u0447\u0430\u0439.",
    "\u0427\u0435\u0440\u0435\u0437 \u043d\u0435\u0434\u0435\u043b\u044e \u0442\u044b \u0437\u0430\u043c\u0435\u0442\u0438\u0448\u044c: \u0437\u0432\u0443\u043a \u0432\u0435\u0437\u0434\u0435 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u043e \u043c\u043e\u0449\u043d\u044b\u0439 \u2014 \u0432 \u043f\u043e\u0434\u043a\u0430\u0441\u0442\u0435, \u0432 \u0438\u0433\u0440\u0435, \u0432 \u043a\u043b\u0438\u043f\u0435 \u043d\u0430 YouTube. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 \u0441\u043a\u0430\u0447\u043a\u043e\u0432 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438, \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u044b\u0445 \u0442\u0438\u0448\u0438\u043d. \u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0441\u0432\u043e\u0451 \u0434\u0435\u043b\u043e, \u0430 \u0442\u044b \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u0451\u0448\u044c \u0434\u0443\u043c\u0430\u0442\u044c \u043e \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438 \u0432\u043e\u043e\u0431\u0449\u0435. \u042d\u0442\u043e \u0438 \u0435\u0441\u0442\u044c \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u0438\u0437\u043c: \u043d\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0440\u0430\u0434\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438, \u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u043b\u0438\u0448\u043d\u0438\u0435 \u0448\u0430\u0433\u0438.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Volume Booster Pro \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u0423\u0431\u0435\u0434\u0438\u0441\u044c, \u0447\u0442\u043e \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a \u043d\u0430 200% \u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e \u0430\u0432\u0442\u043e\u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435. \u0422\u0440\u0438 \u043c\u0438\u043d\u0443\u0442\u044b \u2014 \u0438 \u0437\u0430\u0431\u044b\u043b.\n\nP.S. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 \u0437\u0430\u043a\u0440\u0435\u043f\u0438\u043b\u0430\u0441\u044c \u0431\u044b\u0441\u0442\u0440\u0435\u0435, \u0432\u043a\u043b\u044e\u0447\u0438 Premium \u043d\u0430 \u043d\u0435\u0434\u0435\u043b\u044e. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439, \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0439 \u2014 \u043f\u0440\u043e\u0441\u0442\u043e \u0447\u0438\u0441\u0442\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430. \u0422\u044b \u0434\u0430\u0436\u0435 \u043d\u0435 \u0437\u0430\u043c\u0435\u0442\u0438\u0448\u044c, \u043a\u0430\u043a \u043d\u0430\u0447\u043d\u0451\u0448\u044c \u0434\u0435\u043b\u0430\u0442\u044c \u044d\u0442\u043e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438."
