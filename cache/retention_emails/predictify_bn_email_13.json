{
  "subject": "\u098f\u0995 \u09ae\u09be\u09b8\u09c7 \u0986\u09aa\u09a8\u09bf \u09af\u09be \u0995\u09b0\u09b2\u09c7\u09a8, \u09a4\u09be \u09ac\u09bf\u09b6\u09cd\u09ac\u09be\u09b8 \u09b9\u09ac\u09c7 \u09a8\u09be",
  "preview_text": "\u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09c7\u099f\u09be \u09ac\u09b2\u099b\u09c7 \u0986\u09aa\u09a8\u09bf \u098f\u0995\u099c\u09a8 \u09ad\u09bf\u09a8\u09cd\u09a8 \u09b8\u09cd\u09a4\u09b0\u09c7\u09b0 \u09ab\u09c1\u099f\u09ac\u09b2 \u09ab\u09cd\u09af\u09be\u09a8\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u0997\u09cd\u09b0\u0997\u09a4\u09bf \u09a6\u09c7\u0996\u09c7 \u0986\u09ae\u09bf \u09b9\u09a4\u09ac\u09be\u0995\u0964 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09ac\u09be\u09b0\u09cd\u09a4\u09be \u09aa\u09a1\u09bc\u09c1\u09a8\u0964",
  "body_paragraphs": [
    "\u098f\u0995 \u09ae\u09be\u09b8 \u0986\u0997\u09c7 \u0986\u09aa\u09a8\u09bf Predictify \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09c7\u099b\u09bf\u09b2\u09c7\u09a8\u0964 \u0986\u09ae\u09bf \u09ad\u09c7\u09ac\u09c7\u099b\u09bf\u09b2\u09be\u09ae \u09b9\u09af\u09bc\u09a4\u09cb \u0986\u09aa\u09a8\u09bf \u098f\u0995\u09ac\u09be\u09b0 \u09a6\u09c7\u0996\u09c7 \u099a\u09b2\u09c7 \u09af\u09be\u09ac\u09c7\u09a8\u0964 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09c7\u099f\u09be \u0986\u09ae\u09be\u0995\u09c7 \u09ad\u09c1\u09b2 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3 \u0995\u09b0\u09c7\u099b\u09c7\u0964 \u0986\u09aa\u09a8\u09bf \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09bf\u09a8 \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u099a\u09c7\u0995 \u0995\u09b0\u09c7\u099b\u09c7\u09a8, \u0995\u09c1\u0987\u099c \u0996\u09c7\u09b2\u09c7\u099b\u09c7\u09a8, \u0995\u09ae\u09bf\u0989\u09a8\u09bf\u099f\u09bf\u09a4\u09c7 \u09ad\u09cb\u099f \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09c7\u09a8\u0964 \u099c\u09be\u09a8\u09c7\u09a8 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u0995\u09cb\u09b0 \u0995\u09a4? \u098f\u099f\u09bf \u0997\u09a1\u09bc \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0 \u099a\u09c7\u09af\u09bc\u09c7 \u09ea\u09e6% \u09ac\u09c7\u09b6\u09bf\u0964",
    "\u0986\u09aa\u09a8\u09bf \u09ac\u09c1\u099d\u09a4\u09c7 \u09aa\u09be\u09b0\u099b\u09c7\u09a8 \u09a8\u09be, \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u09aa\u09a8\u09bf \u0987\u09a4\u09bf\u09ae\u09a7\u09cd\u09af\u09c7\u0987 \u0985\u09ad\u09cd\u09af\u09be\u09b8\u09c7 \u09aa\u09b0\u09bf\u09a3\u09a4 \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u09a8\u0964 \u0986\u09aa\u09a8\u09bf \u09af\u0996\u09a8 AI-\u098f\u09b0 \u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u09b8\u09cd\u0995\u09cb\u09b0 \u09a6\u09c7\u0996\u09c7\u09a8, \u09a4\u0996\u09a8 \u0986\u09aa\u09a8\u09be\u09b0 \u0997\u09be\u099f \u09ab\u09bf\u09b2\u09bf\u0982 \u0986\u09b0 \u09a6\u09b0\u0995\u09be\u09b0 \u09b9\u09af\u09bc \u09a8\u09be\u0964 \u0986\u09aa\u09a8\u09bf \u09a1\u09c7\u099f\u09be \u09a6\u09bf\u09af\u09bc\u09c7 \u09a8\u09bf\u099c\u09c7\u09b0 \u09ab\u09c1\u099f\u09ac\u09b2 \u0986\u0987\u0995\u09bf\u0989 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3 \u0995\u09b0\u099b\u09c7\u09a8\u0964 \u098f\u09ac\u0982 \u09b8\u09c7\u099f\u09be\u0987 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0986\u09b2\u09be\u09a6\u09be \u0995\u09b0\u09c7\u0964",
    "\u0986\u09aa\u09a8\u09be\u09b0 \u098f\u0987 \u09af\u09be\u09a4\u09cd\u09b0\u09be\u09af\u09bc \u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u09ae\u099c\u09be\u09b0 \u09ac\u09bf\u09b7\u09af\u09bc \u09b9\u09b2\u09cb\u2014\u0986\u09aa\u09a8\u09bf \u098f\u0996\u09a8\u09cb \u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09af\u09bc\u09be\u09ae \u099f\u09cd\u09b0\u09be\u09af\u09bc\u09be\u09b2 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c7\u09a8\u09a8\u09bf\u0964 \u09ad\u09be\u09ac\u09c1\u09a8, \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09bf \u0986\u09a8\u09b2\u09bf\u09ae\u09bf\u099f\u09c7\u09a1 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u098f\u09ac\u0982 \u0985\u09cd\u09af\u09be\u09a1\u09ad\u09be\u09a8\u09cd\u09b8\u09a1 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u099f\u09b8 \u09aa\u09c7\u09a4\u09c7\u09a8? \u0986\u09aa\u09a8\u09be\u09b0 \u0987\u09a4\u09bf\u09ae\u09a7\u09cd\u09af\u09c7\u0987 \u09af\u09c7 \u09ae\u09cb\u09ae\u09c7\u09a8\u09cd\u099f\u09be\u09ae \u0986\u099b\u09c7, \u09a4\u09be \u09a6\u09bf\u09af\u09bc\u09c7 \u0986\u09aa\u09a8\u09bf \u0986\u09b0\u0993 \u09a6\u09cd\u09b0\u09c1\u09a4 \u09b2\u09bf\u09a1\u09be\u09b0\u09ac\u09cb\u09b0\u09cd\u09a1\u09c7 \u0989\u09a0\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8\u0964",
    "\u0986\u099c\u0995\u09c7\u09b0 \u0995\u09be\u099c: \u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 '\u09ae\u09be\u0987\u09b2\u09b8\u09cd\u099f\u09cb\u09a8' \u09b8\u09c7\u0995\u09b6\u09a8\u09c7 \u09af\u09be\u09a8\u0964 \u09a6\u09c7\u0996\u09c1\u09a8 \u0995\u09a4\u0997\u09c1\u09b2\u09cb \u09ac\u09cd\u09af\u09be\u099c \u0986\u09aa\u09a8\u09bf \u099c\u09bf\u09a4\u09c7\u099b\u09c7\u09a8 \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u0995 \u0995\u09a4\u09a6\u09bf\u09a8 \u09a7\u09b0\u09c7 \u0986\u099b\u09c7\u0964 \u09a4\u09be\u09b0\u09aa\u09b0 AI \u099a\u09cd\u09af\u09be\u099f\u09c7 \u0997\u09bf\u09af\u09bc\u09c7 \u099c\u09bf\u099c\u09cd\u099e\u09be\u09b8\u09be \u0995\u09b0\u09c1\u09a8\u2014\u0986\u0997\u09be\u09ae\u09c0 \u09b8\u09aa\u09cd\u09a4\u09be\u09b9\u09c7\u09b0 \u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u09ad\u09c1\u09b2 \u09ac\u09cb\u099d\u09be\u09a8\u09cb \u09ae\u09cd\u09af\u09be\u099a \u0995\u09cb\u09a8\u099f\u09bf? \u09aa\u09bf.\u098f\u09b8. \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u0995 \u09af\u09a6\u09bf \u09ed \u09a6\u09bf\u09a8\u09c7\u09b0 \u09ac\u09c7\u09b6\u09bf \u09b9\u09af\u09bc, \u09a4\u09be\u09b9\u09b2\u09c7 \u0986\u09aa\u09a8\u09bf \u09ab\u09cd\u09b0\u09bf \u0995\u09cd\u09b0\u09c7\u09a1\u09bf\u099f \u09aa\u09be\u0993\u09af\u09bc\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09a4\u09c8\u09b0\u09bf\u0964 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09b8\u09c7\u099f\u09be \u099c\u09be\u09a8\u09a4\u09c7 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09a4\u09c7\u0987 \u09b9\u09ac\u09c7\u0964"
  ],
