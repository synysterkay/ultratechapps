{
  "subject": "\u0422\u0432\u043e\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u0434\u043e \u0438 \u043f\u043e\u0441\u043b\u0435 \u2014 53 \u0434\u043d\u044f \u0440\u0430\u0437\u043d\u0438\u0446\u044b",
  "preview_text": "\u041f\u043e\u043c\u043d\u0438\u0448\u044c, \u043a\u0430\u043a \u0442\u044b \u0433\u0430\u0434\u0430\u043b \u043d\u0430 \u043a\u043e\u0444\u0435\u0439\u043d\u043e\u0439 \u0433\u0443\u0449\u0435? \u0412\u043e\u0442 \u0447\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e\u0441\u044c.",
  "body_paragraphs": [
    "53 \u0434\u043d\u044f \u043d\u0430\u0437\u0430\u0434 \u0442\u044b \u0441\u043a\u0430\u0447\u0430\u043b Predictify. \u0422\u043e\u0433\u0434\u0430 \u0442\u044b \u0441\u0442\u0430\u0432\u0438\u043b \u043d\u0430 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0438, \u0441\u043c\u043e\u0442\u0440\u0435\u043b \u043d\u0430 \u0444\u043e\u0440\u043c\u0443 \u043a\u043e\u043c\u0430\u043d\u0434 \u0438 \u043d\u0430\u0434\u0435\u044f\u043b\u0441\u044f \u043d\u0430 \u043b\u0443\u0447\u0448\u0435\u0435. \u042f \u0437\u043d\u0430\u044e, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0441\u0430\u043c \u0442\u0430\u043a \u0434\u0435\u043b\u0430\u043b. \u0418 \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0432\u0430\u043b. \u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e.",
    "\u0410 \u0442\u0435\u043f\u0435\u0440\u044c? \u0422\u044b \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0448\u044c \u043c\u0430\u0442\u0447 \u0438 \u0432\u0438\u0434\u0438\u0448\u044c \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u0447\u0435\u0442, \u0430 xG, \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u0435, \u0441\u0438\u043b\u0443 \u0430\u0442\u0430\u043a\u0438 \u0438 \u043e\u0431\u043e\u0440\u043e\u043d\u044b. \u0422\u044b \u0437\u043d\u0430\u0435\u0448\u044c, \u0447\u0442\u043e AI \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b \u0442\u044b\u0441\u044f\u0447\u0438 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0438 \u0434\u0430\u043b 78% \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u0438. \u0422\u044b \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0433\u0430\u0434\u0430\u0435\u0448\u044c \u2014 \u0442\u044b \u0437\u043d\u0430\u0435\u0448\u044c. \u0420\u0430\u0437\u043d\u0438\u0446\u0430 \u043c\u0435\u0436\u0434\u0443 '\u043d\u0430\u0434\u0435\u044e\u0441\u044c, \u043e\u043d\u0438 \u0437\u0430\u0431\u044c\u044e\u0442' \u0438 '\u043e\u043d\u0438 \u0437\u0430\u0431\u044c\u044e\u0442, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0438\u0445 xG \u0432\u044b\u0448\u0435 \u043d\u0430 0.4' \u2014 \u044d\u0442\u043e \u043f\u0440\u043e\u043f\u0430\u0441\u0442\u044c.",
    "\u0412\u043e\u0442 \u0447\u0442\u043e \u0434\u0430\u0435\u0442 Predictify: \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0435 \u0446\u0438\u0444\u0440\u044b \u043f\u043e \u043a\u0430\u0436\u0434\u043e\u043c\u0443 \u043c\u0430\u0442\u0447\u0443. \u0422\u044b \u0432\u0438\u0434\u0438\u0448\u044c, \u0447\u0442\u043e \u0443 '\u0420\u0435\u0430\u043b\u0430' 2.1 xG \u043f\u0440\u043e\u0442\u0438\u0432 1.2 \u0443 \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430, \u0438 \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0448\u044c, \u043f\u043e\u0447\u0435\u043c\u0443 \u0441\u0442\u0430\u0432\u043a\u0430 \u043d\u0430 \u0442\u043e\u0442\u0430\u043b \u0431\u043e\u043b\u044c\u0448\u0435 2.5 \u2014 \u044d\u0442\u043e \u043d\u0435 \u043b\u043e\u0442\u0435\u0440\u0435\u044f. AI Chat \u043e\u0442\u0432\u0435\u0442\u0438\u0442 \u043d\u0430 \u043b\u044e\u0431\u043e\u0439 \u0432\u043e\u043f\u0440\u043e\u0441 \u0437\u0430 \u0441\u0435\u043a\u0443\u043d\u0434\u0443: '\u041a\u0430\u043a\u043e\u0432\u0430 \u0444\u043e\u0440\u043c\u0430 \u0411\u0435\u043d\u0437\u0435\u043c\u0430 \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445 5 \u043c\u0430\u0442\u0447\u0430\u0445?' \u2014 \u0438 \u0442\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0448\u044c \u0434\u0430\u043d\u043d\u044b\u0435, \u0430 \u043d\u0435 \u043c\u043d\u0435\u043d\u0438\u0435.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u0417\u0430\u0439\u0434\u0438 \u0432 \u0440\u0430\u0437\u0434\u0435\u043b '\u041f\u0440\u043e\u0433\u043d\u043e\u0437\u044b \u043d\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f' \u0438 \u0441\u0440\u0430\u0432\u043d\u0438 \u0441\u0432\u043e\u0439 \u0441\u0442\u0430\u0440\u044b\u0439 \u043c\u0435\u0442\u043e\u0434 \u0441 \u0442\u0435\u043c, \u0447\u0442\u043e \u0432\u0438\u0434\u0438\u0448\u044c. P.S. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u0433\u043b\u0443\u0431\u0436\u0435 \u2014 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 Premium \u043d\u0430 3 \u0434\u043d\u044f \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e. \u0423\u0432\u0438\u0434\u0438\u0448\u044c \u0432\u0441\u0435 \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u0442\u044b\u0435 \u0441\u0442\u0430\u0442\u044b \u0438 confidence scores. \u042d\u0442\u043e \u043a\u0430\u043a \u043f\u0435\u0440\u0435\u0439\u0442\u0438 \u0441 \u0447\u0435\u0440\u043d\u043e-\u0431\u0435\u043b\u043e\u0433\u043e \u0442\u0435\u043b\u0435\u0432\u0438\u0437\u043e\u0440\u0430 \u043d\u0430 4K."
