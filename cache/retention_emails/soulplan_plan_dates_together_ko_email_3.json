{
  "subject": "\uc624\ub298 \ubc24 30\ucd08\uba74 \ubc14\ub00c\ub294 \ub370\uc774\ud2b8",
  "preview_text": "\ud30c\ud2b8\ub108\uac00 \ub208\uce58\ucc44\uc9c0 \ubabb\ud558\uac8c \ud558\ub294 \uc791\uc740 \ud2b8\ub9ad \ud558\ub098. \uc624\ub298 \ubc14\ub85c \ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\ub370\uc774\ud2b8 \uacc4\ud68d \uc138\uc6b0\ub290\ub77c \uc9c0\uce5c \uc801 \uc788\ub098\uc694? \uc6b0\ub9ac\ub294 \uc790\uc8fc '\uc5b4\ub514 \uac08\uae4c' \uace0\ubbfc\uc5d0 20\ubd84 \uc774\uc0c1 \uc368\uc694. \uadf8\ub7f0\ub370 \ud55c \uac00\uc9c0 \uc791\uc740 \ud2b8\ub9ad\uc774\uba74 \uadf8 \uc2dc\uac04\uc774 30\ucd08\ub85c \uc904\uc5b4\ub4ed\ub2c8\ub2e4. \uc624\ub298 \ubc24, \ud30c\ud2b8\ub108\uac00 '\uc5b4\ub5bb\uac8c \uc54c\uc558\uc5b4?'\ub77c\uace0 \ubb3c\uc744 \uc900\ube44\ub97c \ud574\ubcf4\uc138\uc694.",
    "\ube44\ubc00\uc740 '\ubb34\ub4dc' \ud558\ub098 \uace0\ub974\ub294 \uac70\uc608\uc694. \uc544\ub291\ud55c, \ubaa8\ud5d8\uc801\uc778, \uc7a5\ub09c\uae30 \uc788\ub294, \uce58\uc720\uc758 \u2014 \ub124 \uac00\uc9c0 \uc911 \ud558\ub098 \uc120\ud0dd\ud558\uba74 \ub05d\uc785\ub2c8\ub2e4. \ub9c8\uce58 \ud30c\ud2b8\ub108\uc758 \ub9c8\uc74c\uc744 \uc77d\uc740 \ub4ef\ud55c \ub370\uc774\ud2b8\uac00 \uc790\ub3d9\uc73c\ub85c \ub5a0\uc694. \uc5f0\uad6c\uc5d0 \ub530\ub974\uba74 \uc774 \uae30\ub2a5\uc744 \uccab 24\uc2dc\uac04 \ub0b4 \uc0ac\uc6a9\ud55c \ucee4\ud50c\ub4e4\uc740 \ud55c \ub2ec \ub3d9\uc548 \ub370\uc774\ud2b8 \ud69f\uc218\uac00 4\ubc30 \uc99d\uac00\ud569\ub2c8\ub2e4.",
    "\uc774\uac8c \ubc14\ub85c SoulPlan\uc758 '\uc624\ub298 \ubc24\uc758 \ub370\uc774\ud2b8' \uae30\ub2a5\uc785\ub2c8\ub2e4. \uc571 \ud648 \ud654\uba74\uc5d0 \ub531 \ud55c \uc7a5\uc758 \uce74\ub4dc\uac00 \ub098\ud0c0\ub098\uace0, \ubb34\ub4dc\ub97c \ud0ed\ud558\uba74 \ubaa8\ub4e0 \uacc4\ud68d\uc774 \uc644\uc131\ub429\ub2c8\ub2e4. \ud30c\ud2b8\ub108\uac00 \uc81c\uc548\uc744 \ubc1b\uc73c\uba74 '\uc624\ub298 \ub108\ub97c \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \ud480\uc2a4\ud06c\ub9b0 \uc21c\uac04\uc774 \ud3bc\uccd0\uc838\uc694. \uc11c\ub85c\uc5d0\uac8c \uc791\uc740 \uc11c\ud504\ub77c\uc774\uc988\ub97c \uc120\ubb3c\ud558\ub294 \uac70\uc8e0.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0 '\uc624\ub298 \ubc24\uc758 \ub370\uc774\ud2b8'\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694. 30\ucd08\uba74 \ub429\ub2c8\ub2e4. P.S. \ub0b4\uc77c \uc544\uce68\uc5d0 \ud30c\ud2b8\ub108\uac00 '\uc5b4\uc81c \uc815\ub9d0 \uc88b\uc558\uc5b4'\ub77c\uace0 \ub9d0\ud560 \uac70\uc608\uc694 \u2014 \uadf8 \uc21c\uac04\uc744 \uc0c1\uc0c1\ud574\ubcf4\uc138\uc694."
  ],
