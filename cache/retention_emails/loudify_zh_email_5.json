  "subject": "\u51cc\u66682\u70b9\u7684Bug\uff0c\u6539\u53d8\u4e86\u4e00\u5207",
  "preview_text": "\u90a3\u5929\u51cc\u66682\u70b9\uff0c\u6211\u76ef\u7740\u7535\u8111\u5c4f\u5e55\uff0c\u4e00\u4e2a\u610f\u5916\u7684Bug\u8ba9\u6211\u91cd\u65b0\u5b9a\u4e49\u4e86Loudify\u3002\u60f3\u77e5\u9053\u8fd9\u4e2a\u6545\u4e8b\u5417\uff1f",
  "body_paragraphs": [
    "\u51cc\u66682\u70b9\uff0c\u6211\u5750\u5728\u6c99\u53d1\u4e0a\uff0c\u8033\u6735\u91cc\u585e\u7740\u8033\u673a\uff0c\u76ef\u7740\u5c4f\u5e55\u4e0a\u7684\u4ee3\u7801\u3002\u4e00\u4e2aBug\u8ba9\u97f3\u91cf\u7a81\u7136\u98d9\u5347\u4e86200%\uff0c\u4f46\u6211\u6ca1\u89c9\u5f97\u523a\u8033\u2014\u2014\u53cd\u800c\u542c\u5230\u4e86\u4e00\u76f4\u88ab\u63a9\u57cb\u7684\u7ec6\u8282\u3002\u90a3\u4e00\u523b\uff0c\u6211\u610f\u8bc6\u5230\u6211\u4eec\u641e\u9519\u4e86\u4e00\u4ef6\u4e8b\uff1a\u97f3\u91cf\u4e0d\u662f\u654c\u4eba\uff0c\u5931\u771f\u624d\u662f\u3002",
    "\u90a3\u4e2aBug\u6210\u4e86Loudify\u7684\u6838\u5fc3\uff1a+200%\u97f3\u91cf\uff0c\u4f46\u7edd\u4e0d\u7c97\u66b4\u3002\u56e0\u4e3a\u771f\u6b63\u7684\u597d\u58f0\u97f3\u4e0d\u662f\u9707\u8033\u6b32\u804b\uff0c\u800c\u662f\u8ba9\u4f60\u542c\u89c1\u6bcf\u4e2a\u5b57\u3001\u6bcf\u6bb5\u65cb\u5f8b\uff0c\u54ea\u6015\u5728\u5608\u6742\u7684\u5730\u94c1\u6216\u6d17\u7897\u673a\u8f70\u9e23\u4e2d\u3002\u6211\u82b1\u4e86\u4e09\u4e2a\u6708\u91cd\u5199\u5f15\u64ce\uff0c\u786e\u4fdd\u5b83\u53ea\u5728\u4f60\u9700\u8981\u7684\u5730\u65b9\u53d1\u529b\u3002",
    "\u73b0\u5728\uff0c\u5f53\u4f60\u6253\u5f00Loudify\uff0c\u4f60\u4f1a\u770b\u52304\u4e2a\u97f3\u9891\u914d\u7f6e\uff08\u97f3\u4e50\u3001\u7535\u5f71\u3001\u64ad\u5ba2\u3001\u6e38\u620f\uff09\u548c10\u6bb5\u5747\u8861\u5668\u3002\u4f46\u771f\u6b63\u9177\u7684\u662fAutoEQ\u2014\u2014\u5b83\u8bb0\u4f4f\u4f60\u7684\u8033\u673a\u578b\u53f7\uff0c\u6bcf\u6b21\u8fde\u63a5\u81ea\u52a8\u8c03\u97f3\u3002\u4e0d\u518d\u662f\u901a\u7528\u9884\u8bbe\uff0c\u800c\u662f\u4e3a\u4f60\u8033\u6735\u5b9a\u5236\u7684\u58f0\u573a\u3002\u4e0a\u5468\u672b\uff0c\u6211\u5728\u5730\u94c1\u4e0a\u7528\u64ad\u5ba2\u6a21\u5f0f\u542c\u300a\u4e09\u4f53\u300b\uff0c\u8fde\u5218\u6148\u6b23\u7684\u547c\u5438\u58f0\u90fd\u6e05\u6670\u53ef\u95fb\u3002",
