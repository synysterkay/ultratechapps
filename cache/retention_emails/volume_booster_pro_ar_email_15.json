{
  "subject": "\u062a\u0648\u0641\u064a\u0631 18 \u062f\u0642\u064a\u0642\u0629 \u0643\u0644 \u0635\u0628\u0627\u062d \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 Volume Booster Pro",
  "preview_text": "\u0627\u0643\u062a\u0634\u0641 \u0643\u064a\u0641 \u064a\u0648\u0641\u0631 \u0644\u0643 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u062e\u0628\u0631\u0627\u0621 18 \u062f\u0642\u064a\u0642\u0629 \u064a\u0648\u0645\u064a\u0627\u064b \u0628\u0636\u063a\u0637\u0629 \u0632\u0631 \u0648\u0627\u062d\u062f\u0629.",
  "body_paragraphs": [
    "\u0623\u062a\u0630\u0643\u0631 \u0642\u0628\u0644 \u0634\u0647\u0631\u060c \u0643\u0646\u062a \u0623\u0636\u0628\u0637 \u0627\u0644\u0635\u0648\u062a \u0641\u064a \u0643\u0644 \u062a\u0637\u0628\u064a\u0642 \u0639\u0644\u0649 \u062d\u062f\u0629: \u064a\u0648\u062a\u064a\u0648\u0628\u060c \u0628\u0648\u062f\u0643\u0627\u0633\u062a\u060c \u0633\u0628\u0648\u062a\u064a\u0641\u0627\u064a. 20 \u062f\u0642\u064a\u0642\u0629 \u0643\u0644 \u0635\u0628\u0627\u062d \u0636\u0627\u0626\u0639\u0629 \u0641\u064a \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0634\u0631\u064a\u0637 \u0627\u0644\u0635\u0648\u062a.",
    "\u0627\u0644\u064a\u0648\u0645\u060c \u0623\u0646\u0627 \u0623\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u064a \u0627\u0644\u0623\u0633\u0628\u0648\u0639. \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u064a\u062a\u0630\u0643\u0631. \u064a\u062a\u0635\u0644 \u0628\u0633\u0645\u0627\u0639\u0627\u062a\u064a \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b\u060c \u064a\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a 200% \u062f\u0648\u0646 \u0625\u0639\u0644\u0627\u0646\u060c \u062b\u0645 \u064a\u062e\u062a\u0641\u064a.",
    "\u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u064a \u0623\u062d\u062f\u062b\u062a \u0627\u0644\u0641\u0627\u0631\u0642: '\u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0639\u0646\u062f \u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a'. \u0628\u0645\u062c\u0631\u062f \u062a\u0641\u0639\u064a\u0644\u0647\u0627 \u0641\u064a \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u060c \u0644\u0646 \u062a\u062d\u062a\u0627\u062c \u0644\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649. 2 \u062f\u0642\u064a\u0642\u0629 \u0625\u0639\u062f\u0627\u062f \u0645\u0642\u0627\u0628\u0644 20 \u062f\u0642\u064a\u0642\u0629 \u064a\u0648\u0645\u064a\u0627\u064b.",
    "\u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646: \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u060c \u0641\u0639\u0651\u0644 '\u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0639\u0646\u062f \u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a'. \u0633\u062a\u0634\u0643\u0631\u0646\u064a \u0644\u0627\u062d\u0642\u0627\u064b. \u0645\u0644\u0627\u062d\u0638\u0629: \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0645\u0645\u064a\u0632\u064a\u0646 \u064a\u0648\u0641\u0631\u0648\u0646 80 \u0633\u0627\u0639\u0629 \u0633\u0646\u0648\u064a\u0627\u064b \u0628\u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629."
  ],
