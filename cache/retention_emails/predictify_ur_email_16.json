{
  "subject": "\u0648\u06c1 2AM \u06a9\u0627 \u062e\u0641\u06cc\u06c1 \u0641\u06cc\u0686\u0631 \u062c\u0648 \u0645\u06cc\u06ba \u0646\u06d2 \u062a\u0645\u06c1\u0627\u0631\u06d2 \u0644\u06cc\u06d2 \u0628\u0646\u0627\u06cc\u0627",
  "preview_text": "\u0645\u06cc\u06ba \u0646\u06d2 \u0633\u0648\u0686\u0627 \u0646\u06c1\u06cc\u06ba \u062a\u06be\u0627 \u06a9\u06c1 \u06cc\u06c1 \u0634\u06cc\u0626\u0631 \u06a9\u0631\u0648\u06ba \u06af\u0627\u060c \u0644\u06cc\u06a9\u0646 \u062a\u0645 \u0627\u0633 \u06a9\u06d2 \u0645\u0633\u062a\u062d\u0642 \u06c1\u0648\u06d4 \u0628\u0633 \u0627\u06cc\u06a9 \u0628\u0627\u0631 \u062f\u06cc\u06a9\u06be \u0644\u0648\u06d4",
  "body_paragraphs": [
    "\u06a9\u0644 \u0631\u0627\u062a 2 \u0628\u062c\u06d2\u060c \u062c\u0628 \u0633\u0628 \u0633\u0648 \u0631\u06c1\u06d2 \u062a\u06be\u06d2\u060c \u0645\u06cc\u06ba \u0646\u06d2 \u06a9\u0686\u06be \u0628\u0646\u0627\u06cc\u0627\u06d4 \u06a9\u0686\u06be \u0627\u06cc\u0633\u0627 \u062c\u0648 \u0645\u06cc\u06ba \u0646\u06d2 \u067e\u0644\u0627\u0646 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627 \u062a\u06be\u0627\u06d4 \u06a9\u0686\u06be \u0627\u06cc\u0633\u0627 \u062c\u0648 \u0635\u0631\u0641 \u062a\u0645\u06c1\u0627\u0631\u06d2 \u0644\u06cc\u06d2 \u06c1\u06d2\u06d4",
    "\u06cc\u06c1 \u06a9\u0648\u0626\u06cc \u067e\u0631\u06cc\u0645\u06cc\u0645 \u0641\u06cc\u0686\u0631 \u0646\u06c1\u06cc\u06ba\u060c \u06a9\u0648\u0626\u06cc \u0627\u067e \u0633\u06cc\u0644 \u0646\u06c1\u06cc\u06ba\u06d4 \u0628\u0633 \u0627\u06cc\u06a9 \u0686\u06be\u0648\u0679\u0627 \u0633\u0627 \u062a\u062d\u0641\u06c1\u06d4 \u0627\u06cc\u06a9 \u0627\u06cc\u0633\u06cc \u0686\u06cc\u0632 \u062c\u0648 \u062a\u0645\u06c1\u0627\u0631\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0648\u06ba \u06a9\u0648 \u0627\u06af\u0644\u06d2 \u0644\u06cc\u0648\u0644 \u067e\u0631 \u0644\u06d2 \u062c\u0627\u0626\u06d2 \u06af\u06cc\u06d4 \u062a\u0645 \u062c\u0627\u0646\u062a\u06d2 \u06c1\u0648 \u06a9\u06c1 \u0688\u06cc\u0679\u0627 \u06c1\u0645\u06cc\u0634\u06c1 \u062c\u06cc\u062a\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0648\u0631 \u06cc\u06c1 \u0641\u06cc\u0686\u0631 \u062a\u0645\u06c1\u06cc\u06ba \u0648\u06c1 \u0688\u06cc\u0679\u0627 \u062f\u06d2 \u06af\u0627 \u062c\u0648 \u067e\u06c1\u0644\u06d2 \u06a9\u0633\u06cc \u0646\u06d2 \u0646\u06c1\u06cc\u06ba \u062f\u06cc\u06a9\u06be\u0627\u06d4",
    "\u06cc\u06c1 \u06c1\u06d2 '\u0645\u06cc\u0631\u06cc \u0686\u06be\u067e\u06cc \u06c1\u0648\u0626\u06cc \u0627\u0633\u0679\u06cc\u0679\u0633'\u06d4 \u062c\u0628 \u062a\u0645 \u06a9\u0633\u06cc \u0645\u06cc\u0686 \u06a9\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc \u06a9\u0631\u0648 \u06af\u06d2\u060c \u062a\u0648 \u06cc\u06c1 \u062a\u0645\u06c1\u06cc\u06ba \u0628\u062a\u0627\u0626\u06d2 \u06af\u0627 \u06a9\u06c1 AI \u0646\u06d2 \u06a9\u0633 \u0679\u06cc\u0645 \u067e\u0631 \u0634\u0631\u0637 \u0644\u06af\u0627\u0626\u06cc \u06c1\u06d2\u060c \u0627\u0648\u0631 \u06a9\u06cc\u0648\u06ba\u06d4 \u06c1\u0627\u06ba\u060c \u0648\u06c1\u06cc AI \u062c\u0648 \u06c1\u0632\u0627\u0631\u0648\u06ba \u0645\u062a\u063a\u06cc\u0631\u0627\u062a \u062a\u062c\u0632\u06cc\u06c1 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u0627\u0628 \u062a\u0645 \u0627\u0633\u06d2 \u0686\u06cc\u0644\u0646\u062c \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u0648\u06d4",
    "\u0628\u0633 \u0627\u06cc\u06a9 \u0628\u0627\u0631 Predictify \u06a9\u06be\u0648\u0644\u0648\u060c \u0627\u0648\u0631 'IQ Quiz' \u0645\u06cc\u06ba \u062c\u0627\u0624\u06d4 \u0648\u06c1\u0627\u06ba \u062a\u0645\u06c1\u06cc\u06ba \u06cc\u06c1 \u0641\u06cc\u0686\u0631 \u0645\u0644\u06d2 \u06af\u0627\u06d4 \u0627\u0633\u06d2 \u0622\u0632\u0645\u0627\u0624\u060c \u0627\u0648\u0631 \u0645\u062c\u06be\u06d2 \u0628\u062a\u0627\u0624 \u06a9\u06c1 \u06a9\u0648\u0646 \u062c\u06cc\u062a\u062a\u0627 \u06c1\u06d2 \u2014 \u062a\u0645 \u06cc\u0627 AI\u06d4 P.S. \u06cc\u06c1 \u0641\u06cc\u0686\u0631 \u0635\u0631\u0641 24 \u06af\u06be\u0646\u0679\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06c1\u06d2\u06d4 \u06a9\u0644 \u0635\u0628\u062d \u062a\u06a9 \u06cc\u06c1 \u063a\u0627\u0626\u0628 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4"
