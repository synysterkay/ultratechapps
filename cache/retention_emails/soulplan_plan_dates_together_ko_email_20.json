  "subject": "45\uc77c\uc758 \uc5ec\uc815, \uc774\uc81c \uc2dc\uc791\uc785\ub2c8\ub2e4",
  "preview_text": "\ub2f9\uc2e0\uc740 \ub354 \uc774\uc0c1 \ucd08\ubcf4\uc790\uac00 \uc544\ub2d9\ub2c8\ub2e4. SoulPlan\uc758 \uc9c4\uc9dc \uc138\uacc4\ub85c \ub4e4\uc5b4\uc62c \uc2dc\uac04\uc785\ub2c8\ub2e4.",
  "body_paragraphs": [
    "45\uc77c \uc804, \ub2f9\uc2e0\uc740 SoulPlan\uc744 \uc5f4\uc5c8\uc2b5\ub2c8\ub2e4. \uc624\ub298, \ub2f9\uc2e0\uc740 \uc774\ubbf8 \uc218\ub9ce\uc740 \ub370\uc774\ud2b8\ub97c \uacc4\ud68d\ud558\uace0, \ud30c\ud2b8\ub108\uc640\uc758 \ucd94\uc5b5\uc744 \uc313\uc544\uc654\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uc774\uac8c \ub05d\uc774 \uc544\ub2d9\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \ub354 \uc774\uc0c1 '\uc0c8\ub85c\uc6b4 \uc0ac\uc6a9\uc790'\uac00 \uc544\ub2d9\ub2c8\ub2e4. \uc774\uc81c\ub294 '\uc9c4\uc815\ud55c \ucee4\ud50c'\ub85c \uc131\uc7a5\ud560 \uc2dc\uac04\uc785\ub2c8\ub2e4.",
    "\uc6b0\ub9ac\ub294 \ub2f9\uc2e0\uc758 \uc5ec\uc815\uc744 \uc9c0\ucf1c\ubd24\uc2b5\ub2c8\ub2e4. Tonight's Date\ub97c \ud1b5\ud574 \ub2e8 30\ucd08 \ub9cc\uc5d0 \uc644\ubcbd\ud55c \uc800\ub141\uc744 \ub9cc\ub4e4\uc5c8\uace0, Memory Timeline\uc5d0 \uc0ac\uc9c4\uacfc \uba54\ubaa8\ub97c \ub0a8\uacbc\uc73c\uba70, Streak Counter\ub85c \uafb8\uc900\ud568\uc744 \uc99d\uba85\ud588\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uac00\uc7a5 \uc911\uc694\ud55c \uac74 \uc544\uc9c1 \uc624\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \ucee4\ud50c \uc544\uc774\ub374\ud2f0\ud2f0\uac00 \uc644\uc131\ub41c \uc9c0\uae08, \ub354 \ud070 \ubb34\ub300\uac00 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4.",
    "\ucee4\ubba4\ub2c8\ud2f0 \uc624\ube0c \ucee4\ud50c\uc2a4\uac00 \ubc14\ub85c \uadf8\uacf3\uc785\ub2c8\ub2e4. \ub2e4\ub978 \ucee4\ud50c\ub4e4\uc774 \ubcf4\ub0b8 \ub370\uc774\ud2b8 \uc21c\uac04\uc744 \ubcf4\uace0, \uc88b\uc544\uc694\ub97c \ub204\ub974\uace0, \ub313\uae00\uc744 \ub0a8\uae30\uc138\uc694. \ub2f9\uc2e0\uc758 \ub370\uc774\ud2b8 \uc544\uc774\ub514\uc5b4\uac00 \ub204\uad70\uac00\uc5d0\uac8c \uc601\uac10\uc774 \ub420 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc704\uc2dc\ub9ac\uc2a4\ud2b8\uc5d0 \uc800\uc7a5\ud55c \uc544\uc774\ub514\uc5b4\ub97c AI\uac00 \ubd84\uc11d\ud574 \uae5c\uc9dd \ub370\uc774\ud2b8\ub97c \uc81c\uc548\ud569\ub2c8\ub2e4. \uc774 \ubaa8\ub4e0 \uac83\uc774 \ud504\ub85c \uae30\ub2a5\uc73c\ub85c, \uc9c0\uae08 \ubc14\ub85c \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
    "\uc624\ub298, \uc571\uc744 \uc5f4\uc5b4 \ucee4\ubba4\ub2c8\ud2f0 \ud0ed\uc5d0 \uccab \ubc88\uc9f8 \ub370\uc774\ud2b8 \uc21c\uac04\uc744 \uacf5\uc720\ud574\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc758 \uc2a4\ud1a0\ub9ac\uac00 \ub2e4\ub978 \ucee4\ud50c\uc758 \ubd88\uaf43\uc744 \uc810\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. P.S. \uc624\ub298\uc758 \uac00\uc7a5 \ud070 \ube44\ubc00: \ud504\ub85c \uae30\ub2a5\uc758 30\uc77c \ubb34\ub8cc \uccb4\ud5d8\uc774 \ub0b4\uc77c \uc790\uc815\uc5d0 \uc885\ub8cc\ub429\ub2c8\ub2e4. \uc9c0\uae08 \ud589\ub3d9\ud558\uc9c0 \uc54a\uc73c\uba74 \ub193\uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
