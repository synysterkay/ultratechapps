{
  "subject": "\u041c\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435 \u0432 3 \u0443\u0442\u0440\u0430",
  "preview_text": "\u042f \u043d\u0435 \u043f\u0438\u0448\u0443 \u0442\u0430\u043a\u0438\u0435 \u043f\u0438\u0441\u044c\u043c\u0430 \u043e\u0431\u044b\u0447\u043d\u043e. \u041d\u043e \u044d\u0442\u043e\u0442 \u043c\u0430\u0442\u0447 \u0438\u0437\u043c\u0435\u043d\u0438\u043b \u0432\u0441\u0451. \u0422\u044b \u0434\u043e\u043b\u0436\u0435\u043d \u044d\u0442\u043e \u0443\u0432\u0438\u0434\u0435\u0442\u044c.",
  "body_paragraphs": [
    "\u0427\u0435\u0441\u0442\u043d\u043e? \u042f \u043d\u0435\u043d\u0430\u0432\u0438\u0436\u0443 \u043f\u0438\u0441\u0430\u0442\u044c \u0442\u0430\u043a\u0438\u0435 \u043f\u0438\u0441\u044c\u043c\u0430. \u041e\u0431\u044b\u0447\u043d\u043e \u044f \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u043a\u0438\u0434\u044b\u0432\u0430\u044e \u0444\u0438\u0447\u0438 \u0432 \u043a\u043e\u0434 \u0438 \u043d\u0430\u0434\u0435\u044e\u0441\u044c, \u0447\u0442\u043e \u0432\u044b \u0441\u0430\u043c\u0438 \u0432\u0441\u0451 \u043d\u0430\u0439\u0434\u0435\u0442\u0435. \u041d\u043e \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0432 3 \u0443\u0442\u0440\u0430 \u044f \u0441\u0438\u0434\u0435\u043b \u0438 \u0441\u043c\u043e\u0442\u0440\u0435\u043b \u043d\u0430 \u0434\u0430\u043d\u043d\u044b\u0435 \u043c\u0430\u0442\u0447\u0430 \u041b\u0438\u0432\u0435\u0440\u043f\u0443\u043b\u044c \u2014 \u0410\u0440\u0441\u0435\u043d\u0430\u043b. \u0418 \u043f\u043e\u043d\u044f\u043b: \u044f \u0434\u043e\u043b\u0436\u0435\u043d \u0442\u0435\u0431\u0435 \u043a\u043e\u0435-\u0447\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u0442\u044c.",
    "\u041c\u044b \u0441 \u043a\u043e\u043c\u0430\u043d\u0434\u043e\u0439 \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u043b\u0438 14 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e\u0431\u044b \u0418\u0418 \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b \u0442\u044b\u0441\u044f\u0447\u0438 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0437\u0430 \u043c\u0430\u0442\u0447. xG, \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u0435, \u0441\u0438\u043b\u0430 \u0437\u0430\u0449\u0438\u0442\u044b, \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0432\u0441\u0442\u0440\u0435\u0447. \u0412\u0441\u0451 \u044d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442. \u041d\u043e \u0437\u043d\u0430\u0435\u0448\u044c, \u0447\u0442\u043e \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u043c\u0435\u043d\u044f\u0435\u0442 \u0438\u0433\u0440\u0443? \u041e\u0434\u0438\u043d \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0442\u044b \u0432\u0438\u0434\u0438\u0448\u044c \u0437\u0430 2 \u0447\u0430\u0441\u0430 \u0434\u043e \u043c\u0430\u0442\u0447\u0430. \u042f \u0441\u0430\u043c \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u043b \u0441\u0442\u0430\u0432\u043a\u0443 \u043d\u0430 \u043d\u0438\u0447\u044c\u044e \u0432 \u043f\u0440\u043e\u0448\u043b\u043e\u043c \u0442\u0443\u0440\u0435 \u2014 \u0438 \u043b\u0438\u0448\u0438\u043b\u0441\u044f 5000 \u0440\u0443\u0431\u043b\u0435\u0439. \u041f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043d\u0435 \u0437\u0430\u0433\u043b\u044f\u043d\u0443\u043b \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435.",
    "\u0423 \u043d\u0430\u0441 \u0435\u0441\u0442\u044c \u0448\u0442\u0443\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u044f \u043e\u0431\u043e\u0436\u0430\u044e: Confidence Score. \u0414\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043c\u0430\u0442\u0447\u0430 \u0418\u0418 \u043f\u0438\u0448\u0435\u0442: '\u0423\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u044c 78%' \u0438\u043b\u0438 '\u0421\u043f\u043e\u0440\u043d\u044b\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u2014 45%'. \u0422\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0448\u044c Predictify, \u0441\u043c\u043e\u0442\u0440\u0438\u0448\u044c \u043d\u0430 \u044d\u0442\u043e\u0442 \u043f\u0440\u043e\u0446\u0435\u043d\u0442 \u0438 \u0440\u0435\u0448\u0430\u0435\u0448\u044c \u2014 \u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0438\u043b\u0438 \u043d\u0435\u0442. \u0411\u0435\u0437 \u0433\u0430\u0434\u0430\u043d\u0438\u0439, \u0431\u0435\u0437 '\u043d\u0443 \u0432\u0440\u043e\u0434\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u043f\u0440\u043e\u0439\u0442\u0438'. \u0422\u043e\u043b\u044c\u043a\u043e \u0434\u0430\u043d\u043d\u044b\u0435. \u0422\u043e\u043b\u044c\u043a\u043e \u0444\u0430\u043a\u0442\u044b.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041d\u0430\u0439\u0434\u0438 \u043c\u0430\u0442\u0447, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0441\u0435\u0433\u043e\u0434\u043d\u044f, \u0438 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438 \u043d\u0430 \u0435\u0433\u043e Confidence Score. \u0415\u0441\u043b\u0438 \u043e\u043d \u0432\u044b\u0448\u0435 70% \u2014 \u044d\u0442\u043e \u0442\u0432\u043e\u0439 \u0448\u0430\u043d\u0441. P.S. \u042f \u0432\u0447\u0435\u0440\u0430 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043d\u0430 \u0442\u043e\u0442\u0430\u043b \u0431\u043e\u043b\u044c\u0448\u0435 2.5 \u0432 \u043c\u0430\u0442\u0447\u0435 \u0411\u0440\u0430\u0439\u0442\u043e\u043d \u2014 \u0438 \u0432\u044b\u0438\u0433\u0440\u0430\u043b. \u0421\u043f\u043e\u0439\u043b\u0435\u0440: \u0418\u0418 \u0431\u044b\u043b \u043f\u0440\u0430\u0432."
  ],
