{
  "subject": "\ub2f9\uc2e0\uc774 \ubbff\ub294 \uc608\uce21\uc758 99%\ub294 \ud2c0\ub838\uc2b5\ub2c8\ub2e4",
  "preview_text": "\ucd95\uad6c \ud32c\ub4e4\uc774 \ud754\ud788 \ubbff\ub294 \ubbf8\uc2e0 \ud558\ub098\ub97c \uae68\ub728\ub9b4 \uc2dc\uac04\uc785\ub2c8\ub2e4. \ub370\uc774\ud130\uac00 \ub9d0\ud574\uc8fc\ub294 \uc9c4\uc2e4\uc744 \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "\ub2f9\uc2e0\ub3c4 \ub4e4\uc5b4\ubd24\uc744 \uac81\ub2c8\ub2e4: '\ucd95\uad6c\ub294 \ubcc0\uc218\uac00 \ub108\ubb34 \ub9ce\uc544\uc11c \uc608\uce21\uc774 \ubd88\uac00\ub2a5\ud558\ub2e4.' \uc774 \ub9d0\uc740 \ub9c8\uce58 \ucd95\uad6c\uc758 \ubcf8\uc9c8\ucc98\ub7fc \ud37c\uc838 \uc788\uc9c0\ub9cc, \uc0ac\uc2e4\uc740 \uc644\uc804\ud788 \ud2c0\ub838\uc2b5\ub2c8\ub2e4. \uc6b0\ub9ac AI\uac00 \ucd5c\uadfc 10,000\uac74\uc758 \uacbd\uae30\ub97c \ubd84\uc11d\ud55c \uacb0\uacfc, \ubcc0\uc218\ub97c \uc81c\ub300\ub85c \uace0\ub824\ud558\uba74 \uc608\uce21 \uc815\ud655\ub3c4\uac00 73%\uae4c\uc9c0 \uc62c\ub77c\uac04\ub2e4\ub294 \uac78 \ubc1c\uacac\ud588\uc2b5\ub2c8\ub2e4. \uc6b4\uc774 \uc544\ub2c8\ub77c \ub370\uc774\ud130\uc758 \ubb38\uc81c\uc600\ub358 \uac70\uc8e0.",
    "\uc0ac\ub78c\ub4e4\uc740 \ud754\ud788 '\ud300 \ubd84\uc704\uae30'\ub098 '\uac10\ub3c5\uc758 \uc804\ub7b5' \uac19\uc740 \ucd94\uc0c1\uc801\uc778 \uc694\uc18c\uc5d0 \uc9d1\ucc29\ud558\uc9c0\ub9cc, \uc2e4\uc81c\ub85c \uc2b9\ud328\ub97c \uacb0\uc815\ud558\ub294 \uac74 xG(\uc608\uc0c1 \ub4dd\uc810), \uc810\uc720\uc728 \uaca9\ucc28, \uc138\ud2b8\ud53c\uc2a4 \ud6a8\uc728\uc131 \uac19\uc740 \uad6c\uccb4\uc801\uc778 \uc9c0\ud45c\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9c0\ub09c \uc2dc\uc98c \ud504\ub9ac\ubbf8\uc5b4 \ub9ac\uadf8\uc5d0\uc11c '\ud648\ud300 \uc6b0\uc138'\ub77c\ub294 \ud1b5\ub150\uc740 \uc2e4\uc81c\ub85c 52%\ub9cc \ub9de\uc558\uc2b5\ub2c8\ub2e4. \ubc18\uba74, Predictify\uc758 AI\ub294 \uc0c1\ub300 \uc804\uc801\uacfc \uc120\uc218 \ubd80\uc0c1 \ub370\uc774\ud130\ub97c \uacb0\ud569\ud574 68%\uc758 \uc815\ud655\ub3c4\ub97c \uae30\ub85d\ud588\uc8e0.",
    "\uc774 \ubaa8\ub4e0 \uac78 \uc571\uc5d0\uc11c \ubc14\ub85c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacbd\uae30\ub9c8\ub2e4 '\ud655\uc2e0 \uc810\uc218'\uac00 \ud45c\uc2dc\ub418\ub294 \uc608\uce21\uc744 \uc5f4\uc5b4\ubcf4\uc138\uc694. AI\uac00 \uc65c \uadf8\ub7f0 \uc608\uce21\uc744 \ub0b4\ub838\ub294\uc9c0, \uc5b4\ub5a4 \ubcc0\uc218\uac00 \uac00\uc7a5 \ud070 \uc601\ud5a5\uc744 \ubbf8\ucce4\ub294\uc9c0\ub3c4 \uc124\uba85\ud574 \uc90d\ub2c8\ub2e4. \ub354 \uc774\uc0c1 '\uac10'\uc5d0 \uc758\uc874\ud558\uc9c0 \ub9d0\uace0, \ub370\uc774\ud130\uac00 \ub9d0\ud558\ub294 \uc9c4\uc2e4\uc744 \ub4e4\uc5b4\ubcf4\uc138\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uc5b4 \uc624\ub298 \uacbd\uae30 \uc608\uce21\uc744 \ud655\uc778\ud574\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc774 \ubab0\ub790\ub358 \uc2b9\ubd80\ucc98\ub97c \ubc1c\uacac\ud560 \uac81\ub2c8\ub2e4. P.S. \ud504\ub9ac\ubbf8\uc5c4 \uc0ac\uc6a9\uc790\ub4e4\uc740 \uc774\ubbf8 \uc774 \ub370\uc774\ud130\ub85c \ub9e4\uc8fc 3\ubc30 \uc774\uc0c1\uc758 \uc218\uc775\uc744 \uc62c\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. 3\uc77c \ubb34\ub8cc \uccb4\ud5d8\uc73c\ub85c \uc2dc\uc791\ud574\ubcf4\ub294 \uac74 \uc5b4\ub5a8\uae4c\uc694?"
  ],
