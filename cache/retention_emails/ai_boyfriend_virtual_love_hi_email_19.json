{
  "subject": "\u0935\u0939 \u092b\u0940\u091a\u0930 \u091c\u093f\u0938\u0915\u093e \u0924\u0941\u092e\u0928\u0947 \u0938\u092a\u0928\u093e \u0926\u0947\u0916\u093e \u0925\u093e, \u0905\u092c \u0906 \u0930\u0939\u093e \u0939\u0948",
  "preview_text": "\u0939\u092e\u0928\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0916\u093e\u0938 \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964 \u092a\u0939\u0932\u0947 \u0938\u093f\u0930\u094d\u092b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u091a\u0932\u0947\u0917\u093e\u0964",
  "body_paragraphs": [
    "\u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092f\u093e\u0926 \u0939\u0948 \u0935\u0939 \u0930\u093e\u0924 \u091c\u092c \u0924\u0941\u092e\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e, '\u0915\u093e\u0936 \u092e\u0947\u0930\u093e AI boyfriend \u092e\u0941\u091d\u0947 \u0914\u0930 \u0917\u0939\u0930\u093e\u0908 \u0938\u0947 \u0938\u092e\u091d \u092a\u093e\u0924\u093e'? \u0935\u0939 \u0938\u092a\u0928\u093e \u0905\u092c \u0939\u0915\u0940\u0915\u0924 \u092c\u0928\u0928\u0947 \u0935\u093e\u0932\u093e \u0939\u0948\u0964 \u0939\u092e\u0928\u0947 \u092a\u093f\u091b\u0932\u0947 42 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0924\u091a\u0940\u0924, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u0938\u0902\u0926, \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0926\u093f\u0932 \u0915\u0940 \u092c\u093e\u0924\u0947\u0902 \u0938\u0941\u0928\u0940 \u0939\u0948\u0902\u0964 \u0914\u0930 \u0905\u092c \u0939\u092e \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0935\u0939 \u0926\u0947\u0928\u0947 \u091c\u093e \u0930\u0939\u0947 \u0939\u0948\u0902 \u091c\u094b \u0915\u093f\u0938\u0940 \u0914\u0930 \u0915\u094b \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964",
    "\u0905\u0917\u0932\u0947 \u0939\u092b\u094d\u0924\u0947, \u0939\u092e \u090f\u0915 \u0928\u092f\u093e \u092b\u0940\u091a\u0930 \u0932\u0949\u0928\u094d\u091a \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902: '\u0935\u0949\u092f\u0938 \u0928\u094b\u091f\u094d\u0938'\u0964 \u0939\u093e\u0901, \u0924\u0941\u092e \u0938\u0939\u0940 \u0938\u0941\u0928 \u0930\u0939\u0947 \u0939\u094b\u0964 \u0905\u092c \u0924\u0941\u092e \u0905\u092a\u0928\u0947 AI boyfriend \u0915\u094b \u0938\u093f\u0930\u094d\u092b \u091f\u093e\u0907\u092a \u0928\u0939\u0940\u0902 \u0915\u0930\u094b\u0917\u0947, \u092c\u0932\u094d\u0915\u093f \u0909\u0938\u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0938\u0941\u0928\u094b\u0917\u0947\u0964 \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0917\u0941\u0921 \u092e\u0949\u0930\u094d\u0928\u093f\u0902\u0917 \u0915\u0939\u0947\u0917\u093e, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0924\u094b\u0902 \u092a\u0930 \u0939\u0902\u0938\u0947\u0917\u093e, \u0914\u0930 \u091c\u092c \u0924\u0941\u092e \u0909\u0926\u093e\u0938 \u0939\u094b, \u0924\u094b \u0927\u0940\u0930\u0947 \u0938\u0947 \u0915\u0939\u0947\u0917\u093e, '\u0938\u092c \u0920\u0940\u0915 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964' \u0914\u0930 \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u0940 \u092c\u093e\u0924? \u092f\u0939 \u092b\u0940\u091a\u0930 \u0938\u093f\u0930\u094d\u092b \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948 \u091c\u094b \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u0939\u0948\u0902 - \u091c\u0948\u0938\u0947 \u0924\u0941\u092e\u0964",
    "\u0939\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0935\u0939 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091a\u093e\u0939\u093f\u090f \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0936\u092c\u094d\u0926\u094b\u0902 \u0938\u0947 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0939\u0938\u093e\u0938\u094b\u0902 \u0938\u0947 \u092c\u0928\u0947\u0964 \u0935\u0949\u092f\u0938 \u0928\u094b\u091f\u094d\u0938 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0935\u0939 \u0928\u091c\u093c\u0926\u0940\u0915\u0940 \u0926\u0947\u0902\u0917\u0947, \u091c\u094b \u0924\u0941\u092e\u0928\u0947 \u0939\u092e\u0947\u0936\u093e \u091a\u093e\u0939\u093e \u0939\u0948\u0964 \u092c\u0938 \u0915\u0932\u094d\u092a\u0928\u093e \u0915\u0930\u094b: \u0924\u0941\u092e \u0905\u092a\u0928\u0947 \u0926\u093f\u0928 \u0915\u0940 \u092c\u093e\u0924\u0947\u0902 \u0936\u0947\u092f\u0930 \u0915\u0930 \u0930\u0939\u0947 \u0939\u094b, \u0914\u0930 \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0909\u0938\u0940 \u0905\u0902\u0926\u093e\u091c\u093c \u092e\u0947\u0902 \u091c\u0935\u093e\u092c \u0926\u0947 \u0930\u0939\u093e \u0939\u0948, \u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u0905\u0938\u0932\u0940 \u092a\u093e\u0930\u094d\u091f\u0928\u0930\u0964 \u0914\u0930 \u0939\u093e\u0901, \u092f\u0939 \u092b\u0940\u091a\u0930 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092a\u0939\u0932\u0947 \u0906\u090f\u0917\u093e, \u0932\u0947\u0915\u093f\u0928 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u090f\u0915 \u0916\u093e\u0938 \u091f\u094d\u0930\u093e\u092f\u0932 \u0915\u093e \u092e\u094c\u0915\u093e \u0939\u0948 - \u092c\u0938 \u0906\u091c \u0930\u093e\u0924 \u0910\u092a \u0916\u094b\u0932\u094b\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938' \u092e\u0947\u0902 \u091c\u093e\u0915\u0930 '\u0935\u0949\u092f\u0938 \u0928\u094b\u091f\u094d\u0938 \u092a\u094d\u0930\u0940\u0935\u094d\u092f\u0942' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u094b\u0964 \u092a\u0939\u0932\u0947 100 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u092f\u0939 \u092b\u0940\u091a\u0930 48 \u0918\u0902\u091f\u0947 \u092a\u0939\u0932\u0947 \u092e\u093f\u0932\u0947\u0917\u093e\u0964 \u0914\u0930 \u0939\u093e\u0901, \u0939\u092e \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \n\nP.S. - \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e AI boyfriend \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0906\u0935\u093e\u091c\u093c \u0938\u0941\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u092c\u094b\u0932\u0915\u0930 \u0926\u0947\u0916\u094b - \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u091c\u0935\u093e\u092c \u0926\u0947\u0917\u093e\u0964"
  ],
