{
  "subject": "\u062a\u0648\u0641\u064a\u0631 18 \u062f\u0642\u064a\u0642\u0629 \u0641\u064a \u0643\u0644 \u0645\u0631\u0629 \u062a\u0633\u062a\u0645\u0639 \u0641\u064a\u0647\u0627",
  "preview_text": "\u0647\u0644 \u062a\u0639\u0644\u0645 \u0623\u0646\u0643 \u062a\u0647\u062f\u0631 18 \u062f\u0642\u064a\u0642\u0629 \u0641\u064a \u0643\u0644 \u0645\u0631\u0629 \u062a\u0633\u062a\u0645\u0639 \u0641\u064a\u0647\u0627\u061f \u062a\u0639\u0644\u0645 \u0643\u064a\u0641 \u062a\u0633\u062a\u0639\u064a\u062f\u0647\u0627 \u0641\u064a \u062b\u0627\u0646\u064a\u062a\u064a\u0646.",
  "body_paragraphs": [
    "\u0641\u064a \u0627\u0644\u0645\u0631\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629 \u0627\u0644\u062a\u064a \u0627\u0633\u062a\u0645\u0639\u062a \u0641\u064a\u0647\u0627 \u0625\u0644\u0649 \u0628\u0648\u062f\u0643\u0627\u0633\u062a \u0623\u0648 \u0643\u062a\u0627\u0628 \u0635\u0648\u062a\u064a\u060c \u0643\u0645 \u0645\u0646 \u0627\u0644\u0648\u0642\u062a \u0642\u0636\u064a\u062a \u0641\u064a \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0635\u0648\u062a\u061f \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a\u060c \u062e\u0641\u0636 \u0627\u0644\u0636\u0648\u0636\u0627\u0621\u060c \u0636\u0628\u0637 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a... \u062b\u0645 \u062a\u0643\u062a\u0634\u0641 \u0623\u0646 \u0627\u0644\u0635\u0648\u062a \u0644\u0627 \u064a\u0632\u0627\u0644 \u063a\u064a\u0631 \u0648\u0627\u0636\u062d.",
    "\u0644\u0642\u062f \u062f\u0631\u0633\u062a \u0639\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u0645\u0639\u064a\u0646\u060c \u0648\u0648\u062c\u062f\u062a \u0623\u0646 \u0645\u0639\u0638\u0645\u0647\u0645 \u064a\u0642\u0636\u064a \u062d\u0648\u0627\u0644\u064a 18 \u062f\u0642\u064a\u0642\u0629 \u0641\u064a \u0643\u0644 \u062c\u0644\u0633\u0629 \u0627\u0633\u062a\u0645\u0627\u0639 \u0641\u064a \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0635\u0648\u062a. 18 \u062f\u0642\u064a\u0642\u0629 \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0627 \u0644\u0644\u0627\u0633\u062a\u0645\u062a\u0627\u0639 \u0628\u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0645\u062d\u0627\u0631\u0628\u062a\u0647.",
    "\u0645\u0639 Loud EQ\u060c \u0643\u0644 \u0645\u0627 \u0639\u0644\u064a\u0643 \u0641\u0639\u0644\u0647 \u0647\u0648 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 '\u062a\u062d\u0633\u064a\u0646' \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629. \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u064a\u0636\u0628\u0637 \u0627\u0644\u0635\u0648\u062a \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u062c\u0647\u0627\u0632\u0643 \u0648\u0628\u064a\u0626\u062a\u0643. \u0644\u0627 \u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0627\u0644\u064a\u062f\u0648\u064a\u0629. \u0644\u0627 \u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0636\u0627\u0626\u0639.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628 '\u0627\u0644\u062a\u062d\u0633\u064a\u0646 \u0628\u0646\u0642\u0631\u0629 \u0648\u0627\u062d\u062f\u0629' \u0641\u064a \u0631\u062d\u0644\u062a\u0643 \u0627\u0644\u0642\u0627\u062f\u0645\u0629. \u0633\u062a\u0641\u0627\u062c\u0623 \u0643\u064a\u0641 \u064a\u0645\u0643\u0646 \u0644\u062b\u0627\u0646\u064a\u062a\u064a\u0646 \u0623\u0646 \u062a\u0648\u0641\u0631 \u0644\u0643 18 \u062f\u0642\u064a\u0642\u0629.",
    "\u0645\u0644\u0627\u062d\u0638\u0629: \u0645\u0633\u062a\u062e\u062f\u0645\u064a Premium \u064a\u062d\u0635\u0644\u0648\u0646 \u0639\u0644\u0649 \u062a\u062d\u0633\u064a\u0646 \u062a\u0644\u0642\u0627\u0626\u064a \u0644\u0643\u0644 \u062c\u0647\u0627\u0632 \u0645\u062a\u0635\u0644\u2014\u0645\u0646 AirPods \u0625\u0644\u0649 \u0633\u0645\u0627\u0639\u0627\u062a \u0627\u0644\u0633\u064a\u0627\u0631\u0629. \u062c\u0631\u0628\u0647 \u0627\u0644\u064a\u0648\u0645."
  ],
