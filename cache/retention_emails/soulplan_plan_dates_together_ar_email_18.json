{
  "subject": "\u0627\u0639\u062a\u0631\u0627\u0641: \u0628\u0646\u064a\u062a \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u064a \u0627\u0644\u06402 \u0635\u0628\u0627\u062d\u0627\u064b",
  "preview_text": "\u0644\u0645 \u0623\u0643\u0646 \u0623\u0646\u0648\u064a \u0643\u062a\u0627\u0628\u0629 \u0647\u0630\u0647 \u0627\u0644\u0631\u0633\u0627\u0644\u0629\u060c \u0644\u0643\u0646 \u0634\u064a\u0626\u0627\u064b \u0645\u0627 \u062a\u063a\u064a\u0631 \u0628\u0639\u062f \u0631\u0624\u064a\u0629 \u0632\u0648\u062c\u064a\u0646 \u064a\u0633\u062a\u062e\u062f\u0645\u0627\u0646\u0647 \u0645\u0639\u0627\u064b.",
  "body_paragraphs": [
    "\u0644\u0645 \u0623\u0643\u0646 \u0623\u0646\u0648\u064a \u0643\u062a\u0627\u0628\u0629 \u0647\u0630\u0647 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0623\u0628\u062f\u0627\u064b. \u0644\u0643\u0646 \u0627\u0644\u0644\u064a\u0644\u0629 \u0627\u0644\u0645\u0627\u0636\u064a\u0629\u060c \u0648\u0623\u0646\u0627 \u0623\u0634\u0627\u0647\u062f \u0632\u0648\u062c\u064a\u0646 \u064a\u0633\u062a\u062e\u062f\u0645\u0627\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0639\u0627\u064b \u0641\u064a \u0645\u0642\u0647\u0649 \u0635\u063a\u064a\u0631\u060c \u0634\u0639\u0631\u062a \u0628\u0634\u064a\u0621 \u063a\u0631\u064a\u0628. \u0644\u064a\u0633 \u0641\u062e\u0631\u0627\u064b\u060c \u0628\u0644 \u062e\u0648\u0641\u0627\u064b. \u062e\u0648\u0641\u0627\u064b \u0645\u0646 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0645\u0627 \u0628\u0646\u064a\u062a\u0647 \u0642\u062f \u0636\u0627\u0639 \u0628\u064a\u0646 \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0631\u0648\u062a\u064a\u0646.",
    "\u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u064f\u0644\u062f \u0641\u064a \u0627\u0644\u06402 \u0635\u0628\u0627\u062d\u0627\u064b\u060c \u0628\u0639\u062f \u0644\u064a\u0644\u0629 \u0637\u0648\u064a\u0644\u0629 \u0645\u0646 \u0627\u0644\u062a\u0641\u0643\u064a\u0631 \u0641\u064a \u0643\u064a\u0641 \u064a\u0645\u0643\u0646 \u0644\u0645\u0648\u0639\u062f \u0639\u0627\u062f\u064a \u0623\u0646 \u064a\u0635\u0628\u062d \u0630\u0643\u0631\u0649 \u062c\u0645\u064a\u0644\u0629. \u0644\u0645 \u0623\u0643\u0646 \u0623\u0639\u0631\u0641 \u0625\u0646 \u0643\u0627\u0646 \u0633\u064a\u0646\u062c\u062d\u060c \u0644\u0643\u0646\u064a \u0623\u0639\u0631\u0641 \u0627\u0644\u0622\u0646 \u0623\u0646 \u0623\u0648\u0644\u0626\u0643 \u0627\u0644\u0630\u064a\u0646 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0645\u064a\u0632\u0629 '\u0645\u0648\u0639\u062f \u0627\u0644\u0644\u064a\u0644\u0629' \u0641\u064a \u0623\u0648\u0644 24 \u0633\u0627\u0639\u0629\u060c \u064a\u062e\u0637\u0637\u0648\u0646 \u0644\u0623\u0631\u0628\u0639\u0629 \u0623\u0636\u0639\u0627\u0641 \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0641\u064a \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u062a\u0627\u0644\u064a. \u0644\u064a\u0633 \u0644\u0623\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0633\u062d\u0631\u064a\u060c \u0628\u0644 \u0644\u0623\u0646\u0647 \u064a\u0630\u0643\u0631\u0643 \u0628\u0623\u0646 \u0627\u0644\u0634\u0631\u064a\u0643 \u0644\u0627 \u064a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u062e\u0637\u0629 \u0645\u062b\u0627\u0644\u064a\u0629\u060c \u0628\u0644 \u0625\u0644\u0649 \u0644\u062d\u0638\u0629 \u062a\u0641\u0643\u064a\u0631 \u062d\u0642\u064a\u0642\u064a\u0629.",
    "\u0647\u0646\u0627\u0643 \u0645\u064a\u0632\u0629 \u0635\u063a\u064a\u0631\u0629 \u0642\u062f \u0644\u0627 \u062a\u0644\u0627\u062d\u0638\u0647\u0627: \u0639\u0646\u062f\u0645\u0627 \u062a\u0631\u0633\u0644 \u0645\u0648\u0639\u062f\u0627\u064b \u0644\u0634\u0631\u064a\u0643\u0643\u060c \u062a\u0638\u0647\u0631 \u0644\u0647 \u0634\u0627\u0634\u0629 \u0643\u0627\u0645\u0644\u0629 \u062c\u0645\u064a\u0644\u0629 \u062a\u0642\u0648\u0644 '\u0641\u0643\u0631\u062a \u0641\u064a\u0643 \u0627\u0644\u0644\u064a\u0644\u0629'. \u0644\u064a\u0633\u062a \u0645\u062c\u0631\u062f \u0625\u0634\u0639\u0627\u0631 \u0639\u0627\u062f\u064a. \u0625\u0646\u0647\u0627 \u0631\u0633\u0627\u0644\u0629 \u062a\u0642\u0648\u0644: \u0623\u0646\u0627 \u0647\u0646\u0627\u060c \u0645\u0639\u0643\u060c \u062d\u062a\u0649 \u0644\u0648 \u0643\u0646\u0627 \u0645\u0634\u063a\u0648\u0644\u064a\u0646. \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0647\u064a \u0642\u0644\u0628 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0648\u0623\u062a\u0645\u0646\u0649 \u0623\u0646 \u062a\u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0644\u064a\u0644\u0629.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0627\u062e\u062a\u0631 \u0645\u0632\u0627\u062c\u0643 \u0645\u0646 '\u0645\u0631\u064a\u062d' \u0623\u0648 '\u0645\u063a\u0627\u0645\u0631' \u0623\u0648 '\u0645\u0631\u062d' \u0623\u0648 '\u0634\u0627\u0641\u064d'\u060c \u0648\u0634\u0627\u0647\u062f \u0643\u064a\u0641 \u064a\u0645\u0643\u0646 \u0644\u0645\u0648\u0639\u062f \u0623\u0646 \u064a\u062a\u062d\u0648\u0644 \u0625\u0644\u0649 \u0630\u0643\u0631\u0649. P.S. \u0625\u0630\u0627 \u0634\u0639\u0631\u062a \u0623\u0646 \u0627\u0644\u0634\u0631\u0627\u0631\u0629 \u062a\u062e\u0641\u062a\u060c \u062a\u0630\u0643\u0631 \u0623\u0646 \u0627\u0644\u0630\u0643\u0631\u064a\u0627\u062a \u0644\u0627 \u062a\u064f\u0635\u0646\u0639 \u0641\u064a \u064a\u0648\u0645 \u0648\u0627\u062d\u062f\u060c \u0628\u0644 \u0641\u064a \u0644\u062d\u0638\u0627\u062a \u0635\u063a\u064a\u0631\u0629 \u0645\u062b\u0644 \u0647\u0630\u0647."
  ],
  "cta_text": "\u0627\u0641\u062a\u062d SoulPlan \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628 '\u0645\u0648\u0639\u062f \u0627\u0644\u0644\u064a\u0644\u0629'",
