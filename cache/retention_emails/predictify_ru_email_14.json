{
  "subject": "\u0422\u044b \u0441\u0442\u0430\u043b \u0447\u0430\u0441\u0442\u044c\u044e \u0447\u0435\u0433\u043e-\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0435\u0433\u043e",
  "preview_text": "1000+ \u0444\u0430\u043d\u0430\u0442\u043e\u0432 \u0443\u0436\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u044d\u0442\u043e. \u0422\u044b \u0435\u0449\u0435 \u043d\u0435\u0442? \u0423\u0437\u043d\u0430\u0439, \u043a\u0430\u043a \u043f\u043e\u043f\u0430\u0441\u0442\u044c \u0432 \u0442\u043e\u043f",
  "body_paragraphs": [
    "\u042f \u0437\u043d\u0430\u044e, \u0447\u0442\u043e \u0442\u044b \u0441\u043a\u0430\u0447\u0430\u043b Predictify \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0430\u043a. \u0422\u044b \u0443\u0441\u0442\u0430\u043b \u043e\u0442 \u0434\u043e\u0433\u0430\u0434\u043e\u043a \u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u0434\u0430\u043d\u043d\u044b\u0435. \u041d\u043e \u0432\u043e\u0442 \u0447\u0442\u043e \u044f \u0437\u0430\u043c\u0435\u0442\u0438\u043b: \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0441\u043c\u043e\u0442\u0440\u044f\u0442 \u043f\u0430\u0440\u0443 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u043e\u0432 \u0438 \u0437\u0430\u0431\u044b\u0432\u0430\u044e\u0442. \u041e\u043d\u0438 \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u044e\u0442, \u0447\u0442\u043e \u043e\u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c \u0432 \u043a\u043b\u0443\u0431\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u0435\u043d\u044f\u0435\u0442 \u0444\u0443\u0442\u0431\u043e\u043b. \u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e \u0443\u0433\u0430\u0434\u0430\u0439\u043a\u0443 \u2014 \u044d\u0442\u043e \u043f\u0440\u043e \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0441\u0442\u0430\u0432\u0438\u0442 \u043d\u0430 \u0444\u0430\u043a\u0442\u044b, \u0430 \u043d\u0435 \u043d\u0430 \u0447\u0443\u0432\u0441\u0442\u0432\u0430.",
    "\u0422\u044b \u0438 1000+ \u0434\u0440\u0443\u0433\u0438\u0445 \u0444\u0430\u043d\u0430\u0442\u043e\u0432 \u0438\u0437 14 \u0441\u0442\u0440\u0430\u043d \u0442\u0435\u043f\u0435\u0440\u044c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c \u043e\u0434\u0438\u043d \u0438 \u0442\u043e\u0442 \u0436\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442. \u041c\u044b \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u043c \u043c\u0430\u0442\u0447\u0438 \u0432 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430\u0445, \u0433\u043e\u043b\u043e\u0441\u0443\u0435\u043c \u0437\u0430 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0434\u043d\u044f \u0438 \u0441\u043e\u0440\u0435\u0432\u043d\u0443\u0435\u043c\u0441\u044f \u0432 IQ Quiz. \u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u2014 \u044d\u0442\u043e \u0442\u0432\u043e\u0439 \u043d\u043e\u0432\u044b\u0439 \u0444\u0443\u0442\u0431\u043e\u043b\u044c\u043d\u044b\u0439 \u043a\u0440\u0443\u0433. \u041a\u043e\u0433\u0434\u0430 \u0442\u044b \u0437\u0430\u0445\u043e\u0434\u0438\u0448\u044c \u0432 Predictify, \u0442\u044b \u043d\u0435 \u043e\u0434\u0438\u043d. \u0422\u044b \u0432\u0438\u0434\u0438\u0448\u044c, \u043a\u0430\u043a \u0434\u0440\u0443\u0433\u0438\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u044e\u0442 \u0441\u0432\u043e\u0438 \u0437\u043d\u0430\u043d\u0438\u044f, \u0441\u0442\u0440\u043e\u044f\u0442 \u0441\u0442\u0440\u0438\u043a\u0438 \u0438 \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f. \u0418 \u0442\u044b \u043c\u043e\u0436\u0435\u0448\u044c \u0431\u044b\u0442\u044c \u0441\u0440\u0435\u0434\u0438 \u043b\u0438\u0434\u0435\u0440\u043e\u0432.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u0440\u0430\u0437\u0434\u0435\u043b '\u0421\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430' \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u0422\u0430\u043c \u0442\u044b \u043d\u0430\u0439\u0434\u0435\u0448\u044c \u0444\u0430\u043d\u0430\u0442\u043e\u0432 \u0441\u0432\u043e\u0435\u0433\u043e \u043a\u043b\u0443\u0431\u0430, \u043e\u0431\u0441\u0443\u0434\u0438\u0448\u044c \u0442\u0430\u043a\u0442\u0438\u043a\u0443 \u0438 \u043f\u0440\u043e\u0433\u043e\u043b\u043e\u0441\u0443\u0435\u0448\u044c \u0437\u0430 \u043b\u0443\u0447\u0448\u0438\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0434\u043d\u044f. \u042d\u0442\u043e \u0442\u0432\u043e\u0439 \u0448\u0430\u043d\u0441 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0444\u0443\u0442\u0431\u043e\u043b, \u0430 \u0431\u044b\u0442\u044c \u0447\u0430\u0441\u0442\u044c\u044e \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0444\u043e\u0440\u043c\u0438\u0440\u0443\u0435\u0442 \u0441\u0442\u0430\u0432\u043a\u0438. \u0414\u0430\u043d\u043d\u044b\u0435 \u0441 AI \u0443\u0436\u0435 \u0433\u043e\u0442\u043e\u0432\u044b \u2014 \u0442\u0435\u0431\u0435 \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u044c\u0441\u044f \u043a \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044e.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Predictify \u0438 \u0437\u0430\u0439\u0434\u0438 \u0432 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u041d\u0430\u0439\u0434\u0438 \u0441\u0432\u043e\u044e \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u0438 \u043d\u0430\u0447\u043d\u0438 \u0434\u0438\u0430\u043b\u043e\u0433. P.S. \u0422\u0432\u043e\u0439 \u0441\u0442\u0440\u0438\u043a \u0443\u0436\u0435 \u043d\u0430 \u043f\u0430\u0443\u0437\u0435 \u2014 \u0432\u0435\u0440\u043d\u0438 \u0435\u0433\u043e \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0438 \u043f\u043e\u043b\u0443\u0447\u0438 \u0431\u0435\u0439\u0434\u0436 '\u041d\u043e\u0432\u0438\u0447\u043e\u043a \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430'."
