{
  "subject": "2 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0935\u0939 \u0915\u093e\u092e \u091c\u094b 20 \u092e\u093f\u0928\u091f \u0932\u0947\u0924\u093e \u0925\u093e",
  "preview_text": "\u0906\u092a\u0915\u093e \u0915\u0940\u092e\u0924\u0940 \u0938\u092e\u092f \u092c\u091a\u093e\u0928\u0947 \u0915\u093e \u090f\u0915 \u0928\u092f\u093e \u0924\u0930\u0940\u0915\u093e\u0964 \u0938\u0941\u0928\u093f\u090f, \u0938\u092e\u091d\u093f\u090f \u0914\u0930 \u092b\u093f\u0930 \u0926\u0947\u0916\u093f\u090f \u0915\u0948\u0938\u0947 Loudify \u0906\u092a\u0915\u0940 \u0930\u094b\u091c\u093c \u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924 \u092c\u0926\u0932 \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u0939 \u0926\u093f\u0928 \u091c\u092c \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0915\u094b \u092c\u093e\u0930-\u092c\u093e\u0930 \u090f\u0921\u091c\u0938\u094d\u091f \u0915\u0930\u0928\u093e \u092a\u0921\u093c\u0924\u093e \u0925\u093e? \u092f\u093e \u092b\u093f\u0930 \u0917\u0947\u092e\u093f\u0902\u0917 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0921\u093e\u092f\u0932\u0949\u0917 \u0915\u094b \u0938\u093e\u092b \u0938\u0941\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u0938\u0947\u091f \u0915\u0930\u0928\u093e? \u0935\u0939 \u0938\u092c \u0916\u0924\u094d\u092e\u0964 \u0905\u092c \u0938\u093f\u0930\u094d\u092b 2 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0906\u092a \u0905\u092a\u0928\u0947 \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u092a\u0939\u0932\u0947 \u091c\u0948\u0938\u093e \u092c\u0928\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 - \u091c\u094b \u092a\u0939\u0932\u0947 20 \u092e\u093f\u0928\u091f \u0932\u0947\u0924\u093e \u0925\u093e\u0964",
    "\u0938\u094b\u091a\u093f\u090f: \u091c\u092c \u0906\u092a \u092e\u0947\u091f\u094d\u0930\u094b \u092e\u0947\u0902 \u0939\u0948\u0902 \u0914\u0930 \u091f\u094d\u0930\u0947\u0928 \u0915\u093e \u0936\u094b\u0930 \u0939\u0948, \u0924\u094b \u0906\u092a\u0915\u094b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u090f\u0915 \u0926\u0940\u0935\u093e\u0930 \u092c\u0928 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 Loudify \u0915\u093e +200% \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f \u0909\u0938 \u0926\u0940\u0935\u093e\u0930 \u0915\u094b \u0924\u094b\u0921\u093c\u0924\u093e \u0939\u0948 - \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0915\u0947\u0964 \u0914\u0930 \u0905\u092c \u0906\u092a\u0915\u094b \u0939\u0930 \u092c\u093e\u0930 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092c\u0926\u0932\u0928\u0947 \u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u094b \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902, \u0914\u0930 AutoEQ \u0909\u0928\u094d\u0939\u0947\u0902 \u092a\u0939\u091a\u093e\u0928 \u0932\u0947\u0924\u093e \u0939\u0948 - \u0939\u0930 \u092c\u093e\u0930\u0964",
    "\u092f\u0939 \u0915\u094b\u0908 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u091f\u0942\u0932 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0940 \u0906\u0926\u0924\u094b\u0902 \u0915\u094b \u0938\u092e\u091d\u0924\u093e \u0939\u0948\u0964 \u0939\u092b\u094d\u0924\u0947 \u0915\u0947 \u0905\u0902\u0924 \u092e\u0947\u0902, \u0906\u092a\u0915\u094b \u090f\u0915 Sound DNA \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092e\u093f\u0932\u0924\u0940 \u0939\u0948 \u091c\u094b \u092c\u0924\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u0906\u092a\u0928\u0947 \u0915\u0948\u0938\u0947 \u0938\u0941\u0928\u093e - \u0915\u093f\u0924\u0928\u0940 \u092c\u093e\u0930, \u0915\u093f\u0924\u0928\u0940 \u0924\u0947\u091c\u093c, \u0914\u0930 \u0915\u093f\u0938 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u092e\u0947\u0902\u0964 \u092f\u0939 \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924\u094b\u0902 \u0915\u093e \u090f\u0915 \u092a\u0930\u094d\u0938\u0928\u0932 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0939\u0948, \u0928 \u0915\u093f \u0915\u094b\u0908 \u0917\u093f\u092e\u093f\u0915\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u0915\u093f \u0906\u092a \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e\u090f\u0902\u0964 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u094b \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902\u0964 \u092b\u093f\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0915\u0948\u0938\u0947 2 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0906\u092a\u0915\u093e \u0911\u0921\u093f\u092f\u094b \u0905\u0928\u0941\u092d\u0935 \u092c\u0926\u0932 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u0939\u093e\u0901, \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u092a\u093e\u0938 \u0914\u0930 \u092d\u0940 \u091c\u094d\u092f\u093e\u0926\u093e \u0935\u093f\u0915\u0932\u094d\u092a \u0939\u0948\u0902 - \u092a\u0942\u0930\u093e +200% \u092c\u0942\u0938\u094d\u091f, \u0938\u092d\u0940 AutoEQ \u092a\u094d\u0930\u0940\u0938\u0947\u091f, \u0914\u0930 Sound DNA \u0915\u093e \u092a\u0942\u0930\u093e \u0907\u0924\u093f\u0939\u093e\u0938\u0964 \u092a\u0940.\u090f\u0938. - \u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f 100,000 \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u094b \u0938\u0939\u0940 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u091f\u094d\u092f\u0942\u0928 \u0915\u0930 \u091a\u0941\u0915\u0947 \u0939\u0948\u0902? \u0906\u092a \u092d\u0940 \u0909\u0928\u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0939\u094b \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
  ],
