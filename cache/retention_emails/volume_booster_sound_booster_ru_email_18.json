{
  "subject": "\u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435: \u044f \u043f\u0438\u0441\u0430\u043b \u044d\u0442\u043e \u0432 3 \u0443\u0442\u0440\u0430",
  "preview_text": "\u041e\u0431\u044b\u0447\u043d\u043e \u044f \u043d\u0435 \u043f\u0438\u0448\u0443 \u0442\u0430\u043a\u0438\u0435 \u043f\u0438\u0441\u044c\u043c\u0430, \u043d\u043e \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0441\u0434\u0435\u043b\u0430\u043b \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435. \u0417\u0430\u0433\u043b\u044f\u043d\u0438 \u0432\u043d\u0443\u0442\u0440\u044c \u2014 \u0442\u0430\u043c \u043a\u043e\u0435-\u0447\u0442\u043e \u043b\u0438\u0447\u043d\u043e\u0435.",
  "body_paragraphs": [
    "\u041e\u0431\u044b\u0447\u043d\u043e \u044f \u043d\u0435 \u043f\u0438\u0448\u0443 \u0442\u0430\u043a\u0438\u0435 \u043f\u0438\u0441\u044c\u043c\u0430. \u0421\u0435\u0440\u044c\u0451\u0437\u043d\u043e. \u0412\u0441\u044f \u043d\u0430\u0448\u0430 \u0440\u0430\u0441\u0441\u044b\u043b\u043a\u0430 \u2014 \u044d\u0442\u043e \u0448\u0430\u0431\u043b\u043e\u043d\u044b, A/B-\u0442\u0435\u0441\u0442\u044b \u0438 \u043f\u0440\u043e\u0447\u0430\u044f \u043c\u0430\u0440\u043a\u0435\u0442\u0438\u043d\u0433\u043e\u0432\u0430\u044f \u043a\u0443\u0445\u043d\u044f. \u041d\u043e \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0432 3 \u043d\u043e\u0447\u0438 \u044f \u0441\u0438\u0434\u0435\u043b \u0441 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u043c\u0438, \u0441\u043b\u0443\u0448\u0430\u043b \u0441\u0432\u043e\u0439 \u043f\u043b\u0435\u0439\u043b\u0438\u0441\u0442 \u0438 \u0432\u0434\u0440\u0443\u0433 \u043f\u043e\u043d\u044f\u043b: \u044f \u0441\u0430\u043c \u043f\u043e\u0447\u0442\u0438 \u0437\u0430\u0431\u044b\u043b, \u0437\u0430\u0447\u0435\u043c \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u043b \u044d\u0442\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435. \u041d\u0435 \u0434\u043b\u044f \u0446\u0438\u0444\u0440 \u0432 \u0434\u0430\u0448\u0431\u043e\u0440\u0434\u0435, \u0430 \u0447\u0442\u043e\u0431\u044b \u0442\u044b \u0443\u0441\u043b\u044b\u0448\u0430\u043b \u043c\u0443\u0437\u044b\u043a\u0443 \u0442\u0430\u043a, \u043a\u0430\u043a \u043e\u043d\u0430 \u0437\u0432\u0443\u0447\u0430\u043b\u0430 \u0432 \u0441\u0442\u0443\u0434\u0438\u0438.",
    "\u0417\u043d\u0430\u0435\u0448\u044c \u044d\u0442\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e, \u043a\u043e\u0433\u0434\u0430 \u0442\u0440\u0435\u043a \u0438\u0433\u0440\u0430\u0435\u0442, \u043d\u043e \u0431\u0430\u0441 \u0435\u043b\u0435 \u0441\u043b\u044b\u0448\u0435\u043d, \u0430 \u0432\u043e\u043a\u0430\u043b \u0442\u0435\u0440\u044f\u0435\u0442\u0441\u044f \u0432 \u0448\u0443\u043c\u0435 \u0443\u043b\u0438\u0446\u044b? \u042f \u043d\u0435\u043d\u0430\u0432\u0438\u0436\u0443 \u044d\u0442\u043e. \u0418\u043c\u0435\u043d\u043d\u043e \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u044f \u0434\u043e\u0431\u0430\u0432\u0438\u043b \u0432 Volume Booster \u0440\u0435\u0436\u0438\u043c \u00ab\u0423\u0441\u0438\u043b\u0435\u043d\u0438\u0435 \u0431\u0430\u0441\u043e\u0432\u00bb \u2014 \u043e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0433\u0440\u043e\u043c\u0447\u0435, \u043e\u043d \u0432\u044b\u0442\u0430\u0441\u043a\u0438\u0432\u0430\u0435\u0442 \u043d\u0438\u0437\u043a\u0438\u0435 \u0447\u0430\u0441\u0442\u043e\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u043e\u0431\u044b\u0447\u043d\u043e \u043f\u0440\u044f\u0447\u0435\u0442. \u0422\u044b \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0448\u044c \u0441\u043b\u044b\u0448\u0430\u0442\u044c \u0442\u043e, \u0447\u0435\u0433\u043e \u0440\u0430\u043d\u044c\u0448\u0435 \u043d\u0435 \u0437\u0430\u043c\u0435\u0447\u0430\u043b.",
    "\u0412\u043a\u043b\u044e\u0447\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441, \u043e\u0442\u043a\u0440\u043e\u0439 \u043b\u044e\u0431\u0443\u044e \u043f\u0435\u0441\u043d\u044e \u0432 Spotify \u0438\u043b\u0438 YouTube \u0438 \u043d\u0430\u0436\u043c\u0438 \u043d\u0430 \u043f\u0440\u0435\u0441\u0435\u0442 \u00ab\u042d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u0438\u043a\u0430\u00bb \u0438\u043b\u0438 \u00ab\u0420\u043e\u043a\u00bb. \u0423\u0441\u043b\u044b\u0448\u0438\u0448\u044c \u0440\u0430\u0437\u043d\u0438\u0446\u0443 \u0437\u0430 5 \u0441\u0435\u043a\u0443\u043d\u0434. \u042d\u0442\u043e \u043d\u0435 \u043c\u0430\u0433\u0438\u044f, \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u044f \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043b \u043f\u043e\u043b\u0433\u043e\u0434\u0430.",
    "\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u044d\u0442\u043e \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u2014 \u043e\u0442\u043a\u0440\u043e\u0439 Volume Booster \u0438 \u0432\u044b\u0431\u0435\u0440\u0438 \u043f\u0440\u0435\u0441\u0435\u0442 \u00ab\u0423\u0441\u0438\u043b\u0435\u043d\u0438\u0435 \u0431\u0430\u0441\u043e\u0432\u00bb. P.S. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f, \u0433\u043b\u044f\u043d\u044c \u043d\u0430 Premium \u2014 \u0442\u0430\u043c \u043c\u043e\u0436\u043d\u043e \u0441\u0430\u043c\u043e\u043c\u0443 \u043a\u0440\u0443\u0442\u0438\u0442\u044c \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440. \u041d\u043e \u0434\u0430\u0436\u0435 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u0445\u0432\u0430\u0442\u0438\u0442, \u0447\u0442\u043e\u0431\u044b \u0442\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0437\u0430\u0437\u0432\u0443\u0447\u0430\u043b \u043f\u043e-\u043d\u043e\u0432\u043e\u043c\u0443."
  ],
