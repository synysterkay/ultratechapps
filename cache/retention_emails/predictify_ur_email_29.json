{
  "subject": "\u0622\u067e \u06a9\u06d2 68 \u062f\u0646\u0648\u06ba \u06a9\u0627 \u0634\u06a9\u0631\u06cc\u06c1 - \u0627\u06cc\u06a9 \u062e\u0627\u0635 \u062a\u062d\u0641\u06c1",
  "preview_text": "\u06c1\u0645 \u0646\u06d2 \u0622\u067e \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u0686\u06be \u0627\u06cc\u0633\u0627 \u0628\u0646\u0627\u06cc\u0627 \u06c1\u06d2 \u062c\u0648 \u0635\u0631\u0641 \u0637\u0648\u06cc\u0644 \u0627\u0644\u0645\u062f\u062a \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0645\u0644\u062a\u0627 \u06c1\u06d2\u06d4 \u062c\u0627\u0646\u06cc\u06d2 \u0648\u06c1 \u06a9\u06cc\u0627 \u06c1\u06d2\u06d4",
  "body_paragraphs": [
    "68 \u062f\u0646 \u067e\u06c1\u0644\u06d2 \u0622\u067e \u0646\u06d2 Preductify \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u06cc\u0627 \u062a\u06be\u0627\u06d4 \u0622\u062c \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u0628\u062a\u0627\u0646\u0627 \u0686\u0627\u06c1\u062a\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u0622\u067e \u0635\u0631\u0641 \u0627\u06cc\u06a9 \u0635\u0627\u0631\u0641 \u0646\u06c1\u06cc\u06ba\u060c \u0628\u0644\u06a9\u06c1 \u06c1\u0645\u0627\u0631\u06cc \u0628\u0631\u0627\u062f\u0631\u06cc \u06a9\u0627 \u0627\u06cc\u06a9 \u0633\u062a\u0648\u0646 \u06c1\u06cc\u06ba\u06d4",
    "\u06c1\u0631 \u0645\u06cc\u0686 \u06a9\u06cc \u067e\u06cc\u0634\u06af\u0648\u0626\u06cc\u060c \u06c1\u0631 \u062a\u062c\u0632\u06cc\u06c1\u060c \u0627\u0648\u0631 \u06c1\u0631 \u0688\u06cc\u0679\u0627 \u067e\u0648\u0627\u0626\u0646\u0679 \u0622\u067e \u06a9\u06cc \u0645\u062f\u062f \u0633\u06d2 \u0628\u06c1\u062a\u0631 \u06c1\u0648\u0627 \u06c1\u06d2\u06d4 \u0622\u067e \u06a9\u06d2 \u0641\u06cc\u0688 \u0628\u06cc\u06a9 \u0646\u06d2 \u06c1\u0645\u06cc\u06ba \u0633\u06a9\u06be\u0627\u06cc\u0627 \u06a9\u06c1 \u0635\u0631\u0641 \u0646\u0645\u0628\u0631 \u0646\u06c1\u06cc\u06ba\u060c \u0628\u0644\u06a9\u06c1 \u0627\u0646 \u06a9\u06d2 \u067e\u06cc\u0686\u06be\u06d2 \u06a9\u06cc \u06a9\u06c1\u0627\u0646\u06cc \u0627\u06c1\u0645 \u06c1\u06d2\u06d4",
    "\u0627\u0633\u06cc \u0644\u06cc\u06d2 \u06c1\u0645 \u0646\u06d2 \u0622\u067e \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u06a9 \u062e\u0627\u0635 '\u0627\u0646\u062f\u0631\u0648\u0646\u06cc \u0631\u0633\u0627\u0626\u06cc' \u0641\u06cc\u0686\u0631 \u062a\u06cc\u0627\u0631 \u06a9\u06cc\u0627 \u06c1\u06d2 \u062c\u0648 \u0635\u0631\u0641 \u0627\u0646 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0645\u0644\u062a\u0627 \u06c1\u06d2 \u062c\u0648 60 \u062f\u0646 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u06c1\u0645\u0627\u0631\u06d2 \u0633\u0627\u062a\u06be \u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1 \u0627\u06cc\u06a9 \u067e\u0631\u0627\u0626\u06cc\u0648\u06cc\u0679 \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc \u06c1\u06d2 \u062c\u06c1\u0627\u06ba \u0622\u067e AI \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0628\u0631\u0627\u06c1 \u0631\u0627\u0633\u062a \u0628\u0627\u062a \u0686\u06cc\u062a \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0627\u0648\u0631 \u0622\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0645\u06cc\u0686\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u062e\u0641\u06cc\u06c1 \u067e\u06cc\u0634\u06af\u0648\u0626\u06cc\u0627\u06ba \u062f\u06cc\u06a9\u06be \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",
    "\u0627\u0628\u06be\u06cc Preductify \u06a9\u06be\u0648\u0644\u06cc\u06ba \u0627\u0648\u0631 \u0627\u067e\u0646\u06d2 \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u0645\u06cc\u06ba '\u062e\u0635\u0648\u0635\u06cc \u0631\u0633\u0627\u0626\u06cc' \u06a9\u06d2 \u0628\u0679\u0646 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 \u067e\u06cc \u0627\u06cc\u0633: \u06cc\u06c1 \u0631\u0633\u0627\u0626\u06cc \u0635\u0631\u0641 7 \u062f\u0646 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06c1\u06d2 - \u0627\u0633 \u06a9\u06d2 \u0628\u0639\u062f \u06cc\u06c1 \u06c1\u0645\u06cc\u0634\u06c1 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062e\u062a\u0645 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u06cc\u06d4"
