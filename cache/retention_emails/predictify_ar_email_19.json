{
  "subject": "\u0645\u064a\u0632\u0629 \u062c\u062f\u064a\u062f\u0629 \u0641\u064a Predictify \u0633\u062a\u063a\u064a\u0631 \u062a\u0648\u0642\u0639\u0627\u062a\u0643",
  "preview_text": "\u0646\u062d\u0646 \u0646\u0639\u0645\u0644 \u0639\u0644\u0649 \u0634\u064a\u0621 \u0643\u0628\u064a\u0631 \u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646\u0627 \u0627\u0644\u0645\u062e\u0644\u0635\u064a\u0646. \u0647\u0644 \u0623\u0646\u062a \u0645\u0633\u062a\u0639\u062f \u0644\u0631\u0624\u064a\u062a\u0647 \u0623\u0648\u0644\u0627\u064b\u061f",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u062a\u0633\u062a\u0637\u064a\u0639 \u0631\u0624\u064a\u0629 \u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0642\u0628\u0644 \u0623\u0646 \u062a\u0646\u062a\u0647\u064a. \u0647\u0630\u0627 \u0645\u0627 \u0643\u0646\u0627 \u0646\u0639\u0645\u0644 \u0639\u0644\u064a\u0647 \u0641\u064a \u0627\u0644\u062e\u0641\u0627\u0621 \u062e\u0644\u0627\u0644 \u0627\u0644\u0623\u0633\u0627\u0628\u064a\u0639 \u0627\u0644\u0645\u0627\u0636\u064a\u0629\u060c \u0648\u0642\u0631\u0631\u0646\u0627 \u0623\u0646 \u0646\u0634\u0627\u0631\u0643\u0643 \u0627\u0644\u062e\u0628\u0631 \u0623\u0648\u0644\u0627\u064b \u0644\u0623\u0646\u0643 \u062c\u0632\u0621 \u0645\u0646 \u0645\u062c\u062a\u0645\u0639\u0646\u0627.",
    "\u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0633\u062a\u0633\u0645\u062d \u0644\u0643 \u0628\u0645\u0642\u0627\u0631\u0646\u0629 \u062a\u0648\u0642\u0639\u0627\u062a\u0643 \u0645\u0639 \u062a\u0648\u0642\u0639\u0627\u062a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0641\u0639\u0644\u064a. \u0633\u062a\u0634\u0627\u0647\u062f \u0643\u064a\u0641 \u062a\u062a\u063a\u064a\u0631 \u0627\u0644\u0646\u0633\u0628 \u0627\u0644\u0645\u0626\u0648\u064a\u0629 \u0644\u0644\u0641\u0648\u0632 \u0645\u0639 \u0643\u0644 \u062f\u0642\u064a\u0642\u0629 \u0641\u064a \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u062a\u062d\u062f\u064a\u062b \u0639\u0627\u062f\u064a\u060c \u0628\u0644 \u0646\u0642\u0644\u0629 \u0646\u0648\u0639\u064a\u0629 \u0641\u064a \u0639\u0627\u0644\u0645 \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a.",
    "\u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u0641\u064a \u0645\u0646\u062a\u0635\u0641 \u0645\u0628\u0627\u0631\u0627\u0629 \u0628\u0631\u0634\u0644\u0648\u0646\u0629 \u0636\u062f \u0631\u064a\u0627\u0644 \u0645\u062f\u0631\u064a\u062f\u060c \u0648\u062a\u0633\u062a\u0637\u064a\u0639 \u0631\u0624\u064a\u0629 \u0623\u0646 \u0641\u0631\u0635\u0629 \u0641\u0648\u0632 \u0628\u0631\u0634\u0644\u0648\u0646\u0629 \u0627\u0631\u062a\u0641\u0639\u062a \u0645\u0646 45% \u0625\u0644\u0649 68% \u0628\u0639\u062f \u0637\u0631\u062f \u0644\u0627\u0639\u0628 \u0627\u0644\u062e\u0635\u0645. \u0647\u0630\u0627 \u0627\u0644\u0646\u0648\u0639 \u0645\u0646 \u0627\u0644\u062a\u062d\u0644\u064a\u0644 \u0633\u064a\u0635\u0628\u062d \u0645\u062a\u0627\u062d\u0627\u064b \u0644\u0643 \u0641\u064a Predictify \u0642\u0631\u064a\u0628\u0627\u064b \u062c\u062f\u0627\u064b.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628 \u0645\u064a\u0632\u0629 '\u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a \u0627\u0644\u062d\u064a\u0629' \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0627\u0644\u062a\u064a \u0623\u0636\u0641\u0646\u0627\u0647\u0627 \u062e\u0635\u064a\u0635\u0627\u064b \u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646\u0627 \u0627\u0644\u0645\u062c\u062a\u0647\u062f\u064a\u0646. \u0623\u0646\u062a \u0623\u0648\u0644 \u0645\u0646 \u064a\u0639\u0631\u0641 \u0639\u0646\u0647\u0627. \n\n\u0645\u0644\u0627\u062d\u0638\u0629: \u0625\u0630\u0627 \u0643\u0646\u062a \u0645\u0634\u062a\u0631\u0643\u0627\u064b \u0641\u064a \u0627\u0644\u0628\u0631\u064a\u0645\u064a\u0648\u0645\u060c \u0633\u062a\u062d\u0635\u0644 \u0639\u0644\u0649 \u0625\u0634\u0639\u0627\u0631 \u0641\u0648\u0631\u064a \u0639\u0646\u062f \u0625\u0637\u0644\u0627\u0642 \u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u0643\u0628\u064a\u0631\u0629 \u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0642\u0627\u062f\u0645."
