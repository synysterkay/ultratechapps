{
  "subject": "\u0644\u06cc\u06af \u0642\u0647\u0631\u0645\u0627\u0646\u0627\u0646 \u0627\u0645\u0634\u0628 - \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u06f7\u06f2 \u062f\u0631\u0635\u062f\u06cc",
  "preview_text": "\u0627\u0645\u0634\u0628 \u0628\u0627\u0632\u06cc \u0628\u0627\u0631\u0633\u0644\u0648\u0646\u0627 \u0648 \u0628\u0627\u06cc\u0631\u0646 \u0645\u0648\u0646\u06cc\u062e\u0647. \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc Predictify \u06cc\u0647 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u062e\u0627\u0635 \u062f\u0627\u0631\u0647. \u0628\u06cc\u0627 \u0628\u0628\u06cc\u0646.",
  "body_paragraphs": [
    "\u0627\u0645\u0634\u0628 \u0628\u0627\u0631\u0633\u0644\u0648\u0646\u0627 \u0648 \u0628\u0627\u06cc\u0631\u0646 \u0645\u0648\u0646\u06cc\u062e \u0631\u0648\u0628\u0631\u0648 \u0647\u0645 \u0642\u0631\u0627\u0631 \u0645\u06cc\u200c\u06af\u06cc\u0631\u0646. \u062a\u0648\u06cc \u06f1\u06f0 \u0628\u0627\u0632\u06cc \u0642\u0628\u0644\u06cc\u060c \u0628\u0627\u06cc\u0631\u0646 \u06f7 \u0628\u0627\u0631 \u0628\u0631\u0646\u062f\u0647 \u0634\u062f\u0647. \u0627\u0645\u0627 \u0628\u0627\u0631\u0633\u0644\u0648\u0646\u0627 \u062a\u0648\u06cc \u0628\u0627\u0632\u06cc\u200c\u0647\u0627\u06cc \u062e\u0627\u0646\u06af\u06cc \u0627\u06cc\u0646 \u0641\u0635\u0644 \u0641\u0631\u0645 \u062e\u0648\u0628\u06cc \u062f\u0627\u0634\u062a\u0647. \u0686\u06cc \u0641\u06a9\u0631 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u061f",
    "\u062f\u0627\u062f\u0647\u200c\u0647\u0627 \u0645\u06cc\u200c\u06af\u0646 \u0628\u0627\u06cc\u0631\u0646 \u0628\u0627 \u06f6\u06f5 \u062f\u0631\u0635\u062f \u0634\u0627\u0646\u0633 \u067e\u06cc\u0631\u0648\u0632\u06cc \u062c\u0644\u0648\u0626\u0647\u060c \u0627\u0645\u0627 \u0628\u0627\u0631\u0633\u0644\u0648\u0646\u0627 \u062a\u0648\u06cc \u0636\u0631\u0628\u0627\u062a \u0627\u06cc\u0633\u062a\u06af\u0627\u0647\u06cc \u062e\u0637\u0631\u0646\u0627\u06a9\u0647. \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc Predictify \u0628\u0627 \u062a\u062d\u0644\u06cc\u0644 \u0628\u06cc\u0634 \u0627\u0632 \u06f5\u06f0\u06f0\u06f0 \u0645\u062a\u063a\u06cc\u0631\u060c \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u062c\u0627\u0644\u0628\u06cc \u062f\u0627\u0631\u0647 \u06a9\u0647 \u0645\u06cc\u200c\u062a\u0648\u0646\u0647 \u0646\u0638\u0631\u062a \u0631\u0648 \u0639\u0648\u0636 \u06a9\u0646\u0647.",
    "\u06a9\u0627\u0641\u06cc\u0647 \u0627\u067e \u0631\u0648 \u0628\u0627\u0632 \u06a9\u0646\u06cc \u0648 \u0628\u0631\u06cc \u0628\u0647 \u0628\u062e\u0634 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc\u200c\u0647\u0627\u06cc \u0647\u0648\u0634\u0645\u0646\u062f. \u0627\u0648\u0646\u200c\u062c\u0627 \u06cc\u0647 \u062f\u06a9\u0645\u0647 \u0645\u062e\u0635\u0648\u0635 \u0628\u0631\u0627\u06cc \u0645\u0633\u0627\u0628\u0642\u0647 \u0627\u0645\u0634\u0628 \u0647\u0633\u062a. \u0628\u0627 \u06cc\u0647 \u06a9\u0644\u06cc\u06a9\u060c \u0647\u0645\u0647 \u0622\u0645\u0627\u0631 \u0648 \u0627\u062d\u062a\u0645\u0627\u0644\u0627\u062a \u0631\u0648 \u0645\u06cc\u200c\u0628\u06cc\u0646\u06cc. \u062d\u062a\u06cc \u0645\u06cc\u200c\u062a\u0648\u0646\u06cc \u0646\u0638\u0631 \u062e\u0648\u062f\u062a \u0631\u0648 \u062a\u0648\u06cc \u0627\u0646\u062c\u0645\u0646 \u0628\u0632\u0627\u0631\u06cc \u0648 \u0628\u0627 \u0628\u0642\u06cc\u0647 \u0647\u0648\u0627\u062f\u0627\u0631\u0627 \u0628\u062d\u062b \u06a9\u0646\u06cc.",
    "\u0627\u0645\u0634\u0628 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0648\u0642\u062a\u0647 \u06a9\u0647 \u0627\u0632 \u0627\u06cc\u0646 \u0648\u06cc\u0698\u06af\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc. \u0627\u067e \u0631\u0648 \u0628\u0627\u0632 \u06a9\u0646 \u0648 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u0627\u0645\u0634\u0628 \u0631\u0648 \u0628\u0628\u06cc\u0646. P.S. \u0627\u06af\u0647 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc\u200c\u0647\u0627\u062a \u062f\u0631\u0633\u062a \u0627\u0632 \u0622\u0628 \u062f\u0631\u0628\u06cc\u0627\u062f\u060c \u0627\u0645\u062a\u06cc\u0627\u0632 \u0645\u06cc\u200c\u06af\u06cc\u0631\u06cc \u0648 \u062a\u0648 \u062c\u062f\u0648\u0644 \u0628\u0627\u0644\u0627 \u0645\u06cc\u200c\u0622\u06cc. \u0627\u0632 \u062f\u0633\u062a \u0646\u062f\u0647."
