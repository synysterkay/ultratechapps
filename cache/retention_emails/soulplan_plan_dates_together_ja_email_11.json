    "\u4f8b\u3048\u3070\u3001\u30a2\u30d7\u30ea\u306e\u300c\u30c7\u30fc\u30c8\u5c65\u6b74\u300d\u6a5f\u80fd\u3092\u4f7f\u3048\u3070\u3001\u4f55\u304c\u697d\u3057\u304b\u3063\u305f\u304b\u660e\u78ba\u306b\u306a\u308b\u3002AI\u304c\u3042\u306a\u305f\u306e\u597d\u307f\u3092\u5b66\u7fd2\u3057\u3066\u3001\u6bce\u56de\u65b0\u9bae\u306a\u30a2\u30a4\u30c7\u30a2\u3092\u63d0\u6848\u3059\u308b\u304b\u3089\u3001\u3082\u3046\u300c\u3069\u3046\u3057\u3088\u3046\uff1f\u300d\u3068\u8ff7\u308f\u306a\u3044\u3002\u5171\u6709\u30a6\u30a3\u30c3\u30b7\u30e5\u30ea\u30b9\u30c8\u3067\u672a\u6765\u306e\u30c7\u30fc\u30c8\u3092\u8a9e\u308a\u5408\u3046\u306e\u3082\u3001\u5b9f\u306f\u3059\u3054\u304f\u30ed\u30de\u30f3\u30c1\u30c3\u30af\u306a\u3093\u3060\u3088\u3002",
    "\u4eca\u65e5\u306f\u3001\u30a2\u30d7\u30ea\u3092\u958b\u3044\u3066\u300c\u30c7\u30fc\u30c8\u5c65\u6b74\u300d\u3092\u30c1\u30a7\u30c3\u30af\u3057\u3066\u3001\u904e\u53bb\u306e\u30c7\u30fc\u30c8\u3092\u632f\u308a\u8fd4\u3063\u3066\u307f\u3066\u3002\u305d\u3057\u3066\u3001\u307e\u3060\u8a66\u3057\u3066\u306a\u3044\u300c\u5171\u6709\u30a6\u30a3\u30c3\u30b7\u30e5\u30ea\u30b9\u30c8\u300d\u3067\u3001\u6b21\u306e\u30c7\u30fc\u30c8\u30921\u3064\u8ffd\u52a0\u3057\u3066\u307f\u3066\u3002\nP.S. \u5b9f\u306f\u3001\u8a08\u753b\u3057\u306a\u3044\u30c7\u30fc\u30c8\u306f91%\u306e\u78ba\u7387\u3067\u300c\u307e\u3042\u307e\u3042\u300d\u3067\u7d42\u308f\u308b\u3063\u3066\u77e5\u3063\u3066\u305f\uff1f\u3053\u306e\u30c7\u30fc\u30bf\u3001SoulPlan\u306e\u5185\u90e8\u8abf\u67fb\u3067\u5206\u304b\u3063\u305f\u3093\u3060\u3002"
