{
  "subject": "\u0939\u092e\u0928\u0947 \u090f\u0915 \u0917\u0932\u0924\u0940 \u0915\u0940 \u091c\u094b 90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902",
  "preview_text": "10,000 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0921\u0947\u091f\u093e \u092e\u0947\u0902 \u091b\u093f\u092a\u093e \u090f\u0915 \u091d\u091f\u0915\u093e \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u093e \u0938\u091a\u0964 \u0906\u092a \u092d\u0940 \u0936\u093e\u092f\u0926 \u092f\u0939\u0940 \u0915\u0930 \u0930\u0939\u0947 \u0939\u094b\u0902\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 \u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0928\u0947 10,000 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0911\u0921\u093f\u092f\u094b \u092c\u0942\u0938\u094d\u091f\u093f\u0902\u0917 \u0921\u0947\u091f\u093e \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u093f\u092f\u093e\u0964 \u091c\u094b \u0939\u092e\u0928\u0947 \u0926\u0947\u0916\u093e, \u0909\u0938\u0938\u0947 \u0939\u092e\u093e\u0930\u0940 \u0928\u0940\u0902\u0926 \u0909\u0921\u093c \u0917\u0908\u0964 \u090f\u0915 \u091a\u0940\u091c\u093c \u0932\u0917\u092d\u0917 \u0938\u092d\u0940 \u0917\u0932\u0924 \u0915\u0930 \u0930\u0939\u0947 \u0925\u0947\u0964",
    "\u0939\u092e\u0928\u0947 \u092a\u093e\u092f\u093e \u0915\u093f 87% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0938\u093f\u0930\u094d\u092b\u093c \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b \u092e\u0948\u0915\u094d\u0938 \u092a\u0930 \u0916\u0940\u0902\u091a\u0915\u0930 \u091b\u094b\u0921\u093c \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u092c\u0921\u093c\u0940 \u092d\u0942\u0932 \u0939\u0948\u0964 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0938\u093f\u0930\u094d\u092b\u093c \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u0938\u0947 \u0938\u093e\u0909\u0902\u0921 \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0939\u094b\u0924\u093e \u0939\u0948, \u092c\u0947\u0938 \u0921\u0942\u092c \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0905\u0938\u0932\u0940 \u092e\u0948\u091c\u093f\u0915 \u0924\u092c \u0939\u094b\u0924\u093e \u0939\u0948 \u091c\u092c \u0906\u092a \u092c\u0942\u0938\u094d\u091f \u0915\u0947 \u0938\u093e\u0925 EQ \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938 \u0915\u094b \u092e\u093f\u0932\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u092f\u0939\u0940 \u0935\u094b \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0939\u0948 \u091c\u094b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902\u0964 '\u0930\u0949\u0915' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0938\u093f\u0930\u094d\u092b\u093c \u0917\u093f\u091f\u093e\u0930 \u0924\u0947\u091c\u093c \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e, \u092f\u0939 \u0935\u094b\u0915\u0932\u094d\u0938 \u0915\u094b \u0915\u094d\u0932\u093f\u092f\u0930 \u0930\u0916\u0924\u0947 \u0939\u0941\u090f \u092c\u0947\u0938 \u0915\u094b \u0917\u0939\u0930\u093e \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964 '\u092a\u0949\u092a' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u092c\u0948\u0915\u0917\u094d\u0930\u093e\u0909\u0902\u0921 \u0928\u0949\u0907\u091c\u093c \u0915\u092e \u0915\u0930\u0915\u0947 \u092e\u094d\u092f\u0942\u091c\u093c\u093f\u0915 \u0915\u094b \u0930\u0942\u092e \u0915\u0947 \u0915\u094b\u0928\u0947 \u0924\u0915 \u092a\u0939\u0941\u0901\u091a\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092a\u0928\u0940 \u0910\u092a \u0905\u092d\u0940 \u0916\u094b\u0932\u0947\u0902\u0964 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0917\u093e\u0928\u0947 \u092f\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u092a\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f \u0911\u0928 \u0915\u0930\u0947\u0902, \u0914\u0930 \u092b\u093f\u0930 EQ \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u091c\u093e\u0915\u0930 '\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915' \u092f\u093e '\u0915\u094d\u0932\u093e\u0938\u093f\u0915\u0932' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902\u0964 \u092b\u0930\u094d\u0915 \u092e\u0939\u0938\u0942\u0938 \u0939\u094b\u0917\u093e\u0964 P.S.: \u091c\u094b \u092f\u0942\u091c\u093c\u0930\u094d\u0938 EQ \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0910\u092a \u0915\u094b \u0930\u094b\u091c\u093c\u093e\u0928\u093e 3 \u0917\u0941\u0928\u093e \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0916\u094b\u0932\u0924\u0947 \u0939\u0948\u0902\u0964 \u0936\u093e\u092f\u0926 \u0907\u0938\u0932\u093f\u090f \u0915\u093f \u0909\u0928\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u091a\u0932 \u0917\u092f\u093e \u0915\u093f \u0905\u0938\u0932\u0940 \u092a\u093e\u0935\u0930 \u0915\u0939\u093e\u0901 \u091b\u093f\u092a\u0940 \u0939\u0948\u0964"
  ],
