{
  "subject": "2AM \u0438 \u043f\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0432\u044b \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u043b\u0438",
  "preview_text": "\u041c\u044b \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438 \u0442\u0438\u0448\u0438\u043d\u0443 \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438. \u0412\u0437\u0433\u043b\u044f\u043d\u0438\u0442\u0435, \u043f\u043e\u043a\u0430 \u043d\u0435 \u0437\u0430\u043a\u0440\u043e\u0435\u0442\u0435.",
  "body_paragraphs": [
    "\u0412\u044b \u0443\u0448\u043b\u0438, \u0438 \u0447\u0442\u043e-\u0442\u043e \u0441\u043b\u0443\u0447\u0438\u043b\u043e\u0441\u044c. \u0411\u0435\u0437 \u0448\u0443\u043c\u0430, \u0431\u0435\u0437 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0439 \u2014 \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0438\u0445\u043e\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435. \u041a\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u043a\u0442\u043e-\u0442\u043e \u0437\u0430\u0448\u0451\u043b \u043d\u043e\u0447\u044c\u044e \u0438 \u043f\u043e\u0434\u043a\u0440\u0443\u0442\u0438\u043b \u0432\u0441\u0435 \u0440\u0443\u0447\u043a\u0438 \u0432 \u0432\u0430\u0448\u0443 \u043f\u043e\u043b\u044c\u0437\u0443.",
    "\u041f\u043e\u043c\u043d\u0438\u0442\u0435 \u0442\u0435 \u0440\u0435\u043a\u043b\u0430\u043c\u043d\u044b\u0435 \u043f\u0430\u0443\u0437\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b\u0438? \u0418\u0445 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435\u0442. \u0412\u0441\u0451, \u0447\u0442\u043e \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u2014 \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a, \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u0438 \u043f\u0443\u0441\u0442\u043e\u0442\u0430. \u041c\u044b \u0443\u0431\u0440\u0430\u043b\u0438 \u0432\u0441\u0451 \u043b\u0438\u0448\u043d\u0435\u0435, \u0447\u0442\u043e\u0431\u044b \u0432\u044b \u043c\u043e\u0433\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0437\u0432\u0443\u043a \u0438 \u0437\u0430\u0431\u044b\u0442\u044c \u043f\u0440\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435.",
    "\u0422\u0435\u043f\u0435\u0440\u044c \u043f\u0440\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0435 \u0432\u044b \u0443\u0432\u0438\u0434\u0438\u0442\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u043d\u043e: \u0432\u0430\u0448 \u0441\u043b\u0430\u0439\u0434\u0435\u0440 \u043d\u0430 200% \u0438 \u0442\u0438\u0448\u0438\u043d\u0443. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439, \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0439. \u042d\u0442\u043e \u043d\u0435 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u2014 \u044d\u0442\u043e \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u0432\u0441\u0435\u0433\u043e, \u0447\u0442\u043e \u043c\u0435\u0448\u0430\u043b\u043e. \u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435 \u0440\u0430\u0437\u043d\u0438\u0446\u0443.",
    "\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \u043d\u0438\u0436\u0435, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c. P.S. \u0415\u0441\u043b\u0438 \u0432\u044b \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438, \u043e\u043d\u043e \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u0441\u044f \u0441\u0430\u043c\u043e \u2014 \u0431\u0435\u0437 \u043b\u0438\u0448\u043d\u0438\u0445 \u043a\u043b\u0438\u043a\u043e\u0432. \u041f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435."
