{
  "subject": "\u0634\u062e\u0635 \u0648\u0627\u062d\u062f \u064a\u062d\u062a\u0627\u062c \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642",
  "preview_text": "\u0623\u0646\u062a \u062a\u0639\u0631\u0641 \u0645\u0646 \u0647\u0648. \u0634\u0627\u0631\u0643 \u0645\u0639\u0647 \u0648\u0627\u0646\u0638\u0631 \u0643\u064a\u0641 \u0633\u064a\u0634\u0643\u0631\u0643.",
  "body_paragraphs": [
    "\u0641\u0643\u0631 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0634\u062e\u0635 \u0627\u0644\u0630\u064a \u064a\u0634\u062a\u0643\u064a \u062f\u0627\u0626\u0645\u0627\u064b \u0645\u0646 \u0623\u0646 \u0635\u0648\u062a\u0647 \u0631\u062f\u064a\u0621 \u0641\u064a \u0627\u0644\u0623\u063a\u0627\u0646\u064a \u0627\u0644\u062a\u064a \u064a\u062d\u0628\u0647\u0627. \u062a\u0639\u0631\u0641\u0647\u060c \u0630\u0644\u0643 \u0627\u0644\u0635\u062f\u064a\u0642 \u0627\u0644\u0630\u064a \u064a\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0625\u0644\u0649 \u0623\u0642\u0635\u0649 \u062d\u062f \u0644\u0643\u0646\u0647 \u0644\u0627 \u064a\u0632\u0627\u0644 \u064a\u0634\u0639\u0631 \u0623\u0646 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0641\u0627\u0631\u063a\u0629.",
    "\u0627\u0644\u0622\u0646 \u062a\u062e\u064a\u0644 \u0623\u0646 \u062a\u0639\u0637\u064a\u0647 \u0647\u0627\u062a\u0641\u0643 \u0628\u0639\u062f \u062a\u0641\u0639\u064a\u0644 Bass Booster. \u0633\u064a\u0634\u0639\u0631 \u0628\u0627\u0644\u0636\u0631\u0628\u0629 \u0641\u064a \u0635\u062f\u0631\u0647 \u0644\u0623\u0648\u0644 \u0645\u0631\u0629. \u0633\u064a\u0646\u0638\u0631 \u0625\u0644\u064a\u0643 \u0648\u0643\u0623\u0646\u0643 \u0645\u0646\u062d\u062a \u0647\u062f\u064a\u0629 \u062b\u0645\u064a\u0646\u0629. \u0644\u0623\u0646\u0643 \u0641\u0639\u0644\u062a.",
    "\u062e\u0627\u0635\u064a\u0629 Boost slider \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u062a\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0662\u0660\u0660\u066a \u0648\u062a\u062c\u0639\u0644 \u0643\u0644 \u0625\u064a\u0642\u0627\u0639 \u064a\u0646\u0628\u0636 \u0643\u0623\u0646\u0647 \u0645\u0643\u0628\u0631 \u0635\u0648\u062a \u062d\u0642\u064a\u0642\u064a. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646 \u0645\u0639 \u0623\u063a\u0646\u064a\u062a\u0647 \u0627\u0644\u0645\u0641\u0636\u0644\u0629\u060c \u062b\u0645 \u0634\u0627\u0631\u0643\u0647\u0627 \u0645\u0639\u0647.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0648\u0627\u0633\u062d\u0628 Boost slider \u0625\u0644\u0649 \u0623\u0642\u0635\u0649 \u0627\u0644\u064a\u0645\u064a\u0646\u060c \u0648\u0627\u062e\u062a\u0628\u0631 \u0627\u0644\u0635\u0648\u062a. \u0628\u0639\u062f\u0647\u0627\u060c \u0623\u0631\u0633\u0644 \u0631\u0627\u0628\u0637 \u0627\u0644\u062a\u062d\u0645\u064a\u0644 \u0644\u0645\u0646 \u064a\u0633\u062a\u062d\u0642\u0647. \u0645\u0644\u0627\u062d\u0638\u0629: \u0647\u0630\u0627 \u0627\u0644\u0634\u062e\u0635 \u064a\u0639\u0631\u0641 \u0623\u0646\u0643 \u0645\u0646 \u0623\u0647\u062f\u0627\u0647 \u0647\u0630\u0647 \u0627\u0644\u062a\u062c\u0631\u0628\u0629."
  ],
