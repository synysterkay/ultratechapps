{
  "subject": "\u092e\u0948\u0902\u0928\u0947 \u0907\u0938 \u0910\u092a \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u092c\u0921\u093c\u0940 \u0917\u0932\u0924\u0940 \u0915\u0940",
  "preview_text": "90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0907\u0938 \u092b\u0940\u091a\u0930 \u0915\u094b \u092e\u093f\u0938 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u092b\u0941\u091f\u092c\u0949\u0932 IQ \u092c\u0926\u0932\u0928\u0947 \u0935\u093e\u0932\u093e \u0938\u091a\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 \u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u092c\u0939\u0938 \u0915\u0940\u0964 \u0935\u094b \u092e\u0948\u0928\u091a\u0947\u0938\u094d\u091f\u0930 \u092f\u0942\u0928\u093e\u0907\u091f\u0947\u0921 \u092c\u0928\u093e\u092e \u0906\u0930\u094d\u0938\u0947\u0928\u0932 \u092e\u0948\u091a \u0915\u093e \u0938\u094d\u0915\u094b\u0930 \u0932\u0917\u093e \u0930\u0939\u0947 \u0925\u0947\u0964 \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u0938\u0947 2-1 \u092c\u094b\u0932\u093e\u0964 \u092b\u093f\u0930 \u092e\u0948\u0902\u0928\u0947 \u0935\u094b \u090f\u0915 \u091a\u0940\u091c\u093c \u091a\u0947\u0915 \u0915\u0940 \u091c\u094b 90% \u0932\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964 \u0914\u0930 \u092e\u0947\u0930\u0940 \u0938\u093e\u0930\u0940 \u0927\u093e\u0930\u0923\u093e \u0909\u0932\u091f \u0917\u0908\u0964",
    "\u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u092f\u0942\u0928\u093e\u0907\u091f\u0947\u0921 \u0915\u093e \u0921\u093f\u092b\u0947\u0902\u0938 \u0907\u0938 \u0938\u0940\u091c\u093c\u0928 \u0915\u092e\u091c\u093c\u094b\u0930 \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0921\u0947\u091f\u093e \u0928\u0947 \u0915\u0941\u091b \u0914\u0930 \u0939\u0940 \u0915\u0939\u093e\u0928\u0940 \u092c\u0924\u093e\u0908\u0964 AI \u0928\u0947 \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u0935\u0947\u0930\u093f\u090f\u092c\u0932\u094d\u0938 \u091a\u0947\u0915 \u0915\u093f\u090f: xG, \u092a\u093f\u091b\u0932\u0947 5 \u092e\u0948\u091a\u094b\u0902 \u0915\u0940 \u092a\u094b\u091c\u093c\u0947\u0936\u0928 \u0930\u0947\u091f, \u0939\u0947\u0921-\u091f\u0942-\u0939\u0940\u0921 \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940, \u092f\u0939\u093e\u0901 \u0924\u0915 \u0915\u093f \u0935\u093f\u092a\u0915\u094d\u0937\u0940 \u091f\u0940\u092e \u0915\u0940 \u0905\u091f\u0948\u0915\u093f\u0902\u0917 \u090f\u092b\u093f\u0936\u093f\u090f\u0902\u0938\u0940 \u092d\u0940\u0964 \u0928\u0924\u0940\u091c\u093e? AI \u0915\u094b 78% \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0925\u093e \u0915\u093f \u092e\u0948\u091a 1-1 \u0930\u0939\u0947\u0917\u093e\u0964 \u0914\u0930 \u0939\u0948\u0930\u093e\u0928\u0940 \u0915\u0940 \u092c\u093e\u0924... \u0920\u0940\u0915 \u0935\u0948\u0938\u093e \u0939\u0940 \u0939\u0941\u0906\u0964",
    "\u092f\u0947 \u0938\u092c Predictify \u0915\u0947 '\u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930' \u092b\u0940\u091a\u0930 \u0938\u0947 \u092a\u0924\u093e \u091a\u0932\u093e\u0964 \u0939\u0930 \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u094d\u0915\u094b\u0930 \u0926\u093f\u0916\u0924\u093e \u0939\u0948 - \u092f\u0947 \u092c\u0924\u093e\u0924\u093e \u0939\u0948 \u0915\u093f AI \u0915\u093f\u0924\u0928\u093e \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u091f \u0939\u0948\u0964 70% \u0938\u0947 \u090a\u092a\u0930 \u0915\u093e \u0938\u094d\u0915\u094b\u0930 \u092e\u0924\u0932\u092c, \u0921\u0947\u091f\u093e \u0930\u0949\u0915 \u0938\u0949\u0932\u093f\u0921 \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u092e\u0948\u091a \u091a\u0941\u0928\u094b, \u0938\u094d\u0915\u094b\u0930 \u0926\u0947\u0916\u094b, \u0914\u0930 30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0905\u0902\u0926\u093e\u091c\u093c\u093e \u092c\u0926\u0932 \u091c\u093e\u090f\u0917\u093e\u0964 \u092f\u0947 \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u0928\u0939\u0940\u0902, \u0921\u0947\u091f\u093e \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0906\u091c \u0930\u093e\u0924 \u0915\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u092e\u0948\u091a \u0915\u093e \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0926\u0947\u0916\u094b\u0964 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u091a\u0932\u0947\u0917\u093e \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0905\u0902\u0926\u093e\u091c\u093c\u093e \u0915\u093f\u0924\u0928\u093e \u0938\u0939\u0940 \u092f\u093e \u0917\u0932\u0924 \u0939\u0948\u0964 \u092c\u091f\u0928 \u0926\u092c\u093e\u0913 \u0914\u0930 30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u092b\u0941\u091f\u092c\u0949\u0932 IQ \u091f\u0947\u0938\u094d\u091f \u0915\u0930\u094b\u0964 P.S.: \u0907\u0938 \u092b\u0940\u091a\u0930 \u0915\u094b \u092e\u093f\u0938 \u092e\u0924 \u0915\u0930\u094b, \u0928\u0939\u0940\u0902 \u0924\u094b \u0924\u0941\u092e \u0935\u094b '\u0935\u0948\u0932\u094d\u092f\u0942 \u092c\u0947\u091f' \u092e\u093f\u0938 \u0915\u0930 \u0926\u094b\u0917\u0947 \u091c\u093f\u0938\u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0938\u093f\u0930\u094d\u092b\u093c \u0921\u0947\u091f\u093e \u091c\u093e\u0928\u0924\u093e \u0939\u0948\u0964"
