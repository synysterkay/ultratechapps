{
  "subject": "\u4f6070\u5929\u7684\u6539\u53d8\uff0c\u8ba9200\u5bf9\u60c5\u4fa3\u91cd\u65b0\u7ea6\u4f1a",
  "preview_text": "\u4f60\u4e0d\u662f\u666e\u901a\u7528\u6237\uff0c\u4f60\u662f\u7075\u9b42\u8ba1\u5212\u7684\u5960\u57fa\u8005\u3002\u770b\u770b\u4f60\u7684\u6570\u636e\u5982\u4f55\u5851\u9020\u672a\u6765\u3002",
  "body_paragraphs": [
    "70\u5929\u524d\uff0c\u4f60\u4e0b\u8f7d\u4e86SoulPlan\u3002\u90a3\u65f6\uff0c\u5b83\u53ea\u662f\u4e00\u4e2a\u5e2e\u4f60\u7b56\u5212\u7ea6\u4f1a\u7684\u5de5\u5177\u3002\u73b0\u5728\uff0c\u5b83\u53d8\u6210\u4e86\u4ec0\u4e48\uff1f\u4f60\u6bcf\u665a\u6253\u5f00\u5b83\uff0c\u4e00\u952e\u9009\u62e9\u5fc3\u60c5\uff0c\u548c\u4f34\u4fa3\u8bb0\u5f55\u56de\u5fc6\u3002\u4f46\u4f60\u77e5\u9053\u5417\uff1f\u4f60\u7684\u6bcf\u4e00\u4e2a\u52a8\u4f5c\uff0c\u90fd\u5728\u6084\u6084\u6539\u5199\u7740\u8fd9\u6b3e\u5e94\u7528\u7684DNA\u3002\u4f60\u4e0d\u662f\u7528\u6237\uff0c\u4f60\u662f\u521b\u9020\u8005\u3002",
    "\u4e0a\u5468\uff0c\u6211\u4eec\u5206\u6790\u4e86\u524d1000\u5bf9\u60c5\u4fa3\u7684\u6570\u636e\u3002\u90a3\u4e9b\u575a\u6301\u4f7f\u7528\u201c\u4eca\u665a\u7684\u7ea6\u4f1a\u201d\u529f\u80fd\u7684\u60c5\u4fa3\uff0c\u8ba1\u5212\u6b21\u6570\u662f\u666e\u901a\u7528\u6237\u76844\u500d\u3002\u66f4\u5173\u952e\u7684\u662f\uff0c\u4ed6\u4eec\u5728\u201c\u8bb0\u5fc6\u65f6\u95f4\u7ebf\u201d\u4e0a\u7559\u4e0b\u7684\u7167\u7247\u548c\u7b14\u8bb0\uff0c\u8ba9\u611f\u60c5\u6df1\u5ea6\u63d0\u5347\u4e8640%\u3002\u8fd9\u4e9b\u6570\u5b57\u6765\u81ea\u4f60\u7684\u65e5\u5e38\u4f7f\u7528\uff0c\u5b83\u4eec\u4e0d\u662f\u51b7\u51b0\u51b0\u7684\u7edf\u8ba1\uff0c\u800c\u662f\u4f60\u4eec\u7231\u60c5\u6545\u4e8b\u7684\u89c1\u8bc1\u3002",
    "\u6211\u4eec\u4e00\u76f4\u76f8\u4fe1\uff0c\u7ea6\u4f1a\u4e0d\u662f\u4efb\u52a1\uff0c\u800c\u662f\u4eea\u5f0f\u3002\u6240\u4ee5\uff0c\u6211\u4eec\u63a8\u51fa\u4e86\u201c\u793e\u533a\u60c5\u4fa3\u201d\u529f\u80fd\uff0c\u8ba9\u4f60\u770b\u5230\u5176\u4ed6\u60c5\u4fa3\u7684\u6d6a\u6f2b\u77ac\u95f4\uff0c\u70b9\u8d5e\u3001\u8bc4\u8bba\uff0c\u751a\u81f3\u88ab\u4ed6\u4eec\u7684\u6545\u4e8b\u542f\u53d1\u3002\u4f60\u5df2\u7ecf\u662f\u8fd9\u4e2a\u793e\u533a\u7684\u4e00\u90e8\u5206\uff0c\u4f60\u7684\u6bcf\u4e00\u5f20\u7167\u7247\u3001\u6bcf\u4e00\u6761\u5907\u6ce8\uff0c\u90fd\u5728\u5e2e\u52a9\u5b83\u6210\u957f\u3002\u73b0\u5728\uff0c\u6253\u5f00\u201c\u8bb0\u5fc6\u65f6\u95f4\u7ebf\u201d\uff0c\u770b\u770b\u4f60\u548c\u4f34\u4fa3\u8fc7\u53bb70\u5929\u7684\u8f68\u8ff9\u3002\u90a3\u4e9b\u4f60\u51e0\u4e4e\u5fd8\u8bb0\u7684\u77ac\u95f4\uff0c\u6b63\u7b49\u7740\u88ab\u91cd\u65b0\u53d1\u73b0\u3002",
    "\u4eca\u5929\uff0c\u6253\u5f00SoulPlan\uff0c\u53bb\u201c\u8bb0\u5fc6\u65f6\u95f4\u7ebf\u201d\u6dfb\u52a0\u4e00\u5f20\u7167\u7247\u6216\u4e00\u6761\u7b14\u8bb0\u3002\u54ea\u6015\u53ea\u662f\u4e00\u53e5\u201c\u4eca\u665a\u7684\u706b\u9505\u5f88\u6696\u201d\uff0c\u4e5f\u80fd\u8ba9\u4f60\u4eec\u7684\u56de\u5fc6\u66f4\u5b8c\u6574\u3002P.S. \u6211\u4eec\u6b63\u5728\u5f00\u53d1\u4e00\u4e2a\u9690\u85cf\u529f\u80fd\uff0c\u57fa\u4e8e\u4f60\u7684\u201c\u613f\u671b\u6e05\u5355\u201d\u81ea\u52a8\u751f\u6210\u60ca\u559c\u7ea6\u4f1a\u3002\u53ea\u6709\u6d3b\u8dc3\u7528\u6237\u624d\u80fd\u5728\u4e0b\u4e2a\u6708\u62a2\u5148\u4f53\u9a8c\u3002"
  ],
