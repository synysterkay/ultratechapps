{
  "subject": "\u0397 \u03b1\u03bb\u03ae\u03b8\u03b5\u03b9\u03b1 \u03b3\u03b9\u03b1 \u03c4\u03b1 \u03c0\u03c1\u03bf\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03ac \u03bc\u03bf\u03c5",
  "preview_text": "\u0394\u03b5\u03bd \u03b3\u03c1\u03ac\u03c6\u03c9 \u03c3\u03c5\u03bd\u03ae\u03b8\u03c9\u03c2 \u03c4\u03ad\u03c4\u03bf\u03b9\u03b1 email, \u03b1\u03bb\u03bb\u03ac \u03b8\u03ad\u03bb\u03c9 \u03bd\u03b1 \u03c3\u03bf\u03c5 \u03c0\u03c9 \u03ba\u03ac\u03c4\u03b9 \u03c0\u03c1\u03bf\u03c3\u03c9\u03c0\u03b9\u03ba\u03cc. \u0394\u03b9\u03ac\u03b2\u03b1\u03c3\u03ad \u03c4\u03bf.",
  "body_paragraphs": [
    "\u0394\u03b5\u03bd \u03b3\u03c1\u03ac\u03c6\u03c9 \u03c3\u03c5\u03bd\u03ae\u03b8\u03c9\u03c2 \u03c4\u03ad\u03c4\u03bf\u03b9\u03b1 email. \u0394\u03b5\u03bd \u03b5\u03af\u03bc\u03b1\u03b9 \u03bf \u03c4\u03cd\u03c0\u03bf\u03c2 \u03c0\u03bf\u03c5 \u03b1\u03bd\u03bf\u03af\u03b3\u03b5\u03c4\u03b1\u03b9 \u03ad\u03c4\u03c3\u03b9. \u0391\u03bb\u03bb\u03ac \u03b5\u03af\u03c3\u03b1\u03b9 39 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03bc\u03b1\u03b6\u03af \u03bc\u03b1\u03c2, \u03ba\u03b1\u03b9 \u03ba\u03ac\u03c4\u03b9 \u03bc\u03b5 \u03c4\u03c1\u03ce\u03b5\u03b9. \u039e\u03ad\u03c1\u03b5\u03b9\u03c2 \u03c0\u03cc\u03c3\u03b5\u03c2 \u03ce\u03c1\u03b5\u03c2 \u03b4\u03bf\u03cd\u03bb\u03b5\u03c8\u03b1 \u03c0\u03ac\u03bd\u03c9 \u03c3\u03c4\u03bf Predictify; \u0391\u03bc\u03ad\u03c4\u03c1\u03b7\u03c4\u03b5\u03c2. \u039a\u03b1\u03b9 \u03ba\u03ac\u03b8\u03b5 \u03c6\u03bf\u03c1\u03ac \u03c0\u03bf\u03c5 \u03b2\u03bb\u03ad\u03c0\u03c9 \u03ad\u03bd\u03b1\u03bd \u03c7\u03c1\u03ae\u03c3\u03c4\u03b7 \u03bd\u03b1 \u03bc\u03b7\u03bd \u03b1\u03bd\u03bf\u03af\u03b3\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae, \u03bd\u03b9\u03ce\u03b8\u03c9 \u03c3\u03b1\u03bd \u03bd\u03b1 \u03ad\u03c7\u03b1\u03c3\u03b1 \u03ad\u03bd\u03b1 \u03c3\u03c4\u03bf\u03af\u03c7\u03b7\u03bc\u03b1 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03b5\u03b1\u03c5\u03c4\u03cc \u03bc\u03bf\u03c5.",
    "\u0398\u03b1 \u03c3\u03bf\u03c5 \u03c0\u03c9 \u03ba\u03ac\u03c4\u03b9 \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03bb\u03ad\u03c9 \u03c3\u03c5\u03c7\u03bd\u03ac: \u03bf\u03b9 \u03b1\u03bb\u03b3\u03cc\u03c1\u03b9\u03b8\u03bc\u03bf\u03af \u03bc\u03b1\u03c2 \u03b1\u03bd\u03b1\u03bb\u03cd\u03bf\u03c5\u03bd \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03b5\u03c2 \u03bc\u03b5\u03c4\u03b1\u03b2\u03bb\u03b7\u03c4\u03ad\u03c2 \u03b1\u03bd\u03ac \u03b1\u03b3\u03ce\u03bd\u03b1 \u2013 \u03b1\u03c0\u03cc xG \u03bc\u03ad\u03c7\u03c1\u03b9 \u03b1\u03bc\u03c5\u03bd\u03c4\u03b9\u03ba\u03ae \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u2013 \u03ba\u03b1\u03b9 \u03b4\u03af\u03bd\u03bf\u03c5\u03bd \u03c0\u03c1\u03bf\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03ac \u03bc\u03b5 \u03c3\u03b9\u03b3\u03bf\u03c5\u03c1\u03b9\u03ac. \u0391\u03bb\u03bb\u03ac \u03b1\u03bd \u03b4\u03b5\u03bd \u03c4\u03b1 \u03b4\u03b5\u03b9\u03c2, \u03b5\u03af\u03bd\u03b1\u03b9 \u03c3\u03b1\u03bd \u03bd\u03b1 \u03ad\u03c7\u03b5\u03b9\u03c2 \u03c4\u03bf\u03bd \u039c\u03ad\u03c3\u03b9 \u03c3\u03c4\u03bf\u03bd \u03c0\u03ac\u03b3\u03ba\u03bf \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03bc\u03b7\u03bd \u03c4\u03bf\u03bd \u03b2\u03ac\u03b6\u03b5\u03b9\u03c2 \u03c0\u03bf\u03c4\u03ad. \u0394\u03b5\u03bd \u03b8\u03ad\u03bb\u03c9 \u03bd\u03b1 \u03b5\u03af\u03c3\u03b1\u03b9 \u03b1\u03c5\u03c4\u03cc\u03c2 \u03bf \u03c0\u03c1\u03bf\u03c0\u03bf\u03bd\u03b7\u03c4\u03ae\u03c2.",
    "\u03a5\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9 \u03ad\u03bd\u03b1 \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03b7\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03c0\u03bf\u03c5 \u03b1\u03b3\u03b1\u03c0\u03ac\u03bd\u03b5 \u03bf\u03b9 \u03c0\u03b9\u03bf \u03ad\u03be\u03c5\u03c0\u03bd\u03bf\u03b9 \u03c6\u03af\u03bb\u03b1\u03b8\u03bb\u03bf\u03b9: \u03c4\u03b1 Confidence Scores. \u039a\u03ac\u03b8\u03b5 \u03c0\u03c1\u03cc\u03b2\u03bb\u03b5\u03c8\u03b7 \u03ad\u03c7\u03b5\u03b9 \u03ad\u03bd\u03b1 \u03c0\u03bf\u03c3\u03bf\u03c3\u03c4\u03cc \u2013 \u03be\u03ad\u03c1\u03b5\u03b9\u03c2 \u03b1\u03ba\u03c1\u03b9\u03b2\u03ce\u03c2 \u03c0\u03cc\u03c3\u03bf \u03c3\u03af\u03b3\u03bf\u03c5\u03c1\u03bf \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03bf \u03c3\u03cd\u03c3\u03c4\u03b7\u03bc\u03b1. \u039a\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03c3\u03ae\u03bc\u03b5\u03c1\u03b1, \u03ad\u03c7\u03c9 \u03ad\u03bd\u03b1 \u03c0\u03c1\u03bf\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03cc \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd Premier League \u03c0\u03bf\u03c5 \u03bc\u03bf\u03c5 \u03b1\u03c1\u03ad\u03c3\u03b5\u03b9 \u03c0\u03bf\u03bb\u03cd. \u0394\u03b5\u03bd \u03b8\u03b1 \u03c3\u03bf\u03c5 \u03c4\u03bf \u03c7\u03b1\u03bb\u03ac\u03c3\u03c9 \u03b5\u03b4\u03ce.",
    "\u0386\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03bf Predictify \u03c4\u03ce\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03b4\u03b5\u03c2 \u03c4\u03bf Prediction of the Day. \u0395\u03af\u03bd\u03b1\u03b9 \u03b5\u03ba\u03b5\u03af \u03b3\u03b9\u03b1 \u03c3\u03ad\u03bd\u03b1. P.S. \u0391\u03bd \u03b4\u03bf\u03ba\u03b9\u03bc\u03ac\u03c3\u03b5\u03b9\u03c2 \u03c4\u03bf Premium \u03b3\u03b9\u03b1 3 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03b4\u03c9\u03c1\u03b5\u03ac\u03bd, \u03b8\u03b1 \u03b4\u03b5\u03b9\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b1 advanced stats \u2013 \u03ba\u03b1\u03b9 \u03bc\u03b5\u03c4\u03ac \u03c0\u03b5\u03c2 \u03bc\u03bf\u03c5 \u03b1\u03bd \u03b4\u03b5\u03bd \u03ac\u03bb\u03bb\u03b1\u03be\u03b5\u03c2 \u03c4\u03bf\u03bd \u03c4\u03c1\u03cc\u03c0\u03bf \u03c0\u03bf\u03c5 \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9\u03c2 \u03c4\u03bf \u03c0\u03bf\u03b4\u03cc\u03c3\u03c6\u03b1\u03b9\u03c1\u03bf."
  ],
