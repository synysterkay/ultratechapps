{
  "subject": "3 \u0445\u0432\u0438\u043b\u0438\u043d\u0438, \u0449\u043e \u0437\u043c\u0456\u043d\u044f\u0442\u044c \u0432\u0430\u0448\u0456 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438",
  "preview_text": "\u041e\u0434\u0438\u043d \u043f\u0440\u043e\u0441\u0442\u0438\u0439 \u0440\u0438\u0442\u0443\u0430\u043b, \u044f\u043a\u0438\u0439 \u0440\u043e\u0431\u0438\u0442\u044c \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0443 10 \u0440\u0430\u0437\u0456\u0432 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0448\u0438\u043c. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456.",
  "body_paragraphs": [
    "\u0422\u0438 \u0437\u043d\u0430\u0454\u0448 \u0446\u0435 \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044f, \u043a\u043e\u043b\u0438 \u0441\u0442\u0430\u0432\u0438\u0448 \u043d\u0430 \u043c\u0430\u0442\u0447, \u0430\u043b\u0435 \u0432 \u0433\u043b\u0438\u0431\u0438\u043d\u0456 \u0434\u0443\u0448\u0456 \u0441\u0443\u043c\u043d\u0456\u0432\u0430\u0454\u0448\u0441\u044f? \u042f \u0442\u0435\u0436 \u0447\u0435\u0440\u0435\u0437 \u0446\u0435 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0432. \u0410\u043b\u0435 \u0454 \u043e\u0434\u0438\u043d \u0441\u0435\u043a\u0440\u0435\u0442, \u044f\u043a\u0438\u0439 \u044f \u0432\u0456\u0434\u043a\u0440\u0438\u0432 \u043f\u0456\u0441\u043b\u044f 37 \u0434\u043d\u0456\u0432 \u0443 Predictify \u2014 \u0456 \u0432\u0456\u043d \u0437\u043c\u0456\u043d\u0438\u0432 \u0443\u0441\u0435.",
    "\u0426\u0435 \u043d\u0435 \u043f\u0440\u043e \u0441\u043a\u043b\u0430\u0434\u043d\u0456 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0438 \u0447\u0438 \u0433\u043e\u0434\u0438\u043d\u0438 \u0430\u043d\u0430\u043b\u0456\u0437\u0443. \u0426\u0435 \u043f\u0440\u043e 3-\u0445\u0432\u0438\u043b\u0438\u043d\u043d\u0438\u0439 \u0440\u0438\u0442\u0443\u0430\u043b \u043f\u0435\u0440\u0435\u0434 \u043a\u043e\u0436\u043d\u0438\u043c \u043c\u0430\u0442\u0447\u0435\u043c: \u0432\u0456\u0434\u043a\u0440\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a, \u043f\u0435\u0440\u0435\u0432\u0456\u0440 \u043f\u043e\u043a\u0430\u0437\u043d\u0438\u043a\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u043e\u0441\u0442\u0456 AI, \u043f\u043e\u0434\u0438\u0432\u0438\u0441\u044c \u043d\u0430 \u043e\u0441\u0442\u0430\u043d\u043d\u0456 \u0442\u0435\u043d\u0434\u0435\u043d\u0446\u0456\u0457 \u043a\u043e\u043c\u0430\u043d\u0434\u0438. \u041e\u0441\u044c \u0456 \u0432\u0441\u0435. \u0411\u0435\u0437 \u0446\u044c\u043e\u0433\u043e \u044f \u0440\u043e\u0431\u0438\u0432 \u043f\u043e\u043c\u0438\u043b\u043a\u0438, \u0437 \u0446\u0438\u043c \u2014 \u043c\u043e\u0457 \u0441\u0442\u0430\u0432\u043a\u0438 \u0441\u0442\u0430\u043b\u0438 \u0442\u043e\u0447\u043d\u0456\u0448\u0438\u043c\u0438 \u043d\u0430 40%.",
    "\u041f\u043e\u0434\u0443\u043c\u0430\u0439: \u0442\u0432\u0456\u0439 \u043c\u043e\u0437\u043e\u043a \u0437\u0432\u0438\u043a \u0434\u043e \u0456\u043d\u0442\u0443\u0457\u0446\u0456\u0457, \u0430\u043b\u0435 \u0434\u0430\u043d\u0456 \u043d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u0431\u0440\u0435\u0448\u0443\u0442\u044c. \u041a\u043e\u043b\u0438 \u0442\u0438 \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454\u0448 \u0446\u0456 3 \u0445\u0432\u0438\u043b\u0438\u043d\u0438, \u0442\u0438 \u0441\u0442\u0430\u0454\u0448 \u0447\u0430\u0441\u0442\u0438\u043d\u043e\u044e \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0438, \u044f\u043a\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0433\u0430\u0434\u0443\u0454, \u0430 \u0437\u043d\u0430\u0454. \u0406 \u0446\u0435 \u0437\u043c\u0456\u043d\u044e\u0454 \u0442\u0432\u043e\u044e \u0456\u0434\u0435\u043d\u0442\u0438\u0447\u043d\u0456\u0441\u0442\u044c \u2014 \u0442\u0438 \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435 \u00ab\u0444\u0430\u043d, \u044f\u043a\u0438\u0439 \u0433\u0430\u0434\u0430\u0454\u00bb, \u0430 \u00ab\u0435\u043a\u0441\u043f\u0435\u0440\u0442, \u044f\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0454\u00bb.",
    "\u0421\u043f\u0440\u043e\u0431\u0443\u0439 \u043f\u0440\u044f\u043c\u043e \u0437\u0430\u0440\u0430\u0437: \u0432\u0456\u0434\u043a\u0440\u0438\u0439 Predictify, \u043e\u0431\u0435\u0440\u0438 \u043c\u0430\u0442\u0447 \u0434\u043d\u044f \u0456 \u043f\u0435\u0440\u0435\u0432\u0456\u0440, \u0447\u0438 \u0437\u0431\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u0442\u0432\u043e\u044f \u0434\u0443\u043c\u043a\u0430 \u0437 AI. \u0426\u0435 \u0437\u0430\u0439\u043c\u0435 3 \u0445\u0432\u0438\u043b\u0438\u043d\u0438. P.S.: \u0422\u0432\u0456\u0439 \u0441\u0442\u0440\u0456\u043a \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456 \u043c\u043e\u0436\u0435 \u043f\u0440\u0438\u043d\u0435\u0441\u0442\u0438 \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0456 \u043a\u0440\u0435\u0434\u0438\u0442\u0438 \u2014 \u043d\u0435 \u0432\u0442\u0440\u0430\u0447\u0430\u0439 \u0448\u0430\u043d\u0441."
  ],
