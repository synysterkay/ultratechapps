{
  "subject": "\u041a\u0430\u043a \u0441\u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0442\u044c 18 \u043c\u0438\u043d\u0443\u0442 \u0437\u0430 \u043e\u0434\u0438\u043d \u043a\u043b\u0438\u043a",
  "preview_text": "\u0412\u044b \u0442\u0440\u0430\u0442\u0438\u0442\u0435 20 \u043c\u0438\u043d\u0443\u0442 \u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0443 \u0437\u0432\u0443\u043a\u0430 \u043a\u0430\u0436\u0434\u043e\u0435 \u0443\u0442\u0440\u043e. \u0412 Loudify \u044d\u0442\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 2 \u043c\u0438\u043d\u0443\u0442\u044b. \u0412\u043e\u0442 \u043a\u0430\u043a.",
  "body_paragraphs": [
    "\u041a\u0430\u0436\u0434\u043e\u0435 \u0443\u0442\u0440\u043e \u043e\u0434\u043d\u043e \u0438 \u0442\u043e \u0436\u0435: \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0435 Spotify, \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438 \u0443\u043f\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u0432 \u043f\u043e\u0442\u043e\u043b\u043e\u043a, \u0430 \u0434\u0438\u0430\u043b\u043e\u0433\u0438 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u0442\u043e\u043d\u0443\u0442 \u0432 \u0448\u0443\u043c\u0435 \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0442\u043e\u0440\u0430. \u0412\u044b \u043b\u0435\u0437\u0435\u0442\u0435 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438, \u043a\u0440\u0443\u0442\u0438\u0442\u0435 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440, \u043f\u0440\u043e\u0431\u0443\u0435\u0442\u0435 \u043f\u0440\u0435\u0441\u0435\u0442\u044b \u2014 20 \u043c\u0438\u043d\u0443\u0442 \u0443\u043b\u0435\u0442\u0430\u044e\u0442 \u0432 \u0442\u0440\u0443\u0431\u0443. \u0410 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u00ab\u0442\u0430\u043a \u0441\u0435\u0431\u0435\u00bb.",
    "\u042f \u0441\u0430\u043c \u0442\u0430\u043a \u0434\u0435\u043b\u0430\u043b, \u043f\u043e\u043a\u0430 \u043d\u0435 \u043f\u043e\u043d\u044f\u043b: \u044d\u0442\u043e \u043d\u0435 \u0432\u0430\u0448 \u0441\u043b\u0443\u0445, \u044d\u0442\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435. Loudify \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u044d\u0442\u0438 20 \u043c\u0438\u043d\u0443\u0442 \u0432 2. \u0412\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0435 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438 \u2014 AutoEQ \u0443\u0437\u043d\u0430\u0451\u0442 \u0438\u0445 \u0438 \u0437\u0430 \u0434\u043e\u043b\u0438 \u0441\u0435\u043a\u0443\u043d\u0434\u044b \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0447\u0430\u0441\u0442\u043e\u0442\u044b \u043f\u043e\u0434 \u043a\u0430\u0436\u0434\u0443\u044e \u043c\u043e\u0434\u0435\u043b\u044c. \u0411\u0435\u0437 \u0440\u0443\u0447\u043d\u043e\u0433\u043e \u043f\u043e\u0434\u0431\u043e\u0440\u0430, \u0431\u0435\u0437 \u0433\u0443\u0433\u043b\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u0435\u0439. \u041f\u0440\u043e\u0441\u0442\u043e \u0432\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u2014 \u0438 \u0437\u0432\u0443\u043a \u0443\u0436\u0435 \u0447\u0451\u0442\u043a\u0438\u0439.",
    "\u0412\u043e\u0442 \u0433\u0434\u0435 \u043c\u0430\u0433\u0438\u044f: \u0432\u044b \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0435 \u0442\u0440\u0435\u043a \u2014 \u0438 \u0441\u0440\u0430\u0437\u0443 \u0441\u043b\u044b\u0448\u0438\u0442\u0435 \u0431\u0430\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u043d\u044c\u0448\u0435 \u0431\u044b\u043b \u0441\u043c\u0430\u0437\u0430\u043d, \u0438 \u0433\u043e\u043b\u043e\u0441\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u0442\u043e\u043d\u0443\u0442. \u0410 \u0435\u0441\u043b\u0438 \u0445\u043e\u0442\u0438\u0442\u0435 \u0435\u0449\u0451 \u0433\u0440\u043e\u043c\u0447\u0435? \u041e\u0434\u0438\u043d \u0441\u0432\u0430\u0439\u043f \u2014 \u0438 +200% \u0431\u0435\u0437 \u0438\u0441\u043a\u0430\u0436\u0435\u043d\u0438\u0439. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 20 \u043c\u0438\u043d\u0443\u0442 \u0430\u0434\u0430. \u0422\u043e\u043b\u044c\u043a\u043e \u0434\u0432\u0435 \u043c\u0438\u043d\u0443\u0442\u044b \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438, \u0430 \u043f\u043e\u0442\u043e\u043c \u2014 \u043c\u0443\u0437\u044b\u043a\u0430.",
    "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 Loudify \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441, \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u043b\u044e\u0431\u0438\u043c\u044b\u0435 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438 \u2014 \u0438 \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044c, \u0447\u0442\u043e 20 \u043c\u0438\u043d\u0443\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0432\u0430\u0448\u0430 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430. P.S. \u0412\u0430\u0448 Sound DNA \u0437\u0430 \u044d\u0442\u0443 \u043d\u0435\u0434\u0435\u043b\u044e \u0443\u0436\u0435 \u0436\u0434\u0451\u0442 \u2014 \u043e\u043d \u043f\u043e\u043a\u0430\u0436\u0435\u0442, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0432\u044b \u0441\u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043b\u0438 \u0441 AutoEQ."
