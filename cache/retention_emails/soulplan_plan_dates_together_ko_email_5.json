{
  "subject": "\uc0c8\ubcbd 2\uc2dc\uc5d0 \ub9cc\ub4e0 \uadf8 \uae30\ub2a5 \uc774\uc57c\uae30",
  "preview_text": "\uc9c4\uc9dc \uc774\uc720\uac00 \uc788\uc5c8\uc5b4\uc694. \uc571\uc5d0 \uc228\uaca8\uc9c4 \ube44\ubc00 \ud558\ub098\ub97c \uc9c0\uae08 \uacf5\uac1c\ud569\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uc5b4\ub290 \uc0c8\ubcbd 2\uc2dc, \ud63c\uc790 \uc549\uc544 \ucf54\ub4dc\ub97c \uace0\uce58\ub2e4\uac00 \uac11\uc790\uae30 \uc0dd\uac01\ub0ac\uc5b4\uc694. \uc6b0\ub9ac \uc571\uc774 \ub2e8\uc21c\ud55c \uacc4\ud68d \uc571\uc774 \uc544\ub2c8\ub77c\ub294 \uac78. \uadf8\ub0a0 \ubc24, \ud55c \ucee4\ud50c\uc774 \ubcf4\ub0b8 \uba54\uc2dc\uc9c0\uac00 \uc81c \ub9c8\uc74c\uc744 \uc644\uc804\ud788 \ubc14\uafd4\ub193\uc558\uac70\ub4e0\uc694.",
    "\uadf8 \ucee4\ud50c\uc740 \ub9d0\ud588\uc5b4\uc694: '\ub298 \uac19\uc740 \ub370\uc774\ud2b8, \ubed4\ud55c \uacc4\ud68d\uc5d0 \uc9c0\ucce4\uc5b4\uc694. \uadf8\ub7f0\ub370 \uc624\ub298 \ubc24, \ud30c\ud2b8\ub108\uac00 \ubcf4\ub0b8 \uc81c\uc548 \ud558\ub098\ub85c \ub2e4\uc2dc \uc124\ub81c\uc5b4\uc694.' \uadf8 \uc21c\uac04 \uae68\ub2ec\uc558\uc8e0. \uc6b0\ub9ac\uac00 \ub9cc\ub4e0 \uac74 \ub2e8\uc21c\ud55c \uae30\ub2a5\uc774 \uc544\ub2c8\ub77c, \uc0ac\ub791\uc744 \ub2e4\uc2dc \uc0b4\ub9ac\ub294 \uc791\uc740 \ubd88\uaf43\uc774\ub77c\ub294 \uac78.",
    "\uadf8\ub798\uc11c '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ub9cc\ub4e4\uc5c8\uc5b4\uc694. \ub2f9\uc2e0\uc774 \uae30\ubd84\ub9cc \uace0\ub974\uba74(\uc544\ub291\ud55c, \ubaa8\ud5d8\uc801\uc778, \uc7a5\ub09c\uae30 \uac00\ub4dd\ud55c, \ud790\ub9c1) 30\ucd08 \ub9cc\uc5d0 \uc644\ubcbd\ud55c \ubc24\uc774 \uc644\uc131\ub429\ub2c8\ub2e4. \ub354 \uc774\uc0c1 \uacc4\ud68d\uc5d0 \uc9c0\uce58\uc9c0 \ub9c8\uc138\uc694. \uadf8\ub0e5 \ud0ed \ud55c \ubc88\uc73c\ub85c \uc0ac\ub791\uc744 \uc2dc\uc791\ud558\uc138\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uc5b4\uc11c '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc744 \uae30\ub2e4\ub9ac\ub294 \uce74\ub4dc\uac00 \uc788\uc5b4\uc694. P.S. \ud30c\ud2b8\ub108\uac00 \ubcf4\ub0b8 \uc81c\uc548\uc774 \ub3c4\ucc29\ud558\uba74, \uc54c\ub9bc \ub300\uc2e0 \uc544\ub984\ub2e4\uc6b4 \ud480\uc2a4\ud06c\ub9b0 \uc21c\uac04\uc774 \ud3bc\uccd0\uc9d1\ub2c8\ub2e4. \uadf8 \uc124\ub818, \uaf2d \uacbd\ud5d8\ud574\ubcf4\uc138\uc694."
  ],
