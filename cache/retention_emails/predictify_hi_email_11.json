{
  "subject": "\u0935\u094b 3AM \u0915\u093e \u092e\u0948\u091a \u091c\u093f\u0938\u0928\u0947 \u0938\u092c\u0915\u094b \u091a\u094c\u0902\u0915\u093e \u0926\u093f\u092f\u093e",
  "preview_text": "\u0939\u0930 \u0915\u094b\u0908 \u0915\u0939\u0924\u093e \u0939\u0948 \u0915\u093f \u0921\u0947\u091f\u093e \u0938\u0947 \u092b\u0941\u091f\u092c\u0949\u0932 \u0915\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u0940 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0924\u0940\u0964 \u090f\u0915 \u092e\u0948\u091a \u0928\u0947 \u092f\u0939 \u091d\u0942\u0920 \u0938\u093e\u092c\u093f\u0924 \u0915\u0930 \u0926\u093f\u092f\u093e\u0964",
  "body_paragraphs": [
    "\u0938\u094b\u091a\u094b, \u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u0932\u0940\u0917 \u0935\u0928 \u0915\u093e \u090f\u0915 \u092e\u0948\u091a \u0925\u093e \u2013 \u0935\u0939\u093e\u0902 \u0938\u092c\u0915\u094b \u0932\u0917 \u0930\u0939\u093e \u0925\u093e \u0915\u093f \u092c\u0921\u093c\u0940 \u091f\u0940\u092e \u091c\u0940\u0924\u0947\u0917\u0940\u0964 \u0932\u0947\u0915\u093f\u0928 \u0939\u092e\u093e\u0930\u0947 AI \u0928\u0947 \u0915\u0941\u091b \u0914\u0930 \u0939\u0940 \u0926\u0947\u0916\u093e \u0925\u093e: \u0935\u094b \u090f\u0915 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u092a\u0948\u091f\u0930\u094d\u0928 \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0921\u0947\u091f\u093e \u092e\u0947\u0902 \u0926\u093f\u0916\u0924\u093e \u0939\u0948\u0964 \u0928\u0924\u0940\u091c\u093e? 3-1 \u0915\u0940 \u091c\u0940\u0924 \u0909\u0938 \u091f\u0940\u092e \u0928\u0947 \u0915\u0940 \u091c\u093f\u0938\u0947 \u0915\u094b\u0908 \u0928\u0939\u0940\u0902 \u091c\u0940\u0924\u0924\u093e \u092e\u093e\u0928\u0924\u093e \u0925\u093e\u0964",
    "\u092f\u0939 \u0915\u094b\u0908 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0938\u092c\u0942\u0924 \u0939\u0948 \u0915\u093f '\u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917' \u0905\u0915\u094d\u0938\u0930 \u0927\u094b\u0916\u093e \u0926\u0947\u0924\u0940 \u0939\u0948\u0964 \u0932\u094b\u0917 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u092b\u0941\u091f\u092c\u0949\u0932 \u092e\u0947\u0902 \u0905\u0928\u093f\u0936\u094d\u091a\u093f\u0924\u0924\u093e \u0939\u0940 \u092e\u091c\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0939\u092e \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0921\u0947\u091f\u093e \u0939\u0940 \u0905\u0938\u0932\u0940 \u0916\u093f\u0932\u093e\u0921\u093c\u0940 \u0939\u0948\u0964 Predictify \u0915\u093e AI \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u0935\u0947\u0930\u093f\u090f\u092c\u0932\u094d\u0938 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0930\u0924\u093e \u0939\u0948 \u2013 xG, \u092a\u091c\u0947\u0936\u0928, \u0921\u093f\u092b\u0947\u0902\u0938\u093f\u0935 \u0938\u094d\u091f\u094d\u0930\u0947\u0902\u0925, \u0914\u0930 \u092f\u0939\u093e\u0902 \u0924\u0915 \u0915\u093f \u0939\u0947\u0921-\u091f\u0942-\u0939\u0947\u0921 \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940\u0964",
    "\u0905\u092c \u0924\u0941\u092e \u092c\u093f\u0928\u093e \u0921\u0947\u091f\u093e \u0915\u0947 \u0938\u093f\u0930\u094d\u092b \u0905\u0902\u0926\u093e\u091c\u093c\u0947 \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u0915\u0930 \u0930\u0939\u0947 \u0939\u094b, \u091c\u092c\u0915\u093f \u0910\u092a \u092e\u0947\u0902 \u0939\u0930 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0939\u0948 \u2013 \u092c\u0924\u093e\u0924\u093e \u0939\u0948 \u0915\u093f AI \u0915\u094b \u0915\u093f\u0924\u0928\u093e \u092f\u0915\u0940\u0928 \u0939\u0948\u0964 \u092f\u0939 \u0935\u0939\u0940 \u091f\u0942\u0932 \u0939\u0948 \u091c\u094b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u0930 \u0932\u0940\u0917 \u0938\u0947 \u0932\u0947\u0915\u0930 \u091a\u0948\u0902\u092a\u093f\u092f\u0902\u0938 \u0932\u0940\u0917 \u0924\u0915, 50 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0932\u0940\u0917\u094d\u0938 \u0915\u094b \u0915\u0935\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091f\u0940\u092e \u0915\u0947 \u0905\u0917\u0932\u0947 \u092e\u0948\u091a \u0915\u093e \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0926\u0947\u0916\u094b\u0964 \u0921\u0947\u091f\u093e \u0915\u094b \u0905\u092a\u0928\u0947 \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u0938\u0947 \u091f\u0915\u0930\u093e\u0928\u0947 \u0926\u094b\u0964 P.S. \u2013 \u0915\u094d\u092f\u093e \u0924\u0941\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u094b \u0915\u093f \u0939\u092e\u093e\u0930\u093e AI \u0905\u092c \u0924\u0915 10,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u092e\u0948\u091a\u094b\u0902 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0930 \u091a\u0941\u0915\u093e \u0939\u0948? \u0936\u093e\u092f\u0926 \u0905\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0930\u0940 \u0939\u0948 \u0915\u093f \u0924\u0941\u092e \u0938\u092c\u0938\u0947 \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u092b\u0948\u0928 \u092c\u0928\u094b\u0964"
  ],
