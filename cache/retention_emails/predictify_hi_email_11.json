{
  "subject": "90% \u092b\u093c\u0941\u091f\u092c\u0949\u0932 \u092b\u093c\u0948\u0928 \u092f\u0939 \u0917\u0932\u0924\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 - \u0906\u092a \u092d\u0940?",
  "preview_text": "\u0906\u092a\u0915\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091f\u0940\u092e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u090f\u0915 \u091d\u0942\u0920\u093e \u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u091c\u094b \u0906\u092a\u0915\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u093f\u092f\u094b\u0902 \u0915\u094b \u0917\u0932\u0924 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0938\u091a\u094d\u091a\u093e\u0908 \u092f\u0939\u093e\u0901 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u0932\u0917\u092d\u0917 \u0939\u0930 \u092b\u093c\u0948\u0928 \u092f\u0939\u0940 \u092e\u093e\u0928\u0924\u093e \u0939\u0948: '\u092b\u0949\u0930\u094d\u092e \u092e\u0947\u0902 \u091f\u0940\u092e \u0939\u092e\u0947\u0936\u093e \u091c\u0940\u0924\u0947\u0917\u0940\u0964' \u092a\u093f\u091b\u0932\u0947 5 \u092e\u0948\u091a \u091c\u0940\u0924\u0947? \u0906\u091c \u092d\u0940 \u091c\u0940\u0924\u0947\u0902\u0917\u0947\u0964 \u092f\u0939 \u0924\u0930\u094d\u0915 \u0907\u0924\u0928\u093e \u0906\u092e \u0939\u0948 \u0915\u093f \u0939\u092e \u0938\u092c\u0928\u0947 \u092e\u093e\u0928 \u0932\u093f\u092f\u093e \u0939\u0948 \u0915\u093f \u092f\u0939 \u0938\u091a \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0921\u0947\u091f\u093e \u0915\u0941\u091b \u0914\u0930 \u0915\u0939\u0924\u093e \u0939\u0948\u0964",
    "\u0939\u092e\u0928\u0947 \u092a\u093f\u091b\u0932\u0947 \u0938\u0940\u091c\u093c\u0928 \u0915\u0947 1000+ \u092e\u0948\u091a\u094b\u0902 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u093f\u092f\u093e\u0964 \u0939\u0948\u0930\u093e\u0928\u0940 \u0915\u0940 \u092c\u093e\u0924: 5 \u092e\u0948\u091a \u091c\u0940\u0924\u0928\u0947 \u0935\u093e\u0932\u0940 \u091f\u0940\u092e\u094b\u0902 \u0928\u0947 \u0905\u0917\u0932\u0947 \u092e\u0948\u091a \u092e\u0947\u0902 \u0938\u093f\u0930\u094d\u092b\u093c 58% \u091c\u0940\u0924\u0947\u0964 \u092f\u093e\u0928\u0940 42% \u092c\u093e\u0930 \u0935\u0947 \u0939\u093e\u0930 \u0917\u090f \u092f\u093e \u0921\u094d\u0930\u0949 \u0915\u0930 \u0917\u090f\u0964 \u0915\u094d\u092f\u094b\u0902? \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092b\u093c\u0941\u091f\u092c\u0949\u0932 \u0938\u093f\u0930\u094d\u092b\u093c \u092b\u0949\u0930\u094d\u092e \u0928\u0939\u0940\u0902, \u091f\u0915\u094d\u0915\u0930, \u091a\u094b\u091f, \u092e\u094c\u0938\u092e \u0914\u0930 1000+ \u0935\u0947\u0930\u093f\u090f\u092c\u0932\u094d\u0938 \u0915\u093e \u0916\u0947\u0932 \u0939\u0948\u0964 \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u0906\u092a\u0915\u094b \u0927\u094b\u0916\u093e \u0926\u0947 \u0938\u0915\u0924\u0940 \u0939\u0948\u0964",
    "\u092f\u0939\u0940\u0902 Predictify \u0915\u093e AI \u0906\u092a\u0915\u0940 \u092e\u0926\u0926 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f, \u0939\u092e\u093e\u0930\u093e AI \u0938\u093f\u0930\u094d\u092b\u093c \u092b\u0949\u0930\u094d\u092e \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f xG, \u092a\u0949\u091c\u093c\u0947\u0936\u0928, \u0939\u0947\u0921-\u091f\u0942-\u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940, \u091f\u0948\u0915\u094d\u091f\u093f\u0915\u0932 \u092e\u0948\u091a\u0905\u092a \u0914\u0930 \u092d\u0940 \u092c\u0939\u0941\u0924 \u0915\u0941\u091b \u090f\u0928\u093e\u0932\u093e\u0907\u091c\u093c \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092b\u093f\u0930 \u090f\u0915 Confidence Score \u0926\u0947\u0924\u093e \u0939\u0948 - \u0924\u093e\u0915\u093f \u0906\u092a \u091c\u093e\u0928 \u0938\u0915\u0947\u0902 AI \u0915\u093f\u0924\u0928\u093e \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u091f \u0939\u0948\u0964 \u0905\u092c \u0906\u092a \u0938\u093f\u0930\u094d\u092b\u093c \u0905\u0902\u0926\u093e\u091c\u093c\u093e \u0928\u0939\u0940\u0902, \u0921\u0947\u091f\u093e \u0938\u0947 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0906\u091c \u0939\u0940 Predictify \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u0917\u0932\u0947 \u092c\u0921\u093c\u0947 \u092e\u0948\u091a \u0915\u093e Confidence Score \u0926\u0947\u0916\u0947\u0902\u0964 \u0915\u094d\u092f\u093e AI \u0906\u092a\u0915\u0940 '\u092b\u0949\u0930\u094d\u092e \u0935\u093e\u0932\u0940 \u091f\u0940\u092e' \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0906\u092a\u0938\u0947 \u0938\u0939\u092e\u0924 \u0939\u0948? \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0915\u094c\u0928 \u0938\u0939\u0940 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u0939\u092e\u093e\u0930\u0947 Premium \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0928\u0947 \u0907\u0938\u0940 \u0921\u0947\u091f\u093e \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0915\u0947 \u092a\u093f\u091b\u0932\u0947 \u092e\u0939\u0940\u0928\u0947 73% \u092a\u094b\u091f\u0947\u0902\u0936\u093f\u092f\u0932 \u0935\u0948\u0932\u094d\u092f\u0942 \u092c\u0947\u091f\u094d\u0938 \u092a\u0915\u0921\u093c\u0947\u0964 3-\u0926\u093f\u0928 \u0915\u093e \u091f\u094d\u0930\u093e\u092f\u0932 \u0905\u092d\u0940 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0964"
