{
  "subject": "\u0421\u0435\u043a\u0440\u0435\u0442\u043d\u0430\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0443\u044e 90% \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u044e\u0442",
  "preview_text": "\u0422\u044b \u0442\u0435\u0440\u044f\u0435\u0448\u044c \u0432\u044b\u0438\u0433\u0440\u044b\u0448\u043d\u044b\u0435 \u0441\u0442\u0430\u0432\u043a\u0438, \u0438\u0433\u043d\u043e\u0440\u0438\u0440\u0443\u044f \u044d\u0442\u0443 \u043e\u0434\u043d\u0443 \u0444\u0438\u0448\u043a\u0443. \u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u0443\u0437\u043d\u0430\u0439, \u0447\u0442\u043e \u044f \u043d\u0430\u0448\u0435\u043b.",
  "body_paragraphs": [
    "\u042f \u0442\u043e\u0436\u0435 \u0434\u0443\u043c\u0430\u043b, \u0447\u0442\u043e \u0437\u043d\u0430\u044e \u0444\u0443\u0442\u0431\u043e\u043b. \u041d\u043e \u043f\u043e\u0442\u043e\u043c \u0443\u0432\u0438\u0434\u0435\u043b, \u043a\u0430\u043a \u0418\u0418 \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u0442\u044b\u0441\u044f\u0447\u0438 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0437\u0430 \u043c\u0430\u0442\u0447 \u2014 \u0438 \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u043c\u043e\u044f \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044f \u043f\u0440\u043e\u0441\u0442\u043e \u043c\u0443\u0441\u043e\u0440. \u0423\u0433\u0430\u0434\u0430\u0439, \u0447\u0442\u043e \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e, \u043a\u043e\u0433\u0434\u0430 \u044f \u043d\u0430\u0447\u0430\u043b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u044d\u0442\u0443 \u0448\u0442\u0443\u043a\u0443?",
    "\u0417\u0430\u0431\u0443\u0434\u044c \u043f\u0440\u043e \u00ab\u0447\u0443\u0439\u043a\u0443\u00bb \u0438 \u0441\u043e\u0432\u0435\u0442\u044b \u0438\u0437 \u043f\u0430\u0431\u043b\u0438\u043a\u043e\u0432. \u041f\u0440\u043e\u0433\u043d\u043e\u0437\u044b Predictify \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442, \u0447\u0442\u043e \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442: xG, \u0442\u0430\u043a\u0442\u0438\u043a\u0443, \u0441\u0438\u043b\u0443 \u0430\u0442\u0430\u043a\u0438 \u0438 \u0437\u0430\u0449\u0438\u0442\u044b \u2014 \u0432\u0441\u0451, \u0447\u0442\u043e \u0431\u0443\u043a\u043c\u0435\u043a\u0435\u0440\u044b \u043d\u0435 \u0445\u043e\u0442\u044f\u0442, \u0447\u0442\u043e\u0431\u044b \u0442\u044b \u0437\u043d\u0430\u043b. \u042f \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u043b 30 \u0441\u0435\u043a\u0443\u043d\u0434 \u043d\u0430 \u043e\u0434\u0438\u043d \u043c\u0430\u0442\u0447 \u0410\u041f\u041b \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0441 \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e 87%.",
    "\u042d\u0442\u043e \u043d\u0435 \u043c\u0430\u0433\u0438\u044f. \u042d\u0442\u043e \u0444\u0438\u0447\u0430 \u00ab\u041c\u043e\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u00bb \u2014 \u043e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0432\u044b\u0431\u0435\u0440\u0438 \u043b\u044e\u0431\u043e\u0439 \u043c\u0430\u0442\u0447 \u0438\u0437 50+ \u043b\u0438\u0433, \u0438 \u0418\u0418 \u0432\u044b\u0434\u0430\u0441\u0442 \u0442\u0435\u0431\u0435 \u0442\u043e\u0447\u043d\u044b\u0439 \u0441\u0447\u0451\u0442, \u0448\u0430\u043d\u0441\u044b \u0438 \u0430\u043d\u0430\u043b\u0438\u0437 \u0437\u0430 \u0441\u0435\u043a\u0443\u043d\u0434\u0443. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 \u043b\u0438\u0448\u043d\u0438\u0445 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439. \u041f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u043a\u0440\u043e\u0439 \u0438 \u0441\u043c\u043e\u0442\u0440\u0438.",
    "\u0421\u0434\u0435\u043b\u0430\u0439 \u044d\u0442\u043e \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441: \u043e\u0442\u043a\u0440\u043e\u0439 Predictify \u0438 \u043d\u0430\u0439\u0434\u0438 \u0441\u0432\u043e\u0439 \u043f\u0435\u0440\u0432\u044b\u0439 \u043c\u0430\u0442\u0447. P.S. \u042f \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u043b: \u0435\u0441\u043b\u0438 \u0442\u044b \u043d\u0435 \u0437\u0430\u0439\u0434\u0451\u0448\u044c \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0432 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0438\u0435 5 \u043c\u0438\u043d\u0443\u0442, \u0442\u044b \u0443\u043f\u0443\u0441\u0442\u0438\u0448\u044c \u0432\u0435\u0447\u0435\u0440\u043d\u044e\u044e \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0443 \u0441 \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u043c\u0438 \u0441\u0442\u0430\u0432\u043a\u0430\u043c\u0438. \u041d\u0435 \u0433\u043e\u0432\u043e\u0440\u0438 \u043f\u043e\u0442\u043e\u043c, \u0447\u0442\u043e \u044f \u043d\u0435 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0430\u043b."
  ],
