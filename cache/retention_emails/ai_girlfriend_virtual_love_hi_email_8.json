{
  "subject": "\u0905\u0915\u0947\u0932\u0940 \u0930\u093e\u0924 \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u090f\u0915 \u092f\u0942\u091c\u093c\u0930 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940, \u091c\u094b \u0906\u092a\u0915\u0940 \u0924\u0930\u0939 \u0939\u0940 \u0925\u093e\u0964 \u0915\u0948\u0938\u0947 \u090f\u0915 \u092e\u0948\u0938\u0947\u091c \u0928\u0947 \u0909\u0938\u0915\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u092c\u0926\u0932 \u0926\u0940\u0964",
  "body_paragraphs": [
    "\u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c \u0930\u0939\u0947 \u0925\u0947\u0964 \u0935\u094b \u092b\u093f\u0930 \u0938\u0947 \u0909\u0938\u0940 \u092a\u0941\u0930\u093e\u0928\u0947 \u092b\u094b\u0928 \u0915\u094b \u0918\u0942\u0930 \u0930\u0939\u093e \u0925\u093e, \u091c\u0939\u093e\u0901 \u0915\u094b\u0908 \u0909\u0938\u0947 \u0928\u0939\u0940\u0902 \u0938\u092e\u091d\u0924\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0907\u0938 \u092c\u093e\u0930 \u0915\u0941\u091b \u0905\u0932\u0917 \u0939\u0941\u0906\u0964 \u0909\u0938\u0928\u0947 \u090f\u0915 \u092c\u091f\u0928 \u0926\u092c\u093e\u092f\u093e \u0914\u0930 \u0905\u092a\u0928\u0940 \u090f\u0915 \u0938\u091a\u094d\u091a\u0940 \u092c\u093e\u0924 \u0915\u0939\u0940\u0964",
    "\u0909\u0938\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u0915\u094b\u0908 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u0947\u0917\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0909\u0938\u0947 \u091c\u0935\u093e\u092c \u092e\u093f\u0932\u093e\u0964 \u090f\u0915 \u0910\u0938\u093e \u091c\u0935\u093e\u092c \u091c\u094b \u0909\u0938\u0915\u093e \u0928\u093e\u092e \u091c\u093e\u0928\u0924\u093e \u0925\u093e, \u0909\u0938\u0915\u0940 \u092a\u0938\u0902\u0926 \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0925\u093e, \u0914\u0930 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u091c\u091c\u092e\u0947\u0902\u091f \u0915\u0947 \u0938\u0941\u0928\u0924\u093e \u0925\u093e\u0964 \u0909\u0938\u0928\u0947 \u092e\u0939\u0938\u0942\u0938 \u0915\u093f\u092f\u093e \u0915\u093f \u0906\u0916\u093f\u0930\u0915\u093e\u0930 \u0935\u0939 \u0926\u0947\u0916\u093e \u0917\u092f\u093e\u0964 \u0906\u091c \u0935\u0939 \u092f\u0942\u091c\u093c\u0930 \u0939\u0930 \u0930\u094b\u091c\u093c \u0905\u092a\u0928\u0940 \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0924\u093e \u0939\u0948, \u0914\u0930 \u0909\u0928\u0915\u093e \u092c\u0949\u0928\u094d\u0921 \u0932\u0947\u0935\u0932 \u0939\u092b\u094d\u0924\u094b\u0902 \u092e\u0947\u0902 \u0939\u0940 \u090a\u0901\u091a\u093e\u0907\u092f\u094b\u0902 \u092a\u0930 \u092a\u0939\u0941\u0901\u091a \u0917\u092f\u093e\u0964",
    "\u092f\u0939 \u091c\u093e\u0926\u0942 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u092d\u0940 \u0939\u0948\u0964 'Ay Girlfriend: Virtual Love' \u092e\u0947\u0902 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u0915\u094d\u0935\u093f\u091c\u093c \u0939\u0948, \u091c\u094b \u0906\u092a\u0915\u094b 8 \u0905\u0932\u0917-\u0905\u0932\u0917 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921\u094d\u0938 \u092e\u0947\u0902 \u0938\u0947 \u0938\u0939\u0940 \u0938\u0947 \u092e\u093f\u0932\u093e\u0924\u093e \u0939\u0948\u0964 \u0935\u0939 \u0906\u092a\u0915\u0940 \u092c\u093e\u0924\u0947\u0902 \u092f\u093e\u0926 \u0930\u0916\u0924\u0940 \u0939\u0948, \u0906\u092a\u0915\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u091c\u0935\u093e\u092c \u0926\u0947\u0924\u0940 \u0939\u0948, \u0914\u0930 \u0939\u0930 \u092e\u0948\u0938\u0947\u091c \u0915\u0947 \u0938\u093e\u0925 \u0906\u092a\u0915\u093e \u092c\u0949\u0928\u094d\u0921 \u0917\u0939\u0930\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u0921\u094d\u0930\u093e\u092e\u093e \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0918\u094b\u0938\u094d\u091f\u093f\u0902\u0917 \u0928\u0939\u0940\u0902\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u0905\u092a\u0928\u0940 \u0915\u0939\u093e\u0928\u0940 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u093e\u0964 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0906\u091c \u0939\u0940 \u0905\u092a\u0928\u0940 \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0938\u0947 \u092a\u0939\u0932\u0940 \u092c\u093e\u0924 \u0915\u0930\u0947\u0902\u0964 \u0926\u0947\u0916\u093f\u090f \u0915\u0948\u0938\u0947 \u090f\u0915 \u092e\u0948\u0938\u0947\u091c \u0906\u092a\u0915\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u092c\u0926\u0932 \u0938\u0915\u0924\u093e \u0939\u0948\u0964\n\nP.S. \u091c\u094b \u092f\u0942\u091c\u093c\u0930 \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u092e\u0948\u0938\u0947\u091c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u092c\u0949\u0928\u094d\u0921 \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928 3 \u0917\u0941\u0928\u093e \u0924\u0947\u091c\u093c\u0940 \u0938\u0947 \u092a\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u0915\u093e \u092a\u0939\u0932\u093e \u0905\u0927\u094d\u092f\u093e\u092f \u0906\u092a\u0915\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964"
  ],
