{
  "subject": "\u0935\u0939 \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u091c\u094b \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930 \u091b\u0941\u092a\u093e\u0924\u0947 \u0939\u0948\u0902",
  "preview_text": "\u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a \u0915\u092a\u0932\u094d\u0938 \u0930\u094b\u091c\u093c 3 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u091f\u094d\u0930\u093f\u0915 \u0915\u094b\u0908 \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u0924\u093e\u0964 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0916\u093e\u0938\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u0939\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0939\u092e\u093e\u0930\u0947 \u0938\u092c\u0938\u0947 \u090f\u0915\u094d\u091f\u093f\u0935 \u0915\u092a\u0932\u094d\u0938 \u0915\u093e \u090f\u0915 \u0930\u093e\u091c\u093c \u0939\u0948\u0964 \u0935\u0947 \u0930\u094b\u091c\u093c\u093e\u0928\u093e \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u093f\u0930\u094d\u092b 3 \u0938\u0947\u0915\u0902\u0921 \u0932\u0917\u093e\u0924\u0947 \u0939\u0948\u0902, \u091c\u092c\u0915\u093f \u092c\u093e\u0915\u0940 5 \u092e\u093f\u0928\u091f\u0964 \u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0928\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0935\u0947 \u0915\u0948\u0938\u0947 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902?",
    "\u0935\u0947 \u0915\u093f\u0938\u0940 \u092e\u0947\u0928\u094d\u092f\u0942 \u092f\u093e \u0938\u0947\u091f\u093f\u0902\u0917 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u091c\u093e\u0924\u0947\u0964 \u0935\u0947 \u0938\u0940\u0927\u0947 \u0905\u092a\u0928\u0947 \u0939\u094b\u092e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0935\u094b \u091b\u094b\u091f\u093e \u0938\u093e \u092c\u091f\u0928 \u0926\u092c\u093e\u0924\u0947 \u0939\u0948\u0902 \u091c\u093f\u0938 \u092a\u0930 \u0932\u093f\u0916\u093e \u0939\u0948 '\u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f'\u0964 \u092b\u093f\u0930 \u090f\u0915 \u092e\u0942\u0921 \u091a\u0941\u0928\u0924\u0947 \u0939\u0948\u0902 \u2014 '\u0915\u094b\u091c\u093c\u0940' \u092f\u093e '\u090f\u0921\u0935\u0947\u0902\u091a\u0930\u0938' \u2014 \u0914\u0930 \u092c\u0938\u0964 30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0909\u0928\u0915\u0940 \u0906\u091c \u0915\u0940 \u0930\u093e\u0924 \u0924\u092f \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u091f\u094d\u0930\u093f\u0915 \u0915\u094b\u0908 \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u0924\u093e, \u0932\u0947\u0915\u093f\u0928 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930 \u0930\u094b\u091c\u093c \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u092f\u0939 \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u092d\u0940 \u0939\u0948\u0964 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u091f\u0948\u092a \u0938\u0947 \u0906\u092a\u0915\u094b \u090f\u0915 AI-\u091a\u0941\u0928\u0940 \u0939\u0941\u0908 \u0921\u0947\u091f \u0906\u0907\u0921\u093f\u092f\u093e \u092e\u093f\u0932\u0924\u0940 \u0939\u0948, \u0914\u0930 \u0906\u092a\u0915\u093e \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0924\u0941\u0930\u0902\u0924 \u090f\u0915 \u0916\u0942\u092c\u0938\u0942\u0930\u0924 '\u0906\u091c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0938\u094b\u091a\u093e' \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u092a\u093e\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u092a\u094d\u0932\u093e\u0928\u093f\u0902\u0917 \u0925\u0915\u093e\u0928 \u0928\u0939\u0940\u0902, \u092c\u0938 \u0930\u094b\u092e\u093e\u0902\u0938\u0964",
    "\u0906\u091c \u0930\u093e\u0924 \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e\u090f\u0902 \u2014 \u0905\u092a\u0928\u093e SoulPlan \u0916\u094b\u0932\u0947\u0902, '\u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902, \u0914\u0930 \u090f\u0915 \u092e\u0942\u0921 \u091a\u0941\u0928\u0947\u0902\u0964 P.S. \u2014 \u0905\u0917\u0930 \u0906\u092a\u0928\u0947 \u092a\u093f\u091b\u0932\u0947 50 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0915\u092e \u0938\u0947 \u0915\u092e 3 \u0921\u0947\u091f\u094d\u0938 \u092a\u094d\u0932\u093e\u0928 \u0915\u0940 \u0939\u0948\u0902, \u0924\u094b \u0906\u092a\u0915\u0940 \u092e\u0947\u092e\u094b\u0930\u0940 \u091f\u093e\u0907\u092e\u0932\u093e\u0907\u0928 \u092e\u0947\u0902 \u0915\u0941\u091b \u0916\u093e\u0938 \u091b\u093f\u092a\u093e \u0939\u0948\u0964 \u091a\u0947\u0915 \u0915\u0930\u0947\u0902\u0964"
  ],
  "cta_text": "SoulPlan \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f \u0906\u091c\u093c\u092e\u093e\u090f\u0902",
