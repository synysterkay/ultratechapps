{
  "subject": "10,000 \ucee4\ud50c \uc911 1\uba85\ub9cc \uc544\ub294 \ube44\ubc00",
  "preview_text": "\ubd84\uc11d \uacb0\uacfc, 99%\uc758 \ucee4\ud50c\uc774 \uac04\uacfc\ud558\ub294 \ub2e8 \ud558\ub098\uc758 \uc2b5\uad00\uc774 \uad00\uacc4\ub97c \ubc14\uafc9\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \ub370\uc774\ud2b8\ub97c \uc601\uc6d0\ud788 \ubc14\uafc0 \ub370\uc774\ud130\ub97c \uc9c0\uae08 \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "\uc9c0\ub09c 63\uc77c \ub3d9\uc548 10,000\uba85\uc758 \uc0ac\uc6a9\uc790\uac00 \uc571\uc5d0\uc11c \ub370\uc774\ud2b8\ub97c \uacc4\ud68d\ud588\uc2b5\ub2c8\ub2e4. \uadf8\ub9ac\uace0 \ucda9\uaca9\uc801\uc778 \uc0ac\uc2e4\uc744 \ubc1c\uacac\ud588\uc2b5\ub2c8\ub2e4: \ub2e8 1%\uc758 \ucee4\ud50c\ub9cc\uc774 \uc54c\uace0 \uc788\ub294 \ud328\ud134\uc774 \uc874\uc7ac\ud55c\ub2e4\ub294 \uac83. \uadf8\ub4e4\uc740 30\ucd08 \ub9cc\uc5d0 \uc624\ub298 \ubc24\uc744 \uc644\ubcbd\ud558\uac8c \ub9cc\ub4dc\ub294 \ubc29\ubc95\uc744 \uc54c\uace0 \uc788\uc5c8\uc2b5\ub2c8\ub2e4.",
    "\uc6b0\ub9ac\ub294 \ub370\uc774\ud130\ub97c \uc0c5\uc0c5\uc774 \ub4a4\uc84c\uc2b5\ub2c8\ub2e4. \uacb0\uacfc\ub294 \uba85\ud655\ud588\uc2b5\ub2c8\ub2e4. \uadf8 1%\ub294 '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \uce74\ub4dc \ud55c \uc7a5\uc73c\ub85c \ud558\ub8e8\ub97c \uc2dc\uc791\ud588\uc2b5\ub2c8\ub2e4. \ud074\ub9ad \ud55c \ubc88, \ubb34\ub4dc \uc120\ud0dd \uc138 \uac00\uc9c0 \u2014 \ub098\uba38\uc9c0\ub294 AI\uac00 \uc54c\uc544\uc11c \ucc44\uc6e0\uc8e0. \ud3c9\uade0\uc801\uc73c\ub85c \uadf8\ub4e4\uc740 \ud55c \ub2ec\uc5d0 4\ubc30 \ub354 \ub9ce\uc740 \ub370\uc774\ud2b8\ub97c \ud588\uace0, \uad00\uacc4 \ub9cc\uc871\ub3c4\ub294 50% \uc0c1\uc2b9\ud588\uc2b5\ub2c8\ub2e4. \ube44\uacb0\uc740 \uac04\ub2e8\ud588\uc2b5\ub2c8\ub2e4: \uacc4\ud68d\uc774 \uc544\ub2c8\ub77c \uc120\ud0dd\uc5d0 \uc9d1\uc911\ud558\ub294 \uac83.",
    "\uc5ec\uae30\uc5d0 '\ud30c\ud2b8\ub108 \uc81c\uc548 \ucd95\ud558' \uae30\ub2a5\uc774 \ub354\ud574\uc84c\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc774 \ub370\uc774\ud2b8\ub97c \ubcf4\ub0b4\uba74, \uc0c1\ub300\ubc29\uc740 '\uc624\ub298 \ubc24 \ub108\ub97c \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \ud480\uc2a4\ud06c\ub9b0 \uba54\uc2dc\uc9c0\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \uc54c\ub9bc\uc774 \uc544\ub2cc, \uc9c4\uc2ec\uc774 \ub2ff\ub294 \uc21c\uac04\uc774\uc8e0. \uc774 \uc791\uc740 \ucc28\uc774\uac00 99%\uc640 1%\ub97c \uac00\ub985\ub2c8\ub2e4.",
    "\uc624\ub298 \uc800\ub141, \uc571\uc744 \uc5f4\uace0 '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ud0ed\ud558\uc138\uc694. \ubb34\ub4dc\ub97c \uace0\ub974\uace0 30\ucd08\uba74 \ub05d\uc785\ub2c8\ub2e4. \ud30c\ud2b8\ub108\uac00 \ub2f9\uc2e0\uc758 \uc0dd\uac01\uc744 \ub290\ub084 \uac81\ub2c8\ub2e4.\n\nP.S. \ub370\uc774\ud130\ub97c \ub354 \ud30c\uace0\ub4e4\uba74, '\uc704\uc2dc\ub9ac\uc2a4\ud2b8'\uc5d0 \uc800\uc7a5\ub41c \ub370\uc774\ud2b8 \uc544\uc774\ub514\uc5b4\uac00 AI\uc758 \uae5c\uc9dd \ub370\uc774\ud2b8 \uc815\ud655\ub3c4\ub97c 90% \ub192\uc778\ub2e4\ub294 \uc0ac\uc2e4\uc744 \ubc1c\uacac\ud588\uc2b5\ub2c8\ub2e4. \uc9c0\uae08 \ucd94\uac00\ud574\ubcf4\uc138\uc694."
  ],
