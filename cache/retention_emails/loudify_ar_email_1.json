{
  "subject": "\u0633\u0645\u0627\u0639\u0629 \u0627\u0644\u0623\u0630\u0646 \u062a\u062e\u0648\u0646\u0643 \u0641\u064a \u0627\u0644\u0644\u064a\u0644",
  "preview_text": "\u0644\u0645\u0627 \u064a\u0643\u0648\u0646 \u0627\u0644\u0635\u0648\u062a \u0636\u0639\u064a\u0641 \u0648\u0627\u0644\u0636\u0648\u0636\u0627\u0621 \u0639\u0627\u0644\u064a\u0629\u060c \u0641\u064a \u062d\u0644 \u0648\u0627\u062d\u062f \u064a\u062e\u0644\u064a\u0643 \u062a\u0633\u0645\u0639 \u0643\u0644 \u0634\u064a\u0621 \u0628\u0648\u0636\u0648\u062d. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u062c\u0631\u0628.",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u0641\u064a \u0627\u0644\u0645\u062a\u0631\u0648\u060c \u0648\u0627\u0644\u0636\u0648\u0636\u0627\u0621 \u0639\u0627\u0644\u064a\u0629 \u0644\u062f\u0631\u062c\u0629 \u0623\u0646\u0643 \u062a\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0644\u0623\u0642\u0635\u0649 \u062d\u062f\u060c \u0644\u0643\u0646 \u0627\u0644\u062d\u0648\u0627\u0631 \u0644\u0633\u0647 \u0645\u0634 \u0648\u0627\u0636\u062d. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u060c \u0644\u0643\u0646 \u0645\u0634 \u0644\u0627\u0632\u0645 \u064a\u0643\u0648\u0646.",
    "\u0641\u064a Loudify\u060c \u0639\u0646\u062f\u0646\u0627 \u0645\u064a\u0632\u0629 \u0648\u0627\u062d\u062f\u0629 \u062a\u063a\u064a\u0631 \u0643\u0644 \u0634\u064a\u0621: \"AutoEQ\" \u0627\u0644\u0644\u064a \u0628\u062a\u0639\u0631\u0641 \u0633\u0645\u0627\u0639\u062a\u0643 \u0628\u0645\u062c\u0631\u062f \u0645\u0627 \u062a\u0648\u0635\u0644\u0647\u0627. \u0644\u0627 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0645\u0645\u0644\u0629 \u0648\u0644\u0627 \u0628\u062d\u062b \u0639\u0646 \u0628\u0631\u0648\u0641\u0627\u064a\u0644\u0627\u062a. \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u064a\u0636\u0628\u0637 \u0627\u0644\u0635\u0648\u062a \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0644\u064a\u0643\u0648\u0646 \u0639\u0627\u0644\u064a \u0648\u0646\u0642\u064a.",
    "\u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646: \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u062e\u062a\u0631 \u0633\u0645\u0627\u0639\u062a\u0643 \u0645\u0646 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0648\u062f\u064a\u0644\u0627\u062a\u060c \u0648\u0634\u0648\u0641 \u0627\u0644\u0641\u0631\u0642 \u0641\u064a 30 \u062b\u0627\u0646\u064a\u0629. \u0627\u0644\u0635\u0648\u062a \u0628\u064a\u0635\u064a\u0631 \u0623\u0639\u0644\u0649 \u0628\u0640200% \u0645\u0646 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649\u060c \u0648\u0646\u0642\u064a \u062c\u062f\u064b\u0627 \u0644\u062f\u0631\u062c\u0629 \u0623\u0646\u0643 \u062a\u0633\u0645\u0639 \u0627\u0644\u062a\u0646\u0641\u0633.",
    "\u0627\u0641\u062a\u062d Loudify\u060c \u0627\u0631\u0628\u0637 \u0633\u0645\u0627\u0639\u062a\u0643\u060c \u0648\u0627\u062e\u062a\u0628\u0631 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0639\u0627\u0644\u064a \u0627\u0644\u0646\u0642\u064a. P.S. \u0625\u0630\u0627 \u062c\u0631\u0628\u062a \u0627\u0644\u0645\u064a\u0632\u0629 \u0648\u0646\u0633\u064a\u062a \u0625\u0646\u0643 \u0641\u064a \u0627\u0644\u0645\u062a\u0631\u0648\u060c \u0647\u0630\u064a \u0639\u0644\u0627\u0645\u0629 \u0625\u0646\u0643 \u0627\u0633\u062a\u0641\u062f\u062a."
  ],
