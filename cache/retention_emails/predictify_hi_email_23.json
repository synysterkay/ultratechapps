{
  "subject": "\u092e\u0948\u091a \u0938\u0947 \u092a\u0939\u0932\u0947 \u092e\u0947\u0930\u0940 \u0939\u093e\u0932\u0924 vs \u0905\u092c \u2014 53 \u0926\u093f\u0928\u094b\u0902 \u0915\u093e \u092b\u0930\u094d\u0915",
  "preview_text": "\u092a\u0939\u0932\u0947 \u092e\u0948\u0902 \u092c\u093f\u0928\u093e \u0921\u0947\u091f\u093e \u0915\u0947 \u0905\u0902\u0926\u093e\u091c\u093c\u093e \u0932\u0917\u093e\u0924\u093e \u0925\u093e\u0964 \u0905\u092c AI \u092e\u0941\u091d\u0947 \u092c\u0924\u093e \u0926\u0947\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u093f\u0938 \u091f\u0940\u092e \u0915\u0947 \u091c\u0940\u0924\u0928\u0947 \u0915\u0940 \u0915\u093f\u0924\u0928\u0940 \u0938\u0902\u092d\u093e\u0935\u0928\u093e \u0939\u0948\u0964 \u092f\u0947 \u092c\u0926\u0932\u093e\u0935 \u0936\u0930\u094d\u092e\u0928\u093e\u0915 \u0939\u0948\u0964",
  "body_paragraphs": [
    "53 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u092e\u0948\u0902 \u092e\u0948\u091a \u0926\u0947\u0916\u0928\u0947 \u092c\u0948\u0920\u0924\u093e \u0925\u093e, \u0914\u0930 \u092e\u0947\u0930\u0940 \u092a\u0942\u0930\u0940 \u0938\u094b\u091a '\u092f\u0947 \u091f\u0940\u092e \u0905\u091a\u094d\u091b\u0940 \u0932\u0917\u0924\u0940 \u0939\u0948' \u092a\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0939\u094b\u0924\u0940 \u0925\u0940\u0964 \u0928\u0924\u0940\u091c\u093e? \u0939\u0930 \u0926\u0942\u0938\u0930\u093e \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0917\u0932\u0924, \u0914\u0930 \u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u092c\u0947\u0935\u0915\u0942\u092b \u092c\u0928\u0928\u093e\u0964 \u092e\u0948\u0902 \u0938\u094b\u091a\u0924\u093e \u0925\u093e \u0915\u093f \u092e\u0941\u091d\u0947 \u092b\u0941\u091f\u092c\u0949\u0932 \u0906\u0924\u0940 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932\u093f\u092f\u0924 \u092f\u0947 \u0925\u0940 \u0915\u093f \u092e\u0948\u0902 \u0938\u093f\u0930\u094d\u092b \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u092a\u0930 \u091a\u0932 \u0930\u0939\u093e \u0925\u093e\u0964",
    "\u0905\u092c \u090f\u0915 \u0939\u092b\u094d\u0924\u0947 \u092e\u0947\u0902 \u0939\u0940 \u092b\u0930\u094d\u0915 \u0926\u093f\u0916\u0928\u0947 \u0932\u0917\u093e\u0964 \u092a\u093f\u091b\u0932\u0947 \u092e\u0939\u0940\u0928\u0947 \u092e\u0948\u0902\u0928\u0947 15 \u092e\u0947\u0902 \u0938\u0947 12 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0938\u0939\u0940 \u0915\u093f\u090f \u2014 \u0938\u093f\u0930\u094d\u092b \u0907\u0938\u0932\u093f\u090f \u0915\u093f \u092e\u0948\u0902\u0928\u0947 AI \u0915\u0947 \u0906\u0902\u0915\u0921\u093c\u094b\u0902 \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u0915\u093f\u092f\u093e\u0964 \u0939\u0930 \u092e\u0948\u091a \u0938\u0947 \u092a\u0939\u0932\u0947 \u092e\u0941\u091d\u0947 \u092a\u0924\u093e \u0939\u094b\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u093f\u0938 \u091f\u0940\u092e \u0915\u093e xG \u092c\u0947\u0939\u0924\u0930 \u0939\u0948, \u0915\u094c\u0928 \u0938\u0940 \u091f\u0940\u092e \u0921\u093f\u092b\u0947\u0902\u0938 \u092e\u0947\u0902 \u0915\u092e\u091c\u093c\u094b\u0930 \u0939\u0948, \u0914\u0930 \u0915\u093f\u0938 \u092e\u0948\u091a \u092e\u0947\u0902 \u0935\u0948\u0932\u094d\u092f\u0942 \u092c\u0947\u091f \u091b\u093f\u092a\u093e \u0939\u0948\u0964 \u092f\u0947 \u090f\u0939\u0938\u093e\u0938 \u092c\u0947\u0939\u0926 \u0936\u0930\u094d\u092e\u0928\u093e\u0915 \u0939\u0948 \u0915\u093f \u092e\u0948\u0902 \u0907\u0924\u0928\u0947 \u0938\u093e\u0932\u094b\u0902 \u0938\u0947 \u092c\u093f\u0928\u093e \u0921\u0947\u091f\u093e \u0915\u0947 \u092b\u0941\u091f\u092c\u0949\u0932 \u0926\u0947\u0916 \u0930\u0939\u093e \u0925\u093e\u0964",
    "Predictify \u0915\u093e AI \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u0935\u0947\u0930\u093f\u090f\u092c\u0932\u094d\u0938 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0930\u0924\u093e \u0939\u0948 \u2014 \u092a\u093f\u091b\u0932\u0947 10 \u092e\u0948\u091a\u094b\u0902 \u0915\u093e \u0939\u0947\u0921-\u091f\u0942-\u0939\u0947\u0921, \u092a\u094d\u0932\u0947\u092f\u0930 \u092b\u0949\u0930\u094d\u092e, \u091f\u0940\u092e \u0915\u0940 \u0905\u091f\u0948\u0915\u093f\u0902\u0917 \u090f\u092b\u093f\u0936\u093f\u090f\u0902\u0938\u0940, \u092f\u0939\u093e\u0901 \u0924\u0915 \u0915\u093f \u092e\u094c\u0938\u092e \u0915\u093e \u0905\u0938\u0930 \u092d\u0940\u0964 \u0914\u0930 \u0906\u092a\u0915\u094b \u090f\u0915 \u0915\u094d\u0932\u093f\u092f\u0930 \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0905\u092c \u092e\u0948\u0902 \u092c\u093f\u0928\u093e \u0921\u0947\u091f\u093e \u0915\u0947 \u0915\u094b\u0908 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e \u2014 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092e\u0941\u091d\u0947 \u092a\u0924\u093e \u0939\u0948 \u0915\u093f \u092c\u093f\u0928\u093e \u0921\u0947\u091f\u093e \u0915\u0947 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0905\u0902\u0926\u093e\u091c\u093c\u093e \u0939\u0948\u0964",
    "\u0906\u092a \u092d\u0940 \u092f\u0947 \u092b\u0930\u094d\u0915 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f AI \u0915\u093e \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0926\u0947\u0916\u0947\u0902\u0964 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u090f\u0915 \u092e\u0948\u091a \u091a\u0941\u0928\u0947\u0902' \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u0926\u0947\u0916\u093f\u090f \u0915\u093f \u0921\u0947\u091f\u093e \u0906\u092a\u0915\u0940 \u0938\u094b\u091a \u0915\u094b \u0915\u0948\u0938\u0947 \u092c\u0926\u0932 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 P.S. 3 \u0926\u093f\u0928 \u0915\u093e \u092b\u094d\u0930\u0940 \u091f\u094d\u0930\u093e\u092f\u0932 \u0939\u0948 \u2014 $12.99/\u092e\u0939\u0940\u0928\u093e \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092e\u0947\u0902 \u0906\u092a\u0915\u094b \u0939\u0930 \u0932\u0940\u0917 \u0915\u0947 \u0932\u093f\u090f \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u0938\u094d\u091f\u0948\u091f\u094d\u0938 \u0914\u0930 \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u092e\u093f\u0932\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u091c \u0939\u0940 \u091f\u094d\u0930\u093e\u092f \u0915\u0930\u0947\u0902\u0964"
  ],
