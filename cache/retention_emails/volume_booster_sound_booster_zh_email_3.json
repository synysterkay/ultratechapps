{
  "subject": "90%\u7684\u4eba\u90fd\u5ffd\u7565\u4e86\u8fd9\u4e2a\u81f4\u547d\u9519\u8bef",
  "preview_text": "\u4f60\u4e5f\u5728\u8fd9\u6837\u7528\u5747\u8861\u5668\u5417\uff1f\u4e00\u4e2a\u5fae\u5c0f\u8c03\u6574\uff0c\u8ba9\u4f60\u7684\u624b\u673a\u97f3\u8d28\u77ac\u95f4\u63d0\u5347200%\uff0c\u50cf\u6362\u4e86\u65b0\u8bbe\u5907\u3002",
  "body_paragraphs": [
    "\u6628\u5929\u6211\u670b\u53cb\u62b1\u6028\uff0c\u8bf4\u5f00\u4e86\u5747\u8861\u5668\u97f3\u8d28\u53cd\u800c\u66f4\u7cdf\uff0c\u58f0\u97f3\u5c16\u9510\u523a\u8033\u3002\u6211\u62ff\u8fc7\u4ed6\u624b\u673a\u4e00\u770b\u2014\u2014\u679c\u7136\uff0c\u4ed6\u72af\u4e86\u4e00\u4e2a\u51e0\u4e4e\u6240\u6709\u4eba\u90fd\u4f1a\u72af\u7684\u9519\u3002",
    "\u5747\u8861\u5668\u4e0d\u662f\u8c03\u5f97\u8d8a\u6781\u7aef\u8d8a\u597d\u3002\u5f88\u591a\u4eba\u4e00\u4e0a\u6765\u5c31\u628a\u6240\u6709\u6ed1\u5757\u62c9\u5230\u9876\uff0c\u4ee5\u4e3a\u8fd9\u6837\u6700\u2018\u52b2\u7206\u2019\u3002\u7ed3\u679c\u5462\uff1f\u58f0\u97f3\u5931\u771f\u3001\u7834\u97f3\uff0c\u7ec6\u8282\u5168\u7cca\u6210\u4e00\u56e2\u3002\u771f\u6b63\u7684\u79d8\u5bc6\u5728\u4e8e\uff1a\u53ea\u52a8\u4e00\u4e2a\u5173\u952e\u9891\u6bb5\u3002",
    "\u6253\u5f00\u5747\u8861\u5668\uff0c\u627e\u5230\u201860Hz-250Hz\u2019\u8fd9\u4e2a\u4f4e\u9891\u533a\u3002\u73b0\u5728\uff0c\u53ea\u628a\u8fd9\u4e00\u5757\u5f80\u4e0a\u63a830%\u3002\u5176\u4ed6\u6240\u6709\u6ed1\u5757\u4fdd\u6301\u4e0d\u52a8\u3002\u8fd9\u4e2a\u5fae\u8c03\u5c31\u662f\u9b54\u6cd5\u5f00\u5173\u2014\u2014\u5b83\u4e0d\u4f1a\u8ba9\u58f0\u97f3\u70b8\u88c2\uff0c\u4f46\u4f1a\u77ac\u95f4\u8865\u8db3\u4f60\u97f3\u4e50\u91cc\u7f3a\u5931\u7684\u2018\u8eab\u4f53\u611f\u2019\uff0c\u4eba\u58f0\u66f4\u9971\u6ee1\uff0c\u9f13\u70b9\u66f4\u6709\u5f39\u6027\uff0c\u5c31\u50cf\u7ed9\u58f0\u97f3\u6ce8\u5165\u4e86\u7075\u9b42\u3002",
    "\u73b0\u5728\u5c31\u6253\u5f00\u5e94\u7528\uff0c\u5728\u5747\u8861\u5668\u91cc\u8bd5\u8bd5\u8fd9\u4e2a\u2018\u5355\u70b9\u63d0\u5347\u6cd5\u2019\u300230\u79d2\uff0c\u4f60\u5c31\u80fd\u542c\u5230\u533a\u522b\u3002P.S. \u5982\u679c\u4f60\u5df2\u7ecf\u5347\u7ea7\u5230Premium\uff0c\u8bd5\u8bd5\u5728\u2018\u9ad8\u7ea7\u63a7\u5236\u2019\u91cc\u628a\u4f4e\u9891\u7684Q\u503c\u8c03\u5bbd\uff0c\u6548\u679c\u4f1a\u66f4\u81ea\u7136\u2014\u2014\u8fd9\u5c31\u50cf\u4ece\u666e\u901a\u8033\u673a\u6362\u5230\u76d1\u542c\u7ea7\u8bbe\u5907\u7684\u533a\u522b\u3002",
    "\u7acb\u523b\u4f53\u9a8c\u8fd9\u4e2a\u5fae\u5c0f\u8c03\u6574"
  ],
