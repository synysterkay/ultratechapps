  "preview_text": "\u4e00\u4e2a\u7b80\u5355\u64cd\u4f5c\uff0c\u8ba9\u4f60\u624b\u673a\u97f3\u91cf\u77ac\u95f4\u7ffb\u500d\uff0c\u97f3\u8d28\u66f4\u6e05\u6670\u3002",
