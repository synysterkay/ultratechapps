  "subject": "\u0635\u0648\u062a\u0643 \u0627\u0644\u0636\u0627\u0626\u0639 \u0641\u064a \u0632\u062d\u0645\u0629 \u0627\u0644\u0639\u064a\u062f",
  "preview_text": "\u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0627\u062a \u0648\u0627\u0644\u0645\u0633\u0644\u0633\u0644\u0627\u062a \u062a\u062e\u062a\u0641\u064a \u0641\u064a \u0636\u0648\u0636\u0627\u0621 \u0627\u0644\u0639\u064a\u062f\u061f \u062c\u0631\u0628 \u0645\u064a\u0632\u0629 Podcast Mode \u0627\u0644\u0622\u0646.",
  "body_paragraphs": [
    "\u0627\u0644\u0639\u064a\u062f \u0647\u0646\u0627\u060c \u0648\u0627\u0644\u0628\u064a\u062a \u0645\u0644\u064a\u0627\u0646 \u0646\u0627\u0633\u060c \u0648\u0627\u0644\u062a\u0644\u0641\u0632\u064a\u0648\u0646 \u0634\u063a\u0627\u0644\u060c \u0648\u0627\u0644\u0623\u0637\u0641\u0627\u0644 \u064a\u0644\u0639\u0628\u0648\u0646. \u062a\u0633\u0645\u0639 \u0635\u0648\u062a \u0627\u0644\u0645\u0633\u0644\u0633\u0644\u061f \u0648\u0644\u0627 \u0628\u0633 \u0627\u0644\u0636\u0648\u0636\u0627\u0621\u061f",
    "\u0644\u0623\u0646\u0647 \u0627\u0644\u0639\u064a\u062f\u060c \u0645\u0627 \u0641\u064a \u0648\u0642\u062a \u062a\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0648\u062a\u0632\u0639\u062c \u0627\u0644\u0644\u064a \u062d\u0648\u0627\u0644\u064a\u0643. \u0628\u0633 \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0625\u0646 \u0627\u0644\u0635\u0648\u062a \u064a\u0636\u064a\u0639 \u0648\u0633\u0637 \u0627\u0644\u0632\u062d\u0645\u0629. \u062a\u0633\u0645\u0639 \u0643\u0644\u0645\u0629 \u0648\u062a\u0641\u0642\u062f \u0627\u0644\u062b\u0627\u0646\u064a\u0629.",
    "\u0644\u0647\u0630\u0627 \u0627\u0644\u0633\u0628\u0628 \u0628\u0646\u064a\u062a \u0645\u064a\u0632\u0629 Podcast Mode \u0641\u064a Loudify. \u062a\u0631\u0641\u0639 \u0648\u0636\u0648\u062d \u0627\u0644\u0635\u0648\u062a \u0648\u062a\u062e\u0644\u064a \u0627\u0644\u0643\u0644\u0627\u0645 \u0648\u0627\u0636\u062d \u062d\u062a\u0649 \u0644\u0648 \u0643\u0627\u0646 \u0627\u0644\u0645\u0643\u0627\u0646 \u0623\u0634\u0628\u0647 \u0628\u0633\u0648\u0642. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u064a\u0648\u0645 \u0639\u0644\u0649 \u0623\u064a \u062a\u0637\u0628\u064a\u0642\u2014Spotify\u060c YouTube\u060c \u0623\u0648 \u062d\u062a\u0649 \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0627\u062a.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u062e\u062a\u0631 Podcast Mode\u060c \u0648\u0627\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0628\u062d\u062f \u0623\u0642\u0635\u0649 \u0628\u062f\u0648\u0646 \u062a\u0634\u0648\u064a\u0647. \u0627\u0644\u0639\u064a\u062f \u0645\u0627 \u064a\u0646\u062a\u0647\u064a \u0648\u0627\u0644\u0635\u0648\u062a \u064a\u0628\u0642\u0649 \u0648\u0627\u0636\u062d. \u0645\u0644\u0627\u062d\u0638\u0629: \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u0648\u0646 \u0641\u064a Premium \u064a\u0642\u062f\u0631\u0648\u0646 \u064a\u062d\u0641\u0638\u0648\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0644\u0643\u0644 \u0633\u0645\u0627\u0639\u0629."
