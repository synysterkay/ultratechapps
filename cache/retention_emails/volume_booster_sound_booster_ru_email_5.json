{
  "subject": "\u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435: \u044f \u0441\u043e\u0437\u0434\u0430\u043b \u044d\u0442\u043e \u0432 2 \u0447\u0430\u0441\u0430 \u043d\u043e\u0447\u0438",
  "preview_text": "\u0420\u0435\u0430\u043b\u044c\u043d\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f, \u043f\u043e\u0447\u0435\u043c\u0443 \u044f \u0441\u0438\u0434\u0435\u043b \u0431\u0435\u0437 \u0441\u043d\u0430 \u0438 \u043f\u0438\u0441\u0430\u043b \u043a\u043e\u0434 \u0434\u043b\u044f Volume Booster. \u042d\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e \u0432\u0441\u0451.",
  "body_paragraphs": [
    "\u042f \u0441\u0438\u0434\u0435\u043b \u043d\u0430 \u043a\u0443\u0445\u043d\u0435 \u0432 2:23 \u043d\u043e\u0447\u0438, \u043f\u0438\u043b \u0442\u0440\u0435\u0442\u044c\u044e \u0447\u0430\u0448\u043a\u0443 \u043a\u043e\u0444\u0435 \u0438 \u0441\u043c\u043e\u0442\u0440\u0435\u043b \u043d\u0430 \u0441\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d. \u0412 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u0445 \u0438\u0433\u0440\u0430\u043b \u0442\u0440\u0435\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u044f \u043e\u0431\u043e\u0436\u0430\u043b, \u043d\u043e \u0437\u0432\u0443\u043a \u0431\u044b\u043b \u043f\u043b\u043e\u0441\u043a\u0438\u043c, \u0431\u0435\u0437 \u0431\u0430\u0441\u0430, \u0431\u0435\u0437 \u0436\u0438\u0437\u043d\u0438. \u042f \u043f\u0435\u0440\u0435\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u043b \u0432\u0441\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u2014 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043f\u043e\u043c\u043e\u0433\u0430\u043b\u043e. \u0418 \u0442\u043e\u0433\u0434\u0430 \u044f \u0440\u0435\u0448\u0438\u043b: \u0445\u0432\u0430\u0442\u0438\u0442. \u042f \u043d\u0430\u043f\u0438\u0448\u0443 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0441\u0434\u0435\u043b\u0430\u0435\u0442 \u0437\u0432\u0443\u043a \u0442\u0430\u043a\u0438\u043c, \u043a\u0430\u043a\u0438\u043c \u043e\u043d \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c.",
    "\u042d\u0442\u043e \u043d\u0435 \u0431\u044b\u043b \u043f\u043b\u0430\u043d. \u042d\u0442\u043e \u0431\u044b\u043b\u0430 \u044f\u0440\u043e\u0441\u0442\u044c. \u042f \u0445\u043e\u0442\u0435\u043b \u0441\u043b\u044b\u0448\u0430\u0442\u044c \u043a\u0430\u0436\u0434\u0443\u044e \u043d\u043e\u0442\u0443, \u043a\u0430\u0436\u0434\u044b\u0439 \u0443\u0434\u0430\u0440 \u0431\u0430\u0441\u0430, \u043a\u0430\u0436\u0434\u0443\u044e \u0434\u0435\u0442\u0430\u043b\u044c \u0432\u043e\u043a\u0430\u043b\u0430. \u0427\u0435\u0440\u0435\u0437 \u0442\u0440\u0438 \u0447\u0430\u0441\u0430 \u0443 \u043c\u0435\u043d\u044f \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0432\u0430\u044f \u0432\u0435\u0440\u0441\u0438\u044f Volume Booster. \u041e\u043d\u0430 \u0431\u044b\u043b\u0430 \u0441\u044b\u0440\u043e\u0439, \u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430. \u042f \u0432\u043a\u043b\u044e\u0447\u0438\u043b \u0442\u0440\u0435\u043a \u2014 \u0438 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b, \u043a\u0430\u043a \u0432\u0438\u0431\u0440\u0430\u0446\u0438\u044f \u043f\u0440\u043e\u0448\u043b\u0430 \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u043e\u043b. \u0412 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442 \u044f \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0444\u0438\u0447\u0430. \u042d\u0442\u043e \u0441\u043f\u043e\u0441\u043e\u0431 \u0432\u0435\u0440\u043d\u0443\u0442\u044c \u043c\u0443\u0437\u044b\u043a\u0435 \u0435\u0451 \u0434\u0443\u0448\u0443.",
    "\u0422\u0430 \u0441\u0430\u043c\u0430\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u044f \u0434\u043e\u0431\u0430\u0432\u0438\u043b \u0442\u043e\u0439 \u043d\u043e\u0447\u044c\u044e, \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u00ab\u0423\u0441\u0438\u043b\u0438\u0442\u0435\u043b\u044c \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438\u00bb \u0438 \u00ab\u042d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440\u00bb. \u041e\u0434\u043d\u043e \u043d\u0430\u0436\u0430\u0442\u0438\u0435 \u2014 \u0438 \u0432\u0430\u0448 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0437\u0432\u0443\u0447\u0438\u0442 \u043a\u0430\u043a \u043d\u043e\u0432\u0430\u044f \u0430\u043a\u0443\u0441\u0442\u0438\u043a\u0430. \u0411\u0430\u0441 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u043c, \u0432\u043e\u043a\u0430\u043b \u2014 \u0447\u0438\u0441\u0442\u044b\u043c, \u0430 \u043e\u0431\u0449\u0430\u044f \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0432\u044b\u0440\u0430\u0441\u0442\u0430\u0435\u0442 \u043d\u0430 200%. \u042f \u0441\u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e \u0434\u043b\u044f \u0441\u0435\u0431\u044f. \u041d\u043e \u0442\u0435\u043f\u0435\u0440\u044c \u044d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0434\u043b\u044f \u0432\u0430\u0441.",
    "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u043f\u0440\u0435\u0441\u0435\u0442 \u00abRock\u00bb \u0438\u043b\u0438 \u00abElectronic\u00bb \u2014 \u0442\u043e\u0442, \u0447\u0442\u043e \u0431\u043b\u0438\u0436\u0435 \u0432\u0430\u0448\u0435\u043c\u0443 \u0441\u0435\u0440\u0434\u0446\u0443. \u041f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435 \u0440\u0430\u0437\u043d\u0438\u0446\u0443. \u042f \u043e\u0431\u0435\u0449\u0430\u044e, \u0432\u044b \u043d\u0435 \u0432\u0435\u0440\u043d\u0451\u0442\u0435\u0441\u044c \u043a \u043e\u0431\u044b\u0447\u043d\u043e\u043c\u0443 \u0437\u0432\u0443\u043a\u0443. P.S. \u041d\u043e\u0447\u043d\u044b\u0435 \u0441\u0435\u0441\u0441\u0438\u0438 \u043a\u043e\u0434\u0430 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e\u0442\u0441\u044f \u2014 \u043f\u0440\u0435\u043c\u0438\u0443\u043c-\u0432\u0435\u0440\u0441\u0438\u044f \u043f\u043e\u043b\u0443\u0447\u0438\u0442 \u043d\u043e\u0432\u044b\u0435 \u0440\u0435\u0436\u0438\u043c\u044b \u0443\u0436\u0435 \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u043d\u0435\u0434\u0435\u043b\u0435. \u0411\u0443\u0434\u044c\u0442\u0435 \u043f\u0435\u0440\u0432\u044b\u043c\u0438, \u043a\u0442\u043e \u0438\u0445 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0435\u0442."
  ],
