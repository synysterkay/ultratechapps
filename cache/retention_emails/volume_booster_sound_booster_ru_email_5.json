{
  "subject": "\u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435: \u044f \u0441\u043e\u0437\u0434\u0430\u043b \u044d\u0442\u0443 \u0444\u0443\u043d\u043a\u0446\u0438\u044e \u0432 2 \u043d\u043e\u0447\u0438 \u043f\u043e \u043e\u0448\u0438\u0431\u043a\u0435",
  "preview_text": "\u041f\u043e\u0447\u0435\u043c\u0443 \u044f \u043d\u0435 \u0441\u043f\u0430\u043b \u0438 \u0434\u0435\u043b\u0430\u043b \u0442\u043e, \u0447\u0442\u043e, \u043a\u0430\u043a \u044f \u0434\u0443\u043c\u0430\u043b, \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0441\u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442. \u0418 \u043a\u0430\u043a \u044d\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e \u0432\u0441\u0451.",
  "body_paragraphs": [
    "\u0411\u044b\u043b\u0430 \u0433\u043b\u0443\u0431\u043e\u043a\u0430\u044f \u043d\u043e\u0447\u044c, \u043d\u0430 \u0447\u0430\u0441\u0430\u0445 2:17. \u042f \u0441\u0438\u0434\u0435\u043b \u0441 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u043c\u0438, \u043f\u044b\u0442\u0430\u044f\u0441\u044c \u0434\u043e\u0441\u043b\u0443\u0448\u0430\u0442\u044c \u043f\u043e\u0434\u043a\u0430\u0441\u0442, \u043d\u043e \u0448\u0443\u043c \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0442\u043e\u0440\u0430 \u043d\u043e\u0443\u0442\u0431\u0443\u043a\u0430 \u0437\u0430\u0433\u043b\u0443\u0448\u0430\u043b \u043a\u0430\u0436\u0434\u043e\u0435 \u0441\u043b\u043e\u0432\u043e. \u042f \u0431\u044b\u043b \u0432 \u044f\u0440\u043e\u0441\u0442\u0438 \u043e\u0442 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043c\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u0432\u044b\u0434\u0430\u0432\u0430\u0442\u044c \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0437\u0432\u0443\u043a. \u0418 \u0442\u043e\u0433\u0434\u0430 \u044f \u0441\u0434\u0435\u043b\u0430\u043b \u0442\u043e, \u0447\u0442\u043e \u0432\u0441\u0435 \u043c\u043e\u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u043d\u0430\u0437\u0432\u0430\u043b\u0438 \u0431\u044b \u0431\u0435\u0437\u0443\u043c\u0438\u0435\u043c.",
    "\u0412\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u043b\u0435\u0447\u044c \u0441\u043f\u0430\u0442\u044c, \u044f \u043e\u0442\u043a\u0440\u044b\u043b \u043a\u043e\u0434. \u041d\u0435 \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0441\u0438\u043b\u0438\u0442\u044c \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u2014 \u044d\u0442\u043e \u043c\u044b \u0443\u0436\u0435 \u0443\u043c\u0435\u043b\u0438. \u0410 \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0439\u0442\u0438 \u0441\u043f\u043e\u0441\u043e\u0431 \u00ab\u0432\u044b\u0442\u044f\u043d\u0443\u0442\u044c\u00bb \u0442\u0438\u0445\u0438\u0435 \u0433\u043e\u043b\u043e\u0441\u0430, \u0448\u0435\u043f\u043e\u0442 \u0432 \u0444\u0438\u043b\u044c\u043c\u0430\u0445, \u0434\u0435\u0442\u0430\u043b\u0438 \u0432 \u043c\u0443\u0437\u044b\u043a\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0435\u0440\u044f\u044e\u0442\u0441\u044f \u0432 \u0444\u043e\u043d\u043e\u0432\u043e\u043c \u0448\u0443\u043c\u0435. \u042f \u0445\u043e\u0442\u0435\u043b \u043d\u0435 \u043a\u0440\u0438\u043a, \u0430 \u044f\u0441\u043d\u043e\u0441\u0442\u044c. \u0418 \u0432 \u0442\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u0433\u0434\u0430 \u0443\u0436\u0435 \u043f\u043e\u0447\u0442\u0438 \u0441\u0434\u0430\u043b\u0441\u044f, \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e \u0441\u043c\u0435\u0448\u0430\u043b \u0434\u0432\u0430 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0430 \u2014 \u0443\u0441\u0438\u043b\u0438\u0442\u0435\u043b\u044c \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438 \u0438 \u0444\u0438\u043b\u044c\u0442\u0440 \u0447\u0430\u0441\u0442\u043e\u0442. \u0418 \u0441\u043b\u0443\u0447\u0438\u043b\u043e\u0441\u044c \u0447\u0443\u0434\u043e.",
    "\u042d\u0442\u043e\u0442 \u043d\u043e\u0447\u043d\u043e\u0439 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442 \u0441\u0442\u0430\u043b \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u00ab\u0423\u0441\u0438\u043b\u0438\u0442\u0435\u043b\u044c \u0447\u0435\u0442\u043a\u043e\u0441\u0442\u0438\u00bb \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u00ab\u042d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440\u00bb. \u041e\u043d\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0437\u0432\u0443\u043a \u0433\u0440\u043e\u043c\u0447\u0435. \u041e\u043d\u0430 \u0432\u044b\u0442\u0430\u0441\u043a\u0438\u0432\u0430\u0435\u0442 \u043d\u0430 \u043f\u0435\u0440\u0435\u0434\u043d\u0438\u0439 \u043f\u043b\u0430\u043d \u0442\u043e, \u0447\u0442\u043e \u0432\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u0441\u043b\u044b\u0448\u0430\u0442\u044c, \u0438 \u043f\u0440\u0438\u0433\u043b\u0443\u0448\u0430\u0435\u0442 \u0432\u0441\u0451 \u043b\u0438\u0448\u043d\u0435\u0435. \u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0434\u043b\u044f \u043f\u043e\u0434\u043a\u0430\u0441\u0442\u043e\u0432 \u0438 \u0444\u0438\u043b\u044c\u043c\u043e\u0432 \u0441 \u0442\u0438\u0445\u0438\u043c\u0438 \u0434\u0438\u0430\u043b\u043e\u0433\u0430\u043c\u0438. \u042d\u0442\u043e \u043d\u0435 \u043c\u0430\u0433\u0438\u044f, \u044d\u0442\u043e \u0442\u0430 \u0441\u0430\u043c\u0430\u044f \u043e\u0448\u0438\u0431\u043a\u0430 \u0432 2 \u0443\u0442\u0440\u0430.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0437\u0430\u0439\u0434\u0438 \u0432 \u00ab\u042d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440\u00bb \u0438 \u0432\u044b\u0431\u0435\u0440\u0438 \u043f\u0440\u0435\u0441\u0435\u0442 \u00ab\u041f\u043e\u0434\u043a\u0430\u0441\u0442\u044b\u00bb \u0438\u043b\u0438 \u0441\u043e\u0437\u0434\u0430\u0439 \u0441\u0432\u043e\u0439, \u0441\u0434\u0432\u0438\u043d\u0443\u0432 \u043f\u043e\u043b\u0437\u0443\u043d\u043a\u0438 \u0441\u0440\u0435\u0434\u043d\u0438\u0445 \u0447\u0430\u0441\u0442\u043e\u0442. \u0422\u044b \u0443\u0441\u043b\u044b\u0448\u0438\u0448\u044c \u0440\u0430\u0437\u043d\u0438\u0446\u0443 \u0441\u0440\u0430\u0437\u0443. P.S. \u0417\u043d\u0430\u0435\u0448\u044c, \u0441\u0430\u043c\u0430\u044f \u0447\u0430\u0441\u0442\u0430\u044f \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u044c, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u044f \u043f\u043e\u043b\u0443\u0447\u0430\u044e, \u0437\u0432\u0443\u0447\u0438\u0442 \u0442\u0430\u043a: \u00ab\u042f \u043d\u0430\u043a\u043e\u043d\u0435\u0446-\u0442\u043e \u0440\u0430\u0441\u0441\u043b\u044b\u0448\u0430\u043b, \u0447\u0442\u043e \u0448\u0435\u043f\u0447\u0443\u0442 \u0433\u0435\u0440\u043e\u0438 \u0432 \u0442\u043e\u043c \u0441\u0442\u0430\u0440\u043e\u043c \u0444\u0438\u043b\u044c\u043c\u0435\u00bb. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439, \u0438 \u0442\u044b \u043f\u043e\u0439\u043c\u0435\u0448\u044c, \u043e \u0447\u0435\u043c \u043e\u043d\u0438.",
    "\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u043f\u0440\u0435\u0441\u0435\u0442 '\u041f\u043e\u0434\u043a\u0430\u0441\u0442\u044b' \u0441\u0435\u0439\u0447\u0430\u0441"
  ],
