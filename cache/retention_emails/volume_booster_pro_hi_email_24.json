{
  "subject": "\u0930\u093e\u091c\u0942 \u0915\u0940 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940",
  "preview_text": "\u090f\u0915 \u092f\u0942\u091c\u0930 \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0915\u0948\u0938\u0947 \u0909\u0938\u0928\u0947 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f\u0930 \u092a\u094d\u0930\u094b \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e\u0964 \u0939\u092e\u093e\u0930\u0940 \u092a\u0942\u0930\u0940 \u091f\u0940\u092e \u0928\u0947 \u0907\u0938\u0947 \u092a\u0922\u093c\u093e\u0964",
  "body_paragraphs": [
    "\u0930\u093e\u091c\u0942 \u0928\u0947 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0939\u092e\u0947\u0902 \u090f\u0915 \u092e\u0948\u0938\u0947\u091c \u092d\u0947\u091c\u093e\u0964 \u0935\u0939 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928 \u0930\u0939\u093e \u0925\u093e, \u0914\u0930 \u092c\u0940\u091a \u092e\u0947\u0902 \u090f\u0915 \u090f\u0921 \u0906 \u0917\u092f\u093e\u0964 \u0909\u0938\u0928\u0947 \u0915\u0939\u093e, '\u092c\u0938 \u092f\u0939\u0940 \u090f\u0915 \u091a\u0940\u091c\u093c \u0939\u0948 \u091c\u094b \u092e\u0941\u091d\u0947 \u091a\u093e\u0939\u093f\u090f \u2014 \u0938\u094d\u0932\u093e\u0907\u0921\u0930, \u0914\u0930 \u0915\u0941\u091b \u0928\u0939\u0940\u0902\u0964' \u0939\u092e\u0928\u0947 \u0909\u0938\u0915\u0940 \u092c\u093e\u0924 \u0938\u0941\u0928\u0915\u0930 \u092a\u0942\u0930\u0940 \u091f\u0940\u092e \u0915\u094b \u0930\u094b\u0915\u093e\u0964",
    "\u0930\u093e\u091c\u0942 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u0939\u092e\u093e\u0930\u0947 \u0932\u093f\u090f \u090f\u0915 \u0938\u092c\u0915 \u0925\u0940\u0964 \u0935\u0939 \u092b\u094d\u0930\u0940 \u0935\u0930\u094d\u0936\u0928 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u093e \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u090f\u0921\u094d\u0938 \u0928\u0947 \u0909\u0938\u0947 \u092a\u0930\u0947\u0936\u093e\u0928 \u0915\u0930 \u0926\u093f\u092f\u093e \u0925\u093e\u0964 \u0909\u0938\u0928\u0947 \u0915\u0939\u093e, '\u092e\u0948\u0902 \u0938\u093f\u0930\u094d\u092b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0902, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u092f\u093e \u0917\u0947\u092e \u0915\u0947\u0964' \u0909\u0938\u0928\u0947 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0932\u093f\u092f\u093e, \u0914\u0930 \u0905\u092c \u0935\u0939 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0930\u0941\u0915\u093e\u0935\u091f \u0915\u0947 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u0924\u093e \u0939\u0948\u0964",
    "\u0930\u093e\u091c\u0942 \u0915\u0940 \u0924\u0930\u0939, \u0906\u092a \u092d\u0940 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f\u0930 \u092a\u094d\u0930\u094b \u092e\u0947\u0902 \u090f\u0915 \u091a\u0940\u091c\u093c \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902: '\u0911\u091f\u094b-\u0905\u092a\u094d\u0932\u093e\u0908 \u0911\u0928 \u0939\u0947\u0921\u092b\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f'\u0964 \u092f\u0939 \u092b\u0940\u091a\u0930 \u0906\u092a\u0915\u0947 \u0939\u0947\u0921\u092b\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b\u0924\u0947 \u0939\u0940 \u0905\u092a\u0928\u0947 \u0906\u092a \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u090f\u0921 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0928\u0939\u0940\u0902 \u2014 \u092c\u0938 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0914\u0930 \u0915\u0941\u091b \u0928\u0939\u0940\u0902\u0964",
    "\u0906\u091c \u0939\u0940 \u0905\u092a\u0928\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f\u0930 \u092a\u094d\u0930\u094b \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0907\u0938 \u092b\u0940\u091a\u0930 \u0915\u094b \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902\u0964 \u092a\u0940.\u090f\u0938. \u2014 \u0930\u093e\u091c\u0942 \u0928\u0947 \u0915\u0939\u093e \u0915\u093f \u0935\u0939 \u0905\u092c \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092d\u0940 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u092a\u0930\u0947\u0936\u093e\u0928\u0940 \u0915\u0947 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u0924\u093e \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0906\u092a \u092d\u0940 \u0935\u0948\u0938\u093e \u0939\u0940 \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?"
  ],
