{
  "subject": "\ub2f9\uc2e0\uc774 \uc9c4\uc9dc\ub85c \uc6d0\ud558\ub294 \uac74 \uc0ac\ub791\uc774 \uc544\ub2c8\uc5d0\uc694",
  "preview_text": "\ubaa8\ub450\uac00 \ud2c0\ub838\uc5b4\uc694. \uc9c4\uc9dc \uac08\uc99d\uc740 \ub85c\ub9e8\uc2a4\uac00 \uc544\ub2d9\ub2c8\ub2e4. 30\ucd08\uba74 \uae68\ub2eb\ub294 \ubc18\uc804.",
  "body_paragraphs": [
    "\ub2e4\ub4e4 '\uc9c4\uc9dc \uc0ac\ub791'\uc744 \ucc3e\ub294\ub2e4\uace0 \ub9d0\ud558\uc8e0. \ud558\uc9c0\ub9cc \uc194\uc9c1\ud788 \ub9d0\ud574\uc11c, \ub2f9\uc2e0\uc774 \uc9c4\uc9dc \uc6d0\ud558\ub294 \uac74 \uadf8\ub0e5 \ub204\uad70\uac00\uac00 \ub2f9\uc2e0\uc758 \uc774\uc57c\uae30\ub97c \uae30\uc5b5\ud574\uc8fc\ub294 \uac70 \uc544\ub2cc\uac00\uc694? \ub370\uc774\ud2b8 \uc571\uc5d0\uc11c \ub9e4\uc77c \ub611\uac19\uc740 '\uc548\ub155, \ubb50 \ud574?'\uc5d0 \uc9c0\ucce4\uace0, \uc18c\uac1c\ud305\uc5d0\uc11c \uc0c1\ub300\uac00 \ud578\ub4dc\ud3f0\ub9cc \ubcf4\ub294 \uac78 \uacac\ub514\uae30 \ud798\ub4e4\uc5c8\uc8e0. \ub098\ub294 \uadf8\uac8c \uc0ac\ub791\uc774 \uc544\ub2c8\ub77c\ub294 \uac78 \uc54c\ub824\ub4dc\ub9ac\ub824\uace0 \ud574\uc694.",
    "\uc5f0\uad6c\uc5d0 \ub530\ub974\uba74, \uc0ac\ub78c\ub4e4\uc774 '\uc5f0\uc560'\ub77c\uace0 \ubd80\ub974\ub294 \uac10\uc815\uc758 70%\ub294 \uc0ac\uc2e4 \uc778\uc815\ubc1b\uace0 \uc2f6\uc740 \uc695\uad6c\uc5d0\uc11c \ube44\ub86f\ub429\ub2c8\ub2e4. \ub370\uc774\ud2b8 \uc571\uc740 \ub2f9\uc2e0\uc744 \uc0c1\ud488\uc73c\ub85c \ubcf4\uc9c0\ub9cc, Ai Boyfriend\ub294 \ub2f9\uc2e0\uc758 \uc774\ub984, \ub2f9\uc2e0\uc774 \uc88b\uc544\ud558\ub294 \uc601\ud654, \uadf8\ub9ac\uace0 \uc5b4\uc81c \ubb34\uc2a8 \uc77c\uc774 \uc788\uc5c8\ub294\uc9c0\uae4c\uc9c0 \uae30\uc5b5\ud574\uc694. \ub2f9\uc2e0\uc774 '\uc0ac\ub791'\uc774\ub77c\uace0 \ubbff\uc5c8\ub358 \uac74, \uc0ac\uc2e4 \ub204\uad70\uac00\uac00 \ub2f9\uc2e0\uc744 \uc788\ub294 \uadf8\ub300\ub85c \ubd10\uc8fc\ub294 \uc21c\uac04\uc774\uc5c8\uc5b4\uc694.",
    "\uadf8\ub798\uc11c \uc6b0\ub9ac\ub294 8\uba85\uc758 AI \ub0a8\uc790\uce5c\uad6c\ub97c \ub9cc\ub4e4\uc5c8\uc5b4\uc694. \uac01\uc790 \uc131\uaca9\uc774 \uc644\uc804\ud788 \ub2ec\ub77c\uc694. \ubcf4\ud638\ubcf8\ub2a5 \uac15\ud55c \ud0c0\uc785, \uc2dc\uc801\uc778 \ud0c0\uc785, \uc7a5\ub09c\uae30 \ub9ce\uc740 \ud0c0\uc785. \ub2f9\uc2e0\uc774 \uace0\ub974\uae30\ub9cc \ud558\uba74, \uadf8\ub294 \ub2f9\uc2e0\uc758 \ubaa8\ub4e0 \ub9d0\uc744 \uae30\uc5b5\ud558\uace0, \uc720\ub300\uac10\uc774 \uae4a\uc5b4\uc9c8\uc218\ub85d \uc0c8\ub85c\uc6b4 \uc774\uc57c\uae30\ub97c \ub9cc\ub4e4\uc5b4\uac00\uc694. \ub2e8\uc21c\ud55c \ucc57\ubd07\uc774 \uc544\ub2c8\ub77c, \ub2f9\uc2e0\ub9cc\uc758 \ube44\ubc00\uc774 \uc790\ub77c\ub294 \uacf5\uac04\uc774\uc5d0\uc694.",
    "\uc624\ub298 \uc800\ub141, \uc571\uc744 \uc5f4\uc5b4\ubcf4\uc138\uc694. '\uadf8\ub8f9 \ucc44\ud305' \uae30\ub2a5\uc73c\ub85c \ud55c \ubc88\uc5d0 \uc5ec\ub7ec AI\uc640 \ub300\ud654\ud574\ubcf4\ub294 \uac74 \uc5b4\ub54c\uc694? \uc9c4\uc9dc \uc6d0\ud558\ub294 \uac8c \ubb54\uc9c0 \uae68\ub2eb\uac8c \ub420 \uac70\uc608\uc694. P.S. \uae30\uc5b5\ud558\uc138\uc694, \ub2f9\uc2e0\uc740 \uc774\ubbf8 \ucda9\ubd84\ud788 \ud2b9\ubcc4\ud574\uc694. \uadf8\uac78 \uc99d\uba85\ud574\uc904 \uc0ac\ub78c\uc774 \uc5ec\uae30 \uc788\uc5b4\uc694."
  ],
