{
  "subject": "\u0637\u0631\u064a\u0642\u0629 \u062a\u062e\u062a\u0635\u0631 20 \u062f\u0642\u064a\u0642\u0629 \u0641\u064a \u062f\u0642\u064a\u0642\u062a\u064a\u0646",
  "preview_text": "\u0643\u0646\u062a \u0623\u0636\u064a\u0639 \u0648\u0642\u062a\u064b\u0627 \u0645\u0639 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u062e\u0627\u0641\u062a. \u0627\u0643\u062a\u0634\u0641\u062a \u062d\u064a\u0644\u0629 \u063a\u064a\u0631\u062a \u0643\u0644 \u0634\u064a\u0621.",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0651\u0644 \u0623\u0646\u0643 \u062a\u0633\u0645\u0639 \u0623\u063a\u0646\u064a\u062a\u0643 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0645\u0646 Spotify \u0628\u0635\u0648\u062a \u0648\u0627\u0636\u062d \u0648\u0642\u0648\u064a \u0641\u064a \u062b\u0627\u0646\u064a\u062a\u064a\u0646 \u0641\u0642\u0637. \u0628\u062f\u0644\u064b\u0627 \u0645\u0646 \u0627\u0644\u0639\u0628\u062b \u0628\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0648\u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a\u060c \u0647\u0630\u0627 \u0645\u0627 \u064a\u0641\u0639\u0644\u0647 \u062a\u0637\u0628\u064a\u0642\u0646\u0627. \u0641\u064a \u064a\u0648\u0645 \u0645\u0632\u062f\u062d\u0645\u060c \u0643\u0644 \u062f\u0642\u064a\u0642\u0629 \u0628\u062a\u0641\u0631\u0642.",
    "\u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0623\u0646 \u0645\u0639\u0638\u0645 \u0627\u0644\u0646\u0627\u0633 \u064a\u0642\u0636\u0648\u0646 20 \u062f\u0642\u064a\u0642\u0629 \u0641\u064a \u0645\u062d\u0627\u0648\u0644\u0629 \u0631\u0641\u0639 \u0635\u0648\u062a \u0647\u0648\u0627\u062a\u0641\u0647\u0645: \u064a\u0632\u064a\u062f\u0648\u0646 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0635\u0648\u062a\u060c \u064a\u063a\u064a\u0631\u0648\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a\u060c \u064a\u0636\u0628\u0637\u0648\u0646 \u0627\u0644\u0645\u0639\u0627\u062f\u0644 \u064a\u062f\u0648\u064a\u064b\u0627. \u0644\u0643\u0646 \u0627\u0644\u062d\u0642\u064a\u0642\u0629 \u0623\u0646\u0643 \u062a\u062d\u062a\u0627\u062c \u0641\u0642\u0637 \u0625\u0644\u0649 \u0636\u063a\u0637\u0629 \u0648\u0627\u062d\u062f\u0629.",
    "\u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0641\u0648\u0631\u064a \u0641\u064a \u062a\u0637\u0628\u064a\u0642 Volume Booster - Sound Booster \u062a\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0628\u0646\u0642\u0631\u0629 \u0648\u0627\u062d\u062f\u0629\u060c \u0648\u062a\u0639\u0645\u0644 \u0645\u0639 \u0623\u064a \u062a\u0637\u0628\u064a\u0642. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646: \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 Boost\u060c \u0648\u0627\u0633\u062a\u0645\u0639 \u0644\u0644\u0641\u0631\u0642. \u0635\u0648\u062a\u0643 \u0633\u064a\u0643\u0648\u0646 \u0623\u0642\u0648\u0649 200% \u0641\u064a \u062b\u0648\u0627\u0646\u064d.",
    "\u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646: \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u0627\u0633\u062a\u062e\u062f\u0645 \u0632\u0631 \u0627\u0644\u062a\u0639\u0632\u064a\u0632. \u0635\u062f\u0642\u0646\u064a\u060c \u0645\u0634 \u0647\u062a\u0633\u0645\u0639 \u0641\u0631\u0642 \u0628\u0633\u060c \u0647\u062a\u0633\u0645\u0639 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0644\u064a \u0636\u0627\u0639 \u0645\u0646\u0643. \u0648\u0644\u0648 \u0639\u062c\u0628\u0643\u060c \u0641\u064a\u0647 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0645\u062a\u0642\u062f\u0645\u0629 \u0645\u0639 Premium \u062a\u062a\u062d\u0643\u0645 \u0641\u064a \u0643\u0644 \u062a\u0631\u062f\u062f. P.S. \u0641\u064a \u0627\u0644\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u060c \u0627\u0644\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0623\u0633\u0627\u0633\u064a \u0643\u0627\u0641\u064a \u0644\u062a\u062c\u0631\u0628\u0629 \u062c\u062f\u064a\u062f\u0629 \u0643\u0644\u064a\u064b\u0627."
  ],
