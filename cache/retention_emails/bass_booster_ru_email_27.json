{
  "subject": "10 000 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0438 1 \u0441\u0442\u0440\u0430\u043d\u043d\u0430\u044f \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c",
  "preview_text": "\u041c\u044b \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b\u0438 \u0434\u0430\u043d\u043d\u044b\u0435 \u0437\u0430 63 \u0434\u043d\u044f \u0438 \u043d\u0430\u0448\u043b\u0438 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0439 \u0442\u0440\u0435\u043d\u0434. \u0422\u044b \u0443\u0434\u0438\u0432\u0438\u0448\u044c\u0441\u044f, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u044e\u0442 90% \u0441\u043b\u0443\u0448\u0430\u0442\u0435\u043b\u0435\u0439 \u0432 2:30 \u043d\u043e\u0447\u0438.",
  "body_paragraphs": [
    "\u0412 2:30 \u043d\u043e\u0447\u0438 \u043f\u043e\u0447\u0442\u0438 \u043a\u0430\u0436\u0434\u044b\u0439 \u0432\u0442\u043e\u0440\u043e\u0439 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c Bass Booster \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0442\u0440\u0435\u043a \u0441 \u043c\u043e\u0449\u043d\u044b\u043c \u0431\u0430\u0441\u043e\u043c. \u041c\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u043b\u0438 \u0434\u0430\u043d\u043d\u044b\u0435 10 000 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u2013 \u0438 \u0432\u043e\u0442 \u0447\u0442\u043e \u0448\u043e\u043a\u0438\u0440\u0443\u0435\u0442: \u0442\u0435, \u043a\u0442\u043e \u0441\u043b\u0443\u0448\u0430\u0435\u0442 \u043c\u0443\u0437\u044b\u043a\u0443 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u0443\u043d\u043e\u0447\u0438, \u0432 \u0441\u0440\u0435\u0434\u043d\u0435\u043c \u043d\u0430 40% \u0447\u0430\u0449\u0435 \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u044e\u0442 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0434\u043e \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u0430. \u041d\u043e \u0435\u0441\u0442\u044c \u043d\u044e\u0430\u043d\u0441: 70% \u0438\u0437 \u043d\u0438\u0445 \u0434\u0430\u0436\u0435 \u043d\u0435 \u0434\u043e\u0433\u0430\u0434\u044b\u0432\u0430\u044e\u0442\u0441\u044f, \u0447\u0442\u043e \u0438\u0445 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u0437\u0432\u0443\u0447\u0430\u0442\u044c \u0432 \u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u043c\u043e\u0449\u043d\u0435\u0435.",
    "\u0422\u044b, \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u0442\u043e\u0436\u0435 \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0448\u044c. \u0412\u043a\u043b\u044e\u0447\u0430\u0435\u0448\u044c \u0442\u0440\u0435\u043a, \u0436\u043c\u0451\u0448\u044c \u043d\u0430 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0434\u043e \u0443\u043f\u043e\u0440\u0430 \u2013 \u0438 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u0437\u0432\u0443\u043a \u043f\u043b\u043e\u0441\u043a\u0438\u0439, \u043a\u0430\u043a \u043b\u0438\u0441\u0442 \u0431\u0443\u043c\u0430\u0433\u0438. \u042d\u0442\u043e \u043d\u0435 \u0442\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0441\u043b\u043e\u043c\u0430\u043b\u0441\u044f. \u041f\u0440\u043e\u0441\u0442\u043e \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0440\u0435\u0436\u0443\u0442 \u0431\u0430\u0441\u044b, \u0447\u0442\u043e\u0431\u044b \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438 \u043d\u0435 \u0445\u0440\u0438\u043f\u0435\u043b\u0438. \u041d\u043e \u043c\u044b \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b\u0438, \u043a\u0430\u043a \u044d\u0442\u043e \u043e\u0431\u043e\u0439\u0442\u0438.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Bass Booster \u0438 \u043f\u0440\u043e\u0432\u0435\u0434\u0438 \u043f\u0430\u043b\u044c\u0446\u0435\u043c \u043f\u043e \u043f\u043e\u043b\u0437\u0443\u043d\u043a\u0443 Boost \u0432\u043f\u0440\u0430\u0432\u043e. \u0412\u0441\u0435\u0433\u043e \u043e\u0434\u043d\u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u2013 \u0438 \u0442\u0432\u043e\u0439 \u0442\u0440\u0435\u043a \u0437\u0430\u0437\u0432\u0443\u0447\u0438\u0442 \u0442\u0430\u043a, \u0431\u0443\u0434\u0442\u043e \u0443 \u0442\u0435\u0431\u044f \u0432 \u043a\u0430\u0440\u043c\u0430\u043d\u0435 \u0441\u0430\u0431\u0432\u0443\u0444\u0435\u0440. \u0414\u0430\u0436\u0435 \u043d\u0430 \u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u0445 \u0442\u044b \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044c \u0432\u0438\u0431\u0440\u0430\u0446\u0438\u044e \u0432 \u0433\u0440\u0443\u0434\u0438. \u0411\u0435\u0437 Premium \u0442\u044b \u043c\u043e\u0436\u0435\u0448\u044c \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u0442\u044c \u044d\u0442\u043e 5 \u0440\u0430\u0437 \u2013 \u0445\u0432\u0430\u0442\u0438\u0442, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043d\u044f\u0442\u044c \u0440\u0430\u0437\u043d\u0438\u0446\u0443.",
    "\u0421\u0434\u0435\u043b\u0430\u0439 \u044d\u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0432\u044b\u0431\u0435\u0440\u0438 \u043b\u044e\u0431\u043e\u0439 \u0442\u0440\u0435\u043a \u0441 \u0431\u0430\u0441\u043e\u043c \u0438 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0443\u0439 Boost. \u0410 \u0435\u0441\u043b\u0438 \u0437\u0430\u0445\u043e\u0447\u0435\u0448\u044c \u0431\u0435\u0437 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0439 \u2013 Premium \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0439 \u0431\u0443\u0441\u0442 \u0438 \u043f\u043e\u043b\u043d\u044b\u0439 10-\u043f\u043e\u043b\u043e\u0441\u043d\u044b\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440. P.S. \u0422\u0435, \u043a\u0442\u043e \u0441\u043b\u0443\u0448\u0430\u0435\u0442 \u0432 2:30 \u043d\u043e\u0447\u0438, \u043e\u0431\u044b\u0447\u043d\u043e \u0432\u044b\u0431\u0438\u0440\u0430\u044e\u0442 \u0440\u0435\u0436\u0438\u043c 'Music' \u2013 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439, \u043e\u043d \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u0437\u0430\u0442\u043e\u0447\u0435\u043d \u043f\u043e\u0434 \u043c\u043e\u0449\u043d\u044b\u0439 \u0431\u0430\u0441."
