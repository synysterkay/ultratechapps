{
  "subject": "\u0639\u064a\u062f \u0627\u0644\u0623\u0636\u062d\u0649 \u0648\u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0647\u062f\u064a\u062a\u0643",
  "preview_text": "\u0644\u062d\u0638\u0627\u062a \u0627\u0644\u0639\u064a\u062f \u062a\u062d\u062a\u0627\u062c \u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u062a\u0647\u0632 \u0627\u0644\u0642\u0644\u0628. \u062c\u0631\u0628 \u0645\u064a\u0632\u0629 Bass Virtualizer \u0627\u0644\u0622\u0646.",
  "body_paragraphs": [
    "\u0627\u0644\u0639\u064a\u062f \u0642\u0631\u0628\u060c \u0648\u0643\u0644 \u0644\u062d\u0638\u0629 \u0641\u064a\u0647 \u062a\u0633\u062a\u062d\u0642 \u0623\u0646 \u062a\u0639\u064a\u0634\u0647\u0627 \u0628\u0642\u0648\u0629. \u062a\u062e\u064a\u0644 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0641\u064a \u0633\u064a\u0627\u0631\u062a\u0643 \u0623\u0648 \u0641\u064a \u0627\u0644\u0628\u064a\u062a\u060c \u0644\u0643\u0646 \u0639\u0628\u0631 \u0633\u0645\u0627\u0639\u0627\u062a \u0623\u0630\u0646\u0643 \u0623\u0648 \u0633\u0645\u0627\u0639\u0629 \u0647\u0627\u062a\u0641\u0643. \u062a\u0633\u0645\u0639 \u0643\u0644 \u0646\u0628\u0636\u0629\u060c \u0643\u0644 \u0625\u064a\u0642\u0627\u0639\u060c \u0648\u0643\u0623\u0646\u0647 \u064a\u062d\u062f\u062b \u0628\u062f\u0627\u062e\u0644\u0643. \u0644\u0643\u0646 \u0627\u0644\u062d\u0642\u064a\u0642\u0629\u061f \u0645\u0639\u0638\u0645\u0646\u0627 \u064a\u0645\u0631 \u0628\u062a\u062c\u0631\u0628\u0629 \u0645\u0633\u0637\u062d\u0629\u060c \u0635\u0648\u062a \u0628\u0644\u0627 \u0631\u0648\u062d\u060c \u0648\u0643\u0623\u0646 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0645\u0627\u062a\u062a.",
    "\u0647\u0630\u0627 \u0627\u0644\u0639\u064a\u062f\u060c \u0644\u0627 \u062a\u062a\u0631\u0643 \u0644\u062d\u0638\u0627\u062a\u0643 \u062a\u0645\u0631 \u0647\u0643\u0630\u0627. \u0623\u0646\u062a \u062a\u0633\u062a\u062d\u0642 \u0623\u0646 \u062a\u0634\u0639\u0631 \u0628\u0643\u0644 \u0627\u0646\u0641\u0639\u0627\u0644 \u0641\u064a \u0627\u0644\u0623\u063a\u0646\u064a\u0629\u060c \u0645\u0646 \u0623\u0639\u0645\u0642 \u0627\u0644\u0628\u0627\u0635 \u0625\u0644\u0649 \u0623\u0639\u0644\u0649 \u0627\u0644\u0646\u0648\u062a\u0627\u062a. \u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u062a\u0633\u0645\u0639 \u0623\u063a\u0646\u064a\u0629 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0644\u062f\u064a\u0643\u060c \u0648\u0641\u062c\u0623\u0629 \u062a\u0634\u0639\u0631 \u0628\u0627\u0644\u0635\u062f\u0645\u0629 \u0641\u064a \u0635\u062f\u0631\u0643 \u0639\u0646\u062f\u0645\u0627 \u064a\u0636\u0631\u0628 \u0627\u0644\u0640 drop. \u0647\u0630\u0627 \u0644\u064a\u0633 \u062e\u064a\u0627\u0644\u0627\u064b\u060c \u0628\u0644 \u0647\u0648 \u0648\u0627\u0642\u0639 \u0645\u0639 Bass Booster.",
    "\u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u064a \u0623\u062d\u062f\u062b\u062a \u0641\u0631\u0642\u0627\u064b \u0645\u0639 \u0623\u0643\u062b\u0631 \u0645\u0646 100,000 \u0645\u0633\u062a\u062e\u062f\u0645 \u0647\u064a Bass Virtualizer. \u0627\u0636\u063a\u0637 \u0639\u0644\u064a\u0647\u0627 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629\u060c \u0648\u0627\u0633\u062d\u0628 \u0627\u0644\u0645\u0624\u0634\u0631\u060c \u0648\u0633\u062a\u0634\u0639\u0631 \u0648\u0643\u0623\u0646\u0643 \u0641\u064a \u062d\u0641\u0644\u0629 \u0645\u0648\u0633\u064a\u0642\u064a\u0629 \u062d\u0642\u064a\u0642\u064a\u0629. \u062d\u062a\u0649 \u0639\u0644\u0649 \u0633\u0645\u0627\u0639\u0627\u062a \u0623\u0630\u0646\u0643 \u0627\u0644\u0639\u0627\u062f\u064a\u0629\u060c \u0633\u062a\u0647\u062a\u0632 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0641\u064a \u062f\u0627\u062e\u0644\u0643. \u0644\u0627 \u062a\u062d\u062a\u0627\u062c \u0644\u0634\u064a\u0621 \u0622\u062e\u0631\u060c \u0641\u0642\u0637 \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646.",
    "\u0627\u0641\u062a\u062d Bass Booster \u0627\u0644\u0622\u0646\u060c \u0648\u0627\u062e\u062a\u0631 'Bass Virtualizer'\u060c \u0648\u0627\u0633\u062d\u0628 \u0627\u0644\u0645\u0624\u0634\u0631 \u0644\u0644\u0623\u0639\u0644\u0649. \u0627\u0644\u0639\u064a\u062f \u0644\u0646 \u064a\u0646\u062a\u0638\u0631\u060c \u0648\u0644\u0627 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649. P.S. \u062c\u0631\u0628\u0647\u0627 \u0645\u0639 \u0623\u063a\u0646\u064a\u0629 'HUMBLE.' \u0644\u0640 Kendrick Lamar \u0623\u0648 'Starboy' \u0644\u0640 The Weeknd \u2013 \u0633\u062a\u0641\u0647\u0645 \u0627\u0644\u0641\u0631\u0642."
