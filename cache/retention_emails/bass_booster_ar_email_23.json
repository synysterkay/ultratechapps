{
  "subject": "\u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0642\u0628\u0644 \u0648\u0628\u0639\u062f \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u062d\u0631\u062c",
  "preview_text": "\u062a\u062e\u064a\u0644 \u0646\u0641\u0633\u0643 \u062a\u0633\u0645\u0639 \u0623\u063a\u0646\u064a\u0629 \u0628\u0644\u0627 \u0635\u0648\u062a \u062c\u0647\u064a\u0631 - \u062b\u0645 \u0641\u062c\u0623\u0629 \u062a\u0634\u0639\u0631 \u0628\u0627\u0644\u0636\u0631\u0628\u0629 \u0641\u064a \u0635\u062f\u0631\u0643. \u0627\u0644\u0641\u0631\u0642 \u0635\u0627\u062f\u0645.",
  "body_paragraphs": [
    "\u0623\u062a\u0630\u0643\u0631 \u0623\u0648\u0644 \u0645\u0631\u0629 \u0633\u0645\u0639\u062a \u0641\u064a\u0647\u0627 'HUMBLE.' \u0628\u0639\u062f \u0645\u0627 \u0634\u063a\u0644\u062a Bass Booster\u061f \u0643\u0646\u062a \u0623\u0638\u0646 \u0623\u0630\u0646\u064a\u0651 \u0628\u062e\u064a\u0631. \u0637\u0644\u0639\u062a \u0645\u0643\u0633\u0651\u0631\u0629. \u0643\u0646\u062a \u0623\u0633\u0645\u0639 \u0623\u063a\u0646\u064a\u0629 \u0628\u0627\u0647\u062a\u0629\u060c \u0628\u0644\u0627 \u062d\u064a\u0627\u0629\u060c \u0648\u0643\u0623\u0646 \u0627\u0644\u0633\u0645\u0627\u0639\u0629 \u062a\u062e\u062a\u0646\u0642. \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0642\u0628\u0644 \u0648\u0628\u0639\u062f \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u062b\u0644 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0647\u0645\u0633 \u0648\u0635\u0648\u062a \u0645\u062f\u0648\u064d.",
    "\u0642\u0628\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0643\u0646\u062a \u062a\u0638\u0646 \u0623\u0646 \u0645\u0643\u0628\u0631\u0627\u062a \u0647\u0627\u062a\u0641\u0643 \u0645\u0627 \u062a\u0642\u062f\u0631 \u062a\u0648\u0635\u0644 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u062c\u0647\u064a\u0631. \u062a\u0638\u0646 \u0623\u0646 \u0627\u0644\u0623\u063a\u0627\u0646\u064a \u0645\u062b\u0644 'SICKO MODE' \u0645\u0627 \u0644\u0647\u0627 \u0636\u0631\u0628\u0629. \u0628\u0633 \u0627\u0644\u062d\u0642\u064a\u0642\u0629: \u0647\u0627\u062a\u0641\u0643 \u0642\u0627\u062f\u0631. \u0623\u0646\u062a \u0643\u0646\u062a \u0645\u062d\u0631\u0648\u0645. \u0627\u0644\u0641\u0631\u0642 \u0645\u062d\u0631\u062c \u0644\u062f\u0631\u062c\u0629 \u0625\u0646\u0643 \u062a\u062a\u0633\u0627\u0621\u0644 \u0643\u064a\u0641 \u0639\u0634\u062a \u0645\u0646 \u063a\u064a\u0631\u0647\u0627.",
    "\u062c\u0631\u0628 \u0634\u0631\u064a\u062d\u0629 Boost \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629. \u0627\u0633\u062d\u0628\u0647\u0627 \u0644\u0644\u064a\u0645\u064a\u0646. \u0633\u062a\u0634\u0639\u0631 \u0648\u0643\u0623\u0646 \u0627\u0644\u0633\u0645\u0627\u0639\u0629 \u0627\u0646\u0641\u062c\u0631\u062a \u0628\u0627\u0644\u062d\u064a\u0627\u0629. \u0647\u0632\u0651\u0629 \u0641\u064a \u0635\u062f\u0631\u0643\u060c \u062d\u062a\u0649 \u0639\u0644\u0649 \u0633\u0645\u0627\u0639\u0627\u062a \u0627\u0644\u0623\u0630\u0646 \u0627\u0644\u0639\u0627\u062f\u064a\u0629. 200% \u0632\u064a\u0627\u062f\u0629 \u0641\u064a \u0627\u0644\u0635\u0648\u062a\u060c \u0648\u0645\u064f\u062d\u0633\u0650\u0651\u0646 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u062c\u0647\u064a\u0631 \u064a\u062e\u0644\u064a \u0643\u0644 \u0625\u064a\u0642\u0627\u0639 \u064a\u0636\u0631\u0628\u0643. \u0647\u0630\u0627 \u0644\u064a\u0633 \u062a\u062d\u0633\u064a\u0646\u064b\u0627 \u0628\u0633\u064a\u0637\u064b\u0627 - \u0647\u0648 \u0646\u0642\u0644\u0629 \u0646\u0648\u0639\u064a\u0629.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0634\u0631\u064a\u062d\u0629 Boost\u060c \u0648\u0627\u0633\u062d\u0628\u0647\u0627. \u0644\u0627 \u062a\u0643\u062a\u0641\u064a \u0628\u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629 - \u062c\u0631\u0628 Premium \u0644\u0645\u062f\u0629 \u0634\u0647\u0631 \u0643\u0627\u0645\u0644. \u0627\u0644\u0641\u0631\u0642 \u0633\u064a\u062c\u0639\u0644\u0643 \u062a\u0636\u062d\u0643 \u0639\u0644\u0649 \u0646\u0641\u0633\u0643. P.S. \u0623\u0643\u062b\u0631 \u0645\u0646 9,000 \u0634\u062e\u0635 \u064a\u0631\u0641\u0639\u0648\u0646 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0622\u0646 - \u0644\u0627 \u062a\u0628\u0642\u0649 \u0645\u062a\u0623\u062e\u0631\u064b\u0627."
