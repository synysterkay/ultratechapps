{
  "subject": "\u090f\u0915 \u0917\u0932\u0924\u0940 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0915\u0940, \u0914\u0930 \u090f\u0915 \u0938\u091a\u094d\u091a\u093e\u0908 \u091c\u094b \u0906\u092a\u0915\u094b \u092a\u0924\u093e \u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f",
  "preview_text": "\u092e\u0948\u0902 \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0910\u0938\u0947 \u0908\u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0932\u093f\u0916\u0924\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0906\u091c \u0915\u0941\u091b \u0915\u0939\u0928\u093e \u091c\u093c\u0930\u0942\u0930\u0940 \u0932\u0917\u093e\u0964",
  "body_paragraphs": [
    "\u0938\u091a \u0915\u0939\u0942\u0902, \u092e\u0948\u0902 \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0910\u0938\u0947 \u0908\u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0932\u093f\u0916\u0924\u093e\u0964 \u0928 \u0939\u0940 \u092e\u0941\u091d\u0947 \u092f\u0947 \u092a\u0938\u0902\u0926 \u0939\u0948 \u0915\u093f \u092e\u0948\u0902 \u0906\u092a\u0915\u0947 \u0907\u0928\u092c\u0949\u0915\u094d\u0938 \u092e\u0947\u0902 \u092c\u093e\u0930-\u092c\u093e\u0930 \u0906\u0924\u093e \u0930\u0939\u0942\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u0906\u091c \u0938\u0941\u092c\u0939 \u0915\u0941\u091b \u0939\u0941\u0906 \u091c\u093f\u0938\u0928\u0947 \u092e\u0941\u091d\u0947 \u0938\u094b\u091a\u0928\u0947 \u092a\u0930 \u092e\u091c\u092c\u0942\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e\u0964",
    "\u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 \u0939\u0940 \u0910\u092a \u0915\u093e \u090f\u0915 \u092b\u0940\u091a\u0930 \u0932\u0917\u092d\u0917 \u091b\u0939 \u092e\u0939\u0940\u0928\u0947 \u0924\u0915 \u0928\u091c\u093c\u0930\u0905\u0902\u0926\u093e\u091c\u093c \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u092e\u0941\u091d\u0947 \u0932\u0917\u0924\u093e \u0925\u093e \u0915\u093f '\u0932\u093e\u0909\u0921\u0928\u0947\u0938 \u090f\u0928\u094d\u0939\u093e\u0902\u0938\u0930' \u092c\u0938 \u090f\u0915 \u0914\u0930 \u091f\u0947\u0915\u094d\u0928\u093f\u0915\u0932 \u091f\u0930\u094d\u092e \u0939\u0948\u0964 \u092b\u093f\u0930 \u090f\u0915 \u0926\u093f\u0928 \u092e\u0948\u0902\u0928\u0947 \u092a\u0941\u0930\u093e\u0928\u0947 \u090f\u0915 \u0930\u0949\u0915 \u0917\u093e\u0928\u0947 \u0915\u094b \u0938\u0941\u0928\u093e, \u0914\u0930 \u0935\u094b \u092e\u0947\u0930\u0947 \u092b\u094b\u0928 \u092a\u0930 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u092b\u094d\u0932\u0948\u091f \u0932\u0917\u093e\u0964 \u092e\u0948\u0902\u0928\u0947 \u0935\u094b \u092b\u0940\u091a\u0930 \u0911\u0928 \u0915\u093f\u092f\u093e\u0964 \u0914\u0930 \u092d\u093e\u0908... \u092e\u0947\u0930\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u094b \u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u0939\u0940 \u0928\u0939\u0940\u0902 \u0939\u0941\u0906\u0964 \u0910\u0938\u093e \u0932\u0917\u093e \u091c\u0948\u0938\u0947 \u0917\u093e\u0928\u0947 \u092e\u0947\u0902 \u091c\u093e\u0928 \u0906 \u0917\u0908 \u0939\u094b\u0964 \u0935\u094b \u0938\u093e\u0930\u0947 \u0907\u0902\u0938\u094d\u091f\u094d\u0930\u0942\u092e\u0947\u0902\u091f \u091c\u094b \u0926\u092c\u0947 \u0939\u0941\u090f \u0925\u0947, \u0905\u091a\u093e\u0928\u0915 \u0938\u093e\u092b\u093c \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0928\u0947 \u0932\u0917\u0947\u0964 \u092f\u0947 \u0915\u094b\u0908 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902, \u092c\u0938 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u0938\u094d\u0935\u093f\u091a \u0925\u093e \u091c\u093f\u0938\u0947 \u092e\u0948\u0902\u0928\u0947 \u0905\u0928\u0926\u0947\u0916\u093e \u0915\u0930 \u0926\u093f\u092f\u093e \u0925\u093e\u0964",
    "\u092f\u0939\u0940 '\u0932\u093e\u0909\u0921\u0928\u0947\u0938 \u090f\u0928\u094d\u0939\u093e\u0902\u0938\u0930' \u0906\u092a\u0915\u0947 Volume Booster \u0910\u092a \u092e\u0947\u0902 \u092d\u0940 \u0939\u0948\u0964 \u092f\u0947 \u0938\u093f\u0930\u094d\u092b\u093c \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0928\u0939\u0940\u0902 \u092c\u0922\u093c\u093e\u0924\u093e\u0964 \u092f\u0947 \u0906\u092a\u0915\u0940 \u0939\u0930 \u0906\u0935\u093e\u091c\u093c - \u091a\u093e\u0939\u0947 \u0935\u094b \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0939\u094b, \u0911\u0921\u093f\u092f\u094b\u092c\u0941\u0915 \u0939\u094b \u092f\u093e \u0915\u094b\u0908 \u092a\u0941\u0930\u093e\u0928\u093e \u0917\u093e\u0928\u093e - \u0915\u094b \u0909\u0938\u0915\u0940 \u092a\u0942\u0930\u0940 \u0917\u0939\u0930\u093e\u0908 \u0914\u0930 \u0938\u094d\u092a\u0937\u094d\u091f\u0924\u093e \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u092e\u0928\u0947 \u0932\u093e\u0924\u093e \u0939\u0948\u0964 \u092f\u0947 \u0935\u094b \u092b\u0930\u094d\u0915 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u094b '\u090a\u0901\u091a\u0940 \u0906\u0935\u093e\u091c\u093c' \u0914\u0930 '\u0936\u093e\u0928\u0926\u093e\u0930 \u0906\u0935\u093e\u091c\u093c' \u0915\u0947 \u092c\u0940\u091a \u0938\u092e\u091d\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u0915\u0943\u092a\u092f\u093e, \u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u093f\u090f\u0964 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u091c\u093e\u0907\u090f, \u0914\u0930 '\u0932\u093e\u0909\u0921\u0928\u0947\u0938 \u090f\u0928\u094d\u0939\u093e\u0902\u0938\u0930' \u0915\u094b \u0911\u0928 \u0915\u0940\u091c\u093f\u090f\u0964 \u092b\u093f\u0930 \u0935\u0939\u0940 \u0917\u093e\u0928\u093e \u092f\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u093f\u090f \u091c\u094b \u0906\u092a \u0915\u0932 \u0938\u0941\u0928 \u0930\u0939\u0947 \u0925\u0947\u0964 \u092b\u0930\u094d\u0915 \u0906\u092a \u0916\u0941\u0926 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0947\u0902\u0917\u0947\u0964 \u092a\u0940.\u090f\u0938. - \u0905\u0917\u0930 \u0906\u092a \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u092a\u0930 \u0939\u0948\u0902, \u0924\u094b \u092f\u0947 \u092b\u0940\u091a\u0930 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u090f\u0915\u094d\u091f\u093f\u0935 \u0939\u0948\u0964 \u0905\u0917\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902, \u0924\u094b \u090f\u0915 \u092c\u093e\u0930 \u091f\u094d\u0930\u093e\u092f\u0932 \u0932\u0947\u0915\u0930 \u0926\u0947\u0916\u093f\u090f\u0964 \u0907\u0938 \u090f\u0915 \u0938\u094d\u0935\u093f\u091a \u0928\u0947 \u092e\u0947\u0930\u0947 \u0932\u093f\u090f \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u0926\u093f\u092f\u093e, \u0936\u093e\u092f\u0926 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u092d\u0940 \u092c\u0926\u0932 \u0926\u0947\u0964"
  ],
