{
  "subject": "\u0935\u094b \u0936\u0916\u094d\u0938 \u091c\u093f\u0938\u0947 \u092c\u093e\u0938 \u091a\u093e\u0939\u093f\u090f",
  "preview_text": "\u0924\u0941\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u094b \u0915\u093f\u0938\u0915\u0940 \u092c\u093e\u0924 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948\u0964 \u0909\u0938\u0947 \u092f\u0947 \u0910\u092a \u0926\u094b \u0914\u0930 \u0926\u0947\u0916\u094b \u091a\u0947\u0939\u0930\u0947 \u092a\u0930 \u092e\u0941\u0938\u094d\u0915\u093e\u0928\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u094b \u0926\u094b\u0938\u094d\u0924 \u091c\u094b \u0939\u0930 \u092c\u093e\u0930 '\u092c\u093e\u0938 \u0915\u0939\u093e\u0901 \u0939\u0948?' \u0915\u0939\u0924\u093e \u0939\u0948? \u092f\u093e \u0935\u094b \u092d\u093e\u0908-\u092c\u0939\u0928 \u091c\u093f\u0928\u0915\u0947 \u0908\u092f\u0930\u092b\u094b\u0928 \u0938\u0947 \u0938\u093f\u0930\u094d\u092b \u092a\u0924\u0932\u0940 \u0906\u0935\u093e\u091c\u093c \u0906\u0924\u0940 \u0939\u0948? \u0924\u0941\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u094b \u092e\u0948\u0902 \u0915\u093f\u0938\u0915\u0940 \u092c\u093e\u0924 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0901\u0964 \u0909\u0928\u0915\u0947 \u0932\u093f\u090f \u092f\u0947 \u0910\u092a \u090f\u0915 \u0924\u094b\u0939\u092b\u093c\u093e \u0939\u0948\u0964",
    "\u091c\u092c \u0924\u0941\u092e \u0909\u0928\u094d\u0939\u0947\u0902 Bass Booster \u0926\u094b\u0917\u0947, \u0924\u094b \u0935\u094b \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0938\u0941\u0928\u0947\u0902\u0917\u0947 \u0915\u093f \u0909\u0928\u0915\u0947 \u092b\u094b\u0928 \u0938\u0947 \u0905\u0938\u0932\u0940 \u092c\u093e\u0938 \u0915\u0948\u0938\u0947 \u0928\u093f\u0915\u0932\u0924\u093e \u0939\u0948\u0964 \u0935\u094b \u0921\u094d\u0930\u0949\u092a \u0909\u0928\u0915\u0947 \u0938\u0940\u0928\u0947 \u092e\u0947\u0902 \u0917\u0942\u0902\u091c\u0947\u0917\u093e, \u0938\u093f\u0930\u094d\u092b \u0915\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902\u0964 \u092f\u0947 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902, \u092f\u0947 \u0909\u0928\u0915\u093e \u0938\u0902\u0917\u0940\u0924 \u0915\u093e \u0928\u092f\u093e \u0905\u0928\u0941\u092d\u0935 \u0939\u0948\u0964",
    "\u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u092e\u0947\u0902 Bass Booster \u0915\u093e Boost slider \u0916\u094b\u0932\u094b, \u0914\u0930 \u0909\u0928\u094d\u0939\u0947\u0902 \u0926\u093f\u0916\u093e\u0913 \u0915\u093f \u0909\u0928\u0915\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u093e \u0915\u0948\u0938\u0947 \u0917\u0942\u0902\u091c\u0924\u093e \u0939\u0948\u0964 10-\u092c\u0948\u0902\u0921 EQ \u0938\u0947 \u0909\u0928\u094d\u0939\u0947\u0902 \u0905\u092a\u0928\u0940 \u0927\u0941\u0928 \u0938\u0947\u091f \u0915\u0930\u0928\u0947 \u0926\u094b\u0964 \u0935\u094b \u0939\u0948\u0930\u093e\u0928 \u0930\u0939 \u091c\u093e\u090f\u0901\u0917\u0947\u0964",
    "\u0905\u092c \u0909\u0928\u094d\u0939\u0947\u0902 \u092f\u0947 \u0910\u092a \u0936\u0947\u092f\u0930 \u0915\u0930\u094b\u0964 \u092c\u091f\u0928 \u0926\u092c\u093e\u0913 \u0914\u0930 \u0926\u0947\u0916\u094b \u0909\u0928\u0915\u0940 \u0916\u093c\u0941\u0936\u0940\u0964 \n\nP.S. \u0905\u0917\u0930 \u0935\u094b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902, \u0924\u094b \u0909\u0928\u094d\u0939\u0947\u0902 \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u092e\u093f\u0932\u0947\u0917\u093e\u2014\u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092d\u0940 \u090f\u0915 \u090f\u0915\u094d\u0938\u094d\u091f\u094d\u0930\u093e \u092b\u093c\u0940\u091a\u0930\u0964 \u0926\u094b\u0928\u094b\u0902 \u091c\u0940\u0924\u0947\u0902\u0917\u0947\u0964"
  ],
