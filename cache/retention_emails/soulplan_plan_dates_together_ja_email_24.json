    "\u3053\u308c\u304c\u3001\u79c1\u305f\u3061\u304c\u300c\u4eca\u591c\u306e\u30c7\u30fc\u30c8\u300d\u6a5f\u80fd\u306b\u8fbc\u3081\u305f\u672c\u5f53\u306e\u4fa1\u5024\u3067\u3059\u3002\u305f\u3060\u306e\u63d0\u6848\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u76f8\u624b\u306b\u300c\u4eca\u65e5\u3001\u3042\u306a\u305f\u306e\u3053\u3068\u3092\u8003\u3048\u305f\u3088\u300d\u3068\u4f1d\u3048\u308b\u300130\u79d2\u306e\u30b8\u30a7\u30b9\u30c1\u30e3\u30fc\u3002\u3042\u306a\u305f\u3082\u307e\u3060\u8a66\u3057\u305f\u3053\u3068\u304c\u306a\u3051\u308c\u3070\u3001\u305c\u3072\u4e00\u5ea6\u3001\u30e0\u30fc\u30c9\u3092\u9078\u3093\u3067\u9001\u3063\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002",
