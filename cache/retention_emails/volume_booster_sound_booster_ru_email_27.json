{
  "subject": "\u0421\u0435\u043a\u0440\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0442 90% \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u043d\u0430\u0448\u0435\u0433\u043e \u0431\u0443\u0441\u0442\u0435\u0440\u0430",
  "preview_text": "\u041c\u044b \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b\u0438 10 000 \u0441\u0435\u0441\u0441\u0438\u0439 \u0438 \u043d\u0430\u0448\u043b\u0438 \u043e\u0434\u043d\u0443 \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043e\u0448\u0438\u0431\u043a\u0443. \u042d\u0442\u043e \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0430 \u0432\u0435\u0441\u044c \u0437\u0432\u0443\u043a.",
  "body_paragraphs": [
    "\u041f\u0440\u0438\u0432\u0435\u0442. \u0423 \u043c\u0435\u043d\u044f \u0434\u043b\u044f \u0442\u0435\u0431\u044f \u0446\u0438\u0444\u0440\u0430, \u043e\u0442 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0443 \u043c\u0435\u043d\u044f \u0441\u0430\u043c\u043e\u0433\u043e \u0432\u043e\u043b\u043e\u0441\u044b \u0432\u0441\u0442\u0430\u043b\u0438 \u0434\u044b\u0431\u043e\u043c. \u041c\u044b \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0442\u043e \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b\u0438 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u044b\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u2014 10 000 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0445 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439, \u0438\u0445 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438, \u0438\u0445 \u0441\u0435\u0441\u0441\u0438\u0438. \u0418 \u043d\u0430\u0448\u043b\u0438 \u043a\u043e\u0435-\u0447\u0442\u043e, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u044e\u0442 \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u0435. \u0418 \u044d\u0442\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u0430\u044f \u043e\u0448\u0438\u0431\u043a\u0430.",
    "\u041e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c, 87% \u043b\u044e\u0434\u0435\u0439 \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442 \u0431\u0443\u0441\u0442\u0435\u0440 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438, \u043d\u043e \u041d\u0415 \u0442\u0440\u043e\u0433\u0430\u044e\u0442 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440. \u041e\u043d\u0438 \u0441\u043b\u0443\u0448\u0430\u044e\u0442 \u043c\u0443\u0437\u044b\u043a\u0443, \u043f\u043e\u0434\u043a\u0430\u0441\u0442\u044b, \u0441\u043c\u043e\u0442\u0440\u044f\u0442 \u0432\u0438\u0434\u0435\u043e \u0441 \u043f\u043b\u043e\u0441\u043a\u0438\u043c, \u043d\u0435\u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u044b\u043c \u0437\u0432\u0443\u043a\u043e\u043c. \u042d\u0442\u043e \u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u043e \u0447\u0442\u043e \u043a\u0443\u043f\u0438\u0442\u044c Ferrari \u0438 \u0435\u0437\u0434\u0438\u0442\u044c \u043d\u0430 \u043f\u0435\u0440\u0432\u043e\u0439 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0435. \u041c\u043e\u0449\u043d\u043e\u0441\u0442\u044c \u0435\u0441\u0442\u044c, \u0430 \u0433\u043b\u0443\u0431\u0438\u043d\u044b \u0438 \u0447\u0435\u0442\u043a\u043e\u0441\u0442\u0438 \u2014 \u043d\u043e\u043b\u044c. \u0417\u0432\u0443\u043a \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u043a\u0440\u0438\u0447\u0430\u0449\u0438\u043c \u0438 \u043f\u0443\u0441\u0442\u044b\u043c, \u0445\u043e\u0442\u044f \u043c\u043e\u0436\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0435\u0433\u043e \u043e\u0431\u044a\u0435\u043c\u043d\u044b\u043c.",
    "\u0412\u043e\u0442 \u0432 \u0447\u0435\u043c \u0441\u0435\u043a\u0440\u0435\u0442: \u0441\u0430\u043c \u0431\u0443\u0441\u0442\u0435\u0440 \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0435\u0442 \u0443\u0440\u043e\u0432\u0435\u043d\u044c, \u043d\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u0438 \u0431\u0430\u0441\u0441-\u0431\u0443\u0441\u0442\u0435\u0440 \u043e\u0436\u0438\u0432\u043b\u044f\u044e\u0442 \u043c\u0443\u0437\u044b\u043a\u0443. \u041e\u043d\u0438 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u044e\u0442 \u0442\u0443 \u0441\u0430\u043c\u0443\u044e \u043f\u043b\u043e\u0442\u043d\u043e\u0441\u0442\u044c, \u0442\u043e\u0442 \u0441\u0430\u043c\u044b\u0439 \u0432\u0430\u0443-\u044d\u0444\u0444\u0435\u043a\u0442, \u043a\u043e\u0433\u0434\u0430 \u043a\u0430\u0436\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u0443 \u0442\u0435\u0431\u044f \u0432 \u043a\u0430\u0440\u043c\u0430\u043d\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0441\u0442\u0443\u0434\u0438\u0439\u043d\u0430\u044f \u043a\u043e\u043b\u043e\u043d\u043a\u0430. \u041e\u0434\u043d\u0430 \u043f\u0440\u0435\u0434\u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u043f\u043e\u0434 \u0442\u0432\u043e\u0439 \u0436\u0430\u043d\u0440 \u2014 \u0438 \u0437\u0432\u0443\u043a \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 \u043d\u0435\u0439\u0440\u043e\u043d\u043e\u0432.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u043a\u043b\u044e\u0447\u0430\u0439 \u0431\u0443\u0441\u0442\u0435\u0440. \u0417\u0430\u0439\u0434\u0438 \u0432 \u0440\u0430\u0437\u0434\u0435\u043b '\u042d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440', \u0432\u044b\u0431\u0435\u0440\u0438 \u043f\u0440\u0435\u0441\u0435\u0442 \u043f\u043e\u0434 \u0442\u043e, \u0447\u0442\u043e \u0441\u043b\u0443\u0448\u0430\u0435\u0448\u044c \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043e (\u041f\u043e\u043f, \u0420\u043e\u043a, \u042d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u0438\u043a\u0430 \u2014 \u043d\u0435\u0432\u0430\u0436\u043d\u043e), \u0438 \u0432\u043a\u043b\u044e\u0447\u0438 '\u0423\u0441\u0438\u043b\u0438\u0442\u0435\u043b\u044c \u0431\u0430\u0441\u043e\u0432'. \u0421\u0434\u0435\u043b\u0430\u0439 \u044d\u0442\u043e \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0438 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0439 \u0440\u0430\u0437\u043d\u0438\u0446\u0443. \u042d\u0442\u043e \u0437\u0430\u0439\u043c\u0435\u0442 15 \u0441\u0435\u043a\u0443\u043d\u0434. P.S. \u0421\u0430\u043c\u044b\u0439 \u0447\u0430\u0441\u0442\u044b\u0439 \u043e\u0442\u0437\u044b\u0432 \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e: '\u0411\u043e\u0436\u0435, \u044f \u0434\u0432\u0430 \u043c\u0435\u0441\u044f\u0446\u0430 \u0441\u043b\u0443\u0448\u0430\u043b \u043a\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u044f\u043f\u043a\u0443'. \u041d\u0435 \u0431\u0443\u0434\u044c \u0432 \u044d\u0442\u0438\u0445 87%.",
    "\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u044d\u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441"
  ],
