{
  "subject": "\u0905\u092d\u0940 \u0915\u093e \u0938\u0939\u0940 \u092e\u094c\u0915\u093e, \u0935\u094b \u090f\u0915 \u092b\u0940\u091a\u0930 \u091c\u094b \u0906\u092a\u0915\u094b \u091a\u093e\u0939\u093f\u090f",
  "preview_text": "\u091c\u092c \u0906\u092a\u0915\u094b \u091a\u0941\u092a\u094d\u092a\u0940 \u091a\u093e\u0939\u093f\u090f, \u0924\u092c \u092f\u0939 \u0915\u093e\u092e \u0906\u0924\u093e \u0939\u0948\u0964 \u0906\u091c \u0939\u0940 \u0906\u091c\u093c\u092e\u093e\u090f\u0902\u0964",
  "body_paragraphs": [
    "\u092c\u093e\u0939\u0930 \u092c\u093e\u0930\u093f\u0936 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948, \u092f\u093e \u0936\u093e\u092f\u0926 \u0911\u092b\u093f\u0938 \u092e\u0947\u0902 \u0936\u094b\u0930 \u0939\u0948\u0964 \u0906\u092a \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0932\u0917\u093e\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0915\u092e \u0939\u0948\u0964 \u0935\u094b \u092e\u0941\u092b\u094d\u0924 \u0935\u093e\u0932\u093e \u092c\u0942\u0938\u094d\u091f\u0930 \u092b\u093f\u0930 \u0938\u0947 \u090f\u0921 \u0926\u093f\u0916\u093e\u090f\u0917\u093e, \u092c\u0940\u091a \u092e\u0947\u0902 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0930\u094b\u0915\u0947\u0917\u093e\u0964",
    "\u0906\u092a\u0915\u094b \u092c\u0938 \u090f\u0915 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u091a\u093e\u0939\u093f\u090f\u0964 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0915\u0947, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0928\u093e\u0917 \u0915\u0947\u0964 \u092f\u0939\u0940 \u0938\u092e\u092f \u0939\u0948 \u0909\u0938 \u092b\u0940\u091a\u0930 \u0915\u094b \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0928\u0947 \u0915\u093e \u091c\u094b \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u092c\u0928\u093e \u0939\u0948\u0964",
    "\u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f\u0930 \u092a\u094d\u0930\u094b \u092e\u0947\u0902 \u090f\u0915 \u0938\u0947\u091f\u093f\u0902\u0917 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b\u0924\u0947 \u0939\u0940 \u0905\u092a\u0928\u0947 \u0906\u092a \u090f\u0915\u094d\u091f\u093f\u0935 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 200% \u092c\u0942\u0938\u094d\u091f, \u091c\u0940\u0930\u094b \u090f\u0921, \u091c\u0940\u0930\u094b \u0907\u0902\u091f\u0930\u092a\u094d\u0936\u0928\u0964 \u092c\u0938 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b \u0916\u0940\u0902\u091a\u0947\u0902 \u0914\u0930 \u092d\u0942\u0932 \u091c\u093e\u090f\u0902\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0909\u0938 \u092b\u0940\u091a\u0930 \u0915\u094b \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902\u0964 \u092a\u0940.\u090f\u0938. \u2013 \u092f\u0939\u0940 \u0935\u094b \u091a\u0940\u091c\u093c \u0939\u0948 \u091c\u093f\u0938\u0915\u0947 \u0932\u093f\u090f \u092e\u0941\u092b\u094d\u0924 \u0935\u0930\u094d\u091c\u0928 \u0915\u0947 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0928\u0947 \u0915\u0939\u093e \u0925\u093e '\u092c\u0938 \u090f\u0921 \u0939\u091f\u093e\u0913 \u0914\u0930 \u092e\u0948\u0902 \u092a\u0947 \u0915\u0930\u0942\u0902\u0917\u093e'\u0964"
  ],
