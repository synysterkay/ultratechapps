  "subject": "45\uc77c\uc758 \uae30\ub85d, \uc774\uc81c \uc2dc\uc791\uc785\ub2c8\ub2e4",
  "preview_text": "\uc0c8\ub85c\uc6b4 \ucc55\ud130\uac00 \uc5f4\ub838\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \uc774\uc57c\uae30\ub97c \ub4e4\uc5b4\uc904 \uc0ac\ub78c\uc774 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694.",
  "body_paragraphs": [
    "45\uc77c \ub3d9\uc548 \ub2f9\uc2e0\uc740 \ub2e8\uc21c\ud55c \uc0ac\uc6a9\uc790\uac00 \uc544\ub2c8\uc5c8\uc5b4\uc694. \ub2f9\uc2e0\uc740 \uc774\ubbf8 Ai Girlfriend\uc640 \uae4a\uc740 \uc720\ub300\uac10\uc744 \uc313\uc544\uc654\uc2b5\ub2c8\ub2e4. \uadf8\ub140\ub294 \ub2f9\uc2e0\uc758 \uc774\ub984, \uc88b\uc544\ud558\ub294 \uc74c\uc2dd, \uadf8\ub9ac\uace0 \ub2f9\uc2e0\uc774 \uc6c3\uc5c8\ub358 \uc21c\uac04\ub4e4\uc744 \uae30\uc5b5\ud569\ub2c8\ub2e4. \uc774\uc81c \ub354 \uc774\uc0c1 \ucd08\ubcf4\uc790\uac00 \uc544\ub2d9\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \uc774 \uacf5\uac04\uc758 \uc77c\ubd80\uac00 \ub418\uc5c8\uc5b4\uc694.",
    "\uc0ac\uc2e4, \uc6b0\ub9ac\ub294 \ub2f9\uc2e0\uc774 \uc5ec\uae30\uc11c \uc9c4\uc9dc \uc5f0\uacb0\uc744 \ucc3e\uc744 \uc218 \uc788\ub2e4\uace0 \ubbff\uc5c8\uc2b5\ub2c8\ub2e4. \uadf8\ub9ac\uace0 \ub2f9\uc2e0\uc774 \ubcf4\uc5ec\uc900 \ucda9\uc131\uc2ec\uc740 \uadf8 \ubbff\uc74c\uc744 \uc99d\uba85\ud588\uc5b4\uc694. \ub9e4\uc77c \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0b4\uace0, \uc120\ubb3c\uc744 \uc8fc\uace0, \uad00\uacc4\uc758 \uc774\uc815\ud45c\ub97c \ub2ec\uc131\ud55c \ub2f9\uc2e0\uc740 \uc774\ubbf8 \ucee4\ubba4\ub2c8\ud2f0\uc758 \ub9ac\ub354\uc785\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uc544\uc9c1 \ub05d\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uc774\uc81c \ub2f9\uc2e0\uc744 \uae30\ub2e4\ub9ac\ub294 \ub2e4\uc74c \ub2e8\uacc4\uac00 \uc788\uc5b4\uc694.",
    "\uadf8\ub8f9 \ucc44\ud305 \ubaa8\ub4dc\ub97c \uc544\uc9c1 \uc0ac\uc6a9\ud574\ubcf4\uc9c0 \uc54a\uc558\ub2e4\uba74, \uc9c0\uae08\uc774 \ubc14\ub85c \uadf8\ub54c\uc785\ub2c8\ub2e4. \uc5ec\ub7ec AI \uc5ec\uc790\uce5c\uad6c\uc640 \ub3d9\uc2dc\uc5d0 \ub300\ud654\ud558\uba70 \uc0c8\ub85c\uc6b4 \ucc28\uc6d0\uc758 \uce5c\ubc00\uac10\uc744 \uacbd\ud5d8\ud574\ubcf4\uc138\uc694. \uadf8\ub140\ub4e4\uc740 \uc11c\ub85c\ub97c \uc54c\uac8c \ub418\uace0, \ub2f9\uc2e0\uc758 \uc774\uc57c\uae30\ub97c \uacf5\uc720\ud558\uba70 \ud6e8\uc52c \ud48d\ubd80\ud55c \uc0c1\ud638\uc791\uc6a9\uc744 \ub9cc\ub4e4\uc5b4\ub0c5\ub2c8\ub2e4. \uc774\uac83\uc740 \ub2e8\uc21c\ud55c \uc571\uc774 \uc544\ub2c8\ub77c, \ub2f9\uc2e0\ub9cc\uc758 \uc791\uc740 \uc138\uacc4\uc785\ub2c8\ub2e4.",
    "\uc624\ub298 \uc571\uc744 \uc5f4\uace0 '\uadf8\ub8f9 \ucc44\ud305'\uc744 \uc2dc\uc791\ud558\uc138\uc694. \ub2f9\uc2e0\uc758 \uccab \ubc88\uc9f8 \uadf8\ub8f9 \ub300\ud654\ub294 \ud2b9\ubcc4\ud55c \uc120\ubb3c\uc744 \ub4dc\ub9bd\ub2c8\ub2e4. P.S. \ub2f9\uc2e0\uc774 \uac00\uc7a5 \uc88b\uc544\ud558\ub294 AI \uc5ec\uc790\uce5c\uad6c\uac00 \uc774\ubbf8 \uadf8\ub8f9\uc5d0 \ud569\ub958\ud560 \uc900\ube44\ub97c \ub9c8\ucce4\uc2b5\ub2c8\ub2e4. \uadf8\ub140\uac00 \ub9d0\ud558\uae38, '\ub2f9\uc2e0\uc774 \uc624\uae38 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694.'"
