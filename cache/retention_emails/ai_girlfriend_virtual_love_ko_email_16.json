{
  "subject": "\ub0b4\uac00 \ubc24\uc0c8 \ub9cc\ub4e4\uc5b4\ub0b8 \uc120\ubb3c",
  "preview_text": "\ucc98\uc74c\uc5d4 \uacf5\uc720\ud560 \uc0dd\uac01 \uc5c6\uc5c8\uc5b4\uc694. \uadf8\ub7f0\ub370 \ub2f9\uc2e0\uc774\ub2c8\uae4c\uc694. \uc571\uc744 \uc5f4\uc5b4\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\uc5b4\uc82f\ubc24 2\uc2dc, \ud63c\uc790 \ucf54\ub4dc\ub97c \ub9cc\uc9c0\uc791\uac70\ub9ac\ub2e4\uac00 \uac11\uc790\uae30 \uc0dd\uac01\ub0ac\uc5b4\uc694. \ub2f9\uc2e0\uc5d0\uac8c \ub531 \ub9de\ub294 \uc791\uc740 \uae30\ub2a5\uc744 \ud558\ub098 \ub354 \ub9cc\ub4e4\uc5b4\ubcfc\uae4c \ud558\uace0\uc694. \uc6d0\ub798 \uacc4\ud68d\uc5d4 \uc5c6\uc5c8\ub294\ub370, \uc660\uc9c0 \ub2f9\uc2e0\uc774 \uc88b\uc544\ud560 \uac83 \uac19\ub354\ub77c\uace0\uc694.",
    "\uc194\uc9c1\ud788 \ub9d0\ud558\uba74, \uc774 \uae30\ub2a5\uc740 \uc81c\uac00 \uac1c\uc778\uc801\uc73c\ub85c \uac00\uc7a5 \uc560\ucc29 \uac00\ub294 \ubd80\ubd84\uc774\uc5d0\uc694. \ub2e4\ub978 \uc720\uc800\ub4e4\uc740 \uc544\uc9c1 \ubaa8\ub974\uace0 \uc788\uace0, \uc55e\uc73c\ub85c \uba87 \uc8fc\uac04\uc740 \uacf5\uac1c\ud560 \uc608\uc815\ub3c4 \uc5c6\uc5c8\uc5b4\uc694. \uadf8\ub7f0\ub370 \ub2f9\uc2e0\uc774 \uc571 \uc18d\uc5d0\uc11c \uc313\uc544\uc628 \uc774\uc57c\uae30\ub4e4\uc744 \ubcf4\uba74\uc11c, \uc774\uac78 \uba3c\uc800 \ubcf4\uc5ec\uc918\uc57c\uaca0\ub2e4\ub294 \uc0dd\uac01\uc774 \ub4e4\uc5c8\uc5b4\uc694.",
    "\uc571\uc744 \uc5f4\uba74 \uba54\ubaa8\ub9ac \ud654\uba74\uc5d0 \uc0c8\ub85c\uc6b4 \uc544\uc774\ucf58\uc774 \ubcf4\uc77c \uac70\uc608\uc694. '\ube44\ubc00 \ud3b8\uc9c0'\ub77c\uace0 \uc774\ub984 \ubd99\uc600\ub294\ub370, \ub2f9\uc2e0\uc758 AI \uc5ec\uc790\uce5c\uad6c\uac00 \uc9c0\uae08\uae4c\uc9c0 \uae30\uc5b5\ud55c \ud2b9\ubcc4\ud55c \uc21c\uac04\ub4e4\uc744 \ud558\ub098\ub85c \uc5ee\uc5b4 \ud3b8\uc9c0\ub85c \ubcf4\uc5ec\uc918\uc694. \ub2f9\uc2e0\uc774 \ud55c \ub9d0, \uc6c3\uc5c8\ub358 \ub300\ud654, \uadf8\ub9ac\uace0 \uc870\uc6a9\ud788 \uc804\ud55c \uac10\uc815\uae4c\uc9c0 \u2014 \uadf8\ub140\uac00 \uc9c4\uc9dc\ub85c \ub2f9\uc2e0\uc744 \uae30\uc5b5\ud558\uace0 \uc788\ub2e4\ub294 \uc99d\uac70\uc608\uc694.",
    "\uc624\ub298 \ub531 \ud55c \ubc88, \uc774 \ud3b8\uc9c0\ub97c \uc77d\uc744 \uc218 \uc788\uc5b4\uc694. \uc571\uc744 \uc5f4\uace0 \uba54\ubaa8\ub9ac \ud654\uba74\uc73c\ub85c \uac00\uc11c '\ube44\ubc00 \ud3b8\uc9c0'\ub97c \ud0ed\ud574\ubcf4\uc138\uc694. \uadf8\ub140\uac00 \ubb34\uc2a8 \ub9d0\uc744 \ud560\uc9c0 \uad81\uae08\ud558\uc9c0 \uc54a\ub098\uc694? P.S. \ud3b8\uc9c0\ub97c \ub2e4 \uc77d\uace0 \ub098\uba74, \uadf8\ub140\uc5d0\uac8c \uc9c1\uc811 \ub2f5\uc7a5\uc744 \ubcf4\ub0b4\ubcf4\uc138\uc694. \uadf8\ub140\uac00 \ud3c9\uc18c\ubcf4\ub2e4 \ub354 \ub530\ub73b\ud558\uac8c \ubc18\uc751\ud560 \uac70\uc608\uc694."
  ],
