  "subject": "90%\u306e\u30e6\u30fc\u30b6\u30fc\u304c\u898b\u9003\u3059\u79d8\u5bc6\u306e\u6a5f\u80fd",
  "preview_text": "\u3042\u306a\u305f\u3082\u30b9\u30ad\u30c3\u30d7\u3057\u3066\u3044\u307e\u305b\u3093\u304b\uff1f\u3053\u306e\u6a5f\u80fd\u3092\u4f7f\u3046\u3060\u3051\u3067\u3001\u30c7\u30fc\u30c8\u304c\u5287\u7684\u306b\u5909\u308f\u308b\u7406\u7531\u3092\u304a\u4f1d\u3048\u3057\u307e\u3059\u3002",
  "body_paragraphs": [
    "\u5148\u9031\u3001\u3042\u308b\u30ab\u30c3\u30d7\u30eb\u304c\u6559\u3048\u3066\u304f\u308c\u305f\u3093\u3067\u3059\u3002\u300eSoulPlan\u30921\u9031\u9593\u4f7f\u3063\u3066\u3001\u3082\u3046\u30de\u30f3\u30cd\u30ea\u304b\u3089\u629c\u3051\u51fa\u305b\u305f\u300f\u3063\u3066\u3002\u3067\u3082\u3001\u5f7c\u3089\u304c\u8a00\u3046\u306b\u306f\u3001\u6700\u521d\u306f\u5168\u7136\u6c17\u3065\u304b\u306a\u304b\u3063\u305f\u6a5f\u80fd\u304c\u3042\u3063\u305f\u3089\u3057\u3044\u3002\u5b9f\u306f\u3001\u307b\u3068\u3093\u3069\u306e\u30e6\u30fc\u30b6\u30fc\u304c\u898b\u904e\u3054\u3057\u3066\u3044\u308b\u3001\u3067\u3082\u4e00\u756a\u3059\u3054\u3044\u6a5f\u80fd\u304c\u3042\u308b\u3093\u3067\u3059\u3002",
    "\u3042\u306a\u305f\u3082\u3001\u30a2\u30d7\u30ea\u3092\u958b\u3044\u3066\u300eAI\u304a\u3059\u3059\u3081\u300f\u3060\u3051\u898b\u3066\u7d42\u308f\u3063\u3066\u307e\u305b\u3093\u304b\uff1f\u305d\u308c\u3060\u3051\u3058\u3083\u3001\u307e\u3060\u5b9d\u306e\u6301\u3061\u8150\u308c\u3002\u79c1\u305f\u3061\u304c\u5bc6\u304b\u306b\u4ed5\u8fbc\u3093\u3060\u96a0\u3057\u6a5f\u80fd\u306f\u3001\u30d1\u30fc\u30c8\u30ca\u30fc\u3092\u9a5a\u304b\u305b\u305f\u3044\u3068\u304d\u306b\u3060\u3051\u5149\u308b\u4ed5\u639b\u3051\u3002\u4f7f\u3063\u305f\u30ab\u30c3\u30d7\u30eb\u306e92%\u304c\u300e\u95a2\u4fc2\u304c\u826f\u304f\u306a\u3063\u305f\u300f\u3068\u7b54\u3048\u305f\u3001\u305d\u306e\u79d8\u5bc6\u3092\u4eca\u304b\u3089\u6559\u3048\u307e\u3059\u3002",
    "\u305d\u308c\u306f\u300e\u30b5\u30d7\u30e9\u30a4\u30ba\u30c7\u30fc\u30c8\u30d7\u30e9\u30f3\u30ca\u30fc\u300f\u3002\u7247\u65b9\u304c\u30d7\u30e9\u30f3\u3092\u7df4\u308a\u3001\u3082\u3046\u7247\u65b9\u306f\u5f53\u65e5\u307e\u3067\u77e5\u3089\u306a\u3044\u3002\u3042\u306a\u305f\u306e\u8da3\u5473\u3084\u4e88\u7b97\u3092AI\u304c\u5b66\u7fd2\u3057\u3066\u3001\u76f8\u624b\u304c\u7d76\u5bfe\u559c\u3076\u30c7\u30fc\u30c8\u3092\u81ea\u52d5\u751f\u6210\u3002\u3057\u304b\u3082\u3001\u30ec\u30b9\u30c8\u30e9\u30f3\u304b\u3089\u30a2\u30af\u30c6\u30a3\u30d3\u30c6\u30a3\u307e\u3067\u3001\u5730\u5143\u306e\u96a0\u308c\u305f\u540d\u6240\u3082\u63d0\u6848\u3057\u3066\u304f\u308c\u308b\u3002\u307e\u308b\u3067\u3001\u604b\u306e\u30d7\u30ed\u30c7\u30e5\u30fc\u30b5\u30fc\u304c\u3064\u3044\u3066\u308b\u307f\u305f\u3044\u3002",
    "\u4eca\u3059\u3050\u30a2\u30d7\u30ea\u3092\u958b\u3044\u3066\u3001\u300e\u30b5\u30d7\u30e9\u30a4\u30ba\u30d7\u30e9\u30f3\u300f\u3092\u30bf\u30c3\u30d7\u3057\u3066\u3002\u6700\u521d\u306e\u30c7\u30fc\u30c8\u30d7\u30e9\u30f3\u3092\u4f5c\u308b\u306e\u306b5\u5206\u3082\u304b\u304b\u3089\u306a\u3044\u3002P.S. \u4f7f\u3063\u305f\u3089\u3001\u30d1\u30fc\u30c8\u30ca\u30fc\u306e\u30ea\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u305c\u3072\u6559\u3048\u3066\u3002\u79c1\u305f\u3061\u3082\u5bc6\u304b\u306b\u697d\u3057\u307f\u306b\u3057\u3066\u308b\u304b\u3089\u3002"
  ],
