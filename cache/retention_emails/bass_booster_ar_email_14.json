{
  "subject": "30 \u064a\u0648\u0645\u0627 \u0645\u0639 9000 \u0634\u062e\u0635 \u064a\u0633\u0645\u0639\u0648\u0646 \u0627\u0644\u0628\u0627\u0633",
  "preview_text": "\u0623\u0646\u062a \u0644\u0633\u062a \u0648\u062d\u062f\u0643. \u0647\u0646\u0627\u0643 \u0622\u0644\u0627\u0641 \u064a\u0633\u0645\u0639\u0648\u0646 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0643\u0645\u0627 \u064a\u062c\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u0627\u0646\u0638\u0631 \u0628\u0646\u0641\u0633\u0643.",
  "body_paragraphs": [
    "\u0642\u0628\u0644 30 \u064a\u0648\u0645\u0627\u060c \u062d\u0645\u0644\u062a \u062a\u0637\u0628\u064a\u0642 Bass Booster. \u0631\u0628\u0645\u0627 \u0643\u0646\u062a \u062a\u0628\u062d\u062b \u0639\u0646 \u0635\u0648\u062a \u064a\u0647\u0632 \u0635\u062f\u0631\u0643\u060c \u0628\u062f\u0644\u0627 \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u0633\u0637\u062d \u0627\u0644\u0645\u064a\u062a. \u0627\u0644\u064a\u0648\u0645\u060c \u0623\u0646\u062a \u062c\u0632\u0621 \u0645\u0646 \u0634\u064a\u0621 \u0623\u0643\u0628\u0631.",
    "\u0647\u0646\u0627\u0643 \u0627\u0644\u0622\u0646 9000 \u0634\u062e\u0635\u060c \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0644\u062d\u0638\u0629\u060c \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u064a\u0633\u062a\u0645\u0639\u0648\u0646 \u0625\u0644\u0649 \u0627\u0644\u0647\u064a\u0628 \u0647\u0648\u0628\u060c \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u060c \u0627\u0644\u0631\u0648\u0643\u060c \u0648\u0643\u0644 \u0634\u064a\u0621 \u0628\u064a\u0646\u0647\u0645\u0627. \u0644\u064a\u0633\u0648\u0627 \u0645\u062c\u0631\u062f \u0645\u0633\u062a\u0645\u0639\u064a\u0646 \u0639\u0627\u062f\u064a\u064a\u0646. \u0647\u0645 \u0645\u062c\u0645\u0648\u0639\u0629 \u062a\u0631\u0641\u0636 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0627\u0644\u0635\u0648\u062a \u0645\u064a\u062a\u0627. \u0623\u0646\u062a \u0648\u0627\u062d\u062f \u0645\u0646\u0647\u0645.",
    "\u0639\u0646\u062f\u0645\u0627 \u062a\u0633\u062d\u0628 \u0634\u0631\u064a\u0637 Boost \u0625\u0644\u0649 \u0623\u0642\u0635\u0649 \u0627\u0644\u064a\u0645\u064a\u0646\u060c \u0648\u062a\u0634\u0639\u0631 \u0628\u0627\u0644\u0628\u0627\u0633 \u064a\u0636\u0631\u0628 \u0641\u064a \u0623\u0630\u0646\u064a\u0643\u060c \u062a\u0630\u0643\u0631: \u0647\u0630\u0627 \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u062a\u0637\u0628\u064a\u0642. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0633\u0645\u0627\u0639 \u0627\u0644\u0623\u063a\u0646\u064a\u0629 \u0648\u0627\u0644\u0634\u0639\u0648\u0631 \u0628\u0647\u0627. \u062c\u0631\u0628 \u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629 \u0644\u0644\u062a\u0639\u0627\u062f\u0644 \u0627\u0644\u0635\u0648\u062a\u064a 10 \u0646\u0637\u0627\u0642\u0627\u062a\u060c \u0648\u0634\u0627\u0647\u062f \u0643\u064a\u0641 \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u0635\u0628\u062d \u0627\u0644\u0635\u0648\u062a \u0645\u062e\u062a\u0644\u0641\u0627.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0648\u0627\u0633\u062d\u0628 \u0634\u0631\u064a\u0637 Boost. \u0627\u0633\u062a\u0645\u0639 \u0625\u0644\u0649 \u0623\u063a\u0646\u064a\u062a\u0643 \u0627\u0644\u0645\u0641\u0636\u0644\u0629. \u0623\u062e\u0628\u0631\u0646\u064a \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0634\u0639\u0631 \u0628\u0627\u0644\u0641\u0631\u0642. \u0645\u0644\u0627\u062d\u0638\u0629: 100,000 \u0634\u062e\u0635 \u062d\u0645\u0644\u0648\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u064812,800 \u0645\u0646\u0647\u0645 \u062a\u0631\u0643\u0648\u0627 \u062a\u0642\u064a\u064a\u0645\u0627 4.7 \u0646\u062c\u0648\u0645. \u0647\u0645 \u0644\u064a\u0633\u0648\u0627 \u0645\u062e\u0637\u0626\u064a\u0646."
  ],
