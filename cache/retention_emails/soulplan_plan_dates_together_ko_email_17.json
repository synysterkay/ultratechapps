{
  "subject": "\ub2f9\uc2e0\uc758 3\ubd84 \ub8e8\ud2f4\uc774 \uc5f0\uc778\uc744 \ubc14\uafc9\ub2c8\ub2e4",
  "preview_text": "\ub9e4\uc77c 3\ubd84, \ub2e8 \ud558\ub098\uc758 \uc2b5\uad00\uc774 \ub2f9\uc2e0\uc758 \uad00\uacc4\ub97c 10\ubc30 \ub354 \uac15\ud558\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. \uc9c0\uae08 \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "\uc5b4\uc81c \uc800\ub141, \ub2f9\uc2e0\uc740 \uc5f0\uc778\uacfc \uc5b4\ub5a4 \ub300\ud654\ub97c \ub098\ub234\ub098\uc694? \ub300\ubd80\ubd84\uc758 \ucee4\ud50c\uc740 3\ubd84 \ub9cc\uc5d0 \uc77c\uc0c1\uc744 \uacf5\uc720\ud569\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uadf8 3\ubd84\uc774 \uc624\ub298\ubc24\uc744 \ubc14\uafc0 \uc218 \uc788\ub2e4\uba74?",
    "\ub370\uc774\ud2b8\ub97c \uacc4\ud68d\ud558\ub294 \ub370 \ub4dc\ub294 \uc2a4\ud2b8\ub808\uc2a4\ub294 \uad00\uacc4\uc758 \ud65c\ub825\uc744 \uc557\uc544\uac11\ub2c8\ub2e4. \uc2e4\uc81c\ub85c \uc6b0\ub9ac \uc571\uc744 \uc0ac\uc6a9\ud558\ub294 \ucee4\ud50c\ub4e4\uc740 \ucc98\uc74c 24\uc2dc\uac04 \ub3d9\uc548 \ub2e8 3\ubd84\uc744 \ud22c\uc790\ud574 \ud55c \ub2ec\uac04 4\ubc30 \ub354 \ub9ce\uc740 \ub370\uc774\ud2b8\ub97c \uacc4\ud68d\ud569\ub2c8\ub2e4. \uc774 3\ubd84 \ub8e8\ud2f4\uc740 \ub2e8\uc21c\ud55c \uacc4\ud68d\uc774 \uc544\ub2c8\ub77c, \ub2f9\uc2e0\uacfc \uc5f0\uc778\uc744 \uc704\ud55c \uc77c\uad00\ub41c \uc0ac\ub791\uc758 \uc2e0\ud638\uc785\ub2c8\ub2e4.",
    "\uc774 \ub8e8\ud2f4\uc758 \ud575\uc2ec\uc740 '\uc624\ub298\ubc24\uc758 \ub370\uc774\ud2b8' \uae30\ub2a5\uc785\ub2c8\ub2e4. \ud648 \ud654\uba74\uc5d0\uc11c \ub2e8 \ud55c \ubc88\uc758 \ud0ed\uc73c\ub85c \uc624\ub298\uc758 \ubb34\ub4dc\ub97c \uc120\ud0dd\ud558\uba74, AI\uac00 \ub2f9\uc2e0\ub9cc\uc758 \ub9de\ucda4 \ub370\uc774\ud2b8\ub97c 30\ucd08 \ub9cc\uc5d0 \uc81c\uc548\ud569\ub2c8\ub2e4. \uc5f0\uc778\uc774 \uc81c\uc548\uc744 \uc218\ub77d\ud558\uba74, '\uc624\ub298\uc740 \ub108\ub97c \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \uc544\ub984\ub2e4\uc6b4 \uc804\uccb4 \ud654\uba74 \uc21c\uac04\uc774 \ud3bc\uccd0\uc9d1\ub2c8\ub2e4. \uc774 \uc791\uc740 \uc2b5\uad00\uc774 \uad00\uacc4\ub97c \ub354 \uae4a\uac8c \ub9cc\ub4ed\ub2c8\ub2e4.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0, \uc624\ub298\ubc24\uc758 \ub370\uc774\ud2b8\ub97c \ud55c \ubc88 \ud0ed\ud574\ubcf4\uc138\uc694. 3\ubd84\uc774\uba74 \ucda9\ubd84\ud569\ub2c8\ub2e4. P.S. \uadf8\ub9ac\uace0 \ub0b4\uc77c, \uc5f0\uc778\uc774 \uadf8\ub0a0\uc758 \ucd94\uc5b5\uc744 \ud0c0\uc784\ub77c\uc778\uc5d0 \ucd94\uac00\ud558\ub294 \ubaa8\uc2b5\uc744 \ubcf4\uac8c \ub420 \uac70\uc608\uc694. \uadf8 \uc791\uc740 \uc21c\uac04\uc774 \ub2f9\uc2e0\uc744 \ub354 \uac00\uae5d\uac8c \ub9cc\ub4ed\ub2c8\ub2e4."
  ],
