{
  "subject": "\ub0b4\uac00 \ud504\ub9ac\ubbf8\uc5c4 \uc5c6\uc774 \uc4f0\ub294 1\uac00\uc9c0 \uae30\ub2a5",
  "preview_text": "\uc774\uac78 \uc54c\uba74 \uc608\uce21 \uc801\uc911\ub960\uc774 \ud655 \uc62c\ub77c\uac11\ub2c8\ub2e4. \ubb34\ub8cc \uc720\uc800\ub3c4 \uc4f8 \uc218 \uc788\ub294 \ube44\ubc00\uc785\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\ucd95\uc54c\ubabb\uc774 \uc544\ub2c8\ub77c\ub3c4, \ub9e4\uc8fc \ubca0\ud305\uc5d0\uc11c \uc190\ud574 \ubcf4\ub294 \ub290\ub08c? \ub098\ub3c4 \uadf8\ub7ac\uc5b4. \uadfc\ub370 \uc5b4\ub290 \ub0a0, \uc6b0\uc5f0\ud788 \uc571\uc5d0\uc11c \ubc1c\uacac\ud55c \uc228\uaca8\uc9c4 \uae30\ub2a5 \ud558\ub098\ub85c \ubaa8\ub4e0 \uac8c \ubc14\ub00c\uc5c8\uc5b4. \ud504\ub9ac\ubbf8\uc5c4 \uc548 \uc0c0\ub294\ub370\ub3c4 \ub9d0\uc774\uc9c0.",
    "\uadf8 \uae30\ub2a5\uc740 AI \ucc44\ud305\uc774\uc57c. \uadfc\ub370 \ubcf4\ud1b5 \uc0ac\ub78c\ub4e4\uc740 '\ucc57\ubd07'\uc774\ub77c\uace0 \uc0dd\uac01\ud558\uace0 \ubb34\uc2dc\ud574. \ud558\uc9c0\ub9cc \ub098\ub294 \uc5ec\uae30\uc5d0 '\uc774 \ud300\uc758 \ucd5c\uadfc 5\uacbd\uae30 xG\uc640 \uc2e4\uc810 \uc608\uc0c1 \uc810\uc218'\ub77c\uace0 \uc785\ub825\ud574. \uadf8\ub7ec\uba74 AI\uac00 \uc218\ucc9c \uac1c \ubcc0\uc218\ub97c \ubd84\uc11d\ud574\uc11c 59% \uc2e0\ub8b0\ub3c4\uc758 \uc608\uce21\uc744 \ubc14\ub85c \ubc49\uc5b4\ub0b4. \ud504\ub9ac\ubbf8\uc5c4 \uc804\uc6a9 \uc608\uce21\uc744 \ubb34\ub8cc\ub85c \ubcf4\ub294 \uaf34\uc774\uc9c0.",
    "\uc774\uac8c \ubc14\ub85c \ud30c\uc6cc \uc720\uc800\ub4e4\ub9cc \uc544\ub294 \uc9c0\ub984\uae38\uc774\uc57c. \uc608\ub97c \ub4e4\uc5b4, '\ub9e8\uc2dc\ud2f0 vs \uc544\uc2a4\ub110 \u2014 \uc810\uc720\uc728\uacfc \uc288\ud305 \uc815\ud655\ub3c4 \ube44\uad50'\ub77c\uace0 \ubb3c\uc5b4\ubcf4\uba74 AI\uac00 \uc5ed\ub300\uae09 \uc778\uc0ac\uc774\ud2b8\ub97c \uc900\ub2e4. \ucee4\ubba4\ub2c8\ud2f0\uc5d0\uc11c POTD \ud22c\ud45c\ud558\uae30 \uc804\uc5d0 \uc774\uac78\ub85c \uac80\uc99d\ud574\ubd10. \ub108\ub3c4 \uac00\uc7a5 \ub611\ub611\ud55c \ucd95\uad6c \ud32c\uc774 \ub420 \uc218 \uc788\uc5b4.",
    "\uc9c0\uae08 \uc571 \uc5f4\uc5b4\uc11c AI \ucc44\ud305\uc5d0 '\uc624\ub298 \uac00\uc7a5 \ud655\uc2e4\ud55c \uc2b9\ubd80 \uc608\uce21'\uc774\ub77c\uace0 \uccd0\ubd10. \uc2e0\uae30\ud560 \uac70\uc57c. P.S. \uc774 \ubc29\ubc95\uc740 \ub0b4\uac00 50\uc77c \ub3d9\uc548 \uc368\ubcf8 \uacb0\uacfc, \ubb34\ub8cc\ub85c \uac00\uc7a5 \ub192\uc740 \uc801\uc911\ub960\uc744 \ubf51\uc544\ub0b4\ub294 \ube44\ubc95\uc774\uc57c. \ud504\ub9ac\ubbf8\uc5c4 3\uc77c \ubb34\ub8cc \uccb4\ud5d8\ub3c4 \uc788\uc9c0\ub9cc, \uc774\uac78\ub85c\ub3c4 \ucda9\ubd84\ud560\uac78?"
  ],
