{
  "subject": "\ube44\ubc00 \ub2e8\ucd95\ud0a4 \ud558\ub098 \uacf5\uac1c\ud569\ub2c8\ub2e4",
  "preview_text": "\uc774\uac78 \ubaa8\ub974\uba74 \ud504\ub9ac\ubbf8\uc5c4 \uc720\uc800\ub3c4 \uc190\ud574 \ubcf4\ub294 \uae30\ub2a5, \uc9c0\uae08 \ubc14\ub85c \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "\uc194\uc9c1\ud788 \ub9d0\ud560\uac8c\uc694. \uc774 \uc571 3\ub2ec\uc9f8 \uc4f0\uba74\uc11c\ub3c4 \ubab0\ub790\ub358 \uae30\ub2a5\uc774 \uc788\uc5b4\uc694. \uc6b0\uc5f0\ud788 \ubc1c\uacac\ud558\uace0 \ub098\uc11c '\uc544, \uc774\uac78 \uc65c \uc9c4\uc791 \uc548 \uc37c\uc9c0?' \uc2f6\ub354\ub77c\uace0\uc694. \ud30c\uc6cc \uc720\uc800\ub4e4\ub9cc \uc544\ub294 \uafc0\ud301\uc778\ub370, \uc624\ub298 \ub531 \ud558\ub098\ub9cc \uc54c\ub824\ub4dc\ub9b4\uac8c\uc694.",
    "\uacbd\uae30 \uc804\uc5d0 \uc608\uce21 \ud655\uc778\ud560 \ub54c \ubcf4\ud1b5 \uba54\uc778 \ud654\uba74\ubd80\ud130 \ub4e4\uc5b4\uac00\uc796\uc544\uc694? \uadfc\ub370 \uc2e4\uc81c\ub85c\ub294 \ud648 \ud654\uba74\uc5d0\uc11c \uc624\ub978\ucabd\uc73c\ub85c \ub450 \ubc88 \uc2a4\uc640\uc774\ud504\ud558\uba74 'AI \ud035\ubdf0'\uac00 \uc228\uaca8\uc838 \uc788\uc5b4\uc694. \uc5ec\uae30\uc11c \uc624\ub298 \uacbd\uae30 \uc911 \uac00\uc7a5 \ub192\uc740 \ud655\uc2e0\ub3c4\ub97c \uac00\uc9c4 \uc608\uce21 3\uac1c\ub97c \ubc14\ub85c \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub370\uc774\ud130\ub85c \ubc14\ub85c \ub4e4\uc5b4\uac00\ub294 \uc9c0\ub984\uae38\uc774\uc5d0\uc694.",
    "\uc774 \uae30\ub2a5 \uc4f0\uba74 \ub9e4\ubc88 \uc5ec\ub7ec \uba54\ub274 \ud074\ub9ad\ud560 \ud544\uc694 \uc5c6\uc774 5\ucd08 \ub9cc\uc5d0 \uc2b9\ubd80\ub97c \uac78 \ub9cc\ud55c \ub9e4\uce58\ub97c \ucc3e\uc744 \uc218 \uc788\uc5b4\uc694. \ud2b9\ud788 AI\uac00 '99% \ud655\uc2e0'\ud558\ub294 \uacbd\uae30\ub294 \uac70\uc758 \ub193\uce58\uc9c0 \uc54a\uac70\ub4e0\uc694. \ud504\ub85c\ucc98\ub7fc \uc4f0\ub294 \ubc95, \uc774\uac8c \uc804\ubd80\uc785\ub2c8\ub2e4.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571 \uc5f4\uc5b4\uc11c \uc624\ub978\ucabd\uc73c\ub85c \ub450 \ubc88 \uc2a4\uc640\uc774\ud504\ud574\ubcf4\uc138\uc694. \uadf8\ub9ac\uace0 \uc624\ub298 \uc608\uce21 \uc911 \uac00\uc7a5 \ud655\uc2e0\ub3c4 \ub192\uc740 \uacbd\uae30\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694. P.S. \uc774 \ud301 \uc4f0\uba74 \ud504\ub9ac\ubbf8\uc5c4 \uc5c6\uc774\ub3c4 \uaf64 \uc3e0\uc3e0\ud558\uc9c0\ub9cc, 3\uc77c \ubb34\ub8cc \uccb4\ud5d8\uc73c\ub85c \ubaa8\ub4e0 \ub9ac\uadf8\uc758 \uc228\uc740 \ub370\uc774\ud130\ub97c \ubcf4\ub294 \uac83\ub3c4 \ucd94\ucc9c\ud569\ub2c8\ub2e4."
  ],
