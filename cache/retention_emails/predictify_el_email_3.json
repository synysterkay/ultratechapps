{
  "subject": "\u03a4\u03bf \u03bb\u03ac\u03b8\u03bf\u03c2 \u03c0\u03bf\u03c5 \u03ba\u03ac\u03bd\u03b5\u03b9\u03c2 \u03c3\u03c4\u03bf 60'",
  "preview_text": "\u0388\u03bd\u03b1 \u03bc\u03b9\u03ba\u03c1\u03cc \u03ba\u03cc\u03bb\u03c0\u03bf \u03c0\u03bf\u03c5 \u03b1\u03bb\u03bb\u03ac\u03b6\u03b5\u03b9 \u03c4\u03b1 \u03c0\u03ac\u03bd\u03c4\u03b1 \u03c3\u03c4\u03b7\u03bd \u03c0\u03c1\u03cc\u03b2\u03bb\u03b5\u03c8\u03ae \u03c3\u03bf\u03c5 - \u03b4\u03b5\u03c2 \u03c4\u03bf \u03c4\u03ce\u03c1\u03b1.",
  "body_paragraphs": [
    "\u039e\u03ad\u03c1\u03b5\u03b9\u03c2 \u03cc\u03c4\u03b9 \u03c4\u03bf 70% \u03c4\u03c9\u03bd \u03b3\u03ba\u03bf\u03bb \u03bc\u03c0\u03b1\u03af\u03bd\u03b5\u03b9 \u03bc\u03b5\u03c4\u03ac \u03c4\u03bf 60\u03cc \u03bb\u03b5\u03c0\u03c4\u03cc; \u039a\u03b9 \u03cc\u03bc\u03c9\u03c2, \u03bf\u03b9 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03bf\u03b9 \u03c6\u03af\u03bb\u03b1\u03b8\u03bb\u03bf\u03b9 \u03ba\u03bf\u03b9\u03c4\u03ac\u03bd\u03b5 \u03bc\u03cc\u03bd\u03bf \u03c4\u03b1 \u03c3\u03c4\u03b1\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03ac \u03c4\u03bf\u03c5 \u03c0\u03c1\u03ce\u03c4\u03bf\u03c5 \u03b7\u03bc\u03b9\u03c7\u03c1\u03cc\u03bd\u03bf\u03c5. \u0391\u03c5\u03c4\u03cc \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03bf \u03bb\u03ac\u03b8\u03bf\u03c2 \u03c0\u03bf\u03c5 \u03c3\u03b5 \u03ba\u03ac\u03bd\u03b5\u03b9 \u03bd\u03b1 \u03c7\u03ac\u03bd\u03b5\u03b9\u03c2 \u03c3\u03c4\u03bf\u03b9\u03c7\u03ae\u03bc\u03b1\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03bd\u03b9\u03ce\u03b8\u03b5\u03b9\u03c2 \u03cc\u03c4\u03b9 \u03b7 \u03b4\u03b9\u03b1\u03af\u03c3\u03b8\u03b7\u03c3\u03b7 \u03b4\u03b5\u03bd \u03c6\u03c4\u03ac\u03bd\u03b5\u03b9.",
    "\u0397 \u03b1\u03bb\u03ae\u03b8\u03b5\u03b9\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03cc\u03c4\u03b9 \u03b7 \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u03c4\u03c9\u03bd \u03bf\u03bc\u03ac\u03b4\u03c9\u03bd \u03b1\u03bb\u03bb\u03ac\u03b6\u03b5\u03b9 \u03b4\u03c1\u03b1\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u03c3\u03c4\u03bf \u03b4\u03b5\u03cd\u03c4\u03b5\u03c1\u03bf \u03b7\u03bc\u03af\u03c7\u03c1\u03bf\u03bd\u03bf. \u0397 \u03ba\u03bf\u03cd\u03c1\u03b1\u03c3\u03b7, \u03bf\u03b9 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ad\u03c2, \u03b7 \u03c4\u03b1\u03ba\u03c4\u03b9\u03ba\u03ae \u2014 \u03cc\u03bb\u03b1 \u03c0\u03b1\u03af\u03b6\u03bf\u03c5\u03bd \u03c1\u03cc\u03bb\u03bf. \u039a\u03b1\u03b9 \u03b5\u03b4\u03ce \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03bf \u03bc\u03b9\u03ba\u03c1\u03cc \u03ba\u03cc\u03bb\u03c0\u03bf: \u03ac\u03c1\u03c7\u03b9\u03c3\u03b5 \u03bd\u03b1 \u03b5\u03bb\u03ad\u03b3\u03c7\u03b5\u03b9\u03c2 \u03c4\u03b1 xG \u03c4\u03bf\u03c5 \u03b4\u03b5\u03cd\u03c4\u03b5\u03c1\u03bf\u03c5 \u03b7\u03bc\u03b9\u03c7\u03c1\u03cc\u03bd\u03bf\u03c5. \u0394\u03b5\u03bd \u03c7\u03c1\u03b5\u03b9\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 \u03bd\u03b1 \u03b5\u03af\u03c3\u03b1\u03b9 \u03b1\u03bd\u03b1\u03bb\u03c5\u03c4\u03ae\u03c2, \u03b1\u03c0\u03bb\u03ac \u03b4\u03b5\u03c2 \u03c4\u03b1 \u03bd\u03bf\u03cd\u03bc\u03b5\u03c1\u03b1 \u03c0\u03bf\u03c5 \u03ad\u03c7\u03b5\u03b9 \u03b7 Predictify \u03b3\u03b9\u03b1 \u03ba\u03ac\u03b8\u03b5 \u03b1\u03b3\u03ce\u03bd\u03b1.",
    "\u03a3\u03c4\u03b7\u03bd \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03bc\u03b1\u03c2, \u03ad\u03c7\u03bf\u03c5\u03bc\u03b5 \u03b5\u03bd\u03c3\u03c9\u03bc\u03b1\u03c4\u03ce\u03c3\u03b5\u03b9 \u03b2\u03b1\u03b8\u03b9\u03ac \u03c3\u03c4\u03b1\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03ac \u03cc\u03c0\u03c9\u03c2 xG, \u03ba\u03b1\u03c4\u03bf\u03c7\u03ae \u03bc\u03c0\u03ac\u03bb\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03b1\u03bc\u03c5\u03bd\u03c4\u03b9\u03ba\u03ae \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u03b1\u03bd\u03ac \u03b7\u03bc\u03af\u03c7\u03c1\u03bf\u03bd\u03bf. \u0391\u03bd\u03c4\u03af \u03bd\u03b1 \u03b2\u03b1\u03c3\u03af\u03b6\u03b5\u03c3\u03b1\u03b9 \u03c3\u03c4\u03bf \u03ad\u03bd\u03c3\u03c4\u03b9\u03ba\u03c4\u03bf, \u03b4\u03b5\u03c2 \u03c4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1. \u0393\u03b9\u03b1 \u03c0\u03b1\u03c1\u03ac\u03b4\u03b5\u03b9\u03b3\u03bc\u03b1, \u03b7 \u039c\u03c0\u03ac\u03b3\u03b5\u03c1\u03bd \u03ad\u03c7\u03b5\u03b9 2.3 xG \u03c3\u03c4\u03bf \u03b4\u03b5\u03cd\u03c4\u03b5\u03c1\u03bf \u03b7\u03bc\u03af\u03c7\u03c1\u03bf\u03bd\u03bf \u03c6\u03ad\u03c4\u03bf\u03c2 \u2014 \u03b1\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03c0\u03bf\u03c5 \u03c3\u03bf\u03c5 \u03bb\u03ad\u03b5\u03b9 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b1 \u03b1\u03c0\u03cc \u03cc\u03c3\u03b1 \u03bd\u03bf\u03bc\u03af\u03b6\u03b5\u03b9\u03c2.",
    "\u0386\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03b7\u03bd Predictify \u03c4\u03ce\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03ba\u03bf\u03af\u03c4\u03b1\u03be\u03b5 \u03c4\u03b1 stats \u03c4\u03bf\u03c5 \u03b5\u03c0\u03cc\u03bc\u03b5\u03bd\u03bf\u03c5 \u03b1\u03b3\u03ce\u03bd\u03b1. \u0394\u03b9\u03ac\u03bb\u03b5\u03be\u03b5 \u03ad\u03bd\u03b1 \u03bc\u03b1\u03c4\u03c2, \u03b4\u03b5\u03c2 \u03c4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03b1\u03bd\u03ac \u03b7\u03bc\u03af\u03c7\u03c1\u03bf\u03bd\u03bf \u03ba\u03b1\u03b9 \u03ba\u03ac\u03bd\u03b5 \u03c4\u03b7\u03bd \u03c0\u03c1\u03cc\u03b2\u03bb\u03b5\u03c8\u03ae \u03c3\u03bf\u03c5. \u0398\u03b1 \u03b5\u03ba\u03c0\u03bb\u03b1\u03b3\u03b5\u03af\u03c2 \u03c0\u03cc\u03c3\u03bf \u03b1\u03bb\u03bb\u03ac\u03b6\u03b5\u03b9 \u03b7 \u03bc\u03b1\u03c4\u03b9\u03ac \u03c3\u03bf\u03c5. P.S. \u0391\u03bd \u03b4\u03bf\u03ba\u03b9\u03bc\u03ac\u03c3\u03b5\u03b9\u03c2 \u03c4\u03bf Premium, \u03ad\u03c7\u03b5\u03b9\u03c2 \u03c0\u03c1\u03cc\u03c3\u03b2\u03b1\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c3\u03b5 \u03c0\u03c1\u03bf\u03b7\u03b3\u03bc\u03ad\u03bd\u03b1 \u03bc\u03bf\u03bd\u03c4\u03ad\u03bb\u03b1 \u03c0\u03bf\u03c5 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ad\u03c0\u03bf\u03c5\u03bd \u03c3\u03ba\u03bf\u03c1 \u03bc\u03b5 \u03b1\u03ba\u03c1\u03af\u03b2\u03b5\u03b9\u03b1 85% \u2014 \u03b1\u03bb\u03bb\u03ac \u03c0\u03c1\u03ce\u03c4\u03b1, \u03ba\u03ac\u03bd\u03b5 \u03c4\u03bf \u03c0\u03c1\u03ce\u03c4\u03bf \u03b2\u03ae\u03bc\u03b1."
