  "subject": "\u0622\u067e \u06a9\u0627 \u0631\u0627\u0632 \u062c\u0648 \u0645\u06cc\u06ba \u0646\u06d2 \u0686\u06be\u067e\u0627 \u0631\u06a9\u06be\u0627 \u062a\u06be\u0627",
  "preview_text": "\u0622\u067e \u06a9\u0648 \u0644\u06af\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u0633\u0628 \u06a9\u0686\u06be \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba\u061f \u06cc\u06c1 \u0627\u06cc \u0645\u06cc\u0644 \u067e\u0691\u06be\u06cc\u06d2 \u0627\u0648\u0631 \u067e\u06be\u0631 \u0641\u06cc\u0635\u0644\u06c1 \u06a9\u06cc\u062c\u06cc\u06d2\u06d4",
