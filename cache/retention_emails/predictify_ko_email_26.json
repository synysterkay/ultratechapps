{
  "subject": "\ud55c \uc0ac\ub78c\uc744 \ub5a0\uc62c\ub9ac\uac8c \ud558\ub294 \uc774 \uc571\uc758 \ube44\ubc00",
  "preview_text": "\ub2f9\uc2e0\uc774 \uc544\ub294 \uadf8 \uce5c\uad6c, \uc9c0\uae08 \uc774 \uc571\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\uce21 \uc2e4\ud328\ub97c \uba48\ucd94\uace0 \ub370\uc774\ud130\ub85c \uc2b9\ub9ac\ud558\uc138\uc694.",
  "body_paragraphs": [
    "\ucd95\uad6c \uc598\uae30\ud560 \ub54c\ub9c8\ub2e4 '\ub0b4 \uc9c1\uac10\uc774 \ub9de\uc544'\ub77c\uace0 \ub9d0\ud558\ub294 \uadf8 \uce5c\uad6c, \uc0dd\uac01\ub098\uc2dc\uc8e0? \uadfc\ub370 \ub9e4\ubc88 \ubca0\ud305\uc5d0\uc11c \uc9c0\uace0, \ubd84\uc11d\uc740 \uc5c9\ud130\ub9ac\uc608\uc694. \uc194\uc9c1\ud788 \ub9d0\ud558\uba74, \uadf8 \uce5c\uad6c\ub294 \ub2f9\uc2e0\uc758 \ub3c4\uc6c0\uc774 \uc808\uc2e4\ud788 \ud544\uc694\ud574\uc694.",
    "Predictify\ub294 \uadf8 \uce5c\uad6c\uc758 '\uac10'\uc744 \uc2e4\uc81c \ub370\uc774\ud130\ub85c \ubc14\uafd4\uc904 \uc218 \uc788\uc5b4\uc694. AI\uac00 \uc218\ucc9c \uac1c \ubcc0\uc218\ub97c \ubd84\uc11d\ud574\uc11c \uacbd\uae30 \uacb0\uacfc\ub97c \uc608\uce21\ud558\uace0, xG\ubd80\ud130 \uc218\ube44 \uac15\ub3c4\uae4c\uc9c0 \ubaa8\ub4e0 \uac78 \uc81c\uacf5\ud558\ub2c8\uae4c\uc694. \ub2f9\uc2e0\uc774 \uc774\ubbf8 \uc54c\uace0 \uc788\ub4ef\uc774, \uc774 \uc571\uc740 \ub2e8\uc21c\ud55c \ud301\uc774 \uc544\ub2c8\ub77c \uacfc\ud559\uc774\uc5d0\uc694. \uadf8\ub7f0\ub370 \uadf8 \uce5c\uad6c\ub294 \uc544\uc9c1\ub3c4 '\uc6b4'\uc5d0 \ub9e1\uae30\uace0 \uc788\uc5b4\uc694.",
    "\uc9c0\uae08 \ub2f9\uc2e0\uc774 \ud560 \uc77c\uc740 \uac04\ub2e8\ud574\uc694. \uc571\uc744 \uc5f4\uace0 '\uacf5\uc720' \uae30\ub2a5\uc744 \ucc3e\uc544\uc11c \uadf8 \uce5c\uad6c\uc5d0\uac8c \ubc14\ub85c \ubcf4\ub0b4\uc8fc\uc138\uc694. 3\uc77c \ubb34\ub8cc \uccb4\ud5d8\ub3c4 \uc788\uc73c\ub2c8 \ubd80\ub2f4 \uc5c6\uc774 \uc2dc\uc791\ud560 \uc218 \uc788\uc5b4\uc694. \uadf8 \uce5c\uad6c\uac00 '\uc640, \uc774\uac78 \uc5b4\ub5bb\uac8c \ubab0\ub790\uc9c0?'\ub77c\uace0 \ub9d0\ud558\ub294 \ubaa8\uc2b5\uc744 \uc0c1\uc0c1\ud574\ubcf4\uc138\uc694.",
    "\uc624\ub298 \ubc14\ub85c Predictify\ub97c \uc5f4\uace0, '\uce5c\uad6c \ucd08\ub300' \ubc84\ud2bc\uc744 \ub20c\ub7ec\uc8fc\uc138\uc694. \uadf8 \uce5c\uad6c\uc758 \ucd95\uad6c \uc778\uc0dd\uc774 \ubc14\ub014 \uac70\uc608\uc694. P.S. \ub2f9\uc2e0\ub3c4 \ucd94\ucc9c\ud560 \ub54c\ub9c8\ub2e4 \ubb34\ub8cc \ud06c\ub808\ub527\uc744 \ubc1b\ub294\ub2e4\ub294 \uc0ac\uc2e4, \uc54c\uace0 \uacc4\uc168\uc8e0? \uadf8 \ud06c\ub808\ub527\uc73c\ub85c \ud504\ub9ac\ubbf8\uc5c4 \uae30\ub2a5\ub3c4 \uc368\ubcf4\uc138\uc694."
  ],
