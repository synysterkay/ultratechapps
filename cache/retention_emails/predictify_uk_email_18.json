{
  "subject": "\u042f \u043d\u0435 \u0445\u043e\u0442\u0456\u0432 \u0446\u044c\u043e\u0433\u043e \u043f\u0438\u0441\u0430\u0442\u0438, \u0430\u043b\u0435",
  "preview_text": "\u0427\u0435\u0441\u043d\u0430 \u0440\u043e\u0437\u043c\u043e\u0432\u0430 \u043f\u0440\u043e \u0442\u0435, \u0447\u043e\u043c\u0443 \u044f \u043c\u0430\u0439\u0436\u0435 \u0432\u0438\u0434\u0430\u043b\u0438\u0432 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a. \u041f\u0440\u043e\u0447\u0438\u0442\u0430\u0439, \u0446\u0435 \u0432\u0430\u0436\u043b\u0438\u0432\u043e.",
  "body_paragraphs": [
    "\u0417\u043d\u0430\u0454\u0448, \u044f \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u043d\u0435 \u043f\u0438\u0448\u0443 \u0442\u0430\u043a\u0438\u0445 \u043b\u0438\u0441\u0442\u0456\u0432. \u0410\u043b\u0435 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456 \u0432\u043d\u043e\u0447\u0456, \u0434\u0438\u0432\u043b\u044f\u0447\u0438\u0441\u044c \u043d\u0430 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443, \u044f \u0437\u0440\u043e\u0437\u0443\u043c\u0456\u0432 \u043e\u0434\u043d\u0443 \u0440\u0456\u0447, \u044f\u043a\u0430 \u043c\u0435\u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0440\u0430\u0437\u0438\u043b\u0430. \u042f \u043c\u0430\u0439\u0436\u0435 \u0432\u0438\u0434\u0430\u043b\u0438\u0432 Predictify. \u0421\u0435\u0440\u0439\u043e\u0437\u043d\u043e.",
    "\u0427\u043e\u043c\u0443? \u0411\u043e \u044f \u043f\u043e\u0431\u0430\u0447\u0438\u0432, \u0449\u043e \u0442\u0438\u0441\u044f\u0447\u0456 \u043b\u044e\u0434\u0435\u0439 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u044e\u0442\u044c \u0434\u043e\u0434\u0430\u0442\u043e\u043a, \u0430\u043b\u0435 \u0431\u0456\u043b\u044c\u0448\u0456\u0441\u0442\u044c \u043d\u0430\u0432\u0456\u0442\u044c \u043d\u0435 \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u044e\u0442\u044c \u0439\u043e\u0433\u043e \u043f\u0456\u0441\u043b\u044f \u043f\u0435\u0440\u0448\u043e\u0433\u043e \u0442\u0438\u0436\u043d\u044f. \u0406 \u0446\u0435 \u0431\u043e\u043b\u044f\u0447\u0435. \u042f \u0432\u043a\u043b\u0430\u0434\u0430\u0432 \u0443 \u043d\u044c\u043e\u0433\u043e \u0434\u0443\u0448\u0443, \u043a\u043e\u0436\u043d\u0443 \u043b\u0456\u043d\u0456\u044e \u043a\u043e\u0434\u0443, \u043a\u043e\u0436\u043d\u0443 \u0444\u043e\u0440\u043c\u0443\u043b\u0443. \u0410\u043b\u0435 \u043f\u043e\u0442\u0456\u043c \u044f \u0437\u0433\u0430\u0434\u0430\u0432, \u0434\u043b\u044f \u0447\u043e\u0433\u043e \u0446\u0435 \u0432\u0441\u0435.",
    "\u0422\u0438 \u0437\u043d\u0430\u0454\u0448, \u0449\u043e \u0432 Predictify \u0454 \u043e\u0434\u043d\u0430 \u0444\u0443\u043d\u043a\u0446\u0456\u044f, \u044f\u043a\u0443 \u043c\u0430\u0439\u0436\u0435 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454? \u0426\u0435 AI-\u0447\u0430\u0442. \u0422\u0438 \u043c\u043e\u0436\u0435\u0448 \u0437\u0430\u043f\u0438\u0442\u0430\u0442\u0438 \u0431\u0443\u0434\u044c-\u0449\u043e \u043f\u0440\u043e \u0444\u0443\u0442\u0431\u043e\u043b \u2014 \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0447\u0438 \u0432\u0430\u0440\u0442\u043e \u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u043d\u0430 \u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0443 \u00ab\u0411\u0430\u0440\u0441\u0435\u043b\u043e\u043d\u0438\u00bb \u0437 \u0444\u043e\u0440\u043e\u044e, \u0430\u0431\u043e \u044f\u043a\u0438\u0439 \u0443 \u00ab\u041b\u0456\u0432\u0435\u0440\u043f\u0443\u043b\u044f\u00bb xG \u0443 \u0432\u0438\u0457\u0437\u043d\u0438\u0445 \u043c\u0430\u0442\u0447\u0430\u0445. \u0406 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c \u0437\u0430 \u0441\u0435\u043a\u0443\u043d\u0434\u0443, \u0437 \u0446\u0438\u0444\u0440\u0430\u043c\u0438, \u0430 \u043d\u0435 \u0437 \u043f\u0443\u0441\u0442\u0438\u043c\u0438 \u0441\u043b\u043e\u0432\u0430\u043c\u0438.",
    "\u042f\u043a\u0449\u043e \u0442\u0438 \u0449\u0435 \u043d\u0435 \u043f\u0440\u043e\u0431\u0443\u0432\u0430\u0432 \u0446\u0435, \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u0440\u0430\u0437 \u0432\u0456\u0434\u043a\u0440\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0456 \u043d\u0430\u043f\u0438\u0448\u0438: \u00ab\u0425\u0442\u043e \u0432\u0438\u0433\u0440\u0430\u0454 \u0415\u043b\u044c \u041a\u043b\u0430\u0441\u0456\u043a\u043e?\u00bb. \u041f\u043e\u0431\u0430\u0447\u0438\u0448, \u044f\u043a \u0446\u0435 \u0437\u043c\u0456\u043d\u044e\u0454 \u0433\u0440\u0443. \u0410 \u043f\u043e\u0442\u0456\u043c \u043d\u0430\u043f\u0438\u0448\u0438 \u043c\u0435\u043d\u0456 \u2014 \u044f \u0445\u043e\u0447\u0443 \u0437\u043d\u0430\u0442\u0438, \u0447\u0438 \u0446\u0435 \u0441\u043f\u0440\u0430\u0446\u044e\u0432\u0430\u043b\u043e. P.S. \u042f \u0437\u043d\u0430\u044e, \u0449\u043e \u0442\u0438 \u0441\u043a\u0435\u043f\u0442\u0438\u0447\u043d\u0438\u0439. \u042f \u0442\u0435\u0436 \u0431\u0443\u0432 \u0442\u0430\u043a\u0438\u043c. \u0410\u043b\u0435 \u0434\u0430\u043d\u0456 \u043d\u0435 \u0431\u0440\u0435\u0448\u0443\u0442\u044c \u2014 87% \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0456\u0432 AI \u0441\u043f\u0440\u0430\u0432\u0434\u0436\u0443\u044e\u0442\u044c\u0441\u044f \u0432 \u0442\u043e\u043f-\u043b\u0456\u0433\u0430\u0445."
  ],
