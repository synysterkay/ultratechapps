{
  "subject": "63 \u064a\u0648\u0645\u064b\u0627 \u0645\u0646 \u0627\u0644\u0628\u0627\u0633.. 9,000 \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u062c\u0631\u0647\u0645",
  "preview_text": "\u062f\u0631\u0633\u0646\u0627 10,000 \u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u0648\u062c\u062f\u0646\u0627 \u0634\u064a\u0626\u064b\u0627 \u0635\u0627\u062f\u0645\u064b\u0627: 87% \u0645\u0646\u0647\u0645 \u064a\u062a\u0631\u0643\u0648\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u0639\u062f \u0623\u0633\u0628\u0648\u0639\u064a\u0646. \u0644\u0643\u0646 \u0627\u0644\u0640 13% \u0627\u0644\u0628\u0627\u0642\u064a\u0646 \u0641\u0639\u0644\u0648\u0627 \u0634\u064a\u0626\u064b\u0627 \u0645\u062e\u062a\u0644\u0641\u064b\u0627.",
  "body_paragraphs": [
    "\u0641\u064a \u0627\u0644\u064a\u0648\u0645 63\u060c \u0645\u0639\u0638\u0645 \u0627\u0644\u0646\u0627\u0633 \u064a\u062a\u0648\u0642\u0641\u0648\u0646. \u0644\u0643\u0646 1,300 \u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u0646 \u0623\u0635\u0644 10,000 \u0627\u0633\u062a\u0645\u0631\u0648\u0627. \u0648\u0648\u062c\u062f\u0646\u0627 \u0634\u064a\u0626\u064b\u0627 \u063a\u0631\u064a\u0628\u064b\u0627: \u0643\u0644\u0647\u0645 \u0627\u0633\u062a\u062e\u062f\u0645\u0648\u0627 \u0645\u064a\u0632\u0629 'Boost' \u0642\u0628\u0644 \u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \u0623\u064a \u0623\u063a\u0646\u064a\u0629. \u0644\u064a\u0633 \u0628\u0639\u062f\u0647\u0627\u060c \u0642\u0628\u0644\u0647\u0627.",
    "\u0647\u0630\u0627 \u0644\u064a\u0633 \u0635\u062f\u0641\u0629. \u062d\u064a\u0646 \u0631\u0641\u0639\u0646\u0627 \u0627\u0644\u0635\u0648\u062a \u0628\u0640 200% \u0648\u0636\u063a\u0637\u0646\u0627 \u0639\u0644\u0649 'Bass Virtualizer'\u060c \u0634\u0639\u0631\u0646\u0627 \u0628\u0627\u0644\u062f\u0631\u0648\u0628 \u0641\u064a \u0627\u0644\u0635\u062f\u0631 \u062d\u062a\u0649 \u0639\u0644\u0649 \u0633\u0645\u0627\u0639\u0627\u062a \u0627\u0644\u0623\u0630\u0646 \u0627\u0644\u0631\u062e\u064a\u0635\u0629. \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 '\u0623\u0633\u0645\u0639 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649' \u0648'\u0623\u0634\u0639\u0631 \u0628\u0647\u0627' \u0647\u0648 \u0647\u0630\u0627 \u0627\u0644\u0633\u0644\u0627\u064a\u062f\u0631.",
    "\u0623\u0646\u062a \u0628\u0627\u0644\u0641\u0639\u0644 \u062a\u0645\u0644\u0643 \u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u0644\u0643\u0646 \u0647\u0644 \u062c\u0631\u0628\u062a \u0631\u0641\u0639 'Boost' \u0625\u0644\u0649 \u0623\u0642\u0635\u0649 \u062d\u062f \u062b\u0645 \u062a\u0634\u063a\u064a\u0644 \u0623\u063a\u0646\u064a\u0629 like 'HUMBLE.' \u0645\u0646 Kendrick Lamar \u0623\u0648 'Strobe' \u0645\u0646 Deadmau5\u061f \u0625\u0630\u0627 \u0645\u0627 \u062c\u0631\u0628\u062a\u060c \u0636\u064a\u064e\u0651\u0639\u062a 63 \u064a\u0648\u0645\u064b\u0627.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646. \u0627\u0633\u062d\u0628 \u0627\u0644\u0640 Boost slider \u0644\u0644\u064a\u0645\u064a\u0646. \u0634\u063a\u0651\u0644 \u0623\u064a \u0623\u063a\u0646\u064a\u0629. \u0625\u0630\u0627 \u0645\u0627 \u0634\u0639\u0631\u062a \u0628\u0627\u0644\u0641\u0631\u0642\u060c \u0627\u0643\u062a\u0628 \u0644\u064a. \u0644\u0643\u0646\u064a \u0623\u0639\u0631\u0641 \u0623\u0646\u0643 \u0633\u062a\u0634\u0639\u0631. P.S. \u0627\u0644\u064a\u0648\u0645 63 \u0647\u0648 \u0622\u062e\u0631 \u064a\u0648\u0645 \u0645\u062c\u0627\u0646\u064a \u0644\u0640 Premium. \u0625\u0630\u0627 \u062c\u0631\u0628\u062a \u0627\u0644\u0640 10-band EQ \u0645\u0631\u0629\u060c \u0645\u0627 \u0631\u062c\u0639\u062a \u0644\u0644\u062e\u0644\u0641."
  ],
