{
  "subject": "\u0421\u0435\u043a\u0440\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0440\u0442\u0438\u0442 \u0432\u0430\u0448 \u0437\u0432\u0443\u043a. 90% \u043e\u0448\u0438\u0431\u0430\u044e\u0442\u0441\u044f",
  "preview_text": "\u0412\u044b \u0442\u043e\u0436\u0435 \u0442\u0430\u043a \u0434\u0435\u043b\u0430\u0435\u0442\u0435? \u041e\u0434\u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0432 \u0432\u0430\u0448\u0435\u043c \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0435 \u0441\u0432\u043e\u0434\u0438\u0442 \u043d\u0430 \u043d\u0435\u0442 \u0432\u0441\u044e \u043c\u043e\u0449\u044c \u0431\u0443\u0441\u0442\u0435\u0440\u0430. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435.",
  "body_paragraphs": [
    "\u0412\u043e\u0442 \u0432\u0430\u043c \u0432\u043e\u043f\u0440\u043e\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442 \u0437\u0430\u0434\u0443\u043c\u0430\u0442\u044c\u0441\u044f. \u0412\u044b \u043a\u043e\u0433\u0434\u0430-\u043d\u0438\u0431\u0443\u0434\u044c \u0437\u0430\u043c\u0435\u0447\u0430\u043b\u0438, \u0447\u0442\u043e \u043f\u043e\u0441\u043b\u0435 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0431\u0443\u0441\u0442\u0435\u0440\u0430 \u0437\u0432\u0443\u043a \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0433\u0440\u043e\u043c\u0447\u0435, \u043d\u043e... \u043a\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u043f\u043b\u043e\u0441\u043a\u0438\u043c? \u041a\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u0447\u0435\u0433\u043e-\u0442\u043e \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442. \u0412\u044b \u0434\u0443\u043c\u0430\u0435\u0442\u0435: '\u041d\u0443, \u0433\u0440\u043e\u043c\u0447\u0435 \u0438 \u043b\u0430\u0434\u043d\u043e'. \u0418 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442\u0435 \u0441\u043b\u0443\u0448\u0430\u0442\u044c. \u0410 \u0437\u0440\u044f.",
    "\u041f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u0435 \u0443\u0432\u0435\u0440\u0435\u043d\u044b: \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u2014 \u044d\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0435. \u0427\u0435\u043c \u0433\u0440\u043e\u043c\u0447\u0435, \u0442\u0435\u043c \u043b\u0443\u0447\u0448\u0435. \u042d\u0442\u043e \u043c\u0438\u0444. \u0418 \u043e\u043d \u0443\u0431\u0438\u0432\u0430\u0435\u0442 \u0432\u0430\u0448\u0443 \u043c\u0443\u0437\u044b\u043a\u0443. \u041d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u043f\u0440\u043e\u0440\u044b\u0432 \u2014 \u043d\u0435 \u0432 \u0434\u0435\u0446\u0438\u0431\u0435\u043b\u0430\u0445, \u0430 \u0432 \u0427\u0418\u0421\u0422\u041e\u0422\u0415 \u0438 \u041f\u041e\u041b\u041d\u041e\u0422\u0415 \u0437\u0432\u0443\u043a\u0430. \u0413\u0440\u043e\u043c\u043a\u0438\u0439, \u043d\u043e \u043f\u043b\u043e\u0441\u043a\u0438\u0439 \u0437\u0432\u0443\u043a \u2014 \u044d\u0442\u043e \u043a\u0430\u043a \u043a\u0440\u0438\u0447\u0430\u0442\u044c \u0445\u0440\u0438\u043f\u043b\u044b\u043c \u0433\u043e\u043b\u043e\u0441\u043e\u043c. \u0414\u0430, \u0441\u043b\u044b\u0448\u043d\u043e, \u043d\u043e \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u044f \u043d\u043e\u043b\u044c. \u0414\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e? \u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0442\u0440\u0435\u043a \u0441 \u043c\u043e\u0449\u043d\u044b\u043c \u0431\u0430\u0441\u043e\u043c. \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043d\u0430 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0439 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438, \u043f\u043e\u0442\u043e\u043c \u0441 \u0431\u0443\u0441\u0442\u0435\u0440\u043e\u043c, \u043d\u043e \u0431\u0435\u0437 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440\u0430. \u0427\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435 \u0440\u0430\u0437\u043d\u0438\u0446\u0443? \u0411\u0430\u0441\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0441\u0442\u0430\u043b\u043e, \u043e\u043d \u043f\u0440\u043e\u0441\u0442\u043e '\u0440\u0430\u0437\u043c\u0430\u0437\u0430\u043b\u0441\u044f'.",
    "\u0412\u043e\u0442 \u0433\u0434\u0435 \u0441\u043f\u0440\u044f\u0442\u0430\u043d\u0430 \u043c\u0430\u0433\u0438\u044f. \u041d\u0430\u0448 \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e '\u043f\u043e\u043b\u0437\u0443\u043d\u043a\u0438'. \u042d\u0442\u043e \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0432\u0430\u0448\u0435\u0433\u043e \u0437\u0432\u0443\u043a\u0430. \u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u0440\u0435\u0441\u0435\u0442 'Bass Booster'. \u041e\u043d \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e '\u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u0431\u0430\u0441\u043e\u0432'. \u041e\u043d \u0432\u044b\u0440\u0435\u0437\u0430\u0435\u0442 \u043b\u0438\u0448\u043d\u0438\u0435 \u0441\u0440\u0435\u0434\u043d\u0438\u0435 \u0447\u0430\u0441\u0442\u043e\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0437\u0430\u0433\u043b\u0443\u0448\u0430\u044e\u0442 \u043d\u0438\u0437\u044b, \u0438 \u0430\u043a\u043a\u0443\u0440\u0430\u0442\u043d\u043e \u0443\u0441\u0438\u043b\u0438\u0432\u0430\u0435\u0442 \u0438\u043c\u0435\u043d\u043d\u043e \u0442\u043e\u0442 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0432\u0438\u0431\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438, \u043d\u043e \u0438 \u0432\u0430\u0441. \u042d\u0442\u043e \u0438 \u0435\u0441\u0442\u044c \u0442\u043e\u0442 \u0441\u0430\u043c\u044b\u0439 '\u043a\u043e\u043d\u0446\u0435\u0440\u0442\u043d\u044b\u0439' \u044d\u0444\u0444\u0435\u043a\u0442, \u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u0440\u0438\u043a.",
    "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u043a\u043b\u044e\u0447\u0430\u0439\u0442\u0435 \u0431\u0443\u0441\u0442\u0435\u0440. \u0417\u0430\u0439\u0434\u0438\u0442\u0435 \u0432 '\u042d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440', \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 'Bass Booster' \u0438 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u0442\u043e\u0442 \u0441\u0430\u043c\u044b\u0439 \u0442\u0440\u0435\u043a, \u0433\u0434\u0435 \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u0441\u043e\u0447\u043d\u044b\u0439, \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0431\u0430\u0441. \u041f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435 \u0440\u0430\u0437\u043d\u0438\u0446\u0443 \u0432 \u0433\u0440\u0443\u0434\u0438, \u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u0443\u0448\u0430\u0445. \u042d\u0442\u043e \u0442\u043e\u0442 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u0435\u043d\u044f\u0435\u0442 \u0432\u0441\u0451. P.S. \u041a\u0441\u0442\u0430\u0442\u0438, \u044d\u0442\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u2014 \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u043e\u0435 \u043e\u0440\u0443\u0436\u0438\u0435 \u0434\u043b\u044f \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0430 \u0444\u0438\u043b\u044c\u043c\u043e\u0432. \u0414\u0438\u0430\u043b\u043e\u0433\u0438 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f \u0447\u0435\u0442\u043a\u0438\u043c\u0438, \u0430 \u0432\u0437\u0440\u044b\u0432\u044b \u0438 \u043c\u0443\u0437\u044b\u043a\u0430 \u2014 \u043e\u0433\u043b\u0443\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0441 \u043b\u044e\u0431\u043e\u0439 \u0441\u0446\u0435\u043d\u043e\u0439 \u0438\u0437 Netflix.",
    "\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 Bass Booster \u0441\u0435\u0439\u0447\u0430\u0441"
  ],
