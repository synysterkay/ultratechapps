{
  "subject": "\u51cc\u66682\u70b9\uff0c\u6211\u4e3a\u4ec0\u4e48\u8981\u52a0\u8fd9\u4e2a\u529f\u80fd",
  "preview_text": "\u4e00\u4e2a\u6df1\u591c\u7684\u5d29\u6e83\u77ac\u95f4\uff0c\u8ba9\u6211\u5f7b\u5e95\u6539\u53d8\u4e86Loud EQ\u7684\u8bbe\u8ba1\u65b9\u5411\u3002\u8fd9\u4e0d\u662f\u6280\u672f\uff0c\u662f\u6c42\u751f\u3002",
  "body_paragraphs": [
    "\u90a3\u662f\u51cc\u66682\u70b9\uff0c\u6211\u521a\u4ece\u4e00\u6b21\u957f\u8fbe3\u5c0f\u65f6\u7684\u901a\u52e4\u56de\u5230\u5bb6\u3002\u8033\u6735\u55e1\u55e1\u54cd\uff0c\u624b\u673a\u97f3\u91cf\u5df2\u7ecf\u8c03\u5230100%\uff0c\u4f46\u5728\u5730\u94c1\u4e0a\uff0c\u6211\u8fde\u64ad\u5ba2\u91cc\u7684\u4e00\u53e5\u8bdd\u90fd\u542c\u4e0d\u6e05\u3002\u6211\u76ef\u7740\u5c4f\u5e55\uff0c\u60f3\u7740\uff1a\u5982\u679c\u8fde\u6211\u81ea\u5df1\u90fd\u53d7\u4e0d\u4e86\uff0c\u90a3\u7528\u6237\u80af\u5b9a\u66f4\u5d29\u6e83\u3002",
    "\u90a3\u5929\u665a\u4e0a\uff0c\u6211\u6ca1\u7761\u89c9\u3002\u6211\u6253\u5f00\u4ee3\u7801\uff0c\u5f00\u59cb\u5199\u4e00\u4e2a\u4e0d\u4f1a\u8ba9\u58f0\u97f3\u53d8\u523a\u8033\u7684\u589e\u76ca\u7b97\u6cd5\u3002\u4e0d\u662f\u4e3a\u4e86\u8ba9\u97f3\u4e50\u66f4\u55e8\uff0c\u800c\u662f\u4e3a\u4e86\u8ba9\u4f60\u5728\u5608\u6742\u73af\u5883\u91cc\uff0c\u4e0d\u7528\u628a\u8033\u6735\u903c\u5230\u6781\u9650\u4e5f\u80fd\u542c\u6e05\u6bcf\u4e00\u53e5\u53f0\u8bcd\u3001\u6bcf\u4e00\u4e2a\u5355\u8bcd\u3002\u8fd9\u4e2a\u529f\u80fd\u540e\u6765\u53d8\u6210\u4e86\u300c+200% \u97f3\u91cf\u300d\u2014\u2014\u4f46\u5b83\u4e0d\u662f\u4e3a\u4e86\u70ab\u8000\uff0c\u662f\u4e3a\u4e86\u8ba9\u4f60\u4e0d\u518d\u9700\u8981\u8c03\u9ad8\u97f3\u91cf\u3002",
    "\u8fd9\u4e2a\u529f\u80fd\u5c31\u662f\u4f60\u7684\u300c\u4e00\u952e\u8c03\u97f3\u300d\u6309\u94ae\u3002\u5b83\u4e0d\u53ea\u628a\u58f0\u97f3\u653e\u5927\uff0c\u8fd8\u4f1a\u626b\u63cf\u4f60\u5f53\u524d\u8fde\u7684\u8bbe\u5907\u2014\u2014AirPods\u3001\u8f66\u8f7d\u84dd\u7259\u3001\u6216\u8005\u90a3\u526f\u65e7\u8033\u673a\u2014\u2014\u7136\u540e\u81ea\u52a8\u8c03\u6574\u5747\u8861\u5668\uff0c\u8ba9\u5bf9\u8bdd\u6e05\u6670\u3001\u80cc\u666f\u566a\u97f3\u538b\u4f4e\u3002\u4f60\u70b9\u4e00\u6b21\uff0c\u5b83\u5c31\u8bb0\u4f4f\u4f60\u7684\u8bbe\u5907\uff0c\u4e0b\u6b21\u8fde\u4e0a\u65f6\u81ea\u52a8\u4f18\u5316\u3002",
    "\u73b0\u5728\u6253\u5f00Loud EQ\uff0c\u8bd5\u8bd5\u300c\u4e00\u952e\u8c03\u97f3\u300d\u3002\u544a\u8bc9\u5b83\u4f60\u521a\u521a\u8fde\u4e86\u4ec0\u4e48\u8bbe\u5907\uff0c\u7136\u540e\u542c\u542c\u533a\u522b\u3002\u5982\u679c\u4f60\u8fd8\u60f3\u66f4\u7cbe\u51c6\uff0c\u53ef\u4ee5\u8bd5\u8bd5Premium\uff0c\u89e3\u9501\u5168\u90e85\u6bb5\u5747\u8861\u5668\u548c4\u79cd\u97f3\u9891\u6a21\u5f0f\u3002\u4f60\u53ef\u80fd\u4f1a\u53d1\u73b0\uff0c\u539f\u6765\u4f60\u7684\u8bbe\u5907\u6f5c\u529b\u8fd9\u4e48\u5927\u3002\n\nP.S. \u90a3\u4e2a\u51cc\u6668\uff0c\u6211\u5199\u4e86\u6574\u65746\u5c0f\u65f6\u3002\u7b2c\u4e8c\u5929\u8bd5\u542c\u65f6\uff0c\u6211\u54ed\u4e86\u3002\u56e0\u4e3a\u7b2c\u4e00\u6b21\uff0c\u6211\u5728\u901a\u52e4\u8def\u4e0a\u542c\u6e05\u4e86\u6240\u6709\u5bf9\u767d\u3002\u5e0c\u671b\u4f60\u4e5f\u4e00\u6837\u3002"
  ],
