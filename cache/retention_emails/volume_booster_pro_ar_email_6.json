{
  "subject": "\u062e\u0637\u0623 \u0627\u0644\u0633\u0627\u0639\u0629 \u0627\u0644\u062d\u0627\u062f\u064a\u0629 \u0639\u0634\u0631\u0629 \u0627\u0644\u0630\u064a \u064a\u0641\u0639\u0644\u0647 \u0627\u0644\u062c\u0645\u064a\u0639",
  "preview_text": "\u0645\u0639\u0638\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u062e\u0633\u0631\u0648\u0646 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0646\u0642\u064a \u0628\u0633\u0628\u0628 \u0647\u0630\u0627 \u0627\u0644\u062e\u0637\u0623. \u062a\u062c\u0646\u0628\u0647 \u0627\u0644\u0622\u0646 \u0641\u064a \u0663\u0660 \u062b\u0627\u0646\u064a\u0629.",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0647\u0630\u0627: \u0623\u0646\u062a \u062a\u0633\u062a\u0645\u0639 \u0625\u0644\u0649 \u0628\u0648\u062f\u0643\u0627\u0633\u062a\u0643 \u0627\u0644\u0645\u0641\u0636\u0644\u060c \u0648\u0641\u062c\u0623\u0629 \u0635\u0648\u062a\u0643 \u064a\u0646\u062e\u0641\u0636 \u0625\u0644\u0649 \u0646\u0635\u0641 \u0627\u0644\u0642\u0648\u0629. \u062a\u0641\u062a\u062d \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u060c \u062a\u0644\u0639\u0628 \u0628\u0634\u0631\u064a\u0637 \u0627\u0644\u0635\u0648\u062a\u060c \u0644\u0643\u0646 \u0644\u0627 \u0634\u064a\u0621 \u064a\u062a\u063a\u064a\u0631. \u0627\u0644\u0633\u0628\u0628\u061f \u0644\u064a\u0633 \u0627\u0644\u0635\u0648\u062a \u0646\u0641\u0633\u0647\u060c \u0628\u0644 \u0634\u064a\u0621 \u0623\u0628\u0633\u0637 \u0628\u0643\u062b\u064a\u0631.",
    "\u0627\u0644\u062e\u0637\u0623 \u0627\u0644\u0634\u0627\u0626\u0639 \u0627\u0644\u0630\u064a \u0623\u0631\u0647\u0642 \u0645\u0633\u062a\u062e\u062f\u0645\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0645\u062c\u0627\u0646\u064a \u0647\u0648 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062a\u0639\u0632\u064a\u0632 \u062f\u0648\u0646 \u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0644\u0627 \u062a\u062a\u062f\u0627\u062e\u0644 \u0645\u0639\u0647. \u0645\u0639\u0638\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0623\u062e\u0631\u0649 \u062a\u062a\u0631\u0643 \u0635\u0648\u062a\u0643 \u0645\u0642\u064a\u062f\u0627\u064b \u0628\u062e\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u062e\u0641\u064a\u0629. \u0647\u0646\u0627 \u0627\u0644\u0641\u0631\u0642: \u062a\u0637\u0628\u064a\u0642\u0646\u0627 \u064a\u0645\u0646\u062d\u0643 \u062a\u062d\u0643\u0645\u0627\u064b \u0643\u0627\u0645\u0644\u0627\u064b\u060c \u0644\u0643\u0646 \u0639\u0644\u064a\u0643 \u0623\u0646 \u062a\u0628\u062f\u0623 \u0645\u0646 \u0627\u0644\u0635\u062d\u064a\u062d.",
    "\u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u064a \u064a\u063a\u0641\u0644 \u0639\u0646\u0647\u0627 \u0627\u0644\u0643\u062b\u064a\u0631\u0648\u0646 \u0647\u064a \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0639\u0646\u062f \u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0634\u0631\u064a\u0637 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u060c \u0648\u0634\u063a\u0651\u0644 \u062e\u064a\u0627\u0631 '\u062a\u0637\u0628\u064a\u0642 \u062a\u0644\u0642\u0627\u0626\u064a'. \u0647\u0630\u0627 \u0643\u0644 \u0634\u064a\u0621. \u0628\u0639\u062f\u0647\u0627\u060c \u0633\u062a\u0644\u0627\u062d\u0638 \u0623\u0646 \u0627\u0644\u0635\u0648\u062a \u064a\u0628\u0642\u0649 \u0646\u0642\u064a\u0627\u064b \u0648\u0642\u0648\u064a\u0627\u064b \u062f\u0648\u0646 \u0623\u064a \u062a\u062f\u062e\u0644 \u0645\u0646\u0643.",
    "\u062c\u0631\u0628 \u0647\u0630\u0627 \u0627\u0644\u0622\u0646: \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u062d\u0631\u0643 \u0634\u0631\u064a\u0637 \u0627\u0644\u0635\u0648\u062a \u0625\u0644\u0649 +200%\u060c \u0648\u0634\u063a\u0651\u0644 \u062e\u064a\u0627\u0631 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a. \u0647\u0630\u0647 \u0647\u064a \u0627\u0644\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0648\u062d\u064a\u062f\u0629 \u0644\u0636\u0645\u0627\u0646 \u062a\u062c\u0631\u0628\u0629 \u062e\u0627\u0644\u064a\u0629 \u0645\u0646 \u0627\u0644\u062a\u0634\u062a\u064a\u062a.\n\n\u0645\u0644\u0627\u062d\u0638\u0629: \u0645\u0633\u062a\u062e\u062f\u0645\u0648 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0629 \u064a\u0628\u0644\u063a\u0648\u0646 \u0639\u0646 \u0632\u064a\u0627\u062f\u0629 \u0628\u0646\u0633\u0628\u0629 \u0663\u0660\u066a \u0641\u064a \u0648\u0636\u0648\u062d \u0627\u0644\u0635\u0648\u062a \u0628\u0639\u062f \u0647\u0630\u0627 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0628\u0633\u064a\u0637."
  ],
