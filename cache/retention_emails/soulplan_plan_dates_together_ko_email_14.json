{
  "subject": "\ub2f9\uc2e0\uacfc 1,247\uc30d\uc758 \ucc28\uc774",
  "preview_text": "\ub2e4\ub978 \ucee4\ud50c\ub4e4\uc740 \uc774\ubbf8 \uc6c0\uc9c1\uc774\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \uc544\uc9c1 \ub2a6\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4.",
  "body_paragraphs": [
    "3\uc8fc \uc804, \ub2f9\uc2e0\uacfc \ud30c\ud2b8\ub108\ub294 \ub611\uac19\uc740 \uc800\ub141\uc744 \ubc18\ubcf5\ud558\uace0 \uc788\uc5c8\uc744 \uac81\ub2c8\ub2e4. \uc624\ub298, SoulPlan\uc744 \uc0ac\uc6a9\ud558\ub294 1,247\uc30d\uc758 \ucee4\ud50c\ub4e4\uc740 \ub9e4\uc77c \ubc24\uc744 \ub2e4\ub974\uac8c \ubcf4\ub0b4\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\ub3c4 \uadf8\uc911 \ud558\ub098\uc785\ub2c8\ub2e4.",
    "\uc774 \ucee4\ubba4\ub2c8\ud2f0\ub294 \ub2e8\uc21c\ud55c \uc571\uc774 \uc544\ub2d9\ub2c8\ub2e4. '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub85c 30\ucd08 \ub9cc\uc5d0 \uacc4\ud68d\uc744 \uc138\uc6b0\uace0, \ud30c\ud2b8\ub108\uac00 \ubcf4\ub0b8 \uc81c\uc548\uc744 \ubc1b\uc744 \ub54c\ub9c8\ub2e4 '\uc624\ub298 \ub108\ub97c \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \uba54\uc2dc\uc9c0\ub97c \ub290\ub07c\ub294 \uc0ac\ub78c\ub4e4\uc785\ub2c8\ub2e4. \uadf8\ub4e4\uc740 \uc9c0\ub8e8\ud568\uc5d0 \uc9c0\uc9c0 \uc54a\uace0, \ub9e4\uc77c\uc744 \ud2b9\ubcc4\ud558\uac8c \ub9cc\ub4ed\ub2c8\ub2e4.",
    "\ub2f9\uc2e0\uc758 \ud648 \ud654\uba74\uc5d0 \uc788\ub294 '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \uce74\ub4dc\uac00 \uadf8 \uc99d\uac70\uc785\ub2c8\ub2e4. \ud55c \ubc88 \ud0ed\ud558\uba74 \ubb34\ub4dc\uc5d0 \ub9de\ub294 \ub370\uc774\ud2b8\uac00 \ub098\ud0c0\ub098\uace0, \ud30c\ud2b8\ub108\ub294 \uadf8 \uc21c\uac04\uc744 \uac10\ub3d9\uc73c\ub85c \ubc1b\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \uc774\ubbf8 \uc774 \ud750\ub984\uc758 \uc77c\ubd80\uc785\ub2c8\ub2e4.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0 '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \uce74\ub4dc\ub97c \ud655\uc778\ud558\uc138\uc694. \ub2e8 30\ucd08\uba74 \uc624\ub298\uc774 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. P.S. \uae30\uc5b5\ud558\uc138\uc694, 1,247\uc30d\uc740 \ub2f9\uc2e0\uc774 \uc544\uc9c1 \ubcf4\uc9c0 \ubabb\ud55c \uc21c\uac04\ub4e4\uc744 \ub9cc\ub4e4\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub4e4\ubcf4\ub2e4 \uc55e\uc11c \ub098\uac00\uc138\uc694."
  ],
