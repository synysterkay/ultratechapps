{
  "subject": "\u0631\u0627\u0632\u06cc \u06a9\u0647 \u06f5\u06f0\u06f0 \u06a9\u0627\u0631\u0628\u0631 \u062d\u0631\u0641\u0647\u200c\u0627\u06cc \u067e\u0646\u0647\u0627\u0646 \u06a9\u0631\u062f\u0646\u062f",
  "preview_text": "\u06cc\u06a9 \u0645\u06cc\u0627\u0646\u0628\u0631 \u062f\u0631 Predictify \u06a9\u0647 \u0641\u0642\u0637 \u06f2\u066a \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0645\u06cc\u200c\u062f\u0627\u0646\u0646\u062f \u0648 \u0628\u0627\u0639\u062b \u0635\u0631\u0641\u0647\u200c\u062c\u0648\u06cc\u06cc \u06f1\u06f0 \u062f\u0642\u06cc\u0642\u0647\u200c\u0627\u06cc \u062f\u0631 \u0647\u0631 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u0645\u06cc\u200c\u0634\u0648\u062f.",
  "body_paragraphs": [
    "\u062f\u06cc\u0631\u0648\u0632 \u0633\u0627\u0639\u062a \u06f3 \u0635\u0628\u062d \u062f\u0627\u0634\u062a\u0645 \u0644\u06cc\u06af \u0628\u0631\u062a\u0631 \u0631\u0648 \u0628\u0631\u0631\u0633\u06cc \u0645\u06cc\u200c\u06a9\u0631\u062f\u0645 \u06a9\u0647 \u06cc\u0647 \u0686\u06cc\u0632\u06cc \u062a\u0648\u062c\u0647\u200c\u0627\u0645 \u0631\u0648 \u062c\u0644\u0628 \u06a9\u0631\u062f. \u06f5\u06f0\u06f0 \u062a\u0627 \u0627\u0632 \u06a9\u0627\u0631\u0628\u0631\u0627\u06cc \u062d\u0631\u0641\u0647\u200c\u0627\u06cc \u0645\u0627 \u06cc\u0647 \u06a9\u0627\u0631 \u0639\u062c\u06cc\u0628 \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u200c\u062f\u0646: \u0647\u06cc\u0686\u200c\u06a9\u062f\u0648\u0645\u0634\u0648\u0646 \u0627\u0632 \u0635\u0641\u062d\u0647 \u0627\u0635\u0644\u06cc \u0634\u0631\u0648\u0639 \u0646\u0645\u06cc\u200c\u06a9\u0646\u0646. \u0646\u0647 \u0628\u0631\u0627\u06cc \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc\u060c \u0646\u0647 \u0628\u0631\u0627\u06cc \u0622\u0645\u0627\u0631. \u0647\u0645\u0647 \u0627\u0632 \u06cc\u0647 \u062c\u0627\u06cc \u062f\u06cc\u06af\u0647 \u0634\u0631\u0648\u0639 \u0645\u06cc\u200c\u06a9\u0646\u0646 \u06a9\u0647 \u062a\u0648\u06cc \u0631\u0627\u0647\u0646\u0645\u0627 \u0647\u0645 \u0646\u0648\u0634\u062a\u0647 \u0646\u0634\u062f\u0647.",
    "\u0627\u06cc\u0646 \u06a9\u0627\u0631\u0628\u0631\u0627 \u0641\u0647\u0645\u06cc\u062f\u0646 \u06a9\u0647 \u0642\u0648\u06cc\u200c\u062a\u0631\u06cc\u0646 \u0627\u0628\u0632\u0627\u0631 Predictify \u062a\u0648\u06cc \u06cc\u0647 \u0628\u062e\u0634 \u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u062e\u0641\u06cc \u0642\u0627\u06cc\u0645 \u0634\u062f\u0647: \u0645\u0642\u0627\u06cc\u0633\u0647 \u062a\u06cc\u0645\u06cc \u0644\u062d\u0638\u0647\u200c\u0627\u06cc. \u0648\u0642\u062a\u06cc \u062f\u0648 \u062a\u0627 \u062a\u06cc\u0645 \u0631\u0648 \u0645\u0633\u062a\u0642\u06cc\u0645\u0627\u064b \u06a9\u0646\u0627\u0631 \u0647\u0645 \u0645\u06cc\u200c\u0630\u0627\u0631\u06cc\u060c AI \u0646\u0647 \u0641\u0642\u0637 \u0627\u0645\u062a\u06cc\u0627\u0632 \u0646\u0647\u0627\u06cc\u06cc\u060c \u0628\u0644\u06a9\u0647 \u06f4\u06f7 \u0645\u062a\u063a\u06cc\u0631 \u067e\u0646\u0647\u0627\u0646 \u0645\u062b\u0644 \u0634\u0627\u0646\u0633 \u06af\u0644 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0641\u0627\u0632 \u062d\u0645\u0644\u0647 \u0648 \u0641\u0634\u0627\u0631 \u062f\u0641\u0627\u0639\u06cc \u0631\u0648 \u0646\u0634\u0648\u0646 \u0645\u06cc\u200c\u062f\u0647. \u0627\u06cc\u0646\u062c\u0648\u0631\u06cc \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc\u200c\u0647\u0627\u062a\u0648\u0646 \u062f\u06cc\u06af\u0647 \u062d\u062f\u0633 \u0646\u06cc\u0633\u062a\u060c \u06cc\u0647 \u0646\u0642\u0634\u0647 \u062f\u0642\u06cc\u0642 \u062c\u0646\u06af\u06cc\u0647.",
    "\u062d\u0627\u0644\u0627 \u0686\u0631\u0627 \u0647\u06cc\u0686\u06a9\u0633 \u062f\u0631\u0628\u0627\u0631\u0634 \u062d\u0631\u0641 \u0646\u0645\u06cc\u200c\u0632\u0646\u0647\u061f \u0686\u0648\u0646 \u0627\u06cc\u0646 \u0642\u0627\u0628\u0644\u06cc\u062a \u062a\u0648\u06cc \u062a\u0628 '\u0645\u0642\u0627\u06cc\u0633\u0647' \u0628\u0639\u062f \u0627\u0632 \u0627\u0646\u062a\u062e\u0627\u0628 \u062f\u0648 \u062a\u06cc\u0645 \u0641\u0639\u0627\u0644 \u0645\u06cc\u200c\u0634\u0647 - \u0647\u0645\u0648\u0646 \u062c\u0627\u06cc\u06cc \u06a9\u0647 \u0628\u06cc\u0634\u062a\u0631 \u06a9\u0627\u0631\u0628\u0631\u0627 \u0641\u0642\u0637 \u06cc\u0647 \u0646\u06af\u0627\u0647 \u0645\u06cc\u200c\u0646\u062f\u0627\u0632\u0646 \u0648 \u0645\u06cc\u0631\u0646. \u0648\u0644\u06cc \u062d\u0631\u0641\u0647\u200c\u0627\u06cc\u200c\u0647\u0627 \u06f3 \u062f\u0642\u06cc\u0642\u0647 \u0648\u0642\u062a \u0645\u06cc\u200c\u0630\u0627\u0631\u0646 \u062a\u0627 \u0647\u0645\u0647 \u062e\u0637\u0648\u0637 \u0631\u0648 \u0628\u0631\u0631\u0633\u06cc \u06a9\u0646\u0646. \u062a\u0627\u0632\u0647 \u0627\u06af\u0647 \u067e\u0631\u06cc\u0645\u06cc\u0648\u0645 \u0628\u0627\u0634\u06cc\u060c \u0645\u06cc\u200c\u062a\u0648\u0646\u06cc \u0641\u06cc\u0644\u062a\u0631\u0647\u0627\u06cc \u0647\u0648\u0634\u0645\u0646\u062f \u0631\u0648 \u0647\u0645 \u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc \u06a9\u0647 \u0628\u0628\u06cc\u0646\u06cc \u06a9\u062f\u0648\u0645 \u0645\u062a\u063a\u06cc\u0631 \u0648\u0627\u0642\u0639\u0627\u064b \u062a\u0639\u06cc\u06cc\u0646\u200c\u06a9\u0646\u0646\u062f\u0647\u200c\u0633\u062a.",
    "\u0641\u0642\u0637 \u06f2 \u062f\u0642\u06cc\u0642\u0647 \u0648\u0642\u062a \u0628\u0630\u0627\u0631 \u0648 \u0628\u0631\u0648 \u062a\u0648\u06cc \u062a\u0628 '\u0645\u0642\u0627\u06cc\u0633\u0647 \u062a\u06cc\u0645\u200c\u0647\u0627' - \u06cc\u0647 \u0645\u0633\u0627\u0628\u0642\u0647 \u0648\u0627\u0642\u0639\u06cc \u0631\u0648 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646 \u0648 \u0628\u0628\u06cc\u0646 AI \u0686\u0647 \u0645\u062a\u063a\u06cc\u0631\u0647\u0627\u06cc\u06cc \u0631\u0648 \u0628\u0631\u0627\u062a \u0628\u0631\u062c\u0633\u062a\u0647 \u0645\u06cc\u200c\u06a9\u0646\u0647. \u0627\u06cc\u0646\u0642\u062f\u0631 \u0633\u0631\u06cc\u0639 \u0645\u06cc\u200c\u062a\u0648\u0646\u06cc \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u06a9\u0646\u06cc \u06a9\u0647 \u0627\u0646\u06af\u0627\u0631 \u0627\u0632 \u0622\u06cc\u0646\u062f\u0647 \u0628\u0631\u06af\u0634\u062a\u06cc."
  ],
