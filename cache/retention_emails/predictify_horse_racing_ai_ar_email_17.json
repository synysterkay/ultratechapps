  "subject": "3 \u062f\u0642\u0627\u0626\u0642 \u062a\u063a\u064a\u0631 \u0643\u0644 \u0634\u064a\u0621",
  "preview_text": "\u0627\u0644\u0631\u0648\u062a\u064a\u0646 \u0627\u0644\u0635\u0628\u0627\u062d\u064a \u0627\u0644\u0630\u064a \u064a\u062c\u0639\u0644\u0643 \u062a\u0633\u0628\u0642 \u0627\u0644\u062c\u0645\u064a\u0639 \u0641\u064a \u0633\u0628\u0627\u0642 \u0627\u0644\u062e\u064a\u0644 \u0627\u0644\u064a\u0648\u0645\u064a",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u062a\u0642\u0636\u064a 3 \u062f\u0642\u0627\u0626\u0642 \u0641\u0642\u0637 \u0643\u0644 \u0635\u0628\u0627\u062d\u060c \u062b\u0645 \u062a\u062c\u062f \u0646\u0641\u0633\u0643 \u062a\u0641\u0648\u0632 \u0641\u064a 4 \u0645\u0646 \u0643\u0644 5 \u0631\u0647\u0627\u0646\u0627\u062a. \u0647\u0630\u0627 \u0644\u064a\u0633 \u062e\u064a\u0627\u0644\u0627\u064b\u060c \u0647\u0630\u0627 \u0645\u0627 \u064a\u0641\u0639\u0644\u0647 \u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646\u0627 \u0627\u0644\u0630\u064a\u0646 \u0627\u0644\u062a\u0632\u0645\u0648\u0627 \u0628\u0631\u0648\u062a\u064a\u0646 \u0628\u0633\u064a\u0637. \u0627\u0644\u0633\u0631 \u0644\u064a\u0633 \u0641\u064a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0648\u062d\u062f\u0647\u060c \u0628\u0644 \u0641\u064a \u0643\u064a\u0641 \u062a\u0633\u062a\u062e\u062f\u0645\u0647 \u0628\u0630\u0643\u0627\u0621.",
    "\u0645\u0639\u0638\u0645 \u0627\u0644\u0646\u0627\u0633 \u064a\u0641\u062a\u062d\u0648\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0642\u0628\u0644 \u0627\u0644\u0633\u0628\u0627\u0642 \u0628\u062f\u0642\u0627\u0626\u0642\u060c \u064a\u0642\u0631\u0624\u0648\u0646 \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a \u0628\u0634\u0643\u0644 \u0639\u0634\u0648\u0627\u0626\u064a\u060c \u0648\u064a\u0631\u0627\u0647\u0646\u0648\u0646 \u0639\u0644\u0649 \u0623\u0648\u0644 \u062d\u0635\u0627\u0646 \u064a\u0644\u0645\u0639 \u0641\u064a \u0623\u0639\u064a\u0646\u0647\u0645. \u0647\u0630\u0627 \u062e\u0637\u0623 \u0641\u0627\u062f\u062d. \u0627\u0644\u0633\u0631 \u0627\u0644\u062d\u0642\u064a\u0642\u064a \u0647\u0648 \u0641\u064a \u062a\u062d\u0644\u064a\u0644 3 \u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0623\u0633\u0627\u0633\u064a\u0629 \u0643\u0644 \u064a\u0648\u0645: \u0623\u0631\u0636\u064a\u0629 \u0627\u0644\u0645\u0636\u0645\u0627\u0631\u060c \u0623\u062f\u0627\u0621 \u0627\u0644\u062d\u0635\u0627\u0646 \u0639\u0644\u0649 \u0646\u0641\u0633 \u0627\u0644\u0645\u0633\u0627\u0641\u0629\u060c \u0648\u062a\u063a\u064a\u0631\u0627\u062a \u0627\u0644\u0648\u0632\u0646. \u0647\u0630\u0647 \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0647\u064a \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0644\u0631\u0641\u0639 \u062f\u0642\u0629 \u062a\u0648\u0642\u0639\u0627\u062a\u0643 \u0625\u0644\u0649 90%.",
    "\u0641\u064a \u062a\u0637\u0628\u064a\u0642 Predictify\u060c \u0644\u062f\u064a\u0646\u0627 \u0645\u064a\u0632\u0629 '\u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0635\u0628\u0627\u062d\u064a' \u0627\u0644\u062a\u064a \u062a\u062c\u0645\u0639 \u0644\u0643 \u0647\u0630\u0647 \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0641\u064a \u0634\u0627\u0634\u0629 \u0648\u0627\u062d\u062f\u0629. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0643\u0644 \u0635\u0628\u0627\u062d\u060c \u0627\u0642\u0631\u0623 \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0644\u0645\u062f\u0629 \u062f\u0642\u064a\u0642\u062a\u064a\u0646\u060c \u062b\u0645 \u0627\u062e\u062a\u0631 3 \u0633\u0628\u0627\u0642\u0627\u062a \u0628\u062b\u0642\u0629 \u0639\u0627\u0644\u064a\u0629. \u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646\u0627 \u0627\u0644\u0630\u064a\u0646 \u064a\u0644\u062a\u0632\u0645\u0648\u0646 \u0628\u0647\u0630\u0627 \u0627\u0644\u0631\u0648\u062a\u064a\u0646 \u064a\u0632\u064a\u062f\u0648\u0646 \u0623\u0631\u0628\u0627\u062d\u0647\u0645 \u0628\u0645\u0639\u062f\u0644 3 \u0623\u0636\u0639\u0627\u0641.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628 \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0635\u0628\u0627\u062d\u064a \u0644\u0633\u0628\u0627\u0642 \u0627\u0644\u064a\u0648\u0645. \u0644\u0627 \u062a\u0642\u0644\u0642\u060c 3 \u062f\u0642\u0627\u0626\u0642 \u0641\u0642\u0637. P.S. \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u060c \u062c\u0631\u0628 \u0628\u0631\u064a\u0645\u064a\u0648\u0645 \u0644\u0645\u062f\u0629 3 \u0623\u064a\u0627\u0645 \u0645\u062c\u0627\u0646\u0627\u064b \u2013 \u0633\u062a\u062c\u062f \u062a\u062d\u0644\u064a\u0644\u0627\u062a \u0623\u0639\u0645\u0642 \u062a\u0632\u064a\u062f \u0645\u0646 \u062f\u0642\u0629 \u0627\u062e\u062a\u064a\u0627\u0631\u0627\u062a\u0643 \u0625\u0644\u0649 95%."
