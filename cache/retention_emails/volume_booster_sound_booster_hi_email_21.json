{
  "subject": "\u0906\u092a\u0915\u0940 \u0906\u0916\u093f\u0930\u0940 \u092c\u093e\u0930 48 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0916\u094b\u0932\u093e \u0925\u093e \u2014 \u0905\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u0917\u092f\u093e \u0939\u0948",
  "preview_text": "\u0939\u092e\u0928\u0947 \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0928\u092f\u093e \u091c\u0940\u0935\u0928 \u0926\u093f\u092f\u093e \u0939\u0948\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947 \u092f\u0939 \u0910\u092a \u0905\u092c \u0914\u0930 \u092d\u0940 \u091c\u094d\u092f\u093e\u0926\u093e \u0926\u092e\u0926\u093e\u0930 \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u0939 \u0926\u093f\u0928 \u091c\u092c \u0906\u092a\u0928\u0947 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u092f\u0939 \u0910\u092a \u0916\u094b\u0932\u093e \u0925\u093e? \u0924\u092c \u0906\u092a\u0915\u094b \u0932\u0917\u093e \u0939\u094b\u0917\u093e \u0915\u093f \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u0905\u092c \u0914\u0930 \u0924\u0947\u091c\u093c \u0906\u0935\u093e\u091c\u093c \u0928\u0939\u0940\u0902 \u0928\u093f\u0915\u093e\u0932 \u0938\u0915\u0924\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0906\u092a\u0928\u0947 \u092a\u093e\u092f\u093e \u0915\u093f \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f\u0930 \u0928\u0947 \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964 \u0905\u092c 48 \u0926\u093f\u0928 \u092c\u0940\u0924 \u0917\u090f \u0939\u0948\u0902, \u0914\u0930 \u0939\u092e\u0928\u0947 \u0915\u0941\u091b \u0910\u0938\u093e \u091c\u094b\u0921\u093c\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u094b \u0939\u0948\u0930\u093e\u0928 \u0915\u0930 \u0926\u0947\u0917\u093e\u0964",
    "\u0939\u092e\u0928\u0947 \u0939\u093e\u0932 \u0939\u0940 \u092e\u0947\u0902 \u090f\u0915 \u0928\u092f\u093e \u092b\u0940\u091a\u0930 \u0932\u0949\u0928\u094d\u091a \u0915\u093f\u092f\u093e \u0939\u0948 \u2014 \"\u0938\u0941\u092a\u0930 \u092c\u0942\u0938\u094d\u091f \u092e\u094b\u0921\"\u0964 \u092f\u0939 \u0906\u092a\u0915\u0947 \u0938\u094d\u092a\u0940\u0915\u0930 \u0915\u0940 \u0932\u093f\u092e\u093f\u091f \u0915\u094b \u092a\u093e\u0930 \u0915\u0930\u0915\u0947 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0907\u0924\u0928\u093e \u0924\u0947\u091c\u093c \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a \u092d\u0940\u0921\u093c \u092d\u0930\u0947 \u0915\u0948\u092b\u0947 \u092e\u0947\u0902 \u092d\u0940 \u0905\u092a\u0928\u0947 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u093e \u0939\u0930 \u0936\u092c\u094d\u0926 \u0938\u0941\u0928 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u094b\u091a\u093f\u090f, \u0905\u092c \u0906\u092a \u091f\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u092f\u093e \u092c\u093e\u091c\u093c\u093e\u0930 \u092e\u0947\u0902 \u092d\u0940 \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u0947 \u0915\u093e \u092c\u093e\u0938 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0935\u0939\u0940 \u0905\u0928\u0941\u092d\u0935 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u094b \u090f\u0915 \u0915\u0949\u0928\u094d\u0938\u0930\u094d\u091f \u092e\u0947\u0902 \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964",
    "\u092f\u0939 \u092b\u0940\u091a\u0930 \u0916\u093e\u0938\u0924\u094c\u0930 \u092a\u0930 \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948 \u091c\u094b \u0939\u0930 \u0926\u093f\u0928 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u2014 \u091a\u093e\u0939\u0947 \u0935\u0939 \u0938\u094d\u092a\u0949\u091f\u093f\u092b\u093e\u0908 \u092a\u0930 \u0917\u093e\u0928\u093e \u0938\u0941\u0928\u0928\u093e \u0939\u094b, \u092f\u0942\u091f\u094d\u092f\u0942\u092c \u092a\u0930 \u0935\u0940\u0921\u093f\u092f\u094b \u0926\u0947\u0916\u0928\u093e \u0939\u094b, \u092f\u093e \u0928\u0947\u091f\u092b\u094d\u0932\u093f\u0915\u094d\u0938 \u092a\u0930 \u092e\u0942\u0935\u0940\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0938\u0947 \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u090f\u0915 \u0928\u090f \u0921\u093f\u0935\u093e\u0907\u0938 \u091c\u0948\u0938\u093e \u0932\u0917\u0947\u0917\u093e\u0964 \u0914\u0930 \u0939\u093e\u0901, \u092f\u0939 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0906\u092a \u0907\u0938\u0947 \u092e\u0941\u092b\u094d\u0924 \u092e\u0947\u0902 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u0915\u093f \u0906\u092a \u092b\u093f\u0930 \u0938\u0947 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0907\u0938 \u0928\u090f \u092b\u0940\u091a\u0930 \u0915\u094b \u0906\u091c\u093c\u092e\u093e\u090f\u0902\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u0915\u093f\u0924\u0928\u093e \u092c\u0926\u0932 \u0917\u092f\u093e \u0939\u0948\u0964",
    "P.S. \u2014 \u091c\u094b \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0939\u0940 \u092f\u0939 \u092b\u0940\u091a\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u091a\u0941\u0915\u0947 \u0939\u0948\u0902, \u0909\u0928\u0915\u093e \u0915\u0939\u0928\u093e \u0939\u0948 \u0915\u093f \u0909\u0928\u0915\u093e \u092b\u094b\u0928 \u0905\u092c \u092a\u0939\u0932\u0947 \u0938\u0947 \u0926\u094b\u0917\u0941\u0928\u093e \u0924\u0947\u091c\u093c \u0932\u0917\u0924\u093e \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0906\u092a \u092a\u0940\u091b\u0947 \u0930\u0939\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?"
  ],
  "cta_text": "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0938\u0941\u092a\u0930 \u092c\u0942\u0938\u094d\u091f \u092e\u094b\u0921 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902",
