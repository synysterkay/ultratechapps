{
  "subject": "\u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u064a \u0633\u062a\u0631\u0627\u0647\u0627 \u0642\u0628\u0644 \u0627\u0644\u062c\u0645\u064a\u0639 \u064a\u0648\u0645 42",
  "preview_text": "\u0634\u064a\u0621 \u062c\u062f\u064a\u062f \u0642\u0627\u062f\u0645 \u0625\u0644\u0649 Loudify \u062d\u0635\u0631\u064a\u064b\u0627 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0645\u062b\u0627\u0628\u0631\u064a\u0646. \u0623\u0646\u062a \u0623\u0648\u0644 \u0645\u0646 \u064a\u0639\u0644\u0645.",
  "body_paragraphs": [
    "\u0647\u0644 \u062a\u0639\u0644\u0645 \u0623\u0646 \u0623\u0643\u062b\u0631 \u0645\u0646 70% \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u062a\u0648\u0642\u0641\u0648\u0646 \u0639\u0646 \u062a\u062d\u0633\u064a\u0646 \u0627\u0644\u0635\u0648\u062a \u0628\u0639\u062f \u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0623\u0648\u0644\u061f \u0644\u0643\u0646\u0643 \u0644\u0633\u062a \u0645\u062b\u0644\u0647\u0645. \u0644\u0642\u062f \u0648\u0635\u0644\u062a \u0625\u0644\u0649 \u0627\u0644\u064a\u0648\u0645 42\u060c \u0648\u0647\u0630\u0627 \u064a\u0639\u0646\u064a \u0623\u0646\u0643 \u062c\u0632\u0621 \u0645\u0646 \u0627\u0644\u0646\u062e\u0628\u0629 \u0627\u0644\u062a\u064a \u062a\u0631\u064a\u062f \u0627\u0644\u0623\u0641\u0636\u0644. \u0644\u0647\u0630\u0627 \u0627\u0644\u0633\u0628\u0628\u060c \u0646\u062d\u0646 \u0646\u0643\u0634\u0641 \u0644\u0643 \u0639\u0646 \u0634\u064a\u0621 \u0642\u0628\u0644 \u0623\u064a \u0634\u062e\u0635 \u0622\u062e\u0631.",
    "\u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0645\u0642\u0628\u0644\u060c \u0633\u0646\u0637\u0644\u0642 \u0645\u064a\u0632\u0629 \u062c\u062f\u064a\u062f\u0629 \u062a\u0633\u0645\u0649 \"Sound DNA Live\". \u062a\u062e\u064a\u0644 \u0623\u0646 \u062a\u0631\u0649 \u0643\u064a\u0641 \u064a\u062a\u063a\u064a\u0631 \u062a\u0648\u0632\u064a\u0639 \u0627\u0644\u0635\u0648\u062a \u0641\u064a \u0623\u0630\u0646\u064a\u0643 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u0646\u0642\u0644\u060c \u0641\u064a \u0627\u0644\u0642\u0637\u0627\u0631\u060c \u0623\u0648 \u062d\u062a\u0649 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0645\u0630\u0627\u0643\u0631\u0629. \u0644\u064a\u0633\u062a \u0645\u062c\u0631\u062f \u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a \u0628\u0639\u062f \u0627\u0644\u0627\u0633\u062a\u0645\u0627\u0639\u060c \u0628\u0644 \u0631\u0633\u0645 \u0628\u064a\u0627\u0646\u064a \u062d\u064a \u064a\u0638\u0647\u0631 \u0644\u0643 \u0645\u062a\u0649 \u0643\u0646\u062a \u0628\u062d\u0627\u062c\u0629 \u0625\u0644\u0649 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0648\u0645\u062a\u0649 \u0643\u0627\u0646 \u0627\u0644\u0635\u0648\u062a \u0645\u062b\u0627\u0644\u064a\u064b\u0627. \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0645\u0628\u0646\u064a\u0629 \u0639\u0644\u0649 \u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0623\u0643\u062b\u0631 \u062a\u0641\u0627\u0639\u0644\u0627\u064b\u060c \u0645\u062b\u0644\u0643.",
    "\u0643\u0644 \u0645\u0627 \u0639\u0644\u064a\u0643 \u0641\u0639\u0644\u0647 \u0647\u0648 \u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \u0623\u064a\u0642\u0648\u0646\u0629 \"Sound DNA\" \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0641\u064a \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629. \u0633\u062a\u0631\u0649 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0627\u0644\u0641\u0639\u0644\u064a\u0629 \u0645\u0646 \u0627\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u0640 42 \u0627\u0644\u0645\u0627\u0636\u064a\u0629\u060c \u0648\u0633\u062a\u062d\u0635\u0644 \u0639\u0644\u0649 \u062a\u0648\u0642\u0639\u0627\u062a \u0645\u062e\u0635\u0635\u0629 \u0644\u062a\u062d\u0633\u064a\u0646 \u062a\u062c\u0631\u0628\u062a\u0643 \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0639\u0627\u062f\u0627\u062a\u0643. \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0645\u062a\u0627\u062d\u0629 \u062d\u0627\u0644\u064a\u064b\u0627 \u0641\u0642\u0637 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0630\u064a\u0646 \u0644\u062f\u064a\u0647\u0645 30 \u064a\u0648\u0645\u064b\u0627 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0645\u0646 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645.",
    "\u0627\u0641\u062a\u062d Loudify \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628\u0647\u0627. \u0641\u0642\u0637 \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0623\u064a\u0642\u0648\u0646\u0629 Sound DNA \u0641\u064a \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629. P.S. \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0633\u062a\u062e\u062f\u0645 Premium\u060c \u0633\u062a\u062d\u0635\u0644 \u0639\u0644\u0649 \u062a\u062d\u0644\u064a\u0644 \u0623\u0639\u0645\u0642 \u064a\u0634\u0645\u0644 \u062a\u0641\u0627\u0635\u064a\u0644 \u0643\u0644 \u062c\u0644\u0633\u0629 \u0627\u0633\u062a\u0645\u0627\u0639. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u062a\u062d\u062f\u064a\u062b\u060c \u0625\u0646\u0647 \u0646\u0642\u0644\u0629 \u0646\u0648\u0639\u064a\u0629 \u0641\u064a \u0643\u064a\u0641\u064a\u0629 \u0633\u0645\u0627\u0639\u0643 \u0644\u0644\u0639\u0627\u0644\u0645."
