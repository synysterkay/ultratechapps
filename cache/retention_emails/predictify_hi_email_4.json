{
  "subject": "\u090f\u0915 \u0917\u0932\u0924\u0940 \u091c\u094b 90% \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 (\u0914\u0930 \u092a\u091b\u0924\u093e\u0924\u0947 \u0939\u0948\u0902)",
  "preview_text": "\u0906\u091c 3,847 \u092f\u0942\u091c\u0930\u094d\u0938 \u0928\u0947 \u092f\u0939 \u0915\u093f\u092f\u093e \u0914\u0930 \u0909\u0928\u0915\u0940 \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928 \u090f\u0915\u094d\u092f\u0942\u0930\u0947\u0938\u0940 42% \u092c\u0922\u093c \u0917\u0908\u0964 \u0906\u092a \u0915\u0939\u093e\u0901 \u0939\u0948\u0902?",
  "body_paragraphs": [
    "\u0938\u091a \u092c\u0924\u093e\u090a\u0901? \u092e\u0948\u0902\u0928\u0947 \u0906\u091c \u0938\u0941\u092c\u0939 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0926\u0947\u0916\u093e \u0914\u0930 \u091a\u094c\u0902\u0915 \u0917\u092f\u093e\u0964 \u0906\u091c \u0915\u0947\u0935\u0932 \u090f\u0915 \u092b\u0940\u091a\u0930 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0915\u0947 3,847 \u092f\u0942\u091c\u0930\u094d\u0938 \u0928\u0947 \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928 \u090f\u0915\u094d\u092f\u0942\u0930\u0947\u0938\u0940 \u092e\u0947\u0902 42% \u0915\u093e \u0938\u0940\u0927\u093e \u0938\u0941\u0927\u093e\u0930 \u0926\u093f\u0916\u093e\u092f\u093e\u0964 \u092f\u0947 \u0935\u094b \u0932\u094b\u0917 \u0939\u0948\u0902 \u091c\u094b \u0905\u092c \u0938\u093f\u0930\u094d\u092b '\u0932\u0915' \u092a\u0930 \u0928\u0939\u0940\u0902, \u0921\u0947\u091f\u093e \u092a\u0930 \u0926\u093e\u0902\u0935 \u0932\u0917\u093e \u0930\u0939\u0947 \u0939\u0948\u0902\u0964",
    "\u092f\u0947 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0932 \u0924\u0915 \u0906\u092a\u0915\u0940 \u0924\u0930\u0939 \u0939\u0940 \u0925\u0947 - \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u0914\u0930 \u0905\u0902\u0926\u093e\u091c\u093c\u0947 \u0938\u0947 \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u0930 \u0930\u0939\u0947 \u0925\u0947\u0964 \u092b\u093f\u0930 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0906\u091c \u0938\u0941\u092c\u0939 \u090f\u0915 \u091a\u0940\u091c\u093c \u091f\u094d\u0930\u093e\u0908 \u0915\u0940: \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f AI \u0915\u093e \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u091a\u0947\u0915 \u0915\u093f\u092f\u093e\u0964 \u091c\u093f\u0928 \u092e\u0948\u091a\u094b\u0902 \u092e\u0947\u0902 AI 85%+ \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u091f \u0925\u093e, \u0938\u093f\u0930\u094d\u092b \u0909\u0928\u092a\u0930 \u092b\u094b\u0915\u0938 \u0915\u093f\u092f\u093e\u0964 \u0928\u0924\u0940\u091c\u093e? \u0909\u0928\u0915\u0940 \u0938\u092b\u0932\u0924\u093e \u0926\u0930 \u0906\u0938\u092e\u093e\u0928 \u091b\u0942\u0928\u0947 \u0932\u0917\u0940, \u091c\u092c\u0915\u093f \u092c\u093e\u0915\u0940 \u0932\u094b\u0917 \u0905\u092d\u0940 \u092d\u0940 \u0905\u0902\u0927\u0947\u0930\u0947 \u092e\u0947\u0902 \u0924\u0940\u0930 \u091a\u0932\u093e \u0930\u0939\u0947 \u0939\u0948\u0902\u0964",
    "\u092f\u0939\u0940 \u0935\u094b \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0939\u0948 \u091c\u094b Predictify \u0915\u094b \u0926\u0942\u0938\u0930\u094b\u0902 \u0938\u0947 \u0905\u0932\u0917 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0939\u0930 \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u0947 \u0938\u093e\u0925 \u0935\u094b \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0928\u0902\u092c\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948 - \u0935\u094b AI \u0915\u093e \u0935\u094b \u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u0939\u0948 \u091c\u094b \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u0935\u0947\u0930\u093f\u090f\u092c\u0932\u094d\u0938 \u090f\u0928\u093e\u0932\u093e\u0907\u091c\u093c \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0906\u0924\u093e \u0939\u0948\u0964 \u0906\u091c \u0915\u0947 \u092e\u0948\u091a\u094b\u0902 \u092e\u0947\u0902 \u0910\u0938\u0947 3 \u092e\u0948\u091a \u0939\u0948\u0902 \u091c\u0939\u093e\u0901 AI 90%+ \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u091f \u0939\u0948\u0964 \u092a\u0930 \u0906\u092a \u0909\u0928 \u0924\u0915 \u092a\u0939\u0941\u0901\u091a \u0928\u0939\u0940\u0902 \u0930\u0939\u0947\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u093f\u090f \u0914\u0930 'Today's Matches' \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u091c\u093e\u0907\u090f\u0964 \u0935\u0939\u093e\u0901 \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0906\u0917\u0947 \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0926\u093f\u0916\u0947\u0917\u093e\u0964 \u0938\u092c\u0938\u0947 \u090a\u0901\u091a\u0947 \u0938\u094d\u0915\u094b\u0930 \u0935\u093e\u0932\u0947 \u092e\u0948\u091a\u094b\u0902 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0940\u091c\u093f\u090f \u0914\u0930 \u0926\u0947\u0916\u093f\u090f AI \u0928\u0947 \u0915\u094d\u092f\u093e \u0921\u0947\u091f\u093e-\u092c\u0948\u0915\u094d\u0921 \u0907\u0928\u0938\u093e\u0907\u091f\u094d\u0938 \u0926\u093f\u090f \u0939\u0948\u0902\u0964 \u0905\u092d\u0940 \u0915\u0930\u093f\u090f, \u0935\u0930\u0928\u093e \u0906\u091c \u0915\u093e \u092e\u0948\u091a \u0936\u0941\u0930\u0942 \u0939\u094b \u091c\u093e\u090f\u0917\u093e \u0914\u0930 \u0906\u092a \u092b\u093f\u0930 \u0938\u0947 \u092a\u0940\u091b\u0947 \u0930\u0939 \u091c\u093e\u090f\u0901\u0917\u0947\u0964 P.S.: \u091c\u094b 3,847 \u092f\u0942\u091c\u0930\u094d\u0938 \u0906\u091c \u0938\u0941\u092c\u0939 \u092f\u0939\u0940 \u0915\u0930 \u0930\u0939\u0947 \u0925\u0947, \u0909\u0928\u092e\u0947\u0902 \u0938\u0947 412 \u0928\u0947 \u0905\u092d\u0940-\u0905\u092d\u0940 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0915\u093e 3-\u0926\u093f\u0928 \u0915\u093e \u092b\u094d\u0930\u0940 \u091f\u094d\u0930\u093e\u092f\u0932 \u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u0936\u093e\u092f\u0926 \u0907\u0938\u0932\u093f\u090f \u0915\u093f \u0909\u0928\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u091a\u0932 \u0917\u092f\u093e \u0915\u093f \u0905\u0938\u0932\u0940 \u091c\u0940\u0924 \u0915\u0939\u093e\u0901 \u091b\u0941\u092a\u0940 \u0939\u0948\u0964"
  ],
