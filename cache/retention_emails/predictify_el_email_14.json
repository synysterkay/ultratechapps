{
  "subject": "30 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03bc\u03b5\u03c4\u03ac \u2014 \u03b5\u03af\u03c3\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03bf\u03bc\u03ac\u03b4\u03b1",
  "preview_text": "\u0394\u03b5\u03bd \u03b5\u03af\u03c3\u03b1\u03b9 \u03b1\u03c0\u03bb\u03cc\u03c2 \u03bf\u03c0\u03b1\u03b4\u03cc\u03c2. \u0395\u03af\u03c3\u03b1\u03b9 \u03bc\u03ad\u03bb\u03bf\u03c2 \u03bc\u03b9\u03b1\u03c2 \u03ba\u03bf\u03b9\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c0\u03bf\u03c5 \u03b1\u03bb\u03bb\u03ac\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9. \u0394\u03b5\u03c2 \u03c4\u03b9 \u03c3\u03bf\u03c5 \u03be\u03ad\u03c6\u03c5\u03b3\u03b5.",
  "body_paragraphs": [
    "\u03a0\u03c1\u03b9\u03bd 30 \u03bc\u03ad\u03c1\u03b5\u03c2, \u03ad\u03ba\u03b1\u03bd\u03b5\u03c2 \u03ba\u03ac\u03c4\u03b9 \u03c0\u03bf\u03c5 \u03bf\u03b9 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03bf\u03b9 \u03b4\u03b5\u03bd \u03c4\u03bf\u03bb\u03bc\u03bf\u03cd\u03bd: \u03c3\u03c4\u03b1\u03bc\u03ac\u03c4\u03b7\u03c3\u03b5\u03c2 \u03bd\u03b1 \u03bc\u03b1\u03bd\u03c4\u03b5\u03cd\u03b5\u03b9\u03c2 \u03ba\u03b1\u03b9 \u03ac\u03c1\u03c7\u03b9\u03c3\u03b5\u03c2 \u03bd\u03b1 \u03be\u03ad\u03c1\u03b5\u03b9\u03c2. \u0391\u03c0\u03cc \u03c4\u03cc\u03c4\u03b5, \u03b5\u03af\u03c3\u03b1\u03b9 \u03bc\u03ad\u03c1\u03bf\u03c2 \u03bc\u03b9\u03b1\u03c2 \u03bf\u03bc\u03ac\u03b4\u03b1\u03c2 \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9 \u03c4\u03bf \u03c0\u03bf\u03b4\u03cc\u03c3\u03c6\u03b1\u03b9\u03c1\u03bf \u03cc\u03c0\u03c9\u03c2 \u03bf\u03b9 \u03ac\u03bb\u03bb\u03bf\u03b9 \u2014 \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9 \u03c4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03c0\u03af\u03c3\u03c9 \u03b1\u03c0\u03cc \u03ba\u03ac\u03b8\u03b5 \u03b3\u03ba\u03bf\u03bb, \u03ba\u03ac\u03b8\u03b5 \u03c0\u03ac\u03c3\u03b1, \u03ba\u03ac\u03b8\u03b5 \u03b1\u03c0\u03cc\u03c6\u03b1\u03c3\u03b7.",
    "\u0394\u03b5\u03bd \u03b5\u03af\u03c3\u03b1\u03b9 \u03bc\u03cc\u03bd\u03bf\u03c2. \u03a7\u03b9\u03bb\u03b9\u03ac\u03b4\u03b5\u03c2 \u03c6\u03af\u03bb\u03b1\u03b8\u03bb\u03bf\u03b9 \u03c3\u03b5 14 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b5\u03c2 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03bf\u03cd\u03bd \u03c4\u03bf Predictify \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b3\u03af\u03bd\u03bf\u03c5\u03bd \u03bf\u03b9 \u03c0\u03b9\u03bf \u03ad\u03be\u03c5\u03c0\u03bd\u03bf\u03b9 \u03c3\u03c4\u03b7\u03bd \u03c0\u03b1\u03c1\u03ad\u03b1 \u03c4\u03bf\u03c5\u03c2. \u0395\u03bd\u03ce \u03bf\u03b9 \u03ac\u03bb\u03bb\u03bf\u03b9 \u03b2\u03b1\u03c3\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf \u03ad\u03bd\u03c3\u03c4\u03b9\u03ba\u03c4\u03bf, \u03b5\u03c3\u03cd \u03ad\u03c7\u03b5\u03b9\u03c2 AI \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b1\u03bb\u03cd\u03b5\u03b9 \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03b5\u03c2 \u03bc\u03b5\u03c4\u03b1\u03b2\u03bb\u03b7\u03c4\u03ad\u03c2 \u03b1\u03bd\u03ac \u03b1\u03b3\u03ce\u03bd\u03b1 \u2014 \u03b1\u03c0\u03cc xG \u03bc\u03ad\u03c7\u03c1\u03b9 \u03b1\u03bc\u03c5\u03bd\u03c4\u03b9\u03ba\u03ae \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03cc head-to-head.",
    "\u0397 \u03ba\u03bf\u03b9\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b6\u03b5\u03b9. \u039a\u03ac\u03b8\u03b5 \u03bc\u03ad\u03c1\u03b1, \u03bf\u03b9 \u03c7\u03c1\u03ae\u03c3\u03c4\u03b5\u03c2 \u03c8\u03b7\u03c6\u03af\u03b6\u03bf\u03c5\u03bd \u03c4\u03bf Prediction of the Day, \u03b1\u03bd\u03b5\u03b2\u03b1\u03af\u03bd\u03bf\u03c5\u03bd \u03c3\u03c4\u03bf leaderboard \u03bc\u03b5 \u03c4\u03bf IQ Quiz, \u03ba\u03b1\u03b9 \u03c3\u03c5\u03b6\u03b7\u03c4\u03bf\u03cd\u03bd \u03c4\u03b1 \u03bc\u03b1\u03c4\u03c2 \u03c3\u03c4\u03b1 Communities. \u03a4\u03bf \u03c0\u03b9\u03bf cool \u03ba\u03bf\u03bc\u03bc\u03ac\u03c4\u03b9; \u039f\u03b9 daily streaks \u03ba\u03b1\u03b9 \u03c4\u03b1 achievements \u2014 \u03c7\u03c4\u03af\u03b6\u03b5\u03b9\u03c2 \u03c4\u03bf \u03c3\u03b5\u03c1\u03af \u03c3\u03bf\u03c5, \u03be\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bd\u03b5\u03b9\u03c2 badges, \u03ba\u03b1\u03b9 \u03bd\u03b9\u03ce\u03b8\u03b5\u03b9\u03c2 \u03cc\u03c4\u03b9 \u03b1\u03bd\u03ae\u03ba\u03b5\u03b9\u03c2 \u03ba\u03ac\u03c0\u03bf\u03c5.",
    "\u0386\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03bf app \u03c4\u03ce\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03b4\u03b5\u03c2 \u03c4\u03bf Prediction of the Day \u03c0\u03bf\u03c5 \u03c8\u03ae\u03c6\u03b9\u03c3\u03b1\u03bd \u03bf\u03b9 \u03c5\u03c0\u03cc\u03bb\u03bf\u03b9\u03c0\u03bf\u03b9. \u039a\u03b1\u03b9 \u03b1\u03bd \u03b8\u03b5\u03c2 \u03bd\u03b1 \u03b4\u03b5\u03b9\u03c2 \u03c4\u03b9 \u03b2\u03bb\u03ad\u03c0\u03bf\u03c5\u03bd \u03bf\u03b9 Premium \u03c7\u03c1\u03ae\u03c3\u03c4\u03b5\u03c2, \u03b4\u03bf\u03ba\u03af\u03bc\u03b1\u03c3\u03b5 \u03c4\u03bf \u03b4\u03c9\u03c1\u03b5\u03ac\u03bd \u03c4\u03c1\u03b9\u03ae\u03bc\u03b5\u03c1\u03bf \u2014 \u03bc\u03cc\u03bd\u03bf 12,99\u20ac/\u03bc\u03ae\u03bd\u03b1 \u03bc\u03b5\u03c4\u03ac. P.S. \u03a4\u03bf \u03c3\u03b5\u03c1\u03af \u03c3\u03bf\u03c5 \u03ba\u03b9\u03bd\u03b4\u03c5\u03bd\u03b5\u03cd\u03b5\u03b9 \u03bd\u03b1 \u03c7\u03b1\u03b8\u03b5\u03af \u2014 \u03bc\u03c0\u03b5\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b1 \u03bc\u03b5\u03c3\u03ac\u03bd\u03c5\u03c7\u03c4\u03b1."
