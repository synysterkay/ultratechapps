  "subject": "48 \u0926\u093f\u0928 \u092c\u093e\u0926 \u092d\u0940 \u0906\u092a\u0915\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u0940 \u0915\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0939\u0948",
  "preview_text": "\u090f\u0915 \u0928\u092f\u093e \u092b\u0940\u091a\u0930 \u091c\u094b \u0906\u092a\u0915\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091f\u0940\u092e \u0915\u0947 \u092e\u0948\u091a \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u092c\u0926\u0932 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0905\u0902\u0926\u0930 \u0926\u0947\u0916\u0947\u0902\u0964",
  "body_paragraphs": [
    "\u092a\u0924\u093e \u0939\u0948, \u091c\u092c \u0906\u092a\u0928\u0947 \u092a\u093f\u091b\u0932\u0940 \u092c\u093e\u0930 Predictify \u0916\u094b\u0932\u093e \u0925\u093e, \u0924\u092c \u0939\u092e\u093e\u0930\u0947 AI \u0928\u0947 78% \u0938\u091f\u0940\u0915\u0924\u093e \u0938\u0947 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u0930 \u0932\u0940\u0917 \u0915\u0947 \u0924\u0940\u0928 \u092c\u0921\u093c\u0947 \u092e\u0948\u091a\u094b\u0902 \u0915\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u0940 \u0915\u0940 \u0925\u0940\u0964 \u0932\u0947\u0915\u093f\u0928 \u0924\u092c \u0938\u0947 \u092c\u0939\u0941\u0924 \u0915\u0941\u091b \u092c\u0926\u0932 \u0917\u092f\u093e \u0939\u0948\u0964 \u0939\u092e\u0928\u0947 \u090f\u0915 \u0910\u0938\u093e \u092b\u0940\u091a\u0930 \u091c\u094b\u0921\u093c\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u092b\u093c\u0941\u091f\u092c\u0949\u0932 \u091c\u094d\u091e\u093e\u0928 \u0915\u094b \u091a\u0941\u0928\u094c\u0924\u0940 \u0926\u0947\u0917\u093e\u2014AI \u091a\u0948\u091f\u0964",
    "\u0905\u092c \u0906\u092a \u0938\u0940\u0927\u0947 AI \u0938\u0947 \u092a\u0942\u091b \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0915\u0932 \u0915\u0947 \u092e\u0948\u091a \u092e\u0947\u0902 \u0915\u093f\u0938 \u091f\u0940\u092e \u0915\u0940 xG \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0939\u0948, \u092f\u093e \u092a\u093f\u091b\u0932\u0947 5 \u092e\u0948\u091a\u094b\u0902 \u092e\u0947\u0902 \u0915\u093f\u0938 \u0916\u093f\u0932\u093e\u0921\u093c\u0940 \u0915\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u093e \u0930\u0939\u093e \u0939\u0948\u0964 \u0939\u092e\u0928\u0947 50 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0932\u0940\u0917\u094b\u0902 \u0915\u0947 \u0921\u0947\u091f\u093e \u0915\u094b \u0905\u092a\u0921\u0947\u091f \u0915\u093f\u092f\u093e \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091f\u0940\u092e \u0915\u093e \u0939\u093e\u0932\u093f\u092f\u093e \u092b\u0949\u0930\u094d\u092e \u092d\u0940 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0964",
    "\u092f\u0939 \u0938\u093f\u0930\u094d\u092b\u093c \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948\u2014\u092f\u0939 \u090f\u0915 \u0928\u092f\u093e \u0924\u0930\u0940\u0915\u093e \u0939\u0948 \u092b\u093c\u0941\u091f\u092c\u0949\u0932 \u0915\u094b \u0938\u092e\u091d\u0928\u0947 \u0915\u093e\u0964 AI \u091a\u0948\u091f \u092e\u0947\u0902 \u091c\u093e\u090f\u0901, \u0905\u092a\u0928\u0940 \u091f\u0940\u092e \u0915\u093e \u0928\u093e\u092e \u091f\u093e\u0907\u092a \u0915\u0930\u0947\u0902, \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0939\u092e\u093e\u0930\u093e AI \u0915\u0948\u0938\u0947 \u0921\u0947\u091f\u093e \u0915\u0947 \u092a\u0940\u091b\u0947 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u092c\u0924\u093e\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b \u0939\u0930 \u092e\u0948\u091a \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0926\u0947\u0917\u093e \u091c\u094b \u092a\u0939\u0932\u0947 \u0928\u0939\u0940\u0902 \u0925\u093e\u0964",
    "\u0924\u094b \u0905\u092c \u0935\u093e\u092a\u0938 \u0906\u0907\u090f \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0915\u094d\u092f\u093e \u092c\u0926\u0932\u093e \u0939\u0948\u0964 \u0905\u092a\u0928\u0947 \u0905\u0915\u093e\u0909\u0902\u091f \u092e\u0947\u0902 \u0932\u0949\u0917 \u0907\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 AI \u091a\u0948\u091f \u0906\u091c\u093c\u092e\u093e\u090f\u0901\u0964 P.S. \u0906\u092a\u0915\u0940 \u092a\u093f\u091b\u0932\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u0940 \u0905\u092c \u092d\u0940 \u0938\u0939\u0947\u091c\u0940 \u0939\u0948\u2014\u0915\u094d\u092f\u093e \u0906\u092a \u0909\u0938\u0947 \u0939\u0930\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0902?"
