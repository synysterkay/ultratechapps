{
  "subject": "\u090f\u0915 \u0917\u0932\u0924\u0940 \u0938\u0941\u0927\u093e\u0930\u0940 \u0917\u0908 \u0939\u0948 \u091c\u094b 90% \u092f\u0942\u091c\u0930\u094d\u0938 \u0928\u0939\u0940\u0902 \u091c\u093e\u0928\u0924\u0947",
  "preview_text": "\u0906\u092a\u0915\u0947 \u092a\u093f\u091b\u0932\u0947 \u0913\u092a\u0928 \u0915\u0947 \u092c\u093e\u0926, \u0910\u092a \u092e\u0947\u0902 \u0915\u0941\u091b \u092c\u0926\u0932 \u0917\u092f\u093e \u0939\u0948\u0964 \u092f\u0939 \u0906\u092a\u0915\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u093f\u092f\u094b\u0902 \u0915\u094b \u0939\u092e\u0947\u0936\u093e \u0915\u0947 \u0932\u093f\u090f \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964",
  "body_paragraphs": [
    "\u0938\u091a \u0915\u0939\u0942\u0902? \u0939\u092e\u0928\u0947 \u090f\u0915 \u091a\u0940\u091c\u093c \u0917\u0932\u0924 \u0938\u092e\u091d\u0940 \u0925\u0940\u0964 \u092e\u0939\u0940\u0928\u094b\u0902 \u0924\u0915 \u0939\u092e\u093e\u0930\u093e AI \u090f\u0915 \u0916\u093e\u0938 \u0921\u0947\u091f\u093e \u092a\u0949\u0907\u0902\u091f \u092e\u093f\u0938 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e - \u0935\u094b \u092d\u0940 \u0910\u0938\u093e \u091c\u094b \u092e\u0948\u091a \u0915\u0947 \u0928\u0924\u0940\u091c\u0947 \u0915\u094b 180 \u0921\u093f\u0917\u094d\u0930\u0940 \u0918\u0941\u092e\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u091c\u092c \u0939\u092e\u0947\u0902 \u092a\u0924\u093e \u091a\u0932\u093e, \u091f\u0940\u092e \u0930\u093e\u0924\u094b\u0902\u0930\u093e\u0924 \u091c\u093e\u0917 \u0917\u0908\u0964",
    "\u0905\u092c \u0935\u094b \u0917\u0932\u0924\u0940 \u0920\u0940\u0915 \u0939\u094b \u091a\u0941\u0915\u0940 \u0939\u0948\u0964 \u0928\u092f\u093e \u0905\u092a\u0921\u0947\u091f \u0932\u093e\u0907\u0935 \u0939\u0948\u0964 \u0914\u0930 \u0907\u0938\u0915\u093e \u092e\u0924\u0932\u092c \u0939\u0948 \u0915\u093f \u0905\u0917\u0932\u0947 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u0930 \u0932\u0940\u0917 \u0935\u0940\u0915\u0947\u0902\u0921 \u0915\u0940 \u0939\u0930 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u0940 \u092a\u0939\u0932\u0947 \u0938\u0947 23% \u091c\u094d\u092f\u093e\u0926\u093e \u090f\u0915\u094d\u092f\u0942\u0930\u0947\u091f \u0939\u094b\u0917\u0940\u0964 \u092f\u0947 \u0935\u094b '\u092e\u093f\u0938\u093f\u0902\u0917 \u0932\u093f\u0902\u0915' \u0925\u093e \u091c\u093f\u0938\u0915\u0940 \u0935\u091c\u0939 \u0938\u0947 \u0915\u092d\u0940-\u0915\u092d\u0940 AI \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0917\u0921\u093c\u092c\u0921\u093c\u093e \u091c\u093e\u0924\u093e \u0925\u093e\u0964 \u0905\u092c \u0928\u0939\u0940\u0902\u0964",
    "\u092f\u0939 \u0938\u092c '\u0921\u0940\u092a \u091f\u0948\u0915\u094d\u091f\u093f\u0915\u0932 \u090f\u0928\u093e\u0932\u093f\u0938\u093f\u0938' \u092b\u0940\u091a\u0930 \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0964 \u0905\u092c \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f, AI \u0928 \u0915\u0947\u0935\u0932 \u0939\u0947\u0921-\u091f\u0942-\u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940 \u0926\u0947\u0916\u0924\u093e \u0939\u0948, \u092c\u0932\u094d\u0915\u093f \u0915\u094b\u091a \u0915\u0947 \u0930\u093f\u092f\u0932-\u091f\u093e\u0907\u092e \u0921\u093f\u0938\u093f\u091c\u0928 \u092a\u0948\u091f\u0930\u094d\u0928 \u092d\u0940 \u090f\u0928\u093e\u0932\u093e\u0907\u091c \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u091c\u0948\u0938\u0947 \u0915\u093f \u092a\u0947\u092a \u0917\u093e\u0930\u094d\u0921\u093f\u092f\u094b\u0932\u093e \u0915\u0947 \u0938\u092c\u094d\u0938\u094d\u091f\u093f\u091f\u094d\u092f\u0942\u0936\u0928 \u091f\u093e\u0907\u092e\u093f\u0902\u0917, \u092f\u093e \u092f\u0941\u0930\u094d\u0917\u0928 \u0915\u094d\u0932\u094b\u092a \u0915\u0940 \u092a\u094d\u0930\u0947\u0936\u0930 \u091f\u094d\u0930\u0948\u092a \u0938\u0947\u091f\u093f\u0902\u0917\u0964 \u092f\u0939 \u0921\u0947\u091f\u093e \u0905\u092c \u0906\u092a\u0915\u0940 \u0909\u0902\u0917\u0932\u093f\u092f\u094b\u0902 \u092a\u0930 \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0915\u0932 \u0915\u0947 \u092e\u0948\u091a\u094b\u0902 \u0915\u0947 \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0926\u0947\u0916\u094b\u0964 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0916\u0941\u0926 \u0905\u0902\u0924\u0930 \u0926\u093f\u0916 \u091c\u093e\u090f\u0917\u093e\u0964 \u092a\u0940.\u090f\u0938. \u092a\u0939\u0932\u0947 48 \u0918\u0902\u091f\u0947 \u092e\u0947\u0902 \u0907\u0938 \u0928\u090f \u0905\u092a\u0921\u0947\u091f \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u094b\u0902 \u0915\u094b \u090f\u0915 \u0938\u094d\u092a\u0947\u0936\u0932 '\u0905\u0930\u094d\u0932\u0940-\u0938\u094d\u092a\u0949\u091f\u0930' \u092c\u0948\u091c \u092e\u093f\u0932\u0947\u0917\u093e\u0964 \u0935\u094b \u092d\u0940 \u092b\u094d\u0930\u0940\u0964"
  ],
