{
  "subject": "10,000 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u093e \u0921\u0947\u091f\u093e \u2014 \u0939\u0948\u0930\u093e\u0928 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u0938\u091a",
  "preview_text": "\u0939\u092e\u0928\u0947 10,000 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0911\u0921\u093f\u092f\u094b \u0921\u0947\u091f\u093e \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u093f\u092f\u093e\u0964 \u090f\u0915 \u091a\u094c\u0902\u0915\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u092c\u093e\u0924 \u0938\u093e\u092e\u0928\u0947 \u0906\u0908 \u091c\u094b \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924 \u092c\u0926\u0932 \u0926\u0947\u0917\u0940\u0964",
  "body_paragraphs": [
    "\u0939\u092e\u0928\u0947 10,000 \u0915\u092e\u094d\u092f\u0942\u091f\u0930\u094d\u0938 \u0915\u093e \u0921\u0947\u091f\u093e \u0926\u0947\u0916\u093e\u0964 \u0928\u0924\u0940\u091c\u093e? 82% \u0932\u094b\u0917 \u0905\u092a\u0928\u0947 \u092b\u093c\u094b\u0928 \u0915\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e 100% \u092a\u0930 \u0930\u0916\u0924\u0947 \u0939\u0948\u0902, \u092b\u093f\u0930 \u092d\u0940 \u0906\u0927\u0940 \u092c\u093e\u0924\u0947\u0902 \u0938\u0941\u0928\u093e\u0908 \u0928\u0939\u0940\u0902 \u0926\u0947\u0924\u0940\u0902\u0964 \u092f\u0939 \u0915\u094b\u0908 \u0905\u0928\u0941\u092e\u093e\u0928 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0905\u0938\u0932\u0940 \u0921\u0947\u091f\u093e \u0939\u0948\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u0938\u092c\u0938\u0947 \u0939\u0948\u0930\u093e\u0928 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0940 \u092c\u093e\u0924 \u092f\u0939 \u0939\u0948 \u0915\u093f \u091c\u093f\u0928 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 Loud EQ \u0915\u093e \u090f\u0915-\u091f\u0948\u092a \u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c \u092b\u093c\u0940\u091a\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e, \u0909\u0928\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u092e\u0947\u0902 200% \u0938\u0941\u0927\u093e\u0930 \u0939\u0941\u0906 \u2014 \u092c\u093f\u0928\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u090f\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b\u093c \u091c\u093c\u094b\u0930 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0938\u093e\u092b\u093c-\u0938\u092b\u093c\u093e\u0908 \u0939\u0948\u0964",
    "\u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u092f\u0939 \u091f\u0942\u0932 \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 '\u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u0906\u092a\u0915\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u092f\u093e \u0938\u094d\u092a\u0940\u0915\u0930 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0916\u0941\u0926 \u0915\u094b \u090f\u0921\u091c\u0938\u094d\u091f \u0915\u0930 \u0932\u0947\u0924\u093e \u0939\u0948\u0964 \u0915\u093f\u0938\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c' \u092c\u091f\u0928 \u0926\u092c\u093e\u090f\u0902\u0964 \u092f\u0939 10 \u0938\u0947\u0915\u0902\u0921 \u0915\u093e \u0915\u093e\u092e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u092c\u0926\u0932 \u091c\u093e\u090f\u0917\u0940\u0964 \u092a\u0940.\u090f\u0938. \u2014 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u0905\u092a\u0928\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u093e '\u0938\u093e\u0909\u0902\u0921 \u0921\u0940\u090f\u0928\u090f' \u092e\u093f\u0932\u0924\u093e \u0939\u0948, \u091c\u094b \u0939\u0930 \u092c\u093e\u0930 \u092a\u0930\u092b\u093c\u0947\u0915\u094d\u091f \u091f\u094d\u092f\u0942\u0928\u093f\u0902\u0917 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"
  ],
