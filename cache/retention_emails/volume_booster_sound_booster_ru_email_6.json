{
  "subject": "\u0421\u0435\u043a\u0440\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0440\u0442\u0438\u0442 \u0437\u0432\u0443\u043a \u0443 90% \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439",
  "preview_text": "\u041e\u0434\u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0432\u0441\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u044e\u0442, \u0438 \u043e\u043d\u0430 \u0441\u0432\u043e\u0434\u0438\u0442 \u043d\u0430 \u043d\u0435\u0442 \u0432\u0435\u0441\u044c \u044d\u0444\u0444\u0435\u043a\u0442 \u043e\u0442 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u044f. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441.",
  "body_paragraphs": [
    "\u041f\u0440\u0438\u0432\u0435\u0442. \u0423 \u043c\u0435\u043d\u044f \u0434\u043b\u044f \u0442\u0435\u0431\u044f \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435. \u042f \u043f\u043e\u0447\u0442\u0438 \u0434\u0432\u0435 \u043d\u0435\u0434\u0435\u043b\u0438 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u043b, \u043a\u0430\u043a \u043b\u044e\u0434\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u043d\u0430\u0448 \u0431\u0443\u0441\u0442\u0435\u0440, \u0438 \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u043e\u0434\u043d\u0443 \u0432\u0435\u0449\u044c, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0432\u043e\u0434\u0438\u0442 \u0438\u0445 \u043d\u0430 \u043d\u0435\u0442. \u041e\u043d\u0438 \u0434\u0435\u043b\u0430\u044e\u0442 \u043e\u0434\u043d\u043e \u0438 \u0442\u043e \u0436\u0435, \u0434\u0443\u043c\u0430\u044f, \u0447\u0442\u043e \u0432\u0441\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e, \u0430 \u043f\u043e\u0442\u043e\u043c \u0436\u0430\u043b\u0443\u044e\u0442\u0441\u044f, \u0447\u0442\u043e '\u0431\u0430\u0441\u0430 \u043d\u0435\u0442' \u0438\u043b\u0438 '\u0437\u0432\u0443\u043a \u043f\u043b\u043e\u0441\u043a\u0438\u0439'. \u0418 \u044f \u043f\u043e\u043d\u044f\u043b, \u0432 \u0447\u0435\u043c \u0434\u0435\u043b\u043e.",
    "\u041f\u043e\u0447\u0442\u0438 \u0432\u0441\u0435 \u0441\u0440\u0430\u0437\u0443 \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0435 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438 \u0438 \u043d\u0430 \u044d\u0442\u043e\u043c \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0442\u0441\u044f. \u042d\u0442\u043e \u043a\u0430\u043a \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0443\u0441\u0438\u043b\u0438\u0442\u0435\u043b\u044c \u043d\u0430 \u043f\u043e\u043b\u043d\u0443\u044e, \u043d\u043e \u0437\u0430\u0431\u044b\u0442\u044c \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0441\u0430\u0431\u0432\u0443\u0444\u0435\u0440. \u0414\u0430, \u0437\u0432\u0443\u043a \u0441\u0442\u0430\u043d\u0435\u0442 \u0433\u0440\u043e\u043c\u0447\u0435, \u043d\u043e \u043e\u043d \u043e\u0441\u0442\u0430\u043d\u0435\u0442\u0441\u044f \u043f\u0443\u0441\u0442\u044b\u043c \u0438 \u0431\u0435\u0437\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u043c. \u0422\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u0443\u0434\u0435\u0448\u044c \u0441\u043b\u0443\u0448\u0430\u0442\u044c \u0433\u0440\u043e\u043c\u043a\u0438\u0439, \u043d\u043e \u043f\u043b\u043e\u0441\u043a\u0438\u0439 \u0437\u0432\u0443\u043a. \u0412\u0435\u0441\u044c \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0443\u0445\u043e\u0434\u0438\u0442 \u0432 \u043d\u0438\u043a\u0443\u0434\u0430. \u0410 \u0444\u0438\u043a\u0441 \u0434\u043e \u0441\u043c\u0435\u0448\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u043e\u0439.",
    "\u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c. \u042d\u0442\u043e \u043f\u0440\u043e \u0433\u043b\u0443\u0431\u0438\u043d\u0443. \u0421\u0435\u043a\u0440\u0435\u0442 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0441\u043b\u0435 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u044f \u041e\u0411\u042f\u0417\u0410\u0422\u0415\u041b\u042c\u041d\u041e \u0437\u0430\u0439\u0442\u0438 \u0432 \u0440\u0430\u0437\u0434\u0435\u043b '\u042d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440' \u0438 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u0442\u044c '\u0411\u0430\u0441\u043e\u0432\u044b\u0439 \u0431\u0443\u0441\u0442\u0435\u0440' \u0438\u043b\u0438 \u0432\u044b\u0431\u0440\u0430\u0442\u044c \u043e\u0434\u0438\u043d \u0438\u0437 \u043f\u0440\u0435\u0441\u0435\u0442\u043e\u0432, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, '\u042d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u0438\u043a\u0430' \u0438\u043b\u0438 '\u0425\u0438\u043f-\u0445\u043e\u043f'. \u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u0431\u0430\u0441. \u042d\u0442\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u0432\u0442\u043e\u0440\u043e\u0439, \u0441\u043a\u0440\u044b\u0442\u044b\u0439 \u0441\u043b\u043e\u0439 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0437\u0432\u0443\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0435\u0433\u043e \u0442\u0435\u043b\u043e\u043c \u0438 \u043c\u043e\u0449\u044c\u044e. \u0411\u0435\u0437 \u044d\u0442\u043e\u0433\u043e \u0442\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0448\u044c \u043b\u0438\u0448\u044c 30% \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0435\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u0412\u043a\u043b\u044e\u0447\u0438 \u043b\u044e\u0431\u0438\u043c\u044b\u0439 \u0442\u0440\u0435\u043a, \u043f\u043e\u0434\u043d\u0438\u043c\u0438 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c, \u0430 \u043f\u043e\u0442\u043e\u043c \u0441\u0440\u0430\u0437\u0443 \u043f\u0435\u0440\u0435\u0439\u0434\u0438 \u0432 \u042d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u0438 \u0432\u044b\u0431\u0435\u0440\u0438 '\u0411\u0430\u0441\u043e\u0432\u044b\u0439 \u0431\u0443\u0441\u0442\u0435\u0440'. \u0420\u0430\u0437\u043d\u0438\u0446\u0430 \u0431\u0443\u0434\u0435\u0442 \u043a\u0430\u043a \u043c\u0435\u0436\u0434\u0443 \u0441\u043b\u0443\u0448\u0430\u0442\u044c \u043c\u0443\u0437\u044b\u043a\u0443 \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0435\u0435 \u043a\u043e\u0436\u0435\u0439. \u0421\u0434\u0435\u043b\u0430\u0439 \u044d\u0442\u043e \u0432 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 5 \u043c\u0438\u043d\u0443\u0442, \u043f\u043e\u043a\u0430 \u043d\u0435 \u0437\u0430\u0431\u044b\u043b. P.S. \u0418\u043c\u0435\u043d\u043d\u043e \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0443 \u043d\u0430\u0441 \u0435\u0441\u0442\u044c \u043f\u0440\u043e\u0431\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434 Premium \u2014 \u0447\u0442\u043e\u0431\u044b \u0442\u044b \u043c\u043e\u0433 \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u044d\u0442\u043e\u0442 \u0431\u0430\u0441 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440\u0430 \u043f\u043e\u0434 \u0441\u0432\u043e\u0439 \u0432\u043a\u0443\u0441, \u0430 \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0448\u0430\u0431\u043b\u043e\u043d\u044b. \u041d\u043e \u0434\u0430\u0436\u0435 \u0448\u0430\u0431\u043b\u043e\u043d\u043d\u044b\u0439 \u0431\u0430\u0441\u043e\u0432\u044b\u0439 \u0431\u0443\u0441\u0442\u0435\u0440 \u0438\u0437\u043c\u0435\u043d\u0438\u0442 \u0432\u0441\u0451."
  ],
  "cta_text": "\u0412\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0411\u0430\u0441\u043e\u0432\u044b\u0439 \u0431\u0443\u0441\u0442\u0435\u0440 \u0441\u0435\u0439\u0447\u0430\u0441",
