{
  "subject": "28 \u0434\u043d\u0435\u0439 \u2014 200% \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438",
  "preview_text": "\u0422\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0448\u044c Volume Booster \u0443\u0436\u0435 \u043c\u0435\u0441\u044f\u0446. \u0412\u043e\u0442 \u0447\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e\u0441\u044c \u0432 \u0442\u0432\u043e\u0435\u043c \u0437\u0432\u0443\u043a\u0435.",
  "body_paragraphs": [
    "\u041f\u0440\u043e\u0448\u043b\u043e 28 \u0434\u043d\u0435\u0439. \u041c\u0435\u0441\u044f\u0446 \u043d\u0430\u0437\u0430\u0434 \u0442\u044b \u0441\u043a\u0430\u0447\u0430\u043b Volume Booster, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u043a\u043e\u043d\u0435\u0446-\u0442\u043e \u0443\u0441\u043b\u044b\u0448\u0430\u0442\u044c \u043c\u0443\u0437\u044b\u043a\u0443 \u0442\u0430\u043a, \u043a\u0430\u043a \u0437\u0430\u0434\u0443\u043c\u0430\u043d\u043e. \u0418 \u0437\u043d\u0430\u0435\u0448\u044c \u0447\u0442\u043e? \u0422\u044b \u0443\u0436\u0435 \u0441\u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e \u2014 \u0442\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0437\u0432\u0443\u0447\u0438\u0442 \u0433\u0440\u043e\u043c\u0447\u0435, \u0447\u0435\u043c \u043a\u043e\u0433\u0434\u0430-\u043b\u0438\u0431\u043e. \u041d\u043e \u0435\u0441\u0442\u044c \u043e\u0434\u043d\u0430 \u0432\u0435\u0449\u044c, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0442\u044b \u0435\u0449\u0435 \u043d\u0435 \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u043b, \u0438 \u043e\u043d\u0430 \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0435\u0442 \u0442\u0432\u043e\u0439 \u043e\u043f\u044b\u0442.",
    "\u0422\u044b \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u043b \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c, \u043d\u043e \u0441\u043b\u044b\u0448\u0430\u043b \u043b\u0438 \u0442\u044b \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u0431\u0430\u0441? \u0412\u043a\u043b\u044e\u0447\u0438 \u043b\u044e\u0431\u043e\u0439 \u0442\u0440\u0435\u043a \u0441 \u0442\u044f\u0436\u0435\u043b\u044b\u043c \u0440\u0438\u0442\u043c\u043e\u043c \u2014 \u043e\u0442 \u0440\u043e\u043a\u0430 \u0434\u043e \u0445\u0438\u043f-\u0445\u043e\u043f\u0430 \u2014 \u0438 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0439 \u0440\u0430\u0437\u043d\u0438\u0446\u0443. \u0411\u0435\u0437 \u0431\u0430\u0441-\u0431\u0443\u0441\u0442\u0435\u0440\u0430 \u0437\u0432\u0443\u043a \u043f\u043b\u043e\u0441\u043a\u0438\u0439, \u043a\u0430\u043a \u043b\u0438\u0441\u0442 \u0431\u0443\u043c\u0430\u0433\u0438. \u0421 \u043d\u0438\u043c \u2014 \u044d\u0442\u043e \u043a\u0430\u043a \u0431\u044b\u0442\u044c \u0432 \u043a\u043b\u0443\u0431\u0435, \u043a\u043e\u0433\u0434\u0430 \u043a\u043e\u043b\u043e\u043d\u043a\u0438 \u0434\u0440\u043e\u0436\u0430\u0442 \u043e\u0442 \u044d\u043d\u0435\u0440\u0433\u0438\u0438.",
    "\u041d\u0430\u0448\u0438 \u0442\u0435\u0441\u0442\u044b \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442: \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u0445\u043e\u0442\u044f \u0431\u044b \u0440\u0430\u0437, \u043d\u0435 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u044e\u0442\u0441\u044f \u043a \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u043c\u0443 \u0437\u0432\u0443\u043a\u0443. \u0422\u044b \u0443\u0436\u0435 \u043f\u0440\u043e\u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e\u0442 \u043f\u0443\u0442\u044c \u2014 \u043d\u0435 \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0439\u0441\u044f. \u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u0432\u044b\u0431\u0435\u0440\u0438 \u043f\u0440\u0435\u0441\u0435\u0442 'Rock' \u0438\u043b\u0438 'Electronic' \u2014 \u0438 \u0442\u0432\u043e\u0439 \u043f\u043b\u0435\u0439\u043b\u0438\u0441\u0442 \u0437\u0430\u0438\u0433\u0440\u0430\u0435\u0442 \u043f\u043e-\u043d\u043e\u0432\u043e\u043c\u0443. \u042d\u0442\u043e \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e \u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 10 \u0441\u0435\u043a\u0443\u043d\u0434.",
    "\u0421\u0434\u0435\u043b\u0430\u0439 \u044d\u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441: \u043e\u0442\u043a\u0440\u043e\u0439 Volume Booster, \u043d\u0430\u0436\u043c\u0438 \u043d\u0430 \u0438\u043a\u043e\u043d\u043a\u0443 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440\u0430 \u0438 \u0432\u044b\u0431\u0435\u0440\u0438 'Bass Booster'. \u041f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439. P.S. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u0431\u0435\u0437\u043b\u0438\u043c\u0438\u0442\u043d\u044b\u0435 \u0443\u0440\u043e\u0432\u043d\u0438 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u044f \u0438 \u043f\u043e\u043b\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u043d\u0430\u0434 \u0447\u0430\u0441\u0442\u043e\u0442\u0430\u043c\u0438 \u2014 \u0432 Premium \u0435\u0441\u0442\u044c \u0432\u0441\u0435. \u041d\u043e \u043d\u0430\u0447\u0430\u0442\u044c \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0433\u043e\u0434\u043d\u044f."
  ],
