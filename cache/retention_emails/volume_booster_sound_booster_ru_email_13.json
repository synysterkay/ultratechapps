{
  "subject": "\u0421\u0435\u043a\u0440\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 90% \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0443\u043f\u0443\u0441\u043a\u0430\u044e\u0442 \u0447\u0435\u0440\u0435\u0437 \u043c\u0435\u0441\u044f\u0446",
  "preview_text": "\u0412\u044b \u0443\u0436\u0435 28 \u0434\u043d\u0435\u0439 \u0441 \u043d\u0430\u043c\u0438. \u0412\u043e\u0442 \u0447\u0442\u043e \u0432\u044b \u0443\u043f\u0443\u0441\u043a\u0430\u0435\u0442\u0435, \u0435\u0441\u043b\u0438 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043d\u0435 \u043d\u0430\u0436\u0430\u043b\u0438 \u044d\u0442\u0443 \u043a\u043d\u043e\u043f\u043a\u0443.",
  "body_paragraphs": [
    "\u041f\u0440\u0438\u0432\u0435\u0442. \u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0435 \u043f\u0438\u0441\u044c\u043c\u043e. \u042d\u0442\u043e \u0447\u0435\u043a-\u0438\u043d \u0447\u0435\u0440\u0435\u0437 \u043c\u0435\u0441\u044f\u0446. 28 \u0434\u043d\u0435\u0439 \u043d\u0430\u0437\u0430\u0434 \u0432\u044b \u0441\u043a\u0430\u0447\u0430\u043b\u0438 Volume Booster, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u043a\u043e\u043d\u0435\u0446-\u0442\u043e \u0441\u043b\u044b\u0448\u0430\u0442\u044c \u043c\u0443\u0437\u044b\u043a\u0443, \u0430 \u043d\u0435 \u0448\u0443\u043c. \u0418 \u0437\u043d\u0430\u0435\u0442\u0435 \u0447\u0442\u043e? \u0412\u044b \u0443\u0436\u0435 \u043f\u0440\u043e\u0448\u043b\u0438 \u043f\u0443\u0442\u044c \u043e\u0442 '\u0442\u0438\u0445\u043e' \u0434\u043e '\u0433\u043e\u0440\u0430\u0437\u0434\u043e \u043b\u0443\u0447\u0448\u0435'. \u041d\u043e \u0435\u0441\u0442\u044c \u043e\u0434\u043d\u0430 \u0432\u0435\u0449\u044c, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u044e\u0442 \u043d\u0430 \u044d\u0442\u043e\u043c \u044d\u0442\u0430\u043f\u0435.",
    "\u0417\u0430 \u044d\u0442\u043e\u0442 \u043c\u0435\u0441\u044f\u0446 \u0432\u044b, \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u0443\u0436\u0435 \u0443\u0441\u043f\u0435\u043b\u0438 \u0443\u0441\u0438\u043b\u0438\u0442\u044c \u0437\u0432\u0443\u043a \u0432 \u0441\u043e\u0442\u043d\u044f\u0445 \u0442\u0440\u0435\u043a\u043e\u0432 \u0438\u043b\u0438 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432 \u043f\u043e\u0434\u043a\u0430\u0441\u0442\u043e\u0432. \u041a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0437, \u043a\u043e\u0433\u0434\u0430 \u0432\u044b \u043d\u0430\u0436\u0438\u043c\u0430\u043b\u0438 \u043a\u043d\u043e\u043f\u043a\u0443 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u044f, \u0432\u044b \u0434\u0435\u043b\u0430\u043b\u0438 \u0432\u044b\u0431\u043e\u0440 \u0432 \u043f\u043e\u043b\u044c\u0437\u0443 \u0447\u0438\u0441\u0442\u043e\u0433\u043e, \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0433\u043e \u0437\u0432\u0443\u043a\u0430. \u042d\u0442\u043e \u0443\u0436\u0435 \u0441\u0442\u0430\u043b\u043e \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u043e\u0439. \u041d\u043e \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 \u2014 \u044d\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0431\u0430\u0437\u0430. \u0421\u0435\u0439\u0447\u0430\u0441 \u0441\u0430\u043c\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u0435\u0451 \u0432 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e. \u041f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0430\u044f \u043c\u0430\u0433\u0438\u044f \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u043d\u0435 \u0441 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438, \u0430 \u0441 \u0434\u0435\u0442\u0430\u043b\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0432\u0441\u0451 \u0435\u0449\u0451 \u043d\u0435 \u0441\u043b\u044b\u0448\u0438\u0442\u0435.",
    "\u0412\u0441\u0451 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u0436\u0434\u0430\u043b \u0432\u0430\u0448 \u043b\u0438\u0447\u043d\u044b\u0439 \u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u0438\u043d\u0436\u0435\u043d\u0435\u0440 \u2014 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u0441 \u043f\u0440\u0435\u0441\u0435\u0442\u0430\u043c\u0438. \u041d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e '\u0433\u0440\u043e\u043c\u0447\u0435', \u0430 '\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0435\u0435 \u0434\u043b\u044f \u0434\u0436\u0430\u0437\u0430', '\u043c\u043e\u0449\u043d\u0435\u0435 \u0434\u043b\u044f \u0440\u043e\u043a\u0430', '\u0447\u0438\u0449\u0435 \u0434\u043b\u044f \u043f\u043e\u0434\u043a\u0430\u0441\u0442\u0430'. \u0412\u044b \u0441\u043b\u0443\u0448\u0430\u043b\u0438 \u043c\u0443\u0437\u044b\u043a\u0443, \u043d\u043e \u043d\u0435 \u0441\u043b\u044b\u0448\u0430\u043b\u0438 \u0435\u0451 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e, \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u043e\u0433\u043b\u0438 \u0431\u044b. Bass Booster \u0438 Loudness Enhancer \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0444\u0443\u043d\u043a\u0446\u0438\u0438. \u042d\u0442\u043e \u043a\u043b\u044e\u0447\u0438 \u043a \u0437\u0432\u0443\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0441\u044f, \u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u0443\u0448\u0430\u043c\u0438.",
    "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041d\u0435 \u0434\u043b\u044f \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0441\u0438\u043b\u0438\u0442\u044c \u0437\u0432\u0443\u043a. \u0410 \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0439\u0442\u0438 \u0432 \u0440\u0430\u0437\u0434\u0435\u043b '\u042d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440', \u0432\u044b\u0431\u0440\u0430\u0442\u044c \u043f\u0440\u0435\u0441\u0435\u0442 \u043f\u043e\u0434 \u0442\u043e, \u0447\u0442\u043e \u0441\u043b\u0443\u0448\u0430\u0435\u0442\u0435 \u0421\u0415\u0419\u0427\u0410\u0421, \u0438 \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c Bass Booster. \u0421\u0440\u0430\u0432\u043d\u0438\u0442\u0435. \u042d\u0442\u043e \u0437\u0430\u0439\u043c\u0451\u0442 30 \u0441\u0435\u043a\u0443\u043d\u0434. \u0418 \u0432\u044b \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0432\u0435\u0440\u043d\u0451\u0442\u0435\u0441\u044c \u043a '\u043f\u0440\u043e\u0441\u0442\u043e \u0433\u0440\u043e\u043c\u043a\u043e'. P.S. \u0418\u043c\u0435\u043d\u043d\u043e \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u0448\u0430\u0433\u0430 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442, \u0437\u0430\u0447\u0435\u043c \u0438\u043c Premium \u2014 \u043d\u0435\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0435 \u0443\u0440\u043e\u0432\u043d\u0438 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u044f \u0438 \u043f\u043e\u043b\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u043d\u0430\u0434 \u0437\u0432\u0443\u043a\u043e\u043c. \u041d\u043e \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0440\u0430\u0437\u043d\u0438\u0446\u0443.",
    "P.S. \u0421\u0430\u043c\u044b\u0435 \u043f\u0440\u0435\u0434\u0430\u043d\u043d\u044b\u0435 \u043d\u0430\u0448\u0438 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u2014 \u0442\u0435, \u043a\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e \u0432 \u043f\u0435\u0440\u0432\u044b\u0439 \u043c\u0435\u0441\u044f\u0446. \u041e\u043d\u0438 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043b\u0443\u0448\u0430\u044e\u0442 \u043c\u0443\u0437\u044b\u043a\u0443. \u041e\u043d\u0438 \u0435\u0451 \u043f\u0440\u043e\u0436\u0438\u0432\u0430\u044e\u0442. \u0412\u044b \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439?"
  ],
  "cta_text": "\u041d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0437\u0432\u0443\u043a \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438",
