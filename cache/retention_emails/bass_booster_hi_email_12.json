{
  "subject": "\u0935\u094b 2 \u092c\u091c\u0947 \u0930\u093e\u0924 \u0915\u093e \u090f\u0915\u094d\u0938\u092a\u0947\u0930\u093f\u092e\u0947\u0902\u091f \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u090f\u0915 \u092f\u0942\u091c\u0930 \u0928\u0947 \u0930\u093e\u0924 2 \u092c\u091c\u0947 Bass Booster \u092e\u0947\u0902 \u0915\u0941\u091b \u091f\u094d\u0930\u093e\u092f \u0915\u093f\u092f\u093e - \u0914\u0930 \u092b\u093f\u0930 \u0915\u092d\u0940 \u092a\u0941\u0930\u093e\u0928\u0947 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092a\u0930 \u0935\u093e\u092a\u0938 \u0928\u0939\u0940\u0902 \u0917\u092f\u093e\u0964 \u0935\u094b \u092b\u0940\u091a\u0930 \u091c\u094b \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u0925\u093e\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u090f\u0915 \u0932\u0921\u093c\u0915\u093e \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u092a\u0930 \u092c\u0948\u0920\u093e \u0925\u093e\u0964 \u0909\u0938\u0915\u093e \u0917\u093e\u0928\u093e \u092c\u091c \u0930\u0939\u093e \u0925\u093e - \u0932\u0947\u0915\u093f\u0928 \u0915\u0941\u091b \u0915\u092e\u0940 \u0925\u0940\u0964 \u092c\u093e\u0938 \u0928\u0939\u0940\u0902 \u0906 \u0930\u0939\u093e \u0925\u093e\u0964 \u0909\u0938\u0928\u0947 Bass Booster \u0916\u094b\u0932\u093e, \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0914\u0930 \u0926\u0947\u0916\u0928\u0947 \u0915\u094b\u0964",
    "\u0909\u0938\u0928\u0947 Bass Virtualizer \u0915\u094b \u0911\u0928 \u0915\u093f\u092f\u093e, \u0914\u0930 3D Surround \u0915\u094b \u092d\u0940\u0964 \u092b\u093f\u0930 \u0909\u0938\u0928\u0947 Boost \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b 80% \u0924\u0915 \u0916\u0940\u0902\u091a\u093e\u0964 \u0905\u091a\u093e\u0928\u0915, \u0909\u0938\u0915\u0947 \u0938\u0938\u094d\u0924\u0947 earbuds \u092e\u0947\u0902 \u092d\u0940 \u0935\u094b \u0921\u094d\u0930\u0949\u092a \u0906 \u0917\u092f\u093e \u091c\u094b \u0938\u0940\u0928\u0947 \u092e\u0947\u0902 \u0917\u0942\u0902\u091c\u0924\u093e \u0939\u0948\u0964 \u0909\u0938\u0928\u0947 \u092e\u0941\u091d\u0947 \u0932\u093f\u0916\u093e - '\u092f\u093e\u0930, \u092f\u0947 \u0924\u094b \u092e\u0948\u0902 \u092a\u0939\u0932\u0947 \u0915\u094d\u092f\u094b\u0902 \u0928\u0939\u0940\u0902 \u0915\u0930 \u092a\u093e\u092f\u093e?'",
    "\u092f\u0947 \u092b\u0940\u091a\u0930 \u0939\u0948 Bass Virtualizer + 3D Surround \u0915\u093e \u0915\u0949\u092e\u094d\u092c\u094b\u0964 Bass Booster \u092e\u0947\u0902 \u092f\u0947 \u092c\u093f\u0932\u094d\u091f-\u0907\u0928 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0907\u0938\u0947 \u091b\u0942\u0924\u0947 \u092d\u0940 \u0928\u0939\u0940\u0902\u0964 \u0924\u0941\u092e \u0905\u0917\u0930 Hip-Hop \u092f\u093e EDM \u0938\u0941\u0928\u0924\u0947 \u0939\u094b, \u0924\u094b \u092f\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0907\u0938\u0947 \u0911\u0928 \u0915\u0930\u094b, \u0914\u0930 \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091f\u094d\u0930\u0948\u0915 \u092a\u0930 \u0938\u0941\u0928\u094b\u0964 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0932\u0917\u0947\u0917\u093e \u091c\u0948\u0938\u0947 \u0924\u0941\u092e \u0915\u094d\u0932\u092c \u092e\u0947\u0902 \u0939\u094b\u0964",
    "\u0905\u092c Bass Booster \u0916\u094b\u0932\u094b\u0964 Bass Virtualizer \u0914\u0930 3D Surround \u0915\u094b \u0911\u0928 \u0915\u0930\u094b\u0964 \u092b\u093f\u0930 Boost \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b 70-80% \u0924\u0915 \u0916\u0940\u0902\u091a\u094b\u0964 \u0914\u0930 \u0938\u0941\u0928\u094b\u0964 P.S. - Premium \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092f\u0947 \u092b\u0940\u091a\u0930 \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u0939\u0948\u0964 \u092b\u094d\u0930\u0940 \u092e\u0947\u0902 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092c\u093e\u0930 \u091f\u094d\u0930\u093e\u092f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964"
  ],
