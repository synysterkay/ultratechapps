{
  "subject": "\ub0b4\uac00 \uc0c8\ubcbd 2\uc2dc\uc5d0 \uc774 \uae30\ub2a5\uc744 \ub9cc\ub4e0 \uc9c4\uc9dc \uc774\uc720",
  "preview_text": "\ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc740 \ubaa8\ub974\ub294 \uc228\uaca8\uc9c4 \uc774\uc57c\uae30. \uc774\uac78 \uc54c\uba74 \uc571\uc774 \uc644\uc804\ud788 \ub2e4\ub974\uac8c \ubcf4\uc77c \uac70\uc608\uc694.",
  "body_paragraphs": [
    "\uc0c8\ubcbd 2\uc2dc, \ucee4\ud53c \ud55c \uc794\uacfc \ud568\uaed8 \uc2dc\uc791\ud55c \ucf54\ub529. \ub2f9\uc2dc\uc5d0\ub294 \uadf8\ub0e5 '\uc7ac\ubbf8\ub85c' \ub9cc\ub4e0 \uae30\ub2a5\uc774\uc5c8\uc5b4\uc694. \uadf8\ub7f0\ub370 \uc774\uac8c \ub098\uc911\uc5d0 \uc218\ucc9c \uba85\uc758 \uc0ac\uc6a9\uc790\uc5d0\uac8c \uac00\uc7a5 \uc0ac\ub791\ubc1b\ub294 \uae30\ub2a5\uc774 \ub420 \uc904\uc740 \uafc8\uc5d0\ub3c4 \ubab0\ub790\uc8e0.",
    "\uc0ac\uc2e4, \ucc98\uc74c\uc5d0\ub294 \ub2e8\uc21c\ud55c \ud1b5\uacc4 \ubd84\uc11d \ub3c4\uad6c\ub97c \ub9cc\ub4e4\uace0 \uc2f6\uc5c8\uc5b4\uc694. \uadf8\ub7f0\ub370 \uc5b4\ub290 \uc21c\uac04 '\uc774 \ub370\uc774\ud130\ub85c \uc0ac\uc6a9\uc790\ub4e4\uc774 \uc2e4\uc81c\ub85c \ubb34\uc5b8\uac00\ub97c \ubc30\uc6b8 \uc218 \uc788\ub2e4\uba74?'\uc774\ub77c\ub294 \uc0dd\uac01\uc774 \ub4e4\uc5c8\uc8e0. \uadf8\ub798\uc11c \ubc24\uc0c8 \uba38\ub9ac\ub97c \uc2f8\ub9e4\uace0 \ub9cc\ub4e0 \uac8c \ubc14\ub85c IQ \ud034\uc988\uc785\ub2c8\ub2e4. \ub2e8\uc21c\ud55c \uc608\uce21\uc774 \uc544\ub2c8\ub77c, \ucd95\uad6c \uc9c0\uc2dd\uc744 \uc9c4\uc9dc\ub85c \ud14c\uc2a4\ud2b8\ud558\uace0 \ube44\uad50\ud560 \uc218 \uc788\ub294 \uacf5\uac04\uc744 \ub9cc\ub4e4\uace0 \uc2f6\uc5c8\uc5b4\uc694.",
    "\uc774 \ud034\uc988\ub294 AI\uac00 \uc0dd\uc131\ud55c \ubb38\uc81c\ub85c, \ub9e4 \uacbd\uae30 \uc804\ud6c4\ub85c \uc5c5\ub370\uc774\ud2b8\ub429\ub2c8\ub2e4. \ub9ac\uadf8 \uc21c\uc704, \uc120\uc218 \uae30\ub85d, \uc804\uc220\uc801 \uacb0\uc815\uae4c\uc9c0 \u2014 \ubaa8\ub4e0 \uac83\uc774 \ub370\uc774\ud130 \uae30\ubc18\uc774\uc5d0\uc694. \ub2f9\uc2e0\uc774 '\ucd95\uad6c \ucc9c\uc7ac'\uc778\uc9c0 \ud655\uc778\ud558\uace0 \uc2f6\ub2e4\uba74, \uc9c0\uae08 \uc571\uc5d0\uc11c 'IQ \ud034\uc988'\ub97c \uc5f4\uc5b4\ubcf4\uc138\uc694. \ub7ad\ud0b9\uc5d0\uc11c \uc0c1\uc704 10% \uc548\uc5d0 \ub4e4\uba74 \ud2b9\ubcc4 \ubc30\uc9c0\ub3c4 \ubc1b\uc744 \uc218 \uc788\uc5b4\uc694.",
    "\uc624\ub298 \ubc14\ub85c \uc571\uc744 \uc5f4\uace0 IQ \ud034\uc988\uc5d0 \ub3c4\uc804\ud574\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc758 \ucd95\uad6c \uc9c0\uc2dd\uc774 \uc5bc\ub9c8\ub098 \uae4a\uc740\uc9c0 \uc54c\uac8c \ub420 \uac70\uc608\uc694. P.S. \uac00\uc7a5 \ub192\uc740 \uc810\uc218\ub97c \uae30\ub85d\ud55c \uc0ac\uc6a9\uc790\uc5d0\uac8c\ub294 \ub2e4\uc74c \uc8fc \ud504\ub9ac\ubbf8\uc5c4 \ubb34\ub8cc \uc774\uc6a9\uad8c\uc744 \ub4dc\ub9bd\ub2c8\ub2e4. \uae30\ud68c\ub97c \ub193\uce58\uc9c0 \ub9c8\uc138\uc694."
  ],
