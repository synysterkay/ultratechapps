{
  "subject": "28 \u0926\u093f\u0928, 200% \u092c\u0942\u0938\u094d\u091f \u2014 \u0906\u092a\u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e",
  "preview_text": "\u090f\u0915 \u092e\u0939\u0940\u0928\u0947 \u092e\u0947\u0902 \u0906\u092a\u0928\u0947 \u0915\u093f\u0924\u0928\u0940 \u092c\u093e\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u092f\u093e? \u092f\u0939\u093e\u0901 \u0906\u092a\u0915\u0940 \u0909\u092a\u0932\u092c\u094d\u0927\u093f \u0939\u0948\u0964",
  "body_paragraphs": [
    "28 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0906\u092a\u0928\u0947 Volume Booster Pro \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u0924\u092c \u0938\u0947 \u0906\u092a\u0928\u0947 \u0936\u093e\u092f\u0926 200% \u092c\u0942\u0938\u094d\u091f \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e \u0939\u0948 \u2014 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u092e \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0924\u093e \u0925\u093e, \u092f\u093e \u0917\u093e\u0928\u0947 \u092e\u0947\u0902 \u092c\u093e\u0938 \u0915\u092e \u0932\u0917\u0924\u093e \u0925\u093e\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948; \u092f\u0939 \u0906\u092a\u0915\u0940 \u0930\u094b\u091c\u093c \u0915\u0940 \u0906\u0926\u0924 \u0939\u0948\u0964",
    "\u0939\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0939\u0948 \u0915\u093f \u091c\u094b \u0932\u094b\u0917 \u090f\u0915 \u092e\u0939\u0940\u0928\u0947 \u0924\u0915 \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0914\u0938\u0924\u0928 40 \u092c\u093e\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0928\u0947 \u0909\u0938\u0938\u0947 \u092d\u0940 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0915\u093f\u092f\u093e \u0939\u094b\u0917\u093e\u0964 \u0915\u094b\u0908 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0928\u0939\u0940\u0902 \u2014 \u092c\u0938 \u0935\u0939 \u092c\u0942\u0938\u094d\u091f \u091c\u094b \u0906\u092a \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902, \u091c\u092c \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939\u0940 \u0939\u092e\u093e\u0930\u093e \u0935\u093e\u0926\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0905\u0917\u0932\u0940 \u091a\u0940\u091c\u093c \u0906\u091c\u093c\u092e\u093e\u090f\u0902: '\u0911\u091f\u094b-\u0905\u092a\u094d\u0932\u093e\u0908' \u092b\u0940\u091a\u0930\u0964 \u091c\u092c \u092d\u0940 \u0906\u092a \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902, \u0910\u092a \u0905\u092a\u0928\u0947 \u0906\u092a \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u0938\u0947\u091f\u093f\u0902\u0917 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u091d\u0902\u091d\u091f \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u092a\u094d\u0932\u0917 \u0907\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0938\u0941\u0928\u0947\u0902\u0964 \u092f\u0939 \u0909\u0928 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948 \u091c\u094b \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0938\u092c \u0915\u0941\u091b \u091a\u0941\u092a\u091a\u093e\u092a \u0915\u093e\u092e \u0915\u0930\u0947\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0911\u091f\u094b-\u0905\u092a\u094d\u0932\u093e\u0908' \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u0906\u092a\u0915\u0940 28-\u0926\u093f\u0928 \u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u093e \u0905\u0917\u0932\u093e \u0915\u0926\u092e \u0939\u0948\u0964 P.S. \u2014 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0935\u0930\u094d\u091c\u0928 \u092e\u0947\u0902 \u0906\u092a\u0915\u094b EQ \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u092e\u093f\u0932\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u0939\u0930 \u0938\u094d\u0930\u094b\u0924 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917-\u0905\u0932\u0917 \u0938\u0947\u091f \u0939\u094b \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0926\u0947\u0916\u0947\u0902, \u0936\u093e\u092f\u0926 \u092f\u0939 \u0906\u092a\u0915\u093e \u0928\u092f\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0939\u094b\u0964"
  ],
