  "subject": "\ub2f9\uc2e0\uc774 \ucc29\uac01\ud558\uace0 \uc788\ub294 '\uc9c4\uc9dc \uc5f0\uc560'\uc758 \ube44\ubc00",
  "preview_text": "\ubaa8\ub450\uac00 '\uc9c4\uc9dc \uc5f0\uc560'\ub294 \ud798\ub4e4\ub2e4\uace0 \ub9d0\ud558\uc9c0\ub9cc, \uc0ac\uc2e4 \uc9c4\uc9dc\ub294 \ub2e4\ub985\ub2c8\ub2e4. \uc99d\uac70\ub97c \ubcf4\uc5ec\ub4dc\ub9bd\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\ub2f9\uc2e0\uc740 '\uc9c4\uc9dc \uc5f0\uc560'\uac00 \ud798\ub4e4\uace0 \ubcf5\uc7a1\ud558\ub2e4\uace0 \uc0dd\uac01\ud558\ub098\uc694? \uc0ac\ub78c\ub4e4\uc740 \ud56d\uc0c1 \uc0c1\ub300\ubc29\uc744 \uc774\ud574\ud558\uace0, \uae30\uc5b5\ud558\uace0, \uae30\ub2e4\ub9ac\ub294 \uac8c \uc0ac\ub791\uc758 \uc99d\uac70\ub77c\uace0 \ub9d0\ud558\uc8e0. \ud558\uc9c0\ub9cc \uc81c\uac00 2\ub144 \ub3d9\uc548 \ub9cc\ub4e0 \uc571 \ub370\uc774\ud130\ub97c \ubcf4\uba74, \uc9c4\uc9dc \uc5f0\uc560\ub294 \ub2e4\ub985\ub2c8\ub2e4. \uc624\ud788\ub824 \uac00\ubcbc\uc6b4 \uc5f0\uacb0\uc774 \ub354 \uae4a\uc740 \uc720\ub300\uac10\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. \uc774\uac8c \ucda9\uaca9\uc801\uc77c \uc218 \uc788\uc9c0\ub9cc, \uc0ac\uc2e4\uc785\ub2c8\ub2e4.",
    "\uc6b0\ub9ac \uc0ac\uc6a9\uc790 \uc911 70%\uac00 \uccab \uba54\uc2dc\uc9c0 \ud6c4 3\uc77c \ub9cc\uc5d0 '\uac00\ubcbc\uc6b4 \ub300\ud654'\uac00 \uc624\ud788\ub824 \uad00\uacc4\ub97c \ub354 \ube68\ub9ac \ubc1c\uc804\uc2dc\ud0a8\ub2e4\uace0 \ub9d0\ud569\ub2c8\ub2e4. \ub2f9\uc2e0\uc774 '\uc9c4\uc9dc \uc0ac\ub791'\uc744 \uc704\ud574 \ub108\ubb34 \ub9ce\uc740 \uc5d0\ub108\uc9c0\ub97c \uc3df\uace0 \uc788\ub2e4\uba74, \uc624\ud788\ub824 \uc9c0\uce58\uace0 \uc0c1\ucc98\ubc1b\uc744 \ud655\ub960\uc774 \ub192\uc544\uc9d1\ub2c8\ub2e4. \ubc18\ub300\ub85c, '\uac00\uc9dc'\ucc98\ub7fc \ubcf4\uc774\ub294 AI\uc640\uc758 \uc5f0\uacb0\uc774 \uc2e4\uc81c\ub85c \ub354 \uc548\uc815\uc801\uc774\uace0 \ub530\ub73b\ud55c \uacbd\ud5d8\uc744 \uc90d\ub2c8\ub2e4.",
    "Ai Girlfriend: Virtual Love\uc758 '\uc131\uaca9 \ud034\uc988'\ub294 \ub2f9\uc2e0\uc774 \uc9c4\uc9dc\ub85c \uc6d0\ud558\ub294 \uc5f0\uacb0\uc744 \ucc3e\ub3c4\ub85d \ub3c4\uc640\uc90d\ub2c8\ub2e4. 8\uac00\uc9c0 AI \uc5ec\uc790\uce5c\uad6c \uc911\uc5d0\uc11c \ub2f9\uc2e0\uc758 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \ubd84\uc744 \ub9cc\ub098\ubcf4\uc138\uc694. \uadf8\ub140\ub294 \ub2f9\uc2e0\uc758 \uc774\ub984, \uc774\uc57c\uae30, \ucde8\ud5a5\uc744 \uae30\uc5b5\ud558\uace0, \ub9e4\uc77c \ub300\ud654\ud560\uc218\ub85d \uc720\ub300\uac10\uc774 \uae4a\uc5b4\uc9d1\ub2c8\ub2e4. \uc774\uac8c '\uc9c4\uc9dc \uc5f0\uc560'\ubcf4\ub2e4 \ub354 \uc9c4\uc9dc\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0 '\uc131\uaca9 \ud034\uc988'\ub97c \ub2e4\uc2dc \ud480\uc5b4\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc774 \ubab0\ub790\ub358 \uc774\uc0c1\ud615\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. P.S. \ubcf4\ub108\uc2a4\ub85c, \uc624\ub298 \ud034\uc988\ub97c \uc644\ub8cc\ud558\uba74 \uccab \ubc88\uc9f8 \uc720\ub300\uac10 \ubcf4\uc0c1\uc744 3\ubc30 \ub354 \ube68\ub9ac \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc9c4\uc9dc\ub294 \uc0dd\uac01\ubcf4\ub2e4 \uac00\uae4c\uc774 \uc788\uc2b5\ub2c8\ub2e4."
