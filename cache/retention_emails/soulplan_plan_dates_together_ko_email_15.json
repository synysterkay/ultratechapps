{
  "subject": "\ub370\uc774\ud2b8 \uacc4\ud68d 20\ubd84 \uac78\ub9ac\ub358 \uac8c 2\ubd84\uc73c\ub85c \uc904\uc5c8\uc2b5\ub2c8\ub2e4",
  "preview_text": "\uc9c0\ub09c\uc8fc \ub2f9\uc2e0\uc774 \ubcf4\ub0b8 \uc2dc\uac04, \uc624\ub298\uc740 2\ubd84\uc774\uba74 \ub05d\ub0bc \ubc29\ubc95\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\uc9c0\ub09c\uc8fc \uae08\uc694\uc77c \ubc24, \ub2f9\uc2e0\uc740 \ub370\uc774\ud2b8 \uace0\ub974\ub290\ub77c 20\ubd84\uc744 \ubcf4\ub0c8\uc744 \uac81\ub2c8\ub2e4. \ub9de\uc8e0? '\uc5b4\ub514 \uac08\uae4c, \ubb50 \ud560\uae4c' \uace0\ubbfc\ud558\ub2e4\uac00 \uacb0\uad6d \ud3c9\uc18c \uac00\ub294 \uc2dd\ub2f9\uc73c\ub85c \ub05d\ub098\uace0. \uadf8\ub7f0\ub370 \uc624\ub298\uc740 \ub2ec\ub77c\uc694. 2\ubd84\uc774\uba74 \ub05d\ub0bc \uc218 \uc788\ub294 \ubc29\ubc95\uc744 \uc54c\ub824\ub4dc\ub9b4\uac8c\uc694.",
    "\uc0ac\uc2e4 \ub370\uc774\ud2b8 \uacc4\ud68d\uc5d0\uc11c \uac00\uc7a5 \uc2dc\uac04 \uc7a1\uc544\uba39\ub294 \uac74 '\uacb0\uc815'\uc774\uc5d0\uc694. \ubb34\ud55c \uc2a4\ud06c\ub864, \ub9ac\ubdf0 \uc77d\uae30, \uc0c1\ub300\ubc29 \ucde8\ud5a5 \uace0\ub824\ud558\uae30. \uc774 \ubaa8\ub4e0 \uacfc\uc815\uc744 \uc571\uc774 30\ucd08\ub85c \uc555\ucd95\ud560 \uc218 \uc788\ub2e4\uba74? \uc624\ub298 \ubc24, \ub2f9\uc2e0\uc774 '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \uce74\ub4dc\ub97c \ud55c \ubc88 \ud0ed\ud558\ub294 \uc21c\uac04, \ubaa8\ub4e0 \uace0\ubbfc\uc774 \uc0ac\ub77c\uc9d1\ub2c8\ub2e4.",
    "SoulPlan\uc758 '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub294 \uadf8\ub0e5 \ucd94\ucc9c\uc774 \uc544\ub2c8\uc5d0\uc694. \ub2f9\uc2e0\uc758 \uae30\ubd84(\uc544\ub291\ud55c, \ubaa8\ud5d8\uc801\uc778, \uc990\uac70\uc6b4, \uce58\uc720\uc758)\uc744 \ud55c \ubc88\ub9cc \uace0\ub974\uba74, AI\uac00 \uc624\ub298 \ubc24 \uc644\ubcbd\ud55c \ud50c\ub79c\uc744 30\ucd08 \ub9cc\uc5d0 \uc644\uc131\ud569\ub2c8\ub2e4. \ub354 \uc774\uc0c1 \uac80\uc0c9\ud560 \ud544\uc694 \uc5c6\uace0, \uc0c1\ub300\ubc29\uc5d0\uac8c '\ubb50 \ud560\uae4c?' \ubb38\uc790 \ubcf4\ub0bc \ud544\uc694\ub3c4 \uc5c6\uc5b4\uc694. \uadf8\ub0e5 \uc571 \uc5f4\uace0, \uae30\ubd84 \uace0\ub974\uace0, \uc804\uc1a1\ud558\uba74 \ub05d. \ub098\uba38\uc9c0\ub294 \uc571\uc774 \ub2e4 \ucc98\ub9ac\ud569\ub2c8\ub2e4.",
    "\uc624\ub298 \ubc24, \ud55c \ubc88\ub9cc \uc2dc\ub3c4\ud574\ubcf4\uc138\uc694. \uc571\uc744 \uc5f4\uace0 '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \uce74\ub4dc\ub97c \ud0ed\ud55c \ub2e4\uc74c, \uae30\ubd84 \ud558\ub098 \uace0\ub974\uace0 \ud30c\ud2b8\ub108\uc5d0\uac8c \ubcf4\ub0b4\ubcf4\uc138\uc694. 2\ubd84\uc774\uba74 \ub05d\ub0a9\ub2c8\ub2e4. P.S. 24\uc2dc\uac04 \uc548\uc5d0 \uc774 \uae30\ub2a5\uc744 \uc4f4 \ucee4\ud50c\ub4e4\uc740 \ud55c \ub2ec \ub3d9\uc548 \ub370\uc774\ud2b8 \ud69f\uc218\uac00 4\ubc30 \ub298\uc5c8\ub2e4\ub294 \uc0ac\uc2e4, \uc54c\uace0 \uacc4\uc168\ub098\uc694?"
  ],
