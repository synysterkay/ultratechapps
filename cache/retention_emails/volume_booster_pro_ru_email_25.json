{
  "subject": "2AM \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u044f \u043d\u0435 \u0436\u0434\u0430\u043b",
  "preview_text": "\u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044c\u0442\u0435: \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438, \u0442\u0438\u0448\u0438\u043d\u0430, \u0438 \u0432\u044b \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0435 Volume Booster Pro... \u043d\u043e \u043d\u0435 \u0434\u043b\u044f \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438. \u041f\u043e\u0447\u0435\u043c\u0443? \u0427\u0438\u0442\u0430\u0439\u0442\u0435.",
  "body_paragraphs": [
    "\u041f\u043e\u0437\u0430\u0432\u0447\u0435\u0440\u0430, 2:17 \u043d\u043e\u0447\u0438. \u041f\u0440\u0438\u0448\u043b\u043e \u043f\u0438\u0441\u044c\u043c\u043e \u043e\u0442 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f: \u00ab\u042f \u0432\u043a\u043b\u044e\u0447\u0438\u043b \u0432\u0430\u0448\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0447\u0442\u043e\u0431\u044b \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0437\u0432\u0443\u043a \u0442\u0438\u0448\u0435\u00bb. \u042f \u043f\u0435\u0440\u0435\u0447\u0438\u0442\u0430\u043b \u0442\u0440\u0438 \u0440\u0430\u0437\u0430. \u0421\u0435\u0440\u044c\u0451\u0437\u043d\u043e? +200% \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0435 \u2014 \u0438 \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u0435\u0433\u043e \u0434\u043b\u044f \u0442\u0438\u0448\u0438\u043d\u044b?",
    "\u041e\u043d \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043b: \u0432 \u043e\u0431\u0449\u0435\u0436\u0438\u0442\u0438\u0438 \u0441\u043e\u0441\u0435\u0434\u0438 \u0441\u043f\u044f\u0442, \u0430 \u043f\u043e\u0434\u043a\u0430\u0441\u0442 \u0445\u043e\u0447\u0435\u0442\u0441\u044f \u0441\u043b\u0443\u0448\u0430\u0442\u044c \u0447\u0451\u0442\u043a\u043e, \u0431\u0435\u0437 \u0448\u0451\u043f\u043e\u0442\u0430. \u041e\u043d \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a \u043d\u0430 -30% \u2014 \u0438 \u0433\u043e\u043b\u043e\u0441 \u0441\u0442\u0430\u043b \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u043c, \u043d\u043e \u0442\u0438\u0445\u0438\u043c. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 \u0438\u0441\u043a\u0430\u0436\u0435\u043d\u0438\u0439, \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0448\u0443\u043c\u0430. \u041f\u0440\u043e\u0441\u0442\u043e \u0437\u0432\u0443\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435 \u043c\u0435\u0448\u0430\u0435\u0442 \u043d\u0438\u043a\u043e\u043c\u0443.",
    "\u0412\u044b \u0437\u043d\u0430\u043b\u0438, \u0447\u0442\u043e \u043d\u0430\u0448 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0432 \u043e\u0431\u0435 \u0441\u0442\u043e\u0440\u043e\u043d\u044b? \u0414\u0430, +200% \u2014 \u044d\u0442\u043e \u043a\u0440\u0443\u0442\u043e \u0434\u043b\u044f \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043a\u0438. \u041d\u043e \u0434\u043b\u044f \u043d\u043e\u0447\u043d\u043e\u0433\u043e \u0447\u0442\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u043f\u043e\u0437\u0434\u043d\u0438\u0445 \u043f\u043e\u0434\u043a\u0430\u0441\u0442\u043e\u0432 \u0441\u0434\u0432\u0438\u043d\u044c\u0442\u0435 \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a \u0432\u043b\u0435\u0432\u043e. \u0411\u0435\u0437 \u0440\u0435\u043a\u043b\u0430\u043c\u044b. \u0411\u0435\u0437 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439. \u041f\u0440\u043e\u0441\u0442\u043e \u0442\u0438\u0448\u0438\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0432\u044b \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u0442\u0435.",
    "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u044d\u0442\u043e\u0442 \u0442\u0440\u044e\u043a \u2014 \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a \u0432 \u043c\u0438\u043d\u0443\u0441. P.S. \u0415\u0441\u043b\u0438 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u0441\u0432\u043e\u0439 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0439 \u0441\u043f\u043e\u0441\u043e\u0431 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f, \u043d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u043d\u0430\u043c. \u041c\u044b \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u043c \u0442\u0430\u043a\u0438\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u2014 \u043e\u043d\u0438 \u043b\u0443\u0447\u0448\u0435 \u043b\u044e\u0431\u044b\u0445 \u043e\u0431\u0437\u043e\u0440\u043e\u0432."
