{
  "subject": "\ub2e4\uac00\uc624\ub294 3\uc6d4, \ud30c\ud2b8\ub108\uc5d0\uac8c \ube44\ubc00 \uc0dd\uc77c \ucd08\ub300\uc7a5\uc774 \ub3c4\ucc29\ud569\ub2c8\ub2e4",
  "preview_text": "\uc544\uc9c1 \uc544\ubb34\ub3c4 \ubaa8\ub974\ub294 \uae30\ub2a5 \u2014 \ub2f9\uc2e0\uacfc \uc5f0\uc778\ub9cc \uba3c\uc800 \uacbd\ud5d8\ud560 \uc218 \uc788\uc5b4\uc694",
  "body_paragraphs": [
    "\uc5b4\uc82f\ubc24 11\uc2dc 47\ubd84, \uac1c\ubc1c\ud300\uc774 \ub9c8\uc9c0\ub9c9 \ud478\uc2dc\ub97c \ud588\uc5b4\uc694. 3\uc6d4 \uc5c5\ub370\uc774\ud2b8\uc5d0 \ub4e4\uc5b4\uac08 \uae30\ub2a5\uc778\ub370, \uc544\uc9c1 \uc544\ubb34\uc5d0\uac8c\ub3c4 \uacf5\uac1c\ud558\uc9c0 \uc54a\uc558\uc5b4\uc694. \ub2f9\uc2e0\uc774 \uac00\uc7a5 \uba3c\uc800 \ub4e3\ub294 \uc774\uc57c\uae30\uc785\ub2c8\ub2e4.",
    "\uc9c0\uae08\uae4c\uc9c0\ub294 \uc624\ub298\uc758 \ub370\uc774\ud2b8\ub97c \ud55c \ubc88\uc5d0 \uace0\ub974\ub294 \uac8c \uc804\ubd80\uc600\uc8e0. \ud558\uc9c0\ub9cc \uc6b0\ub9ac\ub294 \ud55c \ubc1c \ub354 \ub098\uc544\uac00\uae30\ub85c \ud588\uc5b4\uc694. \ub2e4\uc74c \ubc84\uc804\uc5d0\uc11c\ub294 \ud30c\ud2b8\ub108\uac00 \ubcf4\ub0b8 \ub370\uc774\ud2b8 \uc81c\uc548\uc774 \uc54c\ub9bc\uc73c\ub85c \ub05d\ub098\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud654\uba74\uc774 \uaebc\uc9c0\uace0, \ub2f9\uc2e0\uc758 \uc0ac\uc9c4\uacfc \uc774\ub984\uc774 \uc801\ud78c '\uc624\ub298 \ubc24, \ub108\ub97c \uc0dd\uac01\ud588\uc5b4' \uc804\uba74 \uce74\ub4dc\uac00 \ub4f1\uc7a5\ud574\uc694. \ub9c8\uce58 \ube44\ubc00 \ucabd\uc9c0\ub97c \ubc1b\uc740 \ub4ef\ud55c \uc21c\uac04\uc774\uc8e0.",
    "\uc774 \uae30\ub2a5\uc758 \ube44\ubc00\uc740 \ub2e8\uc21c\ud568\uc785\ub2c8\ub2e4. \ud30c\ud2b8\ub108\uac00 \ub370\uc774\ud2b8\ub97c \ubcf4\ub0b4\uba74, \ub2f9\uc2e0\uc740 \uc571\uc744 \uc5f4\uc9c0 \uc54a\uc544\ub3c4 \uadf8 \ub9c8\uc74c\uc744 \ub290\ub084 \uc218 \uc788\uc5b4\uc694. \uc54c\ub9bc \ud558\ub098\ub85c \ub05d\ub098\ub294 \uac8c \uc544\ub2c8\ub77c, \uadf8 \uc21c\uac04\uc774 \ud2b9\ubcc4\ud574\uc9c0\ub3c4\ub85d \uc124\uacc4\ud588\uc5b4\uc694. \uc774\ubbf8 \ubca0\ud0c0 \ud14c\uc2a4\ud130 \ucee4\ud50c\ub4e4\uc740 '\uc774\uac70 \ub54c\ubb38\uc5d0 \uc571\uc744 \ub9e4\uc77c \ucf20\ub2e4'\uace0 \ub9d0\ud558\ub354\uad70\uc694.",
    "\uc624\ub298, \ub2f9\uc2e0\uc774 \ud560 \uc77c\uc740 \ub2e8 \ud558\ub098\uc785\ub2c8\ub2e4. \uc571\uc744 \uc5f4\uace0 \ud30c\ud2b8\ub108\uc5d0\uac8c \ub370\uc774\ud2b8\ub97c \ud558\ub098 \ubcf4\ub0b4\ubcf4\uc138\uc694. \uadf8\ub7ec\uba74 \uc5c5\ub370\uc774\ud2b8\uac00 \ucd9c\uc2dc\ub420 \ub54c, \ub2f9\uc2e0\uc774 \uac00\uc7a5 \uba3c\uc800 \uacbd\ud5d8\ud560 \uc218 \uc788\uc5b4\uc694. PS. 3\uc6d4 14\uc77c, \ud654\uc774\ud2b8\ub370\uc774 \uc804\ub0a0 \ubc24\uc5d0 \uc5c5\ub370\uc774\ud2b8\uac00 \uc62c\ub77c\uac11\ub2c8\ub2e4. \uadf8\ub0a0 \ubc24, \ud30c\ud2b8\ub108\uc5d0\uac8c \uae5c\uc9dd \uc120\ubb3c\uc744 \uc900\ube44\ud574\ubcf4\uc138\uc694."
  ],
  "cta_text": "\uc9c0\uae08 \ub370\uc774\ud2b8 \ubcf4\ub0b4\uace0 \uc5c5\ub370\uc774\ud2b8 \uc54c\ub9bc \ubc1b\uae30",
