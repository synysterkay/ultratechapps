{
  "subject": "\u4f60\u7684\u58f0\u97f3\u4e4b\u65c5\uff1a\u7b2c45\u5929\u7684\u8f6c\u6298\u70b9",
  "preview_text": "\u4f60\u4e0d\u662f\u65b0\u7528\u6237\u4e86\u3002\u8fd9\u662f\u4f60\u6210\u4e3a\u771f\u6b63\u638c\u63a7\u8005\u7684\u4e0b\u4e00\u6b65\u3002",
  "body_paragraphs": [
    "\u4f60\u5df2\u7ecf\u4e0b\u8f7d\u4e86Loud EQ\uff0c\u7528\u4e86\u5b8345\u5929\u3002\u4f46\u731c\u731c\u770b\uff1f\u4f60\u8fd8\u6ca1\u771f\u6b63\u89e3\u9501\u5b83\u7684\u5168\u90e8\u6f5c\u529b\u3002\u6211\u89c1\u8fc7\u592a\u591a\u4eba\u53ea\u7528\u4e86\u97f3\u91cf\u63d0\u5347\uff0c\u7136\u540e\u5c31\u505c\u5728\u90a3\u91cc\u3002\u4ed6\u4eec\u9519\u8fc7\u4e86\u90a3\u4e2a\u8ba9\u4e00\u5207\u53d8\u5f97\u6e05\u6670\u3001\u5e73\u8861\u3001\u5b89\u5168\u7684\u529f\u80fd\u3002\u4eca\u5929\uff0c\u6211\u60f3\u5e26\u4f60\u5230\u4e0b\u4e00\u4e2a\u5c42\u6b21\u3002",
    "\u4f60\u4e0d\u662f\u65b0\u7528\u6237\u4e86\u3002\u4f60\u662f\u4e00\u4e2a\u61c2\u5f97\u58f0\u97f3\u4ef7\u503c\u7684\u4eba\u3002\u5728\u5608\u6742\u7684\u901a\u52e4\u4e2d\uff0c\u5728\u957f\u9014\u9a7e\u9a76\u65f6\uff0c\u5728\u6df1\u591c\u542c\u64ad\u5ba2\u65f6\u2014\u2014\u4f60\u5df2\u7ecf\u4f53\u9a8c\u8fc7Loud EQ\u7684\u5a01\u529b\u3002\u4f46\u771f\u6b63\u7684\u638c\u63a7\u8005\u77e5\u9053\uff0c\u5965\u5999\u5728\u4e8e\u4f18\u5316\uff0c\u800c\u4e0d\u662f\u76f2\u76ee\u653e\u5927\u3002\u60f3\u8c61\u4e00\u4e0b\uff0c\u4f60\u7684\u624b\u673a\u626c\u58f0\u5668\u53d1\u51fa\u4e30\u5bcc\u3001\u7ec6\u817b\u7684\u58f0\u97f3\uff0c\u6ca1\u6709\u4e00\u4e1d\u523a\u8033\u3002\u8fd9\u5c31\u662f\u4f60\u80fd\u505a\u5230\u7684\u3002",
    "\u5173\u952e\u5728\u4e8e5\u6bb5\u5747\u8861\u5668\u548c\u56db\u4e2a\u97f3\u9891\u9884\u8bbe\u3002\u5b83\u4eec\u4e0d\u662f\u88c5\u9970\u54c1\u3002\u5bf9\u4e8e\u64ad\u5ba2\uff0c\u9009\u62e9'\u64ad\u5ba2'\u6a21\u5f0f\u2014\u2014\u5b83\u4f1a\u589e\u5f3a\u4eba\u58f0\uff0c\u538b\u5236\u80cc\u666f\u566a\u97f3\u3002\u5bf9\u4e8e\u97f3\u4e50\uff0c\u8bd5\u8bd5'\u97f3\u4e50'\u6a21\u5f0f\uff0c\u8ba9\u4f4e\u97f3\u6df1\u6c89\u800c\u4e0d\u5931\u6e05\u6670\u3002\u4f60\u751a\u81f3\u53ef\u4ee5\u7528\u4e00\u952e\u4f18\u5316\uff0c\u8ba9\u5b83\u6839\u636e\u4f60\u63d2\u5165\u7684\u8bbe\u5907\u81ea\u52a8\u8c03\u6574\u3002\u8fd9\u4e0d\u662f\u9b54\u6cd5\uff0c\u8fd9\u53ea\u662f\u806a\u660e\u7684\u5de5\u7a0b\u3002",
    "\u73b0\u5728\u6253\u5f00Loud EQ\uff0c\u5c1d\u8bd5\u4e00\u4e0b'\u64ad\u5ba2'\u9884\u8bbe\u3002\u5c31\u4e00\u6b21\u3002\u4f60\u4f1a\u542c\u5230\u533a\u522b\u3002\u7136\u540e\uff0c\u5982\u679c\u4f60\u51c6\u5907\u597d\u4e86\uff0c\u770b\u770b\u9ad8\u7ea7\u7248\u5982\u4f55\u89e3\u9501\u5b8c\u6574\u7684200%\u63d0\u5347\u548c\u58f0\u97f3DNA\u6821\u51c6\u3002\u8fd9\u4e0d\u662f\u63a8\u9500\uff0c\u8fd9\u662f\u9080\u8bf7\u3002\u4f60\u503c\u5f97\u62e5\u6709\u6700\u6e05\u6670\u7684\u542c\u89c9\u4f53\u9a8c\u3002P.S. \u4f60\u4f7f\u7528\u6b21\u6570\u8d8a\u591a\uff0cLoud EQ\u5c31\u8d8a\u61c2\u4f60\u7684\u8033\u6735\u3002\u8bd5\u8bd5\u770b\uff0c\u4f60\u4f1a\u660e\u767d\u7684\u3002"
  ],
