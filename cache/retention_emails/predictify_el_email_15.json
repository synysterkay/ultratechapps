{
  "subject": "\u03a4\u03bf \u03bb\u03ac\u03b8\u03bf\u03c2 \u03c0\u03bf\u03c5 \u03ad\u03ba\u03b1\u03bd\u03b1 15 \u03bb\u03b5\u03c0\u03c4\u03ac \u03c0\u03c1\u03b9\u03bd \u03c4\u03bf\u03bd \u03b1\u03b3\u03ce\u03bd\u03b1",
  "preview_text": "\u03a0\u03ce\u03c2 \u03bd\u03b1 \u03ba\u03b5\u03c1\u03b4\u03af\u03c3\u03b5\u03b9\u03c2 18 \u03bb\u03b5\u03c0\u03c4\u03ac \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03ad\u03c7\u03b5\u03b9\u03c2 \u03c4\u03b1 \u03c0\u03ac\u03bd\u03c4\u03b1 \u03ad\u03c4\u03bf\u03b9\u03bc\u03b1 \u03b3\u03b9\u03b1 \u03c4\u03bf \u03bc\u03b1\u03c4\u03c2. \u0388\u03bd\u03b1 \u03ba\u03cc\u03bb\u03c0\u03bf \u03c0\u03bf\u03c5 \u03b1\u03bb\u03bb\u03ac\u03b6\u03b5\u03b9 \u03c4\u03b1 \u03c0\u03ac\u03bd\u03c4\u03b1.",
  "body_paragraphs": [
    "\u039e\u03ad\u03c1\u03b5\u03b9\u03c2 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf \u03c3\u03c5\u03bd\u03b1\u03af\u03c3\u03b8\u03b7\u03bc\u03b1 \u03cc\u03c4\u03b1\u03bd \u03c4\u03c1\u03ad\u03c7\u03b5\u03b9\u03c2 \u03bd\u03b1 \u03b2\u03c1\u03b5\u03b9\u03c2 \u03c3\u03c4\u03b1\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03ac \u03bb\u03af\u03b3\u03bf \u03c0\u03c1\u03b9\u03bd \u03c4\u03bf \u03bc\u03b1\u03c4\u03c2, \u03c8\u03ac\u03c7\u03bd\u03b5\u03b9\u03c2 \u03c6\u03cc\u03c1\u03bc\u03b5\u03c2, xG, \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ac, \u03ba\u03b1\u03b9 \u03c4\u03b5\u03bb\u03b9\u03ba\u03ac \u03c7\u03ac\u03bd\u03b5\u03b9\u03c2 \u03c4\u03b7\u03bd \u03bc\u03c0\u03ac\u03bb\u03b1; \u03a4\u03bf \u03ad\u03ba\u03b1\u03bd\u03b1 \u03ba\u03b9 \u03b5\u03b3\u03ce \u03b3\u03b9\u03b1 \u03c7\u03c1\u03cc\u03bd\u03b9\u03b1. \u039c\u03ad\u03c7\u03c1\u03b9 \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b1\u03ba\u03ac\u03bb\u03c5\u03c8\u03b1 \u03cc\u03c4\u03b9 \u03bc\u03b5 Predictify, \u03cc,\u03c4\u03b9 \u03ad\u03c0\u03b1\u03b9\u03c1\u03bd\u03b5 20 \u03bb\u03b5\u03c0\u03c4\u03ac \u03c4\u03ce\u03c1\u03b1 \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03c3\u03b5 2. \u039a\u03c5\u03c1\u03b9\u03bf\u03bb\u03b5\u03ba\u03c4\u03b9\u03ba\u03ac.",
    "\u03a4\u03bf \u03bc\u03c5\u03c3\u03c4\u03b9\u03ba\u03cc \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03bf AI Chat. \u0391\u03bd\u03c4\u03af \u03bd\u03b1 \u03c3\u03ba\u03ac\u03b2\u03b5\u03b9\u03c2 \u03c3\u03b5 \u03b4\u03ad\u03ba\u03b1 tabs, \u03b1\u03c0\u03bb\u03ac \u03c1\u03c9\u03c4\u03ac\u03c2: '\u03a0\u03bf\u03b9\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u03c4\u03b7\u03c2 \u039c\u03c0\u03ac\u03b3\u03b5\u03c1\u03bd \u03c3\u03c4\u03b1 \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 5 \u03b5\u03ba\u03c4\u03cc\u03c2 \u03ad\u03b4\u03c1\u03b1\u03c2 \u03bd\u03c4\u03ad\u03c1\u03bc\u03c0\u03b9;' \u03ba\u03b1\u03b9 \u03c0\u03b1\u03af\u03c1\u03bd\u03b5\u03b9\u03c2 \u03b1\u03c0\u03ac\u03bd\u03c4\u03b7\u03c3\u03b7 \u03bc\u03b5 \u03bd\u03bf\u03cd\u03bc\u03b5\u03c1\u03b1, xG, \u03ba\u03b1\u03b9 confidence score. \u0395\u03af\u03bd\u03b1\u03b9 \u03c3\u03b1\u03bd \u03bd\u03b1 \u03ad\u03c7\u03b5\u03b9\u03c2 \u03ad\u03bd\u03b1\u03bd \u03b1\u03bd\u03b1\u03bb\u03c5\u03c4\u03ae \u03b4\u03af\u03c0\u03bb\u03b1 \u03c3\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03b4\u03bf\u03c5\u03bb\u03b5\u03cd\u03b5\u03b9 \u03b3\u03b9\u03b1 \u03c3\u03ad\u03bd\u03b1. \u039a\u03b1\u03b9 \u03b4\u03b5\u03bd \u03c3\u03c4\u03b1\u03bc\u03b1\u03c4\u03ac\u03c2 \u03b5\u03ba\u03b5\u03af \u2014 \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03b1\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u03b3\u03b9\u03b1 \u03c4\u03bf \u03c0\u03ce\u03c2 \u03c0\u03b1\u03af\u03b6\u03b5\u03b9 \u03b7 \u03ac\u03bc\u03c5\u03bd\u03b1 \u03c4\u03b7\u03c2 \u03b1\u03bd\u03c4\u03af\u03c0\u03b1\u03bb\u03b7\u03c2 \u03bf\u03bc\u03ac\u03b4\u03b1\u03c2 \u03c3\u03b5 \u03c3\u03c4\u03b7\u03bc\u03ad\u03bd\u03b5\u03c2 \u03c6\u03ac\u03c3\u03b5\u03b9\u03c2.",
    "\u03a4\u03bf AI \u03c3\u03bf\u03c5 \u03b4\u03af\u03bd\u03b5\u03b9 \u03cc\u03bb\u03b5\u03c2 \u03c4\u03b9\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ad\u03c8\u03b5\u03b9\u03c2 \u03bc\u03b5 \u03b2\u03ac\u03c3\u03b7 \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03b5\u03c2 \u03bc\u03b5\u03c4\u03b1\u03b2\u03bb\u03b7\u03c4\u03ad\u03c2, \u03bc\u03b1\u03b6\u03af \u03bc\u03b5 confidence scores. \u0394\u03b5\u03bd \u03c7\u03c1\u03b5\u03b9\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 \u03bd\u03b1 \u03b5\u03bc\u03c0\u03b9\u03c3\u03c4\u03b5\u03cd\u03b5\u03c3\u03b1\u03b9 \u03c4\u03bf \u03ad\u03bd\u03c3\u03c4\u03b9\u03ba\u03c4\u03cc \u03c3\u03bf\u03c5 \u2014 \u03c4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03bc\u03b9\u03bb\u03ac\u03bd\u03b5. \u039c\u03c0\u03b5\u03c2 \u03c3\u03c4\u03bf app, \u03c0\u03ae\u03b3\u03b1\u03b9\u03bd\u03b5 \u03c3\u03c4\u03bf AI Chat, \u03ba\u03b1\u03b9 \u03ba\u03ac\u03bd\u03b5 \u03bc\u03b9\u03b1 \u03b5\u03c1\u03ce\u03c4\u03b7\u03c3\u03b7 \u03b3\u03b9\u03b1 \u03c4\u03bf \u03b5\u03c0\u03cc\u03bc\u03b5\u03bd\u03bf \u03bc\u03b1\u03c4\u03c2. \u0398\u03b1 \u03b4\u03b5\u03b9\u03c2 \u03c0\u03cc\u03c3\u03bf \u03b3\u03c1\u03ae\u03b3\u03bf\u03c1\u03b1 \u03b3\u03af\u03bd\u03b5\u03c3\u03b1\u03b9 \u03bf \u03c0\u03b9\u03bf \u03b5\u03bd\u03b7\u03bc\u03b5\u03c1\u03c9\u03bc\u03ad\u03bd\u03bf\u03c2 \u03c6\u03af\u03bb\u03b1\u03b8\u03bb\u03bf\u03c2 \u03c3\u03c4\u03bf room.",
    "\u0386\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03bf Predictify \u03c4\u03ce\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03b4\u03bf\u03ba\u03af\u03bc\u03b1\u03c3\u03b5 \u03c4\u03bf AI Chat. \u039c\u03b9\u03b1 \u03b5\u03c1\u03ce\u03c4\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b5\u03af\u03c3\u03b1\u03b9 \u03ad\u03c4\u03bf\u03b9\u03bc\u03bf\u03c2. P.S. \u0391\u03bd \u03c4\u03bf \u03ba\u03ac\u03bd\u03b5\u03b9\u03c2 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03ad\u03bd\u03b1\u03c1\u03be\u03b7, \u03b8\u03b1 \u03ad\u03c7\u03b5\u03b9\u03c2 \u03c7\u03c1\u03cc\u03bd\u03bf \u03bd\u03b1 \u03c0\u03bf\u03c3\u03c4\u03ac\u03c1\u03b5\u03b9\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03bf Prediction of the Day \u03c3\u03c4\u03b7\u03bd \u03ba\u03bf\u03b9\u03bd\u03cc\u03c4\u03b7\u03c4\u03ac \u03c3\u03bf\u03c5 \u2014 \u03bf\u03b9 \u03c6\u03af\u03bb\u03bf\u03b9 \u03c3\u03bf\u03c5 \u03b8\u03b1 \u03c3\u03b5 \u03b6\u03b7\u03bb\u03b5\u03cd\u03bf\u03c5\u03bd."
