{
  "subject": "2 \u03bb\u03b5\u03c0\u03c4\u03ac \u03c0\u03bf\u03c5 \u03b1\u03bb\u03bb\u03ac\u03b6\u03bf\u03c5\u03bd \u03ba\u03ac\u03b8\u03b5 \u03b1\u03b3\u03ce\u03bd\u03b1 \u03c3\u03bf\u03c5",
  "preview_text": "\u03a0\u03ce\u03c2 \u03bd\u03b1 \u03ba\u03ac\u03bd\u03b5\u03b9\u03c2 \u03c3\u03b5 2 \u03bb\u03b5\u03c0\u03c4\u03ac \u03b1\u03c5\u03c4\u03cc \u03c0\u03bf\u03c5 \u03ad\u03c0\u03b1\u03b9\u03c1\u03bd\u03b5 20. \u0388\u03bd\u03b1 \u03ba\u03cc\u03bb\u03c0\u03bf \u03c0\u03bf\u03c5 \u03b8\u03b1 \u03c3\u03b5 \u03ba\u03ac\u03bd\u03b5\u03b9 \u03c4\u03bf\u03bd \u03c0\u03b9\u03bf \u03ad\u03be\u03c5\u03c0\u03bd\u03bf \u03c6\u03af\u03bb\u03b1\u03b8\u03bb\u03bf.",
  "body_paragraphs": [
    "\u0398\u03c5\u03bc\u03ac\u03c3\u03b1\u03b9 \u03b5\u03ba\u03b5\u03af\u03bd\u03bf \u03c4\u03bf \u03b2\u03c1\u03ac\u03b4\u03c5 \u03c0\u03bf\u03c5 \u03ad\u03c4\u03c1\u03b5\u03c7\u03b5\u03c2 \u03b1\u03c0\u03cc site \u03c3\u03b5 site, \u03c8\u03ac\u03c7\u03bd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c3\u03c4\u03b1\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03ac, xG, \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03cc, \u03ba\u03b1\u03b9 \u03c3\u03c4\u03bf \u03c4\u03ad\u03bb\u03bf\u03c2 \u03b4\u03b9\u03ac\u03bb\u03b5\u03b3\u03b5\u03c2 \u03bc\u03b5 \u03c4\u03bf \u03ad\u03bd\u03c3\u03c4\u03b9\u03ba\u03c4\u03bf; \u0395\u03b3\u03ce \u03c4\u03bf \u03b8\u03c5\u03bc\u03ac\u03bc\u03b1\u03b9. \u0393\u03b9\u03b1\u03c4\u03af \u03c4\u03bf \u03ad\u03ba\u03b1\u03bd\u03b1 \u03b3\u03b9\u03b1 \u03c7\u03c1\u03cc\u03bd\u03b9\u03b1. \u039c\u03ad\u03c7\u03c1\u03b9 \u03c0\u03bf\u03c5 \u03ba\u03b1\u03c4\u03ac\u03bb\u03b1\u03b2\u03b1 \u03cc\u03c4\u03b9 \u03c5\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9 \u03c4\u03c1\u03cc\u03c0\u03bf\u03c2 \u03bd\u03b1 \u03c4\u03bf \u03ba\u03ac\u03bd\u03c9 \u03c3\u03b5 2 \u03bb\u03b5\u03c0\u03c4\u03ac, \u03cc\u03c7\u03b9 20.",
    "\u03a4\u03bf Predictify \u03b4\u03b5\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03b1\u03c0\u03bb\u03ac \u03bc\u03b9\u03b1 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae. \u0395\u03af\u03bd\u03b1\u03b9 \u03bf \u03b2\u03bf\u03b7\u03b8\u03cc\u03c2 \u03c3\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b1\u03bb\u03cd\u03b5\u03b9 \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03b5\u03c2 \u03bc\u03b5\u03c4\u03b1\u03b2\u03bb\u03b7\u03c4\u03ad\u03c2 \u03b1\u03bd\u03ac \u03b1\u03b3\u03ce\u03bd\u03b1, \u03c3\u03bf\u03c5 \u03b4\u03af\u03bd\u03b5\u03b9 confidence scores, \u03ba\u03b1\u03b9 \u03c3\u03bf\u03c5 \u03bb\u03ad\u03b5\u03b9 \u03b1\u03ba\u03c1\u03b9\u03b2\u03ce\u03c2 \u03c0\u03cc\u03c3\u03bf \u03c3\u03af\u03b3\u03bf\u03c5\u03c1\u03bf \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03bf prediction. \u0394\u03b5\u03bd \u03c7\u03c1\u03b5\u03b9\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 \u03bd\u03b1 \u03c8\u03ac\u03c7\u03bd\u03b5\u03b9\u03c2 \u03c0\u03bb\u03ad\u03bf\u03bd. \u0391\u03bd\u03bf\u03af\u03b3\u03b5\u03b9\u03c2, \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9\u03c2, \u03b1\u03c0\u03bf\u03c6\u03b1\u03c3\u03af\u03b6\u03b5\u03b9\u03c2.",
    "\u03a4\u03bf \u03ba\u03cc\u03bb\u03c0\u03bf \u03b5\u03af\u03bd\u03b1\u03b9 \u03b1\u03c0\u03bb\u03cc: \u03b4\u03b9\u03ac\u03bb\u03b5\u03be\u03b5 \u03ad\u03bd\u03b1\u03bd \u03b1\u03b3\u03ce\u03bd\u03b1 \u03b1\u03c0\u03cc \u03c4\u03b1 50+ \u03c0\u03c1\u03c9\u03c4\u03b1\u03b8\u03bb\u03ae\u03bc\u03b1\u03c4\u03b1, \u03b4\u03b5\u03c2 \u03c4\u03bf confidence score, \u03ba\u03b1\u03b9 \u03b4\u03b9\u03ac\u03b2\u03b1\u03c3\u03b5 \u03c4\u03b7 tactical analysis \u03c0\u03bf\u03c5 \u03b5\u03c4\u03bf\u03b9\u03bc\u03ac\u03b6\u03b5\u03b9 \u03b7 AI. \u0394\u03cd\u03bf \u03bb\u03b5\u03c0\u03c4\u03ac. \u0391\u03c5\u03c4\u03cc \u03b5\u03af\u03bd\u03b1\u03b9 \u03cc\u03bb\u03bf. \u039a\u03b1\u03b9 \u03b1\u03bd \u03b8\u03b5\u03c2 \u03bd\u03b1 \u03c0\u03b1\u03c2 \u03b2\u03b1\u03b8\u03cd\u03c4\u03b5\u03c1\u03b1, \u03c4\u03bf AI Chat \u03c3\u03bf\u03c5 \u03b1\u03c0\u03b1\u03bd\u03c4\u03ac \u03c3\u03b5 \u03b4\u03b5\u03c5\u03c4\u03b5\u03c1\u03cc\u03bb\u03b5\u03c0\u03c4\u03b1 \u03b3\u03b9\u03b1 \u03bf\u03c0\u03bf\u03b9\u03b1\u03b4\u03ae\u03c0\u03bf\u03c4\u03b5 \u03b5\u03c1\u03ce\u03c4\u03b7\u03c3\u03b7.",
    "\u0386\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03ce\u03c1\u03b1 \u03c4\u03bf Predictify, \u03c0\u03ae\u03b3\u03b1\u03b9\u03bd\u03b5 \u03c3\u03b5 \u03ad\u03bd\u03b1\u03bd \u03b1\u03b3\u03ce\u03bd\u03b1 \u03c4\u03b7\u03c2 Premier League \u03ae \u03c4\u03bf\u03c5 Champions League, \u03ba\u03b1\u03b9 \u03b4\u03b5\u03c2 \u03c0\u03cc\u03c3\u03bf \u03b3\u03c1\u03ae\u03b3\u03bf\u03c1\u03b1 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af\u03c2 \u03bd\u03b1 \u03c0\u03ac\u03c1\u03b5\u03b9\u03c2 \u03b1\u03c0\u03cc\u03c6\u03b1\u03c3\u03b7. P.S. \u0391\u03bd \u03b8\u03b5\u03c2 \u03bd\u03b1 \u03b4\u03b5\u03b9\u03c2 \u03c0\u03ce\u03c2 \u03c4\u03bf \u03ba\u03ac\u03bd\u03bf\u03c5\u03bd \u03bf\u03b9 Premium users, \u03b4\u03bf\u03ba\u03af\u03bc\u03b1\u03c3\u03b5 \u03c4\u03bf 3\u03ae\u03bc\u03b5\u03c1\u03bf trial \u2014 \u03b8\u03b1 \u03b5\u03ba\u03c0\u03bb\u03b1\u03b3\u03b5\u03af\u03c2 \u03c0\u03cc\u03c3\u03bf \u03c0\u03b9\u03bf \u03b3\u03c1\u03ae\u03b3\u03bf\u03c1\u03b1 \u03b4\u03bf\u03c5\u03bb\u03b5\u03cd\u03b5\u03b9\u03c2."
  ],
