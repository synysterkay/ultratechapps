{
  "subject": "\u0633\u0631 \u0644\u0627 \u064a\u0639\u0631\u0641\u0647 90% \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646",
  "preview_text": "\u0647\u0630\u0647 \u0627\u0644\u062e\u062f\u0639\u0629 \u0627\u0644\u0628\u0633\u064a\u0637\u0629 \u0633\u062a\u063a\u064a\u0631 \u0637\u0631\u064a\u0642\u0629 \u0643\u062a\u0627\u0628\u062a\u0643 \u0644\u0644\u0623\u0628\u062d\u0627\u062b \u0625\u0644\u0649 \u0627\u0644\u0623\u0628\u062f. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646.",
  "body_paragraphs": [
    "\u0644\u0646 \u0623\u0636\u064a\u0639 \u0648\u0642\u062a\u0643. \u0623\u0639\u0631\u0641 \u0623\u0646\u0643 \u0645\u0634\u063a\u0648\u0644 \u0648\u062a\u062d\u062a \u0636\u063a\u0637. \u0647\u0646\u0627\u0643 \u062e\u062f\u0639\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u064a \u062a\u0637\u0628\u064a\u0642\u0646\u0627 \u062a\u062c\u0639\u0644 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0633\u0627\u0639\u0629 \u0645\u0646 \u0627\u0644\u062a\u0634\u062a\u064a\u062a \u064810 \u062f\u0642\u0627\u0626\u0642 \u0645\u0646 \u0627\u0644\u0625\u0646\u062c\u0627\u0632. \u0645\u0639\u0638\u0645 \u0627\u0644\u0637\u0644\u0627\u0628 \u064a\u062a\u062c\u0627\u0647\u0644\u0648\u0646\u0647\u0627\u060c \u0644\u0643\u0646 \u0645\u0646 \u064a\u0633\u062a\u062e\u062f\u0645\u0647\u0627 \u064a\u0646\u062c\u0632 \u0628\u0634\u0643\u0644 \u0623\u0633\u0631\u0639 \u0648\u064a\u062d\u0635\u0644 \u0639\u0644\u0649 \u062f\u0631\u062c\u0627\u062a \u0623\u0641\u0636\u0644.",
    "\u0627\u0644\u0641\u0643\u0631\u0629 \u0628\u0633\u064a\u0637\u0629: \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0623\u0646 \u062a\u0628\u062f\u0623 \u0628\u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u0641\u0631\u0636\u064a\u0629 \u0645\u0646 \u0627\u0644\u0635\u0641\u0631 \u0648\u062a\u062a\u0639\u0628 \u0641\u064a \u0627\u0644\u0635\u064a\u0627\u063a\u0629\u060c \u0627\u0633\u062a\u062e\u062f\u0645 \u062e\u0627\u0635\u064a\u0629 '\u0627\u0644\u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0630\u0643\u064a \u0644\u0644\u0641\u0631\u0636\u064a\u0629'. \u0641\u0642\u0637 \u0627\u0643\u062a\u0628 \u0645\u0648\u0636\u0648\u0639\u0643 \u0641\u064a \u062c\u0645\u0644\u0629 \u0648\u0627\u062d\u062f\u0629\u060c \u0648\u0627\u062e\u062a\u0631 \u0646\u0645\u0637 \u0627\u0644\u0628\u062d\u062b (\u0648\u0635\u0641\u064a\u060c \u062a\u062d\u0644\u064a\u0644\u064a\u060c \u062c\u062f\u0644\u064a)\u060c \u062b\u0645 \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631. \u0641\u064a \u0623\u0642\u0644 \u0645\u0646 \u062f\u0642\u064a\u0642\u0629\u060c \u0633\u062a\u062d\u0635\u0644 \u0639\u0644\u0649 3 \u0641\u0631\u0636\u064a\u0627\u062a \u062c\u0627\u0647\u0632\u0629 \u0644\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645.",
    "\u0647\u0630\u0647 \u0627\u0644\u062e\u0627\u0635\u064a\u0629 \u0635\u0645\u0645\u062a \u0644\u062a\u0642\u0636\u064a \u0639\u0644\u0649 \u0644\u062d\u0638\u0627\u062a \u0627\u0644\u062a\u0631\u062f\u062f \u0648\u0627\u0644\u062e\u0648\u0641 \u0645\u0646 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0628\u064a\u0636\u0627\u0621. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646 \u0641\u064a \u0623\u064a \u0628\u062d\u062b \u062a\u0639\u0645\u0644 \u0639\u0644\u064a\u0647. \u0633\u062a\u0644\u0627\u062d\u0638 \u0627\u0644\u0641\u0631\u0642 \u0641\u0648\u0631\u0627\u064b.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0642\u0633\u0645 '\u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0641\u0631\u0636\u064a\u0629'. \u0627\u0643\u062a\u0628 \u0645\u0648\u0636\u0648\u0639\u0643 \u0648\u0627\u062e\u062a\u0631 \u0646\u0645\u0637 \u0627\u0644\u0628\u062d\u062b. \u062e\u0644\u0627\u0644 60 \u062b\u0627\u0646\u064a\u0629 \u0641\u0642\u0637 \u0633\u062a\u062d\u0635\u0644 \u0639\u0644\u0649 \u0641\u0631\u0636\u064a\u0629 \u062c\u0627\u0647\u0632\u0629. \u062c\u0631\u0628\u0647\u0627 \u0648\u0644\u0627 \u062a\u062a\u0631\u062f\u062f \u0641\u064a \u0645\u0631\u0627\u0633\u0644\u062a\u064a \u0625\u0630\u0627 \u0627\u062d\u062a\u062c\u062a \u0645\u0633\u0627\u0639\u062f\u0629. P.S. \u0645\u0639\u0638\u0645 \u0627\u0644\u0637\u0644\u0627\u0628 \u0627\u0644\u0630\u064a\u0646 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0647\u0630\u0647 \u0627\u0644\u062e\u0627\u0635\u064a\u0629 \u064a\u062d\u0635\u0644\u0648\u0646 \u0639\u0644\u0649 \u062a\u0642\u062f\u064a\u0631 \u0623\u0639\u0644\u0649 \u0645\u0646 B+."
