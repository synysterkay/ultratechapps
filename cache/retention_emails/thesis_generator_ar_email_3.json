{
  "subject": "\u062a\u062c\u0646\u0628 \u0647\u0630\u0627 \u0627\u0644\u062e\u0637\u0623 \u0627\u0644\u0630\u064a \u064a\u0636\u064a\u0639 8 \u0633\u0627\u0639\u0627\u062a \u0645\u0646 \u0648\u0642\u062a\u0643",
  "preview_text": "\u062a\u0631\u064a\u0643\u0629 \u0628\u0633\u064a\u0637\u0629 \u062a\u0641\u0631\u0642 \u0641\u064a \u062f\u0642\u064a\u0642\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u0642\u0637. \u0644\u0627 \u062a\u0641\u0648\u062a\u0647\u0627.",
  "body_paragraphs": [
    "\u0644\u0645\u0627 \u062a\u0628\u062f\u0623 \u0628\u0643\u062a\u0627\u0628\u0629 \u0628\u062d\u062b \u062c\u062f\u064a\u062f\u060c \u0623\u0648\u0644 10 \u062f\u0642\u0627\u0626\u0642 \u0628\u062a\u0643\u0648\u0646 \u0623\u0635\u0639\u0628 \u0645\u0646 8 \u0633\u0627\u0639\u0627\u062a \u0628\u0639\u062f\u0647\u0627\u061f \u0647\u0630\u0627 \u0627\u0644\u0634\u0639\u0648\u0631 \u0628\u0627\u0644\u0641\u0631\u0627\u063a \u0642\u062f\u0627\u0645 \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0641\u0627\u0631\u063a\u0629 \u064a\u0636\u064a\u0639 \u0648\u0642\u062a\u0643 \u0648\u064a\u0647\u0632 \u062b\u0642\u062a\u0643. \u062c\u0631\u0628 \u062a\u0631\u064a\u0643\u0629 \u0648\u0627\u062d\u062f\u0629: \u0627\u0643\u062a\u0628 \u062c\u0645\u0644\u0629 \u0648\u062d\u062f\u0629 \u0639\u0646 \u0645\u0648\u0636\u0648\u0639\u0643 \u2013 \u0623\u064a \u062c\u0645\u0644\u0629\u060c \u062d\u062a\u0649 \u0644\u0648 \u063a\u0628\u064a\u0629.",
    "\u0647\u0630\u0647 \u0627\u0644\u062c\u0645\u0644\u0629 \u0627\u0644\u0628\u0633\u064a\u0637\u0629 \u062a\u0643\u0633\u0631 \u062d\u0627\u062c\u0632 \u0627\u0644\u0628\u062f\u0627\u064a\u0629 \u0648\u062a\u062d\u0631\u0643 \u0639\u0642\u0644\u0643. \u0628\u0639\u062f\u0647\u0627\u060c \u062e\u0630\u0647\u0627 \u0644\u0640 Thesis Generator \u0648\u062d\u0637\u0647\u0627 \u0647\u0646\u0627\u0643. \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u064a\u062d\u0648\u0644\u0647\u0627 \u0625\u0644\u0649 \u0628\u064a\u0627\u0646 \u0623\u0637\u0631\u0648\u062d\u0629 \u0642\u0648\u064a \u0641\u064a 10 \u062f\u0642\u0627\u0626\u0642 \u0628\u062f\u0644 8 \u0633\u0627\u0639\u0627\u062a \u0645\u0646 \u0627\u0644\u062a\u062e\u0628\u0637.",
    "\u0645\u0634 \u0628\u0633 \u0643\u0630\u0627\u060c \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u064a\u0636\u064a\u0641 \u0631\u0633\u0648\u0645 \u0628\u064a\u0627\u0646\u064a\u0629\u060c \u062c\u062f\u0627\u0648\u0644\u060c \u0648\u0627\u0633\u062a\u0634\u0647\u0627\u062f\u0627\u062a \u0628\u0634\u0643\u0644 \u062a\u0644\u0642\u0627\u0626\u064a\u060c \u0648\u064a\u0635\u0648\u0631 PDF \u062c\u0627\u0647\u0632 \u0644\u0644\u062a\u0633\u0644\u064a\u0645. \u0648\u0627\u0644\u0623\u0647\u0645: \u064a\u0642\u062f\u0631 \u064a\u0643\u062a\u0628 \u0646\u0635 \u0628\u0634\u0631\u064a \u064a\u062a\u062c\u0627\u0648\u0632 \u0623\u0646\u0638\u0645\u0629 \u0643\u0634\u0641 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0645\u062b\u0644 Turnitin \u0648GPTZero.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628 \u0647\u0627\u0644\u062a\u0631\u064a\u0643\u0629: \u0627\u0643\u062a\u0628 \u062c\u0645\u0644\u0629 \u0648\u062d\u062f\u0629 \u0648\u0636\u063a\u0637 '\u062a\u0648\u0644\u064a\u062f' \u2013 \u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0631\u0627\u062d \u062a\u0641\u0627\u062c\u0626\u0643. \u062a\u0630\u0643\u0631: 50,000 \u0637\u0627\u0644\u0628 \u0627\u0633\u062a\u062e\u062f\u0645\u0648\u0647 \u0648\u0631\u0641\u0639\u0648\u0627 \u0645\u0639\u062f\u0644\u0627\u062a\u0647\u0645 \u0645\u0646 B+ \u0625\u0644\u0649 A-.\n\n\u0645\u0644\u0627\u062d\u0638\u0629: \u0644\u0648 \u0645\u0627 \u062c\u0631\u0628\u062a\u0647 \u0627\u0644\u064a\u0648\u0645\u060c \u0628\u0643\u0631\u0629 \u0631\u0627\u062d \u062a\u0631\u062c\u0639 \u0644\u0646\u0641\u0633 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0641\u0627\u0631\u063a\u0629 \u0648\u062a\u0636\u064a\u0639 \u0648\u0642\u062a\u0643."
