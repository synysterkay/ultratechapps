{
  "subject": "\u0622\u062c \u06a9\u06cc \u0645\u06cc\u0686\u0648\u06ba \u0645\u06cc\u06ba 78% \u06a9\u0627\u0646\u0641\u06cc\u0688\u06cc\u0646\u0633 \u0648\u0627\u0644\u06cc \u067e\u06cc\u0634\u06af\u0648\u0626\u06cc",
  "preview_text": "\u06a9\u06cc\u0627 \u0622\u067e \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0622\u062c \u06a9\u06d2 \u06a9\u0686\u06be \u0645\u06cc\u0686\u0648\u06ba \u0645\u06cc\u06ba AI \u06a9\u06cc \u067e\u06cc\u0634\u06af\u0648\u0626\u06cc 78% \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u06a9\u0627\u0646\u0641\u06cc\u0688\u06cc\u0646\u0633 \u0631\u06a9\u06be\u062a\u06cc \u06c1\u06d2\u061f \u06cc\u06c1 \u0648\u06c1 \u0645\u0648\u0642\u0639 \u06c1\u06d2 \u062c\u0633\u06d2 \u0622\u067e \u0646\u06c1\u06cc\u06ba \u0686\u06be\u0648\u0691 \u0633\u06a9\u062a\u06d2\u06d4",
  "body_paragraphs": [
    "\u06a9\u0644 \u0631\u0627\u062a \u0645\u06cc\u06ba \u0646\u06d2 \u0627\u067e\u0646\u06d2 \u062f\u0648\u0633\u062a \u0633\u06d2 \u06a9\u06c1\u0627 \u06a9\u06c1 \u0648\u06c1 \u0645\u0627\u0646\u0686\u0633\u0679\u0631 \u0633\u0679\u06cc \u06a9\u06d2 \u0645\u06cc\u0686 \u0645\u06cc\u06ba \u0627\u067e\u0646\u06d2 \u067e\u06cc\u0633\u06d2 \u0646\u06c1 \u0644\u06af\u0627\u0626\u06d2\u060c \u06a9\u06cc\u0648\u0646\u06a9\u06c1 AI \u0646\u06d2 78% \u06a9\u0627\u0646\u0641\u06cc\u0688\u06cc\u0646\u0633 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0645\u062e\u0627\u0644\u0641 \u0679\u06cc\u0645 \u06a9\u06cc \u062c\u06cc\u062a \u067e\u06cc\u0634\u06af\u0648\u0626\u06cc \u06a9\u06cc \u062a\u06be\u06cc\u06d4 \u0627\u0633 \u0646\u06d2 \u0645\u06cc\u0631\u06cc \u0628\u0627\u062a \u0646\u06c1\u06cc\u06ba \u0645\u0627\u0646\u06cc \u0627\u0648\u0631 \u0622\u062c \u0635\u0628\u062d \u0627\u0633\u06d2 \u0627\u067e\u0646\u06cc \u063a\u0644\u0637\u06cc \u06a9\u0627 \u0627\u062d\u0633\u0627\u0633 \u06c1\u0648\u0627\u06d4",
    "\u0622\u062c \u06a9\u0627 \u062f\u0646 \u062e\u0627\u0635 \u06c1\u06d2 \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u067e\u0631\u06cc\u0645\u06cc\u0626\u0631 \u0644\u06cc\u06af\u060c \u0644\u0627 \u0644\u06cc\u06af\u0627\u060c \u0627\u0648\u0631 \u0628\u0646\u0688\u0633 \u0644\u06cc\u06af\u0627 \u06a9\u06d2 \u06a9\u0686\u06be \u0645\u06cc\u0686\u0632 \u0627\u06cc\u0633\u06d2 \u06c1\u06cc\u06ba \u062c\u06c1\u0627\u06ba AI \u0646\u06d2 70% \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u06a9\u0627\u0646\u0641\u06cc\u0688\u06cc\u0646\u0633 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u067e\u06cc\u0634\u06af\u0648\u0626\u06cc\u0627\u06ba \u06a9\u06cc \u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1 \u0648\u06c1 \u0645\u0648\u0642\u0639 \u06c1\u06d2 \u062c\u06c1\u0627\u06ba \u0622\u067e \u0627\u067e\u0646\u06d2 \u0627\u0646\u062f\u0627\u0632\u06d2 \u06a9\u0648 \u0688\u06cc\u0679\u0627 \u0633\u06d2 \u0628\u062f\u0644 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0635\u062d\u06cc\u062d \u0641\u06cc\u0635\u0644\u06c1 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",
    "Predictify \u06a9\u0627 \u0641\u06cc\u0686\u0631 \"AI \u0645\u06cc\u0686 \u0627\u06cc\u0646\u0627\u0644\u06cc\u0633\u0633\" \u0622\u067e \u06a9\u0648 \u06c1\u0631 \u0645\u06cc\u0686 \u06a9\u06d2 \u0644\u06cc\u06d2 78% \u06a9\u0627\u0646\u0641\u06cc\u0688\u06cc\u0646\u0633 \u0648\u0627\u0644\u06cc \u067e\u06cc\u0634\u06af\u0648\u0626\u06cc\u0627\u06ba \u062f\u06a9\u06be\u0627\u062a\u0627 \u06c1\u06d2\u060c \u062c\u0633 \u0645\u06cc\u06ba xG\u060c \u062f\u0641\u0627\u0639\u06cc \u0637\u0627\u0642\u062a\u060c \u0627\u0648\u0631 \u06c1\u06cc\u0688 \u0679\u0648 \u06c1\u06cc\u0688 \u06c1\u0633\u0679\u0631\u06cc \u0634\u0627\u0645\u0644 \u06c1\u06d2\u06d4 \u0622\u067e \u0627\u0633\u06d2 \u0622\u062c \u06c1\u06cc \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u062f\u06cc\u06a9\u06be \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0688\u06cc\u0679\u0627 \u06a9\u06cc\u0633\u06d2 \u0622\u067e \u06a9\u06cc \u062c\u06cc\u062a \u06a9\u0627 \u0631\u0627\u0633\u062a\u06c1 \u0628\u0646\u0627\u062a\u0627 \u06c1\u06d2\u06d4",
