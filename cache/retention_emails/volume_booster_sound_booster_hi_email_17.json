{
  "subject": "\u092e\u0948\u0902\u0928\u0947 \u0907\u0938 \u0910\u092a \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u0917\u0902\u092d\u0940\u0930 \u0917\u0932\u0924\u0940 \u0915\u0940 (37\u0935\u0947\u0902 \u0926\u093f\u0928 \u0915\u093e \u0938\u091a)",
  "preview_text": "\u091c\u092c \u092e\u0948\u0902\u0928\u0947 \u092f\u0939 3 \u092e\u093f\u0928\u091f \u0915\u0940 \u0930\u0942\u091f\u0940\u0928 \u0936\u0941\u0930\u0942 \u0915\u0940, \u0924\u094b \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u0917\u092f\u093e\u0964 \u0906\u092a \u092d\u0940 \u0907\u0938\u0947 \u0906\u091c\u092e\u093e\u090f\u0902\u0964",
  "body_paragraphs": [
    "\u0915\u094d\u092f\u093e \u0906\u092a \u092d\u0940 \u0909\u0928 90% \u0932\u094b\u0917\u094b\u0902 \u092e\u0947\u0902 \u0939\u0948\u0902 \u091c\u094b \u092c\u0938 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0915\u0930 \u0910\u092a \u092c\u0902\u0926 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902? \u092e\u0948\u0902 \u0910\u0938\u093e \u0939\u0940 \u0915\u0930\u0924\u093e \u0925\u093e\u0964 \u092b\u093f\u0930 \u092e\u0941\u091d\u0947 \u090f\u0939\u0938\u093e\u0938 \u0939\u0941\u0906 \u0915\u093f \u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u0940 \u0905\u0938\u0932\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u092d\u0940 \u0938\u0941\u0928 \u0939\u0940 \u0928\u0939\u0940\u0902 \u092a\u093e\u092f\u093e\u0964",
    "\u090f\u0915 \u0926\u093f\u0928 \u092e\u0948\u0902\u0928\u0947 \u0916\u0941\u0926 \u0938\u0947 \u0935\u093e\u0926\u093e \u0915\u093f\u092f\u093e: \u0905\u0917\u0932\u0947 7 \u0926\u093f\u0928, \u0930\u094b\u091c \u0938\u093f\u0930\u094d\u092b 3 \u092e\u093f\u0928\u091f\u0964 \u0939\u0930 \u0926\u093f\u0928 \u090f\u0915 \u0928\u092f\u093e EQ \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091f\u0947\u0938\u094d\u091f \u0915\u0930\u0928\u093e\u0964 \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 '\u092c\u093e\u0938 \u092c\u0942\u0938\u094d\u091f\u0930' \u0915\u0947 \u0938\u093e\u0925 \u0939\u093f\u092a-\u0939\u0949\u092a\u0964 \u0926\u0942\u0938\u0930\u0947 \u0926\u093f\u0928 '\u092a\u0949\u092a' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u092a\u0930 \u092a\u0941\u0930\u093e\u0928\u0947 \u0917\u093e\u0928\u0947\u0964 \u0924\u0940\u0938\u0930\u0947 \u0926\u093f\u0928 '\u0915\u094d\u0932\u093e\u0938\u093f\u0915\u0932' \u092e\u094b\u0921 \u092a\u0930 \u0915\u094b\u0908 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f\u0964 \u0926\u094b\u0938\u094d\u0924, \u092f\u0939 \u0935\u0939 \u0905\u0928\u0941\u092d\u0935 \u0925\u093e \u091c\u093f\u0938\u0915\u093e \u092e\u0948\u0902 \u0938\u093e\u0932\u094b\u0902 \u0938\u0947 \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964 \u0905\u092c \u092e\u0947\u0930\u0940 \u0906\u0926\u0924 \u092c\u0928 \u0917\u0908 \u0939\u0948 - \u0939\u0930 \u0938\u0941\u092c\u0939 \u0915\u0949\u092b\u0940 \u0915\u0947 \u0938\u093e\u0925 3 \u092e\u093f\u0928\u091f \u0915\u093e '\u0938\u093e\u0909\u0902\u0921 \u0938\u0947\u091f\u0905\u092a'\u0964 \u092f\u0939\u0940 \u0935\u0939 \u0930\u0939\u0938\u094d\u092f \u0939\u0948 \u091c\u093f\u0938\u0938\u0947 \u092f\u0939 \u0910\u092a 10 \u0917\u0941\u0928\u093e \u092c\u0947\u0939\u0924\u0930 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "\u092f\u0939 \u0938\u092c '\u092c\u093f\u0932\u094d\u091f-\u0907\u0928 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930' \u0915\u0940 \u0935\u091c\u0939 \u0938\u0947 \u0938\u0902\u092d\u0935 \u0939\u0941\u0906\u0964 \u0939\u0930 \u091c\u0947\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u0964 \u0930\u0949\u0915 \u0938\u0941\u0928 \u0930\u0939\u0947 \u0939\u0948\u0902? \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a\u0964 \u091c\u0948\u091c\u093c \u091a\u093e\u0939\u093f\u090f? \u0926\u0942\u0938\u0930\u093e \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u0964 \u092f\u0939 \u0910\u092a \u0924\u092c \u0924\u0915 \u0906\u0927\u093e \u0905\u0927\u0942\u0930\u093e \u0939\u0948 \u091c\u092c \u0924\u0915 \u0906\u092a \u0939\u0930 \u0926\u093f\u0928 \u0907\u0928 \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0916\u0947\u0932\u0928\u093e \u0928\u0939\u0940\u0902 \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u0947\u0964 \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u0939\u0930 \u0926\u093f\u0928 \u090f\u0915 \u0928\u090f \u0938\u094d\u092a\u0940\u0915\u0930 \u0915\u0940 \u0924\u0930\u0939 \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0917\u093e\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 'EQ' \u091f\u0948\u092c \u092a\u0930 \u091c\u093e\u090f\u0902\u0964 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0906\u091c\u092e\u093e\u090f\u0902 - \u091c\u094b \u092d\u0940 \u0906\u092a\u0915\u0940 \u092e\u0942\u0921 \u0915\u0947 \u0905\u0928\u0941\u0915\u0942\u0932 \u0939\u094b\u0964 \u092c\u0938 3 \u092e\u093f\u0928\u091f\u0964 \u092f\u0939 \u0906\u0926\u0924 \u0906\u092a\u0915\u0947 \u0911\u0921\u093f\u092f\u094b \u0905\u0928\u0941\u092d\u0935 \u0915\u094b \u0939\u092e\u0947\u0936\u093e \u0915\u0947 \u0932\u093f\u090f \u092c\u0926\u0932 \u0926\u0947\u0917\u0940\u0964 \u092a\u0940.\u090f\u0938. \u092e\u0948\u0902 \u0905\u092c '\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u092a\u0930 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u0924\u093e \u0939\u0942\u0902... \u0914\u0930 \u0939\u0930 \u0936\u092c\u094d\u0926 \u0915\u094d\u0930\u093f\u0938\u094d\u091f\u0932 \u0915\u094d\u0932\u093f\u092f\u0930 \u0906\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0935\u0939 \u0939\u0945\u0915 \u0939\u0948 \u091c\u093f\u0938\u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0915\u094b\u0908 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964"
  ],
