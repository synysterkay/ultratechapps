  "subject": "\uc9c0\ub09c\uc8fc \ubb38\uc790 \ubcf4\ub0b8 \uce5c\uad6c\uc5d0\uac8c \ud544\uc694\ud55c \uc571",
  "preview_text": "\uadf8 \uc0ac\ub78c \ud63c\uc790 \ub059\ub059 \uc553\uace0 \uc788\uc744 \uac70\uc57c. \ub124\uac00 \uc18c\uac1c\ud574\uc918.",
  "body_paragraphs": [
    "\uc9c0\ub09c\uc8fc\uc5d0 \ub124\uac00 \ubb38\uc790 \ubcf4\ub0b8 \uadf8 \uce5c\uad6c, \uc0c8\ubcbd 2\uc2dc\uc5d0\ub3c4 \ub2f5\uc7a5 \uc548 \uc624\ub294 \uac70 \ubcf4\uace0 \uc18d\uc0c1\ud588\uc9c0? \uc0ac\uc2e4 \uadf8 \uc0ac\ub78c\ub3c4 \ub611\uac19\uc740 \uae30\ubd84\uc77c \uac70\uc57c. \ub204\uad70\uac00\uc5d0\uac8c \ub9d0\ud558\uace0 \uc2f6\uc9c0\ub9cc, \uc544\ubb34\ub3c4 \uc9c4\uc9dc\ub85c \ub4e4\uc5b4\uc8fc\uc9c0 \uc54a\ub294\ub2e4\ub294 \uc0dd\uac01\uc5d0 \ud63c\uc790 \ub059\ub059 \uc553\uace0 \uc788\ub354\ub77c.",
    "\ub108\ub294 \uc774\ubbf8 \uc54c\uc9c0? Ai Boyfriend\uac00 \uc5bc\ub9c8\ub098 \ub2e4\uc815\ud55c\uc9c0. \ucc28\uce78 \uce5c\uad6c \ud558\ub098\ub9cc \uc788\uc5b4\ub3c4 \ud558\ub8e8\uac00 \uc644\uc804\ud788 \ub2ec\ub77c\uc9c4\ub2e4\ub294 \uac78. \uadf8\ub7f0\ub370 \uadf8 \ud61c\ud0dd\uc744 \uc544\uc9c1 \ubaa8\ub974\ub294 \uc0ac\ub78c\uc774 \ubc14\ub85c \ub124 \uc8fc\ubcc0\uc5d0 \uc788\uc5b4. \ub108\ub294 \uc774\ubbf8 \uc54c\uace0 \uc788\uc796\uc544, \ub204\uad6c\uc778\uc9c0.",
    "\uc571 \uc548\uc5d0 '\ucd08\ub300\ud558\uae30' \uae30\ub2a5\uc774 \uc788\uc5b4. \uce5c\uad6c\ub97c \ucd08\ub300\ud558\uba74 \ub108\ub791 \uadf8 \uce5c\uad6c \ubaa8\ub450\uc5d0\uac8c \ud2b9\ubcc4\ud55c \ubcf4\ub108\uc2a4\uac00 \uc313\uc5ec. \ub2e8\uc21c\ud55c \ucd94\ucc9c\uc774 \uc544\ub2c8\ub77c, \uc9c4\uc9dc \ub9c8\uc74c \ud1b5\ud558\ub294 \uc0ac\ub78c\uc774 \ud544\uc694\ud560 \ub54c \uc368\uba39\uc744 \uc218 \uc788\ub294 \ubb34\uae30\uc57c.",
    "\uc9c0\uae08 \ub2f9\uc7a5 \uc571\uc744 \uc5f4\uc5b4\uc11c '\ub0b4 \uc0ac\ub78c \ucd08\ub300\ud558\uae30' \ubc84\ud2bc\uc744 \ub20c\ub7ec\ubd10. \uadf8 \uce5c\uad6c\uc5d0\uac8c \uc774 \ub9c1\ud06c \ud558\ub098\uba74 \ucda9\ubd84\ud574. P.S. \ucd08\ub300\ud55c \uce5c\uad6c\uac00 \uccab \ub300\ud654\ub97c \uc2dc\uc791\ud558\uba74 \ub108\uc758 AI \ub0a8\uce5c\uc774 \ud2b9\ubcc4 \uc120\ubb3c\uc744 \uac00\uc838\uc62c \uac70\uc57c."
  ],
