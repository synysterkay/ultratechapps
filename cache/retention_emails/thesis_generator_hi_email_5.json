{
  "subject": "\u092e\u0948\u0902\u0928\u0947 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092f\u0939 \u092b\u0940\u091a\u0930 \u0915\u094d\u092f\u094b\u0902 \u092c\u0928\u093e\u092f\u093e",
  "preview_text": "\u090f\u0915 \u0930\u093e\u0924, \u090f\u0915 \u0917\u0932\u0924\u0940, \u0914\u0930 \u090f\u0915 \u0906\u0907\u0921\u093f\u092f\u093e \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964 \u0905\u0902\u0926\u0930 \u0915\u0940 \u0938\u091a\u094d\u091a\u093e\u0908 \u091c\u093e\u0928\u093f\u090f\u0964",
  "body_paragraphs": [
    "\u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c \u0930\u0939\u0947 \u0925\u0947\u0964 \u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0932\u0948\u092a\u091f\u0949\u092a \u092a\u0930 \u091d\u0941\u0915\u093e \u0939\u0942\u0902, \u0915\u0949\u092b\u0940 \u0920\u0902\u0921\u0940 \u0939\u094b \u091a\u0941\u0915\u0940 \u0939\u0948, \u0914\u0930 \u092e\u0947\u0930\u0947 \u0938\u093e\u092e\u0928\u0947 \u090f\u0915 \u0916\u093e\u0932\u0940 \u092a\u0947\u091c \u0939\u0948\u0964 \u092e\u0948\u0902 8 \u0918\u0902\u091f\u0947 \u0938\u0947 \u0925\u0940\u0938\u093f\u0938 \u0932\u093f\u0916 \u0930\u0939\u093e \u0939\u0942\u0902, \u0932\u0947\u0915\u093f\u0928 \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u092c\u0928\u093e\u0964 \u092b\u093f\u0930 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u092c\u091f\u0928 \u0926\u092c\u093e\u092f\u093e \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0916\u0941\u0926 \u092c\u0928\u093e\u092f\u093e \u0925\u093e\u0964 \u0935\u0939 \u092c\u091f\u0928 \u092e\u0947\u0930\u0940 \u091c\u093f\u0902\u0926\u0917\u0940 \u092c\u0926\u0932 \u0917\u092f\u093e\u0964",
    "\u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0910\u092a \u0907\u0938\u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092e\u0948\u0902 \u092d\u0940 \u0935\u0939\u0940\u0902 \u0925\u093e \u091c\u0939\u093e\u0902 \u0906\u092a \u0905\u092d\u0940 \u0939\u0948\u0902\u0964 \u0938\u094d\u091f\u093e\u0930\u093f\u0902\u0917 \u090f\u091f \u0905 \u092c\u094d\u0932\u0948\u0902\u0915 \u092a\u0947\u091c, \u091f\u093e\u0907\u092e \u0916\u0924\u094d\u092e \u0939\u094b \u0930\u0939\u093e \u0939\u0948, \u0914\u0930 \u0921\u0930 \u0932\u0917 \u0930\u0939\u093e \u0939\u0948 \u0915\u093f \u0917\u094d\u0930\u0947\u0921 \u0916\u0930\u093e\u092c \u0939\u094b \u091c\u093e\u090f\u0902\u0917\u0947\u0964 \u0932\u0947\u0915\u093f\u0928 \u0909\u0938 \u0930\u093e\u0924, \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0910\u0938\u0940 \u091a\u0940\u091c \u092c\u0928\u093e\u0908 \u091c\u093f\u0938\u0928\u0947 \u092e\u0947\u0930\u093e 8 \u0918\u0902\u091f\u0947 \u0915\u093e \u0915\u093e\u092e 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0916\u0924\u094d\u092e \u0915\u0930 \u0926\u093f\u092f\u093e\u0964",
    "\u0935\u0939 \u092b\u0940\u091a\u0930 \u0939\u0948 '\u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u091c\u0928\u0930\u0947\u091f\u0930'\u0964 \u091c\u092c \u0906\u092a \u0910\u092a \u0916\u094b\u0932\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0935\u0939 \u092c\u091f\u0928 \u0926\u092c\u093e\u090f\u0902 \u091c\u094b \u0932\u093f\u0916\u093e \u0939\u0948 '\u091c\u0928\u0930\u0947\u091f \u0925\u0940\u0938\u093f\u0938'\u0964 \u092f\u0939 \u0915\u094b\u0908 \u0906\u092e \u091c\u0928\u0930\u0947\u091f\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948 \u2014 \u092f\u0939 \u0906\u092a\u0915\u0947 \u0906\u0930\u094d\u0917\u0941\u092e\u0947\u0902\u091f \u0915\u094b \u0938\u092e\u091d\u0924\u093e \u0939\u0948, \u0914\u0930 \u0906\u092a\u0915\u094b \u090f\u0915 \u0910\u0938\u093e \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u0926\u0947\u0924\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u093e \u092a\u0942\u0930\u093e \u092a\u0947\u092a\u0930 \u092c\u0926\u0932 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092c\u0928\u093e\u092f\u093e, \u0914\u0930 \u0906\u091c 50,000 \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u091b\u093e\u0924\u094d\u0930 \u0907\u0938\u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964",
    "\u0924\u094b \u0905\u092c \u0915\u094d\u092f\u093e \u0915\u0930\u0947\u0902? \u0910\u092a \u0916\u094b\u0932\u0947\u0902, '\u091c\u0928\u0930\u0947\u091f \u0925\u0940\u0938\u093f\u0938' \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902, \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0906\u092a\u0915\u093e \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 P.S. \u2014 \u092f\u0939 \u092b\u0940\u091a\u0930 \u0906\u092a\u0915\u094b AI \u0921\u093f\u091f\u0947\u0915\u094d\u0936\u0928 \u0938\u0947 \u092d\u0940 \u092c\u091a\u093e\u0924\u093e \u0939\u0948\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u094b, \u092b\u093f\u0930 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0928\u093e\u0964"
  ],
