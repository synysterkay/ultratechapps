{
  "subject": "\u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092c\u0928\u093e\u0908 \u0917\u0908 \u090f\u0915 \u092b\u0940\u091a\u0930 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940",
  "preview_text": "\u091c\u092c \u092e\u0948\u0902 \u0916\u0941\u0926 \u092a\u0947\u092a\u0930 \u0932\u093f\u0916\u0924\u0947-\u0932\u093f\u0916\u0924\u0947 \u092a\u0930\u0947\u0936\u093e\u0928 \u0939\u094b \u0917\u092f\u093e \u0925\u093e, \u0924\u092c \u092f\u0939 \u0906\u0907\u0921\u093f\u092f\u093e \u0906\u092f\u093e\u0964 \u0905\u092c \u0924\u0915 50,000 \u091b\u093e\u0924\u094d\u0930 \u0907\u0938\u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u091a\u0941\u0915\u0947 \u0939\u0948\u0902\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 \u0938\u0947\u092e\u0947\u0938\u094d\u091f\u0930 \u092e\u0947\u0902, \u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u092a\u0930 \u0918\u0902\u091f\u094b\u0902 \u092c\u0948\u0920\u093e \u0930\u0939\u093e\u0964 \u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c\u0947 \u0925\u0947, \u0906\u0902\u0916\u094b\u0902 \u0938\u0947 \u0928\u0940\u0902\u0926 \u0917\u093e\u092f\u092c \u0925\u0940, \u0914\u0930 \u0926\u093f\u092e\u093e\u0917 \u092e\u0947\u0902 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0939\u0940 \u0938\u0935\u093e\u0932 \u0925\u093e - \u092f\u0939 \u0915\u092c \u0916\u0924\u094d\u092e \u0939\u094b\u0917\u093e? \u0924\u092d\u0940 \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e, \u0915\u094d\u092f\u094b\u0902 \u0928 \u0915\u0941\u091b \u0910\u0938\u093e \u092c\u0928\u093e\u092f\u093e \u091c\u093e\u090f \u091c\u094b \u0907\u0938 \u092a\u0940\u0921\u093c\u093e \u0915\u094b \u0915\u092e \u0915\u0930\u0947?",
    "\u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0940 \u0921\u093e\u092f\u0930\u0940 \u092e\u0947\u0902 \u090f\u0915 \u0932\u093e\u0907\u0928 \u0932\u093f\u0916\u0940 - '\u0925\u0940\u0938\u093f\u0938 \u091c\u0947\u0928\u0930\u0947\u091f\u0930: 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0925\u0940\u0938\u093f\u0938, 8 \u0918\u0902\u091f\u0947 \u0928\u0939\u0940\u0902\u0964' \u0909\u0938 \u0930\u093e\u0924 \u092e\u0948\u0902\u0928\u0947 \u0915\u094b\u0921\u093f\u0902\u0917 \u0936\u0941\u0930\u0942 \u0915\u0940\u0964 \u092e\u0948\u0902 \u091a\u093e\u0939\u0924\u093e \u0925\u093e \u0915\u093f \u0939\u0930 \u091b\u093e\u0924\u094d\u0930 \u0915\u094b \u0935\u0939 \u0930\u093e\u0939\u0924 \u092e\u093f\u0932\u0947 \u091c\u094b \u092e\u0941\u091d\u0947 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940 \u0925\u0940\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u091f\u0942\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948, \u092f\u0939 \u0906\u092a\u0915\u0940 \u092e\u0947\u0902\u091f\u0932 \u092a\u0940\u0938 \u092c\u091a\u093e\u0928\u0947 \u0915\u093e \u0924\u0930\u0940\u0915\u093e \u0939\u0948\u0964",
    "\u0909\u0938 2AM \u0915\u0940 \u091c\u093f\u0926 \u0928\u0947 \u0906\u091c \u0939\u092e\u093e\u0930\u093e '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c \u090f\u0906\u0908 \u091f\u0947\u0915\u094d\u0938\u094d\u091f' \u092b\u0940\u091a\u0930 \u091c\u0928\u094d\u092e \u0932\u093f\u092f\u093e\u0964 \u091c\u092c \u0906\u092a \u091f\u0930\u094d\u0928\u093f\u091f\u093f\u0928 \u092f\u093e GPTZero \u0938\u0947 \u092c\u091a\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u092f\u0939 \u092b\u0940\u091a\u0930 \u0906\u092a\u0915\u0947 \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0915\u094b \u0907\u0924\u0928\u093e \u0928\u0947\u091a\u0941\u0930\u0932 \u092c\u0928\u093e \u0926\u0947\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u094b\u0908 AI \u0921\u093f\u091f\u0947\u0915\u094d\u091f\u0930 \u092a\u0915\u0921\u093c \u0928\u0939\u0940\u0902 \u0938\u0915\u0924\u093e\u0964 \u092f\u0939 \u0935\u0939\u0940 \u091a\u0940\u091c \u0939\u0948 \u091c\u094b \u092e\u0948\u0902 \u0916\u0941\u0926 \u0905\u092a\u0928\u0947 \u092a\u0947\u092a\u0930 \u0915\u0947 \u0932\u093f\u090f \u091a\u093e\u0939\u0924\u093e \u0925\u093e\u0964",
    "\u0905\u092c \u0906\u092a\u0915\u0940 \u092c\u093e\u0930\u0940 \u0939\u0948\u0964 \u0905\u092a\u0928\u0947 \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u0915\u094b \u091c\u0947\u0928\u0930\u0947\u091f \u0915\u0930\u0947\u0902 \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0905\u0917\u0930 \u0906\u092a\u0915\u094b \u0915\u094b\u0908 \u0926\u093f\u0915\u094d\u0915\u0924 \u0906\u090f, \u0924\u094b \u092e\u0941\u091d\u0947 \u0938\u0940\u0927\u093e \u0930\u093f\u092a\u094d\u0932\u093e\u0908 \u0915\u0930\u0947\u0902 - \u092e\u0948\u0902 \u0916\u0941\u0926 \u0906\u092a\u0915\u0940 \u092e\u0926\u0926 \u0915\u0930\u0942\u0902\u0917\u093e\u0964 P.S. - \u092f\u0939 \u092b\u0940\u091a\u0930 \u0938\u093f\u0930\u094d\u092b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0906\u091c \u0906\u092a \u0907\u0938\u0947 \u092b\u094d\u0930\u0940 \u092e\u0947\u0902 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
  ],
