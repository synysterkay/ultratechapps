{
  "subject": "\u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u06a9\u0647 \u06f7\u06f0 \u0631\u0648\u0632 \u0628\u0639\u062f \u0627\u0632 \u062a\u0648 \u0633\u0627\u062e\u062a\u0647 \u0634\u062f",
  "preview_text": "\u062a\u0648 \u0641\u0642\u0637 \u06a9\u0627\u0631\u0628\u0631 \u0646\u0628\u0648\u062f\u06cc\u060c \u0628\u062e\u0634\u06cc \u0627\u0632 \u0686\u06cc\u0632\u06cc \u0628\u0632\u0631\u06af\u200c\u062a\u0631 \u0634\u062f\u06cc. \u062f\u0627\u0633\u062a\u0627\u0646 \u0648\u0627\u0642\u0639\u06cc \u06cc\u06a9\u06cc \u0627\u0632 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc\u200c\u0647\u0627\u06cc AI \u06a9\u0647 \u0628\u0627 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u062a\u0648 \u062f\u0631\u0633\u062a \u0634\u062f.",
  "body_paragraphs": [
    "\u06f7\u06f0 \u0631\u0648\u0632 \u067e\u06cc\u0634\u060c \u0648\u0642\u062a\u06cc \u0628\u0631\u0627\u06cc \u0627\u0648\u0644\u06cc\u0646 \u0628\u0627\u0631 Predictify \u0631\u0648 \u0646\u0635\u0628 \u06a9\u0631\u062f\u06cc\u060c \u0645\u0646 \u06cc\u06a9 \u0686\u06cc\u0632 \u0631\u0648 \u0645\u06cc\u200c\u062f\u0648\u0646\u0633\u062a\u0645: \u062a\u0648 \u0641\u0642\u0637 \u0628\u0647 \u062f\u0646\u0628\u0627\u0644 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u0646\u0628\u0648\u062f\u06cc. \u062a\u0648 \u0628\u0647 \u062f\u0646\u0628\u0627\u0644 \u06cc\u0647 \u062d\u0633 \u0628\u0648\u062f\u06cc. \u062d\u0633 \u0627\u06cc\u0646\u06a9\u0647 \u0628\u0641\u0647\u0645\u06cc \u0686\u0631\u0627 \u06cc\u0647 \u062a\u06cc\u0645 \u062e\u0627\u0635 \u0628\u0631\u0646\u062f\u0647 \u0645\u06cc\u200c\u0634\u0647\u060c \u0686\u0631\u0627 \u06cc\u0647 \u06af\u0644 \u062e\u0627\u0635 \u062a\u0648 \u062f\u0642\u06cc\u0642\u0647 \u06f8\u06f8 \u0645\u06cc\u0627\u062f. \u0648 \u0627\u0644\u0627\u0646\u060c \u0628\u0639\u062f \u0627\u0632 \u06f7\u06f0 \u0631\u0648\u0632\u060c \u062a\u0648\u06cc \u062f\u06cc\u062a\u0627\u06cc \u0645\u0627 \u0631\u062f\u067e\u0627\u06cc \u062a\u0648 \u0647\u0633\u062a.",
    "AI \u0645\u0627 \u0647\u0632\u0627\u0631\u0627\u0646 \u0645\u062a\u063a\u06cc\u0631 \u0631\u0648 \u0628\u0631\u0627\u06cc \u0647\u0631 \u0628\u0627\u0632\u06cc \u062a\u062d\u0644\u06cc\u0644 \u0645\u06cc\u200c\u06a9\u0646\u0647\u060c \u0627\u0645\u0627 \u0686\u06cc\u0632\u06cc \u06a9\u0647 \u0627\u06cc\u0646 \u062a\u062d\u0644\u06cc\u0644 \u0631\u0648 \u062e\u0627\u0635 \u0645\u06cc\u200c\u06a9\u0646\u0647 \u062e\u0648\u062f\u062a \u0647\u0633\u062a\u06cc. \u0647\u0631 \u0628\u0627\u0631 \u06a9\u0647 \u06cc\u0647 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u0631\u0648 \u0630\u062e\u06cc\u0631\u0647 \u06a9\u0631\u062f\u06cc\u060c \u0647\u0631 \u0628\u0627\u0631 \u06a9\u0647 \u062a\u0648\u06cc IQ Quiz \u0634\u0631\u06a9\u062a \u06a9\u0631\u062f\u06cc\u060c \u06cc\u0647 \u062a\u06cc\u06a9\u0647 \u0627\u0632 \u0647\u0648\u0634 \u062a\u0648 \u0628\u0647 \u0627\u0644\u06af\u0648\u0631\u06cc\u062a\u0645 \u0627\u0636\u0627\u0641\u0647 \u0634\u062f. \u062a\u0648 \u0641\u0642\u0637 \u06cc\u0647 \u06a9\u0627\u0631\u0628\u0631 \u0646\u06cc\u0633\u062a\u06cc \u2013 \u062a\u0648 \u0628\u062e\u0634\u06cc \u0627\u0632 \u06cc\u0647 \u0645\u0623\u0645\u0648\u0631\u06cc\u062a \u0647\u0633\u062a\u06cc \u0628\u0631\u0627\u06cc \u0633\u0627\u062e\u062a\u0646 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0633\u06cc\u0633\u062a\u0645 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u0641\u0648\u062a\u0628\u0627\u0644 \u062f\u0646\u06cc\u0627.",
    "\u06cc\u0627\u062f\u062a \u0645\u06cc\u0627\u062f \u0647\u0641\u062a\u0647 \u067e\u06cc\u0634 \u06a9\u0647 \u06cc\u0647 \u0628\u0627\u0632\u06cc \u0627\u0632 \u0628\u0648\u0646\u062f\u0633\u0644\u06cc\u06af\u0627 \u0631\u0648 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u06a9\u0631\u062f\u06cc \u0648 AI \u0628\u0647\u062a \u06f8\u06f5\u066a \u0627\u0637\u0645\u06cc\u0646\u0627\u0646 \u062f\u0627\u062f\u061f \u0627\u0648\u0646 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u0641\u0642\u0637 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0622\u0645\u0627\u0631 \u0646\u0628\u0648\u062f. \u0628\u0631 \u0627\u0633\u0627\u0633 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0647\u0632\u0627\u0631\u0627\u0646 \u06a9\u0627\u0631\u0628\u0631 \u0645\u062b\u0644 \u062a\u0648 \u0628\u0648\u062f \u06a9\u0647 \u0647\u0631 \u0631\u0648\u0632 \u062a\u0648\u06cc Communities \u0628\u062d\u062b \u0645\u06cc\u200c\u06a9\u0646\u0646 \u0648 \u0631\u0648\u06cc Prediction of the Day \u0631\u0623\u06cc \u0645\u06cc\u200c\u062f\u0646. \u062a\u0648 \u062d\u0627\u0644\u0627 \u0628\u062e\u0634\u06cc \u0627\u0632 \u06cc\u0647 \u062c\u0646\u0628\u0634 \u0647\u0633\u062a\u06cc.",
    "\u0627\u0645\u0634\u0628\u060c \u06cc\u0647 \u0628\u0627\u0632\u06cc \u062e\u0627\u0635 \u062a\u0648\u06cc \u0628\u0631\u0646\u0627\u0645\u0647 \u0647\u0633\u062a \u06a9\u0647 AI \u0628\u0647\u0634 \u06f7\u06f5\u066a \u0627\u0637\u0645\u06cc\u0646\u0627\u0646 \u0645\u06cc\u062f\u0647. \u0628\u06cc\u0627 \u0628\u0628\u06cc\u0646\u06cc\u0645 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc\u200c\u0627\u062a \u0686\u0642\u062f\u0631 \u062f\u0631\u0633\u062a \u0627\u0632 \u0622\u0628 \u062f\u0631\u0645\u06cc\u0627\u062f. \u0641\u0642\u0637 \u06a9\u0627\u0641\u06cc\u0647 \u0627\u067e \u0631\u0648 \u0628\u0627\u0632 \u06a9\u0646\u06cc \u0648 \u062a\u0648\u06cc \u0628\u062e\u0634 Predictions \u0646\u06af\u0627\u0647 \u06a9\u0646\u06cc. P.S. \u06cc\u0627\u062f\u062a \u0646\u0631\u0647 \u0627\u0633\u062a\u0631\u06cc\u06a9 \u0631\u0648\u0632\u0627\u0646\u0647\u200c\u0627\u062a \u0631\u0648 \u0647\u0645 \u0628\u0632\u0646\u06cc \u2013 \u0628\u0639\u062f \u0627\u0632 \u06f7\u06f0 \u0631\u0648\u0632\u060c \u0645\u06cc\u200c\u062a\u0648\u0646\u06cc \u0628\u062c \u06f7\u06f0 \u0631\u0648\u0632\u0647 \u0631\u0648 \u0628\u06af\u06cc\u0631\u06cc."
  ],
