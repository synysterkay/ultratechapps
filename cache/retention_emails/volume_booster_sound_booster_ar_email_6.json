{
  "subject": "\u0627\u0644\u062e\u0637\u0623 \u0627\u0644\u0648\u062d\u064a\u062f \u0627\u0644\u0630\u064a \u064a\u062e\u0631\u0628 \u0635\u0648\u062a \u0647\u0627\u062a\u0641\u0643",
  "preview_text": "\u0645\u0639\u0638\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u0642\u0639\u0648\u0646 \u0641\u064a\u0647 \u0648\u064a\u062e\u0633\u0631\u0648\u0646 \u062c\u0648\u062f\u0629 \u0627\u0644\u0635\u0648\u062a. \u0627\u0643\u062a\u0634\u0641 \u0627\u0644\u062d\u0644 \u0627\u0644\u0628\u0633\u064a\u0637 \u0627\u0644\u0622\u0646",
  "body_paragraphs": [
    "\u0623\u0639\u062a\u0631\u0641 \u0644\u0643 \u0628\u0634\u064a\u0621: \u0623\u0648\u0644 \u0645\u0631\u0629 \u0627\u0633\u062a\u062e\u062f\u0645\u062a \u0641\u064a\u0647\u0627 \u062a\u0637\u0628\u064a\u0642 \u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0635\u0648\u062a\u060c \u0638\u0646\u0646\u062a \u0623\u0646 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0644\u0623\u0642\u0635\u0649 \u062d\u062f \u0647\u0648 \u0627\u0644\u062d\u0644. \u0643\u0646\u062a \u0623\u0631\u0641\u0639 \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0625\u0644\u0649 200% \u0648\u0623\u062a\u0648\u0642\u0639 \u0633\u0645\u0627\u0639 \u0645\u0648\u0633\u064a\u0642\u0649 \u0646\u0642\u064a\u0629\u060c \u0644\u0643\u0646 \u0645\u0627 \u062d\u0635\u0644 \u0643\u0627\u0646 \u0639\u0643\u0633 \u0630\u0644\u0643 \u062a\u0645\u0627\u0645\u0627\u064b \u2014 \u062a\u0634\u0648\u064a\u0634 \u0645\u0632\u0639\u062c \u0648\u0635\u0648\u062a \u0645\u0643\u0633\u0648\u0631. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u062e\u0637\u0623 \u0631\u0642\u0645 1 \u0627\u0644\u0630\u064a \u064a\u0642\u0639 \u0641\u064a\u0647 9 \u0645\u0646 \u0643\u0644 10 \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u062c\u062f\u062f.",
    "\u0627\u0644\u0633\u0628\u0628 \u0623\u0646 \u0627\u0644\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0623\u0639\u0645\u0649 \u064a\u0636\u063a\u0637 \u0639\u0644\u0649 \u0645\u0643\u0628\u0631\u0627\u062a \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0636\u0639\u064a\u0641\u0629 \u0641\u064a \u0647\u0627\u062a\u0641\u0643\u060c \u0641\u064a\u062a\u062d\u0648\u0644 \u0627\u0644\u0635\u0648\u062a \u0625\u0644\u0649 \u0636\u0648\u0636\u0627\u0621. \u0644\u0643\u0646 \u0627\u0644\u062e\u0628\u0631 \u0627\u0644\u0633\u0627\u0631: \u0647\u0646\u0627\u0643 \u0637\u0631\u064a\u0642\u0629 \u0628\u0633\u064a\u0637\u0629 \u0644\u062a\u062c\u0646\u0628 \u0647\u0630\u0627 \u0627\u0644\u0643\u0627\u0628\u0648\u0633. \u0643\u0644 \u0645\u0627 \u062a\u062d\u062a\u0627\u062c\u0647 \u0647\u0648 \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u062a\u0631\u062f\u062f\u0627\u062a \u0642\u0628\u0644 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a.",
    "\u0644\u0647\u0630\u0627 \u0635\u0645\u0645\u0646\u0627 \u0645\u0639\u0627\u062f\u0644 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u062f\u0645\u062c \u0641\u064a Volume Booster. \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0635\u0648\u062a \u0628\u0637\u0631\u064a\u0642\u0629 \u0639\u0634\u0648\u0627\u0626\u064a\u0629\u060c \u0627\u062e\u062a\u0631 \u0625\u062d\u062f\u0649 \u0627\u0644\u0628\u0627\u0642\u0627\u062a \u0627\u0644\u062c\u0627\u0647\u0632\u0629 \u0645\u062b\u0644 '\u0631\u0648\u0643' \u0623\u0648 '\u062c\u0627\u0632' \u0623\u0648 '\u0643\u0644\u0627\u0633\u064a\u0643'. \u0647\u0630\u0647 \u0627\u0644\u0628\u0627\u0642\u0627\u062a \u062a\u0648\u0627\u0632\u0646 \u0627\u0644\u062a\u0631\u062f\u062f\u0627\u062a \u0627\u0644\u0645\u0646\u062e\u0641\u0636\u0629 \u0648\u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0629 \u0648\u0627\u0644\u0639\u0627\u0644\u064a\u0629\u060c \u0641\u062a\u062d\u0635\u0644 \u0639\u0644\u0649 \u0635\u0648\u062a \u0642\u0648\u064a \u062f\u0648\u0646 \u062a\u0634\u0648\u064a\u0647. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646 \u0648\u0633\u062a\u0641\u0647\u0645 \u0627\u0644\u0641\u0631\u0642.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0623\u064a\u0642\u0648\u0646\u0629 \u0627\u0644\u0645\u0639\u0627\u062f\u0644\u060c \u0648\u0627\u062e\u062a\u0631 \u0627\u0644\u0628\u0627\u0642\u0629 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 \u0644\u0645\u0648\u0633\u064a\u0642\u0627\u0643 \u0623\u0648 \u0628\u0648\u062f\u0643\u0627\u0633\u062a\u0643. \u0635\u062f\u0642\u0646\u064a\u060c \u0623\u0630\u0646\u064a\u0643 \u0633\u062a\u0634\u0643\u0631\u0643. \u0645\u0644\u0627\u062d\u0638\u0629: \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0631\u064a\u062f \u062a\u062d\u0643\u0645\u0627\u064b \u0643\u0627\u0645\u0644\u0627\u064b\u060c \u062c\u0631\u0628 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0629 \u2014 \u062a\u0641\u062a\u062d \u0644\u0643 \u0645\u0639\u0627\u062f\u0644\u0627\u064b \u0645\u062a\u0642\u062f\u0645\u0627\u064b \u0628\u062a\u0631\u062f\u062f\u0627\u062a \u063a\u064a\u0631 \u0645\u062d\u062f\u0648\u062f\u0629."
  ],
