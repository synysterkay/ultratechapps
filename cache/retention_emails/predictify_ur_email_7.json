{
  "subject": "\u06cc\u06c1 \u0648\u06c1 \u0686\u06cc\u0632 \u06c1\u06d2 \u062c\u0648 90% \u0635\u0627\u0631\u0641\u06cc\u0646 \u0646\u0638\u0631 \u0627\u0646\u062f\u0627\u0632 \u06a9\u0631 \u062f\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba",
  "preview_text": "\u06a9\u06cc\u0627 \u0622\u067e \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0627\u06cc\u06a9 \u0686\u06be\u0648\u0679\u06cc \u0633\u06cc \u0633\u06cc\u0679\u0646\u06af \u0622\u067e \u06a9\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0648\u06ba \u06a9\u0648 10 \u06af\u0646\u0627 \u0628\u06c1\u062a\u0631 \u0628\u0646\u0627 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u061f",
  "body_paragraphs": [
    "\u0645\u06cc\u06ba \u0646\u06d2 \u0633\u0648\u0686\u0627 \u06a9\u06c1 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u0627\u06cc\u06a9 \u0631\u0627\u0632 \u0628\u062a\u0627\u0624\u06ba\u06d4 \u062c\u0628 \u0645\u06cc\u06ba \u0646\u06d2 \u067e\u06c1\u0644\u06cc \u0628\u0627\u0631 Predictify \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc\u0627\u060c \u062a\u0648 \u0645\u06cc\u06ba \u0646\u06d2 \u0633\u0648\u0686\u0627 \u06a9\u06c1 \u06cc\u06c1 \u0635\u0631\u0641 \u0627\u06cc\u06a9 \u0627\u0648\u0631 \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc \u0627\u06cc\u067e \u06c1\u06d2\u06d4 \u0644\u06cc\u06a9\u0646 \u067e\u06be\u0631 \u0645\u06cc\u06ba \u0646\u06d2 \u0627\u06cc\u06a9 \u0686\u06cc\u0632 \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u06cc \u062c\u0633 \u0646\u06d2 \u0633\u0628 \u06a9\u0686\u06be \u0628\u062f\u0644 \u062f\u06cc\u0627\u06d4",
    "\u06cc\u06c1\u0627\u06ba \u0628\u0627\u062a \u06cc\u06c1 \u06c1\u06d2: \u0632\u06cc\u0627\u062f\u06c1 \u062a\u0631 \u0635\u0627\u0631\u0641\u06cc\u0646 \u0635\u0631\u0641 \u0627\u0633\u06a9\u0648\u0631 \u06a9\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc \u062f\u06cc\u06a9\u06be\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0686\u0644\u06d2 \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0644\u06cc\u06a9\u0646 \u0627\u0635\u0644\u06cc \u0637\u0627\u0642\u062a 'Confidence Score' \u0645\u06cc\u06ba \u0686\u06be\u067e\u06cc \u06c1\u06d2\u06d4 \u062c\u0628 \u0622\u067e \u062f\u06cc\u06a9\u06be\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 AI \u06a9\u0648 \u06a9\u0633\u06cc \u0645\u06cc\u0686 \u067e\u0631 85% \u06cc\u0642\u06cc\u0646 \u06c1\u06d2 \u062a\u0648 \u0622\u067e \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u06cc\u06c1 \u06a9\u0648\u0626\u06cc \u0627\u0646\u062f\u0627\u0632\u06c1 \u0646\u06c1\u06cc\u06ba\u060c \u0628\u0644\u06a9\u06c1 \u0688\u06cc\u0679\u0627 \u067e\u0631 \u0645\u0628\u0646\u06cc \u062d\u0642\u06cc\u0642\u062a \u06c1\u06d2\u06d4 \u0645\u06cc\u06ba \u0646\u06d2 \u062e\u0648\u062f \u0627\u0633\u06d2 \u0622\u0632\u0645\u0627\u06cc\u0627 \u0627\u0648\u0631 \u0627\u067e\u0646\u06cc \u062c\u06cc\u062a \u06a9\u06cc \u0634\u0631\u062d \u062f\u06af\u0646\u06cc \u06a9\u0631 \u062f\u06cc\u06d4",
    "\u06cc\u06c1 \u0641\u06cc\u0686\u0631 \u0622\u067e \u06a9\u0648 \u0628\u062a\u0627\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u06a9\u0628 \u0634\u0631\u0637 \u0644\u06af\u0627\u0646\u06cc \u06c1\u06d2 \u0627\u0648\u0631 \u06a9\u0628 \u062e\u0627\u0645\u0648\u0634 \u0631\u06c1\u0646\u0627 \u06c1\u06d2\u06d4 \u0628\u0633 \u0627\u06cc\u067e \u06a9\u06be\u0648\u0644\u06cc\u06ba\u060c \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0645\u06cc\u0686 \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba\u060c \u0627\u0648\u0631 'Confidence Score' \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 \u0648\u06c1\u0627\u06ba \u0622\u067e \u06a9\u0648 \u062a\u0641\u0635\u06cc\u0644\u06cc \u0688\u06cc\u0679\u0627 \u0645\u0644\u06d2 \u06af\u0627: xG\u060c \u062f\u0641\u0627\u0639\u06cc \u0637\u0627\u0642\u062a\u060c \u0627\u0648\u0631 \u062a\u0627\u0631\u06cc\u062e\u06cc \u062a\u062c\u0632\u06cc\u06c1\u06d4 \u06cc\u06c1 \u0648\u06c1\u06cc \u06c1\u06d2 \u062c\u0648 \u067e\u06cc\u0634\u06c1 \u0648\u0631 \u062a\u062c\u0632\u06cc\u06c1 \u06a9\u0627\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",
    "\u0622\u062c \u06c1\u06cc \u06cc\u06c1 \u06a9\u0631\u06cc\u06ba: \u0627\u06cc\u067e \u06a9\u06be\u0648\u0644\u06cc\u06ba\u060c \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0628\u0691\u06d2 \u0645\u06cc\u0686 (\u062c\u06cc\u0633\u06d2 Premier League \u06cc\u0627 Champions League) \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u06cc\u06ba\u060c \u0627\u0648\u0631 Confidence Score \u06a9\u0648 \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 \u067e\u06be\u0631 \u0645\u062c\u06be\u06d2 \u0628\u062a\u0627\u0626\u06cc\u06ba \u06a9\u06c1 \u0622\u067e \u06a9\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc \u06a9\u062a\u0646\u06cc \u0628\u06c1\u062a\u0631 \u06c1\u0648\u0626\u06cc\u06d4\n\nP.S. \u06a9\u06cc\u0627 \u0622\u067e \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 Premium \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u06c1\u0631 \u0645\u06cc\u0686 \u06a9\u06d2 \u0644\u06cc\u06d2 100% \u062f\u0631\u0633\u062a \u0688\u06cc\u0679\u0627 \u0645\u0644\u062a\u0627 \u06c1\u06d2\u061f \u0635\u0631\u0641 $12.99/\u0645\u0627\u06c1 \u0645\u06cc\u06ba 3 \u062f\u0646 \u06a9\u0627 \u0645\u0641\u062a \u0679\u0631\u0627\u0626\u0644 \u0628\u06be\u06cc \u06c1\u06d2\u06d4 \u0644\u06cc\u06a9\u0646 \u067e\u06c1\u0644\u06d2 \u06cc\u06c1 \u0686\u06be\u0648\u0679\u0627 \u0633\u0627 \u06c1\u06cc\u06a9 \u0622\u0632\u0645\u0627\u0626\u06cc\u06ba\u06d4"
  ],
