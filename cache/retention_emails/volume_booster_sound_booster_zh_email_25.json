{
  "subject": "\u6211\u72af\u4e86\u4e2a\u9519\u8bef \u8fd9\u529f\u80fd\u672c\u4e0d\u8be5\u88ab\u53d1\u73b0",
  "preview_text": "\u4e00\u4e2a\u7528\u6237\u628a\u97f3\u91cf\u589e\u5f3a\u5668\u7528\u5728\u4e86\u5b8c\u5168\u60f3\u4e0d\u5230\u7684\u5730\u65b9\uff0c\u7ed3\u679c\u8ba9\u6240\u6709\u4eba\u90fd\u60ca\u5446\u4e86\u3002\u8fd9\u65b9\u6cd5\u592a\u75af\u72c2\uff0c\u4f46\u786e\u5b9e\u6709\u6548\u3002",
  "body_paragraphs": [
    "\u6628\u5929\u6536\u5230\u4e00\u5c01\u7528\u6237\u90ae\u4ef6\uff0c\u6211\u5dee\u70b9\u628a\u5496\u5561\u55b7\u5728\u5c4f\u5e55\u4e0a\u3002\u4ed6\u8bf4\u7528\u6211\u4eec\u7684\u97f3\u91cf\u589e\u5f3a\u5668\u4e0d\u662f\u4e3a\u4e86\u542c\u6b4c\uff0c\u4e5f\u4e0d\u662f\u4e3a\u4e86\u770b\u89c6\u9891\u3002",
    "\u4ed6\u628a\u624b\u673a\u653e\u5728\u6d74\u5ba4\u91cc\uff0c\u6253\u5f00\u589e\u5f3a\u5668\u548c\u7535\u5b50\u4e50\u9884\u8bbe\uff0c\u7136\u540e\u628a\u6dcb\u6d74\u6c34\u58f0\u5f53\u6210\u80cc\u666f\u8282\u594f\u3002\u4ed6\u8bf4\u8fd9\u662f\u4ed6\u7684\u2018\u767d\u566a\u97f3\u521b\u4f5c\u5668\u2019\uff0c\u6c34\u58f0\u6df7\u7740\u4f4e\u9891\u589e\u5f3a\uff0c\u6bd4\u4efb\u4f55\u51a5\u60f3App\u90fd\u7ba1\u7528\u3002\u6211\u4ece\u6765\u6ca1\u60f3\u8fc7\u4f1a\u6709\u4eba\u8fd9\u6837\u7528\u3002",
    "\u8fd9\u8ba9\u6211\u610f\u8bc6\u5230\uff0c\u90a3\u4e2a\u5185\u7f6e\u7684\u7535\u5b50\u4e50EQ\u9884\u8bbe\uff0c\u4e0d\u53ea\u662f\u7ed9\u97f3\u4e50\u7528\u7684\u3002\u5b83\u80fd\u91cd\u5851\u4efb\u4f55\u73af\u5883\u97f3\u7684\u4f4e\u9891\u8d28\u611f\u2014\u2014\u96e8\u58f0\u3001\u98ce\u6247\u58f0\u3001\u751a\u81f3\u5730\u94c1\u8f70\u9e23\u3002\u6253\u5f00\u589e\u5f3a\u5668\uff0c\u9009\u7535\u5b50\u4e50\u9884\u8bbe\uff0c\u6574\u4e2a\u4e16\u754c\u7684\u58f0\u97f3\u7ed3\u6784\u90fd\u53d8\u4e86\u3002",
    "\u73b0\u5728\u5c31\u6253\u5f00App\uff0c\u9009\u7535\u5b50\u4e50\u9884\u8bbe\uff0c\u7136\u540e\u8bd5\u8bd5\u542c\u70b9\u5b8c\u5168\u4e0d\u662f\u97f3\u4e50\u7684\u4e1c\u897f\u3002\u4f60\u4f1a\u542c\u5230\u4ece\u672a\u6ce8\u610f\u8fc7\u7684\u4f4e\u9891\u5c42\u6b21\u3002P.S. \u53e6\u4e00\u4e2a\u7528\u6237\u5077\u5077\u544a\u8bc9\u6211\uff0c\u5979\u7528\u8fd9\u4e2a\u9884\u8bbe\u7ed9\u8001\u65e7\u7535\u98ce\u6247\u2018\u8c03\u97f3\u2019\uff0c\u73b0\u5728\u7761\u89c9\u79bb\u4e0d\u5f00\u5b83\u4e86\u3002",
    "\u8fd9\u529f\u80fd\u672c\u4e0d\u8be5\u8fd9\u6837\u7528\uff0c\u4f46\u65e2\u7136\u4f60\u77e5\u9053\u4e86\u2026\u2026\u4e0d\u5982\u8bd5\u8bd5\u770b\uff1f"
  ],
