{
  "subject": "\u5c0f\u6770\u548c\u5c0f\u96e8\u7684\u7b2c30\u6b21\u7ea6\u4f1a",
  "preview_text": "\u4ed6\u4eec\u5dee\u70b9\u5728\u7b2c3\u6b21\u5c31\u653e\u5f03\u4e86\u3002\u4e00\u4e2a\u6539\u53d8\u4e00\u5207\u7684\u591c\u665a\u3002",
  "body_paragraphs": [
    "\u5c0f\u6770\u548c\u5c0f\u96e8\u5728\u4e00\u8d77\u4e09\u5e74\u4e86\u3002\u7b2c15\u6b21\u7ea6\u4f1a\u65f6\uff0c\u4ed6\u4eec\u5bf9\u7740\u624b\u673a\u53d1\u5446\uff0c\u5237\u4e86\u534a\u5c0f\u65f6\u9910\u5385\uff0c\u6700\u540e\u70b9\u4e86\u5916\u5356\u5404\u81ea\u5403\u3002\u5c0f\u96e8\u8bf4\uff0c\u90a3\u665a\u5979\u89c9\u5f97\u81ea\u5df1\u50cf\u7a7a\u6c14\u3002",
    "\u4f46\u7b2c30\u6b21\u7ea6\u4f1a\uff0c\u5c0f\u96e8\u56de\u5230\u5bb6\uff0c\u770b\u5230\u5c0f\u6770\u5728\u95e8\u53e3\u7b49\u5979\uff0c\u624b\u673a\u5c4f\u4eae\u7740\u2014\u2014\u5c4f\u5e55\u4e0a\u662f\u4e00\u5f20\u5361\u7247\uff0c\u5199\u7740\u2018\u4eca\u665a\uff0c\u6211\u4eec\u56de\u5230\u7b2c\u4e00\u6b21\u7ea6\u4f1a\u7684\u5730\u65b9\u2019\u3002\u6ca1\u6709\u8ba8\u8bba\uff0c\u6ca1\u6709\u4e89\u5435\uff0c\u53ea\u6709\u90a3\u4e2a\u5ff5\u5934\u3002\u90a3\u4e00\u523b\uff0c\u5979\u6ca1\u6709\u89c9\u5f97\u88ab\u9057\u5fd8\uff0c\u800c\u662f\u88ab\u770b\u89c1\u4e86\u3002",
    "SoulPlan\u91cc\u6709\u4e2a\u529f\u80fd\u53eb\u2018\u4eca\u665a\u7684\u7ea6\u4f1a\u2019\u3002\u4f60\u70b9\u4e00\u4e0b\u5fc3\u60c5\u2014\u2014\u6cbb\u6108\u3001\u5192\u9669\u3001\u6e29\u99a8\u2014\u2014\u7136\u540e\u4e00\u5f20\u5361\u7247\u8df3\u51fa\u6765\u3002\u5c0f\u6770\u8bf4\uff0c\u4ed6\u82b1\u4e8630\u79d2\u9009\u4e86\u2018\u6e29\u99a8\u2019\uff0c\u7136\u540e\u7cfb\u7edf\u7ed9\u4e86\u4ed6\u4eec\u4e00\u4e2a\u91ce\u9910\u65b9\u6848\uff0c\u8fde\u5730\u5740\u548c\u97f3\u4e50\u6b4c\u5355\u90fd\u914d\u597d\u4e86\u3002\u4ed6\u4eec\u6ca1\u518d\u5237\u624b\u673a\uff0c\u800c\u662f\u804a\u4e86\u4e00\u6574\u665a\u3002",
    "\u73b0\u5728\uff0c\u8bd5\u8bd5\u6253\u5f00SoulPlan\uff0c\u70b9\u4e00\u4e0b\u2018\u4eca\u665a\u7684\u7ea6\u4f1a\u2019\u3002\u4e0d\u7528\u591a\u60f3\uff0c\u9009\u4e00\u4e2a\u4f60\u4eec\u73b0\u5728\u6700\u9700\u8981\u7684\u5fc3\u60c5\u3002\u4eca\u665a\uff0c\u53ef\u80fd\u5c31\u662f\u4f60\u4eec\u7684\u7b2c30\u6b21\u3002\nP.S. \u5c0f\u96e8\u540e\u6765\u544a\u8bc9\u6211\uff0c\u90a3\u665a\u4ed6\u4eec\u62cd\u4e86\u4e00\u5f20\u7167\u7247\uff0c\u5b58\u8fdb\u4e86\u8bb0\u5fc6\u65f6\u95f4\u7ebf\u3002\u5979\u8bf4\uff0c\u2018\u90a3\u5f20\u7167\u7247\u4e0d\u662f\u6211\u4eec\u591a\u597d\uff0c\u800c\u662f\u6211\u4eec\u8fd8\u8bb0\u5f97\u600e\u4e48\u597d\u3002\u2019"
  ],
