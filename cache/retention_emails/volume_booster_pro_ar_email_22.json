{
  "subject": "\u0627\u0644\u0627\u062e\u062a\u0635\u0627\u0631 \u0627\u0644\u0630\u064a \u064a\u0633\u062a\u062e\u062f\u0645\u0647 \u0627\u0644\u0645\u062d\u062a\u0631\u0641\u0648\u0646",
  "preview_text": "\u0627\u0643\u062a\u0634\u0641 \u0627\u0644\u0627\u062e\u062a\u0635\u0627\u0631 \u0627\u0644\u0633\u0631\u064a \u0627\u0644\u0630\u064a \u064a\u0636\u0627\u0639\u0641 \u0635\u0648\u062a\u0643 \u062f\u0648\u0646 \u0644\u0645\u0633 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a. \u0627\u0633\u062a\u062e\u062f\u0645\u0647 \u0627\u0644\u0622\u0646 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642.",
  "body_paragraphs": [
    "\u0644\u0627\u062d\u0638 \u0634\u064a\u0621 \u063a\u0631\u064a\u0628\u061f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0645\u062a\u0645\u0631\u0633\u0648\u0646 \u0644\u0627 \u064a\u0641\u062a\u062d\u0648\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u0628\u062f\u064b\u0627.",
    "\u0647\u0645 \u064a\u0631\u0628\u0637\u0648\u0646 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a\u060c \u0648\u064a\u0628\u062f\u0623 \u0627\u0644\u0635\u0648\u062a \u0628\u0642\u0648\u0629 200% \u0641\u0648\u0631\u064b\u0627. \u0628\u062f\u0648\u0646 \u0625\u0639\u0644\u0627\u0646\u0627\u062a. \u0628\u062f\u0648\u0646 \u0646\u0642\u0631\u0627\u062a. \u0628\u062f\u0648\u0646 \u0625\u0632\u0639\u0627\u062c.",
    "\u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0627\u062e\u062a\u0635\u0627\u0631 \u0627\u0644\u0635\u0627\u0645\u062a: \u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0639\u0646\u062f \u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a. \u062a\u0641\u0639\u064a\u0644\u0647\u0627 \u0641\u064a \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629\u060c \u062b\u0645 \u062a\u062e\u062a\u0641\u064a \u0645\u0646 \u062d\u064a\u0627\u062a\u0643.",
    "\u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u060c \u0648\u0641\u0639\u0651\u0644 \"\u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\". \u062b\u0645 \u0627\u0633\u062a\u0645\u062a\u0639 \u0628\u062a\u062c\u0631\u0628\u0629 \u0646\u0642\u064a\u0629. P.S. \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0645\u062a\u0627\u062d\u0629 \u0645\u062c\u0627\u0646\u064b\u0627 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u062d\u0627\u0644\u064a\u064a\u0646."
  ],
