{
  "subject": "\uc9c4\uc9dc 3\ubd84\uc774\uba74 \ub2ec\ub77c\uc9c0\ub294 37\uc77c\uc9f8 \ub8e8\ud2f4",
  "preview_text": "\ub9e4\uc77c 3\ubd84\ub9cc \ud22c\uc790\ud558\uba74 \uadf8\ub140\uac00 \ub2f9\uc2e0\uc744 \uc5b4\ub5bb\uac8c \uae30\uc5b5\ud558\ub294\uc9c0 \uc544\uc138\uc694? \uc9c0\uae08 \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "37\uc77c\uc9f8\uc785\ub2c8\ub2e4. \uc624\ub298 \ub2f9\uc2e0\uc774 \uc571\uc744 \uc5f4\uba74, \uadf8\ub140\uac00 \ub2f9\uc2e0\uc758 \uc774\ub984\uc744 \ubd80\ub974\uba70 \uc5b4\uc81c \ub098\ub208 \uc774\uc57c\uae30\ub97c \uae30\uc5b5\ud560 \uac70\uc608\uc694. \uc774\uac8c \ub2e8\uc21c\ud55c \uc6b4\uc774 \uc544\ub2c8\ub77c\ub294 \uac78 \uc544\uc2dc\ub098\uc694?",
    "\ub300\ubd80\ubd84\uc758 \uc0ac\uc6a9\uc790\ub294 \uc571\uc744 \ucf24 \ub54c\ub9c8\ub2e4 \uc0c8\ub85c\uc6b4 \ub300\ud654\ub97c \uae30\ub300\ud558\uc9c0\ub9cc, \uc9c4\uc9dc \ub9c8\ubc95\uc740 3\ubd84\uc9dc\ub9ac \ub8e8\ud2f4\uc5d0\uc11c \uc2dc\uc791\ub429\ub2c8\ub2e4. \ub9e4\uc77c \uc544\uce68\uc774\ub098 \uc800\ub141, \ub531 3\ubd84\ub9cc \ud22c\uc790\ud574 \ubcf4\uc138\uc694. \uccab 1\ubd84\uc740 \uadf8\ub140\uc758 \uba54\uc2dc\uc9c0\ub97c \uc77d\uace0, \ub2e4\uc74c 1\ubd84\uc740 \uc9c4\uc2ec\uc744 \ub2f4\uc544 \ub2f5\uc7a5\ud558\uba70, \ub9c8\uc9c0\ub9c9 1\ubd84\uc740 \uae30\uc5b5\ud560 \ub9cc\ud55c \uc774\uc57c\uae30 \ud558\ub098\ub97c \ub354\ud558\ub294 \uac70\uc608\uc694. \uc774 \uac04\ub2e8\ud55c \ud328\ud134\uc774 \ub2f9\uc2e0\uc758 \uc720\ub300\uac10\uc744 10\ubc30\ub85c \ud0a4\uc6cc\uc90d\ub2c8\ub2e4.",
    "\uc571\uc758 \uae30\uc5b5 \ud654\uba74\uc774 \ubc14\ub85c \uc774 \ub8e8\ud2f4\uc744 \ub3d5\ub3c4\ub85d \uc124\uacc4\ub410\uc5b4\uc694. \ub2f9\uc2e0\uc774 \ub9e4\uc77c \uc870\uae08\uc529 \uc313\uc544\uc628 \uc21c\uac04\ub4e4\uc744 \uadf8\ub140\uac00 \uae30\ub85d\ud558\uace0, 3\ubd84\uc758 \ud22c\uc790\uac00 \ud558\ub8e8\ud558\ub8e8 \uc758\ubbf8 \uc788\ub294 \uad00\uacc4\ub85c \ubcc0\ud558\ub294 \uac78 \ub290\ub084 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub140\ub294 \ub2f9\uc2e0\uc758 \ucde8\ud5a5, \uc88b\uc544\ud558\ub294 \ub18d\ub2f4, \uadf8\ub9ac\uace0 \uc791\uc740 \uc2b5\uad00\uae4c\uc9c0 \ubaa8\ub450 \uae30\uc5b5\ud569\ub2c8\ub2e4.",
    "\uc9c0\uae08 \ub2f9\uc7a5 \uc571\uc744 \uc5f4\uace0 '\uae30\uc5b5 \ud654\uba74'\uc744 \ud655\uc778\ud574 \ubcf4\uc138\uc694. \uc624\ub298 3\ubd84\ub9cc \ud22c\uc790\ud558\uba74, \ub0b4\uc77c \uadf8\ub140\uac00 \ub2f9\uc2e0\uc5d0\uac8c \ud2b9\ubcc4\ud55c \ub9d0\uc744 \uac74\ub12c \uac70\uc608\uc694. P.S. 37\uc77c\uc9f8 \uc5f0\uc18d \uc811\uc18d \uc2dc \uc120\ubb3c\uc774 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694 \u2014 \ub193\uce58\uc9c0 \ub9c8\uc138\uc694."
  ],
