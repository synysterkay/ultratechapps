{
  "subject": "\u039f\u03b9 1.200 \u03c7\u03c1\u03ae\u03c3\u03c4\u03b5\u03c2 \u03c0\u03bf\u03c5 \u03c0\u03c1\u03bf\u03ad\u03b2\u03bb\u03b5\u03c8\u03b1\u03bd \u03c3\u03c9\u03c3\u03c4\u03ac \u03c3\u03ae\u03bc\u03b5\u03c1\u03b1",
  "preview_text": "\u0394\u03b5\u03c2 \u03c4\u03b9 \u03c3\u03c5\u03bd\u03ad\u03b2\u03b7 \u03cc\u03c4\u03b1\u03bd 1.200 \u03c6\u03af\u03bb\u03bf\u03b9 \u03c4\u03bf\u03c5 \u03c0\u03bf\u03b4\u03bf\u03c3\u03c6\u03b1\u03af\u03c1\u03bf\u03c5 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b1\u03bd \u03c4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03bc\u03b1\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd Premier League \u03c3\u03ae\u03bc\u03b5\u03c1\u03b1.",
  "body_paragraphs": [
    "\u03a3\u03ae\u03bc\u03b5\u03c1\u03b1 \u03c4\u03bf \u03c0\u03c1\u03c9\u03af, 1.200 \u03c7\u03c1\u03ae\u03c3\u03c4\u03b5\u03c2 \u03c4\u03bf\u03c5 Predictify \u03ad\u03ba\u03b1\u03bd\u03b1\u03bd \u03ba\u03ac\u03c4\u03b9 \u03c0\u03bf\u03c5 \u03b8\u03b1 \u03c3\u03b5 \u03ba\u03ac\u03bd\u03b5\u03b9 \u03bd\u03b1 \u03b1\u03bd\u03b1\u03c1\u03c9\u03c4\u03b7\u03b8\u03b5\u03af\u03c2: \u03b3\u03b9\u03b1\u03c4\u03af \u03b4\u03b5\u03bd \u03c4\u03bf \u03b5\u03af\u03c7\u03b1 \u03c3\u03ba\u03b5\u03c6\u03c4\u03b5\u03af; \u03a0\u03c1\u03bf\u03ad\u03b2\u03bb\u03b5\u03c8\u03b1\u03bd \u03c3\u03c9\u03c3\u03c4\u03ac \u03c4\u03bf \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03b1\u03b3\u03ce\u03bd\u03b1 \u0386\u03c1\u03c3\u03b5\u03bd\u03b1\u03bb-\u03a4\u03c3\u03ad\u03bb\u03c3\u03b9, \u03bc\u03b5 \u03b2\u03ac\u03c3\u03b7 \u03c4\u03b1 \u03b1\u03bd\u03b1\u03bb\u03c5\u03c4\u03b9\u03ba\u03ac \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03c4\u03b7\u03c2 AI \u03bc\u03b1\u03c2. \u0395\u03c3\u03cd, \u03cc\u03bc\u03c9\u03c2, \u03c4\u03bf \u03ad\u03c7\u03b1\u03c3\u03b5\u03c2;",
    "\u0394\u03b5\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03c5\u03c7\u03b1\u03af\u03bf. \u0397 AI \u03bc\u03b1\u03c2 \u03b1\u03bd\u03ad\u03bb\u03c5\u03c3\u03b5 \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03b5\u03c2 \u03bc\u03b5\u03c4\u03b1\u03b2\u03bb\u03b7\u03c4\u03ad\u03c2\u2014\u03b1\u03c0\u03cc xG \u03ba\u03b1\u03b9 \u03ba\u03b1\u03c4\u03bf\u03c7\u03ae \u03bc\u03ad\u03c7\u03c1\u03b9 \u03b1\u03bc\u03c5\u03bd\u03c4\u03b9\u03ba\u03ae \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c0\u03c1\u03bf\u03b7\u03b3\u03bf\u03cd\u03bc\u03b5\u03bd\u03b5\u03c2 \u03b1\u03bd\u03b1\u03bc\u03b5\u03c4\u03c1\u03ae\u03c3\u03b5\u03b9\u03c2. \u03a4\u03bf \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1: \u03bc\u03b9\u03b1 \u03c0\u03c1\u03cc\u03b2\u03bb\u03b5\u03c8\u03b7 \u03bc\u03b5 73% \u03c3\u03b9\u03b3\u03bf\u03c5\u03c1\u03b9\u03ac \u03c0\u03bf\u03c5 \u03bf\u03b9 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03bf\u03b9 \u03b4\u03b5\u03bd \u03c0\u03b5\u03c1\u03af\u03bc\u03b5\u03bd\u03b1\u03bd. \u039a\u03b1\u03b9 \u03c4\u03ce\u03c1\u03b1, \u03b1\u03c5\u03c4\u03bf\u03af \u03bf\u03b9 1.200 \u03b3\u03b5\u03bb\u03bf\u03cd\u03bd \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03bf\u03b9, \u03b5\u03bd\u03ce \u03b5\u03c3\u03cd \u03af\u03c3\u03c9\u03c2 \u03bd\u03b1 \u03b2\u03b1\u03c3\u03af\u03b6\u03b5\u03c3\u03b1\u03b9 \u03b1\u03ba\u03cc\u03bc\u03b1 \u03c3\u03c4\u03bf \u03ad\u03bd\u03c3\u03c4\u03b9\u03ba\u03c4\u03cc \u03c3\u03bf\u03c5.",
    "\u0397 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 'Confidence Score' \u03c3\u03c4\u03bf Predictify \u03c3\u03bf\u03c5 \u03b4\u03b5\u03af\u03c7\u03bd\u03b5\u03b9 \u03b1\u03ba\u03c1\u03b9\u03b2\u03ce\u03c2 \u03c0\u03cc\u03c3\u03bf \u03c3\u03af\u03b3\u03bf\u03c5\u03c1\u03b7 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 AI \u03b3\u03b9\u03b1 \u03ba\u03ac\u03b8\u03b5 \u03c0\u03c1\u03cc\u03b2\u03bb\u03b5\u03c8\u03b7. \u0394\u03b5\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03bc\u03b1\u03b3\u03b9\u03ba\u03cc\u2014\u03b5\u03af\u03bd\u03b1\u03b9 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1. \u0386\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03b7\u03bd \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03c4\u03ce\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03b4\u03b5\u03c2 \u03c0\u03bf\u03b9\u03b5\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ad\u03c8\u03b5\u03b9\u03c2 \u03ad\u03c7\u03bf\u03c5\u03bd \u03c4\u03b7\u03bd \u03c5\u03c8\u03b7\u03bb\u03cc\u03c4\u03b5\u03c1\u03b7 \u03b2\u03b1\u03b8\u03bc\u03bf\u03bb\u03bf\u03b3\u03af\u03b1 \u03b3\u03b9\u03b1 \u03c4\u03b1 \u03b1\u03c5\u03c1\u03b9\u03b1\u03bd\u03ac \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9\u03b1. \u039c\u03b7\u03bd \u03bc\u03b5\u03af\u03bd\u03b5\u03b9\u03c2 \u03c0\u03af\u03c3\u03c9.",
    "\u03a0\u03ac\u03c4\u03b1 '\u0386\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03bf Predictify' \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b4\u03b5\u03b9\u03c2 \u03c4\u03b1 \u03bd\u03bf\u03cd\u03bc\u03b5\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03b1\u03bd\u03ad\u03b2\u03b5\u03b9\u03c2 \u03c3\u03c4\u03b7\u03bd \u03ba\u03bf\u03c1\u03c5\u03c6\u03ae. P.S.: \u0397 \u03b4\u03c9\u03c1\u03b5\u03ac\u03bd \u03b4\u03bf\u03ba\u03b9\u03bc\u03ae \u03c4\u03c9\u03bd 3 \u03b7\u03bc\u03b5\u03c1\u03ce\u03bd \u03b3\u03b9\u03b1 \u03c4\u03bf Premium \u03c3\u03bf\u03c5 \u03b4\u03af\u03bd\u03b5\u03b9 \u03c0\u03c1\u03cc\u03c3\u03b2\u03b1\u03c3\u03b7 \u03c3\u03b5 \u03cc\u03bb\u03b5\u03c2 \u03c4\u03b9\u03c2 \u03b1\u03bd\u03b1\u03bb\u03cd\u03c3\u03b5\u03b9\u03c2\u2014\u03ba\u03b1\u03b9 \u03c4\u03b1 1.200 \u03ac\u03c4\u03bf\u03bc\u03b1 \u03c4\u03bf \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b1\u03bd \u03ae\u03b4\u03b7."
  ],
