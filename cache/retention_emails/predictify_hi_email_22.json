{
  "subject": "\u0935\u094b \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u091c\u094b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u0924\u0947",
  "preview_text": "50 \u0926\u093f\u0928 \u092c\u093e\u0926 \u092d\u0940 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e? \u092f\u0947 \u0935\u094b \u091f\u094d\u0930\u093f\u0915 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u093f\u092f\u094b\u0902 \u0915\u094b 100% \u092c\u0926\u0932 \u0926\u0947\u0917\u0940\u0964 \u0905\u0902\u0926\u0930 \u092a\u0922\u093c\u0947\u0902\u0964",
  "body_paragraphs": [
    "\u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u092e\u0948\u0902 \u092a\u094d\u0930\u0940\u0921\u093f\u0915\u094d\u091f\u093f\u092b\u093e\u0908 \u0915\u093e \u092e\u093e\u0938\u094d\u091f\u0930 \u0939\u0942\u0902 \u2014 50 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 200+ \u092e\u0948\u091a \u090f\u0928\u093e\u0932\u093e\u0907\u091c \u0915\u093f\u090f, \u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u091a\u0940\u091c\u093c \u092e\u093f\u0938 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964 \u0935\u094b \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u091c\u094b \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u0930\u094d\u0938 \u091a\u0941\u092a\u0915\u0947 \u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0915\u094b\u0908 \u092c\u0924\u093e\u0924\u093e \u0928\u0939\u0940\u0902\u0964 \u0915\u094d\u092f\u093e \u092a\u0924\u093e \u0939\u0948 \u0935\u094b \u0915\u094d\u092f\u093e \u0939\u0948?",
    "\u092f\u0947 \u0915\u094b\u0908 \u0939\u0948\u0915 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u0921\u0947\u091f\u093e-\u0917\u0939\u0930\u093e \u0924\u0930\u0940\u0915\u093e \u0939\u0948: \u0906\u092a AI \u091a\u0948\u091f \u092e\u0947\u0902 \u0938\u0940\u0927\u0947 'xG difference between Liverpool and Chelsea' \u092f\u093e 'Bundesliga match with highest possession shift' \u091f\u093e\u0907\u092a \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u0947, \u0906\u092a\u0915\u094b \u090f\u0915 \u091d\u091f\u0915\u0947 \u092e\u0947\u0902 \u0935\u094b \u0938\u094d\u091f\u0948\u091f\u094d\u0938 \u092e\u093f\u0932\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u0906\u092a\u0915\u0947 \u092a\u094d\u0930\u0940\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u094b \u0939\u0925\u093f\u092f\u093e\u0930 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u092f\u0947 \u092b\u0940\u091a\u0930 \u2014 AI \u091a\u0948\u091f \u2014 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0926\u0942\u0930 \u0939\u0948\u0964 \u0907\u0938\u0947 \u0916\u094b\u0932\u0947\u0902, \u0905\u092a\u0928\u093e \u0905\u0917\u0932\u093e \u092e\u0948\u091a \u091f\u093e\u0907\u092a \u0915\u0930\u0947\u0902, \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0915\u0948\u0938\u0947 \u0906\u092a\u0915\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u0940 \u0915\u0940 \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0930\u0947\u091f\u093f\u0902\u0917 \u0905\u091a\u093e\u0928\u0915 \u092c\u0922\u093c \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0907\u0938\u0940 \u0938\u0947 \u0905\u092a\u0928\u0940 \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902 \u2014 \u0914\u0930 \u0905\u092c \u0906\u092a \u092d\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0905\u092d\u0940 \u092a\u094d\u0930\u0940\u0921\u093f\u0915\u094d\u091f\u093f\u092b\u093e\u0908 \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 AI \u091a\u0948\u091f \u092e\u0947\u0902 \u0905\u092a\u0928\u093e \u092a\u0939\u0932\u093e \u0938\u0935\u093e\u0932 \u092a\u0942\u091b\u0947\u0902\u0964 P.S. \u0905\u0917\u0930 \u0906\u092a\u0928\u0947 3-\u0926\u093f\u0928 \u0915\u093e \u092b\u094d\u0930\u0940 \u091f\u094d\u0930\u093e\u092f\u0932 ($12.99/\u092e\u0939\u0940\u0928\u093e) \u0928\u0939\u0940\u0902 \u0932\u093f\u092f\u093e, \u0924\u094b \u092f\u0947 \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u0906\u092a\u0915\u094b \u0938\u0940\u092e\u093f\u0924 \u0932\u0917\u0947\u0917\u093e \u2014 \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u092d\u0940, \u090f\u0915 \u092c\u093e\u0930 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u0947\u0902\u0964"
  ],
