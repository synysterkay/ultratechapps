{
  "subject": "92%\u7684\u4f34\u4fa3\u90fd\u5ffd\u7565\u4e86\u8fd91\u4e2a\u529f\u80fd\uff0c\u540e\u679c\u8ba9\u4f60\u540e\u6094",
  "preview_text": "\u6211\u4eec\u5206\u6790\u4e8610,000\u5bf9\u7528\u6237\u7684\u7ea6\u4f1a\u6570\u636e\uff0c\u53d1\u73b0\u4e00\u4e2a\u60ca\u4eba\u7684\u6a21\u5f0f\u2014\u2014\u8fd9\u4e2a\u88ab\u5ffd\u89c6\u7684\u529f\u80fd\uff0c\u53ef\u80fd\u6b63\u5728\u6084\u6084\u6bc1\u6389\u4f60\u4eec\u7684\u5173\u7cfb\u3002",
  "body_paragraphs": [
    "\u6211\u76f4\u63a5\u8bf4\u5427\uff1a\u4f60\u6b63\u5728\u72af\u4e00\u4e2a\u9519\u8bef\u3002\u4e00\u4e2a\u8ba990%\u7684\u60c5\u4fa3\u90fd\u540e\u6094\u7684\u9519\u8bef\u3002\u6211\u4eec\u7814\u7a76\u4e8610,000\u5bf9\u7528\u6237\u7684\u7ea6\u4f1a\u5386\u53f2\uff0c\u53d1\u73b0\u4e86\u4e00\u4e2a\u6b8b\u9177\u7684\u771f\u76f8\u2014\u2014\u90a3\u4e9b\u62b1\u6028\u5173\u7cfb\u53d8\u6de1\u7684\u7528\u6237\uff0c\u51e0\u4e4e\u90fd\u5ffd\u7565\u4e86\u540c\u4e00\u4e2a\u529f\u80fd\u3002\u800c\u575a\u6301\u4f7f\u7528\u5b83\u7684\u4eba\uff0c92%\u90fd\u8bf4\u5173\u7cfb\u5f97\u5230\u4e86\u6539\u5584\u3002\u8fd9\u4e0d\u662f\u5de7\u5408\uff0c\u662f\u6570\u636e\u5728\u8bf4\u8bdd\u3002",
    "\u8fd9\u4e2a\u529f\u80fd\u662f\u201c\u60ca\u559c\u7ea6\u4f1a\u89c4\u5212\u5668\u201d\u3002\u6211\u4eec\u4ee5\u4e3a\u5927\u5bb6\u4f1a\u7231\u7528\u5b83\uff0c\u4f46\u6570\u636e\u663e\u793a\u53ea\u67098%\u7684\u4eba\u771f\u6b63\u70b9\u5f00\u8fc7\u3002\u800c\u90a3\u4e9b\u7528\u4e86\u7684\u4eba\uff0c\u4ed6\u4eec\u7684\u7ea6\u4f1a\u9891\u7387\u63d0\u9ad8\u4e863\u500d\uff0c\u5e76\u4e14\u5f88\u5c11\u91cd\u590d\u8001\u5957\u7684\u884c\u7a0b\u3002\u4e3a\u4ec0\u4e48\uff1f\u56e0\u4e3a\u5f53\u4f60\u628a\u89c4\u5212\u6743\u4ea4\u7ed9\u5bf9\u65b9\uff0c\u90a3\u79cd\u672a\u77e5\u7684\u671f\u5f85\u611f\u76f4\u63a5\u6253\u7834\u4e86\u65e5\u5e38\u7684\u5e73\u6de1\u3002\u4f60\u4e0d\u9700\u8981\u518d\u7ede\u5c3d\u8111\u6c41\u60f3\u70b9\u5b50\uff0c\u53ea\u9700\u8981\u4fe1\u4efb\u4f60\u7684\u4f34\u4fa3\u2014\u2014\u6216\u8005\u8ba9AI\u66ff\u4f60\u4eec\u60f3\u3002",
    "\u6211\u4eec\u5f53\u521d\u8bbe\u8ba1\u8fd9\u4e2a\u529f\u80fd\u65f6\uff0c\u5c31\u60f3\u590d\u5236\u90a3\u79cd\u201c\u6536\u5230\u624b\u5199\u60c5\u4e66\u201d\u7684\u5fc3\u8df3\u611f\u3002\u4f46\u5927\u90e8\u5206\u4eba\u53ea\u628aSoulPlan\u5f53\u6210\u4e00\u4e2a\u9910\u5385\u5217\u8868\uff0c\u767d\u767d\u6d6a\u8d39\u4e86\u5b83\u6700\u5f3a\u5927\u7684\u90e8\u5206\uff1a\u5236\u9020\u60ca\u559c\u3002\u4f60\u60f3\u60f3\uff0c\u4e0a\u6b21\u4f60\u4f34\u4fa3\u7a81\u7136\u5e26\u4f60\u53bb\u505a\u4e00\u4ef6\u5b8c\u5168\u610f\u60f3\u4e0d\u5230\u7684\u4e8b\uff0c\u662f\u4ec0\u4e48\u65f6\u5019\uff1f\u5982\u679c\u7b54\u6848\u662f\u201c\u8bb0\u4e0d\u6e05\u4e86\u201d\uff0c\u90a3\u4f60\u8be5\u8bd5\u8bd5\u4e86\u3002",
    "\u73b0\u5728\uff0c\u6253\u5f00SoulPlan\u7684\u201c\u60ca\u559c\u7ea6\u4f1a\u201d\u6a21\u5f0f\uff0c\u8ba9AI\u6839\u636e\u4f60\u4eec\u5171\u540c\u7684\u5174\u8da3\u751f\u6210\u4e00\u4e2a\u795e\u79d8\u8ba1\u5212\u3002\u4f60\u53ea\u9700\u8bbe\u7f6e\u9884\u7b97\u548c\u5174\u8da3\uff0c\u5269\u4e0b\u7684\u4ea4\u7ed9\u5b83\u3002\u522b\u8ba9\u8fd9\u4e2a\u529f\u80fd\u7ee7\u7eed\u88ab99%\u7684\u4eba\u5ffd\u7565\u3002 P.S. \u6211\u4eec\u8fd8\u53d1\u73b0\uff1a\u90a3\u4e9b\u7528\u201c\u60ca\u559c\u6a21\u5f0f\u201d\u7684\u60c5\u4fa3\uff0c\u5728\u65e5\u671f\u5386\u53f2\u4e2d\u8bb0\u5f55\u7684\u201c\u6700\u7231\u56de\u5fc6\u201d\u6bd4\u5176\u4ed6\u4eba\u591a4\u500d\u3002\u522b\u8ba9\u4e0b\u4e00\u4e2a\u7f8e\u597d\u56de\u5fc6\u6210\u4e3a\u522b\u4eba\u7684\u3002"
