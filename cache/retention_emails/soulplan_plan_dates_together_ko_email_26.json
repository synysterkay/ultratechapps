{
  "subject": "\uc9c0\ub09c\uc8fc \ub450 \ubc88 \ub370\uc774\ud2b8\ud55c \ucee4\ud50c\uc758 \ube44\ubc00",
  "preview_text": "\ub2f9\uc2e0 \uc8fc\ubcc0\uc5d0 \ud55c \uc0ac\ub78c, \uc774 \uc571\uc774 \uc5c6\uc5b4\uc11c \ubc24\ub9c8\ub2e4 \uace0\ubbfc\ud558\ub294 \uc0ac\ub78c\uc774 \uc788\uc5b4\uc694. \uadf8 \uc0ac\ub78c\uc5d0\uac8c \uc774\uba54\uc77c\uc744 \ubcf4\ub0b4\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\uc9c0\ub09c\uc8fc, \ud55c \uce5c\uad6c\uac00 \ub098\uc5d0\uac8c \ubb3c\uc5c8\uc5b4. '\ub108\ud76c\ub294 \uc5b4\ub5bb\uac8c \ub9e4\uc8fc \uc0c8\ub85c\uc6b4 \ub370\uc774\ud2b8\ub97c \uc0dd\uac01\ud574?' \ub098\ub294 \ub300\ub2f5\ud588\uc9c0. '\uc0ac\uc2e4, \ube44\uacb0\uc740 \uc571\uc774\uc57c.' \uadf8 \uce5c\uad6c\ub294 \uc9c0\uae08\uae4c\uc9c0 \uac19\uc740 \uce74\ud398\ub9cc \ub3cc\uace0 \uc788\uc5c8\uc5b4. \ub2f9\uc2e0 \uc8fc\ubcc0\uc5d0\ub3c4 \uadf8\ub7f0 \uc0ac\ub78c\uc774 \uc788\uc9c0 \uc54a\ub098? \ud30c\ud2b8\ub108\uac00 '\ub610 \uac70\uae30?'\ub77c\uace0 \ub9d0\ud560 \ub54c\ub9c8\ub2e4 \uc18d\uc73c\ub85c \ud55c\uc228 \uc26c\ub294 \uc0ac\ub78c.",
    "\ub370\uc774\ud2b8 \ub8e8\ud2f4\uc740 \uc5f0\uc560\uc758 \ubb34\ub364\uc774\uc57c. \ud558\uc9c0\ub9cc \ub2f9\uc2e0\uc740 \uc774\ubbf8 \ud0c8\ucd9c\ud588\uc796\uc544. SoulPlan\uc758 '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \ub355\ubd84\uc5d0 30\ucd08\uba74 \uc644\ubcbd\ud55c \uc800\ub141\uc774 \uacc4\ud68d\ub418\ub2c8\uae4c. \uadf8\ub7f0\ub370 \ub2f9\uc2e0\uc758 \uce5c\uad6c, \ub3d9\ub8cc, \ub610\ub294 \ud615\uc81c\ub294 \uc544\uc9c1 \uadf8 \ubb34\ub364 \uc18d\uc5d0\uc11c \ud5e4\ub9e4\uace0 \uc788\uc744\uc9c0\ub3c4 \ubab0\ub77c. \uadf8 \uc0ac\ub78c\uc5d0\uac8c \uc774 \uc571\uc744 \ubcf4\uc5ec\uc8fc\uba74, \uadf8\ub4e4\uc758 \uad00\uacc4\uc5d0 \ubd88\uaf43\uc774 \ub2e4\uc2dc \uc0b4\uc544\ub0a0 \uac70\uc57c.",
    "SoulPlan\uc740 \ub2e8\uc21c\ud55c \uc571\uc774 \uc544\ub2c8\uc57c. \ud30c\ud2b8\ub108\uac00 '\uc624\ub298 \ub108\ub97c \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \ud480\uc2a4\ud06c\ub9b0 \uc21c\uac04\uc744 \ubc1b\uc73c\uba74, \uadf8 \ubbf8\uc18c\uac00 \uc5bc\ub9c8\ub098 \ud070 \uc120\ubb3c\uc778\uc9c0 \uc54c\uac8c \ub3fc. \uadf8\ub9ac\uace0 \uba54\ubaa8\ub9ac \ud0c0\uc784\ub77c\uc778\uc740 \uadf8 \uc21c\uac04\ub4e4\uc744 \uc601\uc6d0\ud788 \uac04\uc9c1\ud558\uac8c \ud574\uc918. \ub2f9\uc2e0\uc774 \uc774\ubbf8 \uacbd\ud5d8\ud55c \uadf8 \uac10\ub3d9\uc744, \ub2e4\ub978 \ucee4\ud50c\ub3c4 \ub290\ub07c\uac8c \ud574\uc918.",
    "\uc9c0\uae08 \ub2f9\uc7a5, \ub2f9\uc2e0\uc758 \uc5f0\ub77d\ucc98\uc5d0\uc11c \ud55c \uc0ac\ub78c\uc744 \ub5a0\uc62c\ub824\ubd10. \uadf8 \uc0ac\ub78c\uc5d0\uac8c \uc774 \uc571\uc744 \ucd94\ucc9c\ud574\uc918. \ubc84\ud2bc \ud558\ub098\ub9cc \ub204\ub974\uba74, \ucd08\ub300 \ub9c1\ud06c\uac00 \uc804\uc1a1\ub3fc. P.S. \ucd94\ucc9c\ud55c \ucee4\ud50c\uc774 \uccab \ub370\uc774\ud2b8\ub97c \uacc4\ud68d\ud558\uba74, \ub2f9\uc2e0\uc5d0\uac8c\ub3c4 \ubb34\ub8cc \ud504\ub85c \uc704\ud06c\uac00 \uc81c\uacf5\ub3fc. \uc11c\ub85c\uc5d0\uac8c \uc120\ubb3c\uc774 \ub418\ub294 \uac70\uc57c."
  ],
