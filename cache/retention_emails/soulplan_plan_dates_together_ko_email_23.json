{
  "subject": "\ub2f9\uc2e0\uc758 \ub370\uc774\ud2b8\uac00 \uc0ac\ub77c\uc9c4 \uc774\uc720",
  "preview_text": "\uc18c\uc6b8\ud50c\ub79c \uc5c6\uc774 53\uc77c\uc744 \ubcf4\ub0c8\ub2e4\uba74 \uc5b4\ub5a4 \uc77c\uc774 \uc77c\uc5b4\ub0ac\uc744\uae4c\uc694? \uadf8 \ucc28\uc774\uac00 \ubd80\ub044\ub7ec\uc6b8 \uc815\ub3c4\uc785\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uc9c0\ub09c 53\uc77c \ub3d9\uc548, \ub2f9\uc2e0\uc740 \ub370\uc774\ud2b8\ub97c \uc704\ud574 \uc5bc\ub9c8\ub098 \ub9ce\uc740 \uc2dc\uac04\uc744 \ub0ad\ube44\ud588\ub098\uc694? \uc571 \uc5c6\uc774\ub3c4 \uad1c\ucc2e\ub2e4\uace0 \uc0dd\uac01\ud588\uc8e0. \ud558\uc9c0\ub9cc \ud604\uc2e4\uc740 \uc5b4\ub560\ub098\uc694? \ub9e4\uc8fc \uae08\uc694\uc77c \uc800\ub141, '\ubb50 \ud560\uae4c?'\ub77c\ub294 \uc9c8\ubb38\uacfc \ud568\uaed8 \uc2dc\uc791\ub41c \uc9c0\ub8e8\ud55c \ud328\ud134. \uc0c1\ub300\ubc29\uc740 \ub2f9\uc2e0\uc774 \uc774\ubbf8 \ub2e4\ub978 \uc0dd\uac01\uc744 \ud558\uace0 \uc788\ub2e4\ub294 \uac78 \ub290\uaf08\uc744 \uac81\ub2c8\ub2e4.",
    "\uc18c\uc6b8\ud50c\ub79c\uc744 \uc0ac\uc6a9\ud55c \ucee4\ud50c\ub4e4\uc740 \ub2e4\ub985\ub2c8\ub2e4. \uadf8\ub4e4\uc740 \uccab 24\uc2dc\uac04 \uc548\uc5d0 '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ud55c \ubc88 \ud074\ub9ad\ud558\uace0, 30\ucd08 \uc548\uc5d0 \uc644\ubcbd\ud55c \ubc24\uc744 \uacc4\ud68d\ud569\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \uadf8 \uc2dc\uac04\uc5d0 \uc5ec\uc804\ud788 \uace0\ubbfc\ud558\uace0 \uc788\uc5c8\uc2b5\ub2c8\ub2e4. \uadf8 \ucc28\uc774\ub294 \ubd80\ub044\ub7ec\uc6b8 \uc815\ub3c4\uc785\ub2c8\ub2e4. \uc571 \uc5c6\ub294 \uc0b6\uc740 \uae30\uc5b5\uc5d0 \ub0a8\uc9c0 \uc54a\ub294 \uc800\ub141\uacfc \uc0ac\ub77c\uc9c4 \uc2a4\ud30c\ud06c\uc600\uc2b5\ub2c8\ub2e4. \ubc18\uba74, \uc571\uc774 \uc788\ub294 \uc0b6\uc740 \uc0c1\ub300\ubc29\uc774 '\uc624\ub298 \ub108\ub97c \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \uba54\uc2dc\uc9c0\ub97c \ubc1b\uc73c\uba70 \uc6c3\uc74c\uc744 \uc9d3\ub294 \uc21c\uac04\uc744 \ub9cc\ub4ed\ub2c8\ub2e4.",
    "\uc774\uc81c, \ub2f9\uc2e0\uc774 \ub193\uce5c \uae30\ub2a5\uc744 \ubcf4\uc5ec\ub4dc\ub9b4\uac8c\uc694: '\uae30\ub150\uc77c \ud56d\uc544\ub9ac'. \uc911\uc694\ud55c \ub0a0\uc9dc\ub97c \uae5c\ube61\ud558\uc9c0 \uc54a\ub3c4\ub85d \ubd80\ub4dc\ub7fd\uac8c \uc54c\ub824\uc90d\ub2c8\ub2e4. \ub2f9\uc2e0\uc774 \uc78a\uc5b4\ubc84\ub9b0 \uae30\ub150\uc77c\uc774 \uc0c1\ub300\ubc29\uc5d0\uac8c \uc5bc\ub9c8\ub098 \ud070 \uc0c1\ucc98\ub97c \uc92c\ub294\uc9c0 \uc0dd\uac01\ud574\ubcf4\uc138\uc694. \uc571\uc774 \uadf8 \uc0c1\ucc98\ub97c \uc608\ubc29\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, '\uc704\uc2dc\ub9ac\uc2a4\ud2b8'\uc5d0 \uc800\uc7a5\ud55c \uc544\uc774\ub514\uc5b4\ub294 AI\uac00 \uae5c\uc9dd \ub370\uc774\ud2b8\ub85c \ubcc0\ud658\ud569\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \ub178\ub825\uc774 \ud544\uc694 \uc5c6\uc2b5\ub2c8\ub2e4.",
    "\uc9c0\uae08 \uc18c\uc6b8\ud50c\ub79c\uc744 \uc5f4\uace0, '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ud55c \ubc88 \ud0ed\ud574\ubcf4\uc138\uc694. 30\ucd08\uba74 \ub429\ub2c8\ub2e4. P.S. \ub2f9\uc2e0\uc774 \ub193\uce5c 53\uc77c, \ub418\ub3cc\ub9b4 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uc624\ub298 \ubc24\uc740 \ub2e4\ub985\ub2c8\ub2e4."
  ],
