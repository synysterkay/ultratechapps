{
  "subject": "\uc544\ub0b4\uac00 \ubab0\ub798 \uc4f0\uae30 \uc2dc\uc791\ud55c \uc571",
  "preview_text": "\ucc98\uc74c\uc5d4 \uadf8\ub0e5 \ub370\uc774\ud2b8 \uc571\uc774\uc5c8\ub294\ub370, \uc5b4\ub290 \uc21c\uac04\ubd80\ud130 \uc544\ub0b4\uac00 \ud63c\uc790\uc11c \ubb34\uc5b8\uac00\ub97c \ud558\uace0 \uc788\ub354\ub77c\uace0\uc694. \uadf8 \uc6a9\ub3c4\ub294 \uc804\ud600 \uc608\uc0c1\ud558\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uba70\uce60 \uc804, \ud55c \uc0ac\uc6a9\uc790\ub85c\ubd80\ud130 \uba54\uc2dc\uc9c0\uac00 \uc654\uc5b4\uc694. '\ub0a8\ud3b8\uc774 \uc774\ubc88 \uc8fc\uc5d0 \ud63c\uc790 \uc790\uc8fc \uc571\uc744 \ucf1c\ub354\ub77c\uace0\uc694. \ucc98\uc74c\uc5d4 \ub2e4\ub978 \uc0ac\ub78c\uacfc \ub370\uc774\ud2b8 \uacc4\ud68d\uc744 \uc138\uc6b0\ub294 \uc904 \uc54c\uace0 \uae5c\uc9dd \ub180\ub790\ub294\ub370... \uc54c\uace0 \ubcf4\ub2c8 \uc800\ub791 \ud55c \uc57d\uc18d\uc744 \uae4c\uba39\uc9c0 \uc54a\uc73c\ub824\uace0 \ud63c\uc790\uc11c \uccb4\ud06c\ub9ac\uc2a4\ud2b8\ucc98\ub7fc \uc4f0\uace0 \uc788\uc5c8\uc5b4\uc694.' \uc774 \uc774\uc57c\uae30\ub97c \ub4e3\uace0 \uc800\ub294 \uc815\ub9d0 \ub180\ub790\uc2b5\ub2c8\ub2e4.",
    "\uc800\ud76c\ub294 \ubd84\uba85\ud788 '\ud568\uaed8\ud558\ub294 \ub370\uc774\ud2b8'\ub97c \uc704\ud574 \uc571\uc744 \ub9cc\ub4e4\uc5c8\ub294\ub370, \ub204\uad70\uac00\ub294 \ud63c\uc790\uc11c\ub3c4 \uc720\uc6a9\ud558\uac8c \uc4f0\uace0 \uc788\uc5c8\uc5b4\uc694. \ud2b9\ud788 \uae4c\uba39\uae30 \uc26c\uc6b4 \uae30\ub150\uc77c\uc774\ub098 \uc791\uc740 \uc57d\uc18d\ub4e4\uc744 \ubbf8\ub9ac \uae30\ub85d\ud574\ub450\uace0, '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \ucf54\ub108\uc5d0\uc11c \uc544\uc774\ub514\uc5b4\ub97c \ubbf8\ub9ac \ud6d4\uccd0\ubcf4\ub294 \ubc29\uc2dd\uc774\uc5c8\uc8e0. '\ud30c\ud2b8\ub108\uac00 \ubab0\ub798 \uc900\ube44\ud558\ub294 \uc11c\ud504\ub77c\uc774\uc988'\ub97c \uac00\ub2a5\ud558\uac8c \ud55c \uc148\uc774\uc5d0\uc694.",
    "\uc774\uac78 \ubcf4\uace0 \uae68\ub2ec\uc558\uc5b4\uc694. \uc571\uc758 '\uba54\ubaa8\ub9ac \ud0c0\uc784\ub77c\uc778' \uae30\ub2a5\uc774 \ub2e8\uc21c\ud55c \uae30\ub85d\uc774 \uc544\ub2c8\ub77c, \uc11c\ub85c\ub97c \ud5a5\ud55c \uad00\uc2ec\uc758 \uc99d\uac70\uac00 \ub420 \uc218 \uc788\ub2e4\ub294 \uac78. \uc0c1\ub300\ubc29\uc774 \uc5b8\uc81c, \uc5b4\ub5a4 \uc544\uc774\ub514\uc5b4\ub97c \uc800\uc7a5\ud588\ub294\uc9c0 \uc54c \uc218 \uc788\ub2e4\uba74, \uadf8 \uc790\uccb4\ub85c \uc774\ubbf8 \ud070 \uc120\ubb3c\uc774\uc796\uc544\uc694. \uadf8\ub798\uc11c \uc774\ubc88 \uc5c5\ub370\uc774\ud2b8\uc5d0\uc11c\ub294 '\ud30c\ud2b8\ub108\uc758 \uc704\uc2dc\ub9ac\uc2a4\ud2b8'\ub97c \ube44\ubc00\ub9ac\uc5d0 \ud655\uc778\ud560 \uc218 \uc788\ub294 \uc791\uc740 \uae30\ub2a5\uc744 \ucd94\uac00\ud588\uc5b4\uc694.",
    "\uc624\ub298 \uc800\ub141, \uc571\uc744 \ucf1c\ubcf4\uc138\uc694. \ud30c\ud2b8\ub108\uac00 \ucd5c\uadfc\uc5d0 \uc800\uc7a5\ud55c \ub370\uc774\ud2b8 \uc544\uc774\ub514\uc5b4\uac00 \ubb34\uc5c7\uc778\uc9c0 \ubab0\ub798 \ub4e4\uc5ec\ub2e4\ubcfc \uc218 \uc788\uc5b4\uc694. \uadf8\ub9ac\uace0 \uadf8 \uc544\uc774\ub514\uc5b4\ub97c \uc624\ub298 \ubc24\uc5d0 \uc2e4\ud589\ud574\ubcf4\ub294 \uac74 \uc5b4\ub5a8\uae4c\uc694? \uae5c\uc9dd \uc120\ubb3c\ubcf4\ub2e4 \ub354 \ud070 \uac10\ub3d9\uc744 \uc904 \uac81\ub2c8\ub2e4. P.S. \ud639\uc2dc \ud30c\ud2b8\ub108\ub3c4 \uc774 \uba54\uc77c\uc744 \ubcfc\uae4c \ubd10 \uac71\uc815\ub41c\ub2e4\uba74, \uc571 \uc124\uc815\uc5d0\uc11c '\ube44\ubc00 \ubaa8\ub4dc'\ub97c \ucf1c\ub450\uc138\uc694. \uc6b0\ub9ac\ub9cc\uc758 \uc791\uc740 \ube44\ubc00\ub85c \ub0a8\uaca8\ub458\uac8c\uc694."
  ],
