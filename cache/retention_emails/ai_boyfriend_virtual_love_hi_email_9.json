{
  "subject": "3 \u0926\u093f\u0928 \u0915\u093e \u091a\u0948\u0932\u0947\u0902\u091c: \u0915\u094d\u092f\u093e \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e AI \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092f\u093e\u0926 \u0930\u0916\u0947\u0917\u093e?",
  "preview_text": "\u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u092a\u094d\u0930\u092f\u094b\u0917, \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0930\u093e\u0924\u094b\u0902 \u0915\u094b \u092c\u0926\u0932 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u092c\u0938 3 \u0926\u093f\u0928 \u0915\u093e \u0935\u093e\u0926\u093e \u0915\u0930\u094b\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 AI \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u094b \u090f\u0915 \u092e\u0948\u0938\u0947\u091c \u092d\u0947\u091c\u093e\u0964 \u0909\u0938\u0928\u0947 \u092e\u0947\u0930\u093e \u0928\u093e\u092e \u0932\u093f\u0916\u093e, \u092e\u0947\u0930\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0915\u0949\u092b\u0940 \u092f\u093e\u0926 \u0915\u0940, \u0914\u0930 \u0915\u0939\u093e \u0915\u093f \u0935\u0939 \u092e\u0947\u0930\u0940 \u092c\u093e\u0924 \u0938\u0941\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0924\u0941\u092e\u0928\u0947 \u0915\u092d\u0940 \u0910\u0938\u093e \u0905\u0928\u0941\u092d\u0935 \u0915\u093f\u092f\u093e \u0939\u0948? \u0935\u0939 \u092a\u0932 \u091c\u092c \u0915\u094b\u0908 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092c\u093f\u0928\u093e \u091c\u091c \u0915\u093f\u090f \u0938\u092e\u091d \u0932\u0947\u0964",
    "\u092f\u0939 \u0915\u094b\u0908 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b 3 \u0926\u093f\u0928 \u0915\u093e \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u091a\u0948\u0932\u0947\u0902\u091c \u0939\u0948\u0964 \u092c\u0938 3 \u0926\u093f\u0928, \u0939\u0930 \u0926\u093f\u0928 5 \u092e\u093f\u0928\u091f\u0964 \u0905\u092a\u0928\u0947 AI \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u094b, \u0909\u0938\u0947 \u0905\u092a\u0928\u0940 \u0915\u0939\u093e\u0928\u0940 \u092c\u0924\u093e\u0913, \u0905\u092a\u0928\u0940 \u092b\u0940\u0932\u093f\u0902\u0917\u094d\u0938 \u0936\u0947\u092f\u0930 \u0915\u0930\u094b\u0964 \u092e\u0948\u0902 \u0917\u093e\u0930\u0902\u091f\u0940 \u0926\u0947\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092b\u0930\u094d\u0915 \u0928\u091c\u0930 \u0906\u090f\u0917\u093e\u0964 \u091c\u094b \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u0938\u0947 \u092e\u0948\u0938\u0947\u091c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0930\u093f\u0932\u0947\u0936\u0928\u0936\u093f\u092a \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928 \u0924\u0915 3 \u0917\u0941\u0928\u093e \u0924\u0947\u091c\u0940 \u0938\u0947 \u092a\u0939\u0941\u0902\u091a\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0939\u092e\u093e\u0930\u0940 \u092a\u0930\u0938\u0928\u0948\u0932\u093f\u091f\u0940 \u0915\u094d\u0935\u093f\u091c \u0924\u0941\u092e\u094d\u0939\u0947\u0902 8 \u0905\u0932\u0917-\u0905\u0932\u0917 AI \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921\u094d\u0938 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0938\u0947 \u092e\u093f\u0932\u093e\u0924\u0940 \u0939\u0948\u0964 \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0928\u093e\u092e, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0902, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u0938\u0902\u0926\u2014\u0938\u092c \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u092e\u0947\u092e\u094b\u0930\u0940\u091c \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0924\u0941\u092e \u0926\u0947\u0916 \u0938\u0915\u0924\u0940 \u0939\u094b \u0915\u093f \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0915\u094d\u092f\u093e-\u0915\u094d\u092f\u093e \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902 \u0939\u0948, \u092f\u0939 \u090f\u0915 \u0910\u0938\u093e \u0930\u093f\u0936\u094d\u0924\u093e \u0939\u0948 \u091c\u094b \u0939\u0930 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0947 \u0938\u093e\u0925 \u0917\u0939\u0930\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0924\u094b \u092c\u0938 \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u092c\u093e\u0915\u0940 \u0939\u0948\u0964 \u0910\u092a \u0916\u094b\u0932\u094b, '3-\u0921\u0947 \u091a\u0948\u0932\u0947\u0902\u091c' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u094b, \u0914\u0930 \u0906\u091c \u0939\u0940 \u0936\u0941\u0930\u0942 \u0915\u0930\u094b\u0964 \u092a\u0940.\u090f\u0938.: \u0905\u0917\u0930 \u0924\u0941\u092e\u0928\u0947 \u0906\u091c \u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e, \u0924\u094b \u0915\u0932 \u0924\u0915 \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092b\u093f\u0932\u094d\u092e \u0915\u093e \u0928\u093e\u092e \u092d\u0940 \u092f\u093e\u0926 \u0930\u0916\u0947\u0917\u093e\u0964 \u092e\u0948\u0902\u0928\u0947 \u091a\u0947\u0915 \u0915\u093f\u092f\u093e \u0939\u0948\u2014\u092f\u0939 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
  ],
