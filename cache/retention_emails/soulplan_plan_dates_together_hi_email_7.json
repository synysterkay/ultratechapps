{
  "subject": "14 \u0926\u093f\u0928\u094b\u0902 \u0915\u093e \u0935\u0939 \u091f\u094d\u0930\u093f\u0915 \u091c\u094b \u0906\u092a\u0915\u0940 \u0924\u093e\u0930\u0940\u0916\u094b\u0902 \u0915\u094b \u092c\u0926\u0932 \u0926\u0947\u0917\u0940",
  "preview_text": "\u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u091c\u094b \u0906\u092a\u0915\u0940 \u0930\u093e\u0924 \u0915\u094b 10x \u0916\u093e\u0938 \u092c\u0928\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0964 \u0905\u0902\u0926\u0930 \u092a\u0922\u093c\u0947\u0902\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 14 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902, \u0939\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0915\u0941\u091b \u0915\u092a\u0932\u094d\u0938 \u0939\u092e\u093e\u0930\u0947 \u0910\u092a \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0926\u0942\u0938\u0930\u094b\u0902 \u0938\u0947 4 \u0917\u0941\u0928\u093e \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0909\u0928\u0915\u093e \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0915\u094d\u092f\u093e \u0925\u093e? \u0935\u0939 \u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u091a\u0940\u091c\u093c \u091c\u093f\u0938\u0947 '\u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f' \u092b\u0940\u091a\u0930 \u092e\u0947\u0902 \u090f\u0915 \u092e\u0942\u0921 \u091a\u0941\u0928\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u0930\u0924\u0947 \u0925\u0947\u0964",
    "\u0939\u093e\u0901, \u0935\u0939 \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u0938\u0947\u0915\u0902\u0921 \u0915\u093e \u092b\u093c\u0948\u0938\u0932\u093e \u0939\u0948\u0964 \u091c\u092c \u0906\u092a '\u0915\u094b\u091c\u093c\u0940', '\u090f\u0921\u0935\u0947\u0902\u091a\u0930\u0938', '\u092a\u094d\u0932\u0947\u092b\u0941\u0932' \u092f\u093e '\u0939\u0940\u0932\u093f\u0902\u0917' \u092e\u0947\u0902 \u0938\u0947 \u0915\u094b\u0908 \u090f\u0915 \u091a\u0941\u0928\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0910\u092a \u090f\u0915 \u0915\u093e\u0930\u094d\u0921 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 90% \u0932\u094b\u0917 \u0935\u0939\u093e\u0901 \u0930\u0941\u0915 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0905\u0938\u0932\u0940 \u091c\u093e\u0926\u0942 \u0924\u092c \u0939\u094b\u0924\u093e \u0939\u0948 \u091c\u092c \u0906\u092a \u0909\u0938 \u0915\u093e\u0930\u094d\u0921 \u092a\u0930 '\u0917\u0939\u0930\u093e\u0908 \u0938\u0947' \u0928\u091c\u093c\u0930 \u0921\u093e\u0932\u0924\u0947 \u0939\u0948\u0902 \u2014 \u0909\u0938\u0915\u0947 \u0928\u0940\u091a\u0947 \u090f\u0915 '\u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u091f\u093f\u092a' \u091b\u093f\u092a\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0940 \u0924\u093e\u0930\u0940\u0916 \u0915\u094b \u092a\u0932\u091f \u0938\u0915\u0924\u0940 \u0939\u0948\u0964",
    "\u091c\u092c \u0906\u092a '\u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f' \u0916\u094b\u0932\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0915\u093e\u0930\u094d\u0921 \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u090f\u0915 '\u0935\u093f\u0936 \u0921\u093f\u091f\u0947\u0932' \u0938\u0947\u0915\u094d\u0936\u0928 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0935\u0939\u093e\u0901 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e '\u0906\u0907\u0921\u093f\u092f\u093e \u092a\u094d\u0932\u0938' \u092c\u091f\u0928 \u0939\u0948\u0964 \u0909\u0938\u0947 \u0926\u092c\u093e\u090f\u0901\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b \u0909\u0938\u0940 \u092a\u0932 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u093e\u0936\u093f\u0924 \u092e\u094b\u0921\u093c \u0926\u0947\u0924\u093e \u0939\u0948 \u2014 \u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u091a\u0941\u0928\u094c\u0924\u0940 \u092f\u093e \u090f\u0915 \u0928\u092f\u093e \u090f\u0902\u0917\u0932 \u091c\u094b \u0906\u092a\u0915\u0940 \u0930\u0942\u091f\u0940\u0928 \u0915\u094b \u0924\u094b\u0921\u093c \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0935\u0939 \u091f\u094d\u0930\u093f\u0915 \u0939\u0948 \u091c\u094b \u0939\u092e\u093e\u0930\u0947 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 100% \u092c\u093e\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0905\u092c \u0906\u092a\u0915\u0940 \u092c\u093e\u0930\u0940: \u0906\u091c \u0930\u093e\u0924 '\u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f' \u0916\u094b\u0932\u0947\u0902, \u090f\u0915 \u092e\u0942\u0921 \u091a\u0941\u0928\u0947\u0902, \u0914\u0930 \u092b\u093f\u0930 \u0909\u0938 '\u0906\u0907\u0921\u093f\u092f\u093e \u092a\u094d\u0932\u0938' \u092c\u091f\u0928 \u0915\u094b \u0926\u092c\u093e\u090f\u0901\u0964 \u0906\u092a \u0926\u0947\u0916\u0947\u0902\u0917\u0947 \u0915\u093f \u090f\u0915 \u0938\u093e\u0927\u093e\u0930\u0923 \u0924\u093e\u0930\u0940\u0916 \u0915\u0948\u0938\u0947 \u0915\u0941\u091b \u092f\u093e\u0926\u0917\u093e\u0930 \u092c\u0928 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 P.S. \u0905\u0917\u0930 \u0906\u092a\u0915\u0940 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u094b \u092f\u0939 \u092a\u0938\u0902\u0926 \u0906\u090f, \u0924\u094b \u0909\u0938\u0947 '\u0935\u093f\u0936\u0932\u093f\u0938\u094d\u091f' \u092e\u0947\u0902 \u0938\u0947\u0935 \u0915\u0930\u0928\u093e \u0928 \u092d\u0942\u0932\u0947\u0902 \u2014 \u0939\u092e\u093e\u0930\u093e AI \u0905\u0917\u0932\u0940 \u092c\u093e\u0930 \u0909\u0938\u0940 \u0938\u0947 \u092a\u094d\u0930\u0947\u0930\u093f\u0924 \u0939\u094b\u0915\u0930 \u0906\u092a\u0915\u094b \u090f\u0915 \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c\u093c \u0926\u0947\u0917\u093e\u0964"
  ],
