{
  "subject": "\u0924\u0941\u092e 5000 \u092b\u0948\u0902\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0916\u0921\u093c\u0947 \u0939\u094b",
  "preview_text": "\u090f\u0915 \u0910\u0938\u093e \u0938\u092e\u0941\u0926\u093e\u092f \u091c\u0939\u093e\u0901 \u0939\u0930 \u092b\u0948\u0928 \u0921\u0947\u091f\u093e \u0938\u0947 \u0916\u0947\u0932\u0924\u093e \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0924\u0941\u092e \u0924\u0948\u092f\u093e\u0930 \u0939\u094b?",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u091c\u092c \u0924\u0941\u092e \u0938\u093f\u0930\u094d\u092b \u0905\u0902\u0924\u0930\u094d\u091c\u094d\u091e\u093e\u0928 \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u0915\u0930\u0924\u0947 \u0925\u0947? \u0905\u092c \u0924\u0941\u092e 5000 \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u092b\u0941\u091f\u092c\u0949\u0932 \u092b\u0948\u0902\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0939\u094b \u091c\u094b \u0939\u0930 \u092e\u0948\u091a \u0915\u094b \u0921\u0947\u091f\u093e \u0938\u0947 \u0938\u092e\u091d\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902 \u0939\u0948 - \u092f\u0939 \u090f\u0915 \u0906\u0902\u0926\u094b\u0932\u0928 \u0939\u0948\u0964",
    "\u0939\u0930 \u0930\u094b\u091c, \u0939\u091c\u093e\u0930\u094b\u0902 \u092b\u0948\u0902\u0938 \u092a\u094d\u0930\u0940\u0921\u093f\u0915\u094d\u091f\u093f\u092b\u093e\u0908 \u092a\u0930 \u0905\u092a\u0928\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u093f\u092f\u093e\u0901 \u092a\u094b\u0938\u094d\u091f \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0911\u092b \u0926 \u0921\u0947 \u092a\u0930 \u0935\u094b\u091f \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0914\u0930 \u090f\u0906\u0908 \u0938\u0947 \u092c\u0939\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e \u0905\u092c \u0907\u0938 '\u0938\u094d\u092e\u093e\u0930\u094d\u091f \u092b\u0948\u0928' \u091f\u094d\u0930\u093e\u0907\u092c \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u094b \u091c\u094b '\u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917' \u0915\u094b '\u0921\u0947\u091f\u093e-\u092c\u0948\u0915\u094d\u0921 \u0907\u0928\u0938\u093e\u0907\u091f' \u0938\u0947 \u092c\u0926\u0932 \u0930\u0939\u093e \u0939\u0948\u0964",
    "\u0905\u092a\u0928\u0947 \u0915\u092e\u094d\u092f\u0941\u0928\u093f\u091f\u0940 \u091f\u0948\u092c \u092e\u0947\u0902 \u091c\u093e\u0913 \u0914\u0930 \u0926\u0947\u0916\u094b \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u091c\u0948\u0938\u0947 \u092b\u0948\u0902\u0938 \u0915\u0948\u0938\u0947 \u0932\u0940\u0917 \u0915\u0947 \u0939\u0930 \u092e\u0948\u091a \u092a\u0930 \u091a\u0930\u094d\u091a\u093e \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091f\u0940\u092e \u0915\u093e \u0917\u094d\u0930\u0941\u092a \u091c\u0949\u0907\u0928 \u0915\u0930\u094b, \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0911\u092b \u0926 \u0921\u0947 \u092a\u0930 \u0935\u094b\u091f \u0915\u0930\u094b, \u0914\u0930 \u0926\u0947\u0916\u094b \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0930\u0948\u0902\u0915 \u0915\u0939\u093e\u0901 \u0939\u0948\u0964 \u092f\u0939\u093e\u0901 \u0939\u0930 \u092b\u0948\u0928 \u0915\u094b \u090f\u0915 \u0935\u0949\u092f\u0938 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u0915\u092e\u094d\u092f\u0941\u0928\u093f\u091f\u0940' \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u0905\u092a\u0928\u093e \u092a\u0939\u0932\u093e \u0935\u094b\u091f \u0921\u093e\u0932\u094b\u0964 P.S. - \u0906\u091c \u0915\u093e \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0911\u092b \u0926 \u0921\u0947 \u092e\u0948\u0928\u091a\u0947\u0938\u094d\u091f\u0930 \u092f\u0942\u0928\u093e\u0907\u091f\u0947\u0921 \u092c\u0928\u093e\u092e \u0906\u0930\u094d\u0938\u0947\u0928\u0932 \u0939\u0948 - 67% \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0915\u0949\u0932\u0964 \u0915\u094d\u092f\u093e \u0924\u0941\u092e \u0938\u0939\u0940 \u0939\u094b?"
  ],
