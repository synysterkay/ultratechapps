{
  "subject": "\u09b0\u09be\u09a4 \u09e8\u099f\u09be\u09b0 \u09ad\u09c1\u09b2 \u09b8\u09bf\u09a6\u09cd\u09a7\u09be\u09a8\u09cd\u09a4 \u09af\u09be \u09b8\u09ac\u09be\u09b0 \u099c\u09c0\u09ac\u09a8 \u09ac\u09a6\u09b2\u09c7 \u09a6\u09bf\u09b2",
  "preview_text": "\u098f\u0995\u099c\u09a8 \u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u09ab\u09c1\u099f\u09ac\u09b2 \u09ab\u09cd\u09af\u09be\u09a8\u09c7\u09b0 \u0997\u09b2\u09cd\u09aa, \u09af\u09bf\u09a8\u09bf \u09a1\u09c7\u099f\u09be\u09b0 \u099c\u09cb\u09b0\u09c7 \u09b8\u09ac \u09ad\u09c1\u09b2\u9884\u6d4b \u09ac\u09a6\u09b2\u09c7 \u09ab\u09c7\u09b2\u09b2\u09c7\u09a8\u0964 \u0986\u09aa\u09a8\u09be\u09b0\u0993 \u098f\u0995\u0987 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964",
  "body_paragraphs": [
    "\u0997\u09a4 \u09ae\u09be\u09b8\u09c7, \u09b0\u09be\u09a4 \u09e8\u099f\u09be\u09af\u09bc \u09ac\u09b8\u09c7 \u099b\u09bf\u09b2\u09be\u09ae \u09ae\u09cd\u09af\u09be\u099a \u09a6\u09c7\u0996\u09a4\u09c7\u0964 \u09ac\u09a8\u09cd\u09a7\u09c1\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09ac\u09be\u099c\u09bf \u09a7\u09b0\u09c7\u099b\u09bf\u09b2\u09be\u09ae, \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u09ac\u09be\u09b0\u0993 \u0986\u09ae\u09be\u09b0 \u0997\u09be\u099f \u09ab\u09bf\u09b2\u09bf\u0982 \u09ad\u09c1\u09b2 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3 \u09b9\u09b2\u09cb\u0964 \u09b9\u09c7\u09b0\u09c7 \u0997\u09c7\u09b2\u09be\u09ae, \u0986\u09b0 \u09ae\u09a8\u099f\u09be \u0996\u09be\u09b0\u09be\u09aa \u09b9\u09af\u09bc\u09c7 \u0997\u09c7\u09b2\u0964 \u09a4\u0996\u09a8\u0987 \u09ae\u09a8\u09c7 \u09aa\u09a1\u09bc\u09b2 Predictify-\u09b0 \u0995\u09a5\u09be, \u09af\u09c7\u099f\u09be \u0986\u09ae\u09bf \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09c7\u099b\u09bf\u09b2\u09be\u09ae \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09a0\u09bf\u0995 \u09ae\u09a4\u09cb \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09bf\u09a8\u09bf\u0964",
    "\u0986\u09ae\u09bf \u09a6\u09c7\u0996\u09b2\u09be\u09ae, AI \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3 \u0995\u09b0\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u09b9\u09be\u099c\u09be\u09b0\u09cb \u09ad\u09c7\u09b0\u09bf\u09af\u09bc\u09c7\u09ac\u09b2, \u0986\u09b0 \u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u09b8\u09cd\u0995\u09cb\u09b0 \u09a6\u09c7\u09af\u09bc\u0964 \u09aa\u09cd\u09b0\u09a5\u09ae\u09ac\u09be\u09b0 \u09af\u0996\u09a8 La Liga-\u09b0 \u098f\u0995\u099f\u09be \u09ae\u09cd\u09af\u09be\u099a\u09c7 \u09ed\u09ee% \u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u09a6\u09c7\u0996\u09be\u09b2, \u0986\u09ae\u09bf \u09b8\u09c7\u099f\u09be \u09ab\u09b2\u09cb \u0995\u09b0\u09b2\u09be\u09ae\u0964 \u0986\u09b0 \u09b8\u09c7\u099f\u09be \u09b8\u09a0\u09bf\u0995 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3 \u09b9\u09b2\u09cb! \u0986\u09ae\u09be\u09b0 \u09ac\u09a8\u09cd\u09a7\u09c1\u09b0\u09be \u0985\u09ac\u09be\u0995 \u09b9\u09af\u09bc\u09c7 \u0997\u09c7\u09b2, \u0986\u09b0 \u0986\u09ae\u09bf \u09ac\u09c1\u099d\u09b2\u09be\u09ae\u2014\u09a1\u09c7\u099f\u09be \u09b8\u09ac\u09b8\u09ae\u09af\u09bc \u0997\u09be\u099f \u09ab\u09bf\u09b2\u09bf\u0982\u0995\u09c7 \u09b9\u09be\u09b0\u09be\u09af\u09bc\u0964",
    "\u0986\u09ae\u09bf \u098f\u0996\u09a8 \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09bf\u09a8 Predictify \u0996\u09c1\u09b2\u09bf, \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7 Head-to-Head \u09b9\u09bf\u09b8\u09cd\u099f\u09cd\u09b0\u09bf \u0986\u09b0 \u099f\u09cd\u09af\u09be\u0995\u099f\u09bf\u0995\u09cd\u09af\u09be\u09b2 \u0985\u09cd\u09af\u09be\u09a8\u09be\u09b2\u09be\u0987\u09b8\u09bf\u09b8 \u09a6\u09c7\u0996\u09bf\u0964 \u09a4\u09be\u09b0\u09aa\u09b0 IQ Quiz \u0996\u09c7\u09b2\u09c7 \u09a8\u09bf\u099c\u09c7\u09b0 \u099c\u09cd\u099e\u09be\u09a8 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09bf, \u0986\u09b0 \u0995\u09ae\u09bf\u0989\u09a8\u09bf\u099f\u09bf\u09a4\u09c7 Prediction of the Day \u09a8\u09bf\u09af\u09bc\u09c7 \u0986\u09b2\u09cb\u099a\u09a8\u09be \u0995\u09b0\u09bf\u0964 \u09a1\u09c7\u099f\u09be-\u09ac\u09cd\u09af\u09be\u0995\u09a1 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u0986\u09ae\u09be\u09b0 \u09ab\u09c1\u099f\u09ac\u09b2 \u09a6\u09c7\u0996\u09be\u09b0 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u09ac\u09a6\u09b2\u09c7 \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09c7\u2014\u0986\u09ae\u09bf \u0986\u09b0 \u09b6\u09c1\u09a7\u09c1 \u09ad\u0995\u09cd\u09a4 \u09a8\u0987, \u09b8\u09cd\u09ae\u09be\u09b0\u09cd\u099f \u09ab\u09cd\u09af\u09be\u09a8\u0964",
    "\u0986\u09aa\u09a8\u09be\u09b0\u0993 \u09b8\u09ae\u09af\u09bc \u098f\u09b8\u09c7\u099b\u09c7\u0964 \u0986\u099c\u0987 Predictify \u0996\u09c1\u09b2\u09c1\u09a8, \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u099b\u09a8\u09cd\u09a6\u09c7\u09b0 \u09b2\u09bf\u0997\u09c7\u09b0 \u099c\u09a8\u09cd\u09af AI-\u09b0 \u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u09b8\u09cd\u0995\u09cb\u09b0 \u09a6\u09c7\u0996\u09c1\u09a8\u0964 P.S. \u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u098f\u0996\u09a8\u09cb \u09ab\u09cd\u09b0\u09bf \u099f\u09cd\u09b0\u09be\u09af\u09bc\u09be\u09b2 \u09a8\u09be \u09a8\u09c7\u09a8, \u09e9 \u09a6\u09bf\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af Premium \u0986\u09a8\u09b2\u09bf\u09ae\u09bf\u099f\u09c7\u09a1 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c7 \u09a6\u09c7\u0996\u09c1\u09a8\u2014\u09b6\u09c1\u09a7\u09c1 $\u09e7\u09e8.\u09ef\u09ef/\u09ae\u09be\u09b8\u0964"
  ],
