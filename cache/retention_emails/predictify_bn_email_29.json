{
  "subject": "\u09a6\u09c0\u09b0\u09cd\u0998 \u09ec\u09ee \u09a6\u09bf\u09a8\u09c7\u09b0 \u09b8\u0999\u09cd\u0997\u09c0\u0995\u09c7 \u09ac\u09bf\u09b6\u09c7\u09b7 \u0989\u09aa\u09b9\u09be\u09b0",
  "preview_text": "\u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0995\u099a\u09c7\u099f\u09bf\u09af\u09bc\u09be \u0995\u09bf\u099b\u09c1 \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be \u0995\u09b0\u099b\u09c7 \u09af\u09be \u09b6\u09c1\u09a7\u09c1 \u09a6\u09c0\u09b0\u09cd\u0998\u09ae\u09c7\u09af\u09bc\u09be\u09a6\u09c0 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0\u09be\u0987 \u09aa\u09be\u09ac\u09c7\u09a8\u0964 \u09ad\u09bf\u09a4\u09b0\u09c7 \u09a6\u09c7\u0996\u09c1\u09a8\u0964",
  "body_paragraphs": [
    "\u09ec\u09ee \u09a6\u09bf\u09a8 \u0986\u0997\u09c7 \u0986\u09aa\u09a8\u09bf Predictify \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09c7\u099b\u09bf\u09b2\u09c7\u09a8\u0964 \u09b8\u09c7\u0987 \u09a5\u09c7\u0995\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09ae\u09cd\u09af\u09be\u099a, \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8\u2014\u0986\u09aa\u09a8\u09bf \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u0986\u099b\u09c7\u09a8\u0964 \u0986\u099c \u0986\u09ae\u09bf \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09a7\u09a8\u09cd\u09af\u09ac\u09be\u09a6 \u099c\u09be\u09a8\u09be\u09a4\u09c7 \u099a\u09be\u0987, \u09b6\u09c1\u09a7\u09c1 \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09a8\u09af\u09bc, \u09ac\u09b0\u0982 \u09ac\u09bf\u09b6\u09cd\u09ac\u09be\u09b8 \u09b0\u09be\u0996\u09be\u09b0 \u099c\u09a8\u09cd\u09af\u0964",
    "\u0985\u09a7\u09bf\u0995\u09be\u0982\u09b6 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0 \u09aa\u09cd\u09b0\u09a5\u09ae \u09b8\u09aa\u09cd\u09a4\u09be\u09b9\u09c7\u0987 \u099a\u09b2\u09c7 \u09af\u09be\u09af\u09bc, \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u09aa\u09a8\u09bf \u09a5\u09be\u0995\u09b2\u09c7\u09a8\u0964 \u0986\u09aa\u09a8\u09bf \u09aa\u09cd\u09b0\u09ae\u09be\u09a3 \u0995\u09b0\u09c7\u099b\u09c7\u09a8 \u09af\u09c7 \u09ab\u09c1\u099f\u09ac\u09b2 \u09ac\u09cb\u099d\u09be \u09b6\u09c1\u09a7\u09c1 \u0986\u09ac\u09c7\u0997 \u09a8\u09af\u09bc, \u09a1\u09c7\u099f\u09be\u0993 \u09b2\u09be\u0997\u09c7\u0964 \u09a4\u09be\u0987 \u0986\u099c \u0986\u09ae\u09b0\u09be \u09b6\u09c1\u09a7\u09c1 \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0995\u099a\u09c7\u099f\u09bf\u09af\u09bc\u09be \u0995\u09bf\u099b\u09c1 \u0996\u09c1\u09b2\u09c7 \u09a6\u09bf\u099a\u09cd\u099b\u09bf\u2014\u098f\u0995\u099f\u09bf \u09ac\u09bf\u09b6\u09c7\u09b7 '\u0987\u09a8\u09b8\u09be\u0987\u09a1\u09be\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8' \u09af\u09be \u09a6\u09c0\u09b0\u09cd\u0998\u09ae\u09c7\u09af\u09bc\u09be\u09a6\u09c0 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0\u09be\u0987 \u09aa\u09be\u09af\u09bc\u0964",
    "\u098f\u0996\u09a8 \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af Predictify-\u098f \u098f\u0995\u099f\u09bf \u09a8\u09a4\u09c1\u09a8 \u09ac\u09bf\u09ad\u09be\u0997 \u0996\u09cb\u09b2\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7: '\u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09af\u09bc\u09be\u09ae \u09aa\u09bf\u0995\u09b8'\u2014\u09af\u09c7\u0996\u09be\u09a8\u09c7 AI \u0995\u09c7\u09ac\u09b2\u09ae\u09be\u09a4\u09cd\u09b0 \u0989\u099a\u09cd\u099a \u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u09b8\u09cd\u0995\u09cb\u09b0 (90%+) \u09b8\u09b9 \u09ae\u09cd\u09af\u09be\u099a \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u09a6\u09c7\u0996\u09be\u09af\u09bc\u0964 \u098f\u099f\u09bf \u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0\u09be \u09a6\u09c7\u0996\u09a4\u09c7 \u09aa\u09be\u09af\u09bc \u09a8\u09be\u0964 \u09b6\u09c1\u09a7\u09c1 \u0986\u09aa\u09a8\u09bf\u0987 \u09a6\u09c7\u0996\u09a4\u09c7 \u09aa\u09be\u09ac\u09c7\u09a8, \u0985\u09a8\u09cd\u09a4\u09a4 \u0986\u099c\u0995\u09c7\u09b0 \u099c\u09a8\u09cd\u09af\u0964",
    "\u0986\u099c \u09b0\u09be\u09a4 \u09e7\u09e7\u099f\u09be\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 Predictify \u0996\u09c1\u09b2\u09c1\u09a8 \u098f\u09ac\u0982 '\u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09af\u09bc\u09be\u09ae \u09aa\u09bf\u0995\u09b8' \u09ac\u09bf\u09ad\u09be\u0997\u099f\u09bf \u09a6\u09c7\u0996\u09c1\u09a8\u0964 P.S. \u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u098f\u0996\u09be\u09a8\u09c7 \u09b2\u09bf\u09ad\u09be\u09b0\u09aa\u09c1\u09b2 \u09ac\u09a8\u09be\u09ae \u0986\u09b0\u09cd\u09b8\u09c7\u09a8\u09be\u09b2 \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u09ef\u09ea% \u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u09b8\u09cd\u0995\u09cb\u09b0 \u09b8\u09b9 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u09a6\u09c7\u0996\u09a4\u09c7 \u09aa\u09be\u09a8, \u09a4\u09be\u09b9\u09b2\u09c7 \u099c\u09be\u09a8\u09ac\u09c7\u09a8\u2014\u09a1\u09c7\u099f\u09be \u0995\u0996\u09a8\u09cb \u09ae\u09bf\u09a5\u09cd\u09af\u09be \u09ac\u09b2\u09c7 \u09a8\u09be\u0964"
  ],
