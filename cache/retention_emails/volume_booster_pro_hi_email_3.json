{
  "subject": "4 \u0926\u093f\u0928, 1 \u091f\u094d\u0930\u093f\u0915, \u0914\u0930 \u0906\u092a\u0915\u093e \u092b\u093c\u094b\u0928 \u0917\u0942\u0902\u091c \u0909\u0920\u0947\u0917\u093e",
  "preview_text": "\u092c\u093f\u0928\u093e \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928\u094b\u0902 \u0915\u0947, \u092c\u0938 \u090f\u0915 \u0938\u094d\u0932\u093e\u0907\u0921\u0930\u0964 \u0926\u0947\u0916\u093f\u090f \u0915\u0948\u0938\u0947 \u092f\u0939 \u091b\u094b\u091f\u0940 \u0938\u0940 \u091a\u0940\u091c\u093c \u0906\u092a\u0915\u0940 \u0930\u094b\u091c\u093c \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u092c\u0926\u0932 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 2 \u092c\u091c\u0947, \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0917\u0932\u0924\u0940 \u0915\u0940\u0964 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u0924\u0947 \u0939\u0941\u090f, \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 \u092b\u093c\u094b\u0928 \u0915\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u093e\u0907\u0921 \u092c\u091f\u0928 \u0926\u092c\u093e\u092f\u093e\u0964 \u0914\u0930 \u0905\u091a\u093e\u0928\u0915, \u090f\u0915 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0915\u093e \u0936\u094b\u0930 \u091a\u093f\u0932\u094d\u0932\u093e\u092f\u093e\u0964 \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e, '\u092f\u0939 \u0924\u094b \u0935\u0939\u0940 \u092a\u0941\u0930\u093e\u0928\u0940 \u0915\u0939\u093e\u0928\u0940 \u0939\u0948\u0964' \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u092e\u0941\u091d\u0947 \u092f\u093e\u0926 \u0906\u092f\u093e\u2014\u0906\u092a\u0915\u0947 \u092a\u093e\u0938 Volume Booster Pro \u0939\u0948\u0964 \u0914\u0930 \u092f\u0939 \u0935\u0948\u0938\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",
    "\u092f\u0939\u093e\u0901 \u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u091f\u094d\u0930\u093f\u0915 \u0939\u0948 \u091c\u094b \u0924\u0941\u0930\u0902\u0924 \u092b\u0930\u094d\u0915 \u0926\u093f\u0916\u093e\u0924\u0940 \u0939\u0948: \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902, \u0914\u0930 \u0910\u092a \u0916\u094b\u0932\u0947\u0902\u0964 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b 200% \u0924\u0915 \u0916\u0940\u0902\u091a\u0947\u0902\u0964 \u092c\u0938 \u0907\u0924\u0928\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0928\u0939\u0940\u0902\u0964 \u0906\u092a\u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0905\u091a\u093e\u0928\u0915 \u0917\u0939\u0930\u0940, \u0938\u093e\u092b\u093c \u0914\u0930 \u0936\u0915\u094d\u0924\u093f\u0936\u093e\u0932\u0940 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u2014\u091c\u0948\u0938\u0947 \u0906\u092a\u0915\u093e \u092b\u093c\u094b\u0928 \u0916\u0941\u0926 \u0915\u094b \u092b\u093f\u0930 \u0938\u0947 \u0916\u094b\u091c \u0932\u0947\u0924\u093e \u0939\u0948\u0964",
    "\u092f\u0939 \u0938\u0941\u0935\u093f\u0927\u093e\u2014\u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b\u0928\u0947 \u092a\u0930 \u0911\u091f\u094b-\u0905\u092a\u094d\u0932\u093e\u0908\u2014\u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0928\u0947 \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092c\u0928\u093e\u0908 \u0939\u0948 \u091c\u094b \u092c\u0938 \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u093e\u092e \u0915\u0930\u0947\u0964 \u0915\u094b\u0908 \u092c\u094d\u0932\u094b\u091f, \u0915\u094b\u0908 \u0917\u0947\u092e \u0932\u0947\u092f\u0930\u0964 \u092c\u0938 \u0906\u092a, \u0906\u092a\u0915\u093e \u0938\u0902\u0917\u0940\u0924, \u0914\u0930 \u0935\u0939 \u0936\u093e\u0902\u0924 \u0936\u0915\u094d\u0924\u093f \u091c\u094b \u0906\u092a\u0915\u094b \u092f\u093e\u0926 \u0926\u093f\u0932\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u0909\u092a\u092f\u094b\u0917\u093f\u0924\u093e \u0915\u093f\u0924\u0928\u0940 \u0938\u0941\u0902\u0926\u0930 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964",
    "\u0906\u091c, \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0910\u092a \u0916\u094b\u0932\u0947\u0902\u0964 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902, \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b 200% \u092a\u0930 \u0938\u0947\u091f \u0915\u0930\u0947\u0902, \u0914\u0930 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0947\u0902\u0964 P.S. \u092f\u0939 \u091f\u094d\u0930\u093f\u0915 \u0938\u093f\u0930\u094d\u092b \u0936\u0941\u0930\u0941\u0906\u0924 \u0939\u0948\u2014\u0905\u0917\u0932\u0947 \u0908\u092e\u0947\u0932 \u092e\u0947\u0902, \u092e\u0948\u0902 \u0906\u092a\u0915\u094b \u0926\u093f\u0916\u093e\u090a\u0901\u0917\u093e \u0915\u093f EQ \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u0948\u0938\u0947 \u0906\u092a\u0915\u0947 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u094b \u0938\u093f\u0928\u0947\u092e\u093e \u091c\u0948\u0938\u093e \u092c\u0928\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0964"
  ],
  "cta_text": "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b 200% \u092a\u0930 \u0932\u0947 \u091c\u093e\u090f\u0902",
