{
  "subject": "\u0935\u094b \u0938\u091a \u091c\u094b \u0939\u0930 \u0915\u092a\u0932 \u0915\u094b \u092a\u0924\u093e \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f",
  "preview_text": "\u0906\u092a \u0938\u094b\u091a\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0938\u094d\u092a\u093e\u0930\u094d\u0915 \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u0939\u0902\u0917\u0940 \u0921\u0947\u091f\u094d\u0938 \u091a\u093e\u0939\u093f\u090f? \u092f\u0939 \u091d\u0942\u0920 \u0939\u0948\u0964 \u091c\u093e\u0928\u093f\u090f \u0905\u0938\u0932\u0940 \u0930\u093e\u091c\u0964",
  "body_paragraphs": [
    "\u0906\u092a\u0915\u094b \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u0930\u094b\u092e\u093e\u0902\u0938 \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u0930 \u0939\u092b\u094d\u0924\u0947 \u0915\u094b\u0908 \u0928\u0908, \u092e\u0939\u0902\u0917\u0940 \u091c\u0917\u0939 \u092a\u0930 \u091c\u093e\u0928\u093e \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948? \u0938\u091a \u092f\u0939 \u0939\u0948 \u0915\u093f 90% \u0915\u092a\u0932\u094d\u0938 \u092f\u0939 \u0917\u0932\u0924\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u0947 \u0938\u094b\u091a\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u092c\u091c\u091f \u0915\u092e \u0939\u0948 \u0924\u094b \u0938\u094d\u092a\u093e\u0930\u094d\u0915 \u0916\u0924\u094d\u092e \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964 \u092a\u0930 \u0939\u0915\u0940\u0915\u0924 \u0915\u0941\u091b \u0914\u0930 \u0939\u0948\u0964",
    "\u0939\u092e\u093e\u0930\u0947 \u0921\u0947\u091f\u093e \u092e\u0947\u0902 230 \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0915\u092a\u0932\u094d\u0938 \u0928\u0947 \u0926\u093f\u0916\u093e\u092f\u093e \u0939\u0948 \u0915\u093f \u0938\u092c\u0938\u0947 \u092f\u093e\u0926\u0917\u093e\u0930 \u0921\u0947\u091f\u094d\u0938 \u0935\u0947 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902 \u091c\u094b \u091b\u094b\u091f\u0940, \u092a\u0930\u094d\u0938\u0928\u0932 \u0914\u0930 \u0905\u0928\u092a\u0947\u0915\u094d\u0937\u093f\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964 \u090f\u0915 \u0938\u0938\u094d\u0924\u0940 \u092a\u093f\u0915\u0928\u093f\u0915, \u0918\u0930 \u092a\u0930 \u092c\u0928\u0940 \u0915\u0949\u092b\u0940 \u0915\u0947 \u0938\u093e\u0925 \u092c\u093e\u0924\u0947\u0902, \u092f\u093e \u092c\u0938 \u090f\u0915 \u0938\u093e\u0925 \u0935\u0949\u0915\u2014\u092f\u0939\u0940 \u091a\u0940\u091c\u0947\u0902 \u0905\u0938\u0932\u0940 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u092c\u0928\u093e\u0924\u0940 \u0939\u0948\u0902\u0964 \u092e\u0939\u0902\u0917\u093e \u0930\u0947\u0938\u094d\u091f\u094b\u0930\u0947\u0902\u091f \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0927\u094d\u092f\u093e\u0928 \u0914\u0930 \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0915\u093e \u090f\u0939\u0938\u093e\u0938 \u092e\u093e\u092f\u0928\u0947 \u0930\u0916\u0924\u093e \u0939\u0948\u0964",
    "\u092f\u0939\u0940 \u0935\u091c\u0939 \u0939\u0948 \u0915\u093f \u0939\u092e\u0928\u0947 SoulPlan \u092e\u0947\u0902 '\u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928\u0930' \u092b\u0940\u091a\u0930 \u092c\u0928\u093e\u092f\u093e\u0964 \u0907\u0938\u092e\u0947\u0902 \u0906\u092a \u092c\u093f\u0928\u093e \u092c\u0924\u093e\u090f \u0905\u092a\u0928\u0947 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u091b\u094b\u091f\u0940, \u092c\u091c\u091f-\u092b\u094d\u0930\u0947\u0902\u0921\u0932\u0940 \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 AI \u0906\u092a\u0915\u0940 \u092a\u0938\u0902\u0926 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0906\u0907\u0921\u093f\u092f\u093e\u091c \u0926\u0947\u0924\u093e \u0939\u0948\u2014\u091a\u093e\u0939\u0947 \u0935\u094b 50 \u0930\u0941\u092a\u092f\u0947 \u0915\u0940 \u091a\u093e\u092f \u0939\u094b \u092f\u093e \u092b\u094d\u0930\u0940 \u092e\u0947\u0902 \u092a\u093e\u0930\u094d\u0915 \u092e\u0947\u0902 \u0918\u0942\u092e\u0928\u093e\u0964 \u092f\u0939 \u092b\u0940\u091a\u0930 \u0906\u092a\u0915\u094b \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0938\u094d\u092a\u093e\u0930\u094d\u0915 \u092a\u0948\u0938\u0947 \u0938\u0947 \u0928\u0939\u0940\u0902, \u0927\u094d\u092f\u093e\u0928 \u0938\u0947 \u091c\u0932\u0924\u093e \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928\u0930' \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u090f\u0915 \u091b\u094b\u091f\u0940, \u092e\u091c\u0947\u0926\u093e\u0930 \u0921\u0947\u091f \u092c\u0928\u093e\u090f\u0902 \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0906\u092a\u0915\u093e \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u0948\u0938\u0947 \u0916\u093f\u0932 \u0909\u0920\u0924\u093e \u0939\u0948\u0964 P.S. \u092f\u0915\u0940\u0928 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e? \u0939\u092e\u093e\u0930\u0947 92% \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0907\u0938 \u092b\u0940\u091a\u0930 \u0928\u0947 \u0909\u0928\u0915\u0940 \u0930\u093f\u0932\u0947\u0936\u0928\u0936\u093f\u092a \u092c\u0926\u0932 \u0926\u0940\u0964 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u094b, \u0916\u0941\u0926 \u092a\u0924\u093e \u091a\u0932\u0947\u0917\u093e\u0964"
  ],
  "cta_text": "\u0905\u092c \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0921\u0947\u091f \u092c\u0928\u093e\u090f\u0902",
