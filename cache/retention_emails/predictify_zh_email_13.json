  "body_paragraphs": [
    "\u5144\u5f1f\uff0c\u4f60\u5df2\u7ecf\u7528Predictify\u6574\u6574\u4e00\u4e2a\u6708\u4e86\u3002\u6211\u731c\u4f60\u5fc3\u91cc\u80af\u5b9a\u5728\u5600\u5495\uff1a'\u6211\u5230\u5e95\u6709\u6ca1\u6709\u53d8\u5f97\u66f4\u806a\u660e\uff1f' \u522b\u6025\uff0c\u5148\u522b\u56de\u7b54\u2014\u2014\u56e0\u4e3a\u7b54\u6848\u53ef\u80fd\u8ba9\u4f60\u5413\u4e00\u8df3\u3002\u4f60\u8fc7\u53bb\u7684\u9884\u6d4b\uff0c\u6709\u591a\u5c11\u662f\u771f\u7684\u9760\u601d\u8003\uff0c\u591a\u5c11\u53ea\u662f\u8fd0\u6c14\uff1f",
