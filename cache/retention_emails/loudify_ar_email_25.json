{
  "subject": "\u0627\u0644\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u064a \u0627\u0633\u062a\u062e\u062f\u0645 \u0628\u0647\u0627 \u0623\u062d\u062f\u0647\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0644\u064a\u0644\u0627\u064b",
  "preview_text": "\u0642\u0635\u0629 \u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0633\u062a\u062e\u062f\u0645 Loudify \u0628\u0637\u0631\u064a\u0642\u0629 \u0644\u0645 \u062a\u062e\u0637\u0631 \u0628\u0628\u0627\u0644\u0643... \u0642\u062f \u062a\u063a\u064a\u0631 \u0646\u0638\u0631\u062a\u0643 \u0644\u0644\u062a\u0637\u0628\u064a\u0642",
  "body_paragraphs": [
    "\u0641\u064a \u0627\u0644\u0633\u0627\u0639\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0635\u0628\u0627\u062d\u0627\u064b\u060c \u062a\u0644\u0642\u064a\u062a \u0631\u0633\u0627\u0644\u0629 \u0645\u0646 \u0645\u0633\u062a\u062e\u062f\u0645 \u064a\u0642\u0648\u0644: '\u0644\u0642\u062f \u0623\u0646\u0642\u0630\u062a\u0646\u064a \u0627\u0628\u0646\u062a\u064a \u0627\u0644\u0644\u064a\u0644\u0629'. \u0644\u0645 \u0623\u0643\u0646 \u0623\u0639\u0631\u0641 \u0645\u0627\u0630\u0627 \u064a\u0639\u0646\u064a \u0630\u0644\u0643. \u062a\u0628\u064a\u0646 \u0623\u0646\u0647 \u0643\u0627\u0646 \u064a\u0636\u0639 \u0633\u0645\u0627\u0639\u0627\u062a\u0647 \u0639\u0644\u0649 \u0623\u0630\u0646 \u0637\u0641\u0644\u062a\u0647 \u0627\u0644\u0631\u0636\u064a\u0639\u0629 \u0623\u062b\u0646\u0627\u0621 \u0646\u0648\u0645\u0647\u0627\u060c \u0648\u064a\u0633\u062a\u062e\u062f\u0645 \u062e\u0627\u0635\u064a\u0629 \u0627\u0644\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0635\u0648\u062a\u064a \u0644\u062a\u0647\u062f\u0626\u062a\u0647\u0627 \u0645\u0646 \u0627\u0644\u0636\u0648\u0636\u0627\u0621 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629. \u0634\u064a\u0621 \u0644\u0645 \u0623\u062a\u0648\u0642\u0639\u0647 \u0623\u0628\u062f\u0627\u064b.",
    "\u0647\u0630\u0627 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062c\u0639\u0644\u0646\u064a \u0623\u0641\u0643\u0631: Loudify \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u062a\u0637\u0628\u064a\u0642 \u0644\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a. \u0625\u0646\u0647 \u0623\u062f\u0627\u0629 \u0644\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0628\u064a\u0626\u0629 \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0645\u0646 \u062d\u0648\u0644\u0643. \u0633\u0648\u0627\u0621 \u0643\u0646\u062a \u062a\u0631\u064a\u062f \u0633\u0645\u0627\u0639 \u0627\u0644\u062d\u0648\u0627\u0631 \u0641\u064a \u0641\u064a\u0644\u0645 \u0648\u0633\u0637 \u0636\u0648\u0636\u0627\u0621 \u0627\u0644\u0645\u0637\u0628\u062e\u060c \u0623\u0648 \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u062a\u0631\u0643\u064a\u0632 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0639\u0645\u0644 \u0628\u062c\u0648\u0627\u0631 \u0645\u0643\u064a\u0641 \u0647\u0648\u0627\u0621 \u0635\u0627\u062e\u0628\u060c \u0623\u0648 \u062d\u062a\u0649 \u062a\u0631\u064a\u062f \u062d\u0645\u0627\u064a\u0629 \u0637\u0641\u0644\u0643 \u0645\u0646 \u0627\u0644\u0636\u0648\u0636\u0627\u0621 \u0627\u0644\u0645\u0632\u0639\u062c\u0629.",
    "\u062e\u0627\u0635\u064a\u0629 AutoEQ \u0627\u0644\u062a\u064a \u062a\u0639\u0631\u0641 \u0633\u0645\u0627\u0639\u0627\u062a\u0643 \u0641\u0648\u0631 \u0627\u062a\u0635\u0627\u0644\u0647\u0627\u060c \u062a\u0639\u0645\u0644 \u0639\u0644\u0649 \u062a\u062e\u0635\u064a\u0635 \u0627\u0644\u0635\u0648\u062a \u0644\u062a\u0646\u0627\u0633\u0628 \u0623\u064a \u0645\u0648\u0642\u0641. \u0645\u0639 4 \u0645\u0644\u0641\u0627\u062a \u0635\u0648\u062a\u064a\u0629 \u0645\u062e\u062a\u0644\u0641\u0629 (\u0645\u0648\u0633\u064a\u0642\u0649\u060c \u0623\u0641\u0644\u0627\u0645\u060c \u0628\u0648\u062f\u0643\u0627\u0633\u062a\u060c \u0623\u0644\u0639\u0627\u0628)\u060c \u064a\u0645\u0643\u0646\u0643 \u062a\u062d\u0648\u064a\u0644 \u0623\u064a \u062a\u062c\u0631\u0628\u0629 \u0633\u0645\u0639\u064a\u0629 \u0625\u0644\u0649 \u0634\u064a\u0621 \u0646\u0638\u064a\u0641 \u0648\u0642\u0648\u064a. \u0644\u0643\u0646 \u0627\u0644\u0642\u0635\u0629 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629 \u0647\u064a \u0643\u064a\u0641 \u064a\u0633\u062a\u062e\u062f\u0645\u0647 \u0627\u0644\u0646\u0627\u0633 \u0628\u0637\u0631\u0642 \u063a\u064a\u0631 \u0645\u062a\u0648\u0642\u0639\u0629 \u0644\u062a\u062d\u0633\u064a\u0646 \u062d\u064a\u0627\u062a\u0647\u0645 \u0627\u0644\u064a\u0648\u0645\u064a\u0629.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628 \u0648\u0636\u0639 '\u0628\u0648\u062f\u0643\u0627\u0633\u062a' \u0645\u0639 \u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0635\u0648\u062a \u0628\u0646\u0633\u0628\u0629 200%. \u0642\u062f \u062a\u0643\u062a\u0634\u0641 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0627\u064b \u062c\u062f\u064a\u062f\u0627\u064b \u0644\u0645 \u064a\u062e\u0637\u0631 \u0628\u0628\u0627\u0644\u0643. P.S. \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0630\u064a \u0623\u0631\u0633\u0644 \u0644\u064a \u0627\u0644\u0631\u0633\u0627\u0644\u0629\u060c \u0623\u0635\u0628\u062d \u0627\u0644\u0622\u0646 \u0645\u0634\u062a\u0631\u0643\u0627\u064b \u0641\u064a Premium \u0644\u064a\u062d\u0635\u0644 \u0639\u0644\u0649 \u0625\u0639\u062f\u0627\u062f\u0627\u062a AutoEQ \u0627\u0644\u0645\u062e\u0635\u0635\u0629 \u0644\u0633\u0645\u0627\u0639\u0627\u062a\u0647."
  ],
