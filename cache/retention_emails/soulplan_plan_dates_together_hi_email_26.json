{
  "subject": "\u090f\u0915 \u0930\u093e\u091c \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0906\u092a\u0938\u0947 \u091b\u0941\u092a\u093e\u092f\u093e \u0925\u093e",
  "preview_text": "\u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u092e\u0947\u0902 \u090f\u0915 \u0910\u0938\u093e \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b \u0915\u093f\u0938\u0940 \u0916\u093e\u0938 \u0915\u094b \u091c\u094b\u0921\u093c \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947?",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0915\u092a\u0932 \u0915\u094b \u0926\u0947\u0916\u093e \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0938\u093e\u0925 \u091f\u093e\u0907\u092e \u092c\u093f\u0924\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0930\u0938 \u0930\u0939\u0947 \u0925\u0947\u0964 \u0909\u0928\u0915\u0940 \u0906\u0901\u0916\u094b\u0902 \u092e\u0947\u0902 \u0935\u0939\u0940 \u091a\u092e\u0915 \u0925\u0940 \u091c\u094b \u092a\u0939\u0932\u0947 \u0921\u0947\u091f \u092a\u0930 \u0939\u094b\u0924\u0940 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0935\u0947 \u092d\u0942\u0932 \u0917\u090f \u0925\u0947 \u0915\u093f \u0907\u0938\u0947 \u0915\u0948\u0938\u0947 \u091c\u093f\u0902\u0926\u093e \u0930\u0916\u0947\u0902\u0964",
    "\u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a\u0915\u0947 \u0906\u0938\u092a\u093e\u0938 \u0915\u094b\u0908 \u0910\u0938\u093e \u0939\u0948 \u091c\u093f\u0938\u0947 \u0907\u0938 \u0910\u092a \u0915\u0940 \u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u091c\u0930\u0942\u0930\u0924 \u0939\u0948\u0964 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u0935\u094b \u0906\u092a\u0915\u093e \u0926\u094b\u0938\u094d\u0924 \u0939\u094b, \u092d\u093e\u0908-\u092c\u0939\u0928, \u092f\u093e \u0915\u094b\u0908 \u0938\u0939\u0915\u0930\u094d\u092e\u0940 \u091c\u094b \u0930\u093f\u0936\u094d\u0924\u0947 \u092e\u0947\u0902 \u092b\u0902\u0938\u093e \u0939\u0941\u0906 \u0939\u0948\u0964 \u0909\u0928\u094d\u0939\u0947\u0902 \u092c\u0938 \u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u092e\u0926\u0926 \u091a\u093e\u0939\u093f\u090f, \u0914\u0930 \u0935\u094b \u092e\u0926\u0926 \u0906\u092a\u0915\u0947 \u0939\u093e\u0925 \u092e\u0947\u0902 \u0939\u0948\u0964",
    "SoulPlan \u092e\u0947\u0902 \u090f\u0915 \u0917\u0941\u092a\u094d\u0924 \u092b\u0940\u091a\u0930 \u0939\u0948 - '\u0936\u0947\u092f\u0930 \u0935\u093f\u0926 \u092b\u094d\u0930\u0947\u0902\u0921'\u0964 \u091c\u092c \u0906\u092a \u0907\u0938\u0947 \u0936\u0947\u092f\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0906\u092a \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u0928\u0908 \u0936\u0941\u0930\u0941\u0906\u0924 \u0915\u093e \u0924\u094b\u0939\u092b\u093e \u0926\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0935\u094b \u0906\u092a\u0915\u094b \u0927\u0928\u094d\u092f\u0935\u093e\u0926 \u0915\u0939\u0947\u0902\u0917\u0947, \u0914\u0930 \u0906\u092a\u0915\u094b \u0932\u0917\u0947\u0917\u093e \u0915\u093f \u0906\u092a\u0928\u0947 \u0915\u0941\u091b \u0938\u0939\u0940 \u0915\u093f\u092f\u093e\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u090f\u0915 \u0915\u0926\u092e \u0909\u0920\u093e\u0928\u0947 \u0915\u093e\u0964 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u092e\u0947\u0902 SoulPlan \u0916\u094b\u0932\u0947\u0902, '\u0907\u0928\u0935\u093e\u0907\u091f \u092b\u094d\u0930\u0947\u0902\u0921' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902, \u0914\u0930 \u0909\u0938 \u090f\u0915 \u0936\u0916\u094d\u0938 \u0915\u094b \u092e\u0948\u0938\u0947\u091c \u092d\u0947\u091c\u0947\u0902\u0964 P.S. - \u091c\u092c \u0935\u094b \u091c\u0941\u0921\u093c\u0947\u0902\u0917\u0947, \u0924\u094b \u0906\u092a\u0915\u094b \u090f\u0915 \u090f\u0915\u094d\u0938\u0915\u094d\u0932\u0942\u0938\u093f\u0935 \u0921\u0947\u091f \u0906\u0907\u0921\u093f\u092f\u093e \u0905\u0928\u0932\u0949\u0915 \u0939\u094b\u0917\u093e \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0930\u0947\u092b\u0930\u0932 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0964"
  ],
