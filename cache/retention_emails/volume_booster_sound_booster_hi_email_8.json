{
  "subject": "\u092e\u0948\u0902\u0928\u0947 \u092d\u0940 \u092f\u0939\u0940 \u0917\u0932\u0924\u0940 \u0915\u0940 \u0925\u0940 - \u090f\u0915 \u0915\u0902\u092b\u0947\u0936\u0928",
  "preview_text": "\u092e\u0947\u0930\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0915\u0939\u093e\u0928\u0940 \u0938\u0941\u0928\u0928\u0947 \u0938\u0947 \u091a\u0942\u0915 \u0917\u092f\u093e \u0925\u093e, \u092b\u093f\u0930 \u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u090f\u0915 \u091a\u0940\u091c\u093c \u0915\u0940...",
  "body_paragraphs": [
    "\u0938\u091a \u0915\u0939\u0942\u0902? \u092e\u0948\u0902 \u092d\u0940 \u0915\u092d\u0940 \u0906\u092a\u0915\u0940 \u0924\u0930\u0939 \u0925\u093e\u0964 \u090f\u0915 \u0936\u093e\u092e, \u091f\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u0935\u093e\u092a\u0938\u0940 \u0915\u0947 \u0938\u092b\u0930 \u092e\u0947\u0902, \u092e\u0947\u0930\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u091a\u0932 \u0930\u0939\u093e \u0925\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u092a\u0939\u093f\u092f\u094b\u0902 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0914\u0930 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u092c\u093e\u0924\u091a\u0940\u0924 \u092e\u0947\u0902 \u0935\u094b \u0906\u0935\u093e\u091c\u093c \u0921\u0942\u092c \u0917\u0908\u0964 \u092e\u0948\u0902\u0928\u0947 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092e\u0948\u0915\u094d\u0938 \u0915\u0930 \u0926\u093f\u092f\u093e, \u092b\u093f\u0930 \u092d\u0940 \u090f\u0915 \u092d\u0940 \u0936\u092c\u094d\u0926 \u0938\u093e\u092b \u0928\u0939\u0940\u0902 \u0906\u092f\u093e\u0964 \u092e\u0948\u0902\u0928\u0947 \u0939\u093e\u0930 \u092e\u093e\u0928 \u0932\u0940 \u0914\u0930 \u092c\u0938 \u0916\u093f\u0921\u093c\u0915\u0940 \u0938\u0947 \u092c\u093e\u0939\u0930 \u0926\u0947\u0916\u0924\u093e \u0930\u0939\u093e\u0964",
    "\u0905\u0917\u0932\u0947 \u0926\u093f\u0928 \u092e\u0947\u0930\u0947 \u0926\u094b\u0938\u094d\u0924 \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0909\u0938\u0928\u0947 \u092d\u0940 \u0935\u0939\u0940 \u090f\u092a\u094d\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u0909\u0938\u0928\u0947 \u0915\u0939\u093e, '\u092d\u093e\u0908, \u092c\u0938 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u0915\u0947 \u092a\u0949\u092a \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u0964' \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e, \u092f\u0939 \u092d\u0940 \u0915\u094b\u0908 \u092c\u093e\u0924 \u0939\u0941\u0908? \u0932\u0947\u0915\u093f\u0928 \u091c\u092c \u092e\u0948\u0902\u0928\u0947 \u0915\u094b\u0936\u093f\u0936 \u0915\u0940... \u0935\u093e\u0939\u0964 \u0905\u091a\u093e\u0928\u0915 \u0939\u0930 \u0906\u0935\u093e\u091c\u093c \u0938\u093e\u092b, \u0939\u0930 \u0928\u094b\u091f \u0917\u0939\u0930\u093e\u0964 \u0910\u0938\u093e \u0932\u0917\u093e \u091c\u0948\u0938\u0947 \u0938\u094d\u092a\u0940\u0915\u0930 \u092e\u0947\u0930\u0947 \u0915\u093e\u0928 \u0915\u0947 \u0905\u0902\u0926\u0930 \u092c\u0948\u0920\u093e \u0939\u0948\u0964",
    "\u092f\u0939\u0940 \u0935\u094b \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u093f\u0938\u0947 90% \u0932\u094b\u0917 \u0907\u0917\u094d\u0928\u094b\u0930 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902 - \u092c\u093f\u0932\u094d\u091f-\u0907\u0928 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930\u0964 \u0939\u0930 \u091c\u0947\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u0964 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f? \u092a\u0949\u092a \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u092a\u0930 \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u094b, \u0906\u0935\u093e\u091c\u093c \u0915\u094d\u0930\u093f\u0938\u094d\u092a \u0939\u094b \u091c\u093e\u090f\u0917\u0940\u0964 \u092e\u094d\u092f\u0942\u091c\u093f\u0915? \u0930\u0949\u0915 \u092f\u093e \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u091a\u0941\u0928\u094b, \u092c\u0947\u0938 \u0905\u092a\u0928\u0947 \u0906\u092a \u0921\u0940\u092a \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u0938\u0947 \u0915\u0939\u0940\u0902 \u091c\u094d\u092f\u093e\u0926\u093e \u0939\u0948 - \u092f\u0939 \u0938\u093e\u0909\u0902\u0921 \u0915\u094b \u091c\u093f\u0902\u0926\u093e \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 Volume Booster \u0916\u094b\u0932\u094b, \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u0906\u0907\u0915\u0928 \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u094b, \u0914\u0930 \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091c\u0947\u0928\u0930 \u0915\u093e \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091a\u0941\u0928\u094b\u0964 \u0938\u093f\u0930\u094d\u092b 30 \u0938\u0947\u0915\u0902\u0921\u0964 \u092b\u0930\u094d\u0915 \u0916\u0941\u0926 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u094b\u0917\u0947\u0964 P.S. \u0915\u0932 \u090f\u0915 \u092f\u0942\u091c\u0930 \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0909\u0938\u0928\u0947 \u0915\u094d\u0932\u093e\u0938\u093f\u0915\u0932 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u092a\u0930 \u092a\u0941\u0930\u093e\u0928\u0947 \u0917\u093e\u0928\u0947 \u0938\u0941\u0928\u0947 - \u0909\u0938\u0928\u0947 \u0915\u0939\u093e \u0910\u0938\u093e \u0932\u0917\u093e \u091c\u0948\u0938\u0947 \u0911\u0930\u094d\u0915\u0947\u0938\u094d\u091f\u094d\u0930\u093e \u0909\u0938\u0915\u0947 \u0915\u092e\u0930\u0947 \u092e\u0947\u0902 \u092c\u091c \u0930\u0939\u093e \u0939\u0948\u0964"
  ],
