  "subject": "\u90a3\u4e2a\u51cc\u66683\u70b9\u6539\u8bba\u6587\u7684\u5b66\u59d0\u53d1\u73b0\u4e86\u4ec0\u4e48",
  "preview_text": "\u5979\u7528\u4e86\u8fd9\u4e2a\u529f\u80fd\u540e\uff0c\u8bba\u6587\u4eceB\u76f4\u63a5\u8df3\u5230A-\uff0c\u8fde\u5bfc\u5e08\u90fd\u95ee\u5979\u7528\u4e86\u4ec0\u4e48\u65b9\u6cd5",
  "body_paragraphs": [
    "\u4e0a\u5468\u51cc\u66683\u70b9\uff0c\u6211\u6536\u5230\u4e00\u6761\u6d88\u606f\u3002\u4e00\u4e2a\u5b66\u59d0\u8bf4\u5979\u5feb\u5d29\u6e83\u4e86\u2014\u2014\u8bba\u6587\u6539\u5230\u7b2c7\u7a3f\uff0c\u5bfc\u5e08\u8fd8\u662f\u4e0d\u6ee1\u610f\uff0c\u8bf4\u8bba\u70b9\u4e0d\u591f\u6e05\u6670\u3002\u5979\u8bd5\u4e86\u6240\u6709\u65b9\u6cd5\uff0c\u6700\u540e\u70b9\u5f00\u4e86\u6211\u4eec\u4e00\u4e2a\u51e0\u4e4e\u6ca1\u4eba\u7528\u7684\u529f\u80fd\u3002\u7ed3\u679c\uff0c\u5979\u4e0d\u4ec5\u901a\u8fc7\u4e86\uff0c\u8fd8\u62ff\u4e86A-\u3002",
    "\u90a3\u4e2a\u529f\u80fd\u5c31\u662f\u300c\u8bba\u70b9\u6df1\u5ea6\u6316\u6398\u300d\u3002\u5b83\u4e0d\u662f\u968f\u4fbf\u751f\u6210\u4e00\u53e5\u8bdd\uff0c\u800c\u662f\u6839\u636e\u4f60\u7684\u4e3b\u9898\uff0c\u81ea\u52a8\u62c6\u89e3\u51fa3\u4e2a\u9690\u85cf\u7684\u903b\u8f91\u6f0f\u6d1e\uff0c\u7136\u540e\u5e2e\u4f60\u91cd\u65b0\u6784\u5efa\u4e00\u4e2a\u65e0\u53ef\u8fa9\u9a73\u7684\u8bba\u70b9\u3002\u5b66\u59d0\u8bf4\uff0c\u5979\u7528\u4e86\u4e4b\u540e\uff0c\u5bfc\u5e08\u76f4\u63a5\u5728\u6279\u6ce8\u91cc\u5199\u4e86\u4e00\u53e5\uff1a\u2018\u8fd9\u624d\u662f\u4f60\u771f\u6b63\u7684\u6c34\u5e73\u3002\u2019",
    "\u6211\u77e5\u9053\u4f60\u8bba\u6587\u65f6\u95f4\u7d27\uff0c\u538b\u529b\u5927\u3002\u4f46\u5982\u679c\u4f60\u8fd8\u5728\u624b\u52a8\u6253\u78e8\u8bba\u70b9\uff0c\u6216\u8005\u5bf9\u7740\u5c4f\u5e55\u53d1\u5446\uff0c\u4f60\u771f\u7684\u5728\u6d6a\u8d39\u65f6\u95f4\u3002\u6253\u5f00App\uff0c\u70b9\u8fdb\u300c\u751f\u6210\u8bba\u6587\u300d\u9875\u9762\uff0c\u7136\u540e\u9009\u62e9\u4e0b\u65b9\u7684\u300c\u6df1\u5ea6\u6a21\u5f0f\u300d\u2014\u2014\u8fd9\u4e2a\u529f\u80fd\u4e00\u76f4\u5c31\u5728\u90a3\u91cc\uff0c\u53ea\u662f\u88ab\u5f88\u591a\u4eba\u5ffd\u7565\u4e86\u3002",
    "\u73b0\u5728\u5c31\u53bb\u8bd5\u8bd5\u3002\u6253\u5f00App\uff0c\u9009\u4e00\u7bc7\u4f60\u6b63\u5728\u5199\u7684\u8bba\u6587\uff0c\u70b9\u51fb\u300c\u751f\u6210\u8bba\u70b9\u300d\u65c1\u8fb9\u7684\u90a3\u4e2a\u5c0f\u9f7f\u8f6e\u56fe\u6807\uff0c\u542f\u7528\u6df1\u5ea6\u6a21\u5f0f\u3002P.S. \u8fd9\u4e2a\u6a21\u5f0f\u4f1a\u82b130\u79d2\uff0c\u4f46\u51fa\u6765\u7684\u5185\u5bb9\uff0c\u53ef\u80fd\u8ba9\u4f60\u7701\u63898\u5c0f\u65f6\u7684\u71ac\u591c\u6539\u7a3f\u3002\u522b\u7b49\u4e86\uff0c\u505a\u90a3\u4e2a\u53d1\u73b0\u79d8\u5bc6\u7684\u4eba\u3002"
