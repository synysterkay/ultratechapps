{
  "subject": "\u09aa\u09cd\u09b0\u09bf\u09a1\u09bf\u0995\u09cd\u099f\u09bf\u09ab\u09be\u0987\u09af\u09bc\u09c7 \u0986\u09b8\u099b\u09c7 \u09ac\u09a1\u09bc \u0986\u09aa\u09a1\u09c7\u099f \u2014 \u0986\u09aa\u09a8\u09bf \u099c\u09be\u09a8\u09ac\u09c7\u09a8 \u09aa\u09cd\u09b0\u09a5\u09ae",
  "preview_text": "\u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be \u0995\u09b0\u099b\u09c7 \u098f\u0995 \u0997\u09cb\u09aa\u09a8 \u09ab\u09bf\u099a\u09be\u09b0! \u09b6\u09c1\u09a7\u09c1 \u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09c7\u0987 \u09a6\u09c7\u0996\u09c1\u09a8\u0964",
  "body_paragraphs": [
    "\u0997\u09a4 \u09b0\u09be\u09a4\u09c7 \u0986\u09ae\u09bf \u098f\u0995\u099f\u09be \u09ac\u09bf\u09b7\u09af\u09bc \u09a8\u09bf\u09af\u09bc\u09c7 \u09ad\u09be\u09ac\u099b\u09bf\u09b2\u09be\u09ae\u2014\u0995\u09c7\u09a8 \u09b8\u09ac \u09aa\u09cd\u09b0\u09bf\u09a1\u09bf\u0995\u09b6\u09a8 \u099f\u09c1\u09b2\u09b8 \u09b6\u09c1\u09a7\u09c1 \u09aa\u09c1\u09b0\u09a8\u09cb \u09a1\u09be\u099f\u09be \u09a6\u09c7\u09af\u09bc? \u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09bf \u09ae\u09a8\u09c7 \u09b9\u09af\u09bc \u09a8\u09be, \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09bf\u09af\u09bc \u0995\u09cd\u09b2\u09be\u09ac\u09c7\u09b0 \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u0986\u0997\u09c7 \u098f\u0995\u099f\u09c1 \u098f\u099c \u09a5\u09be\u0995\u09be \u0989\u099a\u09bf\u09a4? \u09a0\u09bf\u0995 \u09a7\u09b0\u09c7\u099b\u09c7\u09a8, \u0986\u09ae\u09b0\u09be \u098f\u0995\u099f\u09be \u09a8\u09a4\u09c1\u09a8 \u099c\u09bf\u09a8\u09bf\u09b8 \u09a8\u09bf\u09af\u09bc\u09c7 \u098f\u09b8\u09c7\u099b\u09bf\u0964",
    "\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u099f\u09bf\u09ae \u09aa\u09cd\u09b0\u09bf\u09a1\u09bf\u0995\u09cd\u099f\u09bf\u09ab\u09be\u0987\u0995\u09c7 \u0986\u09b0\u0993 \u09b8\u09cd\u09ae\u09be\u09b0\u09cd\u099f \u0995\u09b0\u099b\u09c7\u0964 \u09b6\u09c0\u0998\u09cd\u09b0\u0987 \u0986\u09aa\u09a8\u09bf \u09aa\u09be\u09ac\u09c7\u09a8 '\u09b2\u09be\u0987\u09ad \u09ae\u09cd\u09af\u09be\u099a \u09aa\u09cd\u09b0\u09bf\u09a1\u09bf\u0995\u09b6\u09a8'\u2014\u09af\u09c7\u0996\u09be\u09a8\u09c7 \u09ae\u09cd\u09af\u09be\u099a \u099a\u09b2\u09be\u0995\u09be\u09b2\u09c0\u09a8 \u09b8\u09ae\u09af\u09bc\u09c7 AI \u09b0\u09bf\u09af\u09bc\u09c7\u09b2-\u099f\u09be\u0987\u09ae\u09c7 \u09ad\u09cd\u09af\u09be\u09b0\u09bf\u09af\u09bc\u09c7\u09ac\u09b2 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09ac\u09c7\u0964 \u09ae\u09be\u09a8\u09c7, \u09a6\u09cd\u09ac\u09bf\u09a4\u09c0\u09af\u09bc\u09be\u09b0\u09cd\u09a7\u09c7 \u09af\u0996\u09a8 \u0997\u09cb\u09b2 \u09b9\u09af\u09bc, \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09bf\u09a1\u09bf\u0995\u09b6\u09a8\u0993 \u09ac\u09a6\u09b2\u09c7 \u09af\u09be\u09ac\u09c7\u0964 \u098f\u099f\u09be \u09b6\u09c1\u09a7\u09c1 \u09a1\u09be\u099f\u09be \u09a8\u09af\u09bc\u2014\u098f\u099f\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u0997\u09c1\u099f \u09ab\u09bf\u09b2\u09bf\u0982\u0995\u09c7 \u09aa\u09be\u0993\u09af\u09bc\u09be\u09b0 \u09a6\u09bf\u099a\u09cd\u099b\u09c7\u0964",
    "\u0986\u09aa\u09a8\u09bf \u0987\u09a4\u09bf\u09ae\u09a7\u09cd\u09af\u09c7\u0987 \u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09af\u09bc\u09be\u09b0 \u09b2\u09c0\u0997 \u09a5\u09c7\u0995\u09c7 \u099a\u09cd\u09af\u09be\u09ae\u09cd\u09aa\u09bf\u09af\u09bc\u09a8\u09cd\u09b8 \u09b2\u09c0\u0997 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u0995\u09ad\u09be\u09b0 \u09aa\u09be\u099a\u09cd\u099b\u09c7\u09a8\u0964 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u098f\u0987 \u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u09aa\u09b0, \u0986\u09aa\u09a8\u09bf \u09a6\u09c7\u0996\u09a4\u09c7 \u09aa\u09be\u09ac\u09c7\u09a8 '\u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u09b8\u09cd\u0995\u09cb\u09b0'\u2014\u0995\u09a4 \u09b6\u09a4\u09be\u0982\u09b6 \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 AI \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09bf\u09a1\u09bf\u0995\u09b6\u09a8 \u09a8\u09bf\u09af\u09bc\u09c7\u0964 \u0986\u09b0 \u09b9\u09cd\u09af\u09be\u0981, '\u0986\u0987\u0995\u09bf\u0989 \u0995\u09c1\u0987\u099c' \u0986\u09b0\u0993 \u0995\u09a0\u09bf\u09a8 \u09b9\u09ac\u09c7, \u09b2\u09bf\u09a1\u09be\u09b0\u09ac\u09cb\u09b0\u09cd\u09a1\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09b0\u09cd\u09af\u09be\u0999\u09cd\u0995\u09bf\u0982 \u09ac\u09be\u09a1\u09bc\u09be\u09a8\u09cb\u09b0 \u09b8\u09c1\u09af\u09cb\u0997\u0964",
    "\u098f\u0996\u09a8\u0987 \u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09c1\u09a8 \u098f\u09ac\u0982 '\u09b8\u09c7\u099f\u09bf\u0982\u09b8'-\u098f \u0997\u09bf\u09af\u09bc\u09c7 '\u09a8\u09a4\u09c1\u09a8 \u09ab\u09bf\u099a\u09be\u09b0 \u09aa\u09cd\u09b0\u09bf\u09ad\u09bf\u0989' \u099a\u09be\u09b2\u09c1 \u0995\u09b0\u09c1\u09a8\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09ae\u09a4\u09be\u09ae\u09a4 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09a6\u09b0\u0995\u09be\u09b0\u2014\u0986\u09aa\u09a8\u09bf \u0995\u09c0 \u09ad\u09be\u09ac\u099b\u09c7\u09a8? P.S.: \u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09af\u09bc\u09be\u09ae \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0\u09be \u098f\u0987 \u09ab\u09bf\u099a\u09be\u09b0\u099f\u09bf \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7 \u09aa\u09be\u09ac\u09c7\u09a8\u0964 \u09ab\u09cd\u09b0\u09bf \u099f\u09cd\u09b0\u09be\u09af\u09bc\u09be\u09b2 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09a4\u09c7 \u0986\u099c\u0987 $\u09e7\u09e8.\u09ef\u09ef/\u09ae\u09be\u09b8\u09c7 \u09b8\u09be\u0987\u09a8 \u0986\u09aa \u0995\u09b0\u09c1\u09a8\u0964"
  ],
