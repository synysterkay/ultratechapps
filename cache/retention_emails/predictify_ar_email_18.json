{
  "subject": "\u0647\u0630\u0627 \u0627\u0644\u062e\u0637\u0623 \u064a\u0636\u064a\u0639 20 \u062f\u0642\u064a\u0642\u0629 \u0645\u0646 \u0648\u0642\u062a\u0643 \u0641\u064a \u0643\u0644 \u0645\u0628\u0627\u0631\u0627\u0629",
  "preview_text": "\u0627\u0643\u062a\u0634\u0641 \u0643\u064a\u0641 \u062a\u062d\u0635\u0644 \u0639\u0644\u0649 \u0646\u0641\u0633 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0641\u064a \u062f\u0642\u064a\u0642\u062a\u064a\u0646 \u0641\u0642\u0637 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0633\u0631\u0651 \u0644\u0645 \u0623\u0643\u0646 \u0633\u0623\u0634\u0627\u0631\u0643\u0647",
  "body_paragraphs": [
    "\u0643\u0646\u062a \u0623\u0642\u0636\u064a 20 \u062f\u0642\u064a\u0642\u0629 \u0642\u0628\u0644 \u0643\u0644 \u0645\u0628\u0627\u0631\u0627\u0629 \u0623\u0628\u062d\u062b \u0639\u0646 \u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a \u0627\u0644\u0644\u0627\u0639\u0628\u064a\u0646\u060c \u0648\u0623\u062a\u062a\u0628\u0639 \u0623\u062f\u0627\u0621 \u0627\u0644\u0641\u0631\u064a\u0642\u064a\u0646\u060c \u0648\u0623\u062d\u0627\u0648\u0644 \u062a\u062e\u0645\u064a\u0646 \u0627\u0644\u062a\u0634\u0643\u064a\u0644\u0629. \u0623\u0639\u062f\u0643 \u0623\u0646 90% \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u0641\u0639\u0644\u0648\u0646 \u0646\u0641\u0633 \u0627\u0644\u0634\u064a\u0621. \u062b\u0645 \u0627\u0643\u062a\u0634\u0641\u062a \u0634\u064a\u0626\u0627\u064b \u063a\u064a\u0651\u0631 \u0643\u0644 \u0634\u064a\u0621.",
    "\u0627\u0644\u062d\u0642\u064a\u0642\u0629 \u0627\u0644\u0635\u0627\u062f\u0645\u0629: \u0643\u0644 \u062a\u0644\u0643 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0648\u062c\u0648\u062f\u0629 \u0641\u064a \u0645\u0643\u0627\u0646 \u0648\u0627\u062d\u062f\u060c \u062c\u0627\u0647\u0632\u0629 \u0641\u064a \u062b\u0648\u0627\u0646\u064d. \u0644\u0645 \u062a\u0639\u062f \u0628\u062d\u0627\u062c\u0629 \u0644\u0641\u062a\u062d 5 \u0645\u0648\u0627\u0642\u0639 \u0648\u062a\u0636\u064a\u064a\u0639 \u0648\u0642\u062a\u0643. \u0627\u0644\u0622\u0646 \u064a\u0645\u0643\u0646\u0643 \u0645\u0639\u0631\u0641\u0629 \u0642\u0648\u0629 \u0647\u062c\u0648\u0645 \u0627\u0644\u0641\u0631\u064a\u0642\u060c \u0648\u0646\u0642\u0627\u0637 \u0636\u0639\u0641 \u062f\u0641\u0627\u0639\u0647\u060c \u0648\u062a\u0648\u0642\u0639\u0627\u062a \u0627\u0644\u0623\u062f\u0627\u0621 \u0627\u0644\u0641\u0631\u062f\u064a \u0644\u0644\u0627\u0639\u0628\u064a\u0646... \u0643\u0644 \u0630\u0644\u0643 \u0623\u0633\u0631\u0639 \u0645\u0646 \u062a\u062d\u0636\u064a\u0631 \u0641\u0646\u062c\u0627\u0646 \u0642\u0647\u0648\u0629.",
    "\u0647\u0630\u0627 \u0647\u0648 \u0628\u0627\u0644\u0636\u0628\u0637 \u0645\u0627 \u064a\u0641\u0639\u0644\u0647 '\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u0641\u0648\u0631\u064a' \u0641\u064a Predictify. \u064a\u0642\u062f\u0645 \u0644\u0643 \u062a\u0642\u0631\u064a\u0631\u0627\u064b \u0643\u0627\u0645\u0644\u0627\u064b \u0639\u0646 \u0643\u0644 \u0645\u0627 \u062a\u062d\u062a\u0627\u062c\u0647 \u0644\u0627\u062a\u062e\u0627\u0630 \u0642\u0631\u0627\u0631 \u0630\u0643\u064a\u060c \u0645\u0639\u062a\u0645\u062f\u0627\u064b \u0639\u0644\u0649 \u0622\u0644\u0627\u0641 \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a. \u0643\u0644 \u0645\u0627 \u0639\u0644\u064a\u0643 \u0647\u0648 \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0648\u0633\u062a\u0631\u0649 \u0627\u0644\u062b\u0642\u0629 \u0641\u064a \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a\u060c \u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a \u0627\u0644\u0644\u0627\u0639\u0628\u064a\u0646 \u0627\u0644\u062d\u0627\u0633\u0645\u0629\u060c \u0648\u062a\u062d\u0644\u064a\u0644\u0627\u064b \u062a\u0643\u062a\u064a\u0643\u064a\u0627\u064b \u0648\u0627\u0636\u062d\u0627\u064b.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0627\u062e\u062a\u0631 \u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u064a\u0648\u0645\u060c \u0648\u0634\u0627\u0647\u062f \u0643\u064a\u0641 \u062a\u062d\u0648\u0644 20 \u062f\u0642\u064a\u0642\u0629 \u0645\u0646 \u0627\u0644\u0628\u062d\u062b \u0625\u0644\u0649 \u062f\u0642\u064a\u0642\u062a\u064a\u0646 \u0645\u0646 \u0627\u0644\u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0645\u0624\u0643\u062f\u0629. \u062c\u0631\u0628\u0647 \u0645\u062c\u0627\u0646\u0627\u064b - \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0644\u0627 \u062a\u0643\u0630\u0628. P.S.: \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u064a\u0631\u0648\u0646 \u062a\u062d\u0633\u0646\u0627\u064b \u0628\u0646\u0633\u0628\u0629 70% \u0641\u064a \u062f\u0642\u0629 \u062a\u0648\u0642\u0639\u0627\u062a\u0647\u0645. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0635\u062f\u0641\u0629."
  ],
