{
  "subject": "\u0627\u0639\u062a\u0631\u0627\u0641: \u0643\u0646\u062a \u0623\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u0634\u0643\u0644 \u062e\u0627\u0637\u0626 \u0637\u0648\u0627\u0644 \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0645\u0627\u0636\u064a",
  "preview_text": "\u0628\u0639\u062f 28 \u064a\u0648\u0645\u064b\u0627\u060c \u0627\u0643\u062a\u0634\u0641\u062a \u0634\u064a\u0626\u064b\u0627 \u064a\u063a\u064a\u0631 \u0637\u0631\u064a\u0642\u0629 \u0627\u0633\u062a\u0645\u0627\u0639\u0643 \u0644\u0643\u0644 \u0634\u064a\u0621. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u0631\u0641\u0639 \u0635\u0648\u062a.",
  "body_paragraphs": [
    "\u0645\u0631 \u0634\u0647\u0631 \u0643\u0627\u0645\u0644 \u0645\u0646\u0630 \u0623\u0646 \u0642\u0645\u062a \u0628\u062a\u062b\u0628\u064a\u062a Volume Booster. \u0648\u0647\u0630\u0627 \u064a\u0639\u0646\u064a \u0634\u064a\u0626\u064b\u0627 \u0648\u0627\u062d\u062f\u064b\u0627: \u0644\u0642\u062f \u0623\u0635\u0628\u062d\u062a \u062c\u0632\u0621\u064b\u0627 \u0645\u0646 \u0645\u062c\u0645\u0648\u0639\u0629 \u0635\u063a\u064a\u0631\u0629 \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0630\u064a\u0646 \u0644\u0627 \u064a\u0642\u0628\u0644\u0648\u0646 \u0628\u0635\u0648\u062a \u0647\u0627\u062a\u0641 \u0636\u0639\u064a\u0641. \u0628\u064a\u0646\u0645\u0627 \u064a\u0633\u062a\u0633\u0644\u0645 \u0627\u0644\u0622\u062e\u0631\u0648\u0646\u060c \u0623\u0646\u062a \u062a\u0633\u062a\u0645\u0639.",
    "\u0641\u0643\u0631 \u0641\u064a \u0627\u0644\u0623\u0645\u0631: \u062e\u0644\u0627\u0644 \u0647\u0630\u0627 \u0627\u0644\u0634\u0647\u0631\u060c \u0627\u0633\u062a\u0645\u0639\u062a \u0625\u0644\u0649 \u0639\u0634\u0631\u0627\u062a \u0627\u0644\u0623\u063a\u0627\u0646\u064a\u060c \u0648\u062d\u0644\u0642\u0627\u062a \u0627\u0644\u0628\u0648\u062f\u0643\u0627\u0633\u062a\u060c \u0648\u0645\u0642\u0627\u0637\u0639 \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0628\u0635\u0648\u062a \u0643\u0627\u0646 \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062d\u064a\u0644 \u0633\u0645\u0627\u0639\u0647 \u0645\u0646 \u0642\u0628\u0644. \u0644\u0642\u062f \u0627\u0633\u062a\u0631\u062c\u0639\u062a \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u062a\u064a \u0641\u0642\u062f\u062a\u0647\u0627\u060c \u0648\u0633\u0645\u0639\u062a \u0643\u0644\u0645\u0627\u062a \u0643\u0627\u0646\u062a \u062a\u064f\u0647\u0645\u0633 \u0645\u0646 \u0642\u0628\u0644. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0635\u062f\u0641\u0629. \u0647\u0630\u0627 \u0625\u0646\u062c\u0627\u0632.",
    "\u0648\u0627\u0644\u0622\u0646\u060c \u0628\u0639\u062f \u0623\u0646 \u0627\u0639\u062a\u062f\u062a \u0639\u0644\u0649 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a\u060c \u062d\u0627\u0646 \u0648\u0642\u062a \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062a\u0627\u0644\u064a. \u0645\u064a\u0632\u0629 \u0645\u0639\u0632\u0632 \u0627\u0644\u062c\u0647\u064a\u0631 \u0627\u0644\u0645\u062e\u0641\u064a\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629. \u0647\u064a \u0627\u0644\u062a\u064a \u062a\u062d\u0648\u0644 \u0627\u0644\u0635\u0648\u062a \u0645\u0646 '\u0645\u0633\u0645\u0648\u0639' \u0625\u0644\u0649 '\u0645\u0644\u0645\u0648\u0633'. \u062a\u062c\u0639\u0644 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0644\u0627 \u062a\u064f\u0633\u0645\u0639 \u0641\u0642\u0637\u060c \u0628\u0644 \u062a\u064f\u0634\u0639\u0631 \u0628\u0647\u0627 \u0641\u064a \u0635\u062f\u0631\u0643.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 (\u062d\u062a\u0649 \u0644\u0648 \u0644\u0645 \u062a\u0641\u062a\u062d\u0647\u0627 \u0645\u0646 \u0642\u0628\u0644)\u060c \u0648\u0627\u0636\u0628\u0637 \u0645\u0639\u0632\u0632 \u0627\u0644\u062c\u0647\u064a\u0631 \u0639\u0644\u0649 +50%. \u0627\u0633\u062a\u0645\u0639 \u0644\u0623\u063a\u0646\u064a\u0629 \u062a\u0639\u0631\u0641\u0647\u0627 \u062c\u064a\u062f\u064b\u0627. \u0633\u064a\u0643\u0648\u0646 \u0627\u0644\u0623\u0645\u0631 \u0643\u0645\u0627 \u0644\u0648 \u0623\u0646\u0643 \u062a\u0633\u0645\u0639\u0647\u0627 \u0644\u0623\u0648\u0644 \u0645\u0631\u0629. P.S. \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0636\u0628\u0637\u0648\u0646 \u0647\u0630\u0627 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u064a\u0628\u0642\u0648\u0646 3 \u0623\u0636\u0639\u0627\u0641 \u0623\u0648\u0644\u0626\u0643 \u0627\u0644\u0630\u064a\u0646 \u0644\u0627 \u064a\u0641\u0639\u0644\u0648\u0646. \u0627\u0644\u0623\u0645\u0631 \u064a\u0633\u062a\u062d\u0642 \u0627\u0644\u0646\u0642\u0631\u0629.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 (\u062d\u062a\u0649 \u0644\u0648 \u0644\u0645 \u062a\u0641\u062a\u062d\u0647\u0627 \u0645\u0646 \u0642\u0628\u0644)\u060c \u0648\u0627\u0636\u0628\u0637 \u0645\u0639\u0632\u0632 \u0627\u0644\u062c\u0647\u064a\u0631 \u0639\u0644\u0649 +50%. \u0627\u0633\u062a\u0645\u0639 \u0644\u0623\u063a\u0646\u064a\u0629 \u062a\u0639\u0631\u0641\u0647\u0627 \u062c\u064a\u062f\u064b\u0627. \u0633\u064a\u0643\u0648\u0646 \u0627\u0644\u0623\u0645\u0631 \u0643\u0645\u0627 \u0644\u0648 \u0623\u0646\u0643 \u062a\u0633\u0645\u0639\u0647\u0627 \u0644\u0623\u0648\u0644 \u0645\u0631\u0629. P.S. \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0636\u0628\u0637\u0648\u0646 \u0647\u0630\u0627 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u064a\u0628\u0642\u0648\u0646 3 \u0623\u0636\u0639\u0627\u0641 \u0623\u0648\u0644\u0626\u0643 \u0627\u0644\u0630\u064a\u0646 \u0644\u0627 \u064a\u0641\u0639\u0644\u0648\u0646. \u0627\u0644\u0623\u0645\u0631 \u064a\u0633\u062a\u062d\u0642 \u0627\u0644\u0646\u0642\u0631\u0629."
  ],
