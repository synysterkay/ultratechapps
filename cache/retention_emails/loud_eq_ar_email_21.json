{
  "subject": "\u0627\u0644\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0630\u064a \u063a\u064a\u0631 \u0635\u0648\u062a \u0633\u064a\u0627\u0631\u062a\u0643",
  "preview_text": "\u0627\u0643\u062a\u0634\u0641 \u0645\u0627 \u062a\u063a\u064a\u0631 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0646\u0630 \u0622\u062e\u0631 \u0645\u0631\u0629 \u062f\u062e\u0644\u062a \u0641\u064a\u0647. \u0645\u064a\u0632\u0629 \u062c\u062f\u064a\u062f\u0629 \u062a\u062c\u0639\u0644 \u0635\u0648\u062a\u0643 \u0623\u0648\u0636\u062d \u0645\u0646 \u0623\u064a \u0648\u0642\u062a \u0645\u0636\u0649.",
  "body_paragraphs": [
    "\u0623\u062a\u0630\u0643\u0631 \u0627\u0644\u0645\u0631\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629 \u0627\u0644\u062a\u064a \u0643\u0646\u062a \u0641\u064a \u0627\u0632\u062f\u062d\u0627\u0645 \u0645\u0631\u0648\u0631\u064a \u0648\u0631\u0641\u0639\u062a \u0627\u0644\u0635\u0648\u062a \u0644\u0623\u0642\u0635\u0649 \u062d\u062f\u061f \u0643\u0646\u062a \u062a\u0633\u0645\u0639 \u0647\u0645\u0647\u0645\u0627\u062a \u0648\u0636\u062c\u064a\u062c\u060c \u0644\u0643\u0646 \u0627\u0644\u062d\u0648\u0627\u0631 \u0636\u0627\u0639 \u0628\u064a\u0646 \u0636\u0648\u0636\u0627\u0621 \u0627\u0644\u0637\u0631\u064a\u0642. \u0647\u0630\u0627 \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u060c \u0623\u0636\u0641\u0646\u0627 \u0634\u064a\u0626\u0627\u064b \u064a\u063a\u064a\u0631 \u0630\u0644\u0643 \u0643\u0644\u0647.",
    "\u062e\u0644\u0627\u0644 \u0627\u0644\u0640 48 \u064a\u0648\u0645\u0627\u064b \u0627\u0644\u0645\u0627\u0636\u064a\u0629\u060c \u0627\u0633\u062a\u0645\u0639 \u0622\u0644\u0627\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0625\u0644\u0649 \u0628\u0648\u062f\u0643\u0627\u0633\u062a\u0647\u0645 \u0648\u0645\u0633\u0644\u0633\u0644\u0627\u062a\u0647\u0645 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0628\u0641\u0636\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u0644\u0643\u0646\u0646\u0627 \u0644\u0627\u062d\u0638\u0646\u0627 \u0623\u0646 \u0628\u0639\u0636\u0643\u0645 \u0644\u0645 \u064a\u062c\u0631\u0628 \u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0627\u0644\u062a\u064a \u062a\u062c\u0639\u0644 \u0627\u0644\u0635\u0648\u062a \u0645\u0636\u0628\u0648\u0637\u0627\u064b \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0639\u0644\u0649 \u0633\u0645\u0627\u0639\u0627\u062a\u0643.",
    "\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u064a\u0648\u0645 \u064a\u0636\u064a\u0641 \u0645\u0644\u0641\u0627\u064b \u062c\u062f\u064a\u062f\u0627\u064b \u0644\u0644\u0628\u0648\u062f\u0643\u0627\u0633\u062a \u0641\u064a \u0627\u0644\u0645\u0639\u0627\u062f\u0644 \u0627\u0644\u0635\u0648\u062a\u064a. \u0641\u0642\u0637 \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u062e\u062a\u0631 '\u0628\u0648\u062f\u0643\u0627\u0633\u062a'\u060c \u0648\u0633\u062a\u0644\u0627\u062d\u0638 \u0627\u0644\u0641\u0631\u0642 \u0641\u0648\u0631\u0627\u064b. \u0648\u0636\u0648\u062d \u0627\u0644\u062d\u0648\u0627\u0631 \u0623\u0635\u0628\u062d \u0623\u0642\u0648\u0649 \u0628\u0645\u0631\u062a\u064a\u0646 \u062f\u0648\u0646 \u062a\u0634\u0648\u064a\u0647\u060c \u062d\u062a\u0649 \u0641\u064a \u0623\u0632\u062d\u0645 \u0627\u0644\u0637\u0631\u0642.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u062c\u062f\u064a\u062f. \u0633\u0645\u0639\u0643 \u064a\u0633\u062a\u062d\u0642 \u0627\u0644\u0623\u0641\u0636\u0644. \u0645\u0644\u0627\u062d\u0638\u0629: \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u062c\u0632\u0621 \u0645\u0646 \u0627\u0644\u062e\u0637\u0629 \u0627\u0644\u0645\u0645\u064a\u0632\u0629\u060c \u0644\u0643\u0646 \u064a\u0645\u0643\u0646\u0643 \u062a\u062c\u0631\u0628\u062a\u0647\u0627 \u0645\u062c\u0627\u0646\u0627\u064b \u0644\u0645\u062f\u0629 7 \u0623\u064a\u0627\u0645."
  ],
