{
  "subject": "30 \u0926\u093f\u0928, 100k \u0932\u094b\u0917, \u090f\u0915 \u0906\u0935\u093e\u091c\u093c",
  "preview_text": "\u0924\u0941\u092e \u0905\u0915\u0947\u0932\u0947 \u0928\u0939\u0940\u0902 \u0939\u094b \u2013 \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u0932\u094b\u0917 \u0930\u094b\u091c\u093c \u0907\u0938\u0940 \u0924\u0930\u0939 \u0938\u0941\u0928 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0926\u0947\u0916\u094b \u0915\u0948\u0938\u0947\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 30 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902, 100,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 Loud EQ \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u0914\u0930 \u0939\u0930 \u0915\u094b\u0908 \u090f\u0915 \u0939\u0940 \u092c\u093e\u0924 \u0915\u0939\u0924\u093e \u0939\u0948 \u2013 '\u0906\u0916\u093c\u093f\u0930\u0915\u093e\u0930 \u092e\u0948\u0902 \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091a\u0940\u091c\u093c\u0947\u0902 \u0938\u093e\u092b\u093c \u0938\u0941\u0928 \u092a\u093e \u0930\u0939\u093e \u0939\u0942\u0901\u0964' \u0924\u0941\u092e \u092d\u0940 \u0905\u092c \u0907\u0938 \u091f\u0940\u092e \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u094b\u0964",
    "\u092f\u0939 \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u090f\u0915 \u0910\u0938\u093e \u0938\u092e\u0941\u0926\u093e\u092f \u0939\u0948 \u091c\u094b \u0936\u094b\u0930 \u0915\u094b \u092e\u093e\u0924 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u091a\u093e\u0939\u0947 \u092e\u0947\u091f\u094d\u0930\u094b \u0939\u094b, \u0917\u093e\u0921\u093c\u0940 \u0939\u094b, \u092f\u093e \u0918\u0930 \u0915\u093e \u0915\u094b\u0928\u093e \u2013 \u0939\u092e \u0938\u092c \u0928\u0947 \u0924\u092f \u0915\u093f\u092f\u093e \u0939\u0948 \u0915\u093f \u0905\u092a\u0928\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0926\u092c\u0928\u0947 \u0928\u0939\u0940\u0902 \u0926\u0947\u0902\u0917\u0947\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0915\u093e\u0928 \u0905\u092c \u0938\u093f\u0930\u094d\u092b\u093c \u0938\u0941\u0928\u0924\u0947 \u0928\u0939\u0940\u0902, \u0938\u092e\u091d\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u092f\u0939\u0940 \u0935\u091c\u0939 \u0939\u0948 \u0915\u093f \u0939\u092e\u0928\u0947 '\u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c' \u092b\u0940\u091a\u0930 \u092c\u0928\u093e\u092f\u093e \u2013 \u090f\u0915 \u091f\u0948\u092a \u092e\u0947\u0902 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0938\u092c \u0915\u0941\u091b \u0938\u0947\u091f \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u0938\u094d\u091f\u094d\u0930\u0947\u0928 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u0935\u0939\u0940 \u0938\u093e\u092b\u093c \u0906\u0935\u093e\u091c\u093c \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u091a\u093e\u0939\u093f\u090f\u0964 \u0914\u0930 \u0939\u093e\u0901, \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f +200% \u092c\u0942\u0938\u094d\u091f \u092d\u0940 \u0939\u0948 \u2013 \u092a\u0930 \u092a\u0939\u0932\u0947 \u092f\u0939 \u092b\u0940\u091a\u0930 \u0906\u091c\u093c\u092e\u093e\u0913\u0964",
    "\u0905\u092c \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u0938\u092e\u0941\u0926\u093e\u092f' \u091f\u0948\u092c \u092e\u0947\u0902 \u0926\u0947\u0916\u094b \u0915\u093f \u0926\u0942\u0938\u0930\u0947 \u0915\u094d\u092f\u093e \u0938\u0941\u0928 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0936\u093e\u092f\u0926 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0905\u092a\u0928\u0940 \u0905\u0917\u0932\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0915\u093f\u0924\u093e\u092c \u092f\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u092e\u093f\u0932 \u091c\u093e\u090f\u0964 \u092a\u0940.\u090f\u0938. \u2013 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0905\u092d\u0940 \u092d\u0940 \u0916\u0941\u0932\u093e \u0939\u0948, \u0907\u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u094b \u0915\u093f \u0905\u0938\u0932\u0940 \u0938\u093e\u092b\u093c \u0906\u0935\u093e\u091c\u093c \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964"
  ],
