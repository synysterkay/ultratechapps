{
  "subject": "68 \u0926\u093f\u0928\u094b\u0902 \u0915\u093e \u0938\u092b\u0930 \u0914\u0930 \u090f\u0915 \u0916\u093e\u0938 \u0924\u094b\u0939\u092b\u093e",
  "preview_text": "\u0906\u092a\u0928\u0947 Bass Booster \u0915\u0947 \u0938\u093e\u0925 68 \u0926\u093f\u0928 \u092c\u093f\u0924\u093e\u090f\u0964 \u0905\u092c \u0906\u092a\u0915\u094b \u0935\u094b \u091a\u0940\u091c\u093c \u092e\u093f\u0932\u0947\u0917\u0940 \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u0915\u0947 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u091c\u092c \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0906\u092a\u0928\u0947 \u0905\u092a\u0928\u0947 \u092b\u093c\u094b\u0928 \u092a\u0930 \u0935\u094b \u0917\u093e\u0928\u093e \u091a\u0932\u093e\u092f\u093e \u0914\u0930 \u092c\u093e\u0938 \u0928\u0947 \u0906\u092a\u0915\u0940 \u091b\u093e\u0924\u0940 \u0915\u094b \u0939\u093f\u0932\u093e \u0926\u093f\u092f\u093e? \u0935\u094b \u092a\u0932 \u092e\u0947\u0930\u0947 \u0932\u093f\u090f \u092d\u0940 \u0916\u093e\u0938 \u0925\u093e\u0964 \u0906\u092a 68 \u0926\u093f\u0928\u094b\u0902 \u0938\u0947 Bass Booster \u0915\u0947 \u0938\u093e\u0925 \u0939\u0948\u0902 \u2013 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u0930\u093f\u0936\u094d\u0924\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u0947 \u091c\u0948\u0938\u0947 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f, \u091c\u094b \u0939\u0930 \u092c\u0940\u091f \u0915\u094b \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902, \u092e\u0948\u0902 \u0906\u092a\u0915\u094b \u0927\u0928\u094d\u092f\u0935\u093e\u0926 \u0915\u0939\u0924\u093e \u0939\u0942\u0901\u0964",
    "\u0939\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0928\u0947 \u0905\u092a\u0928\u0947 \u0938\u094d\u092a\u0940\u0915\u0930 \u0914\u0930 \u0908\u092f\u0930\u092c\u0921\u094d\u0938 \u0915\u094b \u091c\u093c\u093f\u0902\u0926\u093e \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u092a\u0930 \u0905\u092c \u090f\u0915 \u092c\u093e\u0924 \u0914\u0930 \u0939\u0948 \u2013 \u090f\u0915 \u0910\u0938\u093e \u092b\u0940\u091a\u0930 \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0916\u0941\u0932\u0924\u093e \u0939\u0948 \u091c\u094b \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u0932\u0902\u092c\u093e \u0938\u092e\u092f \u092c\u093f\u0924\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u090f\u0915 '\u0907\u0928\u0938\u093e\u0907\u0921\u0930 \u090f\u0915\u094d\u0938\u0947\u0938' \u0939\u0948, \u091c\u094b \u092c\u093e\u0915\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u094b \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0924\u093e\u0964",
    "Bass Booster \u092e\u0947\u0902 \u090f\u0915 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u091f\u0942\u0932 \u0939\u0948 \u2013 '\u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092c\u093e\u0938 \u0935\u0930\u094d\u091a\u0941\u0905\u0932\u093e\u0907\u091c\u093c\u0930' \u2013 \u091c\u094b \u0906\u092a\u0915\u0947 \u0939\u0930 \u0917\u093e\u0928\u0947 \u0915\u094b 3D \u0938\u0930\u093e\u0909\u0902\u0921 \u092e\u0947\u0902 \u092c\u0926\u0932 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u092c\u093e\u0938 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u0905\u0928\u0941\u092d\u0935 \u0939\u0948\u0964 \u0906\u092a \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0905\u092d\u0940 \u2013 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0938\u0947\u0964 \u0914\u0930 \u0939\u093e\u0901, \u092f\u0939 Spotify, YouTube, TikTok \u2013 \u0939\u0930 \u091c\u0917\u0939 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0906\u092a\u0915\u094b \u092c\u0938 \u090f\u0915 \u0915\u093e\u092e \u0915\u0930\u0928\u093e \u0939\u0948: \u0905\u092a\u0928\u093e Bass Booster \u0916\u094b\u0932\u0947\u0902, '\u092c\u0942\u0938\u094d\u091f \u0938\u094d\u0932\u093e\u0907\u0921\u0930' \u0915\u094b \u0926\u093e\u0908\u0902 \u0913\u0930 \u0916\u0940\u0902\u091a\u0947\u0902, \u0914\u0930 \u0909\u0938 \u0921\u094d\u0930\u0949\u092a \u0915\u094b \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0947\u0902 \u091c\u094b \u0906\u092a\u0915\u0947 \u092b\u093c\u094b\u0928 \u0915\u094b \u0939\u093f\u0932\u093e \u0926\u0947\u0917\u093e\u0964 P.S. \u092f\u0939 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092b\u0940\u091a\u0930 \u0938\u093f\u0930\u094d\u092b 7 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092b\u094d\u0930\u0940 \u0939\u0948 \u2013 \u0906\u092a\u0915\u0947 68 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925\u0940 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0928\u093e\u0924\u0947\u0964 \u0907\u0938\u0947 \u092e\u093f\u0938 \u092e\u0924 \u0915\u0930\u093f\u090f\u0964"
