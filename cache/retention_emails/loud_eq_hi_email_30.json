{
  "subject": "70 \u0926\u093f\u0928 \u092c\u093e\u0926: \u0924\u0941\u092e \u0905\u092c \u0938\u093f\u0930\u094d\u092b \u092f\u0942\u091c\u093c\u0930 \u0928\u0939\u0940\u0902 \u0939\u094b",
  "preview_text": "\u0924\u0941\u092e\u0928\u0947 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0938\u093e\u092b \u0938\u0941\u0928\u093e, \u0932\u0947\u0915\u093f\u0928 \u0905\u092c \u0924\u0941\u092e \u0907\u0938 \u092e\u093f\u0936\u0928 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u094b\u0964 \u0926\u0947\u0916\u094b \u0915\u0948\u0938\u0947\u0964",
  "body_paragraphs": [
    "70 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0924\u0941\u092e\u0928\u0947 Loud EQ \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u0924\u092c \u0924\u0941\u092e \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u0922\u0942\u0902\u0922 \u0930\u0939\u0947 \u0925\u0947 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u092e\u091c\u093c\u094b\u0930 \u0938\u094d\u092a\u0940\u0915\u0930 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u092c\u0922\u093c\u093e \u0938\u0915\u0947\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u092c, \u0924\u0941\u092e \u0915\u0941\u091b \u0914\u0930 \u0939\u094b\u0964 \u0924\u0941\u092e \u0909\u0928 \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u0932\u094b\u0917\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u0939\u094b \u091c\u093f\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0905\u092a\u0928\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924 \u092c\u0926\u0932 \u0926\u0940 \u0939\u0948\u0964",
    "\u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0924\u0941\u092e\u0928\u0947 \u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c \u092c\u091f\u0928 \u0926\u092c\u093e\u092f\u093e, \u0924\u0941\u092e\u0928\u0947 \u0938\u093f\u0930\u094d\u092b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0928\u0939\u0940\u0902 \u092c\u0922\u093c\u093e\u092f\u093e\u2014\u0924\u0941\u092e\u0928\u0947 \u0938\u093e\u092b\u093c-\u0938\u092b\u093c\u093e\u0908 \u0915\u094b \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e \u0926\u0940\u0964 \u0924\u0941\u092e\u0928\u0947 \u0936\u094b\u0930 \u0915\u094b \u0939\u0930\u093e\u092f\u093e, \u092c\u093f\u0928\u093e \u0905\u092a\u0928\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u094b \u0928\u0941\u0915\u0938\u093e\u0928 \u092a\u0939\u0941\u0901\u091a\u093e\u090f\u0964 \u092f\u0939\u0940 \u0939\u092e\u093e\u0930\u093e \u092e\u093f\u0936\u0928 \u0939\u0948: \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0938\u093e\u092b\u093c, \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0914\u0930 \u0939\u0930 \u0915\u0939\u0940\u0902 \u0932\u0947 \u091c\u093e\u0928\u093e\u0964",
    "\u0905\u092c \u0939\u092e \u090f\u0915 \u0928\u0908 \u0938\u0941\u0935\u093f\u0927\u093e \u092a\u0930 \u0915\u093e\u092e \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u2014'\u0938\u093e\u0909\u0902\u0921 \u0921\u0940\u090f\u0928\u090f'\u2014\u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092b\u093c\u094b\u0928 \u0915\u0940 \u0938\u094d\u092a\u0940\u0915\u0930, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0908\u092f\u0930\u092b\u093c\u094b\u0928 \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u094b \u090f\u0915 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u092f\u0939 \u092a\u0939\u0932\u0947 \u092e\u093f\u0932\u0947\u0917\u093e\u0964 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0924\u0941\u092e \u0938\u093f\u0930\u094d\u092b \u092f\u0942\u091c\u093c\u0930 \u0928\u0939\u0940\u0902 \u0939\u094b\u2014\u0924\u0941\u092e \u0907\u0938 \u092e\u093f\u0936\u0928 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u094b\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932\u094d\u0938' \u092e\u0947\u0902 \u091c\u093e\u0913\u0964 \u0935\u0939\u093e\u0901 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 '\u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f' \u092e\u094b\u0921 \u0926\u093f\u0916\u0947\u0917\u093e\u2014\u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e\u0913, \u0916\u093e\u0938\u0915\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928\u0964 P.S. \u092f\u093e\u0926 \u0930\u0916\u0928\u093e, \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0924\u0941\u092e \u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c \u0915\u0930\u0924\u0947 \u0939\u094b, \u0924\u0941\u092e \u0905\u092a\u0928\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u094b \u090f\u0915 \u0924\u094b\u0939\u092b\u093c\u093e \u0926\u0947\u0924\u0947 \u0939\u094b\u2014\u0938\u093e\u092b\u093c \u0906\u0935\u093e\u091c\u093c, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0924\u0928\u093e\u0935 \u0915\u0947\u0964"
  ],
