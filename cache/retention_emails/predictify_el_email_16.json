{
  "subject": "\u03a4\u03bf \u03b4\u03ce\u03c1\u03bf \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03c3\u03c7\u03b5\u03b4\u03af\u03b1\u03b6\u03b1 \u03bd\u03b1 \u03c3\u03c4\u03b5\u03af\u03bb\u03c9",
  "preview_text": "\u03a4\u03bf \u03ad\u03c6\u03c4\u03b9\u03b1\u03be\u03b1 \u03c3\u03c4\u03b9\u03c2 3 \u03c4\u03bf \u03c0\u03c1\u03c9\u03af \u03b3\u03b9\u03b1 \u03c3\u03ad\u03bd\u03b1. \u0394\u03b5\u03bd \u03c4\u03bf \u03c0\u03b5\u03c1\u03af\u03bc\u03b5\u03bd\u03b5\u03c2, \u03b1\u03bb\u03bb\u03ac \u03c4\u03bf \u03b1\u03be\u03af\u03b6\u03b5\u03b9\u03c2.",
  "body_paragraphs": [
    "\u03a0\u03c1\u03bf\u03c7\u03b8\u03ad\u03c2, \u03b3\u03cd\u03c1\u03c9 \u03c3\u03c4\u03b9\u03c2 3 \u03c4\u03b1 \u03be\u03b7\u03bc\u03b5\u03c1\u03ce\u03bc\u03b1\u03c4\u03b1, \u03ba\u03ac\u03c4\u03b9 \u03bc\u03bf\u03c5 \u03ad\u03ba\u03b1\u03bd\u03b5 \u03ba\u03bb\u03b9\u03ba. \u039e\u03ad\u03c1\u03b5\u03b9\u03c2 \u03b1\u03c5\u03c4\u03ae \u03c4\u03b7 \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae \u03c0\u03bf\u03c5 \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9\u03c2 \u03ad\u03bd\u03b1 \u03bc\u03b1\u03c4\u03c2 \u03ba\u03b1\u03b9 \u03bd\u03b9\u03ce\u03b8\u03b5\u03b9\u03c2 \u03cc\u03c4\u03b9 \u03ba\u03ac\u03c4\u03b9 \u03c3\u03bf\u03c5 \u03be\u03b5\u03c6\u03b5\u03cd\u03b3\u03b5\u03b9 \u2013 \u03b7 \u03c3\u03c4\u03b1\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03b5\u03af\u03c7\u03b5\u03c2, \u03c4\u03bf \u03bc\u03bf\u03c4\u03af\u03b2\u03bf \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03c0\u03c1\u03cc\u03c3\u03b5\u03be\u03b5\u03c2. \u039b\u03bf\u03b9\u03c0\u03cc\u03bd, \u03ba\u03ac\u03b8\u03b9\u03c3\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03bf \u03ad\u03c6\u03c4\u03b9\u03b1\u03be\u03b1. \u0388\u03bd\u03b1 \u03b5\u03c1\u03b3\u03b1\u03bb\u03b5\u03af\u03bf \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03ae\u03c4\u03b1\u03bd \u03c3\u03c4\u03bf \u03c0\u03bb\u03ac\u03bd\u03bf, \u03bf\u03cd\u03c4\u03b5 \u03c3\u03c4\u03bf roadmap. \u0391\u03c0\u03bb\u03ac, \u03ae\u03b8\u03b5\u03bb\u03b1 \u03bd\u03b1 \u03c4\u03bf \u03bc\u03bf\u03b9\u03c1\u03b1\u03c3\u03c4\u03ce \u03bc\u03b1\u03b6\u03af \u03c3\u03bf\u03c5 \u03c0\u03c1\u03b9\u03bd \u03c4\u03bf \u03b4\u03b5\u03b9 \u03ba\u03b1\u03bd\u03b5\u03af\u03c2 \u03ac\u03bb\u03bb\u03bf\u03c2.",
    "\u0395\u03af\u03bd\u03b1\u03b9 \u03ad\u03bd\u03b1\u03c2 \u03ba\u03c1\u03c5\u03c6\u03cc\u03c2 \u03c0\u03af\u03bd\u03b1\u03ba\u03b1\u03c2 \u03bc\u03b5 real-time \u03c3\u03c5\u03b3\u03ba\u03c1\u03af\u03c3\u03b5\u03b9\u03c2 \u03bf\u03bc\u03ac\u03b4\u03c9\u03bd \u2013 \u03cc\u03c7\u03b9 \u03c4\u03b1 \u03c3\u03c5\u03bd\u03b7\u03b8\u03b9\u03c3\u03bc\u03ad\u03bd\u03b1 \u03c3\u03c4\u03b1\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03ac, \u03b1\u03bb\u03bb\u03ac \u03bf\u03b9 \u03bc\u03b5\u03c4\u03b1\u03b2\u03bb\u03b7\u03c4\u03ad\u03c2 \u03c0\u03bf\u03c5 \u03bc\u03b5\u03c4\u03c1\u03ac\u03b5\u03b9 \u03c4\u03bf AI \u03bc\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bd\u03ae\u03b8\u03c9\u03c2 \u03ba\u03c1\u03cd\u03b2\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c0\u03af\u03c3\u03c9 \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ad\u03c8\u03b5\u03b9\u03c2. \u0393\u03b9\u03b1 \u03c0\u03b1\u03c1\u03ac\u03b4\u03b5\u03b9\u03b3\u03bc\u03b1, \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9\u03c2 \u03c4\u03b7\u03bd \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03b5\u03c0\u03af\u03b8\u03b5\u03c3\u03b7\u03c2 \u03c4\u03b7\u03c2 \u039c\u03c0\u03ac\u03c1\u03c4\u03c3\u03b1 \u03c3\u03c4\u03bf 80\u03bf \u03bb\u03b5\u03c0\u03c4\u03cc \u03cc\u03c4\u03b1\u03bd \u03c0\u03b1\u03af\u03b6\u03b5\u03b9 \u03b5\u03ba\u03c4\u03cc\u03c2 \u03ad\u03b4\u03c1\u03b1\u03c2, \u03ae \u03c4\u03bf \u03c0\u03ce\u03c2 \u03b1\u03bb\u03bb\u03ac\u03b6\u03b5\u03b9 \u03b7 \u03b1\u03bc\u03c5\u03bd\u03c4\u03b9\u03ba\u03ae \u03b3\u03c1\u03b1\u03bc\u03bc\u03ae \u03c4\u03b7\u03c2 \u0393\u03b9\u03bf\u03c5\u03bd\u03ac\u03b9\u03c4\u03b5\u03bd\u03c4 \u03cc\u03c4\u03b1\u03bd \u03c7\u03ac\u03bd\u03b5\u03b9. \u0394\u03b5\u03bd \u03c4\u03bf \u03b5\u03af\u03c7\u03b1 \u03c3\u03ba\u03bf\u03c0\u03cc \u03bd\u03b1 \u03c4\u03bf \u03b2\u03b3\u03ac\u03bb\u03c9, \u03b1\u03bb\u03bb\u03ac \u03cc\u03c4\u03b1\u03bd \u03c4\u03bf \u03b5\u03af\u03b4\u03b1, \u03ba\u03b1\u03c4\u03ac\u03bb\u03b1\u03b2\u03b1 \u03cc\u03c4\u03b9 \u03b5\u03c3\u03cd, \u03c0\u03bf\u03c5 \u03ba\u03c5\u03bd\u03b7\u03b3\u03ac\u03c2 \u03ba\u03ac\u03b8\u03b5 \u03c0\u03bb\u03b5\u03bf\u03bd\u03ad\u03ba\u03c4\u03b7\u03bc\u03b1, \u03b8\u03b1 \u03c4\u03bf \u03b5\u03ba\u03c4\u03b9\u03bc\u03ae\u03c3\u03b5\u03b9\u03c2.",
    "\u039c\u03c0\u03b5\u03c2 \u03c3\u03c4\u03bf Predictify \u03ba\u03b1\u03b9 \u03c8\u03ac\u03be\u03b5 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03ba\u03b1\u03c1\u03c4\u03ad\u03bb\u03b1 \u00ab\u039c\u03c5\u03c3\u03c4\u03b9\u03ba\u03cc\u03c2 \u03a0\u03af\u03bd\u03b1\u03ba\u03b1\u03c2\u00bb \u2013 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b5\u03ba\u03b5\u03af, \u03b4\u03af\u03c0\u03bb\u03b1 \u03c3\u03c4\u03b9\u03c2 \u039a\u03bf\u03b9\u03bd\u03cc\u03c4\u03b7\u03c4\u03b5\u03c2. \u0394\u03b5\u03bd \u03b8\u03b1 \u03c4\u03bf \u03b2\u03c1\u03b5\u03b9\u03c2 \u03b1\u03bb\u03bb\u03b9\u03ce\u03c2. \u0395\u03af\u03bd\u03b1\u03b9 \u03c4\u03bf \u03b4\u03ce\u03c1\u03bf \u03bc\u03bf\u03c5 \u03b3\u03b9\u03b1 \u03c3\u03ad\u03bd\u03b1, \u03b3\u03b9\u03b1\u03c4\u03af \u03be\u03ad\u03c1\u03c9 \u03cc\u03c4\u03b9 \u03b4\u03b5\u03bd \u03b1\u03c1\u03ba\u03b5\u03af\u03c3\u03b1\u03b9 \u03c3\u03b5 \u03c4\u03c5\u03c6\u03bb\u03ad\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ad\u03c8\u03b5\u03b9\u03c2. \u0398\u03ad\u03bb\u03b5\u03b9\u03c2 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03c0\u03bf\u03c5 \u03c7\u03c4\u03c5\u03c0\u03ac\u03bd\u03b5 \u03c6\u03bb\u03ad\u03b2\u03b1. \u0391\u03c5\u03c4\u03cc \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03bf \u03c0\u03c1\u03ce\u03c4\u03bf \u03b2\u03ae\u03bc\u03b1 \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b3\u03af\u03bd\u03b5\u03b9\u03c2 \u03bf \u03c0\u03b9\u03bf \u03ad\u03be\u03c5\u03c0\u03bd\u03bf\u03c2 \u03c6\u03af\u03bb\u03bf\u03c2 \u03c3\u03c4\u03b7\u03bd \u03c0\u03b1\u03c1\u03ad\u03b1 \u03c3\u03bf\u03c5 \u03c4\u03b7\u03bd \u03ce\u03c1\u03b1 \u03c4\u03bf\u03c5 \u03b1\u03b3\u03ce\u03bd\u03b1.",
    "\u0391\u03bd\u03bf\u03b9\u03be\u03ad \u03c4\u03bf \u03c4\u03ce\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03b4\u03b5\u03c2 \u03c4\u03b9 \u03c3\u03bf\u03c5 \u03b5\u03c4\u03bf\u03af\u03bc\u03b1\u03c3\u03b1. \u0394\u03b5\u03bd \u03b8\u03b1 \u03bc\u03b5\u03af\u03bd\u03b5\u03b9 \u03b3\u03b9\u03b1 \u03c0\u03ac\u03bd\u03c4\u03b1 \u03b5\u03ba\u03b5\u03af \u2013 \u03c3\u03b5 \u03bb\u03af\u03b3\u03b5\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03c4\u03bf \u03b1\u03c0\u03bf\u03c3\u03cd\u03c1\u03c9 \u03b3\u03b9\u03b1\u03c4\u03af \u03b4\u03b5\u03bd \u03ae\u03c4\u03b1\u03bd \u03b3\u03b9\u03b1 \u03cc\u03bb\u03bf\u03c5\u03c2. \u03a5\u0393: \u0391\u03bd \u03c3\u03bf\u03c5 \u03b1\u03c1\u03ad\u03c3\u03b5\u03b9, \u03c3\u03ba\u03ad\u03c8\u03bf\u03c5 \u03c4\u03bf Premium \u2013 \u03bc\u03b5 12.99\u20ac/\u03bc\u03ae\u03bd\u03b1 \u03be\u03b5\u03ba\u03bb\u03b5\u03b9\u03b4\u03ce\u03bd\u03b5\u03b9\u03c2 \u03cc\u03bb\u03b5\u03c2 \u03c4\u03b9\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ad\u03c8\u03b5\u03b9\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b1 advanced stats. \u0391\u03bb\u03bb\u03ac \u03c0\u03c1\u03ce\u03c4\u03b1, \u03b1\u03c0\u03cc\u03bb\u03b1\u03c5\u03c3\u03b5 \u03c4\u03bf \u03b4\u03ce\u03c1\u03bf \u03c3\u03bf\u03c5."
  ],
