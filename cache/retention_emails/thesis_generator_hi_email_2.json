{
  "subject": "\u0935\u094b \u092b\u0940\u091a\u0930 \u091c\u094b 90% \u092f\u0942\u091c\u0930\u094d\u0938 \u092e\u093f\u0938 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902",
  "preview_text": "\u0905\u0917\u0930 \u0924\u0941\u092e\u0928\u0947 \u092f\u0947 \u092b\u0940\u091a\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e, \u0924\u094b \u0924\u0941\u092e \u0905\u0938\u0932\u0940 \u092e\u091c\u093e \u0916\u094b \u0930\u0939\u0947 \u0939\u094b\u0964 \u0905\u092d\u0940 \u092a\u0922\u093c\u094b\u0964",
  "body_paragraphs": [
    "\u092e\u0948\u0902 \u0906\u091c \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u090f\u0915 \u0938\u091a \u092c\u0924\u093e\u0928\u0947 \u091c\u093e \u0930\u0939\u093e \u0939\u0942\u0901\u0964 \u091c\u092c \u092e\u0948\u0902\u0928\u0947 Thesis Generator \u092c\u0928\u093e\u092f\u093e, \u0924\u094b \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u093e \u092b\u0940\u091a\u0930 \u0935\u0939\u0940 \u0939\u094b\u0917\u093e \u091c\u094b \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u0926\u093f\u0916\u0924\u093e \u0939\u0948\u0964 \u092a\u0930 \u0928\u0939\u0940\u0902\u0964 \u0905\u0938\u0932 \u092e\u0947\u0902, 90% \u092f\u0942\u091c\u0930\u094d\u0938 \u090f\u0915 \u0910\u0938\u0947 \u092b\u0940\u091a\u0930 \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0928\u091c\u0930\u0905\u0902\u0926\u093e\u091c \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u091c\u094b \u0905\u0938\u0932 \u092e\u0947\u0902 \u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0915\u093e\u092e \u0915\u093e \u0939\u0948\u0964 \u0914\u0930 \u091c\u092c \u0909\u0928\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u091a\u0932\u0924\u093e \u0939\u0948, \u0924\u092c \u0924\u0915 \u092c\u0939\u0941\u0924 \u0926\u0947\u0930 \u0939\u094b \u091a\u0941\u0915\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964",
    "\u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u0939\u0948, \u0935\u094b \u092a\u0932 \u091c\u092c \u0924\u0941\u092e \u0918\u0902\u091f\u094b\u0902 \u090f\u0915 \u0939\u0940 \u0932\u093e\u0907\u0928 \u0915\u094b \u0918\u0942\u0930\u0924\u0947 \u0930\u0939\u0924\u0947 \u0939\u094b \u0914\u0930 \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0932\u093f\u0916 \u092a\u093e\u0924\u0947? \u092f\u093e \u091c\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092a\u0947\u092a\u0930 \u092e\u0947\u0902 \u0917\u094d\u0930\u093e\u092b \u0914\u0930 \u091f\u0947\u092c\u0932\u094d\u0938 \u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948 \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e \u0915\u093f \u0915\u0939\u093e\u0902 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902? \u0935\u094b \u0938\u093e\u0930\u0940 \u092a\u0930\u0947\u0936\u093e\u0928\u0940 \u0916\u0924\u094d\u092e \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948, \u092c\u0938 \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u0938\u0947\u0964 \u0939\u092e\u093e\u0930\u0947 \u092a\u093e\u0938 \u090f\u0915 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u0938\u0947 \u0932\u0947\u0915\u0930 \u092a\u0942\u0930\u0947 \u092a\u0947\u092a\u0930 \u0924\u0915, \u0939\u0930 \u091a\u0940\u091c \u0915\u094b \u0911\u091f\u094b-\u091c\u0928\u0930\u0947\u091f \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0907\u0924\u0928\u093e \u0939\u0940 \u0928\u0939\u0940\u0902, \u092f\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0915\u094b \u0907\u0924\u0928\u093e \u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c \u0915\u0930\u0924\u093e \u0939\u0948 \u0915\u093f AI \u0921\u093f\u091f\u0947\u0915\u094d\u091f\u0930 \u0909\u0938\u0947 \u092a\u0915\u0921\u093c \u0928\u0939\u0940\u0902 \u092a\u093e\u090f\u0917\u093e\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932\u0940 \u092c\u093e\u0924 \u092f\u0947 \u0939\u0948: \u092e\u0948\u0902 \u092c\u093e\u0924 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0901 '\u0906\u0909\u091f\u0932\u093e\u0907\u0928 \u091f\u0942 \u092b\u0941\u0932 \u092a\u0947\u092a\u0930' \u092b\u0940\u091a\u0930 \u0915\u0940\u0964 \u091c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0938\u094b\u091a\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u092f\u0947 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0938\u093e\u0927\u093e\u0930\u0923 \u091f\u0942\u0932 \u0939\u0948, \u092a\u0930 \u0905\u0938\u0932 \u092e\u0947\u0902 \u092f\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092a\u0942\u0930\u0947 \u092a\u0947\u092a\u0930 \u0915\u094b \u092e\u093f\u0928\u091f\u094b\u0902 \u092e\u0947\u0902 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0924\u0941\u092e \u092c\u0938 \u0905\u092a\u0928\u093e \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u0921\u093e\u0932\u094b, \u0914\u0930 \u092f\u0947 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u090f\u0915 \u092a\u0942\u0930\u093e \u0930\u094b\u0921\u092e\u0948\u092a \u0926\u0947\u0917\u093e\u2014\u0917\u094d\u0930\u093e\u092b, \u091f\u0947\u092c\u0932\u094d\u0938, \u0938\u093e\u0907\u091f\u0947\u0936\u0902\u0938 (APA, MLA, Chicago) \u0938\u092c \u0915\u0941\u091b \u0915\u0947 \u0938\u093e\u0925\u0964 \u0914\u0930 \u0939\u093e\u0901, \u092f\u0947 \u092a\u0940\u0921\u0940\u090f\u092b \u090f\u0915\u094d\u0938\u092a\u094b\u0930\u094d\u091f \u092d\u0940 \u0915\u0930\u0924\u093e \u0939\u0948 \u091c\u094b \u0938\u0940\u0927\u0947 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0928\u0947 \u0932\u093e\u092f\u0915 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092b\u093f\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092a\u093e\u0938 \u0935\u094b 8 \u0918\u0902\u091f\u0947 \u092c\u091a \u091c\u093e\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u0924\u0941\u092e \u092a\u0939\u0932\u0947 \u092c\u0930\u094d\u092c\u093e\u0926 \u0915\u0930\u0924\u0947 \u0925\u0947\u0964",
    "\u0905\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0930\u0940 \u0939\u0948\u0964 \u0905\u092a\u0928\u093e \u092b\u094b\u0928 \u0909\u0920\u093e\u0913, Thesis Generator \u0916\u094b\u0932\u094b, \u0914\u0930 '\u0906\u0909\u091f\u0932\u093e\u0907\u0928 \u091f\u0942 \u092b\u0941\u0932 \u092a\u0947\u092a\u0930' \u091f\u0948\u092c \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u094b\u0964 \u092c\u0938 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0926\u0947\u0916\u094b \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092e\u0948\u0902 \u0935\u093e\u0926\u093e \u0915\u0930\u0924\u093e \u0939\u0942\u0901, \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092a\u091b\u0924\u093e\u0928\u093e \u0928\u0939\u0940\u0902 \u092a\u0921\u093c\u0947\u0917\u093e\u0964 \u092a\u0940.\u090f\u0938. \u0905\u0917\u0930 \u0924\u0941\u092e \u0905\u092d\u0940 \u092d\u0940 \u092e\u093e\u0928\u0924\u0947 \u0939\u094b \u0915\u093f \u092f\u0947 \u0915\u093e\u092e \u0928\u0939\u0940\u0902 \u0915\u0930\u0947\u0917\u093e, \u0924\u094b \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092c\u093e\u0930 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b\u2014\u092b\u093f\u0930 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0928\u093e \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0917\u094d\u0930\u0947\u0921 B+ \u0938\u0947 A- \u092e\u0947\u0902 \u0915\u0948\u0938\u0947 \u092c\u0926\u0932 \u0917\u092f\u093e\u0964"
  ],
  "cta_text": "\u0905\u092d\u0940 \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u0948\u0938\u0947 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u092a\u0942\u0930\u093e \u092a\u0947\u092a\u0930 \u0924\u0948\u092f\u093e\u0930 \u0939\u094b\u0924\u093e \u0939\u0948",
