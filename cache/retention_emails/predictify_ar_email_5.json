{
  "subject": "\u0627\u0639\u062a\u0631\u0627\u0641: \u0647\u0630\u0627 \u0645\u0627 \u062d\u062f\u062b \u0641\u064a \u0627\u0644\u0633\u0627\u0639\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0635\u0628\u0627\u062d\u0627\u064b",
  "preview_text": "\u0644\u0645 \u0623\u0643\u0646 \u0623\u0646\u0648\u064a \u0625\u062e\u0628\u0627\u0631\u0643 \u0628\u0647\u0630\u0627 \u0623\u0628\u062f\u0627\u064b\u060c \u0644\u0643\u0646 \u0647\u0630\u0647 \u0627\u0644\u0642\u0635\u0629 \u0633\u062a\u063a\u064a\u0631 \u0637\u0631\u064a\u0642\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0643 \u0644\u0644\u062a\u0637\u0628\u064a\u0642 \u062a\u0645\u0627\u0645\u0627\u064b.",
  "body_paragraphs": [
    "\u0643\u0627\u0646\u062a \u0627\u0644\u0633\u0627\u0639\u0629 \u062a\u0634\u064a\u0631 \u0625\u0644\u0649 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0635\u0628\u0627\u062d\u0627\u064b\u060c \u0648\u0623\u0646\u0627 \u0623\u062d\u062f\u0642 \u0641\u064a \u0634\u0627\u0634\u0629 \u0645\u0644\u064a\u0626\u0629 \u0628\u0623\u0631\u0642\u0627\u0645 \u0644\u0627 \u062a\u0646\u062a\u0647\u064a. \u0645\u0628\u0627\u0631\u0627\u0629 \u0641\u0627\u0635\u0644\u0629 \u063a\u062f\u0627\u064b\u060c \u0648\u062a\u0648\u0642\u0639\u0627\u062a\u064a \u0643\u0644\u0647\u0627 \u062e\u0627\u0637\u0626\u0629. \u0633\u0623\u0644\u062a \u0646\u0641\u0633\u064a: \u0644\u0645\u0627\u0630\u0627 \u0646\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0627\u0644\u062d\u062f\u0633 \u0641\u064a \u0639\u0627\u0644\u0645 \u0645\u0644\u064a\u0621 \u0628\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\u061f",
    "\u0641\u064a \u062a\u0644\u0643 \u0627\u0644\u0644\u064a\u0644\u0629\u060c \u0627\u0643\u062a\u0634\u0641\u062a \u0634\u064a\u0626\u0627\u064b \u063a\u0631\u064a\u0628\u0627\u064b. \u0645\u0639\u0638\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u062a\u0642\u062f\u0645 \u062a\u0648\u0642\u0639\u0627\u062a \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 5 \u0623\u0648 6 \u0639\u0648\u0627\u0645\u0644 \u0641\u0642\u0637. \u0644\u0643\u0646 \u0645\u0628\u0627\u0631\u0627\u0629 \u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645 \u0645\u0639\u0642\u062f\u0629 \u0643\u062d\u0631\u0628 \u0627\u0633\u062a\u062e\u0628\u0627\u0631\u0627\u062a\u064a\u0629 - \u062a\u062d\u062a\u0627\u062c \u0644\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u0626\u0627\u062a \u0645\u0646 \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0627\u0644\u062e\u0641\u064a\u0629. \u0627\u0644\u0644\u0627\u0639\u0628 \u0627\u0644\u0630\u064a \u0639\u0627\u062f \u0645\u0646 \u0625\u0635\u0627\u0628\u0629\u060c \u0627\u0644\u0637\u0642\u0633 \u0627\u0644\u0645\u0641\u0627\u062c\u0626\u060c \u062d\u062a\u0649 \u0636\u063a\u0637 \u0627\u0644\u062c\u0645\u0647\u0648\u0631 \u0641\u064a \u0627\u0644\u0645\u0644\u0639\u0628. \u0647\u0630\u0627 \u0645\u0627 \u062f\u0641\u0639\u0646\u064a \u0644\u0644\u0639\u0645\u0644 \u062d\u062a\u0649 \u0627\u0644\u0641\u062c\u0631.",
    "\u0644\u0630\u0644\u0643 \u0628\u0646\u064a\u062a \u062e\u0627\u0635\u064a\u0629 '\u0645\u0624\u0634\u0631 \u0627\u0644\u062b\u0642\u0629' \u0627\u0644\u062a\u064a \u062a\u0631\u0627\u0647\u0627 \u0628\u062c\u0627\u0646\u0628 \u0643\u0644 \u062a\u0648\u0642\u0639. \u0647\u0630\u0627 \u0627\u0644\u0631\u0642\u0645 \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u062a\u062e\u0645\u064a\u0646 - \u0625\u0646\u0647 \u0646\u062a\u064a\u062c\u0629 \u062a\u062d\u0644\u064a\u0644 1247 \u0645\u062a\u063a\u064a\u0631\u0627\u064b \u0645\u062e\u062a\u0644\u0641\u0627\u064b \u0644\u0643\u0644 \u0645\u0628\u0627\u0631\u0627\u0629. \u0639\u0646\u062f\u0645\u0627 \u062a\u0634\u0627\u0647\u062f 85%\u060c \u0641\u0623\u0646\u062a \u062a\u0639\u0631\u0641 \u0623\u0646 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u062a\u0642\u0641 \u062e\u0644\u0641 \u0647\u0630\u0627 \u0627\u0644\u0631\u0642\u0645\u060c \u0648\u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u0634\u0639\u0648\u0631.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0634\u0627\u0647\u062f \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0627\u0644\u064a\u0648\u0645. \u0627\u0646\u0642\u0631 \u0639\u0644\u0649 \u0623\u064a \u062a\u0648\u0642\u0639 \u0648\u0633\u062a\u0631\u0649 \u0643\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u062e\u0641\u064a\u0629 \u0648\u0631\u0627\u0621\u0647 - \u0645\u0646 \u0642\u0648\u0629 \u0627\u0644\u0647\u062c\u0648\u0645 \u0625\u0644\u0649 \u0636\u0639\u0641 \u0627\u0644\u062f\u0641\u0627\u0639. \u062c\u0631\u0628\u0647\u0627 \u0642\u0628\u0644 \u0627\u0646\u062a\u0647\u0627\u0621 \u062a\u062c\u0631\u0628\u062a\u0643 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629 \u0628\u064a\u0648\u0645\u064a\u0646 \u0641\u0642\u0637. P.S.: \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0647\u0630\u0647 \u0627\u0644\u062e\u0627\u0635\u064a\u0629 \u064a\u0631\u062a\u0641\u0639 \u0645\u0639\u062f\u0644 \u062f\u0642\u0629 \u062a\u0648\u0642\u0639\u0627\u062a\u0647\u0645 \u0628\u0646\u0633\u0628\u0629 63% - \u0647\u0630\u0627 \u0644\u064a\u0633 \u0643\u0644\u0627\u0645\u064a\u060c \u0647\u0630\u0647 \u0623\u0631\u0642\u0627\u0645\u0646\u0627.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0634\u0627\u0647\u062f \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0627\u0644\u064a\u0648\u0645. \u0627\u0646\u0642\u0631 \u0639\u0644\u0649 \u0623\u064a \u062a\u0648\u0642\u0639 \u0648\u0633\u062a\u0631\u0649 \u0643\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u062e\u0641\u064a\u0629 \u0648\u0631\u0627\u0621\u0647 - \u0645\u0646 \u0642\u0648\u0629 \u0627\u0644\u0647\u062c\u0648\u0645 \u0625\u0644\u0649 \u0636\u0639\u0641 \u0627\u0644\u062f\u0641\u0627\u0639. \u062c\u0631\u0628\u0647\u0627 \u0642\u0628\u0644 \u0627\u0646\u062a\u0647\u0627\u0621 \u062a\u062c\u0631\u0628\u062a\u0643 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629 \u0628\u064a\u0648\u0645\u064a\u0646 \u0641\u0642\u0637. P.S.: \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0647\u0630\u0647 \u0627\u0644\u062e\u0627\u0635\u064a\u0629 \u064a\u0631\u062a\u0641\u0639 \u0645\u0639\u062f\u0644 \u062f\u0642\u0629 \u062a\u0648\u0642\u0639\u0627\u062a\u0647\u0645 \u0628\u0646\u0633\u0628\u0629 63% - \u0647\u0630\u0627 \u0644\u064a\u0633 \u0643\u0644\u0627\u0645\u064a\u060c \u0647\u0630\u0647 \u0623\u0631\u0642\u0627\u0645\u0646\u0627."
  ],
