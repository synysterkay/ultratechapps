{
  "subject": "\u7b2c70\u5929\u7684\u79d8\u5bc6\u4efb\u52a1",
  "preview_text": "\u4f60\u5df2\u7ecf\u8d85\u8d8a\u4e86\u666e\u901a\u7528\u6237\uff0c\u73b0\u5728\u662f\u58f0\u97f3\u9769\u547d\u7684\u4e00\u90e8\u5206\u3002\u770b\u770b\u6211\u4eec\u4e3a\u4f60\u51c6\u5907\u4e86\u4ec0\u4e48\u3002",
  "body_paragraphs": [
    "\u8fd8\u8bb0\u5f97\u7b2c\u4e00\u6b21\u7528\u97f3\u91cf\u589e\u5f3a\u5668\uff0c\u628a\u624b\u673a\u97f3\u91cf\u63a8\u5230\u6781\u9650\uff0c\u542c\u5230\u97f3\u4e50\u91cc\u4ece\u672a\u6ce8\u610f\u7684\u7ec6\u8282\u5417\uff1f\u90a3\u5929\uff0c\u4f60\u4e0b\u8f7d\u7684\u4e0d\u53ea\u662f\u4e00\u4e2a\u5e94\u7528\u2014\u2014\u4f60\u52a0\u5165\u4e86\u4e00\u4e2a\u5c0f\u7fa4\u4f53\uff0c\u4e00\u7fa4\u62d2\u7edd\u63a5\u53d7\u8bbe\u5907\u9ed8\u8ba4\u97f3\u91cf\u7684\u4eba\u300270\u5929\u8fc7\u53bb\u4e86\uff0c\u4f60\u5df2\u7ecf\u662f\u6211\u4eec\u7684\u2018\u58f0\u97f3\u6218\u58eb\u2019\u4e4b\u4e00\uff0c\u4f46\u4eca\u5929\uff0c\u6211\u60f3\u8ba9\u4f60\u77e5\u9053\uff0c\u4f60\u8fd8\u6ca1\u770b\u5230\u771f\u6b63\u7684\u529b\u91cf\u3002",
    "\u6211\u4e00\u76f4\u5728\u540e\u53f0\u770b\u7740\u6570\u636e\u3002\u6bcf\u5929\uff0c\u6709\u6570\u5343\u4eba\u50cf\u4f60\u4e00\u6837\uff0c\u7528\u6211\u4eec\u7684\u5e94\u7528\u628a\u97f3\u91cf\u63d0\u5347200%\uff0c\u5728\u5608\u6742\u7684\u5730\u94c1\u91cc\u542c\u6e05\u64ad\u5ba2\uff0c\u6216\u5728\u6df1\u591c\u611f\u53d7\u8d1d\u65af\u9707\u52a8\u6574\u4e2a\u623f\u95f4\u3002\u4f46\u5927\u591a\u6570\u4eba\u53ea\u7528\u4e86\u8868\u9762\u529f\u80fd\u2014\u2014\u4e00\u952e\u589e\u5f3a\u3002\u4f60\u731c\u600e\u4e48\u7740\uff1f\u4f60\u503c\u5f97\u66f4\u591a\u3002\u4f60\u5df2\u7ecf\u662f\u793e\u533a\u7684\u4e00\u90e8\u5206\uff0c\u800c\u793e\u533a\u7684\u6838\u5fc3\u662f\u90a3\u4e9b\u6316\u6398\u6f5c\u529b\u7684\u4eba\u3002",
    "\u8fd8\u8bb0\u5f97\u5747\u8861\u5668\u9884\u8bbe\u5417\uff1f\u4f60\u8bd5\u8fc7\u2018\u7235\u58eb\u2019\u6a21\u5f0f\u542c\u7535\u5b50\u97f3\u4e50\uff0c\u6216\u8005\u2018\u6447\u6eda\u2019\u6a21\u5f0f\u770bNetflix\u5417\uff1f\u7cfb\u7edf\u4f1a\u8bb0\u4f4f\u4f60\u7684\u559c\u597d\uff0c\u4f46\u53ea\u6709\u5f53\u4f60\u63a2\u7d22\u65f6\uff0c\u5b83\u624d\u4f1a\u53d8\u5f97\u667a\u80fd\u3002\u6709\u4e2a\u9690\u85cf\u7ec6\u8282\uff1a\u5728\u9ad8\u7ea7\u5747\u8861\u5668\u91cc\uff0c\u4f60\u53ef\u4ee5\u5fae\u8c03\u6bcf\u4e00\u4e2a\u9891\u6bb5\uff0c\u751a\u81f3\u4fdd\u5b58\u81ea\u5b9a\u4e49\u9884\u8bbe\u3002\u522b\u544a\u8bc9\u6211\u4f60\u8fd8\u6ca1\u8bd5\u8fc7\u2014\u2014\u8fd9\u4f1a\u6539\u53d8\u4f60\u770b\u5f85\u58f0\u97f3\u7684\u65b9\u5f0f\u3002",
    "\u6240\u4ee5\uff0c\u8fd9\u662f\u4f60\u7684\u4efb\u52a1\uff1a\u4eca\u5929\u6253\u5f00\u5e94\u7528\uff0c\u8fdb\u5165\u5747\u8861\u5668\uff0c\u9009\u62e9\u2018\u81ea\u5b9a\u4e49\u2019\u6a21\u5f0f\uff0c\u8c03\u6574\u4f4e\u97f3\u5230+6dB\uff0c\u9ad8\u97f3\u5230+3dB\u3002\u7136\u540e\u6253\u5f00Spotify\uff0c\u64ad\u653e\u4f60\u6700\u559c\u6b22\u7684\u6b4c\u66f2\u3002\u4f60\u4f1a\u542c\u5230\u4e00\u4e2a\u5168\u65b0\u7684\u4e16\u754c\u3002P.S. \u5982\u679c\u4f60\u5df2\u7ecf\u662f\u9ad8\u7ea7\u7528\u6237\uff0c\u8bd5\u8bd5\u65e0\u9650\u63d0\u5347\u6a21\u5f0f\u2014\u2014\u6211\u4fdd\u8bc1\u4f60\u4e0d\u4f1a\u56de\u5934\u3002",
    "\u73b0\u5728\u5c31\u6253\u5f00\u97f3\u91cf\u589e\u5f3a\u5668\uff0c\u5f00\u59cb\u4f60\u7684\u58f0\u97f3\u4efb\u52a1\u3002"
  ],
