{
  "subject": "\u090f\u0915 \u0917\u0941\u092a\u094d\u0924 \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u091c\u094b 90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0928\u0939\u0940\u0902 \u091c\u093e\u0928\u0924\u0947",
  "preview_text": "\u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u092f\u0939\u0940 \u091f\u094d\u0930\u093f\u0915 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0915\u093f\u0938\u0940 \u0938\u0947 \u0936\u0947\u092f\u0930 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964 \u092f\u0939\u093e\u0901 \u092c\u0924\u093e\u0924\u093e \u0939\u0942\u0901...",
  "body_paragraphs": [
    "\u092e\u0948\u0902\u0928\u0947 \u0915\u0932 \u090f\u0915 \u0926\u094b\u0938\u094d\u0924 \u0915\u094b \u0926\u0947\u0916\u093e - \u0935\u0939 \u0905\u092a\u0928\u0947 \u092b\u093c\u094b\u0928 \u092a\u0930 \u0917\u093e\u0928\u093e \u0938\u0941\u0928 \u0930\u0939\u093e \u0925\u093e \u0914\u0930 \u092c\u093e\u0930-\u092c\u093e\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u091f\u0928 \u0926\u092c\u093e \u0930\u0939\u093e \u0925\u093e\u0964 \u092e\u0948\u0902\u0928\u0947 \u0909\u0938\u0947 \u0930\u094b\u0915\u093e \u0914\u0930 5 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0935\u0939\u0940 \u0915\u093e\u092e \u0915\u0930\u0915\u0947 \u0926\u093f\u0916\u093e\u092f\u093e \u091c\u094b \u0909\u0938\u0928\u0947 30 \u0938\u0947\u0915\u0902\u0921 \u0938\u0947 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964 \u0909\u0938\u0915\u0940 \u0906\u0901\u0916\u0947\u0902 \u092b\u091f\u0940 \u0915\u0940 \u092b\u091f\u0940 \u0930\u0939 \u0917\u0908\u0902\u0964",
    "\u092f\u0939\u0940 \u0935\u0939 '\u0907\u0928\u0938\u093e\u0907\u0921\u0930 \u091f\u094d\u0930\u093f\u0915' \u0939\u0948 \u091c\u094b \u0938\u092d\u0940 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u092a\u0930 \u092c\u0924\u093e\u0924\u0947 \u0928\u0939\u0940\u0902\u0964 \u0906\u092a\u0915\u094b \u0939\u0930 \u092c\u093e\u0930 \u0910\u092a \u0916\u094b\u0932\u0915\u0930 \u092c\u0942\u0938\u094d\u091f\u0930 \u0911\u0928 \u0915\u0930\u0928\u0947 \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0938\u0947\u091f \u0915\u0930 \u0932\u094b, \u0914\u0930 \u092b\u093f\u0930 \u0915\u092d\u0940 \u092d\u0940 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0910\u092a \u092e\u0947\u0902 - \u091a\u093e\u0939\u0947 Spotify \u0939\u094b \u092f\u093e YouTube - \u0938\u0940\u0927\u0947 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u092a\u0948\u0928\u0932 \u0938\u0947 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0913\u0964 \u092f\u0939 \u0935\u0939 \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u0911\u0921\u093f\u092f\u094b \u090f\u0915\u094d\u0938\u092a\u0940\u0930\u093f\u092f\u0902\u0938 \u0915\u094b 10x \u092c\u0928\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
    "Volume Booster \u092e\u0947\u0902 '\u0915\u094d\u0935\u093f\u0915 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u091f\u093e\u0907\u0932' \u092b\u0940\u091a\u0930 \u0939\u0948\u0964 \u0907\u0938\u0947 \u090f\u0915 \u092c\u093e\u0930 \u0938\u0947\u091f\u0905\u092a \u0915\u0930\u094b, \u0914\u0930 \u092b\u093f\u0930 \u090a\u092a\u0930 \u0938\u0947 \u0938\u094d\u0935\u093e\u0907\u092a \u0915\u0930\u0915\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0935\u0915\u094d\u0924 \u092c\u0942\u0938\u094d\u091f \u0911\u0928/\u0911\u092b \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964 \u092c\u093f\u0928\u093e \u0910\u092a \u0916\u094b\u0932\u0947\u0964 \u092c\u093f\u0928\u093e \u0930\u0941\u0915\u0947\u0964 \u0938\u0940\u0927\u0947 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u092c\u093e\u0930 \u0938\u0947\u0964 \u092f\u0939\u0940 \u0935\u091c\u0939 \u0939\u0948 \u0915\u093f \u091c\u094b \u0932\u094b\u0917 \u0930\u094b\u091c\u093c 2-3 \u0918\u0902\u091f\u0947 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0907\u0938 \u0910\u092a \u0938\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0928\u093f\u0915\u0932\u0924\u0947\u0964",
    "\u0905\u092d\u0940 Volume Booster \u0916\u094b\u0932\u094b, \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u091c\u093e\u0913, \u0914\u0930 '\u0915\u094d\u0935\u093f\u0915 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u091f\u093e\u0907\u0932' \u0911\u0928 \u0915\u0930 \u0926\u094b\u0964 \u0906\u091c \u0938\u0947 \u0924\u0941\u092e \u092d\u0940 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0940 \u0932\u093f\u0938\u094d\u091f \u092e\u0947\u0902 \u0906 \u091c\u093e\u0913\u0917\u0947\u0964 P.S.: \u092f\u0939 \u091f\u094d\u0930\u093f\u0915 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902 \u0939\u0948 - \u092b\u094d\u0930\u0940 \u0935\u0930\u094d\u091c\u0928 \u092e\u0947\u0902 \u092d\u0940 \u0915\u093e\u092e \u0915\u0930\u0924\u0940 \u0939\u0948, \u092c\u0938 \u0915\u093f\u0938\u0940 \u0915\u094b \u092c\u0924\u093e\u0928\u093e \u092e\u0924\u0964"
  ],
