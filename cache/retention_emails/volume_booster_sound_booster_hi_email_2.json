{
  "subject": "\u0935\u094b \u092b\u0940\u091a\u0930 \u091c\u094b 90% \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u094b \u0928\u0939\u0940\u0902 \u092a\u0924\u093e",
  "preview_text": "\u090f\u0915 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u092c\u091f\u0928 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0926\u094b\u0917\u0941\u0928\u093e \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0917\u0932\u0924\u0940 \u0915\u0940\u0964 \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092a\u0942\u0930\u093e \u092c\u0922\u093c\u093e \u0926\u093f\u092f\u093e, \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u092d\u0940 \u0917\u093e\u0928\u093e \u0938\u0941\u0928\u093e\u0908 \u0928\u0939\u0940\u0902 \u0926\u0947 \u0930\u0939\u093e \u0925\u093e\u0964 \u0924\u092d\u0940 \u092e\u0941\u091d\u0947 \u092f\u093e\u0926 \u0906\u092f\u093e\u2014\u090f\u0915 \u0910\u0938\u093e \u092b\u0940\u091a\u0930 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0916\u0941\u0926 \u092c\u0928\u093e\u092f\u093e \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u0936\u093e\u092f\u0926 \u0906\u092a\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e\u0964",
    "\u091c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0938\u094b\u091a\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f Volume Booster - Sound Booster \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092c\u091f\u0928 \u0926\u092c\u093e\u0928\u0947 \u0915\u0940 \u091a\u0940\u091c\u093c \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932\u0940 \u091c\u093e\u0926\u0942 \u0924\u094b \u090f\u0915 \u0914\u0930 \u091a\u0940\u091c\u093c \u092e\u0947\u0902 \u091b\u093f\u092a\u093e \u0939\u0948\u0964 \u0935\u094b \u0939\u0948 '\u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930'\u0964 \u0939\u093e\u0901, \u0935\u0939\u0940 \u091c\u093f\u0938\u0947 \u0932\u094b\u0917 \u0938\u094d\u0915\u093f\u092a \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0909\u0928\u094d\u0939\u0947\u0902 \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u092f\u0939 \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0938\u091a\u094d\u091a\u093e\u0908 \u092f\u0947 \u0939\u0948 \u0915\u093f \u092f\u0939\u0940 \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u092c\u0926\u0932 \u0938\u0915\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092a\u0928\u0947 \u0910\u092a \u092e\u0947\u0902 \u091c\u093e\u0907\u090f\u0964 \u0928\u0940\u091a\u0947 \u0926\u0947\u0916\u093f\u090f, \u090f\u0915 'EQ' \u0915\u093e \u092c\u091f\u0928 \u0939\u0948\u0964 \u0909\u0938\u0947 \u0926\u092c\u093e\u0907\u090f\u0964 \u092b\u093f\u0930 'Rock' \u092f\u093e 'Jazz' \u092f\u093e 'Electronic' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091a\u0941\u0928\u093f\u090f\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u092e\u0947\u0902 \u0906\u092a\u0915\u093e \u0938\u093e\u0909\u0902\u0921 \u092b\u094d\u0932\u0948\u091f \u0938\u0947 \u0932\u093e\u0907\u0935 \u0915\u0949\u0928\u094d\u0938\u0930\u094d\u091f \u091c\u0948\u0938\u093e \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964 \u092c\u093e\u0938 \u0917\u0939\u0930\u093e \u0939\u094b\u0917\u093e, \u0935\u094b\u0915\u0932\u094d\u0938 \u0938\u093e\u092b\u093c \u0939\u094b\u0902\u0917\u0947, \u0914\u0930 \u0939\u0930 \u0928\u094b\u091f \u0905\u092a\u0928\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0939\u094b\u0917\u093e\u0964 \u092f\u0939 \u0935\u094b \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u093f\u0938\u0947 90% \u092f\u0942\u091c\u0930\u094d\u0938 \u092e\u093f\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u091c\u094b \u0907\u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u093e \u0939\u0948, \u0935\u094b \u0915\u092d\u0940 \u0935\u093e\u092a\u0938 \u0928\u0939\u0940\u0902 \u091c\u093e\u0924\u093e\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 EQ \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091f\u0947\u0938\u094d\u091f \u0915\u0930\u0947\u0902\u0964 \u0938\u093f\u0930\u094d\u092b 10 \u0938\u0947\u0915\u0902\u0921 \u0932\u0917\u0947\u0902\u0917\u0947\u0964 P.S. \u0905\u0917\u0930 \u0906\u092a\u0915\u094b 'Bass Booster' \u092f\u093e 'Loudness Enhancer' \u092a\u0938\u0902\u0926 \u0939\u0948, \u0924\u094b Premium \u091f\u094d\u0930\u093e\u092f\u0932 \u0932\u0947\u0928\u0947 \u092a\u0930 \u092f\u0947 \u0938\u092c \u0905\u0928\u0932\u0949\u0915 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u2014\u0932\u0947\u0915\u093f\u0928 \u092a\u0939\u0932\u0947 \u092f\u0947 \u092b\u094d\u0930\u0940 \u092b\u0940\u091a\u0930 \u0906\u091c\u093c\u092e\u093e\u0907\u090f\u0964 \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u0906\u092a\u0915\u094b \u0927\u0928\u094d\u092f\u0935\u093e\u0926 \u0915\u0939\u0947\u0917\u093e\u0964"
  ],
