{
  "subject": "90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u092f\u0939 \u0917\u0932\u0924\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0906\u092a \u092d\u0940?",
  "preview_text": "\u0906\u092a\u0915\u0947 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0947 \u092c\u093e\u0926 \u092e\u0941\u091d\u0947 \u090f\u0915 \u092c\u093e\u0924 \u0915\u093e \u092a\u0924\u093e \u091a\u0932\u093e \u091c\u094b \u0906\u092a\u0915\u094b \u091c\u093e\u0928\u0928\u093e \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u092a\u0941\u0930\u093e\u0928\u093e \u0917\u093e\u0928\u093e \u0938\u0941\u0928\u093e \u0914\u0930 \u0915\u0941\u091b \u0910\u0938\u093e \u0939\u0941\u0906 \u091c\u094b \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0939\u0941\u0906\u0964 \u092e\u0941\u091d\u0947 \u0932\u0917\u093e \u091c\u0948\u0938\u0947 \u092e\u0948\u0902 \u0938\u094d\u091f\u0942\u0921\u093f\u092f\u094b \u092e\u0947\u0902 \u0916\u0921\u093c\u093e \u0939\u0942\u0901 \u0914\u0930 \u0917\u093f\u091f\u093e\u0930 \u0938\u0940\u0927\u0947 \u092e\u0947\u0930\u0947 \u0926\u093f\u0932 \u092e\u0947\u0902 \u092c\u091c \u0930\u0939\u093e \u0939\u0948\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b\u093c \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0925\u093e\u0964",
    "\u092f\u0939\u0940 \u0935\u0939 \u092a\u0932 \u0925\u093e \u091c\u092c \u092e\u0948\u0902\u0928\u0947 \u0938\u092e\u091d\u093e \u0915\u093f \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0938\u093f\u0930\u094d\u092b\u093c \u092c\u0942\u0938\u094d\u091f \u092c\u091f\u0928 \u0926\u092c\u093e\u0915\u0930 \u0910\u092a \u092c\u0902\u0926 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u094b \u0905\u0938\u0932\u0940 \u091c\u093e\u0926\u0942 \u0924\u094b \u091b\u0942\u091f \u0939\u0940 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u0909\u0938\u0915\u0947 \u092c\u093f\u0928\u093e, \u0906\u092a\u0915\u093e \u092e\u094d\u092f\u0942\u091c\u093c\u093f\u0915 \u0935\u0948\u0938\u093e \u092b\u094d\u0932\u0948\u091f \u0914\u0930 \u092c\u0947\u091c\u093e\u0928 \u0939\u0940 \u0930\u0939\u0947\u0917\u093e \u091c\u0948\u0938\u093e \u092a\u0939\u0932\u0947 \u0925\u093e\u0964",
    "\u0935\u094b \u091c\u093e\u0926\u0942 \u0939\u0948 '\u092c\u093f\u0932\u094d\u091f-\u0907\u0928 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930'\u0964 \u092a\u0949\u092a, \u0930\u0949\u0915, \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915\u2014\u0939\u0930 \u091c\u0947\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u0964 \u092f\u0939 \u092b\u093c\u0940\u091a\u0930 \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u0928\u0939\u0940\u0902, \u0909\u0938\u0915\u0940 \u0906\u0924\u094d\u092e\u093e \u0915\u094b \u092c\u0942\u0938\u094d\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092c\u093e\u0938 \u0907\u0924\u0928\u093e \u0917\u0939\u0930\u093e \u0915\u093f \u0906\u092a \u0909\u0938\u0947 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0947\u0902\u0917\u0947\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u091f\u0948\u092c \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u092c\u0938 \u090f\u0915 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0938\u0941\u0928\u0947\u0902 \u0915\u093f \u0906\u092a\u0915\u093e \u092b\u093c\u094b\u0928 \u0915\u0948\u0938\u0947 \u090f\u0915 \u0928\u092f\u093e \u0921\u093f\u0935\u093e\u0907\u0938 \u092c\u0928 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u0930\u0949\u0915 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0915\u0947 \u0938\u093e\u0925 \u0915\u094b\u0908 \u092d\u0940 \u092a\u0941\u0930\u093e\u0928\u093e \u0917\u093e\u0928\u093e \u0938\u0941\u0928\u0947\u0902... \u0906\u092a \u092e\u0941\u091d\u0947 \u092c\u093e\u0926 \u092e\u0947\u0902 \u0927\u0928\u094d\u092f\u0935\u093e\u0926 \u0926\u0947\u0902\u0917\u0947\u0964"
  ],
