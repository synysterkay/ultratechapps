{
  "subject": "\uc774 \uc571\uc73c\ub85c \uc774\ub7f0 \uc77c\uc744 \ud558\ub2e4\ub2c8.. \ucda9\uaca9\uc785\ub2c8\ub2e4",
  "preview_text": "\ud55c \uc0ac\uc6a9\uc790\uac00 Predictify\ub85c \uc644\uc804\ud788 \uc608\uc0c1\uce58 \ubabb\ud55c \ubc29\uc2dd\uc73c\ub85c \uc2b9\ubd80\ub97c \ubd24\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\ub3c4 \ub180\ub784 \uac81\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uc194\uc9c1\ud788 \ub9d0\ud560\uac8c\uc694. \uc774 \uc571\uc744 \ub9cc\ub4e4\uba74\uc11c \uc774\ub7f0 \uc6a9\ub3c4\ub294 \uc804\ud600 \uc0c1\uc0c1 \ubabb \ud588\uc5b4\uc694. \uc5b4\ub290 \ub0a0 \ud55c \uc720\uc800\uac00 \uc800\ud55c\ud14c \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0b4\uc654\ub294\ub370, 'Predictify\ub85c \ub0b4 \ucd95\uad6c \uc9c0\uc2dd\uc774 \uc5bc\ub9c8\ub098 \uc815\ud655\ud55c\uc9c0 \uc2dc\ud5d8\ud574\ubd24\uc5b4\uc694'\ub77c\uace0 \ud558\ub354\ub77c\uace0\uc694. \ucc98\uc74c\uc5d0\ub294 \ubb34\uc2a8 \uc18c\ub9ac\uc778\uac00 \ud588\uc8e0.",
    "\uc54c\uace0 \ubcf4\ub2c8 \uadf8 \uc720\uc800\ub294 \ub9e4 \uacbd\uae30 \uc804\uc5d0 AI \uc608\uce21\uc744 \ubcf4\uace0, \uc790\uae30 \uc9c1\uac10\uacfc \ube44\uad50\ud558\uba74\uc11c \uc810\uc218\ub97c \ub9e4\uae30\uace0 \uc788\uc5c8\uc5b4\uc694. 'AI\uac00 \uc608\uce21\ud55c \uacb0\uacfc vs \ub0b4 \uc608\uce21'\uc744 \uae30\ub85d\ud558\uba74\uc11c \ub9d0\uc774\uc8e0. \uba87 \uc8fc \ud6c4\uc5d0 \uadf8 \uc0ac\ub78c\uc774 \ubcf4\ub0b8 \uc2a4\ud06c\ub9b0\uc0f7\uc744 \ubd24\ub294\ub370, \uc790\uae30 \uc608\uce21 \uc815\ud655\ub3c4\uac00 AI\ubcf4\ub2e4 8%\ub098 \ub192\uc558\uc5b4\uc694. \uadf8\ub54c \uae68\ub2ec\uc558\uc5b4\uc694. \uc774 \uc571\uc774 \ub2e8\uc21c\ud788 \uc608\uce21 \ub3c4\uad6c\uac00 \uc544\ub2c8\ub77c, \uc790\uae30 \uc2e4\ub825\uc744 \uce21\uc815\ud558\uace0 \ud0a4\uc6b0\ub294 \ud6c8\ub828\uc7a5\uc774 \ub420 \uc218\ub3c4 \uc788\uad6c\ub098.",
    "\ubc14\ub85c \uadf8 \uae30\ub2a5, IQ \ud034\uc988\uc778\ub370\uc694. \uc6b0\ub9ac\ub294 \ub2e8\uc21c\ud788 \ud034\uc988\ub77c\uace0 \uc0dd\uac01\ud588\uc9c0\ub9cc, \ud604\uba85\ud55c \uc720\uc800\ub4e4\uc740 AI\uc640\uc758 \ub300\uacb0\uc744 \ud1b5\ud574 \ucd95\uad6c \ud1b5\ucc30\ub825\uc744 \ud0a4\uc6b0\uace0 \uc788\uc5b4\uc694. \ub9e4\uc77c\uc758 \uc608\uce21\uc744 \uae30\ub85d\ud558\uace0, AI\uc758 \ubd84\uc11d\uc744 \uacf5\ubd80\ud558\uba74\uc11c \uc790\uc2e0\ub9cc\uc758 \ub370\uc774\ud130 \uae30\ubc18 \uc804\ub7b5\uc744 \uc138\uc6b0\ub294 \uac70\uc8e0. \ucee4\ubba4\ub2c8\ud2f0\uc5d0\uc11c \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uacfc \uc608\uce21\uc744 \ube44\uad50\ud558\uace0, \uacb0\uacfc\ub97c \ubd84\uc11d\ud558\uba74\uc11c \uc2e4\ub825\uc774 \uc313\uc5ec\uc694. \uc774\uac8c \ubc14\ub85c '\ub370\uc774\ud130\uac00 \uc9c1\uac10\uc744 \uc774\uae34\ub2e4'\ub294 \ub9d0\uc758 \uc9c4\uc9dc \uc758\ubbf8\uc785\ub2c8\ub2e4.",
    "\uc624\ub298 \ud574\ubcfc\uae4c\uc694? \uc571\uc744 \uc5f4\uace0 'IQ \ud034\uc988'\ub85c \uac00\uc11c AI\uc640 \ud55c \ud310 \uaca8\ub904\ubcf4\uc138\uc694. \ub0b4 \uc608\uce21 \uc815\ud655\ub3c4\uac00 \uc5b4\ub290 \uc815\ub3c4\uc778\uc9c0 \uc9c1\uc811 \ud655\uc778\ud574\ubcf4\ub294 \uac70\uc608\uc694. P.S. \ud639\uc2dc AI\ub97c \uc774\uae30\uba74, \uadf8 \uacb0\uacfc\ub97c \ucee4\ubba4\ub2c8\ud2f0\uc5d0 \uacf5\uc720\ud574\uc8fc\uc138\uc694. \uc9c4\uc9dc \ucd95\uad6c \uace0\uc218\uc778\uc9c0 \ud655\uc778\ud574\ubcf4\uace0 \uc2f6\uc5b4\uc694."
  ],
