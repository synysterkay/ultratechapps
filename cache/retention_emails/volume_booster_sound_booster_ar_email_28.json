{
  "subject": "\u0639\u0628\u062f\u0627\u0644\u0644\u0647\u060c \u0627\u0644\u064a\u0648\u0645 \u0647\u0648 \u064a\u0648\u0645 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649",
  "preview_text": "\u0641\u064a 21 \u064a\u0648\u0646\u064a\u0648\u060c \u0643\u0644 \u0627\u0644\u0639\u0627\u0644\u0645 \u064a\u062d\u062a\u0641\u0644 \u0628\u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649. \u0647\u0644 \u062a\u0639\u0644\u0645 \u0623\u0646 \u0647\u0627\u062a\u0641\u0643 \u064a\u0645\u0643\u0646\u0647 \u0623\u0646 \u064a\u063a\u0646\u064a \u0628\u0635\u0648\u062a \u0623\u0639\u0644\u0649 \u0628\u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a\u061f",
  "body_paragraphs": [
    "\u0623\u0639\u0644\u0645 \u0623\u0646\u0643 \u0645\u0634\u063a\u0648\u0644. \u0644\u0643\u0646 \u0627\u0644\u064a\u0648\u0645 \u0647\u0648 \u064a\u0648\u0645 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0627\u0644\u0639\u0627\u0644\u0645\u064a. \u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u062a\u0633\u062a\u0645\u0639 \u0644\u0623\u063a\u0646\u064a\u062a\u0643 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0628\u0635\u0648\u062a \u064a\u0645\u0644\u0623 \u0627\u0644\u063a\u0631\u0641\u0629\u060c \u0648\u0643\u0623\u0646\u0643 \u0641\u064a \u062d\u0641\u0644 \u0645\u0628\u0627\u0634\u0631. \u0647\u0630\u0627 \u0644\u064a\u0633 \u062d\u0644\u0645\u064b\u0627.",
    "\u0641\u064a \u0647\u0627\u062a\u0641\u0643\u060c \u0647\u0646\u0627\u0643 \u0643\u0646\u0632 \u0645\u062e\u0641\u064a. \u0639\u0646\u062f\u0645\u0627 \u062a\u0633\u062a\u062e\u062f\u0645 \u062a\u0637\u0628\u064a\u0642\u0646\u0627\u060c \u064a\u0645\u0643\u0646\u0643 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0625\u0644\u0649 \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0644\u0645 \u062a\u0633\u0645\u0639\u0647\u0627 \u0645\u0646 \u0642\u0628\u0644. \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0623\u0646 \u0645\u0639\u0638\u0645 \u0627\u0644\u0646\u0627\u0633 \u0644\u0627 \u064a\u0639\u0631\u0641\u0648\u0646 \u0623\u0646 \u0647\u0627\u062a\u0641\u0647\u0645 \u064a\u0645\u0643\u0646\u0647 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0628\u0647\u0630\u0647 \u0627\u0644\u0642\u0648\u0629.",
    "\u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u064a \u0623\u062a\u062d\u062f\u062b \u0639\u0646\u0647\u0627 \u0647\u064a '\u0627\u0644\u0645\u0639\u0632\u0632 \u0627\u0644\u0635\u0648\u062a\u064a \u0627\u0644\u0641\u0648\u0631\u064a'. \u0627\u0636\u063a\u0637 \u0639\u0644\u064a\u0647\u0627 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629\u060c \u0648\u0633\u062a\u0634\u0639\u0631 \u0648\u0643\u0623\u0646\u0643 \u0627\u0634\u062a\u0631\u064a\u062a \u0633\u0645\u0627\u0639\u0627\u062a \u062c\u062f\u064a\u062f\u0629. \u0627\u0644\u0635\u0648\u062a \u064a\u0635\u0628\u062d \u0639\u0645\u064a\u0642\u064b\u0627\u060c \u0648\u0627\u0636\u062d\u064b\u0627\u060c \u0648\u0642\u0648\u064a\u064b\u0627. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646 \u0645\u0639 \u0623\u064a \u0623\u063a\u0646\u064a\u0629 \u0623\u0648 \u0628\u0648\u062f\u0643\u0627\u0633\u062a.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0648\u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 '\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0635\u0648\u062a'. \u0633\u062a\u0631\u0649 \u0627\u0644\u0641\u0631\u0642 \u0641\u064a \u062b\u0648\u0627\u0646\u064d. \u0644\u0627 \u062a\u0646\u062a\u0638\u0631 \u062d\u062a\u0649 \u064a\u0646\u062a\u0647\u064a \u0627\u0644\u064a\u0648\u0645. P.S. \u0625\u0630\u0627 \u062c\u0631\u0628\u062a \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0633\u0628\u0642\u0629 \u0644\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0645\u062b\u0644 '\u0628\u0648\u0628' \u0623\u0648 '\u0631\u0648\u0643'\u060c \u0633\u062a\u0646\u062f\u0647\u0634 \u0643\u064a\u0641 \u064a\u062a\u062d\u0648\u0644 \u0635\u0648\u062a \u0647\u0627\u062a\u0641\u0643 \u0625\u0644\u0649 \u062c\u0647\u0627\u0632 \u062d\u0641\u0644\u0627\u062a. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u064a\u0648\u0645."
  ],
