{
  "subject": "\u0622\u067e \u06a9\u06d2 \u063a\u0627\u0626\u0628 \u06c1\u0648\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f \u0633\u06d2 \u067e\u0631\u06cc\u0688\u06a9\u0679\u06cc\u0641\u0627\u0626\u06cc \u0628\u062f\u0644 \u06af\u06cc\u0627 \u06c1\u06d2",
  "preview_text": "48 \u062f\u0646\u0648\u06ba \u0645\u06cc\u06ba AI \u0646\u06d2 \u0646\u06cc\u0627 \u0641\u06cc\u0686\u0631 \u0634\u0627\u0645\u0644 \u06a9\u06cc\u0627 \u06c1\u06d2 \u062c\u0648 \u0622\u067e \u06a9\u06cc \u067e\u0686\u06be\u0644\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0648\u06ba \u06a9\u0648 \u0628\u06d2 \u0645\u0639\u0646\u06cc \u0628\u0646\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u062c\u0627\u0646\u06cc\u06ba \u06a9\u06cc\u0633\u06d2\u06d4",
  "body_paragraphs": [
    "\u06cc\u0627\u062f \u06c1\u06d2 \u062c\u0628 \u0622\u067e \u0646\u06d2 \u067e\u06c1\u0644\u06cc \u0628\u0627\u0631 \u067e\u0631\u06cc\u0688\u06a9\u0679\u06cc\u0641\u0627\u0626\u06cc \u06a9\u06be\u0648\u0644\u0627 \u062a\u06be\u0627\u061f \u0634\u0627\u06cc\u062f \u0622\u067e \u0646\u06d2 \u0633\u0648\u0686\u0627 \u062a\u06be\u0627 \u06a9\u06c1 \u06cc\u06c1 \u0635\u0631\u0641 \u0627\u06cc\u06a9 \u0627\u0648\u0631 \u0627\u06cc\u067e \u06c1\u06d2\u06d4 \u0644\u06cc\u06a9\u0646 \u062c\u0628 \u0633\u06d2 \u0622\u067e \u0646\u06d2 \u0644\u0627\u06af \u0627\u0646 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627\u060c AI \u0646\u06d2 \u06a9\u0686\u06be \u0646\u06cc\u0627 \u0633\u06cc\u06a9\u06be\u0627 \u06c1\u06d2\u06d4 \u0627\u06cc\u06a9 \u0646\u06cc\u0627 \u0627\u0644\u06af\u0648\u0631\u062a\u06be\u0645 \u062c\u0648 \u0622\u067e \u06a9\u06d2 \u067e\u0633\u0646\u062f\u06cc\u062f\u06c1 \u06a9\u06be\u0644\u0627\u0691\u06cc\u0648\u06ba \u06a9\u06cc \u06a9\u0627\u0631\u06a9\u0631\u062f\u06af\u06cc \u06a9\u0648 \u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u06af\u06c1\u0631\u0627\u0626\u06cc \u0633\u06d2 \u062a\u062c\u0632\u06cc\u06c1 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4",
    "\u06cc\u06c1 \u0635\u0631\u0641 \u0627\u06cc\u06a9 \u0627\u067e \u0688\u06cc\u0679 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4 \u06cc\u06c1 \u0627\u06cc\u06a9 \u0627\u0646\u0642\u0644\u0627\u0628 \u06c1\u06d2\u06d4 \u0627\u0628 \u0622\u067e \u06c1\u0631 \u0645\u06cc\u0686 \u06a9\u06d2 \u0644\u06cc\u06d2 95% \u062a\u06a9 \u062f\u0631\u0633\u062a \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0627\u06ba \u062f\u06cc\u06a9\u06be \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0644\u06cc\u06a9\u0646 \u0635\u0631\u0641 \u0627\u0633 \u0635\u0648\u0631\u062a \u0645\u06cc\u06ba \u062c\u0628 \u0622\u067e \u0627\u06cc\u067e \u06a9\u06be\u0648\u0644\u06cc\u06ba\u06d4 \u06a9\u06cc\u0627 \u0622\u067e \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u06af\u0632\u0634\u062a\u06c1 \u06c1\u0641\u062a\u06d2 \u0644\u0627 \u0644\u06cc\u06af\u0627 \u06a9\u06d2 \u0627\u06cc\u06a9 \u0645\u06cc\u0686 \u0645\u06cc\u06ba\u060c AI \u0646\u06d2 89% \u0627\u0639\u062a\u0645\u0627\u062f \u06a9\u06d2 \u0633\u0627\u062a\u06be \u063a\u0644\u0637 \u0646\u062a\u06cc\u062c\u06c1 \u067e\u06cc\u0634 \u06a9\u06cc\u0627 \u062a\u06be\u0627\u061f \u0648\u06c1 \u063a\u0644\u0637\u06cc \u0627\u0628 \u062f\u0631\u0633\u062a \u06c1\u0648 \u0686\u06a9\u06cc \u06c1\u06d2\u06d4",
    "\u0646\u06cc\u0627 \u0641\u06cc\u0686\u0631: 'AI \u0686\u06cc\u0679' \u0627\u0628 \u0622\u067e \u0633\u06d2 \u0633\u0648\u0627\u0644\u0627\u062a \u067e\u0648\u0686\u06be \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4 \u0645\u062b\u0627\u0644 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631\u060c '\u06a9\u06cc\u0627 \u0645\u06cc\u0633\u06cc \u0622\u062c \u0631\u0627\u062a \u06af\u0648\u0644 \u06a9\u0631\u06d2 \u06af\u0627\u061f' \u0627\u0648\u0631 AI \u0622\u067e \u06a9\u0648 xG\u060c \u062f\u0641\u0627\u0639\u06cc \u06a9\u0645\u0632\u0648\u0631\u06cc\u060c \u0627\u0648\u0631 \u062a\u0627\u0631\u06cc\u062e\u06cc \u0688\u06cc\u0679\u0627 \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631 \u062c\u0648\u0627\u0628 \u062f\u06d2 \u06af\u0627\u06d4 \u06cc\u06c1 \u0648\u06c1 \u0686\u06cc\u0632 \u06c1\u06d2 \u062c\u0648 \u067e\u06c1\u0644\u06d2 \u0646\u06c1\u06cc\u06ba \u062a\u06be\u06cc\u06d4 \u0627\u0648\u0631 \u0627\u06af\u0631 \u0622\u067e \u067e\u0631\u06cc\u0645\u06cc\u0645 \u0622\u0632\u0645\u0627\u0626\u06cc\u06ba \u06af\u06d2 \u062a\u0648 \u0622\u067e \u06a9\u0648 3 \u062f\u0646 \u06a9\u0627 \u0645\u0641\u062a \u0679\u0631\u0627\u0626\u0644 \u0645\u0644\u06d2 \u06af\u0627\u060c \u062c\u06c1\u0627\u06ba \u062a\u0645\u0627\u0645 \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0627\u06ba \u06a9\u06be\u0644\u06cc \u06c1\u06cc\u06ba\u06d4",
    "\u0622\u067e \u06a9\u0627 \u0627\u06af\u0644\u0627 \u0642\u062f\u0645: \u067e\u0631\u06cc\u0688\u06a9\u0679\u06cc\u0641\u0627\u0626\u06cc \u06a9\u06be\u0648\u0644\u06cc\u06ba \u0627\u0648\u0631 'IQ \u06a9\u0648\u0626\u0632' \u0645\u06cc\u06ba \u062d\u0635\u06c1 \u0644\u06cc\u06ba\u06d4 \u06cc\u06c1 \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u06a9\u06c1 AI \u06a9\u06d2 \u0645\u0642\u0627\u0628\u0644\u06d2 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0627 \u0641\u0679 \u0628\u0627\u0644 \u0639\u0644\u0645 \u06a9\u062a\u0646\u0627 \u0645\u0636\u0628\u0648\u0637 \u06c1\u06d2\u06d4 \u067e\u06cc \u0627\u06cc\u0633: \u062c\u0648 \u0635\u0627\u0631\u0641\u06cc\u0646 \u0622\u062c \u0644\u0627\u06af \u0627\u0646 \u06a9\u0631\u06cc\u06ba \u06af\u06d2\u060c \u0627\u0646\u06c1\u06cc\u06ba 50 \u0645\u0641\u062a \u06a9\u0631\u06cc\u0688\u0679\u0633 \u0645\u0644\u06cc\u06ba \u06af\u06d2 \u2014 \u0644\u06cc\u06a9\u0646 \u06cc\u06c1 \u0635\u0631\u0641 24 \u06af\u06be\u0646\u0679\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u06c1\u06d2\u06d4"
