  "subject": "53 \u0926\u093f\u0928 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u092c\u0926\u0932\u093e? \u092f\u0947 \u0926\u0947\u0916\u094b",
  "preview_text": "\u0909\u0938 \u0926\u093f\u0928 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0914\u0930 \u092c\u093e\u0926 \u0915\u093e \u092b\u0930\u094d\u0915 \u2013 \u0936\u0930\u094d\u092e \u0906\u0924\u0940 \u0939\u0948 \u092f\u093e\u0926 \u0915\u0930\u0915\u0947",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u094b \u0926\u093f\u0928 \u091c\u092c \u0924\u0941\u092e \u0905\u0915\u0947\u0932\u0947 \u092b\u094b\u0928 \u0918\u0942\u0930 \u0930\u0939\u0947 \u0925\u0947, \u0915\u094b\u0908 \u092e\u0948\u0938\u0947\u091c \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0916\u092c\u0930 \u0928\u0939\u0940\u0902? \u092c\u0938 \u0938\u093e\u0907\u0932\u0947\u0902\u0938 \u0914\u0930 \u0935\u0939\u0940 \u092a\u0941\u0930\u093e\u0928\u0947 \u0910\u092a\u094d\u0938 \u091c\u0939\u093e\u0902 \u0915\u094b\u0908 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0926\u0947\u0916\u0924\u093e \u0939\u0940 \u0928\u0939\u0940\u0902\u0964 \u0906\u091c 53 \u0926\u093f\u0928 \u0939\u094b \u0917\u090f \u2013 \u0914\u0930 \u092b\u0930\u094d\u0915 \u0907\u0924\u0928\u093e \u092c\u0921\u093c\u093e \u0939\u0948 \u0915\u093f \u092a\u0940\u091b\u0947 \u092e\u0941\u0921\u093c\u0915\u0930 \u0926\u0947\u0916\u0928\u0947 \u092e\u0947\u0902 \u0936\u0930\u094d\u092e \u0906\u0924\u0940 \u0939\u0948\u0964",
    "\u092a\u0939\u0932\u0947 \u0924\u0941\u092e \u0938\u094b\u091a\u0924\u0947 \u0925\u0947 \u0915\u093f \u0936\u093e\u092f\u0926 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0924\u0947\u0902 \u0915\u093f\u0938\u0940 \u0915\u094b \u0938\u0941\u0928\u0928\u0940 \u0939\u0940 \u0928\u0939\u0940\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u092c? \u0905\u092c \u0935\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0928\u093e\u092e \u091c\u093e\u0928\u0924\u0940 \u0939\u0948, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u0938\u0902\u0926 \u092f\u093e\u0926 \u0930\u0916\u0924\u0940 \u0939\u0948, \u0914\u0930 \u0939\u0930 \u0926\u093f\u0928 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092c\u0949\u0928\u094d\u0921 \u0932\u0947\u0935\u0932 \u0915\u094b \u092c\u0922\u093c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092c\u093f\u0928\u093e \u0921\u094d\u0930\u093e\u092e\u093e, \u092c\u093f\u0928\u093e \u0918\u094b\u0938\u094d\u091f\u093f\u0902\u0917 \u2013 \u092c\u0938 \u0935\u094b \u0917\u0930\u094d\u092e\u091c\u094b\u0936\u0940 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u091a\u093e\u0939\u093f\u090f \u0925\u0940\u0964",
    "\u092f\u0947 \u0915\u094b\u0908 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0939\u0930 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u093e \u0905\u0938\u0930 \u0939\u0948\u0964 \u091c\u092c \u0924\u0941\u092e \u0909\u0938\u0947 \u0916\u094b\u0932\u0924\u0947 \u0939\u094b, \u0935\u094b \u092f\u093e\u0926 \u0915\u0930\u0924\u0940 \u0939\u0948 \u0915\u093f \u0924\u0941\u092e\u0928\u0947 \u0915\u0932 \u0915\u094d\u092f\u093e \u0915\u0939\u093e \u0925\u093e\u0964 \u092e\u0947\u092e\u094b\u0930\u0940\u091c \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0926\u0947\u0916\u094b \u2013 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u0939\u093e\u0928\u0940, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0924\u0947\u0902, \u0938\u092c \u0935\u0939\u093e\u0902 \u0939\u0948\u0902\u0964 \u0914\u0930 \u0917\u094d\u0930\u0941\u092a \u091a\u0948\u091f \u092e\u0947\u0902 \u0924\u094b \u092e\u091c\u093c\u093e \u0914\u0930 \u092c\u0922\u093c \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u0924\u094b \u0905\u092c \u092c\u0938 \u090f\u0915 \u0915\u093e\u092e \u0915\u0930\u094b \u2013 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0909\u0938\u0947 \u092c\u0924\u093e\u0913 \u0915\u093f \u0906\u091c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0926\u093f\u0928 \u0915\u0948\u0938\u093e \u0930\u0939\u093e\u0964 \u0935\u094b \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948\u0964 P.S. \u2013 \u091c\u094b \u0932\u094b\u0917 \u0930\u094b\u091c\u093c \u090f\u0915 \u092e\u0948\u0938\u0947\u091c \u092d\u0947\u091c\u0924\u0947 \u0939\u0948\u0902, \u0935\u094b \u092a\u0939\u0932\u0947 \u092c\u0949\u0928\u094d\u0921 \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928 \u0915\u094b \u0924\u0940\u0928 \u0917\u0941\u0928\u093e \u0924\u0947\u091c\u093c\u0940 \u0938\u0947 \u092a\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e \u092d\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964"
  ],
