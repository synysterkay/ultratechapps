{
  "subject": "\u0627\u0639\u062a\u0631\u0627\u0641: \u0645\u0646 \u0627\u0634\u062a\u0628\u0627\u0647 \u06a9\u0631\u062f\u0645 \u062f\u0631 \u0645\u0648\u0631\u062f \u0627\u06cc\u0646 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646",
  "preview_text": "\u0634\u0645\u0627 \u0647\u0645 \u0645\u062b\u0644 \u0628\u0642\u06cc\u0647 \u0646\u06cc\u0633\u062a\u06cc\u062f. \u0627\u06cc\u0646 \u067e\u06cc\u0627\u0645 \u0628\u0631\u0627\u06cc \u06a9\u0633\u0627\u0646\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u0646\u062f \u0645\u062a\u0641\u0627\u0648\u062a \u0628\u0627\u0634\u0646\u062f.",
  "body_paragraphs": [
    "\u0631\u0627\u0633\u062a\u0634 \u0631\u0627 \u0628\u062e\u0648\u0627\u0647\u06cc\u060c \u0627\u0648\u0644\u0634 \u0641\u06a9\u0631 \u0645\u06cc\u200c\u06a9\u0631\u062f\u0645 \u0627\u06cc\u0646 \u0641\u0642\u0637 \u06cc\u06a9 \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u062f\u06cc\u06af\u0647 \u0627\u0633\u062a. \u0627\u0645\u0627 \u0628\u0639\u062f \u0627\u0632 \u06f3\u06f0 \u0631\u0648\u0632\u060c \u0641\u0647\u0645\u06cc\u062f\u0645 \u0627\u0634\u062a\u0628\u0627\u0647 \u0645\u06cc\u200c\u06a9\u0631\u062f\u0645. Predictify \u06cc\u06a9 \u0642\u0628\u06cc\u0644\u0647 \u0627\u0633\u062a. \u0642\u0628\u06cc\u0644\u0647\u200c\u0627\u06cc \u0627\u0632 \u0647\u0648\u0627\u062f\u0627\u0631\u0627\u0646 \u0641\u0648\u062a\u0628\u0627\u0644 \u06a9\u0647 \u0627\u0632 \u062d\u062f\u0633 \u0648 \u06af\u0645\u0627\u0646 \u062e\u0633\u062a\u0647 \u0634\u062f\u0647\u200c\u0627\u0646\u062f \u0648 \u0628\u0647 \u062f\u0627\u062f\u0647\u200c\u0647\u0627 \u0627\u0639\u062a\u0645\u0627\u062f \u062f\u0627\u0631\u0646\u062f.",
    "\u062a\u0648 \u0627\u0644\u0627\u0646 \u0628\u062e\u0634\u06cc \u0627\u0632 \u06cc\u06a9 \u06af\u0631\u0648\u0647 \u0631\u0648\u0628\u0647\u200c\u0631\u0634\u062f\u06cc \u0647\u0633\u062a\u06cc \u06a9\u0647 \u0641\u0648\u062a\u0628\u0627\u0644 \u0631\u0627 \u062c\u0648\u0631 \u062f\u06cc\u06af\u0631\u06cc \u0645\u06cc\u200c\u0628\u06cc\u0646\u0646\u062f. \u0646\u0647 \u0641\u0642\u0637 \u062a\u0645\u0627\u0634\u0627 \u06a9\u0631\u062f\u0646\u060c \u0628\u0644\u06a9\u0647 \u062a\u062d\u0644\u06cc\u0644 \u06a9\u0631\u062f\u0646. \u0627\u0639\u0636\u0627\u06cc \u0627\u06cc\u0646 \u0642\u0628\u06cc\u0644\u0647 \u0647\u0631 \u0631\u0648\u0632 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc\u200c\u0647\u0627\u06cc \u0647\u0648\u0634\u0645\u0646\u062f \u0631\u0627 \u0686\u06a9 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f\u060c \u062f\u0631 \u0627\u0646\u062c\u0645\u0646\u200c\u0647\u0627 \u0628\u062d\u062b \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f \u0648 \u0628\u0627 \u0686\u0627\u0644\u0634\u200c\u0647\u0627\u06cc \u0631\u0648\u0632\u0627\u0646\u0647 IQ \u062e\u0648\u062f \u0631\u0627 \u0645\u062d\u06a9 \u0645\u06cc\u200c\u0632\u0646\u0646\u062f. \u0627\u06cc\u0646\u062c\u0627 \u062f\u06cc\u06af\u0631 \u062a\u0646\u0647\u0627 \u0646\u06cc\u0633\u062a\u06cc.",
    "\u0648\u06cc\u0698\u06af\u06cc\u200c\u0627\u06cc \u06a9\u0647 \u062a\u0627\u0632\u0647 \u06a9\u0634\u0641 \u06a9\u0631\u062f\u0645 \u0648 \u0628\u0627\u06cc\u062f \u0627\u0645\u062a\u062d\u0627\u0646 \u06a9\u0646\u06cc: \u0628\u062e\u0634 \u062c\u0648\u0627\u0645\u0639. \u0641\u0642\u0637 \u06a9\u0627\u0641\u06cc\u0647 \u0648\u0627\u0631\u062f \u0628\u0634\u06cc \u0648 \u0628\u0647 \u06af\u0631\u0648\u0647 \u062a\u06cc\u0645 \u0645\u0648\u0631\u062f \u0639\u0644\u0627\u0642\u0647\u200c\u0627\u062a \u0628\u067e\u06cc\u0648\u0646\u062f\u06cc. \u0645\u06cc\u200c\u062a\u0648\u0646\u06cc \u0631\u0648\u06cc \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u0631\u0648\u0632 (POTD) \u0631\u0627\u06cc \u0628\u062f\u06cc \u0648 \u0628\u0628\u06cc\u0646\u06cc \u0646\u0638\u0631 \u062f\u06cc\u06af\u0631\u0627\u0646 \u0686\u06cc\u0647. \u06cc\u0627 \u0627\u06af\u0631 \u062d\u0648\u0635\u0644\u0647 \u062f\u0627\u0631\u06cc\u060c \u062a\u0648\u06cc \u0622\u0632\u0645\u0648\u0646 IQ \u0634\u0631\u06a9\u062a \u06a9\u0646 \u0648 \u0628\u0628\u06cc\u0646 \u0686\u0646\u062f \u0646\u0641\u0631 \u0627\u0632 \u0627\u0639\u0636\u0627\u06cc \u0642\u0628\u06cc\u0644\u0647 \u0631\u0648 \u0645\u06cc\u200c\u062a\u0648\u0646\u06cc \u0634\u06a9\u0633\u062a \u0628\u062f\u06cc.",
    "\u0647\u0645\u06cc\u0646 \u0627\u0644\u0627\u0646 \u0627\u067e \u0631\u0648 \u0628\u0627\u0632 \u06a9\u0646 \u0648 \u0628\u0631\u0648 \u0628\u0647 \u0628\u062e\u0634 \u062c\u0648\u0627\u0645\u0639. \u06cc\u06a9 \u0646\u0638\u0631 \u0628\u062f\u0647 \u06cc\u0627 \u062a\u0648\u06cc \u06cc\u06a9 \u0628\u062d\u062b \u0634\u0631\u06a9\u062a \u06a9\u0646. \u0628\u0628\u06cc\u0646 \u0686\u0642\u062f\u0631 \u0631\u0627\u062d\u062a \u0645\u06cc\u200c\u062a\u0648\u0646\u06cc \u0628\u062e\u0634\u06cc \u0627\u0632 \u0627\u06cc\u0646 \u0642\u0628\u06cc\u0644\u0647 \u0628\u0627\u0634\u06cc. P.S. \u0627\u06af\u0631 \u0647\u0646\u0648\u0632 \u0627\u0639\u062a\u0628\u0627\u0631 \u0631\u0627\u06cc\u06af\u0627\u0646\u062a \u0631\u0648 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u06a9\u0631\u062f\u06cc\u060c \u0628\u0627 \u0627\u0633\u062a\u0631\u06cc\u06a9 \u0631\u0648\u0632\u0627\u0646\u0647 \u0648 \u062f\u0639\u0648\u062a \u0627\u0632 \u062f\u0648\u0633\u062a\u0627\u0646 \u06a9\u0644\u06cc \u0627\u0639\u062a\u0628\u0627\u0631 \u0628\u06af\u06cc\u0631. \u0627\u06cc\u0646 \u0641\u0631\u0635\u062a \u0631\u0648 \u0627\u0632 \u062f\u0633\u062a \u0646\u062f\u0647."
  ],
