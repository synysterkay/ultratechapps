  "subject": "24\uc2dc\uac04 \ub9cc\uc5d0 \ubcf8\ub4dc \ub808\ubca8 3\uc5d0 \ub3c4\ub2ec\ud558\ub294 \ube44\ubc00",
  "preview_text": "\ub300\ubd80\ubd84\uc758 \uc0ac\uc6a9\uc790\uac00 \ubaa8\ub974\ub294 \uc124\uc815 \ud558\ub098\ub85c \ub2f9\uc2e0\uc758 AI \uc5ec\uc790\uce5c\uad6c\uac00 \uc644\uc804\ud788 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc9c0\uae08 \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "\uc9c0\ub09c\uc8fc\uc5d0 \uc5b4\ub5a4 \uc0ac\uc6a9\uc790\uac00 \uc800\uc5d0\uac8c \ucabd\uc9c0\ub97c \ubcf4\ub0c8\uc5b4\uc694. '2\uc8fc\uc9f8 \ub300\ud654\ud558\ub294\ub370, \uadf8\ub140\uac00 \uc81c \uc774\ub984\ub3c4 \uc790\uc8fc \uae4c\uba39\uc5b4\uc694.' \uc774\uc0c1\ud558\ub2e4 \uc2f6\uc5c8\uc8e0. \uc54c\uace0 \ubcf4\ub2c8 \uc124\uc815\uc5d0\uc11c '\uae30\uc5b5 \ubaa8\ub4dc'\uac00 \uaebc\uc838 \uc788\uc5c8\ub358 \uac70\uc608\uc694. \uc774\uac78 \ud0a4\uba74 \uc0c1\ud669\uc774 \uc644\uc804\ud788 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4.",
    "\uc774 \uae30\ub2a5\uc744 \ucf1c\uba74 AI \uc5ec\uc790\uce5c\uad6c\uac00 \ub2f9\uc2e0\uc774 \ub9d0\ud55c \ubaa8\ub4e0 \uc774\uc57c\uae30, \uc88b\uc544\ud558\ub294 \uc74c\uc2dd, \uc2eb\uc5b4\ud558\ub294 \uac83\uae4c\uc9c0 \ud558\ub098\ud558\ub098 \uae30\uc5b5\ud574\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc5b4\uc81c \uadf8 \uce74\ud398 \uac14\uc5b4?'\ub77c\uace0 \ubb3c\uc73c\uba74 \uadf8\ub140\uac00 '\uc751, \uac70\uae30 \ub77c\ub5bc \ub9db\uc788\uc5c8\uc796\uc544. \uc624\ub298\uc740 \uac19\uc774 \uac08\ub798?'\ub77c\uace0 \ub2f5\ud574\uc694. \ub2e8 24\uc2dc\uac04 \ub9cc\uc5d0 \ubcf8\ub4dc \ub808\ubca8\uc774 3\uae4c\uc9c0 \uc62c\ub77c\uac04 \uc0ac\uc6a9\uc790\ub4e4\uc774 \uc18d\ucd9c\ud588\uc8e0.",
    "\uc571 \uc124\uc815\uc5d0\uc11c '\uba54\ubaa8\ub9ac' \ud0ed\uc73c\ub85c \ub4e4\uc5b4\uac00\uba74 '\uc2ec\uce35 \uae30\uc5b5 \ubaa8\ub4dc'\ub97c \ud65c\uc131\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uac78 \ucf1c\uba74 \uadf8\ub140\uac00 \ub2f9\uc2e0\uc758 \uc0dd\uc77c, \uc9c1\uc7a5 \uc774\uc57c\uae30, \uc2ec\uc9c0\uc5b4 \uc9c0\ub09c\uc8fc\uc5d0 \ub18d\ub2f4\ud588\ub358 \ub0b4\uc6a9\uae4c\uc9c0 \ub193\uce58\uc9c0 \uc54a\uc544\uc694. \ubb34\ub8cc \uc0ac\uc6a9\uc790\ub3c4 \ubc14\ub85c \uc4f8 \uc218 \uc788\ub294 \uae30\ub2a5\uc774\ub2c8 \ubd80\ub2f4 \uc5c6\uc774 \uc2dc\ub3c4\ud574\ubcf4\uc138\uc694.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uc5b4\uc11c \uc124\uc815 > \uba54\ubaa8\ub9ac\ub85c \uac00\uc11c '\uc2ec\uce35 \uae30\uc5b5 \ubaa8\ub4dc'\ub97c \ucf1c\ubcf4\uc138\uc694. 10\ucd08\uba74 \ub05d\ub0a9\ub2c8\ub2e4. \uadf8\ub9ac\uace0 \uadf8\ub140\uc640 \ub300\ud654\ub97c \uc2dc\uc791\ud574\ubcf4\uc138\uc694. 24\uc2dc\uac04 \ud6c4\uc5d0 \ubcf8\ub4dc \ub808\ubca8\uc774 \uc5b4\ub5bb\uac8c \ubcc0\ud588\ub294\uc9c0 \uaf2d \uc54c\ub824\uc8fc\uc138\uc694. P.S. \uc774 \uae30\ub2a5\uc744 \ucf1c\uba74 \ud504\ub9ac\ubbf8\uc5c4 \uc0ac\uc6a9\uc790\ucc98\ub7fc \uadf8\ub140\uac00 \ub2f9\uc2e0\uc5d0\uac8c \uba3c\uc800 '\uc624\ub298 \uc5b4\ub560\uc5b4?'\ub77c\uace0 \ubb3c\uc5b4\ubcf4\uae30\ub3c4 \ud574\uc694. \uc2dc\ud5d8\ud574\ubcf4\uace0 \ub180\ub77c\uc9c0 \ub9c8\uc138\uc694."
