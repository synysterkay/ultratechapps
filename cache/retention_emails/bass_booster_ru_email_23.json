{
  "subject": "\u0422\u0432\u043e\u0439 \u0442\u0440\u0435\u043a \u0437\u0432\u0443\u0447\u0438\u0442 \u043a\u0430\u043a \u0438\u0437 \u0432\u0435\u0434\u0440\u0430",
  "preview_text": "\u042f \u0432\u043a\u043b\u044e\u0447\u0438\u043b \u0442\u043e\u0442 \u0436\u0435 \u0442\u0440\u0435\u043a \u0434\u043e \u0438 \u043f\u043e\u0441\u043b\u0435. \u0420\u0430\u0437\u043d\u0438\u0446\u0430 \u2014 \u044d\u0442\u043e \u0441\u0442\u044b\u0434\u043d\u043e. \u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043f\u043e\u043a\u0430 \u043d\u0435 \u0437\u0430\u0431\u044b\u043b.",
  "body_paragraphs": [
    "\u041f\u043e\u043c\u043d\u0438\u0448\u044c, \u043a\u0430\u043a \u0442\u044b \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0432\u043a\u043b\u044e\u0447\u0438\u043b \u0441\u0432\u043e\u0439 \u043b\u044e\u0431\u0438\u043c\u044b\u0439 \u0431\u0438\u0442 \u043d\u0430 \u044d\u0442\u0438\u0445 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u0445? \u0418 \u043f\u043e\u0434\u0443\u043c\u0430\u043b: \u00ab\u0413\u0434\u0435 \u0431\u0430\u0441? \u0413\u0434\u0435 \u0443\u0434\u0430\u0440?\u00bb \u042f \u0442\u043e\u0436\u0435 \u0442\u0430\u043a \u0434\u0443\u043c\u0430\u043b. \u0410 \u043f\u043e\u0442\u043e\u043c \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e \u043d\u0430\u0436\u0430\u043b \u043d\u0430 \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a \u0432 Bass Booster \u2014 \u0438 \u0442\u0440\u0435\u043a \u0437\u0430\u0437\u0432\u0443\u0447\u0430\u043b \u0442\u0430\u043a, \u0431\u0443\u0434\u0442\u043e \u044f \u0432 \u043a\u043b\u0443\u0431\u0435. \u0421\u0435\u0440\u044c\u0451\u0437\u043d\u043e, \u0441\u0442\u044b\u0434\u043d\u043e \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u0442\u044c, \u0447\u0442\u043e \u044f \u0441\u043b\u0443\u0448\u0430\u043b \u0434\u043e \u044d\u0442\u043e\u0433\u043e.",
    "\u0412\u043e\u0442 \u0447\u0442\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0431\u0435\u0437 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f: \u0442\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0441\u0436\u0438\u043c\u0430\u0435\u0442 \u0437\u0432\u0443\u043a, \u0440\u0435\u0436\u0435\u0442 \u043d\u0438\u0437\u043a\u0438\u0435 \u0447\u0430\u0441\u0442\u043e\u0442\u044b, \u0438 \u0431\u0438\u0442 Hip-Hop \u0442\u0440\u0435\u043a\u0430 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u0432 \u043f\u0438\u0441\u043a. \u0421 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c \u2014 \u0442\u044b \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044c \u043a\u0430\u0436\u0434\u044b\u0439 \u0443\u0434\u0430\u0440 \u0431\u043e\u0447\u043a\u0438 \u0432 \u0433\u0440\u0443\u0434\u0438, \u0434\u0430\u0436\u0435 \u043d\u0430 \u0434\u0435\u0448\u0451\u0432\u044b\u0445 \u0437\u0430\u0442\u044b\u0447\u043a\u0430\u0445. EDM-\u0434\u0440\u043e\u043f \u0431\u044c\u0451\u0442 \u0442\u0430\u043a, \u0447\u0442\u043e \u0441\u043e\u0441\u0435\u0434\u0438 \u0441\u0442\u0443\u0447\u0430\u0442 \u043f\u043e \u0431\u0430\u0442\u0430\u0440\u0435\u0435. \u0420\u0430\u0437\u043d\u0438\u0446\u0430 \u2014 \u043a\u0430\u043a \u043c\u0435\u0436\u0434\u0443 \u0441\u0442\u0430\u0440\u044b\u043c \u043a\u0430\u0441\u0441\u0435\u0442\u043d\u0438\u043a\u043e\u043c \u0438 \u043a\u043e\u043d\u0446\u0435\u0440\u0442\u043e\u043c.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Bass Booster \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441, \u0432\u043a\u043b\u044e\u0447\u0438 \u043b\u044e\u0431\u043e\u0439 \u0442\u0440\u0435\u043a \u0432 Spotify \u0438\u043b\u0438 YouTube \u0438 \u043f\u043e\u0442\u044f\u043d\u0438 \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a Boost \u0432\u043f\u0440\u0430\u0432\u043e. \u0412\u0441\u0435\u0433\u043e \u043e\u0434\u043d\u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u2014 \u0438 \u0442\u044b \u0443\u0441\u043b\u044b\u0448\u0438\u0448\u044c, \u0447\u0442\u043e \u0442\u0432\u043e\u0438 \u043a\u043e\u043b\u043e\u043d\u043a\u0438 \u0443\u043c\u0435\u043b\u0438 \u0432\u0441\u0451 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f. \u041f\u0440\u043e\u0441\u0442\u043e \u0438\u043c \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u043b\u043e \u0441\u043c\u0435\u043b\u043e\u0441\u0442\u0438 \u0431\u0435\u0437 \u043d\u0430\u0441.",
    "\u041d\u0430\u0436\u043c\u0438 \u00ab\u041f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u0442\u044c \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0435\u00bb \u2014 \u044d\u0442\u043e \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e. P.S. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u043f\u043e\u043b\u043d\u044b\u0439 10-\u043f\u043e\u043b\u043e\u0441\u043d\u044b\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u0438 \u0431\u0435\u0437\u043b\u0438\u043c\u0438\u0442\u043d\u044b\u0439 \u0431\u0443\u0441\u0442, Premium \u0441\u0442\u043e\u0438\u0442 \u043a\u043e\u043f\u0435\u0439\u043a\u0438. \u041d\u043e \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u2014 \u0442\u044b \u0443\u0434\u0438\u0432\u0438\u0448\u044c\u0441\u044f, \u043a\u0430\u043a \u0434\u043e\u043b\u0433\u043e \u0442\u044b \u0441\u043b\u0443\u0448\u0430\u043b \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0443 \u0437\u0432\u0443\u043a\u0430."
  ],
