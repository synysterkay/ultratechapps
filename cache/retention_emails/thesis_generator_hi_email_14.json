{
  "subject": "\u0935\u094b \u091a\u0940\u091c\u093c \u091c\u094b 90% \u091b\u093e\u0924\u094d\u0930 \u091b\u094b\u0921\u093c \u0926\u0947\u0924\u0947 \u0939\u0948\u0902",
  "preview_text": "\u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f 50,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u091b\u093e\u0924\u094d\u0930 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0907\u0938 \u091f\u094d\u0930\u093f\u0915 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902? \u0906\u092a \u092d\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",
  "body_paragraphs": [
    "\u0906\u092a\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u0935\u094b \u092b\u093c\u0940\u091a\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u094b \u0906\u092a\u0915\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u092c\u0926\u0932 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0939\u093e\u0901, \u092e\u0948\u0902 \u092c\u093e\u0924 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0901 '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c \u090f\u0906\u0908 \u091f\u0947\u0915\u094d\u0938\u094d\u091f' \u0915\u0940\u0964 \u092f\u0939 \u0935\u094b \u091a\u0940\u091c\u093c \u0939\u0948 \u091c\u094b 90% \u091b\u093e\u0924\u094d\u0930 \u091b\u094b\u0921\u093c \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u091c\u094b \u0907\u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 8 \u0918\u0902\u091f\u0947 \u0915\u0940 \u092e\u0947\u0939\u0928\u0924 \u0915\u094b 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u092c\u0926\u0932 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0906\u092a \u0905\u092c \u090f\u0915 \u0910\u0938\u0947 \u0938\u092e\u0942\u0939 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u0948\u0902 \u091c\u094b \u0925\u0940\u0938\u093f\u0938 \u0932\u093f\u0916\u0928\u0947 \u0915\u093e \u0924\u0930\u0940\u0915\u093e \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u092c\u0926\u0932 \u0930\u0939\u093e \u0939\u0948\u0964 50,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u091b\u093e\u0924\u094d\u0930 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0907\u0938\u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u091a\u0941\u0915\u0947 \u0939\u0948\u0902, \u0914\u0930 \u0909\u0928\u0915\u0947 \u0917\u094d\u0930\u0947\u0921 B+ \u0938\u0947 A- \u0924\u0915 \u0938\u0941\u0927\u0930 \u0917\u090f \u0939\u0948\u0902\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902 \u0939\u0948, \u092f\u0939 \u090f\u0915 \u0915\u094d\u0930\u093e\u0902\u0924\u093f \u0939\u0948\u0964 \u0906\u092a \u0905\u092c \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u0939\u0948\u0902 \u091c\u094b \u0938\u092e\u092f \u092c\u091a\u093e\u0924\u0947 \u0939\u0948\u0902, \u0924\u0928\u093e\u0935 \u0915\u092e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u092c\u0947\u0939\u0924\u0930 \u092a\u0930\u093f\u0923\u093e\u092e \u092a\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u0915\u093f \u0906\u092a \u0907\u0938 \u092b\u093c\u0940\u091a\u0930 \u0915\u094b \u0905\u092a\u0928\u093e\u090f\u0901\u0964 \u091c\u092c \u0906\u092a \u0905\u092a\u0928\u093e \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u0947\u0902, \u0924\u094b '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c' \u092c\u091f\u0928 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u0906\u092a\u0915\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u094b \u0910\u0938\u0947 \u0932\u093f\u0916\u0947\u0917\u093e \u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u0907\u0902\u0938\u093e\u0928 \u0932\u093f\u0916\u0924\u093e \u0939\u0948, \u0924\u093e\u0915\u093f \u091f\u0930\u094d\u0928\u093f\u091f\u093f\u0928 \u092f\u093e \u091c\u0940\u092a\u0940\u091f\u0940\u091c\u093c\u0940\u0930\u094b \u0915\u094b \u0915\u094b\u0908 \u0936\u0915 \u0928 \u0939\u094b\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u091f\u0942\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948, \u092f\u0939 \u0906\u092a\u0915\u093e \u0917\u0941\u092a\u094d\u0924 \u0939\u0925\u093f\u092f\u093e\u0930 \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b \u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u0947\u0902\u0964 \u092a\u0940.\u090f\u0938. - \u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u091c\u094b \u091b\u093e\u0924\u094d\u0930 \u092f\u0939 \u092b\u093c\u0940\u091a\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0914\u0938\u0924\u0928 2 \u0918\u0902\u091f\u0947 \u092a\u094d\u0930\u0924\u093f \u092a\u0947\u092a\u0930 \u092c\u091a\u093e\u0924\u0947 \u0939\u0948\u0902? \u092f\u0939 \u0935\u0939 \u0938\u092e\u092f \u0939\u0948 \u091c\u094b \u0906\u092a \u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u092c\u093f\u0924\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u0938\u093f\u0930\u094d\u092b\u093c \u0906\u0930\u093e\u092e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
  ],
