{
  "subject": "\u6211\u72af\u4e86\u4e2a\u5927\u9519\uff1a90%\u7528\u6237\u90fd\u6d6a\u8d39\u4e86\u8fd92\u5206\u949f",
  "preview_text": "\u5176\u5b9e\u7528\u8fd9\u4e2a\u529f\u80fd\uff0c20\u5206\u949f\u7684\u8c03\u97f3\u5de5\u4f5c\u73b0\u57282\u5206\u949f\u5c31\u80fd\u641e\u5b9a\u3002\u522b\u518d\u50cf\u6211\u4e00\u6837\u50bb\u50bb\u624b\u52a8\u8c03\u4e86\u3002",
  "body_paragraphs": [
    "\u6211\u5f97\u8ddf\u4f60\u5766\u767d\u4ef6\u4e8b\u3002\u4e4b\u524d\u6bcf\u6b21\u542c\u65b0\u4e13\u8f91\uff0c\u6211\u90fd\u8981\u82b120\u5206\u949f\u53cd\u590d\u8c03EQ\u2014\u2014\u9ad8\u97f3\u62c9\u4e00\u70b9\uff0c\u4f4e\u97f3\u63a8\u4e00\u70b9\uff0c\u6765\u56de\u8bd5\u5230\u8033\u6735\u7d2f\u3002\u4e0a\u5468\u624d\u53d1\u73b0\uff0c\u8fd9\u6839\u672c\u662f\u5728\u6d6a\u8d39\u65f6\u95f4\u3002",
    "\u5176\u5b9e\u4f60\u624b\u673a\u91cc\u5df2\u7ecf\u6709\u4e2a\u2018\u667a\u80fd\u8c03\u97f3\u5e08\u2019\u4e86\u3002\u5b83\u5206\u6790\u4e86\u4e0a\u4e07\u9996\u6b4c\u66f2\u7684\u6570\u636e\uff0c\u77e5\u9053\u6d41\u884c\u4e50\u8be5\u7a81\u51fa\u4eba\u58f0\uff0c\u7535\u5b50\u4e50\u8981\u5f3a\u8c03\u8282\u594f\uff0c\u53e4\u5178\u4e50\u5f97\u4fdd\u6301\u52a8\u6001\u3002\u4f60\u9009\u4e2a\u6b4c\u5355\uff0c\u5b832\u5206\u949f\u5c31\u80fd\u8c03\u51fa\u4e13\u4e1a\u542c\u611f\u3002",
    "\u8fd9\u5c31\u662f\u5185\u7f6e\u7684\u2018\u573a\u666f\u9884\u8bbe\u2019\u529f\u80fd\u3002\u522b\u518d\u53bb\u624b\u52a8\u8c03\u90a312\u4e2a\u9891\u6bb5\u4e86\u3002\u4e0b\u6b21\u542c\u6b4c\u524d\uff0c\u76f4\u63a5\u5728\u5747\u8861\u5668\u91cc\u9009\u2018\u6447\u6eda\u2019\u6216\u2018\u7235\u58eb\u2019\u9884\u8bbe\uff0c\u7cfb\u7edf\u4f1a\u77ac\u95f4\u5339\u914d\u6700\u4f73\u58f0\u573a\u3002",
    "\u73b0\u5728\u5c31\u53bb\u8bd5\u8bd5\uff1a\u6253\u5f00\u4efb\u610f\u6b4c\u5355\uff0c\u9009\u5bf9\u5e94\u7684\u9884\u8bbe\uff0c\u611f\u53d72\u5206\u949f\u641e\u5b9a\u4e00\u5207\u7684\u723d\u5feb\u3002P.S. \u8ba2\u9605\u7528\u6237\u8fd8\u80fd\u89e3\u9501\u81ea\u5b9a\u4e49\u9884\u8bbe\uff0c\u628a\u4f60\u8c03\u597d\u7684\u8bbe\u7f6e\u5b58\u6210\u2018\u901a\u52e4\u6a21\u5f0f\u2019\u6216\u2018\u5065\u8eab\u623f\u4e13\u5c5e\u2019\uff0c\u4e0b\u6b21\u4e00\u70b9\u5373\u7528\u3002"
  ],
