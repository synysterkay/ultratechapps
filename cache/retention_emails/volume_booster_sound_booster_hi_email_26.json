{
  "subject": "\u090f\u0915 \u0917\u0932\u0924\u0940 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0915\u0940, \u0914\u0930 \u090f\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u091c\u093f\u0938\u0947 \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902",
  "preview_text": "\u0906\u092a\u0915\u0947 \u092b\u093c\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u090f\u0915 \u0915\u0928\u094d\u092b\u0947\u0936\u0928\u0964 \u0914\u0930 \u0935\u094b \u090f\u0915 \u0907\u0902\u0938\u093e\u0928 \u091c\u093f\u0938\u0947 \u0907\u0938\u0915\u0940 \u0938\u092c\u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u091c\u093c\u0930\u0942\u0930\u0924 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u0938\u091a \u092c\u0924\u093e\u090a\u0902? \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u092c\u0921\u093c\u0940 \u0917\u0932\u0924\u0940 \u0915\u0940\u0964 \u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0910\u092a \u0938\u093f\u0930\u094d\u092b\u093c \u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u0930\u0916 \u0932\u093f\u092f\u093e\u0964 \u092e\u0939\u0940\u0928\u094b\u0902 \u0924\u0915 \u092f\u0939\u0940 \u0938\u094b\u091a\u0924\u093e \u0930\u0939\u093e \u0915\u093f \u092f\u0939 \u092e\u0947\u0930\u0940 \u092a\u0930\u094d\u0938\u0928\u0932 \u0939\u0948\u0915 \u0939\u0948, \u092e\u0947\u0930\u093e \u091b\u0941\u092a\u093e \u0939\u0941\u0906 \u0938\u0940\u0915\u094d\u0930\u0947\u091f\u0964 \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u0915\u0932 \u0930\u093e\u0924 \u0915\u0941\u091b \u0939\u0941\u0906\u0964",
    "\u092e\u0947\u0930\u0947 \u0926\u094b\u0938\u094d\u0924 \u0915\u0940 \u092a\u0941\u0930\u093e\u0928\u0940 \u0935\u093e\u0932\u0940 \u0915\u093e\u0930 \u092e\u0947\u0902 \u092c\u0948\u0920\u093e \u0925\u093e\u0964 \u0909\u0938\u0915\u093e \u0938\u094d\u092a\u0940\u0915\u0930 \u092b\u091f\u093e \u0939\u0941\u0906 \u0925\u093e, \u092c\u0947\u0938 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0928\u0939\u0940\u0902 \u0925\u093e\u0964 \u0909\u0938\u0928\u0947 \u0917\u093e\u0928\u093e \u0932\u0917\u093e\u092f\u093e \u0914\u0930 \u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0935\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u092b\u094d\u0930\u0938\u094d\u091f\u094d\u0930\u0947\u091f\u0947\u0921 \u0939\u0948\u0964 \u0909\u0938\u0915\u0940 \u0906\u0901\u0916\u094b\u0902 \u092e\u0947\u0902 \u0935\u0939\u0940 \u0928\u093f\u0930\u093e\u0936\u093e \u0925\u0940 \u091c\u094b \u0936\u093e\u092f\u0926 \u0906\u092a\u0915\u0940 \u092d\u0940 \u0925\u0940 \u091c\u092c \u0906\u092a\u0928\u0947 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u092f\u0939 \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u0924\u092d\u0940 \u0916\u094d\u092f\u093e\u0932 \u0906\u092f\u093e - \u092f\u093e\u0930, \u0907\u0938\u0940 \u0915\u0947 \u0932\u093f\u090f \u0924\u094b \u092f\u0939 \u092c\u0928\u093e \u0939\u0948\u0964",
    "\u092e\u0948\u0902\u0928\u0947 \u0909\u0938\u0947 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u092c\u0942\u0938\u094d\u091f \u092c\u091f\u0928 \u0926\u093f\u0916\u093e\u092f\u093e, \u0914\u0930 \u092b\u093f\u0930 \u092c\u0947\u0938 \u092c\u0942\u0938\u094d\u091f\u0930 \u091a\u093e\u0932\u0942 \u0915\u093f\u092f\u093e\u0964 \u0909\u0938\u0915\u093e \u091a\u0947\u0939\u0930\u093e \u092c\u0926\u0932 \u0917\u092f\u093e\u0964 \u092c\u094b\u0932\u093e, '\u0905\u0930\u0947, \u092f\u0947 \u0924\u094b \u0935\u0939\u0940 \u0906\u0935\u093e\u091c\u093c \u0939\u0948 \u091c\u094b \u092e\u0948\u0902 \u0938\u093e\u0932\u094b\u0902 \u0938\u0947 \u0922\u0942\u0902\u0922 \u0930\u0939\u093e \u0925\u093e\u0964' \u0909\u0938 \u090f\u0915 \u0936\u0947\u092f\u0930 \u0928\u0947 \u0909\u0938\u0915\u0940 \u0939\u0930 \u0921\u094d\u0930\u093e\u0907\u0935 \u0915\u094b \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964 \u0914\u0930 \u092e\u0941\u091d\u0947 \u090f\u0939\u0938\u093e\u0938 \u0939\u0941\u0906 - \u0939\u0930 \u0915\u093f\u0938\u0940 \u0915\u0947 \u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u090f\u0915 \u0910\u0938\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0939\u094b\u0924\u093e \u0939\u0948 \u091c\u094b \u0907\u0938 '\u0938\u0940\u0915\u094d\u0930\u0947\u091f' \u0915\u093e \u0939\u0915\u0926\u093e\u0930 \u0939\u0948\u0964",
    "\u0906\u092a\u0915\u0947 \u0926\u093f\u092e\u093e\u0917 \u092e\u0947\u0902 \u0905\u092d\u0940 \u090f\u0915 \u0928\u093e\u092e \u0906\u092f\u093e, \u0939\u0948 \u0928\u093e? \u0935\u094b \u0926\u094b\u0938\u094d\u0924 \u091c\u093f\u0938\u0915\u093e \u0938\u094d\u092a\u0940\u0915\u0930 \u0916\u0930\u093e\u092c \u0939\u0948, \u0935\u094b \u092a\u093e\u092a\u093e \u091c\u094b \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0928\u0939\u0940\u0902 \u0938\u0941\u0928 \u092a\u093e\u0924\u0947, \u0935\u094b \u092d\u093e\u0908 \u091c\u094b \u092b\u093c\u093f\u0932\u094d\u092e\u0947\u0902 \u0926\u0947\u0916\u0924\u0947 \u0938\u092e\u092f \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0938\u0947 \u092a\u0930\u0947\u0936\u093e\u0928 \u0930\u0939\u0924\u093e \u0939\u0948\u0964 \u0909\u0928\u094d\u0939\u0947\u0902 \u092c\u0938 \u090f\u0915 \u0932\u093f\u0902\u0915 \u092d\u0947\u091c\u0928\u0947 \u0915\u0940 \u0926\u0947\u0930 \u0939\u0948\u0964 \u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u093f\u090f, \u0914\u0930 '\u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0915\u094b \u0906\u092e\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0947\u0902' \u0935\u093e\u0932\u093e \u0911\u092a\u094d\u0936\u0928 \u091f\u0948\u092a \u0915\u0940\u091c\u093f\u090f\u0964 \u090f\u0915 \u0936\u0947\u092f\u0930 \u0938\u0947 \u0915\u093f\u0938\u0940 \u0915\u093e \u092a\u0942\u0930\u093e \u0911\u0921\u093f\u092f\u094b \u0905\u0928\u0941\u092d\u0935 \u092c\u0926\u0932 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 P.S. \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u0940 \u092c\u093e\u0924? \u091c\u092c \u0935\u0939 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0917\u093e, \u0906\u092a\u0915\u094b \u092d\u0940 \u090f\u0915\u094d\u0938\u094d\u091f\u094d\u0930\u093e \u092c\u0942\u0938\u094d\u091f \u0921\u0947\u091c\u093c \u092e\u093f\u0932\u0947\u0902\u0917\u0947\u0964 \u0930\u093f\u0938\u093f\u092a\u094d\u0930\u094b\u0938\u093f\u091f\u0940, \u092f\u093e\u0930\u0964"
  ],
  "cta_text": "\u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0926\u094b\u0938\u094d\u0924 \u0915\u094b \u0906\u092e\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0947\u0902",
