{
  "subject": "\u0421\u0435\u043a\u0440\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 90% \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0432 \u0444\u0430\u043d\u0430\u0442\u043e\u0432",
  "preview_text": "\u042d\u0442\u043e \u0437\u0430\u0439\u043c\u0435\u0442 3 \u043c\u0438\u043d\u0443\u0442\u044b. \u041d\u043e \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u0432\u0430\u0448 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0431\u0443\u0434\u0435\u0442 \u0437\u0432\u0443\u0447\u0430\u0442\u044c \u043a\u0430\u043a \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u0440\u0430\u043d\u044c\u0448\u0435. \u041f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043e.",
  "body_paragraphs": [
    "\u041f\u0440\u0438\u0432\u0435\u0442. \u0423 \u043c\u0435\u043d\u044f \u0434\u043b\u044f \u0442\u0435\u0431\u044f \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435. \u041f\u0435\u0440\u0432\u044b\u0435 \u043f\u0430\u0440\u0443 \u043d\u0435\u0434\u0435\u043b\u044c \u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f \u043d\u0430\u0448\u0438\u043c \u0431\u0443\u0441\u0442\u0435\u0440\u043e\u043c \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e. \u041f\u0440\u043e\u0441\u0442\u043e \u0432\u043a\u043b\u044e\u0447\u0430\u043b \u0438 \u0441\u043b\u0443\u0448\u0430\u043b. \u0418 \u0434\u0443\u043c\u0430\u043b, \u0447\u0442\u043e \u044d\u0442\u043e \u043a\u0440\u0443\u0442\u043e. \u041f\u043e\u043a\u0430 \u043d\u0435 \u043d\u0430\u0442\u043a\u043d\u0443\u043b\u0441\u044f \u043d\u0430 \u043e\u0434\u0438\u043d \u0442\u0440\u044e\u043a.",
    "\u0412\u0441\u044f \u043c\u0430\u0433\u0438\u044f \u2014 \u0432 \u0440\u0438\u0442\u0443\u0430\u043b\u0435. \u041d\u0435 \u0432 \u0440\u0430\u0437\u043e\u0432\u043e\u043c \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0438, \u0430 \u0432 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0435. \u0412\u0441\u0435\u0433\u043e 3 \u043c\u0438\u043d\u0443\u0442\u044b \u0443\u0442\u0440\u043e\u043c \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0434 \u0432\u0435\u0447\u0435\u0440\u043d\u0438\u043c \u0441\u0435\u0430\u043d\u0441\u043e\u043c \u043c\u0443\u0437\u044b\u043a\u0438. \u0417\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0448\u044c \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0448\u044c \u043f\u0440\u0435\u0441\u0435\u0442 \u043f\u043e\u0434 \u0441\u0432\u043e\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u043a\u043e\u043d\u0442\u0435\u043d\u0442, \u0438 \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0448\u044c \u043e\u0434\u0438\u043d \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440\u0430 \u043f\u043e\u0434 \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0438\u0439 \u0442\u0440\u0435\u043a. \u042d\u0442\u043e \u043a\u0430\u043a \u0440\u0430\u0437\u043c\u0438\u043d\u043a\u0430 \u0434\u043b\u044f \u0443\u0448\u0435\u0439. \u041f\u043e\u0441\u043b\u0435 \u043d\u0435\u0434\u0435\u043b\u0438 \u0442\u0430\u043a\u043e\u0433\u043e \u0440\u0438\u0442\u0443\u0430\u043b\u0430 \u0442\u044b \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0448\u044c \u0441\u043b\u044b\u0448\u0430\u0442\u044c \u043d\u044e\u0430\u043d\u0441\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0440\u0430\u043d\u044c\u0448\u0435 \u043d\u0435 \u0437\u0430\u043c\u0435\u0447\u0430\u043b. \u041c\u0443\u0437\u044b\u043a\u0430 \u043e\u0436\u0438\u0432\u0430\u0435\u0442 \u043f\u043e-\u043d\u043e\u0432\u043e\u043c\u0443 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c.",
    "\u042d\u0442\u043e\u0442 \u0440\u0438\u0442\u0443\u0430\u043b \u0437\u0430\u0432\u044f\u0437\u0430\u043d \u043d\u0430 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440\u0435. \u041d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u0431\u0440\u0430\u0442\u044c '\u0420\u043e\u043a' \u0438 \u0437\u0430\u0431\u044b\u0442\u044c. \u0410 \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u0442\u044c \u044d\u0442\u0438 3 \u043c\u0438\u043d\u0443\u0442\u044b, \u0447\u0442\u043e\u0431\u044b '\u043f\u043e\u0434\u043e\u0433\u043d\u0430\u0442\u044c' \u0437\u0432\u0443\u043a \u043f\u043e\u0434 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0439 \u0442\u0440\u0435\u043a, \u043f\u043e\u0434 \u0448\u0443\u043c \u0432\u043e\u043a\u0440\u0443\u0433 \u0442\u0435\u0431\u044f, \u043f\u043e\u0434 \u0442\u0432\u043e\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438. \u0421\u0435\u043a\u0440\u0435\u0442 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u0442\u0432\u043e\u0438 \u0443\u0448\u0438 \u0438 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b. \u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0439 \u043f\u0440\u0435\u0441\u0435\u0442 \u2014 \u044d\u0442\u043e \u0431\u0430\u0437\u0430. \u0410 \u0442\u0432\u043e\u044f \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0430\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u043a\u0430 \u2014 \u044d\u0442\u043e \u043a\u043b\u044e\u0447 \u043a \u0437\u0432\u0443\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u0443\u0434\u0435\u0442 \u0440\u0435\u0437\u0430\u0442\u044c \u0442\u043e\u0447\u043d\u043e \u0432 \u0446\u0435\u043b\u044c.",
    "\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u044d\u0442\u043e\u0442 \u0440\u0438\u0442\u0443\u0430\u043b \u0441\u0435\u0433\u043e\u0434\u043d\u044f. \u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0432\u044b\u0431\u0435\u0440\u0438 \u043b\u044e\u0431\u043e\u0439 \u0442\u0440\u0435\u043a \u0438 \u043f\u0440\u043e\u0432\u0435\u0434\u0438 3 \u043c\u0438\u043d\u0443\u0442\u044b \u0441 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440\u043e\u043c. \u0421\u0434\u0432\u0438\u043d\u044c \u043e\u0434\u0438\u043d \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a. \u041f\u043e\u0441\u043b\u0443\u0448\u0430\u0439 \u0440\u0430\u0437\u043d\u0438\u0446\u0443. \u042d\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u0442 \u0442\u0432\u043e\u0435 \u0432\u043e\u0441\u043f\u0440\u0438\u044f\u0442\u0438\u0435. P.S. \u0418\u043c\u0435\u043d\u043d\u043e \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u0440\u0438\u0442\u0443\u0430\u043b\u0430 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442, \u0437\u0430\u0447\u0435\u043c \u043d\u0443\u0436\u0435\u043d Premium \u0441 \u0435\u0433\u043e \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u0442\u044b\u043c \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c. \u041d\u043e \u0434\u0430\u0436\u0435 \u043d\u0430 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u044d\u0442\u0438 3 \u043c\u0438\u043d\u0443\u0442\u044b \u0442\u0432\u043e\u0440\u044f\u0442 \u0447\u0443\u0434\u0435\u0441\u0430.",
    "\u041e\u0442\u043a\u0440\u044b\u0442\u044c Volume Booster"
  ],
