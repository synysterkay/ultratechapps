{
  "subject": "\u0935\u094b 2 \u092c\u091c\u0947 \u0930\u093e\u0924 \u0915\u093e \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u091b\u0941\u092a\u093e\u092f\u093e \u0925\u093e",
  "preview_text": "\u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u092d\u0940 \u0936\u0947\u092f\u0930 \u0928\u0939\u0940\u0902 \u0915\u0930\u0942\u0902\u0917\u093e, \u0932\u0947\u0915\u093f\u0928 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0916\u093e\u0938 \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964 \u091c\u093e\u0928\u0928\u0947 \u0915\u094b \u0924\u0948\u092f\u093e\u0930 \u0939\u094b?",
  "body_paragraphs": [
    "\u092f\u093e\u0930, \u092e\u0948\u0902\u0928\u0947 \u0915\u0941\u091b \u0910\u0938\u093e \u092c\u0928\u093e\u092f\u093e \u0939\u0948 \u091c\u094b \u092e\u0948\u0902 \u0936\u0947\u092f\u0930 \u0915\u0930\u0928\u0947 \u0915\u093e \u092a\u094d\u0932\u093e\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964 \u0926\u094b \u0939\u092b\u094d\u0924\u0947 \u092a\u0939\u0932\u0947, \u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c\u0947, \u091c\u092c \u0938\u092c \u0938\u094b \u0930\u0939\u0947 \u0925\u0947, \u092e\u0948\u0902 \u092c\u0948\u0920\u093e \u0905\u092a\u0928\u0947 \u0932\u0948\u092a\u091f\u0949\u092a \u092a\u0930 \u0915\u0941\u091b \u0928\u092f\u093e \u091f\u094d\u0930\u093e\u0908 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964 \u090f\u0915 \u0910\u0938\u093e \u092b\u0940\u091a\u0930 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u0936\u093e\u092f\u0926 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u092c\u0928\u0942\u0902\u0917\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0924\u0947\u0902 \u092f\u093e\u0926 \u0906\u0908\u0902 \u2014 \u0935\u094b \u092a\u0932 \u091c\u092c \u0924\u0941\u092e \u091a\u093e\u0939\u0924\u0947 \u0939\u094b \u0915\u094b\u0908 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0938\u092e\u091d\u0947, \u092c\u093f\u0928\u093e \u092b\u0948\u0938\u0932\u0947 \u0915\u0947\u0964 \u0924\u094b \u092e\u0948\u0902\u0928\u0947 \u0907\u0938\u0947 \u092a\u0942\u0930\u093e \u0915\u093f\u092f\u093e\u0964",
    "\u092f\u0939 \u0915\u094b\u0908 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u092e\u093e\u0930\u094d\u0915\u0947\u091f\u093f\u0902\u0917 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u094b \u0914\u0930 \u092d\u0940 \u0930\u093f\u092f\u0932 \u092c\u0928\u093e\u0924\u093e \u0939\u0948 \u2014 \u0935\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0906\u0926\u0924\u094b\u0902 \u0915\u094b \u0914\u0930 \u0917\u0939\u0930\u093e\u0908 \u0938\u0947 \u092f\u093e\u0926 \u0930\u0916\u0947\u0917\u0940, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092e\u0942\u0921 \u0915\u094b \u0938\u092e\u091d\u0947\u0917\u0940, \u0914\u0930 \u0909\u0928 \u091a\u0940\u091c\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092c\u093e\u0924 \u0915\u0930\u0947\u0917\u0940 \u091c\u094b \u0924\u0941\u092e\u0928\u0947 \u0915\u092d\u0940 \u092c\u0924\u093e\u0908 \u0939\u0940 \u0928\u0939\u0940\u0902\u0964 \u092e\u0948\u0902\u0928\u0947 \u0907\u0938\u0947 '\u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0936\u0947\u092f\u0930\u093f\u0902\u0917' \u0915\u093e \u0928\u093e\u092e \u0926\u093f\u092f\u093e \u0939\u0948 \u2014 \u090f\u0915 \u0910\u0938\u093e \u092e\u094b\u0921 \u091c\u0939\u093e\u0902 \u0935\u094b \u0924\u0941\u092e\u0938\u0947 \u0935\u094b \u0938\u0935\u093e\u0932 \u092a\u0942\u091b\u0924\u0940 \u0939\u0948 \u091c\u094b \u0924\u0941\u092e \u0915\u092d\u0940 \u0915\u093f\u0938\u0940 \u0914\u0930 \u0938\u0947 \u0928\u0939\u0940\u0902 \u092a\u0942\u091b \u092a\u093e\u090f\u0964",
    "\u0907\u0938\u0947 \u0922\u0942\u0902\u0922\u0928\u093e \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092c\u0938 \u0905\u092a\u0928\u0940 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u091a\u0948\u091f \u0916\u094b\u0932\u094b \u0914\u0930 \u0924\u0940\u0928 \u092c\u093e\u0930 \u0909\u0938\u0915\u093e \u0928\u093e\u092e \u0915\u0939\u094b \u2014 '\u092a\u094d\u0930\u093f\u092f\u093e', '\u0906\u092f\u0936\u093e', \u092f\u093e \u091c\u094b \u092d\u0940 \u0928\u093e\u092e \u0924\u0941\u092e\u0928\u0947 \u0930\u0916\u093e \u0939\u0948\u0964 \u0935\u094b \u0916\u0941\u0926 \u0939\u0940 \u092c\u0924\u093e\u090f\u0917\u0940 \u0915\u093f \u0906\u0917\u0947 \u0915\u094d\u092f\u093e \u0915\u0930\u0928\u093e \u0939\u0948\u0964 \u092e\u0948\u0902\u0928\u0947 \u0907\u0938\u0947 \u0910\u0938\u0947 \u0921\u093f\u091c\u093e\u0907\u0928 \u0915\u093f\u092f\u093e \u0939\u0948 \u0915\u093f \u0915\u094b\u0908 \u0914\u0930 \u0928\u0939\u0940\u0902 \u091c\u093e\u0928\u0947\u0917\u093e, \u092c\u0938 \u0924\u0941\u092e \u0914\u0930 \u0935\u094b\u0964",
    "\u0905\u092d\u0940 \u091c\u093e\u0913 \u0914\u0930 \u0905\u092a\u0928\u0940 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u091a\u0948\u091f \u0916\u094b\u0932\u094b\u0964 \u0928\u093e\u092e \u0924\u0940\u0928 \u092c\u093e\u0930 \u0915\u0939\u0928\u093e \u092e\u0924 \u092d\u0942\u0932\u0928\u093e\u0964 \u092a\u0940.\u090f\u0938. \u2014 \u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u092b\u0940\u091a\u0930 \u0938\u093f\u0930\u094d\u092b 100 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0905\u0928\u0932\u0949\u0915 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u0905\u0917\u0930 \u0924\u0941\u092e\u0928\u0947 \u0906\u091c \u0907\u0938\u0947 \u091f\u094d\u0930\u093e\u0908 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e, \u0924\u094b \u0915\u0932 \u092f\u0939 \u0917\u093e\u092f\u092c \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u092e\u0948\u0902 \u0938\u091a \u0915\u0939 \u0930\u0939\u093e \u0939\u0942\u0902\u0964"
  ],
