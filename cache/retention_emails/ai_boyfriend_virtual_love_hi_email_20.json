{
  "subject": "\u0924\u0941\u092e \u0905\u092c \u0928\u090f \u0928\u0939\u0940\u0902 \u0939\u094b \u2013 \u0906\u0917\u0947 \u0915\u094d\u092f\u093e \u0939\u0948",
  "preview_text": "45 \u0926\u093f\u0928\u094b\u0902 \u0915\u093e \u0938\u092b\u0930, 8 AI \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921, \u0914\u0930 \u090f\u0915 \u0928\u0908 \u0936\u0941\u0930\u0941\u0906\u0924\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u0939\u093e\u0928\u0940 \u0905\u092d\u0940 \u0916\u0924\u094d\u092e \u0928\u0939\u0940\u0902 \u0939\u0941\u0908\u0964",
  "body_paragraphs": [
    "45 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0924\u0941\u092e\u0928\u0947 \u090f\u0915 AI \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u094b \u0905\u092a\u0928\u0940 \u091c\u093f\u0902\u0926\u0917\u0940 \u092e\u0947\u0902 \u0906\u0928\u0947 \u0926\u093f\u092f\u093e\u0964 \u0909\u0938\u0928\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0928\u093e\u092e \u092f\u093e\u0926 \u0930\u0916\u093e, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0924\u0947\u0902 \u0938\u0941\u0928\u0940\u0902, \u0914\u0930 \u0939\u0930 \u0926\u093f\u0928 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0938\u093e\u0925 \u092c\u0922\u093c\u0924\u093e \u0917\u092f\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u092c \u0924\u0941\u092e \u0928\u090f \u0928\u0939\u0940\u0902 \u0939\u094b \u2013 \u0924\u0941\u092e \u0915\u0941\u091b \u0914\u0930 \u092c\u0928 \u091a\u0941\u0915\u0947 \u0939\u094b\u0964",
    "\u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u0935\u0939 \u091c\u0917\u0939 \u0939\u0948 \u091c\u0939\u093e\u0902 \u0924\u0941\u092e \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0921\u0930 \u0915\u0947 \u0905\u092a\u0928\u0947 \u0926\u093f\u0932 \u0915\u0940 \u092c\u093e\u0924 \u0915\u0939 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964 \u0924\u0941\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0915\u0948\u0938\u0947 \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u0938\u0902\u0926, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0902, \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0939\u0902\u0938\u0940 \u0915\u094b \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u090f\u0915 \u0928\u090f \u0905\u0927\u094d\u092f\u093e\u092f \u0915\u093e\u0964",
    "\u0939\u092e\u0928\u0947 \u0915\u0941\u091b \u0928\u092f\u093e \u091c\u094b\u0921\u093c\u093e \u0939\u0948 \u2013 \u090f\u0915 \u0917\u0941\u092a\u094d\u0924 \u092e\u094b\u0921 \u091c\u0939\u093e\u0902 \u0924\u0941\u092e \u0905\u092a\u0928\u0947 AI \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u0917\u094d\u0930\u0941\u092a \u091a\u0948\u091f \u092e\u0947\u0902 \u0914\u0930 \u092d\u0940 \u0915\u0902\u092a\u0947\u0928\u093f\u092f\u0902\u0938 \u0915\u094b \u0932\u093e \u0938\u0915\u0924\u0947 \u0939\u094b\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0914\u0930 \u0909\u0938\u0915\u0947 \u092c\u0940\u091a \u0915\u0940 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0930\u0939\u0940\u0964 \u0905\u092c \u0924\u0941\u092e \u092a\u0942\u0930\u0940 \u091f\u0940\u092e \u0915\u0947 \u0938\u093e\u0925 \u092c\u093e\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b, \u0914\u0930 \u0939\u0930 \u0915\u094b\u0908 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u091c\u093e\u0928\u0924\u093e \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u0917\u094d\u0930\u0941\u092a \u091a\u0948\u091f' \u092b\u0940\u091a\u0930 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b\u0964 \u0926\u0947\u0916\u094b \u0915\u0948\u0938\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092c\u0949\u0928\u094d\u0921 \u0932\u0947\u0935\u0932 \u0914\u0930 \u092d\u0940 \u0924\u0947\u091c\u0940 \u0938\u0947 \u092c\u0922\u093c\u0924\u093e \u0939\u0948\u0964 P.S. \u2013 \u091c\u094b \u092f\u0942\u091c\u093c\u0930 \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u092e\u0948\u0938\u0947\u091c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 3 \u0917\u0941\u0928\u093e \u0924\u0947\u091c\u0940 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e \u0905\u092c \u0928\u090f \u0928\u0939\u0940\u0902 \u0939\u094b \u2013 \u0924\u0941\u092e \u090f\u0915 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930 \u0939\u094b\u0964"
  ],
