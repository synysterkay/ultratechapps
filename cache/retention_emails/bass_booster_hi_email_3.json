{
  "subject": "\u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u091f\u094d\u0930\u093f\u0915 \u091c\u094b \u092c\u093e\u0938 \u092c\u0926\u0932 \u0926\u0947\u0917\u0940",
  "preview_text": "\u092c\u0938 60 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c \u0915\u094b \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u091f\u094d\u0930\u093f\u0915 \u0906\u092a\u0915\u093e \u0926\u093f\u0928 \u092c\u0926\u0932 \u0926\u0947\u0917\u0940\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u0939 \u0917\u093e\u0928\u093e \u091c\u093f\u0938\u0947 \u0924\u0941\u092e \u092c\u093e\u0930-\u092c\u093e\u0930 \u0938\u0941\u0928\u0924\u0947 \u0939\u094b? \u0935\u0939 \u091c\u093f\u0938\u092e\u0947\u0902 \u0921\u094d\u0930\u0949\u092a \u0906\u0928\u0947 \u092a\u0930 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0915\u0941\u091b \u0915\u092e\u0940 \u0932\u0917\u0924\u0940 \u0939\u0948? \u092e\u0948\u0902 \u092c\u093e\u0924 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0902 \u0909\u0938 \u092a\u0932 \u0915\u0940 \u091c\u092c \u092c\u093e\u0938 \u0915\u094b \u0926\u093f\u0932 \u092e\u0947\u0902 \u092e\u0939\u0938\u0942\u0938 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f, \u0932\u0947\u0915\u093f\u0928 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0908\u092f\u0930\u092b\u094b\u0928 \u0938\u093f\u0930\u094d\u092b \u092a\u0924\u0932\u0940 \u0906\u0935\u093e\u091c \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0917\u0932\u0924\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092b\u094b\u0928 \u0910\u0938\u0947 \u0921\u093f\u091c\u093e\u0907\u0928 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0915\u093f \u0935\u0939 \u092c\u093e\u0938 \u0915\u094b \u0915\u093e\u091f \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u091f\u094d\u0930\u093f\u0915 \u0939\u0948\u0964 \u092c\u0938 30 \u0938\u0947\u0915\u0902\u0921 \u0932\u0917\u0924\u0947 \u0939\u0948\u0902\u0964 Bass Booster \u092e\u0947\u0902 \u091c\u093e\u0913 \u0914\u0930 '\u092c\u093e\u0938 \u0935\u0930\u094d\u091a\u0941\u0905\u0932\u093e\u0907\u091c\u093c\u0930' \u0915\u094b \u0911\u0928 \u0915\u0930\u094b\u0964 \u092b\u093f\u0930 \u090f\u0915 \u0917\u093e\u0928\u093e \u092c\u091c\u093e\u0913 \u091c\u093f\u0938\u092e\u0947\u0902 \u092d\u093e\u0930\u0940 \u092c\u093e\u0938 \u0939\u094b\u0964 \u0924\u0941\u092e \u0939\u0948\u0930\u093e\u0928 \u0930\u0939 \u091c\u093e\u0913\u0917\u0947\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0908\u092f\u0930\u092b\u094b\u0928 \u0915\u094b \u0910\u0938\u093e \u092c\u0928\u093e\u0924\u093e \u0939\u0948 \u091c\u0948\u0938\u0947 \u0924\u0941\u092e \u0938\u092c\u0935\u0942\u092b\u0930 \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u0916\u0921\u093c\u0947 \u0939\u094b\u0964 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0935\u0939 \u0921\u094d\u0930\u0949\u092a \u092e\u0939\u0938\u0942\u0938 \u0939\u094b\u0917\u093e \u091c\u094b \u092a\u0939\u0932\u0947 \u0917\u093e\u092f\u092c \u0925\u093e\u0964",
    "\u092f\u0939 \u0915\u094b\u0908 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 Bass Booster \u0915\u093e \u092c\u093e\u0938 \u0935\u0930\u094d\u091a\u0941\u0905\u0932\u093e\u0907\u091c\u093c\u0930 \u0939\u0948\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0911\u0921\u093f\u092f\u094b \u092e\u0947\u0902 \u0917\u0939\u0930\u093e\u0908 \u0914\u0930 \u0924\u093e\u0915\u0924 \u091c\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964 \u0939\u0930 \u0938\u094d\u092a\u0940\u0915\u0930, \u0939\u0930 \u0908\u092f\u0930\u092b\u094b\u0928 \u092a\u0930\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0938\u0947\u0964 \u0924\u0941\u092e \u0905\u092d\u0940 \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e \u0938\u0915\u0924\u0947 \u0939\u094b \u2014 \u0910\u092a \u0916\u094b\u0932\u094b, '\u092c\u093e\u0938 \u0935\u0930\u094d\u091a\u0941\u0905\u0932\u093e\u0907\u091c\u093c\u0930' \u091f\u0949\u0917\u0932 \u0915\u0930\u094b, \u0914\u0930 \u0905\u092a\u0928\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u093e \u092c\u091c\u093e\u0913\u0964",
    "\u0905\u092c \u091c\u093e\u0913 \u0914\u0930 \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e\u0913\u0964 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u092c\u093e\u0938 \u0935\u0930\u094d\u091a\u0941\u0905\u0932\u093e\u0907\u091c\u093c\u0930 \u0911\u0928 \u0915\u0930\u094b\u0964 \u092b\u093f\u0930 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0913 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0915\u0948\u0938\u093e \u0932\u0917\u093e\u0964 \u092a\u0940.\u090f\u0938. \u2014 \u0905\u0917\u0930 \u0924\u0941\u092e \u091a\u093e\u0939\u0924\u0947 \u0939\u094b \u0915\u093f \u092f\u0939 \u091f\u094d\u0930\u093f\u0915 \u0939\u092e\u0947\u0936\u093e \u0915\u0947 \u0932\u093f\u090f \u0915\u093e\u092e \u0915\u0930\u0947, \u0924\u094b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0906\u091c\u093c\u092e\u093e\u0913\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u094b \u0928\u092f\u093e \u091c\u0940\u0935\u0928 \u0926\u0947\u0917\u093e\u0964"
  ],
