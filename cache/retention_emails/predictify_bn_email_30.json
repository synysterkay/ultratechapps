{
  "subject": "\u0986\u09aa\u09a8\u09bf \u0986\u09b8\u09b2\u09c7 \u0995\u09c7 \u09a4\u09be \u099c\u09be\u09a8\u09a4\u09c7 \u099a\u09be\u09a8?",
  "preview_text": "Predictify \u09b6\u09c1\u09a7\u09c1 \u0985\u09cd\u09af\u09be\u09aa \u09a8\u09af\u09bc, \u098f\u099f\u09be \u098f\u0995\u099f\u09be \u09ae\u09bf\u09b6\u09a8\u0964 \u0986\u09aa\u09a8\u09bf \u098f\u09b0 \u0985\u0982\u09b6 \u0995\u09bf\u09a8\u09be \u09a4\u09be \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09a3 \u0995\u09b0\u099b\u09c7 \u098f\u0987 \u09ac\u09be\u09b0\u09cd\u09a4\u09be\u0964",
  "body_paragraphs": [
    "\u0986\u09aa\u09a8\u09bf \u09b9\u09af\u09bc\u09a4\u09cb \u09ad\u09be\u09ac\u099b\u09c7\u09a8, \u098f\u0987 \u0987\u09ae\u09c7\u0987\u09b2 \u0995\u09c7\u09a8 \u0986\u09b8\u099b\u09c7? \u09ed\u09e6 \u09a6\u09bf\u09a8 \u0986\u0997\u09c7 \u0986\u09aa\u09a8\u09bf Predictify \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09c7\u099b\u09bf\u09b2\u09c7\u09a8, \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09a4\u09be\u09b0 \u09ae\u09be\u09a8\u09c7 \u098f\u0987 \u09a8\u09af\u09bc \u09af\u09c7 \u0986\u09aa\u09a8\u09bf \u09b6\u09c1\u09a7\u09c1 \u098f\u0995\u099c\u09a8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u0964 \u0986\u09ae\u09bf \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u09ac\u09b2\u09bf\u2014\u0986\u09aa\u09a8\u09bf \u098f\u0996\u09a8 \u09ab\u09c1\u099f\u09ac\u09b2 \u099c\u09cd\u099e\u09be\u09a8\u09c7\u09b0 \u098f\u0995 \u09a8\u09a4\u09c1\u09a8 \u09af\u09c1\u0997\u09c7\u09b0 \u0985\u0982\u09b6\u0964",
    "\u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u09aa\u09bf\u099b\u09a8\u09c7 \u09b9\u09be\u099c\u09be\u09b0\u09cb \u09a1\u09c7\u099f\u09be \u09b0\u09af\u09bc\u09c7\u099b\u09c7, \u09af\u09be AI \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09a0\u09bf\u0995 \u09aa\u09c2\u09b0\u09cd\u09ac\u09be\u09ad\u09be\u09b8 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c7\u0964 \u0986\u09aa\u09a8\u09bf \u0995\u09bf \u099c\u09be\u09a8\u09c7\u09a8, \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0995\u09ae\u09bf\u0989\u09a8\u09bf\u099f\u09bf\u09a4\u09c7 \u09af\u09be\u09b0\u09be \u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09bf\u09a8 \u09b2\u0997\u0987\u09a8 \u0995\u09b0\u09c7, \u09a4\u09be\u09a6\u09c7\u09b0 \u09ad\u09ac\u09bf\u09b7\u09cd\u09af\u09a6\u09cd\u09ac\u09be\u09a3\u09c0\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ad\u09c1\u09b2\u09a4\u09be \u09e9\u09e6% \u09ac\u09c7\u09b6\u09bf? \u098f\u099f\u09be \u09b6\u09c1\u09a7\u09c1 \u0997\u09c1\u09a1 \u09b2\u09be\u0995 \u09a8\u09af\u09bc\u2014\u098f\u099f\u09be \u09a1\u09c7\u099f\u09be\u0964 \u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u09a1\u09c7\u099f\u09be \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7\u09a8, \u09a4\u09be\u09b9\u09b2\u09c7 \u0986\u09aa\u09a8\u09bf \u0995\u09c7\u09ac\u09b2 \u09ad\u0995\u09cd\u09a4 \u09a8\u09a8, \u0986\u09aa\u09a8\u09bf \u098f\u0995\u099c\u09a8 \u09b8\u09cd\u099f\u09cd\u09b0\u09cd\u09af\u09be\u099f\u09c7\u099c\u09bf\u09b8\u09cd\u099f\u0964",
    "Predictify-\u09a4\u09c7 \u098f\u0995\u099f\u09bf \u0997\u09cb\u09aa\u09a8 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af \u0986\u099b\u09c7 \u09af\u09be \u09ef\u09e6% \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0 \u098f\u09a1\u09bc\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09af\u09bc: '\u0995\u09ae\u09bf\u0989\u09a8\u09bf\u099f\u09bf \u09aa\u09cb\u09b2'\u0964 \u098f\u0996\u09be\u09a8\u09c7 \u0986\u09aa\u09a8\u09bf '\u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u0985\u09ab \u09a6\u09cd\u09af \u09a1\u09c7' (POTD) \u09a4\u09c7 \u09ad\u09cb\u099f \u09a6\u09bf\u09af\u09bc\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09cd\u099e\u09be\u09a8 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8 \u098f\u09ac\u0982 \u09a6\u09b2\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u0986\u09b2\u09cb\u099a\u09a8\u09be \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u098f\u099f\u09bf \u09b6\u09c1\u09a7\u09c1 \u098f\u0995\u099f\u09bf \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af \u09a8\u09af\u09bc\u2014\u098f\u099f\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09b0\u09bf\u099a\u09af\u09bc\u0964 \u0986\u09aa\u09a8\u09bf \u098f\u0995\u099f\u09bf \u09ac\u09a1\u09bc \u0995\u09bf\u099b\u09c1\u09b0 \u0985\u0982\u09b6\u0964",
    "\u098f\u0996\u09a8\u0987 Predictify \u0996\u09c1\u09b2\u09c1\u09a8 \u098f\u09ac\u0982 '\u0995\u09ae\u09bf\u0989\u09a8\u09bf\u099f\u09bf' \u09b8\u09c7\u0995\u09b6\u09a8\u09c7 \u09af\u09be\u09a8\u0964 POTD-\u09a4\u09c7 \u09ad\u09cb\u099f \u09a6\u09bf\u09a8 \u098f\u09ac\u0982 \u09a6\u09c7\u0996\u09c1\u09a8 \u0986\u09aa\u09a8\u09be\u09b0 \u09ae\u09a4\u09be\u09ae\u09a4 \u0995\u09a4\u099f\u09be \u09b6\u0995\u09cd\u09a4\u09bf\u09b6\u09be\u09b2\u09c0\u0964 P.S. \u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u0986\u099c\u0995\u09c7\u09b0 \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u099c\u09a8\u09cd\u09af AI-\u098f\u09b0 \u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u09b8\u09cd\u0995\u09cb\u09b0 \u09a6\u09c7\u0996\u09a4\u09c7 \u099a\u09be\u09a8, \u09a4\u09be\u09b9\u09b2\u09c7 \u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09af\u09bc\u09be\u09ae \u099f\u09cd\u09b0\u09be\u09af\u09bc\u09be\u09b2 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c1\u09a8\u2014\u09ae\u09be\u09a4\u09cd\u09b0 \u09e9 \u09a6\u09bf\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09bf\u09a8\u09be\u09ae\u09c2\u09b2\u09cd\u09af\u09c7\u0964"
  ],
