{
  "subject": "30 \u0434\u043d\u0456\u0432 \u0443 \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456, \u044f\u043a\u0430 \u0437\u043c\u0456\u043d\u044e\u0454 \u0433\u0440\u0443",
  "preview_text": "\u0422\u0438 \u0432\u0436\u0435 30 \u0434\u043d\u0456\u0432 \u0456\u0437 \u043d\u0430\u043c\u0438. \u0414\u0456\u0437\u043d\u0430\u0439\u0441\u044f, \u044f\u043a \u0442\u0432\u043e\u0457 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438 \u0437\u043c\u0456\u043d\u044e\u044e\u0442\u044c \u0444\u0443\u0442\u0431\u043e\u043b\u044c\u043d\u0438\u0439 \u0441\u0432\u0456\u0442. \u0412\u0456\u0434\u043a\u0440\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a.",
  "body_paragraphs": [
    "\u0422\u0438 \u043f\u0430\u043c'\u044f\u0442\u0430\u0454\u0448 \u0442\u043e\u0439 \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u043b\u0438 \u0432\u043f\u0435\u0440\u0448\u0435 \u0432\u0456\u0434\u043a\u0440\u0438\u0432 Predictify? \u042f \u0442\u043e\u0434\u0456 \u0441\u0438\u0434\u0456\u0432 \u043e 2 \u043d\u043e\u0447\u0456, \u0434\u0438\u0432\u0438\u0432\u0441\u044f \u043d\u0430 \u0433\u0440\u0430\u0444\u0456\u043a\u0438 xG \u0456 \u0434\u0443\u043c\u0430\u0432: \"\u0410 \u0449\u043e, \u044f\u043a\u0449\u043e \u043c\u0438 \u0437\u0431\u0435\u0440\u0435\u043c\u043e \u0432\u0441\u0456\u0445, \u043a\u043e\u043c\u0443 \u043d\u0430\u0431\u0440\u0438\u0434\u043b\u0438 \u043f\u043e\u0440\u043e\u0436\u043d\u0456 \u043e\u0431\u0456\u0446\u044f\u043d\u043a\u0438?\" \u0417\u0430 30 \u0434\u043d\u0456\u0432 \u043d\u0430\u0441 \u0441\u0442\u0430\u043b\u043e \u0431\u0456\u043b\u044c\u0448\u0435, \u043d\u0456\u0436 \u044f \u043c\u0456\u0433 \u0443\u044f\u0432\u0438\u0442\u0438. \u0422\u0438 \u0442\u0435\u043f\u0435\u0440 \u0447\u0430\u0441\u0442\u0438\u043d\u0430 \u0433\u0440\u0443\u043f\u0438, \u044f\u043a\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0433\u0430\u0434\u0443\u0454 \u2014 \u043c\u0438 \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0454\u043c\u043e, \u0440\u0430\u0445\u0443\u0454\u043c\u043e \u0456 \u043f\u0435\u0440\u0435\u043c\u0430\u0433\u0430\u0454\u043c\u043e.",
    "\u041a\u043e\u0436\u0435\u043d \u0442\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437, \u043a\u043e\u0436\u0435\u043d \u0433\u043e\u043b\u043e\u0441 \u0443 Prediction of the Day \u0447\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u0443 \u043d\u043e\u0432\u0438\u043d\u0430\u0445 \u2014 \u0446\u0435 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u043b\u0456\u043a\u0438. \u0426\u0435 \u0434\u0430\u043d\u0456, \u044f\u043a\u0456 \u0440\u043e\u0431\u043b\u044f\u0442\u044c \u043d\u0430\u0441 \u0441\u0438\u043b\u044c\u043d\u0456\u0448\u0438\u043c\u0438. \u0422\u0438 \u0431\u0430\u0447\u0438\u0432, \u044f\u043a AI \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0454 \u0442\u0438\u0441\u044f\u0447\u0456 \u0437\u043c\u0456\u043d\u043d\u0438\u0445? \u0423\u044f\u0432\u0456\u0442\u044c, \u0449\u043e \u0432\u0430\u0448\u0430 \u0456\u043d\u0442\u0443\u0457\u0446\u0456\u044f \u0442\u0435\u043f\u0435\u0440 \u043c\u0430\u0454 \u0446\u0438\u0444\u0440\u043e\u0432\u0438\u0439 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442. \u0422\u0438 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0444\u0430\u043d\u0430\u0442 \u2014 \u0442\u0438 \u0447\u0430\u0441\u0442\u0438\u043d\u0430 \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0438, \u044f\u043a\u0430 \u0431\u0443\u0434\u0443\u0454 \u043d\u043e\u0432\u0443 \u0444\u0443\u0442\u0431\u043e\u043b\u044c\u043d\u0443 \u0440\u0435\u0430\u043b\u044c\u043d\u0456\u0441\u0442\u044c.",
    "\u0417\u0430\u0445\u043e\u0434\u044c \u0443 \u0440\u043e\u0437\u0434\u0456\u043b \"\u0421\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0438\" \u2014 \u0442\u0430\u043c \u0437\u0430\u0440\u0430\u0437 \u043e\u0431\u0433\u043e\u0432\u043e\u0440\u044e\u044e\u0442\u044c \u043c\u0430\u0442\u0447 \u0442\u0438\u0436\u043d\u044f. \u041f\u0440\u043e\u0433\u043e\u043b\u043e\u0441\u0443\u0439 \u0437\u0430 Prediction of the Day, \u043f\u0456\u0434\u0432\u0438\u0449 \u0441\u0432\u0456\u0439 \u0440\u0435\u0439\u0442\u0438\u043d\u0433 \u0443 IQ-\u0432\u0456\u043a\u0442\u043e\u0440\u0438\u043d\u0456. \u041a\u043e\u0436\u0435\u043d \u0442\u0432\u0456\u0439 \u043a\u0440\u043e\u043a \u0434\u043e\u0434\u0430\u0454 \u0431\u0430\u043b\u0456\u0432 \u0434\u043e \u0449\u043e\u0434\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0442\u0440\u0456\u043a\u0443. \u0422\u0438 \u0432\u0436\u0435 30 \u0434\u043d\u0456\u0432 \u0456\u0437 \u043d\u0430\u043c\u0438 \u2014 \u043d\u0435 \u0437\u0443\u043f\u0438\u043d\u044f\u0439\u0441\u044f.",
    "\u0412\u0456\u0434\u043a\u0440\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0456 \u043f\u0435\u0440\u0435\u0432\u0456\u0440, \u0447\u0438 \u0442\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u043d\u0430 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456 \u0443\u0432\u0456\u0439\u0448\u043e\u0432 \u0434\u043e \u0442\u043e\u043f-10. P.S. \u0414\u043e \u0440\u0435\u0447\u0456, \u0443 Premium-\u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432 \u0454 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0435\u043a\u0441\u043a\u043b\u044e\u0437\u0438\u0432\u043d\u0438\u0445 \u0430\u043d\u0430\u043b\u0456\u0437\u0456\u0432 \u2014 \u0441\u043f\u0440\u043e\u0431\u0443\u0439 3 \u0434\u043d\u0456 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u043e, \u043f\u043e\u0431\u0430\u0447\u0438\u0448 \u0440\u0456\u0437\u043d\u0438\u0446\u044e."
  ],
