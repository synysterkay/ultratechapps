{
  "subject": "\u09b0\u09be\u09b9\u09c1\u09b2\u09c7\u09b0 \u09e8\u09ea \u0998\u09a3\u09cd\u099f\u09be\u09b0 \u0997\u09b2\u09cd\u09aa \u09af\u09be \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09a5\u09be\u09ae\u09bf\u09af\u09bc\u09c7 \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09c7",
  "preview_text": "\u098f\u0995\u099c\u09a8 \u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u09ab\u09c1\u099f\u09ac\u09b2 \u09ab\u09cd\u09af\u09be\u09a8\u09c7\u09b0 \u0985\u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u09b8\u09be\u09ab\u09b2\u09cd\u09af\u2014\u099c\u09be\u09a8\u09c1\u09a8 \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u09a4\u09bf\u09a8\u09bf Predictify \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7 \u09ac\u09be\u099c\u09bf\u09ae\u09be\u09a4 \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u0964",
  "body_paragraphs": [
    "\u0997\u09a4 \u09b8\u09aa\u09cd\u09a4\u09be\u09b9\u09c7, \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u099f\u09bf\u09ae\u09c7\u09b0 \u0987\u09a8\u09ac\u0995\u09cd\u09b8\u09c7 \u098f\u0995\u099f\u09be \u09ae\u09c7\u09b8\u09c7\u099c \u098f\u09b8\u09c7\u099b\u09bf\u09b2\u2014\u2018\u0986\u09ae\u09bf Predictify \u09a6\u09bf\u09af\u09bc\u09c7 \u09e8\u09e6\u099f\u09bf \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u09ad\u09ac\u09bf\u09b7\u09cd\u09af\u09a6\u09cd\u09ac\u09be\u09a3\u09c0 \u0995\u09b0\u09c7\u099b\u09bf, \u09e7\u09ee\u099f\u09bf\u0987 \u09b8\u09a0\u09bf\u0995\u0964\u2019 \u0986\u09ae\u09b0\u09be \u09b8\u09ac\u09be\u0987 \u09a5\u09ae\u0995\u09c7 \u0997\u09c7\u09b2\u09be\u09ae\u0964 \u098f\u099f\u09be \u099b\u09bf\u09b2 \u09b0\u09be\u09b9\u09c1\u09b2, \u09ae\u09c1\u09ae\u09cd\u09ac\u09be\u0987\u09af\u09bc\u09c7\u09b0 \u098f\u0995\u099c\u09a8 \u09ab\u09c1\u099f\u09ac\u09b2 \u09ab\u09cd\u09af\u09be\u09a8, \u09af\u09bf\u09a8\u09bf \u09b6\u09c1\u09a7\u09c1 \u09a1\u09c7\u099f\u09be \u09a8\u09bf\u09af\u09bc\u09c7 \u0996\u09c7\u09b2\u09c7\u09a8\u09a8\u09bf\u2014\u09ac\u09be\u099c\u09bf \u09a7\u09b0\u09c7\u099b\u09c7\u09a8 \u098f\u09ac\u0982 \u099c\u09bf\u09a4\u09c7\u099b\u09c7\u09a8\u0964 \u09a4\u09be\u09b0 \u0997\u09b2\u09cd\u09aa \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09ae\u09a8\u09c7 \u0995\u09b0\u09bf\u09af\u09bc\u09c7 \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09c7 \u0995\u09c7\u09a8 \u0986\u09ae\u09b0\u09be \u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa \u09ac\u09be\u09a8\u09bf\u09af\u09bc\u09c7\u099b\u09bf: \u2018\u0997\u09be\u099f \u09ab\u09bf\u09b2\u09bf\u0982\u2019 \u09a8\u09af\u09bc, \u2018\u09a1\u09c7\u099f\u09be-\u09ac\u09cd\u09af\u09be\u0995\u09a1 \u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8\u2019\u0964",
    "\u09b0\u09be\u09b9\u09c1\u09b2\u09c7\u09b0 \u0995\u09cc\u09b6\u09b2 \u099b\u09bf\u09b2 \u09b8\u09b9\u099c\u2014\u09aa\u09cd\u09b0\u09a4\u09bf \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u099c\u09a8\u09cd\u09af Predictify-\u098f\u09b0 \u2018\u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u09b8\u09cd\u0995\u09cb\u09b0\u2019 \u099a\u09c7\u0995 \u0995\u09b0\u09be\u0964 \u09a4\u09bf\u09a8\u09bf \u09ac\u09b2\u09c7\u09a8, \u2018\u09af\u0996\u09a8 AI \u09ed\u09e6%+ \u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u09a6\u09c7\u09af\u09bc, \u0986\u09ae\u09bf \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u09a5\u09be\u0995\u09bf\u0964 \u09ac\u09be\u0995\u09bf \u09b8\u09ae\u09af\u09bc \u0986\u09ae\u09bf \u09b6\u09c1\u09a7\u09c1 \u09b6\u09bf\u0996\u09bf\u0964\u2019 \u09a4\u09be\u09b0 \u099c\u09af\u09bc\u09c7\u09b0 \u09b9\u09be\u09b0 \u09ef\u09e6%\u2014\u09af\u09be \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u0997\u09a1\u09bc \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0 \u099a\u09c7\u09af\u09bc\u09c7 \u0985\u09a8\u09c7\u0995 \u09ac\u09c7\u09b6\u09bf\u0964 \u09a4\u09bf\u09a8\u09bf \u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09af\u09bc\u09be\u09b0 \u09b2\u09bf\u0997, \u09b2\u09be \u09b2\u09bf\u0997\u09be, \u098f\u09ac\u0982 \u09ac\u09c1\u09a8\u09cd\u09a6\u09c7\u09b8\u09b2\u09bf\u0997\u09be\u09b0 \u09ae\u09cd\u09af\u09be\u099a \u0995\u09ad\u09be\u09b0 \u0995\u09b0\u09c7\u099b\u09c7\u09a8, \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09ad\u09ac\u09bf\u09b7\u09cd\u09af\u09a6\u09cd\u09ac\u09be\u09a3\u09c0\u09b0 \u09aa\u09c7\u099b\u09a8\u09c7 \u099b\u09bf\u09b2 \u0997\u09ad\u09c0\u09b0 \u09aa\u09b0\u09bf\u09b8\u0982\u0996\u09cd\u09af\u09be\u09a8\u2014xG, \u09aa\u099c\u09c7\u09b6\u09a8, \u09a1\u09bf\u09ab\u09c7\u09a8\u09cd\u09b8\u09bf\u09ad \u09b6\u0995\u09cd\u09a4\u09bf\u0964",
    "Predictify-\u09b0 \u2018\u0995\u09ae\u09bf\u0989\u09a8\u09bf\u099f\u09bf\u2019 \u09ab\u09bf\u099a\u09be\u09b0\u0987 \u09a4\u09be\u0995\u09c7 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0995\u09b0\u09c7\u099b\u09c7\u2014\u09a4\u09bf\u09a8\u09bf \u2018\u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u0985\u09ab \u09a6\u09cd\u09af \u09a1\u09c7\u2019 (POTD) \u09ad\u09cb\u099f \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09c7\u09a8 \u098f\u09ac\u0982 \u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u09ab\u09cd\u09af\u09be\u09a8\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u0986\u09b2\u09cb\u099a\u09a8\u09be \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u0964 \u2018\u0986\u0987\u0995\u09bf\u0989 \u0995\u09c1\u0987\u099c\u2019-\u098f \u099a\u09a1\u09bc\u09c7 \u09a4\u09bf\u09a8\u09bf \u09b2\u09bf\u09a1\u09be\u09b0\u09ac\u09cb\u09b0\u09cd\u09a1\u09c7 \u0989\u09a0\u09c7\u099b\u09c7\u09a8, \u098f\u09ac\u0982 \u2018\u09a1\u09c7\u0987\u09b2\u09bf \u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u0995\u2019 \u09ac\u099c\u09be\u09af\u09bc \u09b0\u09c7\u0996\u09c7\u099b\u09c7\u09a8\u0964 \u098f\u0996\u09a8 \u09a4\u09bf\u09a8\u09bf \u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09af\u09bc\u09be\u09ae \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u099b\u09c7\u09a8 ($\u09e7\u09e8.\u09ef\u09ef/\u09ae\u09be\u09b8) \u09af\u09be\u09a4\u09c7 \u09b8\u09ac \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u098f\u09ac\u0982 \u0985\u09cd\u09af\u09be\u09a1\u09ad\u09be\u09a8\u09cd\u09b8\u09a1 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u099f\u09b8 \u0986\u09a8\u09b2\u0995 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u2014\u09ab\u09cd\u09b0\u09bf \u099f\u09cd\u09b0\u09be\u09af\u09bc\u09be\u09b2 \u09a6\u09bf\u09af\u09bc\u09c7 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c7\u099b\u09bf\u09b2\u09c7\u09a8\u0964",
    "\u0986\u09aa\u09a8\u09be\u09b0 \u0997\u09b2\u09cd\u09aa \u0995\u09bf \u09b9\u09ac\u09c7? \u0986\u099c\u0987 \u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09c1\u09a8, \u2018\u0995\u09ae\u09bf\u0989\u09a8\u09bf\u099f\u09bf\u2019 \u09ac\u09bf\u09ad\u09be\u0997\u09c7 \u09af\u09be\u09a8, \u098f\u09ac\u0982 \u09b0\u09be\u09b9\u09c1\u09b2\u09c7\u09b0 \u09ae\u09a4\u09cb \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u09ad\u09ac\u09bf\u09b7\u09cd\u09af\u09a6\u09cd\u09ac\u09be\u09a3\u09c0 \u0995\u09b0\u09c1\u09a8\u0964 \u09aa\u09bf.\u098f\u09b8.: \u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u098f\u0996\u09a8 \u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09af\u09bc\u09be\u09ae \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c7\u09a8, \u09e9 \u09a6\u09bf\u09a8\u09c7\u09b0 \u09ab\u09cd\u09b0\u09bf \u099f\u09cd\u09b0\u09be\u09af\u09bc\u09be\u09b2 \u09aa\u09be\u09ac\u09c7\u09a8\u2014\u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09c7\u099f\u09be-\u099a\u09be\u09b2\u09bf\u09a4 \u099c\u09be\u09b0\u09cd\u09a8\u09bf \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09be\u09b0 \u09b8\u09c7\u09b0\u09be \u09b8\u09ae\u09af\u09bc\u0964"
  ],
