{
  "subject": "\u0627\u0644\u0645\u0644\u0627\u0630 \u0627\u0644\u0623\u062e\u064a\u0631 \u0644\u0635\u0648\u062a\u0643 \u0627\u0644\u0646\u0642\u064a",
  "preview_text": "\u0644\u0645 \u062a\u0639\u062f \u0645\u0633\u062a\u0645\u0639\u064b\u0627 \u0639\u0627\u062f\u064a\u064b\u0627. \u0623\u0646\u062a \u062c\u0632\u0621 \u0645\u0646 \u0645\u0647\u0645\u0629 Loudify \u0644\u0625\u0646\u0647\u0627\u0621 \u062a\u0634\u0648\u064a\u0647 \u0627\u0644\u0635\u0648\u062a.",
  "body_paragraphs": [
    "\u0641\u064a \u0627\u0644\u0633\u0627\u0639\u0629 3 \u0641\u062c\u0631\u064b\u0627\u060c \u0628\u064a\u0646\u0645\u0627 \u0643\u0627\u0646 \u0627\u0644\u0639\u0627\u0644\u0645 \u0646\u0627\u0626\u0645\u064b\u0627\u060c \u0643\u0646\u0627 \u0646\u0639\u064a\u062f \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0635\u0648\u062a. \u0644\u0645 \u0646\u0643\u0646 \u0646\u0635\u0646\u0639 \u062a\u0637\u0628\u064a\u0642\u064b\u0627 \u0641\u062d\u0633\u0628\u060c \u0628\u0644 \u0643\u0646\u0627 \u0646\u0628\u0646\u064a \u0645\u0644\u0627\u0630\u064b\u0627 \u0644\u0643\u0644 \u0645\u0646 \u0633\u0626\u0645 \u0645\u0646 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u0634\u0648\u0647. \u0623\u0646\u062a \u0627\u0644\u0622\u0646 \u062c\u0632\u0621 \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u0645\u0644\u0627\u0630.",
    "\u0644\u0642\u062f \u0627\u062e\u062a\u0631\u062a Loudify \u0644\u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u0623\u0646 \u062a\u0633\u0645\u0639 \u0643\u0644 \u0647\u0645\u0633\u0629\u060c \u0643\u0644 \u0646\u0628\u0636\u0629\u060c \u0643\u0644 \u062a\u0641\u0635\u064a\u0644\u0629. \u0644\u0643\u0646 \u0647\u0646\u0627\u0643 \u0634\u064a\u0626\u064b\u0627 \u0648\u0627\u062d\u062f\u064b\u0627 \u0644\u0645 \u062a\u062e\u0628\u0631\u0643 \u0628\u0647 \u0628\u0639\u062f: \u062a\u0637\u0628\u064a\u0642\u0643 \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u0623\u062f\u0627\u0629 \u0631\u0641\u0639 \u0635\u0648\u062a. \u0625\u0646\u0647 \u0628\u064a\u0627\u0646. \u0628\u064a\u0627\u0646 \u0628\u0623\u0646 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0646\u0642\u064a \u0644\u064a\u0633 \u0631\u0641\u0627\u0647\u064a\u0629\u060c \u0628\u0644 \u062d\u0642.",
    "\u0627\u0644\u064a\u0648\u0645\u060c \u0627\u0641\u062a\u062d \u062a\u0637\u0628\u064a\u0642\u0643 \u0648\u0627\u0646\u0638\u0631 \u0625\u0644\u0649 '\u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0635\u0648\u062a\u064a \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u064a'. \u0647\u0630\u0627 \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u062a\u0642\u0631\u064a\u0631. \u0625\u0646\u0647 \u0628\u0635\u0645\u062a\u0643 \u0627\u0644\u0635\u0648\u062a\u064a\u0629. \u0643\u064a\u0641 \u0627\u0633\u062a\u0645\u0639\u062a \u0647\u0630\u0627 \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u061f \u0623\u064a \u0633\u0645\u0627\u0639\u0627\u062a \u0627\u0633\u062a\u062e\u062f\u0645\u062a\u061f \u0623\u064a \u0645\u0633\u0627\u0631 \u0643\u0631\u0631\u062a\u061f \u0647\u0630\u0627 \u0647\u0648 \u062a\u0627\u0631\u064a\u062e\u0643 \u0627\u0644\u0635\u0648\u062a\u064a\u060c \u0648\u0646\u062d\u0646 \u0646\u062d\u062a\u0641\u0638 \u0628\u0647 \u0644\u0623\u062c\u0644\u0643.",
    "\u0627\u0641\u062a\u062d Loudify \u0627\u0644\u0622\u0646\u060c \u0648\u062a\u0635\u0641\u062d \u0645\u0644\u0641\u0643 \u0627\u0644\u0635\u0648\u062a\u064a. \u062b\u0645 \u0634\u0627\u0631\u0643\u0646\u0627 \u0631\u0623\u064a\u0643: \u0647\u0644 \u062a\u0634\u0639\u0631 \u0623\u0646\u0643 \u062c\u0632\u0621 \u0645\u0646 \u0634\u064a\u0621 \u0623\u0643\u0628\u0631\u061f \u0644\u0623\u0646\u0643 \u0643\u0630\u0644\u0643. P.S. \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0645\u0645\u064a\u0632\u0648\u0646 \u064a\u062d\u0635\u0644\u0648\u0646 \u0639\u0644\u0649 \u062a\u0627\u0631\u064a\u062e \u0643\u0627\u0645\u0644 \u0644\u0645\u0644\u0641\u0627\u062a\u0647\u0645 \u0627\u0644\u0635\u0648\u062a\u064a\u0629. \u0644\u064a\u0633 \u0641\u0642\u0637 \u0647\u0630\u0627 \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u060c \u0628\u0644 \u0643\u0644 \u0623\u0633\u0628\u0648\u0639 \u0645\u0646\u0630 \u0623\u0648\u0644 \u064a\u0648\u0645. \u062c\u0631\u0628\u0647 \u0627\u0644\u0622\u0646."
  ],
