{
  "subject": "\u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0917\u0932\u0924\u0940 \u0915\u0940, \u0905\u092c \u0906\u092a \u092e\u0924 \u0915\u0940\u091c\u093f\u090f",
  "preview_text": "\u091c\u094b 90% \u0932\u094b\u0917 \u0907\u0938 \u0910\u092a \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947, \u0935\u0939\u0940 \u090f\u0915 \u091a\u0940\u091c\u093c \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964 \u0924\u0940\u0928 \u0926\u093f\u0928 \u0915\u093e \u0930\u0939\u0938\u094d\u092f...",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u092a\u0941\u0930\u093e\u0928\u093e \u0917\u093e\u0928\u093e \u0938\u0941\u0928\u093e\u0964 \u0935\u0939\u0940, \u091c\u094b \u0915\u0949\u0932\u0947\u091c \u0915\u0947 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0932\u0917\u093e\u0924\u093e\u0930 \u0938\u0941\u0928\u0924\u093e \u0925\u093e\u0964 \u0914\u0930 \u090f\u0915 \u092c\u093e\u0924 \u0938\u092e\u091d \u0906\u0908 \u2013 \u0939\u092e \u0938\u093f\u0930\u094d\u092b\u093c \u0917\u093e\u0928\u0947 \u0938\u0941\u0928\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u094d\u0939\u0947\u0902 '\u092e\u0939\u0938\u0942\u0938' \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0939\u092e\u093e\u0930\u0947 \u092b\u093c\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0909\u0924\u0928\u0940 \u0917\u0939\u0930\u0940 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940\u0964 \u092f\u0939\u0940 \u0935\u094b \u091b\u094b\u091f\u0940 \u0938\u0940 \u0917\u0932\u0924\u0940 \u0939\u0948 \u091c\u094b \u0939\u0930 \u0915\u094b\u0908 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "\u092e\u0948\u0902\u0928\u0947 \u0916\u0941\u0926 \u092a\u0930 \u090f\u0915 \u091a\u0941\u0928\u094c\u0924\u0940 \u0930\u0916\u0940: \u0905\u0917\u0932\u0947 \u0924\u0940\u0928 \u0926\u093f\u0928, \u0939\u0930 \u0935\u094b \u0911\u0921\u093f\u092f\u094b \u091c\u094b \u0938\u0941\u0928\u0942\u0901 \u2013 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f, \u0917\u093e\u0928\u093e, \u092e\u0942\u0935\u0940 \u2013 \u0909\u0938\u0947 Volume Booster \u0915\u0947 'Bass Booster' \u0914\u0930 'Rock' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0915\u0947 \u092c\u093f\u0928\u093e \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u0942\u0901\u0917\u093e\u0964 \u092c\u0938 \u0924\u0940\u0928 \u0926\u093f\u0928\u0964 \u0928\u0924\u0940\u091c\u093e? \u092f\u0939 \u0910\u0938\u093e \u0925\u093e \u091c\u0948\u0938\u0947 \u092e\u0948\u0902\u0928\u0947 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0938\u0947 \u092c\u093e\u0938 \u0938\u0941\u0928\u093e \u0939\u094b\u0964 \u0939\u0930 \u0917\u093f\u091f\u093e\u0930 \u0915\u093e \u091d\u0928\u091d\u0928\u093e\u0939\u091f, \u0939\u0930 \u0921\u094d\u0930\u092e \u0915\u093e \u0925\u092a-\u0925\u092a... \u0938\u092c \u0915\u0941\u091b \u0928\u092f\u093e \u0932\u0917\u093e\u0964",
    "\u092f\u0939 \u0910\u092a \u0915\u0940 \u0935\u0939\u0940 \u092b\u093c\u0940\u091a\u0930 \u0939\u0948 \u091c\u093f\u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u090f\u0915 \u092c\u093e\u0930 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0915\u0947 \u092d\u0942\u0932 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902 \u2013 Equalizer \u0915\u0947 \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938\u0964 Pop, Rock, Jazz... \u0939\u0930 \u091c\u0947\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0938\u0947\u091f\u093f\u0902\u0917\u0964 \u0924\u0940\u0928 \u0926\u093f\u0928 \u0915\u0947 \u0932\u093f\u090f \u092c\u0938 \u0907\u0938\u0947 \u091a\u093e\u0932\u0942 \u0930\u0916\u093f\u090f\u0964 \u0939\u0930 \u0917\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u092c\u0926\u0932\u093f\u090f\u0964 \u0906\u092a\u0915\u093e \u092b\u093c\u094b\u0928 \u090f\u0915 \u0928\u092f\u093e \u0921\u093f\u0935\u093e\u0907\u0938 \u092c\u0928 \u091c\u093e\u090f\u0917\u093e\u0964",
    "\u091a\u0941\u0928\u094c\u0924\u0940 \u0915\u092c\u0942\u0932 \u0939\u0948? \u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u093f\u090f, Equalizer \u092a\u0930 \u091f\u0948\u092a \u0915\u0940\u091c\u093f\u090f, \u0914\u0930 'Rock' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091a\u0941\u0928\u093f\u090f\u0964 \u092b\u093f\u0930 \u0915\u0932 \u0924\u0915 \u0909\u0938\u0947 \u092c\u0926\u0932\u093f\u090f 'Electronic' \u092f\u093e 'Jazz' \u092e\u0947\u0902\u0964 \u092c\u0938 \u0924\u0940\u0928 \u0926\u093f\u0928\u0964 \u092b\u0930\u094d\u0915 \u0916\u0941\u0926-\u092c-\u0916\u0941\u0926 \u0926\u093f\u0916 \u091c\u093e\u090f\u0917\u093e\u0964 \u0914\u0930 \u0939\u093e\u0901, Premium \u091f\u094d\u0930\u093e\u092f\u0932 \u092e\u0947\u0902 \u092f\u0947 \u0938\u092d\u0940 \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938 \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0932\u0947\u0935\u0932 \u0915\u0947 \u0938\u093e\u0925 \u092e\u093f\u0932\u0924\u0947 \u0939\u0948\u0902 \u2013 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0930\u094b\u0915-\u091f\u094b\u0915 \u0915\u0947\u0964\n\nP.S. \u0924\u0940\u0928 \u0926\u093f\u0928 \u092c\u093e\u0926 \u0905\u0917\u0930 \u0906\u092a\u0915\u094b \u0932\u0917\u0947 \u0915\u093f \u0906\u092a\u0915\u093e \u092a\u0941\u0930\u093e\u0928\u093e \u092b\u093c\u094b\u0928 \u0935\u093e\u092a\u0938 '\u092b\u094d\u0932\u0948\u091f' \u0938\u093e\u0909\u0902\u0921 \u0926\u0947 \u0930\u0939\u093e \u0939\u0948... \u0924\u094b \u0938\u092e\u091d \u091c\u093e\u0928\u093e, \u091a\u0941\u0928\u094c\u0924\u0940 \u0928\u0947 \u0915\u093e\u092e \u0915\u0930 \u0926\u093f\u092f\u093e\u0964"
  ],
