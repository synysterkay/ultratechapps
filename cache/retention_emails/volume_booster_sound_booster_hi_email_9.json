{
  "subject": "\u0924\u0940\u0928 \u0926\u093f\u0928 \u0915\u093e \u091a\u0948\u0932\u0947\u0902\u091c, \u0905\u092a\u0928\u0947 \u0915\u093e\u0928\u094b\u0902 \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u0915\u0930\u094b",
  "preview_text": "\u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u091c\u094b \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964 \u0938\u093f\u0930\u094d\u092b 72 \u0918\u0902\u091f\u0947, \u092b\u093f\u0930 \u0926\u0947\u0916\u094b \u092b\u0930\u094d\u0915\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0915\u093e\u092e \u0915\u093f\u092f\u093e\u2014\u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092e\u0948\u0915\u094d\u0938\u093f\u092e\u092e \u092a\u0930 \u0932\u0917\u093e\u092f\u093e \u0914\u0930 \u090f\u0915 \u092a\u0941\u0930\u093e\u0928\u093e \u0917\u093e\u0928\u093e \u0938\u0941\u0928\u093e\u0964 \u0932\u0917\u093e \u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u0917\u0940\u0932\u093e \u0915\u0902\u092c\u0932 \u0938\u093f\u0930 \u092a\u0930 \u0921\u093e\u0932 \u0926\u093f\u092f\u093e \u0939\u094b\u0964 \u092b\u093f\u0930 \u092e\u0948\u0902\u0928\u0947 \u0910\u092a \u0916\u094b\u0932\u093e \u0914\u0930 \u090f\u0915 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091a\u0941\u0928\u093e\u0964 \u0909\u0938\u0940 \u0917\u093e\u0928\u0947 \u0928\u0947 \u092e\u0941\u091d\u0947 \u0915\u0902\u092a\u093e \u0926\u093f\u092f\u093e\u0964 \u092f\u0939 \u0915\u094b\u0908 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902, \u092c\u0938 \u0935\u094b \u092b\u0940\u091a\u0930 \u091c\u094b \u0906\u092a\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e\u0964",
    "\u0905\u092c \u092e\u0948\u0902 \u0906\u092a\u0915\u094b \u090f\u0915 \u091a\u0948\u0932\u0947\u0902\u091c \u0926\u0947\u0924\u093e \u0939\u0942\u0901\u2014\u0905\u0917\u0932\u0947 \u0924\u0940\u0928 \u0926\u093f\u0928, \u0930\u094b\u091c \u090f\u0915 \u0905\u0932\u0917 \u0924\u0930\u0939 \u0915\u0940 \u0911\u0921\u093f\u092f\u094b \u0938\u0941\u0928\u094b\u0964 \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u0915\u094b\u0908 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u092f\u093e \u0911\u0921\u093f\u092f\u094b\u092c\u0941\u0915, \u0926\u0942\u0938\u0930\u0947 \u0926\u093f\u0928 \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092a\u094d\u0932\u0947\u0932\u093f\u0938\u094d\u091f, \u0924\u0940\u0938\u0930\u0947 \u0926\u093f\u0928 \u0915\u094b\u0908 \u092e\u0942\u0935\u0940 \u092f\u093e \u0935\u0947\u092c \u0938\u0940\u0930\u0940\u091c\u0964 \u0939\u0930 \u092c\u093e\u0930 \u0910\u092a \u0916\u094b\u0932\u094b, '\u0932\u093e\u0909\u0921\u0928\u0947\u0938 \u090f\u0928\u094d\u0939\u093e\u0902\u0938\u0930' \u0911\u0928 \u0915\u0930\u094b, \u0914\u0930 \u090f\u0915 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091a\u0941\u0928\u094b\u2014\u092a\u0949\u092a, \u0930\u0949\u0915, \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915, \u091c\u094b \u092d\u0940 \u092e\u0942\u0921 \u0939\u094b\u0964 \u092c\u0938 \u0924\u0940\u0928 \u0926\u093f\u0928, \u092b\u093f\u0930 \u0924\u092f \u0915\u0930\u0928\u093e \u0915\u093f \u092b\u0930\u094d\u0915 \u092a\u0921\u093c\u0924\u093e \u0939\u0948 \u092f\u093e \u0928\u0939\u0940\u0902\u0964",
    "\u092f\u0939 \u0910\u092a \u0938\u093f\u0930\u094d\u092b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0928\u0939\u0940\u0902 \u092c\u0922\u093c\u093e\u0924\u093e\u2014\u092f\u0939 \u0906\u0935\u093e\u091c\u093c \u092e\u0947\u0902 \u091c\u093e\u0928 \u0921\u093e\u0932\u0924\u093e \u0939\u0948\u0964 \u092c\u093f\u0932\u094d\u091f-\u0907\u0928 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u0915\u0947 \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938 \u0939\u0930 \u091c\u0949\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c \u0939\u0948\u0902\u0964 \u092c\u093e\u0938 \u092c\u0942\u0938\u094d\u091f\u0930 \u0938\u0947 \u0917\u093e\u0928\u0947 \u092e\u0947\u0902 \u0935\u094b \u0917\u0939\u0930\u093e\u0908 \u0906\u0924\u0940 \u0939\u0948 \u091c\u094b \u0915\u0949\u0928\u094d\u0938\u0930\u094d\u091f \u092e\u0947\u0902 \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964 \u0914\u0930 \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u0940 \u092c\u093e\u0924\u2014\u092f\u0939 Spotify, YouTube, Netflix, \u0939\u0930 \u091a\u0940\u091c\u093c \u092a\u0930 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a, \u0914\u0930 \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u090f\u0915 \u0928\u090f \u0921\u093f\u0935\u093e\u0907\u0938 \u091c\u0948\u0938\u093e \u0932\u0917\u0947\u0917\u093e\u0964",
    "\u0924\u094b \u0924\u0948\u092f\u093e\u0930 \u0939\u094b? \u0906\u091c \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u094b\u0964 \u0910\u092a \u0916\u094b\u0932\u094b, '\u0932\u093e\u0909\u0921\u0928\u0947\u0938 \u090f\u0928\u094d\u0939\u093e\u0902\u0938\u0930' \u0911\u0928 \u0915\u0930\u094b, \u0914\u0930 \u0915\u094b\u0908 \u090f\u0915 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091a\u0941\u0928\u094b\u0964 \u0924\u0940\u0928 \u0926\u093f\u0928 \u092c\u093e\u0926 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0928\u093e \u0915\u093f \u0915\u0948\u0938\u093e \u0932\u0917\u093e\u0964 P.S.\u2014\u0905\u0917\u0930 \u0924\u0940\u0938\u0930\u0947 \u0926\u093f\u0928 \u0924\u0915 \u0906\u092a\u0915\u094b \u092b\u0930\u094d\u0915 \u0928 \u0932\u0917\u0947, \u0924\u094b \u092e\u0948\u0902 \u0906\u092a\u0915\u094b \u090f\u0915 \u0914\u0930 \u091f\u094d\u0930\u093f\u0915 \u092c\u0924\u093e\u090a\u0901\u0917\u093e \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u092a\u0939\u0932\u0947 \u092f\u0939 \u091a\u0948\u0932\u0947\u0902\u091c \u092a\u0942\u0930\u093e \u0915\u0930\u094b\u0964"
  ],
