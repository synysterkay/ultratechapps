{
  "subject": "\u0406\u0441\u0442\u043e\u0440\u0456\u044f \u041e\u043b\u0435\u043a\u0441\u0456\u044f: \u044f\u043a \u0432\u0456\u043d \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u0432 \u043f\u043e\u043c\u0438\u043b\u044f\u0442\u0438\u0441\u044f",
  "preview_text": "\u0412\u0456\u043d \u0441\u0442\u0430\u0432\u0438\u0432 \u043d\u0430 \u0456\u043d\u0442\u0443\u0457\u0446\u0456\u044e \u2014 \u0456 \u043f\u0440\u043e\u0433\u0440\u0430\u0432 5 \u043c\u0430\u0442\u0447\u0456\u0432 \u043f\u043e\u0441\u043f\u0456\u043b\u044c. \u041f\u043e\u0442\u0456\u043c \u0437\u043d\u0430\u0439\u0448\u043e\u0432 \u0456\u043d\u0448\u0438\u0439 \u0448\u043b\u044f\u0445.",
  "body_paragraphs": [
    "\u041e\u043b\u0435\u043a\u0441\u0456\u0439 \u0441\u0438\u0434\u0456\u0432 \u0443 \u0431\u0430\u0440\u0456 \u0437 \u0434\u0440\u0443\u0437\u044f\u043c\u0438 \u043f\u0456\u0441\u043b\u044f \u0447\u0435\u0440\u0433\u043e\u0432\u043e\u0457 \u043f\u043e\u0440\u0430\u0437\u043a\u0438. \u0419\u043e\u0433\u043e \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u043d\u0430 \u043c\u0430\u0442\u0447 \u0411\u0430\u0440\u0441\u0435\u043b\u043e\u043d\u0438 \u0437\u0456\u0433\u0440\u0430\u0432 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u2014 \u0442\u0456\u043b\u044c\u043a\u0438 \u0432\u0456\u043d \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0432 \u043d\u0430 2:0, \u0430 \u0440\u0430\u0445\u0443\u043d\u043e\u043a \u0431\u0443\u0432 3:1. \u0412\u0456\u043d \u0443\u0436\u0435 \u0437\u0432\u0438\u043a \u0434\u043e \u0446\u044c\u043e\u0433\u043e \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044f: \u043a\u043e\u043b\u0438 \u0442\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0438\u0439 \u043d\u0430 100%, \u0430 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0437\u043d\u0438\u0449\u0443\u0454 \u0442\u0432\u043e\u044e \u043b\u043e\u0433\u0456\u043a\u0443. \u0417\u0434\u0430\u0432\u0430\u043b\u043e\u0441\u044f, \u0449\u043e \u0444\u0443\u0442\u0431\u043e\u043b \u2014 \u0446\u0435 \u0445\u0430\u043e\u0441, \u044f\u043a\u0438\u0439 \u043d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0438\u0442\u0438.",
    "\u0422\u043e\u0434\u0456 \u0432\u0456\u043d \u043d\u0430\u0442\u0440\u0430\u043f\u0438\u0432 \u043d\u0430 Predictify. \u0421\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0441\u043a\u0435\u043f\u0442\u0438\u0447\u043d\u043e \u0433\u043e\u0440\u0442\u0430\u0432 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438 AI, \u044f\u043a\u0456 \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u043b\u0438 \u0441\u043e\u0442\u043d\u0456 \u0437\u043c\u0456\u043d\u043d\u0438\u0445: xG \u0433\u0440\u0430\u0432\u0446\u0456\u0432, \u043e\u0431\u043e\u0440\u043e\u043d\u043d\u0443 \u043b\u0456\u043d\u0456\u044e \u0441\u0443\u043f\u0435\u0440\u043d\u0438\u043a\u0430, \u043d\u0430\u0432\u0456\u0442\u044c \u043f\u043e\u0433\u043e\u0434\u0443 \u043d\u0430 \u0441\u0442\u0430\u0434\u0456\u043e\u043d\u0456. \u0427\u0435\u0440\u0435\u0437 \u0442\u0438\u0436\u0434\u0435\u043d\u044c \u0432\u0456\u043d \u0432\u0438\u0440\u0456\u0448\u0438\u0432 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u043e\u0434\u0438\u043d \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u043d\u0430 \u043c\u0430\u0442\u0447 \u041b\u0430 \u041b\u0456\u0433\u0438 \u2014 \u0456 \u0432\u0438\u0433\u0440\u0430\u0432. \u041f\u043e\u0442\u0456\u043c \u0449\u0435 \u043e\u0434\u0438\u043d \u0456 \u0449\u0435. \u0417\u0430 \u043c\u0456\u0441\u044f\u0446\u044c \u0439\u043e\u0433\u043e \u0442\u043e\u0447\u043d\u0456\u0441\u0442\u044c \u0437\u0440\u043e\u0441\u043b\u0430 \u0434\u043e 73%, \u0430 \u0434\u0440\u0443\u0437\u0456 \u043f\u043e\u0447\u0430\u043b\u0438 \u043f\u0438\u0442\u0430\u0442\u0438, \u044f\u043a \u0439\u043e\u043c\u0443 \u0446\u0435 \u0432\u0434\u0430\u0454\u0442\u044c\u0441\u044f.",
    "\u0421\u0435\u043a\u0440\u0435\u0442 \u043d\u0435 \u0432 \u043c\u0430\u0433\u0456\u0457, \u0430 \u0432 \u0434\u0430\u043d\u0438\u0445. \u041a\u043e\u043b\u0438 AI \u0434\u0430\u0454 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0437 confidence score 67%, \u0442\u0438 \u0437\u043d\u0430\u0454\u0448, \u0447\u0438 \u0432\u0430\u0440\u0442\u043e \u0440\u0438\u0437\u0438\u043a\u0443\u0432\u0430\u0442\u0438. \u041a\u043e\u043b\u0438 \u0431\u0430\u0447\u0438\u0448 \u0430\u043d\u0430\u043b\u0456\u0437 \u0442\u0430\u043a\u0442\u0438\u043a\u0438 \u0441\u0443\u043f\u0435\u0440\u043d\u0438\u043a\u0430 \u0437\u0430 \u043e\u0441\u0442\u0430\u043d\u043d\u0456 5 \u043c\u0430\u0442\u0447\u0456\u0432 \u2014 \u0446\u0435 \u043d\u0435 \u0433\u0430\u0434\u0430\u043d\u043d\u044f, \u0430 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044f. Predictify \u043d\u0435 \u0437\u043c\u0443\u0448\u0443\u0454 \u0442\u0435\u0431\u0435 \u0432\u0456\u0440\u0438\u0442\u0438 \u043d\u0430 \u0441\u043b\u043e\u0432\u043e, \u0430 \u043f\u043e\u043a\u0430\u0437\u0443\u0454 \u043f\u0440\u043e\u0437\u043e\u0440\u0456 \u0446\u0438\u0444\u0440\u0438, \u044f\u043a\u0456 \u0442\u0438 \u043c\u043e\u0436\u0435\u0448 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0441\u0430\u043c.",
    "\u0412\u0456\u0434\u043a\u0440\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0437\u0430\u0440\u0430\u0437 \u0456 \u043f\u043e\u0434\u0438\u0432\u0438\u0441\u044c \u043d\u0430 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438 \u043d\u0430 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456\u0448\u043d\u0456 \u043c\u0430\u0442\u0447\u0456. \u0417\u043d\u0430\u0439\u0434\u0438 \u0445\u043e\u0447\u0430 \u0431 \u043e\u0434\u0438\u043d, \u0434\u0435 confidence score \u0432\u0438\u0449\u0438\u0439 \u0437\u0430 70% \u2014 \u0456 \u0437\u0440\u043e\u0431\u0438 \u0441\u0432\u0456\u0439 \u0432\u0438\u0431\u0456\u0440. \u0412\u0456\u0434\u0447\u0443\u0439 \u0440\u0456\u0437\u043d\u0438\u0446\u044e \u043c\u0456\u0436 \u0456\u043d\u0442\u0443\u0457\u0446\u0456\u0454\u044e \u0456 \u0437\u043d\u0430\u043d\u043d\u044f\u043c\u0438. P.S. \u041e\u043b\u0435\u043a\u0441\u0456\u0439 \u0442\u0435\u043f\u0435\u0440 \u043d\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u0454 \u0436\u043e\u0434\u043d\u043e\u0433\u043e \u043c\u0430\u0442\u0447\u0443 \u2014 \u043a\u0430\u0436\u0435, \u0449\u043e \u0446\u0435 \u0437\u043c\u0456\u043d\u0438\u043b\u043e \u0439\u043e\u0433\u043e \u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0438 \u0437 \u0444\u0443\u0442\u0431\u043e\u043b\u043e\u043c."
  ],
