{
  "subject": "\u6211\u901a\u5e38\u4e0d\u5199\u8fd9\u79cd\u90ae\u4ef6\uff0c\u4f46\u4eca\u5929\u4f8b\u5916",
  "preview_text": "\u51cc\u66683\u70b9\uff0c\u6211\u76ef\u7740\u4ee3\u7801\uff0c\u7a81\u7136\u610f\u8bc6\u5230\u4e00\u4ef6\u4e8b\u2026\u2026\u8fd9\u5c01\u90ae\u4ef6\u53ef\u80fd\u4e5f\u662f\u6700\u540e\u4e00\u6b21\u3002",
  "body_paragraphs": [
    "\u8bf4\u5b9e\u8bdd\uff0c\u6211\u4e0d\u592a\u64c5\u957f\u5199\u8fd9\u79cd\u4e1c\u897f\u3002\u6211\u662f\u5f00\u53d1\u8005\uff0c\u4e0d\u662f\u6587\u6848\u3002\u4f46\u4eca\u5929\u662f\u7b2c39\u5929\uff0c\u4f60\u4e0b\u8f7d\u4e86Bass Booster\uff0c\u7136\u540e\u2026\u2026\u53ef\u80fd\u518d\u4e5f\u6ca1\u6253\u5f00\u8fc7\u3002\u8fd9\u5f88\u6b63\u5e38\uff0c90%\u7684\u7528\u6237\u90fd\u8fd9\u6837\u3002\u4f46\u51cc\u66683\u70b9\u6211\u76ef\u7740\u540e\u53f0\u6570\u636e\uff0c\u7a81\u7136\u89c9\u5f97\u4e0d\u80fd\u5c31\u8fd9\u4e48\u7b97\u4e86\u3002",
    "\u6211\u82b1\u4e86\u4e09\u4e2a\u6708\u8c03\u8bd5\u90a3\u4e2a\u4f4e\u97f3\u865a\u62df\u5668\uff0c\u5c31\u4e3a\u4e86\u8ba9Hip-Hop\u7684\u9f13\u70b9\u5728\u4f60\u8033\u673a\u91cc\u7838\u51fa\u80f8\u53e3\u7684\u9707\u52a8\u3002\u4e0d\u662f\u90a3\u79cd\u201c\u54e6\uff0c\u58f0\u97f3\u5927\u4e86\u70b9\u201d\u7684\u6577\u884d\uff0c\u662f\u8ba9\u4f60\u4e0b\u610f\u8bc6\u6478\u4e00\u4e0b\u624b\u673a\u2014\u2014\u5b83\u600e\u4e48\u53ef\u80fd\u53d1\u51fa\u8fd9\u79cd\u58f0\u97f3\uff1f\u4f46\u5982\u679c\u4f60\u53ea\u7528\u4e86\u4e00\u6b21\u9ed8\u8ba4\u8bbe\u7f6e\uff0c\u4f60\u6c38\u8fdc\u4e0d\u77e5\u9053\u8fd9\u73a9\u610f\u513f\u80fd\u5e72\u561b\u3002",
    "\u6253\u5f00\u5e94\u7528\uff0c\u70b9\u90a3\u4e2aBoost\u6ed1\u5757\uff0c\u76f4\u63a5\u62c9\u5230\u6700\u53f3\u8fb9\u3002\u4e0d\u662f\u4e00\u70b9\u70b9\uff0c\u662f200%\u3002\u7136\u540e\u5207\u5230\u97f3\u4e50\u6a21\u5f0f\uff0c\u628a60Hz\u90a3\u6863\u63a8\u9ad8\u4e24\u683c\u3002\u73b0\u5728\u968f\u4fbf\u653e\u4e00\u9996Kendrick Lamar\u6216\u8005The Weeknd\uff0c\u542c\u542c\u90a3\u4e2a\u4f4e\u97f3\u662f\u4e0d\u662f\u50cf\u4ece\u5730\u677f\u4e0b\u9762\u6d8c\u4e0a\u6765\u7684\u3002\u8fd9\u5c31\u662f\u6211\u71ac\u591c\u5199\u4ee3\u7801\u65f6\u8111\u5b50\u91cc\u56de\u54cd\u7684\u58f0\u97f3\u2014\u2014\u4f60\u624b\u673a\u91cc\u4e00\u76f4\u85cf\u7740\u7684\u90a3\u4e2a\u3002",
    "\u73b0\u5728\u5c31\u8bd5\u8bd5\u3002\u522b\u7b49\u201c\u6709\u7a7a\u7684\u65f6\u5019\u201d\uff0c\u56e0\u4e3a\u90a3\u901a\u5e38\u610f\u5473\u7740\u6c38\u8fdc\u3002P.S. \u5982\u679c\u4f60\u89c9\u5f97\u8fd8\u4e0d\u591f\uff0cPremium\u89e3\u9501\u4e86\u5b8c\u657410\u6bb5EQ\u548c\u65e0\u9650Boost\u2014\u2014\u4f46\u4f60\u5f97\u5148\u77e5\u9053\u9ed8\u8ba4\u8bbe\u7f6e\u6709\u591a\u5f3a\u3002"
  ],
