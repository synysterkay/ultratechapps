  "preview_text": "\ub2f9\uc2e0\uc758 \uc9c1\uac10\uc774 \ud56d\uc0c1 \ud2c0\ub9ac\ub294 \uc774\uc720, \ub370\uc774\ud130\uac00 \ub9d0\ud574\uc90d\ub2c8\ub2e4. \uc9c0\uae08 \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "\ucd95\uad6c \uacbd\uae30 \ubcf4\uba74\uc11c '\uc774\uac74 \ubb34\uc870\uac74 \uc774\uae34\ub2e4' \uc0dd\uac01\ud588\ub294\ub370, \ub9c9\uc0c1 \uacb0\uacfc\ub294 \ubc18\ub300\uc600\ub358 \uc801 \uc788\uc8e0? \uc800\ub3c4 \uc218\uc5c6\uc774 \ub2f9\ud588\uc2b5\ub2c8\ub2e4. \uadf8\ub7f0\ub370 \ucd5c\uadfc\uc5d0 \uc54c\uac8c \ub41c \uc0ac\uc2e4 \ud558\ub098\uac00 \ubaa8\ub4e0 \uac78 \ubc14\uafe8\uc5b4\uc694.",
