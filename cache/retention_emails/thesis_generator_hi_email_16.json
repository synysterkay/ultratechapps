{
  "subject": "\u092e\u0948\u0902\u0928\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u092c\u0928\u093e\u092f\u093e \u0939\u0948, \u092a\u094d\u0932\u093e\u0928 \u0928\u0939\u0940\u0902 \u0925\u093e \u0936\u0947\u092f\u0930 \u0915\u0930\u0928\u093e",
  "preview_text": "\u090f\u0915 \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u092b\u0940\u091a\u0930 \u091c\u094b 90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u0928\u0939\u0940\u0902 \u092a\u0924\u093e\u0964 \u0916\u094b\u0932\u094b \u0914\u0930 \u0905\u092a\u0928\u0947 \u092a\u0947\u092a\u0930 \u0915\u094b \u092c\u0926\u0932 \u0926\u094b\u0964 \u0905\u0902\u0926\u0930 \u091c\u093e\u0928\u094b\u0964",
  "body_paragraphs": [
    "\u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u0939\u0948, \u0915\u0932 \u0930\u093e\u0924 \u092e\u0948\u0902 \u0915\u094b\u0921\u093f\u0902\u0917 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e \u0914\u0930 \u0905\u091a\u093e\u0928\u0915 \u090f\u0915 \u0906\u0907\u0921\u093f\u092f\u093e \u0906\u092f\u093e\u0964 \u092e\u0948\u0902\u0928\u0947 \u0915\u0941\u091b \u090f\u0915\u094d\u0938\u094d\u091f\u094d\u0930\u093e \u092c\u0928\u093e\u092f\u093e\u2014\u0935\u094b \u092d\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f\u0964 \u092a\u094d\u0932\u093e\u0928 \u0928\u0939\u0940\u0902 \u0925\u093e \u0907\u0938\u0947 \u0936\u0947\u092f\u0930 \u0915\u0930\u0928\u0947 \u0915\u093e, \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u0938\u094b\u091a\u093e \u0915\u094d\u092f\u094b\u0902 \u0928\u093e \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092f\u0947 \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c\u093c \u0926\u0942\u0902\u0964",
    "\u092f\u0947 \u091a\u0940\u091c\u093c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0925\u0940\u0938\u093f\u0938 \u0930\u093e\u0907\u091f\u093f\u0902\u0917 \u0915\u094b \u0914\u0930 \u092d\u0940 \u0906\u0938\u093e\u0928 \u092c\u0928\u093e \u0926\u0947\u0917\u0940\u0964 \u0924\u0941\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u094b \u0915\u093f Thesis Generator \u0924\u0941\u092e\u094d\u0939\u0947\u0902 8 \u0918\u0902\u091f\u0947 \u0915\u0940 \u092e\u0947\u0939\u0928\u0924 \u0938\u0947 \u092c\u091a\u093e\u0924\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0905\u092c \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0928\u092f\u093e \u092b\u0940\u091a\u0930 \u091c\u094b\u0921\u093c\u093e \u0939\u0948\u2014\u090f\u0915 \u0911\u091f\u094b-\u0930\u093f\u0938\u0930\u094d\u091a \u0905\u0938\u093f\u0938\u094d\u091f\u0947\u0902\u091f \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u091f\u0949\u092a\u093f\u0915 \u0915\u0947 \u0932\u093f\u090f \u092c\u0947\u0938\u094d\u091f \u0930\u093f\u0938\u0930\u094d\u091a \u092a\u0947\u092a\u0930\u094d\u0938, \u0938\u094d\u091f\u0921\u0940\u091c\u093c \u0914\u0930 \u0921\u0947\u091f\u093e \u0916\u094b\u091c\u0915\u0930 \u0932\u093e\u0924\u093e \u0939\u0948\u0964 \u0938\u093f\u0930\u094d\u092b 2 \u0915\u094d\u0932\u093f\u0915 \u092e\u0947\u0902\u0964",
    "\u0907\u0938\u0947 \u0910\u0938\u0947 \u0938\u092e\u091d\u094b\u2014\u091c\u092c \u0924\u0941\u092e \u0905\u092a\u0928\u093e \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u091c\u0928\u0930\u0947\u091f \u0915\u0930\u0924\u0947 \u0939\u094b, \u0924\u094b \u0905\u092c \u0910\u092a \u0924\u0941\u092e\u094d\u0939\u0947\u0902 3-5 \u0930\u093f\u0932\u0947\u0935\u0947\u0902\u091f \u0930\u093f\u0938\u0930\u094d\u091a \u092a\u0947\u092a\u0930\u094d\u0938 \u092d\u0940 \u0926\u093f\u0916\u093e\u090f\u0917\u093e, \u091c\u093f\u0928\u092e\u0947\u0902 \u0938\u0947 \u0924\u0941\u092e \u0938\u0940\u0927\u0947 \u0938\u093e\u0907\u091f\u0947\u0936\u0928 \u0915\u0949\u092a\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964 \u092f\u0947 \u0935\u094b \u090f\u0915\u094d\u0938\u094d\u091f\u094d\u0930\u093e \u092c\u094b\u0928\u0938 \u0939\u0948 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0905\u092d\u0940-\u0905\u092d\u0940 \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964 \u0924\u0941\u092e \u0907\u0938\u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u094b\u0917\u0947 \u0924\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u0947\u092a\u0930 \u0914\u0930 \u092d\u0940 \u092a\u094d\u0930\u094b\u092b\u0947\u0936\u0928\u0932 \u0932\u0917\u0947\u0917\u093e\u0964",
    "\u0905\u092c \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0905\u092a\u0928\u093e \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u0926\u094b\u092c\u093e\u0930\u093e \u091c\u0928\u0930\u0947\u091f \u0915\u0930\u094b\u2014\u0924\u0941\u092e\u094d\u0939\u0947\u0902 'Bonus Research' \u0915\u093e \u0911\u092a\u094d\u0936\u0928 \u092e\u093f\u0932\u0947\u0917\u093e\u0964 \u0907\u0938\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u094b \u0914\u0930 \u0926\u0947\u0916\u094b \u0915\u0948\u0938\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0930\u093f\u0938\u0930\u094d\u091a \u092a\u0939\u0932\u0947 \u0938\u0947 \u0915\u0939\u0940\u0902 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u092e\u091c\u092c\u0942\u0924 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u2014 \u092f\u0947 \u092b\u0940\u091a\u0930 \u0938\u093f\u0930\u094d\u092b 48 \u0918\u0902\u091f\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915\u094d\u0938\u0947\u0938\u093f\u092c\u0932 \u0939\u0948, \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u092e\u0948\u0902 \u0907\u0938\u0947 \u0939\u091f\u093e \u0926\u0942\u0902\u0917\u093e\u0964 \u091c\u0932\u094d\u0926\u0940 \u0915\u0930\u094b\u0964"
  ],
