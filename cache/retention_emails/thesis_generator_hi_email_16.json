{
  "subject": "\u090f\u0915 \u091a\u0940\u091c\u093c \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u092c\u0928\u093e\u0908 \u0939\u0948",
  "preview_text": "\u0938\u094b\u091a\u093e \u0928\u0939\u0940\u0902 \u0925\u093e \u0915\u093f \u092f\u0939 \u0936\u0947\u092f\u0930 \u0915\u0930\u0942\u0902\u0917\u093e, \u0932\u0947\u0915\u093f\u0928 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092a\u0947\u092a\u0930 \u0915\u094b \u092c\u091a\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u0939 \u0930\u093e\u0924 \u091c\u092c \u0924\u0941\u092e 2 \u092c\u091c\u0947 \u0924\u0915 \u091c\u093e\u0917\u0924\u0947 \u0930\u0939\u0947 \u0914\u0930 \u0925\u0940\u0938\u093f\u0938 \u0915\u093e \u090f\u0915 \u0936\u092c\u094d\u0926 \u092d\u0940 \u0928\u0939\u0940\u0902 \u0932\u093f\u0916 \u092a\u093e\u090f? \u092e\u0948\u0902 \u0935\u0939\u093e\u0901 \u0925\u093e\u0964 \u0914\u0930 \u0924\u092c \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e\u2014\u0915\u093e\u0936 \u0915\u094b\u0908 \u0910\u0938\u093e \u091f\u0942\u0932 \u0939\u094b\u0924\u093e \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0925\u0940\u0938\u093f\u0938 \u0928\u0939\u0940\u0902 \u092c\u0928\u093e\u0924\u093e, \u092c\u0932\u094d\u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u0942\u0930\u093e \u092a\u0947\u092a\u0930 \u0932\u093f\u0916 \u0926\u0947\u0924\u093e\u0964 \u0924\u094b \u092e\u0948\u0902\u0928\u0947 \u0915\u0941\u091b \u092c\u0928\u093e\u092f\u093e\u0964 \u0914\u0930 \u092e\u0948\u0902 \u092f\u0939 \u0936\u0947\u092f\u0930 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u0928\u0939\u0940\u0902 \u0925\u093e\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0924\u0941\u092e\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u0905\u092a\u0928\u0940 \u0925\u0940\u0938\u093f\u0938 \u091c\u0947\u0928\u0930\u0947\u091f \u0928\u0939\u0940\u0902 \u0915\u0940 \u0939\u0948\u0964 \u0936\u093e\u092f\u0926 \u0924\u0941\u092e \u0938\u094b\u091a \u0930\u0939\u0947 \u0939\u094b \u0915\u093f \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0914\u0930 \u0910\u092a \u0939\u0948\u0964 \u092a\u0930 \u092f\u0939 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u0935\u0939 \u091a\u0940\u091c\u093c \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0921\u0930 \u0915\u094b \u0916\u0924\u094d\u092e \u0915\u0930 \u0938\u0915\u0924\u0940 \u0939\u0948\u2014\u092c\u094d\u0932\u0948\u0902\u0915 \u092a\u0947\u091c \u0915\u093e \u0921\u0930, \u0921\u0947\u0921\u0932\u093e\u0907\u0928 \u0915\u093e \u0921\u0930, \u0914\u0930 AI \u0921\u093f\u091f\u0947\u0915\u094d\u0936\u0928 \u0915\u093e \u0921\u0930\u0964 \u092e\u0948\u0902\u0928\u0947 \u0907\u0938\u0947 \u0916\u093e\u0938 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964",
    "\u0905\u0902\u0926\u093e\u091c\u093c\u093e \u0932\u0917\u093e\u0913? \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0928\u092f\u093e \u092b\u0940\u091a\u0930 \u091c\u094b\u0921\u093c\u093e \u0939\u0948\u2014\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u092a\u0942\u0930\u0947 \u092a\u0947\u092a\u0930 \u092e\u0947\u0902 \u092c\u0926\u0932 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0917\u094d\u0930\u093e\u092b\u093c, \u091f\u0947\u092c\u0932, \u0938\u093e\u0907\u091f\u0947\u0936\u0928\u2014\u0938\u092c \u0905\u092a\u0928\u0947 \u0906\u092a\u0964 \u0914\u0930 \u0939\u093e\u0901, \u092f\u0939 Turnitin \u0915\u094b \u092c\u093e\u092f\u092a\u093e\u0938 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092c\u0938 \u0913\u092a\u0928 \u0915\u0930\u0928\u093e \u0939\u0948 \u0914\u0930 '\u0925\u0940\u0938\u093f\u0938 \u091f\u0942 \u092a\u0947\u092a\u0930' \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0928\u093e \u0939\u0948\u0964 \u092f\u0939 \u0910\u0938\u093e \u0939\u0948 \u091c\u0948\u0938\u0947 \u092e\u0948\u0902 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0938\u093e\u0925 \u092c\u0948\u0920\u093e \u0939\u0942\u0901 \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u0947\u092a\u0930 \u0932\u093f\u0916 \u0930\u0939\u093e \u0939\u0942\u0901\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u0925\u0940\u0938\u093f\u0938 \u091f\u0942 \u092a\u0947\u092a\u0930' \u092b\u0940\u091a\u0930 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u0906\u091c \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u091c\u092c \u0924\u0941\u092e \u092f\u0939 \u0915\u0930\u094b\u0917\u0947, \u0924\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u090f\u0915 \u092c\u094b\u0928\u0938 \u092e\u093f\u0932\u0947\u0917\u093e\u2014\u090f\u0915 \u092b\u094d\u0930\u0940 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0915\u092d\u0940 \u0915\u093f\u0938\u0940 \u0915\u094b \u0928\u0939\u0940\u0902 \u0926\u093f\u092f\u093e\u0964"
  ],
