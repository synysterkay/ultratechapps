{
  "subject": "\u0421\u0435\u043a\u0440\u0435\u0442\u043d\u044b\u0439 \u043f\u0440\u0435\u0441\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u044f \u0441\u043e\u0437\u0434\u0430\u043b \u0432 3 \u0447\u0430\u0441\u0430 \u043d\u043e\u0447\u0438",
  "preview_text": "\u042f \u043d\u0435 \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043b \u044d\u0442\u043e \u0432\u044b\u043f\u0443\u0441\u043a\u0430\u0442\u044c. \u041d\u043e \u043f\u043e\u0441\u043b\u0435 35 \u0434\u043d\u0435\u0439 \u0442\u0435\u0441\u0442\u043e\u0432 \u043f\u043e\u043d\u044f\u043b \u2014 \u0442\u044b \u0434\u043e\u043b\u0436\u0435\u043d \u044d\u0442\u043e \u0443\u0441\u043b\u044b\u0448\u0430\u0442\u044c. \u041e\u0442\u043a\u0440\u043e\u0439 Bass Booster.",
  "body_paragraphs": [
    "\u041d\u0430 \u043f\u0440\u043e\u0448\u043b\u043e\u0439 \u043d\u0435\u0434\u0435\u043b\u0435 \u044f \u0441\u0438\u0434\u0435\u043b \u0441 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u043c\u0438 \u0432 3 \u0447\u0430\u0441\u0430 \u043d\u043e\u0447\u0438. \u041e\u0431\u044b\u0447\u043d\u044b\u0439 \u0442\u0440\u0435\u043a \u2014 \u0438 \u0432\u0434\u0440\u0443\u0433 \u044f \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u0431\u0430\u0441 \u043f\u0440\u043e\u043f\u0430\u0434\u0430\u0435\u0442 \u043d\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0435. \u0417\u0432\u0443\u043a \u043f\u043b\u043e\u0441\u043a\u0438\u0439, \u043a\u0430\u043a \u0434\u043e\u0441\u043a\u0430. \u042f \u0440\u0430\u0437\u043e\u0437\u043b\u0438\u043b\u0441\u044f. \u0412\u043a\u043b\u044e\u0447\u0438\u043b Bass Booster, \u043f\u043e\u043a\u0440\u0443\u0442\u0438\u043b \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440, \u0434\u043e\u0431\u0430\u0432\u0438\u043b \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440 \u2014 \u0438 \u0443\u0441\u043b\u044b\u0448\u0430\u043b \u0442\u043e, \u0447\u0435\u0433\u043e \u043d\u0435 \u0436\u0434\u0430\u043b. \u0423\u0434\u0430\u0440 \u0432 \u0433\u0440\u0443\u0434\u0438, \u0434\u0430\u0436\u0435 \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u0448\u0451\u0432\u044b\u0435 \u0437\u0430\u0442\u044b\u0447\u043a\u0438.",
    "\u042f \u043d\u0435 \u0441\u043e\u0431\u0438\u0440\u0430\u043b\u0441\u044f \u044d\u0442\u043e \u043d\u0438\u043a\u043e\u043c\u0443 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c. \u042d\u0442\u043e \u0431\u044b\u043b \u043c\u043e\u0439 \u043b\u0438\u0447\u043d\u044b\u0439 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442. \u041d\u043e \u043f\u043e\u0442\u043e\u043c \u043f\u043e\u0434\u0443\u043c\u0430\u043b: \u0435\u0441\u043b\u0438 \u044f \u044d\u0442\u043e \u043d\u0430\u0448\u0451\u043b, \u0442\u044b \u0442\u043e\u0436\u0435 \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u0448\u044c. \u0412\u043a\u043b\u044e\u0447\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u2014 \u0442\u0430\u043c \u0436\u0434\u0451\u0442 \u043d\u043e\u0432\u044b\u0439 \u0441\u043a\u0440\u044b\u0442\u044b\u0439 \u043f\u0440\u0435\u0441\u0435\u0442. \u042f \u043d\u0430\u0437\u0432\u0430\u043b \u0435\u0433\u043e \u00ab3AM Punch\u00bb. \u041e\u043d \u0432\u044b\u0436\u0438\u043c\u0430\u0435\u0442 \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c \u0438\u0437 \u0442\u0432\u043e\u0438\u0445 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u043e\u0432: \u0431\u0430\u0441 \u0431\u044c\u0451\u0442, \u0430 \u043d\u0435 \u0433\u0443\u0434\u0438\u0442.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Bass Booster, \u043f\u0435\u0440\u0435\u0439\u0434\u0438 \u0432 \u0440\u0430\u0437\u0434\u0435\u043b \u043f\u0440\u0435\u0441\u0435\u0442\u043e\u0432 \u0438 \u043d\u0430\u0439\u0434\u0438 \u00ab3AM Punch\u00bb. \u042d\u0442\u043e \u043d\u0435 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0430\u044f \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u2014 \u044f \u0434\u043e\u0431\u0430\u0432\u0438\u043b +200% \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438 \u0438 \u0441\u0434\u0432\u0438\u043d\u0443\u043b \u0447\u0430\u0441\u0442\u043e\u0442\u044b \u0442\u0430\u043a, \u0447\u0442\u043e\u0431\u044b \u043a\u0430\u0436\u0434\u044b\u0439 \u0443\u0434\u0430\u0440 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b \u0441\u043a\u0432\u043e\u0437\u044c \u043f\u0430\u043b\u044c\u0446\u044b. \u0414\u0430\u0436\u0435 \u043d\u0430 \u0442\u0438\u0445\u0438\u0445 \u043a\u043e\u043b\u043e\u043d\u043a\u0430\u0445 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044c \u0440\u0430\u0437\u043d\u0438\u0446\u0443.",
    "\u0421\u0434\u0435\u043b\u0430\u0439 \u044d\u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441, \u043f\u043e\u043a\u0430 \u044f \u043d\u0435 \u043f\u0435\u0440\u0435\u0434\u0443\u043c\u0430\u043b \u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f. \u041f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u0432\u044b\u0431\u0435\u0440\u0438 \u043f\u0440\u0435\u0441\u0435\u0442. P.S. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u044d\u0442\u043e\u0442 \u0437\u0432\u0443\u043a \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u2014 \u043f\u0440\u0435\u043c\u0438\u0443\u043c \u0434\u0430\u0451\u0442 \u043d\u0435\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u043a\u043e \u0432\u0441\u0435\u043c \u043a\u0430\u0441\u0442\u043e\u043c\u043d\u044b\u043c \u043f\u0440\u0435\u0441\u0435\u0442\u0430\u043c. \u041d\u043e \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0441\u043b\u0443\u0448\u0430\u0439."
  ],
