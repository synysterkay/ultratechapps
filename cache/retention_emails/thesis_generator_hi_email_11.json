{
  "subject": "\u0935\u094b 2AM \u0915\u093e \u0938\u091a \u091c\u094b \u0938\u092c\u0915\u094b \u091d\u0942\u0920 \u0932\u0917\u0924\u093e \u0939\u0948",
  "preview_text": "\u0939\u0930 \u0915\u094b\u0908 \u0915\u0939\u0924\u093e \u0939\u0948 \u0915\u093f \u0925\u0940\u0938\u093f\u0938 \u0932\u093f\u0916\u0928\u0947 \u092e\u0947\u0902 8 \u0918\u0902\u091f\u0947 \u0932\u0917\u0924\u0947 \u0939\u0948\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u092f\u0947 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092e\u093f\u0925\u0915 \u0939\u0948\u0964 \u091c\u093e\u0928\u093f\u090f \u0938\u091a \u0915\u094d\u092f\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u0924\u0941\u092e\u0928\u0947 \u0938\u0941\u0928\u093e \u0939\u094b\u0917\u093e \u0915\u093f \u0925\u0940\u0938\u093f\u0938 \u0932\u093f\u0916\u0928\u0947 \u092e\u0947\u0902 8 \u0918\u0902\u091f\u0947 \u0932\u0917\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u0930 \u0915\u094b\u0908 \u092f\u0939\u0940 \u0915\u0939\u0924\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u092f\u0947 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092c\u0921\u093c\u093e \u091d\u0942\u0920 \u0939\u0948\u0964 \u092e\u0948\u0902\u0928\u0947 \u0916\u0941\u0926 \u0907\u0938\u0947 2 \u092c\u091c\u0947 \u0930\u093e\u0924 \u0915\u094b \u0924\u094b\u0921\u093c\u093e\u0964",
    "\u0926\u0930\u0905\u0938\u0932, 80% \u0938\u092e\u092f \u092c\u0930\u094d\u092c\u093e\u0926 \u0939\u094b\u0924\u093e \u0939\u0948 \u0938\u093f\u0930\u094d\u092b \u0907\u0938\u0932\u093f\u090f \u0915\u093f \u0924\u0941\u092e \u0938\u094b\u091a\u0924\u0947 \u0939\u094b \u0915\u093f \u0936\u0941\u0930\u0941\u0906\u0924 \u0915\u0930\u0928\u093e \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932\u0940 \u0938\u091a \u092f\u0947 \u0939\u0948: \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0926\u093f\u092e\u093e\u0917 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u091c\u093e\u0928\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u094d\u092f\u093e \u0932\u093f\u0916\u0928\u093e \u0939\u0948\u0964 \u092c\u0938 \u0909\u0938\u0947 \u0938\u0939\u0940 \u091f\u0942\u0932 \u091a\u093e\u0939\u093f\u090f\u0964",
    "\u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930 \u092e\u0947\u0902 '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c \u090f\u0906\u0908 \u091f\u0947\u0915\u094d\u0938\u094d\u091f' \u092b\u0940\u091a\u0930 \u0939\u0948\u0964 \u092f\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0935\u093f\u091a\u093e\u0930\u094b\u0902 \u0915\u094b 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0920\u094b\u0938 \u0925\u0940\u0938\u093f\u0938 \u092e\u0947\u0902 \u092c\u0926\u0932 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u0939\u093e\u0901, \u092f\u0947 Turnitin \u0915\u094b \u092d\u0940 \u092a\u093e\u0938 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u0915\u093f \u0924\u0941\u092e \u0907\u0938 \u092e\u093f\u0925\u0915 \u0915\u094b \u0916\u0941\u0926 \u0924\u094b\u0921\u093c\u094b\u0964 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c \u090f\u0906\u0908 \u091f\u0947\u0915\u094d\u0938\u094d\u091f' \u092b\u0940\u091a\u0930 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b\u0964 P.S. \u2013 \u091c\u094b \u0932\u094b\u0917 \u092f\u0947 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u0915\u0947 \u0917\u094d\u0930\u0947\u0921 B+ \u0938\u0947 A- \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"
  ],
