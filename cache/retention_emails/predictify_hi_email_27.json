{
  "subject": "\u0939\u092e\u0928\u0947 10,000 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u093e \u0921\u0947\u091f\u093e \u0926\u0947\u0916\u093e \u0914\u0930 \u090f\u0915 \u091a\u094c\u0902\u0915\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u092c\u093e\u0924 \u092a\u093e\u0908",
  "preview_text": "\u0915\u094d\u092f\u093e \u0906\u092a \u092d\u0940 \u0935\u0939\u0940 \u0917\u0932\u0924\u0940 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902 \u091c\u094b 80% \u092b\u0941\u091f\u092c\u0949\u0932 \u092b\u0948\u0902\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902? \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947 \u0906\u092a \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u094b \u092c\u0947\u0939\u0924\u0930 \u092c\u0928\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",
  "body_paragraphs": [
    "\u0939\u092e\u0928\u0947 \u092a\u093f\u091b\u0932\u0947 63 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 10,000 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u092a\u0948\u091f\u0930\u094d\u0928 \u0915\u093e \u090f\u0928\u093e\u0932\u093f\u0938\u093f\u0938 \u0915\u093f\u092f\u093e\u0964 \u0928\u0924\u0940\u091c\u093e? 80% \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u092f\u0942\u091c\u0930\u094d\u0938 \u0935\u0939\u0940 \u0917\u0932\u0924\u0940 \u0926\u094b\u0939\u0930\u093e\u0924\u0947 \u0939\u0948\u0902: \u0935\u0947 \u0938\u093f\u0930\u094d\u092b \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091f\u0940\u092e \u092f\u093e \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938\u0938\u0947 \u0909\u0928\u0915\u0947 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u0940 \u0938\u091f\u0940\u0915\u0924\u093e \u0938\u093f\u0930\u094d\u092b 30-40% \u0930\u0939 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u092f\u0939\u093e\u0901 \u090f\u0915 \u091f\u094d\u0935\u093f\u0938\u094d\u091f \u0939\u0948: \u091c\u093f\u0928 \u092f\u0942\u091c\u0930\u094d\u0938 \u0928\u0947 \u0939\u092e\u093e\u0930\u0947 AI \u0915\u0947 \u0921\u0947\u091f\u093e-\u092c\u0948\u0915\u094d\u0921 \u0907\u0928\u0938\u093e\u0907\u091f\u094d\u0938 \u0915\u094b \u092b\u0949\u0932\u094b \u0915\u093f\u092f\u093e, \u0909\u0928\u0915\u0940 \u0938\u091f\u0940\u0915\u0924\u093e 70% \u0938\u0947 \u090a\u092a\u0930 \u092a\u0939\u0941\u0902\u091a \u0917\u0908\u0964 \u0909\u0926\u093e\u0939\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f, \u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u0915\u0947 \u092e\u0948\u091a \u092e\u0947\u0902 \u092e\u0948\u0928\u091a\u0947\u0938\u094d\u091f\u0930 \u0938\u093f\u091f\u0940 vs \u0906\u0930\u094d\u0938\u0947\u0928\u0932 \u0915\u093e \u090f\u0928\u093e\u0932\u093f\u0938\u093f\u0938 \u0939\u092e\u0928\u0947 \u092a\u092c\u094d\u0932\u093f\u0936 \u0915\u093f\u092f\u093e \u0925\u093e\u2014\u091c\u093f\u0938\u092e\u0947\u0902 AI \u0928\u0947 75% \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0921\u094d\u0930\u0949 \u0915\u093e \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u0915\u094d\u092f\u093e \u0906\u092a\u0928\u0947 \u0935\u0939 \u0926\u0947\u0916\u093e \u0925\u093e?",
    "\u0905\u092c \u0938\u094b\u091a\u093f\u090f: \u0905\u0917\u0930 \u0906\u092a \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u0940 \u0921\u0947\u091f\u093e-\u0921\u094d\u0930\u093f\u0935\u0928 \u0907\u0928\u0938\u093e\u0907\u091f\u094d\u0938 \u092a\u093e \u0938\u0915\u0947\u0902, \u0924\u094b \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u093f\u0924\u0928\u0940 \u0938\u091f\u0940\u0915 \u0939\u094b\u0917\u0940? \u0939\u092e\u093e\u0930\u093e AI \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f xG, \u092a\u0949\u091c\u0947\u0936\u0928, \u0914\u0930 \u0921\u093f\u092b\u0947\u0902\u0938\u093f\u0935 \u0938\u094d\u091f\u094d\u0930\u0947\u0902\u0925 \u091c\u0948\u0938\u0947 \u0939\u091c\u093e\u0930\u094b\u0902 \u0935\u0947\u0930\u093f\u090f\u092c\u0932\u094d\u0938 \u0915\u093e \u090f\u0928\u093e\u0932\u093f\u0938\u093f\u0938 \u0915\u0930\u0915\u0947 \u090f\u0915 \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0906\u092a \u0907\u0938\u0947 \u0905\u092a\u0928\u0947 \u0917\u0947\u092e \u092e\u0947\u0902 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0905\u092c \u090f\u0915 \u0915\u093e\u092e \u0915\u0930\u0947\u0902: \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0921\u0947\u091f\u093e \u0907\u0928\u0938\u093e\u0907\u091f\u094d\u0938' \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u091c\u093e\u090f\u0902\u0964 \u0935\u0939\u093e\u0901 \u0906\u091c \u0915\u093e \u0938\u092c\u0938\u0947 \u0926\u093f\u0932\u091a\u0938\u094d\u092a \u092e\u0948\u091a \u0916\u094b\u091c\u0947\u0902 \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f AI \u0915\u094d\u092f\u093e \u0915\u0939\u0924\u093e \u0939\u0948\u0964 P.S. \u0905\u0917\u0930 \u0906\u092a\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 (3 \u0926\u093f\u0928 \u092b\u094d\u0930\u0940) \u0928\u0939\u0940\u0902 \u0932\u093f\u092f\u093e \u0939\u0948, \u0924\u094b \u092f\u0939\u0940 \u092e\u094c\u0915\u093e \u0939\u0948\u2014\u0906\u092a\u0915\u094b \u0938\u092d\u0940 \u0932\u0940\u0917\u094d\u0938 \u0915\u0947 \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u0938\u094d\u091f\u0948\u091f\u094d\u0938 \u0914\u0930 \u0905\u0938\u0940\u092e\u093f\u0924 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u092e\u093f\u0932\u0947\u0902\u0917\u0947\u0964"
  ],
