{
  "subject": "\u0939\u092e\u0928\u0947 10,000 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u093e \u0921\u0947\u091f\u093e \u0926\u0947\u0916\u093e \u0914\u0930 \u090f\u0915 \u092c\u0921\u093c\u0940 \u0917\u0932\u0924\u0940 \u092a\u0915\u0921\u093c\u0940",
  "preview_text": "\u091c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u092f\u0939 \u090f\u0915 \u092b\u0940\u091a\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947, \u0914\u0930 \u0909\u0928\u0915\u0940 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u090f\u0915\u094d\u092f\u0942\u0930\u0947\u0938\u0940 40% \u0915\u092e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u0938\u091a \u0915\u0939\u0942\u0902? \u0939\u092e\u0947\u0902 \u0916\u0941\u0926 \u092a\u0930 \u0936\u0930\u094d\u092e \u0906 \u0930\u0939\u0940 \u0939\u0948\u0964 \u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u0939\u092e\u0928\u0947 \u0905\u092a\u0928\u0947 10,000 \u090f\u0915\u094d\u091f\u093f\u0935 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u093e \u0921\u0947\u091f\u093e \u0921\u0940\u092a \u090f\u0928\u093e\u0932\u093f\u0938\u093f\u0938 \u0915\u0947 \u0932\u093f\u090f \u0930\u0916\u093e\u0964 \u090f\u0915 \u092a\u0948\u091f\u0930\u094d\u0928 \u0939\u092e\u093e\u0930\u0940 \u0906\u0902\u0916\u094b\u0902 \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u0925\u093e, \u091c\u093f\u0938\u0947 \u0939\u092e\u0928\u0947 \u092e\u0939\u0940\u0928\u094b\u0902 \u0924\u0915 \u0928\u091c\u093c\u0930\u0905\u0902\u0926\u093e\u091c\u093c \u0915\u093f\u092f\u093e\u0964",
    "\u0928\u0924\u0940\u091c\u093e \u091a\u094c\u0902\u0915\u093e \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u093e \u0925\u093e\u0964 \u091c\u094b \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0939\u0930 \u092e\u0948\u091a \u0938\u0947 \u092a\u0939\u0932\u0947 'AI Chat' \u092e\u0947\u0902 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0938\u0935\u093e\u0932 \u092a\u0942\u091b\u0924\u0947 \u0939\u0948\u0902 - '\u0907\u0938 \u092e\u0948\u091a \u0915\u093e \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u090f\u0915\u094d\u0938-\u092b\u0948\u0915\u094d\u091f\u0930 \u0915\u094d\u092f\u093e \u0939\u0948?' - \u0909\u0928\u0915\u0940 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u090f\u0915\u094d\u092f\u0942\u0930\u0947\u0938\u0940 73% \u0939\u0948\u0964 \u092c\u093e\u0915\u0940 \u092f\u0942\u091c\u093c\u0930\u094d\u0938? \u0938\u093f\u0930\u094d\u092b 33%\u0964 \u092f\u0939 \u0915\u094b\u0908 \u091b\u094b\u091f\u093e \u0905\u0902\u0924\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u0917\u0947\u092e-\u091a\u0947\u0902\u091c\u0930 \u0939\u0948\u0964",
    "AI Chat \u0938\u093f\u0930\u094d\u092b \u0938\u0935\u093e\u0932-\u091c\u0935\u093e\u092c \u0915\u093e \u092b\u0940\u091a\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u0935\u094b \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0935\u0947\u092a\u0928 \u0939\u0948 \u091c\u094b 90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0905\u0928\u0926\u0947\u0916\u093e \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0905\u0917\u0932\u0947 \u092e\u0948\u091a \u0938\u0947 \u092a\u0939\u0932\u0947, \u0909\u0938\u0938\u0947 \u092a\u0942\u091b\u094b: '\u0926\u094b\u0928\u094b\u0902 \u091f\u0940\u092e\u094b\u0902 \u0915\u0940 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u0915\u092e\u091c\u094b\u0930\u0940 \u0915\u094d\u092f\u093e \u0939\u0948?' \u092f\u093e '\u0906\u091c \u0915\u0947 \u092e\u0948\u091a \u092e\u0947\u0902 \u0915\u094c\u0928 \u0938\u093e \u092a\u094d\u0932\u0947\u092f\u0930 \u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u092e\u0948\u091a-\u0935\u093f\u0928\u0930 \u092c\u0928 \u0938\u0915\u0924\u093e \u0939\u0948?'\u0964 \u091c\u0935\u093e\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 10 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0906 \u091c\u093e\u090f\u0917\u093e\u0964",
    "\u0905\u092a\u0928\u0947 \u0905\u0917\u0932\u0947 \u092e\u0948\u091a \u0915\u0940 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0938\u0947 \u092a\u0939\u0932\u0947, AI Chat \u0916\u094b\u0932\u094b \u0914\u0930 \u092f\u0939 \u0938\u0935\u093e\u0932 \u0921\u093e\u0932\u094b: '\u0906\u091c \u0915\u0947 \u092e\u0948\u091a \u092e\u0947\u0902 \u0938\u092c\u0938\u0947 \u0905\u0902\u0921\u0930\u0930\u0947\u091f\u0947\u0921 \u0935\u0948\u0932\u094d\u092f\u0942 \u092c\u0947\u091f \u0915\u094d\u092f\u093e \u0939\u0948?'\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u091c\u0935\u093e\u092c \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0964 P.S. \u0907\u0938\u0940 \u0939\u092b\u094d\u0924\u0947, \u091c\u093f\u0928 5 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0928\u0947 AI Chat \u0915\u093e \u0938\u092c\u0938\u0947 \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e, \u0909\u0928\u094d\u0939\u0947\u0902 \u0939\u092e\u0928\u0947 \u092b\u094d\u0930\u0940 \u092e\u0947\u0902 1 \u092e\u0939\u0940\u0928\u0947 \u0915\u0940 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u092d\u0947\u091c\u0940 \u0939\u0948\u0964 \u0905\u0917\u0932\u093e \u0928\u093e\u092e \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948\u0964"
