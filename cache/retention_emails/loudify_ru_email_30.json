{
  "subject": "\u0422\u0432\u043e\u044f \u0430\u0443\u0434\u0438\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0436\u0434\u0435\u0442 1 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0443",
  "preview_text": "\u0422\u044b \u0443\u0436\u0435 70 \u0434\u043d\u0435\u0439 \u0441 Loudify. \u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u2014 \u044d\u0442\u043e \u0442\u0432\u043e\u0439 \u0441\u043b\u0435\u0434 \u0432 \u043c\u0438\u0440\u0435 \u0437\u0432\u0443\u043a\u0430. \u0423\u0437\u043d\u0430\u0439, \u0447\u0442\u043e \u0434\u0430\u043b\u044c\u0448\u0435.",
  "body_paragraphs": [
    "70 \u0434\u043d\u0435\u0439 \u043d\u0430\u0437\u0430\u0434 \u0442\u044b \u0441\u043a\u0430\u0447\u0430\u043b Loudify. \u0421 \u0442\u0435\u0445 \u043f\u043e\u0440 \u0442\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043b\u0443\u0448\u0430\u043b \u2014 \u0442\u044b \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043b, \u0443\u043b\u0443\u0447\u0448\u0430\u043b, \u0434\u0435\u043b\u0430\u043b \u0437\u0432\u0443\u043a \u0441\u0432\u043e\u0438\u043c. \u041d\u043e \u0437\u043d\u0430\u0435\u0448\u044c \u0447\u0442\u043e? \u042d\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0447\u0430\u043b\u043e. \u041a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0437, \u043a\u043e\u0433\u0434\u0430 \u0442\u044b \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0430\u0435\u0448\u044c \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438, \u0442\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0448\u044c \u0442\u0440\u0435\u043a \u2014 \u0442\u044b \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0448\u044c \u0432 \u043c\u0438\u0441\u0441\u0438\u0438: \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0447\u0438\u0441\u0442\u043e\u0439, \u0430 \u0442\u0438\u0448\u0438\u043d\u0443 \u2014 \u043e\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u043d\u043e\u0439.",
    "\u0422\u044b \u2014 \u0447\u0430\u0441\u0442\u044c \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u0433\u0434\u0435 100 000+ \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0443\u0436\u0435 \u043f\u043e\u043d\u044f\u043b\u0438: \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0439 \u0441\u043b\u0430\u0439\u0434\u0435\u0440 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438 \u2014 \u044d\u0442\u043e \u0441\u0442\u0435\u043d\u0430, \u0430 \u043d\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442. Loudify \u043b\u043e\u043c\u0430\u0435\u0442 \u044d\u0442\u0443 \u0441\u0442\u0435\u043d\u0443. \u0422\u0432\u043e\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438 \u0442\u0435\u043f\u0435\u0440\u044c \u0437\u043d\u0430\u044e\u0442, \u043a\u0442\u043e \u0442\u044b, \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f AutoEQ, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0434 \u043a\u0430\u0436\u0434\u0443\u044e \u043c\u043e\u0434\u0435\u043b\u044c. \u041d\u043e \u0435\u0441\u0442\u044c \u043a\u043e\u0435-\u0447\u0442\u043e, \u0447\u0442\u043e \u0442\u044b \u0443\u043f\u0443\u0441\u043a\u0430\u0435\u0448\u044c.",
    "\u0422\u0432\u043e\u0439 Sound DNA \u2014 \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0446\u0438\u0444\u0440\u044b. \u042d\u0442\u043e \u0442\u0432\u043e\u0439 \u0430\u0443\u0434\u0438\u043e-\u043f\u043e\u0447\u0435\u0440\u043a: \u043a\u0430\u043a \u0442\u044b \u0441\u043b\u0443\u0448\u0430\u0435\u0448\u044c, \u043a\u043e\u0433\u0434\u0430, \u043d\u0430 \u043a\u0430\u043a\u0438\u0445 \u0447\u0430\u0441\u0442\u043e\u0442\u0430\u0445. \u041d\u043e \u0442\u044b \u0432\u0438\u0434\u0438\u0448\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u044e\u044e \u043d\u0435\u0434\u0435\u043b\u044e. \u041f\u0440\u0435\u043c\u0438\u0443\u043c \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043f\u043e\u043b\u043d\u0443\u044e \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u2014 \u043c\u0435\u0441\u044f\u0446\u044b \u0442\u0432\u043e\u0438\u0445 \u043f\u0440\u0438\u0432\u044b\u0447\u0435\u043a, \u0433\u0440\u0430\u0444\u0438\u043a\u0438, \u0438\u043d\u0441\u0430\u0439\u0442\u044b. \u042d\u0442\u043e \u043a\u0430\u043a \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0441\u0432\u043e\u0439 \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u043e\u0437\u0433 \u0432 \u0440\u0430\u0437\u0440\u0435\u0437\u0435. \u0418 \u044d\u0442\u043e \u043c\u0435\u043d\u044f\u0435\u0442 \u0432\u0441\u0451.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Loudify \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u0437\u0430\u0433\u043b\u044f\u043d\u0438 \u0432 \u0441\u0432\u043e\u0439 Sound DNA \u0437\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 70 \u0434\u043d\u0435\u0439. \u0422\u044b \u0443\u0434\u0438\u0432\u0438\u0448\u044c\u0441\u044f, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u0431\u0435\u0437 \u043f\u043e\u043b\u043d\u043e\u0439 \u043a\u0430\u0440\u0442\u0438\u043d\u044b. P.S. \u041f\u0440\u0435\u043c\u0438\u0443\u043c-\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u0443\u0436\u0435 \u0441\u0442\u0440\u043e\u044f\u0442 \u0441\u0432\u043e\u044e \u0430\u0443\u0434\u0438\u043e-\u0438\u0441\u0442\u043e\u0440\u0438\u044e. \u0425\u043e\u0447\u0435\u0448\u044c \u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u044c\u0441\u044f? \u041d\u0430\u0436\u043c\u0438 \u043d\u0430 \u043a\u043d\u043e\u043f\u043a\u0443 \u2014 \u043e\u0434\u0438\u043d \u0442\u0430\u043f, \u0438 \u0442\u044b \u0443\u0432\u0438\u0434\u0438\u0448\u044c, \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0433\u043b\u0443\u0431\u0436\u0435 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0437\u0432\u0443\u043a."
  ],
