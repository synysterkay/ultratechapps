{
  "subject": "\u0930\u093e\u091c\u0947\u0936 \u0915\u0940 2AM \u0915\u0939\u093e\u0928\u0940 \u091c\u093f\u0938\u0928\u0947 \u0939\u092e\u0947\u0902 \u0930\u094b\u0915 \u0926\u093f\u092f\u093e",
  "preview_text": "\u091c\u092c \u0909\u0938\u0928\u0947 \u0905\u092a\u0928\u0947 AirPods \u0938\u0947\u091f \u0915\u093f\u090f, \u0924\u094b \u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u091a\u0941\u092a \u0939\u094b \u0917\u0908\u0964 \u092a\u0922\u093c\u093f\u090f \u0915\u094d\u092f\u094b\u0902\u0964",
  "body_paragraphs": [
    "\u0930\u093e\u091c\u0947\u0936 \u0928\u0947 \u0939\u092e\u0947\u0902 \u090f\u0915 \u0930\u093e\u0924 2AM \u092a\u0930 \u092e\u0947\u0932 \u0915\u093f\u092f\u093e\u0964 \u0909\u0938\u0928\u0947 \u0932\u093f\u0916\u093e, '\u092e\u0948\u0902\u0928\u0947 \u0906\u092a\u0915\u093e \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e, \u0932\u0947\u0915\u093f\u0928 \u0915\u0941\u091b \u0916\u093e\u0938 \u0928\u0939\u0940\u0902 \u0932\u0917\u093e\u0964 \u092b\u093f\u0930 \u090f\u0915 \u0926\u093f\u0928 \u092e\u0948\u0902\u0928\u0947 '\u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c' \u092c\u091f\u0928 \u0926\u092c\u093e\u092f\u093e\u0964' \u0935\u0939 \u0906\u0917\u0947 \u092c\u094b\u0932\u093e, '\u092e\u0947\u0930\u0940 \u091f\u094d\u0930\u0947\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u092e\u0947\u0902, \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u093e \u0939\u0930 \u0936\u092c\u094d\u0926 \u0938\u0941\u0928\u093e\u0964 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930\u0964' \u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0928\u0947 \u092f\u0939 \u092a\u0922\u093c\u093e \u0914\u0930 \u0938\u092c \u091a\u0941\u092a \u0939\u094b \u0917\u090f\u0964 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092f\u0939\u0940 \u0935\u0939 \u092a\u0932 \u0939\u0948 \u091c\u093f\u0938\u0915\u0947 \u0932\u093f\u090f \u0939\u092e\u0928\u0947 Loud EQ \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964",
    "\u0930\u093e\u091c\u0947\u0936 \u0915\u0940 \u0924\u0930\u0939, \u0906\u092a \u0936\u093e\u092f\u0926 \u0938\u094b\u091a\u0924\u0947 \u0939\u094b\u0902 \u0915\u093f \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u0938\u0947 \u0938\u092c \u0920\u0940\u0915 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0938\u091a \u092f\u0939 \u0939\u0948 \u0915\u093f \u091c\u092c \u0906\u092a 100% \u092a\u0930 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902, \u0924\u092c \u092d\u0940 \u0906\u0935\u093e\u091c\u093c \u0927\u0941\u0902\u0927\u0932\u0940 \u0914\u0930 \u0915\u0930\u094d\u0915\u0936 \u0932\u0917\u0924\u0940 \u0939\u0948\u0964 Loud EQ \u0915\u093e '\u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c' \u092c\u091f\u0928 \u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u094b \u092a\u0922\u093c\u0924\u093e \u0939\u0948\u2014\u091a\u093e\u0939\u0947 \u0935\u0939 \u0935\u093e\u092f\u0930\u094d\u0921 \u0939\u094b \u092f\u093e \u092c\u094d\u0932\u0942\u091f\u0942\u0925\u2014\u0914\u0930 \u0909\u0938\u0947 \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u091f\u094d\u092f\u0942\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u0939\u0930\u094d\u0937\u0928\u0947\u0938 \u0928\u0939\u0940\u0902, \u0938\u093f\u0930\u094d\u092b \u0938\u093e\u092b \u0914\u0930 \u0924\u0947\u091c\u093c \u0906\u0935\u093e\u091c\u093c\u0964",
    "\u0930\u093e\u091c\u0947\u0936 \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0909\u0938\u0928\u0947 \u090f\u0915 \u092c\u093e\u0930 \u0905\u092a\u0928\u0947 AirPods \u0915\u094b \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u093f\u092f\u093e \u0914\u0930 \u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c \u0926\u092c\u093e\u092f\u093e\u0964 \u0909\u0938\u0915\u0947 \u092c\u093e\u0926, \u0935\u0939 \u0939\u0930 \u0926\u093f\u0928 \u091f\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u0924\u093e \u0939\u0948, \u092c\u093f\u0928\u093e \u0915\u093e\u0928\u094b\u0902 \u092a\u0930 \u0926\u092c\u093e\u0935 \u0921\u093e\u0932\u0947\u0964 Loud EQ \u0915\u093e '\u0939\u093f\u092f\u0930\u093f\u0902\u0917-\u0938\u0947\u092b \u0938\u094d\u091f\u094d\u0930\u0940\u0915' \u092b\u0940\u091a\u0930 \u0909\u0938\u0947 \u092f\u093e\u0926 \u0926\u093f\u0932\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0935\u0939 \u0915\u093f\u0924\u0928\u0947 \u0926\u093f\u0928\u094b\u0902 \u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0947\u0902\u091c \u092e\u0947\u0902 \u0938\u0941\u0928 \u0930\u0939\u093e \u0939\u0948\u0964 \u092f\u0939 \u091b\u094b\u091f\u0940 \u0938\u0940 \u0906\u0926\u0924 \u0928\u0947 \u0909\u0938\u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u094b \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964",
    "\u0906\u091c \u0939\u0940 \u0905\u092a\u0928\u093e '\u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c' \u092c\u091f\u0928 \u0926\u092c\u093e\u090f\u0902\u0964 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902, \u0910\u092a \u0916\u094b\u0932\u0947\u0902, \u0914\u0930 \u090f\u0915 \u092c\u093e\u0930 \u0926\u092c\u093e\u090f\u0902\u0964 \u092b\u093f\u0930 \u0938\u0941\u0928\u0947\u0902 \u0915\u093f \u0906\u092a \u0915\u093f\u0924\u0928\u093e \u0915\u0941\u091b \u092e\u093f\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0925\u0947\u0964 P.S. \u0930\u093e\u091c\u0947\u0936 \u0928\u0947 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0932\u093f\u092f\u093e \u0914\u0930 \u0905\u092c \u0935\u0939 \u0930\u094b\u091c\u093c +200% \u092c\u0942\u0938\u094d\u091f \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u093e \u0939\u0948\u2014\u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0915\u0947\u0964 \u0915\u094d\u092f\u093e \u0906\u092a \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0902?"
  ],
  "cta_text": "\u0932\u093e\u0909\u0921 EQ \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c \u0915\u0930\u0947\u0902",
