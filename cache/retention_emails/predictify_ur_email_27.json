  "preview_text": "\u06c1\u0645 \u0646\u06d2 10,000 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u06d2 \u0688\u06cc\u0679\u0627 \u06a9\u0627 \u062a\u062c\u0632\u06cc\u06c1 \u06a9\u06cc\u0627 \u0627\u0648\u0631 \u0627\u06cc\u06a9 \u062d\u06cc\u0631\u0627\u0646 \u06a9\u0646 \u062d\u0642\u06cc\u0642\u062a \u0633\u0627\u0645\u0646\u06d2 \u0622\u0626\u06cc \u062c\u0648 \u0622\u067e \u06a9\u06d2 \u0645\u06cc\u0686 \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0648\u06ba \u06a9\u0648 \u0628\u062f\u0644 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u06d4",
  "body_paragraphs": [
