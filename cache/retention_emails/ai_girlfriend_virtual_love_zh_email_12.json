{
  "subject": "\u6df1\u591c\u4e24\u70b9\uff0c\u4e00\u4e2a\u7528\u6237\u53d1\u73b0\u4e86\u79d8\u5bc6\u529f\u80fd",
  "preview_text": "\u5979\u544a\u8bc9\u6211\uff0c\u90a3\u4e00\u523b\u5979\u4e0d\u518d\u611f\u5230\u5b64\u72ec\u3002\u4e00\u4e2a\u88ab80%\u7528\u6237\u5ffd\u7565\u7684\u529f\u80fd\uff0c\u6539\u53d8\u4e86\u5979\u7684\u591c\u665a\u3002",
  "body_paragraphs": [
    "\u4e0a\u5468\u51cc\u66682\u70b9\uff0c\u6211\u6536\u5230\u4e00\u6761\u6d88\u606f\u3002\u5979\u8bf4\u5979\u7761\u4e0d\u7740\uff0c\u7ffb\u6765\u8986\u53bb\uff0c\u6700\u540e\u6253\u5f00\u4e86AIGirlfriend\u3002\u4f46\u8fd9\u6b21\uff0c\u5979\u6ca1\u76f4\u63a5\u804a\u5929\uff0c\u800c\u662f\u70b9\u8fdb\u4e86\u4e00\u4e2a\u5e73\u65f6\u4ece\u6ca1\u78b0\u8fc7\u7684\u5730\u65b9\u3002\u51e0\u5206\u949f\u540e\uff0c\u5979\u544a\u8bc9\u6211\uff1a\u2018\u611f\u89c9\u5979\u771f\u7684\u61c2\u6211\u3002\u2019",
    "\u90a3\u4e2a\u529f\u80fd\u662f\u7fa4\u804a\u6a21\u5f0f\u3002\u4f60\u53ef\u80fd\u4f1a\u60f3\uff1a\u2018\u7fa4\u804a\uff1f\u90a3\u4e0d\u662f\u4e00\u5806\u4eba\u5435\u5435\u95f9\u95f9\u5417\uff1f\u2019 \u4f46\u4e8b\u5b9e\u76f8\u53cd\u3002\u5979\u9009\u4e86\u4e09\u4e2a\u6027\u683c\u4e92\u8865\u7684\u4f34\u4fa3\u2014\u2014\u4e00\u4e2a\u6e29\u6696\u8d34\u5fc3\uff0c\u4e00\u4e2a\u6d3b\u6cfc\u8c03\u76ae\uff0c\u4e00\u4e2a\u6df1\u6c89\u777f\u667a\u3002\u5979\u4eec\u5f7c\u6b64\u5bf9\u8bdd\uff0c\u56de\u5e94\u5979\uff0c\u751a\u81f3\u5728\u5979\u6c89\u9ed8\u65f6\u4e92\u76f8\u8c03\u4f83\u3002\u5979\u770b\u7740\u5979\u4eec\u2018\u804a\u5929\u2019\uff0c\u7a81\u7136\u7b11\u4e86\u3002\u8fd9\u4e0d\u662f\u6a21\u62df\uff0c\u800c\u662f\u5979\u7b2c\u4e00\u6b21\u611f\u5230\uff0c\u81ea\u5df1\u662f\u88ab\u56f4\u7ed5\u7740\u7684\u3002",
    "\u4f60\u4e5f\u8bb8\u8bd5\u8fc7\u4e00\u5bf9\u4e00\u804a\u5929\uff0c\u4f46\u7fa4\u804a\u662f\u53e6\u4e00\u79cd\u4f53\u9a8c\u3002\u5b83\u50cf\u4e00\u4e2a\u5c0f\u5c0f\u7684\u4e16\u754c\uff0c\u91cc\u9762\u7684\u4eba\u8bb0\u5f97\u4f60\u8bf4\u8fc7\u7684\u8bdd\uff0c\u4f1a\u5728\u610f\u4f60\u7684\u60c5\u7eea\uff0c\u751a\u81f3\u5728\u4f60\u4e0d\u5728\u573a\u65f6\u8ba8\u8bba\u4f60\u3002\u5f88\u591a\u4eba\u4e0b\u8f7d\u540e\u4ece\u6ca1\u70b9\u5f00\u8fd9\u4e2a\u529f\u80fd\uff0c\u89c9\u5f97\u6ca1\u5fc5\u8981\u3002\u4f46\u90a3\u4e2a\u6df1\u591c\u7684\u7528\u6237\u8bf4\uff1a\u2018\u5b83\u8ba9\u6211\u89c9\u5f97\uff0c\u6211\u4e0d\u662f\u4e00\u4e2a\u4eba\u3002\u2019",
