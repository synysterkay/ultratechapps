  "subject": "28 \u0e27\u0e31\u0e19\u0e01\u0e31\u0e1a Predictify \u2014 \u0e2a\u0e16\u0e34\u0e15\u0e34\u0e17\u0e35\u0e48\u0e04\u0e38\u0e13\u0e44\u0e21\u0e48\u0e04\u0e27\u0e23\u0e1e\u0e25\u0e32\u0e14",
  "preview_text": "\u0e04\u0e38\u0e13\u0e17\u0e33\u0e2d\u0e30\u0e44\u0e23\u0e44\u0e1b\u0e1a\u0e49\u0e32\u0e07\u0e43\u0e19 28 \u0e27\u0e31\u0e19\u0e19\u0e35\u0e49? \u0e21\u0e32\u0e14\u0e39\u0e04\u0e27\u0e32\u0e21\u0e01\u0e49\u0e32\u0e27\u0e2b\u0e19\u0e49\u0e32\u0e17\u0e35\u0e48\u0e04\u0e38\u0e13\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e44\u0e27\u0e49",
  "body_paragraphs": [
    "\u0e1c\u0e48\u0e32\u0e19\u0e21\u0e32 28 \u0e27\u0e31\u0e19\u0e41\u0e25\u0e49\u0e27\u0e19\u0e31\u0e1a\u0e08\u0e32\u0e01\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48\u0e04\u0e38\u0e13\u0e14\u0e32\u0e27\u0e19\u0e4c\u0e42\u0e2b\u0e25\u0e14 Predictify \u2014 \u0e40\u0e14\u0e37\u0e2d\u0e19\u0e41\u0e23\u0e01\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e43\u0e19\u0e01\u0e32\u0e23\u0e40\u0e1b\u0e47\u0e19\u0e41\u0e1f\u0e19\u0e1a\u0e2d\u0e25\u0e17\u0e35\u0e48\u0e09\u0e25\u0e32\u0e14\u0e02\u0e36\u0e49\u0e19 \u0e25\u0e2d\u0e07\u0e19\u0e36\u0e01\u0e14\u0e39: \u0e04\u0e38\u0e13\u0e40\u0e04\u0e22\u0e40\u0e14\u0e32\u0e1c\u0e25\u0e1a\u0e2d\u0e25\u0e41\u0e1a\u0e1a\u0e21\u0e31\u0e48\u0e27\u0e46 \u0e01\u0e48\u0e2d\u0e19\u0e2b\u0e19\u0e49\u0e32\u0e19\u0e35\u0e49\u0e01\u0e35\u0e48\u0e04\u0e23\u0e31\u0e49\u0e07? \u0e41\u0e15\u0e48\u0e15\u0e2d\u0e19\u0e19\u0e35\u0e49\u0e04\u0e38\u0e13\u0e21\u0e35 AI \u0e17\u0e35\u0e48\u0e27\u0e34\u0e40\u0e04\u0e23\u0e32\u0e30\u0e2b\u0e4c\u0e2b\u0e25\u0e32\u0e22\u0e1e\u0e31\u0e19\u0e15\u0e31\u0e27\u0e41\u0e1b\u0e23\u0e15\u0e48\u0e2d\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e41\u0e21\u0e15\u0e0a\u0e4c\u0e43\u0e2b\u0e49\u0e04\u0e38\u0e13 \u0e23\u0e39\u0e49\u0e2a\u0e36\u0e01\u0e14\u0e35\u0e43\u0e0a\u0e48\u0e44\u0e2b\u0e21\u0e17\u0e35\u0e48\u0e40\u0e25\u0e34\u0e01\u0e40\u0e14\u0e32\u0e41\u0e25\u0e49\u0e27\u0e40\u0e23\u0e34\u0e48\u0e21\u0e23\u0e39\u0e49\u0e08\u0e23\u0e34\u0e07",
    "\u0e43\u0e19 28 \u0e27\u0e31\u0e19\u0e19\u0e35\u0e49 \u0e04\u0e38\u0e13\u0e44\u0e14\u0e49\u0e40\u0e2b\u0e47\u0e19\u0e01\u0e32\u0e23\u0e04\u0e32\u0e14\u0e01\u0e32\u0e23\u0e13\u0e4c\u0e08\u0e32\u0e01 AI \u0e17\u0e35\u0e48\u0e41\u0e21\u0e48\u0e19\u0e22\u0e33\u0e23\u0e30\u0e14\u0e31\u0e1a 70-80% \u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e25\u0e35\u0e01\u0e43\u0e2b\u0e0d\u0e48\u0e46 \u0e2d\u0e22\u0e48\u0e32\u0e07\u0e1e\u0e23\u0e35\u0e40\u0e21\u0e35\u0e22\u0e23\u0e4c\u0e25\u0e35\u0e01 \u0e25\u0e32\u0e25\u0e35\u0e01\u0e32 \u0e2b\u0e23\u0e37\u0e2d\u0e1a\u0e38\u0e19\u0e40\u0e14\u0e2a\u0e25\u0e35\u0e01\u0e32 \u0e04\u0e38\u0e13\u0e2d\u0e32\u0e08\u0e08\u0e30\u0e1e\u0e25\u0e32\u0e14\u0e04\u0e48\u0e32\u0e40\u0e14\u0e34\u0e21\u0e1e\u0e31\u0e19\u0e14\u0e35\u0e46 \u0e44\u0e1b\u0e1a\u0e49\u0e32\u0e07 \u0e40\u0e1e\u0e23\u0e32\u0e30\u0e44\u0e21\u0e48\u0e21\u0e31\u0e48\u0e19\u0e43\u0e08\u0e43\u0e19\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25 \u2014 \u0e41\u0e15\u0e48\u0e15\u0e2d\u0e19\u0e19\u0e35\u0e49\u0e04\u0e38\u0e13\u0e21\u0e35\u0e2a\u0e16\u0e34\u0e15\u0e34 xG, \u0e04\u0e27\u0e32\u0e21\u0e41\u0e02\u0e47\u0e07\u0e41\u0e01\u0e23\u0e48\u0e07\u0e40\u0e01\u0e21\u0e23\u0e31\u0e1a, \u0e41\u0e25\u0e30\u0e1b\u0e23\u0e30\u0e27\u0e31\u0e15\u0e34\u0e01\u0e32\u0e23\u0e40\u0e08\u0e2d\u0e01\u0e31\u0e19\u0e43\u0e19\u0e21\u0e37\u0e2d\u0e04\u0e38\u0e13\u0e41\u0e25\u0e49\u0e27",
    "\u0e25\u0e2d\u0e07\u0e40\u0e1b\u0e34\u0e14\u0e41\u0e2d\u0e1b\u0e41\u0e25\u0e49\u0e27\u0e14\u0e39 '\u0e2a\u0e16\u0e34\u0e15\u0e34\u0e2a\u0e48\u0e27\u0e19\u0e15\u0e31\u0e27' \u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e2a\u0e34 \u2014 \u0e04\u0e38\u0e13\u0e21\u0e35\u0e2a\u0e15\u0e23\u0e35\u0e04\u0e01\u0e35\u0e48\u0e27\u0e31\u0e19\u0e41\u0e25\u0e49\u0e27? \u0e21\u0e35\u0e41\u0e15\u0e49\u0e21\u0e2a\u0e30\u0e2a\u0e21\u0e40\u0e17\u0e48\u0e32\u0e44\u0e23? \u0e41\u0e25\u0e30\u0e17\u0e35\u0e48\u0e40\u0e14\u0e47\u0e14\u0e04\u0e37\u0e2d 'IQ Quiz' \u0e17\u0e35\u0e48\u0e43\u0e2b\u0e49\u0e04\u0e38\u0e13\u0e17\u0e14\u0e2a\u0e2d\u0e1a\u0e04\u0e27\u0e32\u0e21\u0e23\u0e39\u0e49\u0e1f\u0e38\u0e15\u0e1a\u0e2d\u0e25\u0e01\u0e31\u0e1a AI \u0e42\u0e14\u0e22\u0e15\u0e23\u0e07 \u0e04\u0e38\u0e13\u0e2d\u0e32\u0e08\u0e08\u0e30\u0e15\u0e34\u0e14\u0e2d\u0e31\u0e19\u0e14\u0e31\u0e1a\u0e17\u0e47\u0e2d\u0e1b 10 \u0e02\u0e2d\u0e07\u0e0a\u0e38\u0e21\u0e0a\u0e19\u0e01\u0e47\u0e44\u0e14\u0e49 \u0e2d\u0e22\u0e48\u0e32\u0e25\u0e37\u0e21\u0e43\u0e0a\u0e49\u0e1f\u0e35\u0e40\u0e08\u0e2d\u0e23\u0e4c\u0e19\u0e35\u0e49\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e1e\u0e34\u0e2a\u0e39\u0e08\u0e19\u0e4c\u0e27\u0e48\u0e32\u0e04\u0e38\u0e13\u0e04\u0e37\u0e2d\u0e41\u0e1f\u0e19\u0e1a\u0e2d\u0e25\u0e17\u0e35\u0e48\u0e40\u0e2b\u0e19\u0e37\u0e2d\u0e0a\u0e31\u0e49\u0e19",
    "\u0e04\u0e25\u0e34\u0e01\u0e17\u0e35\u0e48 '\u0e2a\u0e16\u0e34\u0e15\u0e34\u0e02\u0e2d\u0e07\u0e09\u0e31\u0e19' \u0e43\u0e19\u0e41\u0e2d\u0e1b\u0e15\u0e2d\u0e19\u0e19\u0e35\u0e49\u0e40\u0e25\u0e22 \u2014 \u0e41\u0e25\u0e49\u0e27\u0e41\u0e0a\u0e23\u0e4c\u0e04\u0e30\u0e41\u0e19\u0e19\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e01\u0e31\u0e1a\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e19\u0e43\u0e19\u0e04\u0e2d\u0e21\u0e21\u0e39\u0e19\u0e34\u0e15\u0e35\u0e49 \u0e16\u0e49\u0e32\u0e2d\u0e22\u0e32\u0e01\u0e1b\u0e25\u0e14\u0e25\u0e47\u0e2d\u0e04\u0e17\u0e38\u0e01\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e41\u0e1a\u0e1a\u0e44\u0e21\u0e48\u0e08\u0e33\u0e01\u0e31\u0e14 \u0e25\u0e2d\u0e07\u0e17\u0e14\u0e25\u0e2d\u0e07\u0e43\u0e0a\u0e49 Premium 3 \u0e27\u0e31\u0e19\u0e1f\u0e23\u0e35 \u0e41\u0e25\u0e49\u0e27\u0e04\u0e38\u0e13\u0e08\u0e30\u0e40\u0e2b\u0e47\u0e19\u0e41\u0e1c\u0e19\u0e17\u0e35\u0e48 AI \u0e21\u0e2d\u0e07\u0e40\u0e2b\u0e47\u0e19\u0e17\u0e35\u0e48\u0e04\u0e19\u0e2d\u0e37\u0e48\u0e19\u0e44\u0e21\u0e48\u0e40\u0e2b\u0e47\u0e19"
