{
  "subject": "\u0935\u0939 \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u091c\u094b \u0915\u094b\u0908 \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u0924\u093e",
  "preview_text": "\u0939\u0930 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930 \u091a\u0941\u092a\u0915\u0947 \u0938\u0947 \u0907\u0938 \u091f\u094d\u0930\u093f\u0915 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0906\u092a \u092d\u0940 \u0906\u091c\u093c\u092e\u093e\u0907\u090f\u0964",
  "body_paragraphs": [
    "\u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0906\u092a \u0905\u092d\u0940 \u0924\u0915 \u0932\u093e\u0909\u0921\u093f\u092b\u093c\u093e\u0908 \u0915\u0947 \u0905\u0938\u0932\u0940 \u0917\u0941\u092a\u094d\u0924 \u0939\u0925\u093f\u092f\u093e\u0930 \u0924\u0915 \u0928\u0939\u0940\u0902 \u092a\u0939\u0941\u0902\u091a\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0935\u0939 \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u0939\u0948 \u091c\u094b \u0939\u0930 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930 \u091a\u0941\u092a\u0915\u0947 \u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0915\u094b\u0908 \u092c\u0924\u093e\u0924\u093e \u0928\u0939\u0940\u0902\u0964 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u091c\u092c \u0906\u092a \u092f\u0939 \u091c\u093e\u0928 \u0932\u0947\u0902\u0917\u0947, \u0924\u094b \u0906\u092a \u0915\u092d\u0940 \u092a\u0941\u0930\u093e\u0928\u0947 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0935\u093e\u092a\u0938 \u0928\u0939\u0940\u0902 \u091c\u093e\u090f\u0902\u0917\u0947\u0964",
    "\u092c\u093e\u0924 \u092f\u0939 \u0939\u0948: \u091c\u092c \u0906\u092a \u0939\u0930 \u0930\u094b\u091c\u093c \u091f\u094d\u0930\u0947\u0928, \u0915\u093f\u091a\u0928 \u092f\u093e \u090f\u0938\u0940 \u0915\u0947 \u0936\u094b\u0930 \u092e\u0947\u0902 \u0911\u0921\u093f\u092f\u094b\u092c\u0941\u0915 \u092f\u093e \u092e\u094d\u092f\u0942\u091c\u093c\u093f\u0915 \u0938\u0941\u0928\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0926\u0940\u0935\u093e\u0930 \u0938\u0947 \u091f\u0915\u0930\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930 \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0905\u0938\u0932\u0940 \u091a\u093e\u0932 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0938\u0939\u0940 \u092b\u093c\u094d\u0930\u0940\u0915\u094d\u0935\u0947\u0902\u0938\u0940 \u092a\u0930 \u092b\u093c\u094b\u0915\u0938 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0939\u0948\u0964 \u0935\u0947 \u0905\u092a\u0928\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u094b \u0936\u094b\u0930 \u0938\u0947 \u0905\u0932\u0917 \u0915\u0930\u0915\u0947 \u0938\u093f\u0930\u094d\u092b\u093c \u0921\u093e\u092f\u0932\u0949\u0917 \u092f\u093e \u092c\u0940\u091f \u0915\u094b \u0938\u093e\u092b\u093c \u0938\u0941\u0928\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0932\u093e\u0909\u0921\u093f\u092b\u093c\u093e\u0908 \u092e\u0947\u0902 \u090f\u0915 \u0910\u0938\u0940 \u092b\u093c\u0940\u091a\u0930 \u0939\u0948 \u091c\u093f\u0938\u0947 \u0939\u092e '\u0915\u0938\u094d\u091f\u092e \u092c\u0942\u0938\u094d\u091f \u0938\u094d\u092a\u0949\u091f' \u0915\u0939\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b 10-\u092c\u0948\u0902\u0921 EQ \u092e\u0947\u0902 \u090f\u0915 \u0916\u093e\u0938 \u092b\u093c\u094d\u0930\u0940\u0915\u094d\u0935\u0947\u0902\u0938\u0940 \u0930\u0947\u0902\u091c \u091a\u0941\u0928\u0928\u0947 \u0926\u0947\u0924\u0940 \u0939\u0948 \u091c\u0939\u093e\u0901 \u0906\u092a\u0915\u094b \u0938\u092c\u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u091c\u093c\u0930\u0942\u0930\u0924 \u0939\u0948\u0964 \u091c\u0948\u0938\u0947, \u091f\u094d\u0930\u0947\u0928 \u0915\u0947 \u0936\u094b\u0930 \u092e\u0947\u0902 400Hz \u092a\u0930 \u092c\u0942\u0938\u094d\u091f \u0915\u0930\u0947\u0902 \u0914\u0930 \u0921\u093e\u092f\u0932\u0949\u0917 \u0924\u0941\u0930\u0902\u0924 \u0938\u093e\u092b\u093c \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964 \u092f\u0939 \u0935\u0939 \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u0939\u0948 \u091c\u094b \u0939\u0930 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930 \u0905\u092a\u0928\u0947 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092e\u0947\u0902 \u091b\u0941\u092a\u093e\u0915\u0930 \u0930\u0916\u0924\u093e \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u0932\u093e\u0909\u0921\u093f\u092b\u093c\u093e\u0908 \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 10-\u092c\u0948\u0902\u0921 EQ \u092e\u0947\u0902 \u0905\u092a\u0928\u093e \u092a\u0939\u0932\u093e '\u0915\u0938\u094d\u091f\u092e \u092c\u0942\u0938\u094d\u091f \u0938\u094d\u092a\u0949\u091f' \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964 \u092c\u0938 30 \u0938\u0947\u0915\u0902\u0921 \u0932\u0917\u0947\u0902\u0917\u0947\u0964 \u0914\u0930 \u0939\u093e\u0901, \u092f\u0939 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092e\u0947\u0902 \u092d\u0940 \u092e\u0941\u092b\u093c\u094d\u0924 \u0939\u0948 \u2014 \u0915\u094b\u0908 \u092c\u0939\u093e\u0928\u093e \u0928\u0939\u0940\u0902\u0964 P.S. \u0905\u0917\u0930 \u0906\u092a \u0938\u093e\u0909\u0902\u0921 DNA \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0926\u0947\u0916\u0928\u093e \u091a\u093e\u0939\u0947\u0902, \u0924\u094b \u092f\u0939 \u0939\u092b\u093c\u094d\u0924\u0947 \u0915\u0947 \u0905\u0902\u0924 \u092e\u0947\u0902 \u0906\u092a\u0915\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948\u0964"
  ],
