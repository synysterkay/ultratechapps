{
  "subject": "\u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0936\u0930\u094d\u092e\u0928\u093e\u0915 \u0917\u0932\u0924\u0940 \u0915\u0940 \u0925\u0940, \u092f\u0939 \u0938\u091a\u094d\u091a\u093e\u0908 \u0906\u092a\u0915\u094b \u092d\u0940 \u091c\u093e\u0928\u0928\u0940 \u091a\u093e\u0939\u093f\u090f",
  "preview_text": "\u0906\u092a\u0915\u0947 \u092b\u093c\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0905\u092d\u0940 \u0924\u0915 \u0910\u0938\u0940 \u0915\u094d\u092f\u094b\u0902 \u0939\u0948? \u0907\u0938\u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u093f \u0915\u094b\u0908 \u0914\u0930 \u0938\u0941\u0928 \u0932\u0947, \u092f\u0939 \u092a\u0922\u093c\u0947\u0902...",
  "body_paragraphs": [
    "\u0915\u0932 \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 \u092a\u0941\u0930\u093e\u0928\u0947 \u092b\u093c\u094b\u0928 \u0938\u0947 \u090f\u0915 \u0917\u093e\u0928\u093e \u091a\u0932\u093e\u092f\u093e\u0964 \u0935\u0939\u0940 \u091c\u094b \u092e\u0948\u0902 \u0939\u0930 \u0926\u093f\u0928 Volume Booster \u0915\u0947 \u0938\u093e\u0925 \u0938\u0941\u0928\u0924\u093e \u0939\u0942\u0901\u0964 \u092e\u0947\u0930\u0947 \u0926\u094b\u0938\u094d\u0924 \u0928\u0947 \u092a\u0942\u091b\u093e - '\u0915\u094d\u092f\u093e \u092f\u0939\u0940 \u0935\u0939\u0940 \u0917\u093e\u0928\u093e \u0939\u0948?' \u0909\u0938\u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0907\u0924\u0928\u0940 \u092b\u094d\u0932\u0948\u091f \u0914\u0930 \u092c\u0947\u091c\u093e\u0928 \u0925\u0940, \u092e\u0941\u091d\u0947 \u0936\u0930\u094d\u092e \u0906 \u0917\u0908\u0964",
    "\u0906\u092a \u092d\u0940 \u0936\u093e\u092f\u0926 \u092f\u0939\u0940 \u0917\u0932\u0924\u0940 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u092c\u093f\u0928\u093e \u092c\u0942\u0938\u094d\u091f\u0930 \u0915\u0947, \u0906\u092a\u0915\u093e \u092b\u093c\u094b\u0928 \u0938\u093f\u0930\u094d\u092b\u093c 40% \u0915\u094d\u0937\u092e\u0924\u093e \u0938\u0947 \u0938\u093e\u0909\u0902\u0921 \u0926\u0947 \u0930\u0939\u093e \u0939\u0948\u0964 \u092c\u093e\u0938 \u0917\u093e\u092f\u092c \u0939\u0948\u0964 \u0906\u0935\u093e\u091c\u093c \u0928\u094b\u0907\u091c\u093c \u092e\u0947\u0902 \u0921\u0942\u092c \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0906\u092a \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u0947 \u0936\u092c\u094d\u0926 \u092e\u093f\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0935\u0939 \u0926\u0941\u0928\u093f\u092f\u093e \u0939\u0948 \u091c\u0939\u093e\u0901 \u0906\u092a \u0930\u0939 \u0930\u0939\u0947 \u0925\u0947 - \u0914\u0930 \u0906\u092a\u0915\u094b \u092a\u0924\u093e \u092d\u0940 \u0928\u0939\u0940\u0902 \u0925\u093e \u0915\u093f \u0915\u094d\u092f\u093e \u092e\u093f\u0938 \u0939\u094b \u0930\u0939\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u090f\u0915 \u091f\u0948\u092a \u0915\u0930\u0915\u0947 Volume Booster \u0916\u094b\u0932\u0947\u0902\u0964 Bass Booster \u0914\u0930 Loudness Enhancer ON \u0915\u0930\u0947\u0902\u0964 \u092f\u0939\u0940 \u0935\u0939 \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u092b\u093c\u094b\u0928 \u0915\u094b \u0915\u0949\u0928\u094d\u0938\u0930\u094d\u091f \u0939\u0949\u0932 \u092c\u0928\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0939\u0930 \u0928\u094b\u091f \u0938\u093e\u092b\u093c, \u0939\u0930 \u092c\u0940\u091f \u0917\u0939\u0930\u0940, \u0939\u0930 \u0936\u092c\u094d\u0926 \u0915\u094d\u0930\u093f\u0938\u094d\u092a\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 'Electronic' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902\u0964 \u0938\u093f\u0930\u094d\u092b\u093c 30 \u0938\u0947\u0915\u0902\u0921\u0964 \u092b\u093c\u0930\u094d\u0915 \u0907\u0924\u0928\u093e \u0936\u0930\u094d\u092e\u0928\u093e\u0915 \u0939\u094b\u0917\u093e \u0915\u093f \u0906\u092a \u0915\u092d\u0940 \u0935\u093e\u092a\u0938 \u0928\u0939\u0940\u0902 \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947\u0964 P.S. Premium users \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0939\u0948 \u0915\u093f Rock \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0915\u0947 \u0938\u093e\u0925 200% \u092c\u0942\u0938\u094d\u091f \u092a\u0930 \u0917\u093f\u091f\u093e\u0930 \u0938\u0941\u0928\u0928\u093e \u091c\u093c\u093f\u0902\u0926\u0917\u0940 \u092c\u0926\u0932 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u093e \u0939\u0948\u0964"
