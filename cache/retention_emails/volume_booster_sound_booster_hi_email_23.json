{
  "subject": "\u091c\u092c \u092b\u093c\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u092e \u0939\u0948, \u0924\u094b \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948",
  "preview_text": "\u092c\u093f\u0928\u093e \u0910\u092a \u0915\u0947 \u0938\u0941\u0928\u093e\u0908 \u0928\u0939\u0940\u0902 \u0926\u0947\u0924\u093e, \u092a\u0930 \u0905\u092c? \u092f\u0947 \u092b\u093c\u0930\u094d\u0915\u093c \u0936\u0930\u094d\u092e\u0928\u093e\u0915 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u094b \u0926\u093f\u0928 \u091c\u092c \u0924\u0941\u092e \u0905\u092a\u0928\u0947 \u092b\u093c\u094b\u0928 \u0915\u094b \u091c\u093c\u094b\u0930 \u0938\u0947 \u091a\u0932\u093e \u0930\u0939\u0947 \u0925\u0947, \u092a\u0930 \u0938\u092c \u0915\u0941\u091b \u0927\u0941\u0902\u0927\u0932\u093e \u0938\u0941\u0928\u093e\u0908 \u0926\u0947 \u0930\u0939\u093e \u0925\u093e? \u092c\u0938 \u092e\u0947\u0902, \u0915\u0948\u092b\u0947 \u092e\u0947\u0902, \u092f\u093e \u0918\u0930 \u092a\u0930 \u092d\u0940\u2014\u092c\u0938 \u090f\u0915 \u092c\u093e\u0924: '\u092f\u0947 \u0915\u094d\u092f\u093e \u0939\u0948?' \u0905\u092c \u0938\u094b\u091a\u094b, \u0915\u094d\u092f\u093e \u092c\u0926\u0932 \u0917\u092f\u093e? \u0924\u0941\u092e\u0928\u0947 Volume Booster - Sound Booster \u0915\u094b \u0906\u091c\u093c\u092e\u093e\u092f\u093e, \u0914\u0930 \u0905\u091a\u093e\u0928\u0915 \u0935\u0939\u0940 \u0917\u093e\u0928\u093e, \u0935\u0939\u0940 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f, \u0935\u0939\u0940 \u0935\u0940\u0921\u093f\u092f\u094b\u2014\u090f\u0915 \u0928\u0908 \u0926\u0941\u0928\u093f\u092f\u093e \u0916\u0941\u0932 \u0917\u0908\u0964 \u092b\u093c\u0930\u094d\u0915\u093c \u0907\u0924\u0928\u093e \u092c\u0921\u093c\u093e \u0939\u0948 \u0915\u093f \u092a\u0939\u0932\u0947 \u0915\u0940 \u0924\u0930\u0939 \u0938\u0941\u0928\u0928\u093e \u0905\u092c \u0936\u0930\u094d\u092e\u0928\u093e\u0915 \u0932\u0917\u0924\u093e \u0939\u0948\u0964",
    "\u092c\u093f\u0928\u093e \u0910\u092a \u0915\u0947, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092b\u093c\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u092c\u0938 \u090f\u0915 \u092b\u0941\u0938\u092b\u0941\u0938\u093e\u0939\u091f \u0925\u0940\u2014\u092c\u093e\u0938 \u0928\u0939\u0940\u0902, \u0938\u093e\u092b\u093c \u0928\u0939\u0940\u0902, \u0938\u093f\u0930\u094d\u092b\u093c \u0936\u094b\u0930\u0964 \u092a\u0930 \u0905\u092c, \u090f\u0915 \u091f\u0948\u092a \u0938\u0947, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0915\u093e\u0928 \u092e\u0947\u0902 \u0935\u094b \u092c\u093e\u0938 \u0917\u0942\u0902\u091c\u0924\u093e \u0939\u0948 \u091c\u0948\u0938\u0947 \u0915\u0949\u0928\u094d\u0938\u0930\u094d\u091f \u092e\u0947\u0902 \u0939\u094b\u0964 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u0947 \u0939\u0930 \u0936\u092c\u094d\u0926 \u0938\u093e\u092b\u093c, \u0939\u0930 \u0928\u094b\u091f \u091c\u0940\u0935\u0902\u0924\u0964 \u092f\u0947 \u0935\u0939\u0940 \u092b\u093c\u094b\u0928 \u0939\u0948, \u092a\u0930 \u0905\u092c \u092f\u0947 \u090f\u0915 \u0928\u092f\u093e \u0921\u093f\u0935\u093e\u0907\u0938 \u0932\u0917\u0924\u093e \u0939\u0948\u0964 \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u092f\u0947 \u092c\u0924\u093e\u092f\u093e \u0939\u0948\u2014\u0914\u0938\u0924\u0928 200% \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0906\u0935\u093e\u091c\u093c\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f, \u092f\u0947 \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u0930\u093f\u0935\u0947\u0932\u0947\u0936\u0928 \u0939\u0948\u0964",
    "\u0924\u094b \u0915\u094d\u092f\u093e \u0939\u0948 \u0935\u094b \u092b\u0940\u091a\u0930 \u091c\u093f\u0938\u0928\u0947 \u092f\u0947 \u091c\u093e\u0926\u0942 \u0915\u093f\u092f\u093e? \u092f\u0947 \u0939\u0948 '\u0932\u093e\u0909\u0921\u0928\u0947\u0938 \u090f\u0928\u094d\u0939\u093e\u0902\u0938\u0930'\u2014\u090f\u0915 \u091f\u0948\u092a \u0938\u0947 \u0938\u093e\u0930\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0938\u093f\u0938\u094d\u091f\u092e-\u0935\u093e\u0907\u0921 \u092c\u0942\u0938\u094d\u091f \u0915\u0930\u094b\u0964 \u0938\u094d\u092a\u0949\u091f\u093f\u092b\u093c\u093e\u0908, \u092f\u0942\u091f\u094d\u092f\u0942\u092c, \u0928\u0947\u091f\u092b\u093c\u094d\u0932\u093f\u0915\u094d\u0938\u2014\u0938\u092c \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u0905\u0917\u0930 \u0924\u0941\u092e \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092a\u0930 \u0939\u094b, \u0924\u094b \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0932\u0947\u0935\u0932\u094d\u0938 \u0914\u0930 \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 EQ \u0915\u0902\u091f\u094d\u0930\u094b\u0932\u094d\u0938 \u092e\u093f\u0932\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0947 \u0935\u094b \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092b\u093c\u094b\u0928 \u0915\u094b \u0905\u0938\u0932\u0940 \u0938\u093e\u0909\u0902\u0921 \u0938\u093f\u0938\u094d\u091f\u092e \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e\u0913, \u0914\u0930 \u092b\u093f\u0930 \u092a\u0940\u091b\u0947 \u092e\u0941\u0921\u093c\u0915\u0930 \u092e\u0924 \u0926\u0947\u0916\u0928\u093e\u0964",
    "\u0905\u092c \u0935\u0939\u0940 \u0915\u0930\u094b \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092a\u0938\u0902\u0926 \u0939\u0948\u2014\u0910\u092a \u0916\u094b\u0932\u094b, \u0932\u093e\u0909\u0921\u0928\u0947\u0938 \u090f\u0928\u094d\u0939\u093e\u0902\u0938\u0930 \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u094b, \u0914\u0930 \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u0947 \u0915\u094b \u092b\u093f\u0930 \u0938\u0947 \u0938\u0941\u0928\u094b\u0964 \u092f\u0915\u0940\u0928 \u092e\u093e\u0928\u094b, \u092f\u0947 \u0935\u094b \u0905\u0928\u0941\u092d\u0935 \u0939\u0948 \u091c\u093f\u0938\u0947 \u0924\u0941\u092e \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u092d\u0942\u0932\u094b\u0917\u0947\u0964 \n\nP.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u092a\u0930 \u0935\u093f\u091a\u093e\u0930 \u0915\u0930\u094b\u2014\u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0915\u0947 \u0938\u093e\u0925, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092b\u093c\u094b\u0928 \u090f\u0915 \u0928\u0908 \u0926\u0941\u0928\u093f\u092f\u093e \u0916\u094b\u0932 \u0926\u0947\u0917\u093e\u0964"
  ],
