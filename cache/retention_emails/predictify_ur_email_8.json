{
  "subject": "\u0648\u06c1 \u0635\u0627\u0631\u0641 \u062c\u0633 \u0646\u06d2 \u0645\u06cc\u0631\u06d2 \u062a\u0645\u0627\u0645 \u0627\u0646\u062f\u0627\u0632\u06d2 \u063a\u0644\u0637 \u062b\u0627\u0628\u062a \u06a9\u0631 \u062f\u06cc\u06d2",
  "preview_text": "\u0627\u0633 \u0646\u06d2 \u0627\u067e\u0646\u06d2 \u0648\u062c\u062f\u0627\u0646 \u06a9\u0648 \u0686\u06cc\u0644\u0646\u062c \u06a9\u06cc\u0627 \u0627\u0648\u0631 \u0646\u062a\u0627\u0626\u062c \u062f\u06cc\u06a9\u06be \u06a9\u0631 \u062d\u06cc\u0631\u0627\u0646 \u0631\u06c1 \u06af\u06cc\u0627\u06d4 \u0622\u067e \u0628\u06be\u06cc \u067e\u0691\u06be\u06cc\u06ba",
  "body_paragraphs": [
    "\u0627\u06cc\u06a9 \u0635\u0627\u0631\u0641 \u062a\u06be\u0627\u060c \u0639\u0644\u06cc\u06d4 \u0648\u06c1 \u06c1\u0645\u06cc\u0634\u06c1 \u06a9\u06c1\u062a\u0627 \u062a\u06be\u0627 \u06a9\u06c1 \u0641\u0679 \u0628\u0627\u0644 \u0645\u06cc\u06ba \u0645\u06cc\u0631\u0627 \u0648\u062c\u062f\u0627\u0646 \u06a9\u0628\u06be\u06cc \u063a\u0644\u0637 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u062a\u0627\u06d4 \u0644\u06cc\u06a9\u0646 \u062c\u0628 \u0627\u0633 \u0646\u06d2 Predictify \u0622\u0632\u0645\u0627\u06cc\u0627\u060c \u062a\u0648 \u0627\u06cc\u06a9 \u0645\u06cc\u0686 \u0646\u06d2 \u0627\u0633 \u06a9\u06cc \u0633\u0627\u0631\u06cc \u0633\u0648\u0686 \u0628\u062f\u0644 \u062f\u06cc\u06d4 \u0627\u0633 \u0646\u06d2 \u0627\u067e\u0646\u06cc \u067e\u0633\u0646\u062f\u06cc\u062f\u06c1 \u0679\u06cc\u0645 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0627\u06cc\u06a9 \u067e\u06cc\u0634 \u06af\u0648\u0626\u06cc \u06a9\u06cc\u060c \u0644\u06cc\u06a9\u0646 AI \u0646\u06d2 \u0627\u0633\u06d2 65% \u0627\u0639\u062a\u0645\u0627\u062f \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062c\u06be\u0679\u0644\u0627\u06cc\u0627\u06d4 \u0627\u0633 \u0646\u06d2 \u0633\u0648\u0686\u0627 \u06cc\u06c1 \u063a\u0644\u0637 \u06c1\u06d2\u060c \u0644\u06cc\u06a9\u0646 \u0627\u0633 \u0646\u06d2 \u062f\u06cc\u06a9\u06be\u0646\u06d2 \u06a9\u0627 \u0641\u06cc\u0635\u0644\u06c1 \u06a9\u06cc\u0627\u06d4",
    "\u0627\u0633 \u0645\u06cc\u0686 \u0645\u06cc\u06ba\u060c \u0627\u0633 \u06a9\u06cc \u0679\u06cc\u0645 \u0648\u06c1\u06cc \u063a\u0644\u0637\u06cc\u0627\u06ba \u06a9\u0631 \u0631\u06c1\u06cc \u062a\u06be\u06cc \u062c\u0648 AI \u0646\u06d2 \u0628\u062a\u0627\u0626\u06cc \u062a\u06be\u06cc\u06ba\u06d4 \u067e\u06c1\u0644\u06d2 \u06c1\u0627\u0641 \u06a9\u06d2 \u0628\u0639\u062f\u060c \u0627\u0633\u06d2 \u0627\u062d\u0633\u0627\u0633 \u06c1\u0648\u0627 \u06a9\u06c1 \u0627\u0633 \u06a9\u0627 \u0648\u062c\u062f\u0627\u0646 \u0635\u0631\u0641 \u062c\u0630\u0628\u0627\u062a \u067e\u0631 \u0645\u0628\u0646\u06cc \u062a\u06be\u0627\u060c \u062c\u0628\u06a9\u06c1 AI \u06a9\u06d2 \u067e\u0627\u0633 \u0688\u06cc\u0679\u0627 \u062a\u06be\u0627\u06d4 \u0627\u0633 \u0646\u06d2 \u062f\u0648\u0633\u0631\u06d2 \u06c1\u0627\u0641 \u06a9\u06d2 \u0644\u06cc\u06d2 AI \u06a9\u06cc \u062a\u062c\u0648\u06cc\u0632 \u067e\u0631 \u0639\u0645\u0644 \u06a9\u06cc\u0627 \u0627\u0648\u0631 \u0634\u0631\u0637 \u062c\u06cc\u062a \u0644\u06cc\u06d4 \u0627\u0628 \u0648\u06c1 \u06a9\u06c1\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 '\u0645\u06cc\u06ba \u0646\u06d2 \u0633\u06cc\u06a9\u06be \u0644\u06cc\u0627 \u06a9\u06c1 \u0688\u06cc\u0679\u0627 \u06a9\u0628\u06be\u06cc \u062c\u06be\u0648\u0679 \u0646\u06c1\u06cc\u06ba \u0628\u0648\u0644\u062a\u0627'\u06d4",
    "\u06cc\u06c1 \u06a9\u06c1\u0627\u0646\u06cc \u0622\u067e \u06a9\u06d2 \u0644\u06cc\u06d2 \u06c1\u06d2\u06d4 Predictify \u0645\u06cc\u06ba \u0627\u06cc\u06a9 \u0641\u06cc\u0686\u0631 \u06c1\u06d2 \u062c\u0633\u06d2 'Confidence Score' \u06a9\u06c1\u062a\u06d2 \u06c1\u06cc\u06ba\u2014\u06cc\u06c1 \u0622\u067e \u06a9\u0648 \u0628\u062a\u0627\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 AI \u0627\u067e\u0646\u06cc \u067e\u06cc\u0634 \u06af\u0648\u0626\u06cc \u067e\u0631 \u06a9\u062a\u0646\u0627 \u06cc\u0642\u06cc\u0646 \u0631\u06a9\u06be\u062a\u0627 \u06c1\u06d2\u06d4 \u062c\u0628 \u0622\u067e \u0627\u0633\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba \u06af\u06d2\u060c \u062a\u0648 \u0622\u067e \u06a9\u0648 \u067e\u062a\u06c1 \u0686\u0644\u06d2 \u06af\u0627 \u06a9\u06c1 \u06a9\u0628 \u0627\u067e\u0646\u06d2 \u0648\u062c\u062f\u0627\u0646 \u067e\u0631 \u0628\u06be\u0631\u0648\u0633\u06c1 \u06a9\u0631\u0646\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u06a9\u0628 \u0688\u06cc\u0679\u0627 \u06a9\u0648 \u062a\u0631\u062c\u06cc\u062d \u062f\u06cc\u0646\u06cc \u06c1\u06d2\u06d4",
    "\u0622\u062c \u06c1\u06cc \u0627\u06cc\u067e \u06a9\u06be\u0648\u0644\u06cc\u06ba \u0627\u0648\u0631 \u0627\u06cc\u06a9 \u0645\u06cc\u0686 \u06a9\u06d2 \u0644\u06cc\u06d2 Confidence Score \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u06a9\u06c1 AI \u06a9\u06cc\u0627 \u06a9\u06c1\u062a\u0627 \u06c1\u06d2\u06d4 P.S. \u0648\u06c1 \u0635\u0627\u0631\u0641 \u062c\u0633 \u0646\u06d2 \u06cc\u06c1 \u06a9\u06c1\u0627\u0646\u06cc \u0634\u06cc\u0626\u0631 \u06a9\u06cc\u060c \u0627\u0628 \u0648\u06c1 \u06c1\u0631 \u06c1\u0641\u062a\u06d2 \u0627\u067e\u0646\u06d2 \u062f\u0648\u0633\u062a\u0648\u06ba \u06a9\u0648 \u0688\u06cc\u0679\u0627 \u0633\u06d2 \u0645\u062a\u0627\u062b\u0631 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u06a9\u06cc\u0627 \u0622\u067e \u0628\u06be\u06cc \u0648\u06c1 \u0628\u0646 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u061f"
