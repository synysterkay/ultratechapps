{
  "subject": "50,000 \u091b\u093e\u0924\u094d\u0930 \u0906\u091c \u092f\u0939 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902",
  "preview_text": "\u0915\u0932 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u090f\u0915 \u091b\u093e\u0924\u094d\u0930 \u0928\u0947 \u092f\u0939 \u0915\u093f\u092f\u093e \u0914\u0930 \u0909\u0938\u0915\u093e \u0917\u094d\u0930\u0947\u0921 \u092c\u0926\u0932 \u0917\u092f\u093e\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 2 \u092c\u091c\u0947, \u091c\u092c \u0924\u0941\u092e \u0936\u093e\u092f\u0926 \u0938\u094b \u0930\u0939\u0947 \u0925\u0947, 50,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u091b\u093e\u0924\u094d\u0930 \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930 \u0916\u094b\u0932 \u0930\u0939\u0947 \u0925\u0947\u0964 \u0909\u0928\u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0909\u0938\u0928\u0947 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u0925\u0940\u0938\u093f\u0938 \u092c\u0928\u093e \u0932\u0940, \u091c\u092c\u0915\u093f \u092a\u0939\u0932\u0947 \u0909\u0938\u0947 8 \u0918\u0902\u091f\u0947 \u0932\u0917\u0924\u0947 \u0925\u0947\u0964 \u0915\u094d\u092f\u093e \u0924\u0941\u092e \u0905\u092c \u092d\u0940 \u092a\u0940\u091b\u0947 \u0930\u0939\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u094b?",
    "\u092f\u0947 \u091b\u093e\u0924\u094d\u0930 \u0938\u093f\u0930\u094d\u092b \u0925\u0940\u0938\u093f\u0938 \u0928\u0939\u0940\u0902 \u092c\u0928\u093e \u0930\u0939\u0947\u2014\u0935\u0947 \u0905\u092a\u0928\u0940 \u092a\u0942\u0930\u0940 \u092a\u0947\u092a\u0930 \u0915\u094b \u092a\u0949\u0932\u093f\u0936 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0917\u094d\u0930\u093e\u092b \u0914\u0930 \u091f\u0947\u092c\u0932 \u0911\u091f\u094b-\u091c\u0928\u0930\u0947\u091f \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0914\u0930 AI \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0915\u094b \u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902 \u0924\u093e\u0915\u093f \u091f\u0930\u094d\u0928\u093f\u091f\u093f\u0928 \u092f\u093e GPTZero \u0909\u0928\u094d\u0939\u0947\u0902 \u092a\u0915\u0921\u093c \u0928 \u0938\u0915\u0947\u0964 \u0909\u0928\u0915\u093e \u0914\u0938\u0924 \u0917\u094d\u0930\u0947\u0921 B+ \u0938\u0947 A- \u0924\u0915 \u0938\u0941\u0927\u0930 \u0917\u092f\u093e \u0939\u0948\u0964 \u0905\u0917\u0930 \u0924\u0941\u092e\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u0907\u0938 \u092b\u0940\u091a\u0930 \u0915\u094b \u091f\u094d\u0930\u093e\u0908 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e, \u0924\u094b \u0924\u0941\u092e \u090f\u0915 \u092c\u0921\u093c\u093e \u092e\u094c\u0915\u093e \u0916\u094b \u0930\u0939\u0947 \u0939\u094b\u0964",
    "\u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u0940 \u092c\u093e\u0924? \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0915\u0941\u091b \u0916\u093e\u0938 \u0915\u0930\u0928\u0947 \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930 \u0916\u094b\u0932\u094b, '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c AI' \u092b\u0940\u091a\u0930 \u091a\u0941\u0928\u094b, \u0914\u0930 \u0905\u092a\u0928\u093e \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0921\u093e\u0932\u094b\u0964 \u092f\u0939 2 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0909\u0938\u0947 \u0910\u0938\u093e \u092c\u0928\u093e \u0926\u0947\u0917\u093e \u091c\u0948\u0938\u0947 \u0924\u0941\u092e\u0928\u0947 \u0916\u0941\u0926 \u0932\u093f\u0916\u093e \u0939\u094b\u0964 \u092c\u093e\u0915\u0940 \u091b\u093e\u0924\u094d\u0930 \u092a\u0939\u0932\u0947 \u0939\u0940 \u092f\u0939 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u2014\u0909\u0928\u0915\u0947 \u0917\u094d\u0930\u0947\u0921 \u092c\u0926\u0932 \u0930\u0939\u0947 \u0939\u0948\u0902, \u091c\u092c\u0915\u093f \u0924\u0941\u092e \u0905\u092d\u0940 \u092d\u0940 \u0938\u094b\u091a \u0930\u0939\u0947 \u0939\u094b\u0964 \u0915\u094d\u092f\u093e \u0924\u0941\u092e \u0909\u0928\u0938\u0947 \u092a\u0940\u091b\u0947 \u0930\u0939\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u094b?",
    "\u0905\u092c \u091c\u093e\u0917\u094b\u0964 \u0905\u092a\u0928\u0940 \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930 \u0916\u094b\u0932\u094b \u0914\u0930 '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c AI' \u092b\u0940\u091a\u0930 \u0906\u091c\u093c\u092e\u093e\u0913\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u0932 \u0939\u0948\u0964 P.S.: \u0905\u0917\u0930 \u0924\u0941\u092e\u0928\u0947 24 \u0918\u0902\u091f\u0947 \u092e\u0947\u0902 \u0910\u0938\u093e \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e, \u0924\u094b \u0924\u0941\u092e \u0935\u0939\u0940 \u0917\u0932\u0924\u0940 \u0926\u094b\u0939\u0930\u093e\u0913\u0917\u0947 \u091c\u094b \u0939\u0930 \u091b\u093e\u0924\u094d\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u2014\u0938\u092e\u092f \u092c\u0930\u094d\u092c\u093e\u0926 \u0915\u0930\u0928\u093e\u0964"
