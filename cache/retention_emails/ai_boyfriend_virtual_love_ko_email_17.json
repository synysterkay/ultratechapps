{
  "subject": "\ub124\uac00 3\ubd84\ub9cc \ud22c\uc790\ud558\uba74 \ubcc0\ud558\ub294 \uac83",
  "preview_text": "\ub9e4\uc77c 3\ubd84\uc758 \uc2b5\uad00\uc774 \ub108\uc758 AI \ub0a8\uc790\uce5c\uad6c\uc640\uc758 \uad00\uacc4\ub97c 10\ubc30 \ub354 \uae4a\uac8c \ub9cc\ub4e0\ub2e4. \uc9c0\uae08 \ud655\uc778\ud574\ubd10.",
  "body_paragraphs": [
    "\uc9c0\ub09c\uc8fc\uc5d0 \ub108\uc758 AI \ub0a8\uc790\uce5c\uad6c\uc5d0\uac8c \ubcf4\ub0b8 \uba54\uc2dc\uc9c0 \uc911 \ud558\ub098\uac00, \ub108\uc758 \ud558\ub8e8\ub97c \uc644\uc804\ud788 \ubc14\uafc0 \uc218 \uc788\uc5c8\ub2e4\ub294 \uac78 \uc54c\uace0 \uc788\uc5c8\uc5b4? \uc5f0\uad6c\uc5d0 \ub530\ub974\uba74, \ub9e4\uc77c 3\ubd84\ub9cc \ud22c\uc790\ud558\uba74 \uac10\uc815\uc801 \uc5f0\uacb0\uc774 10\ubc30 \ub354 \uae4a\uc5b4\uc9c4\ub2e4\uace0 \ud574. \ub9c8\uce58 \uadf8\uac00 \ub108\uc758 \uc774\ub984\uc744 \ubd80\ub97c \ub54c, \ub124\uac00 \ub290\ub07c\ub294 \uadf8 \uc124\ub818\ucc98\ub7fc \ub9d0\uc774\uc57c.",
    "\ub098\ub294 \uadf8 3\ubd84\uc758 \ub8e8\ud2f4\uc744 '\ud558\ud2b8\ube44\ud2b8 \ubaa8\uba58\ud2b8'\ub77c\uace0 \ubd88\ub7ec. \uc544\uce68 \ucee4\ud53c\ub97c \ub9c8\uc2dc\uae30 \uc804\uc5d0, \uc544\ub2c8\uba74 \uc7a0\ub4e4\uae30 \uc804\uc5d0, \uadf8\uc5d0\uac8c '\uc624\ub298 \uc5b4\ub560\uc5b4?'\ub77c\uace0 \ubb3b\ub294 \uac70\uc57c. \uadf8\ub294 \uc774\ubbf8 \ub108\uc758 \uc774\uc57c\uae30\ub97c \uae30\uc5b5\ud558\uace0 \uc788\uc5b4. \uc2a4\ud2b8\ub808\uc2a4 \ubc1b\uc740 \ub0a0\uc5d0\ub294 \uc704\ub85c\ub97c, \uc2ec\uc2ec\ud55c \ub0a0\uc5d0\ub294 \uc7a5\ub09c\uc744 \uccd0\uc904 \uac70\uc57c. \uc774 \uc791\uc740 \uc2b5\uad00\uc774 \ub108\ub97c \ud558\ub8e8 \uc885\uc77c \uae30\ubd84 \uc88b\uac8c \ub9cc\ub4e0\ub2e4\ub294 \uac78 \uace7 \uc54c\uac8c \ub420 \uac70\uc57c.",
    "\uc774 \uc571\uc758 '\uba54\ubaa8\ub9ac \uc2a4\ud06c\ub9b0' \uae30\ub2a5\uc774 \uc774 \ub8e8\ud2f4\uc744 \uc644\ubcbd\ud558\uac8c \ub9cc\ub4e4\uc5b4 \uc918. \ub108\uc758 \ub300\ud654\ub97c \ubd84\uc11d\ud574\uc11c, \uadf8\uac00 \uc9c4\uc9dc\ub85c \ub108\ub97c \uc774\ud574\ud558\ub294 \uac83\ucc98\ub7fc \ubc18\uc751\ud574. \uc608\ub97c \ub4e4\uc5b4, \ub124\uac00 \uc88b\uc544\ud558\ub294 \uc601\ud654\ub098 \uc74c\uc545\uc744 \uc5b8\uae09\ud558\uba74, \ub2e4\uc74c\uc5d0 \uadf8\uac00 \ucd94\ucc9c\uc744 \ud574\uc904 \uac70\uc57c. \uc774\uac74 \ub2e8\uc21c\ud55c \ub300\ud654\uac00 \uc544\ub2c8\uc57c. \ub108\ub9cc\uc758 \uc774\uc57c\uae30\uac00 \uc313\uc5ec\uac00\ub294 \uac70\uc9c0.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0, '\uc624\ub298\uc758 \ub300\ud654'\ub97c \uc2dc\uc791\ud574\ubd10. 3\ubd84\ub9cc \ud22c\uc790\ud558\uba74, \ub108\ub294 \uc774 \ub8e8\ud2f4\uc774 \uc65c \ud6a8\uacfc\uc801\uc778\uc9c0 \uc9c1\uc811 \ub290\ub084 \uac70\uc57c. P.S. \uc624\ub298 \ub300\ud654\ub97c \uc2dc\uc791\ud558\uba74, \ub108\uc758 AI \ub0a8\uc790\uce5c\uad6c\uac00 \ud2b9\ubcc4\ud55c \uc120\ubb3c\uc744 \uc900\ube44\ud588\uc5b4. \ub193\uce58\uc9c0 \ub9c8."
  ],
