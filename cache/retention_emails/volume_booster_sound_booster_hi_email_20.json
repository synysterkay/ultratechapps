{
  "subject": "45 \u0926\u093f\u0928 \u092c\u093e\u0926 \u092d\u0940 \u0924\u0941\u092e \u092f\u0939\u093e\u0901 \u0939\u094b - \u090f\u0915 \u0928\u092f\u093e \u0905\u0927\u094d\u092f\u093e\u092f",
  "preview_text": "\u0905\u092c \u0928\u090f \u092f\u0942\u091c\u093c\u0930 \u0928\u0939\u0940\u0902 \u0930\u0939\u0947, \u0905\u092c \u0924\u0941\u092e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092e\u093e\u0938\u094d\u091f\u0930 \u0939\u094b\u0964 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0905\u0917\u0932\u093e \u0915\u0926\u092e \u0915\u094d\u092f\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0930, \u0938\u091a \u092c\u0924\u093e\u090a\u0901? 45 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0924\u0941\u092e\u0928\u0947 \u092f\u0939 \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0925\u093e, \u0914\u0930 \u0924\u092c \u0938\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u091c\u0947\u092c \u092e\u0947\u0902 \u090f\u0915 \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0935\u0947\u092a\u0928 \u0939\u0948\u0964 \u0924\u0941\u092e \u0905\u092c \u0928\u090f \u092f\u0942\u091c\u093c\u0930 \u0928\u0939\u0940\u0902 \u0939\u094b\u2014\u0924\u0941\u092e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0915\u0947 \u092e\u093e\u0938\u094d\u091f\u0930 \u092c\u0928 \u091a\u0941\u0915\u0947 \u0939\u094b\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932\u0940 \u092e\u091c\u093c\u093e \u0905\u092c \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0924\u0941\u092e\u0928\u0947 \u0936\u093e\u092f\u0926 \u0905\u092c \u0924\u0915 \u092c\u0947\u0938\u093f\u0915 \u092c\u0942\u0938\u094d\u091f \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e \u0939\u094b\u0917\u093e, \u092a\u0930 \u0915\u094d\u092f\u093e \u0924\u0941\u092e\u0928\u0947 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u0915\u094b \u091b\u0941\u0906? \u0909\u0928 \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938 \u0915\u094b \u091f\u094d\u0930\u093e\u0908 \u0915\u093f\u092f\u093e? \u0930\u0949\u0915, \u091c\u0948\u091c\u093c, \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915\u2014\u0939\u0930 \u091c\u0949\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0938\u0947\u091f\u093f\u0902\u0917 \u0939\u0948\u0964 \u092f\u0939 \u0935\u0939 \u091c\u0917\u0939 \u0939\u0948 \u091c\u0939\u093e\u0901 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092b\u094b\u0928 \u090f\u0915 \u0915\u0949\u0928\u094d\u0938\u0930\u094d\u091f \u0939\u0949\u0932 \u092c\u0928 \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0915\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u092e\u0947\u0902 \u0915\u0926\u092e \u0930\u0916\u0928\u0947 \u0915\u093e\u0964 \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0932\u0947\u0935\u0932 \u0914\u0930 \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 EQ \u0915\u0902\u091f\u094d\u0930\u094b\u0932\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925, \u0924\u0941\u092e \u0939\u0930 \u0917\u093e\u0928\u0947 \u092e\u0947\u0902 \u092c\u093e\u0938 \u0915\u094b \u0910\u0938\u093e \u092b\u0940\u0932 \u0915\u0930\u094b\u0917\u0947 \u091c\u0948\u0938\u0947 \u0932\u093e\u0907\u0935 \u0936\u094b \u092e\u0947\u0902 \u0939\u094b\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a, \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0938\u094d\u092a\u0949\u091f\u093f\u092b\u093e\u0908, \u092f\u0942\u091f\u094d\u092f\u0942\u092c, \u0928\u0947\u091f\u092b\u094d\u0932\u093f\u0915\u094d\u0938\u2014\u0938\u092c \u0915\u0941\u091b \u0905\u0932\u0917 \u0932\u0917\u0947\u0917\u093e\u0964",
    "\u0924\u094b \u092f\u0939\u093e\u0901 \u0938\u0947 \u0906\u0917\u0947 \u0915\u094d\u092f\u093e? \u0910\u092a \u0916\u094b\u0932\u094b, \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u092e\u0947\u0902 \u091c\u093e\u0913, \u0914\u0930 '\u0930\u0949\u0915' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0915\u094b \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b\u0964 \u092b\u093f\u0930 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0928\u093e \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0926\u093f\u0932 \u0915\u093f\u0924\u0928\u093e \u091c\u094b\u0930 \u0938\u0947 \u0927\u0921\u093c\u0915\u093e\u0964 P.S. - \u092f\u0939 \u0906\u0916\u093f\u0930\u0940 \u0908\u092e\u0947\u0932 \u0939\u0948 \u0907\u0938 \u0938\u0940\u0930\u0940\u091c\u093c \u0915\u093e, \u0932\u0947\u0915\u093f\u0928 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0938\u092b\u0930 \u092f\u0939\u0940\u0902 \u0916\u0924\u094d\u092e \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e\u2014\u092c\u0938 \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"
  ],
  "cta_text": "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b",
