{
  "subject": "\u03a4\u03bf \u03bb\u03ac\u03b8\u03bf\u03c2 \u03c0\u03bf\u03c5 \u03ad\u03ba\u03b1\u03bd\u03b1 \u03c3\u03c4\u03b9\u03c2 3 \u03c0.\u03bc.",
  "preview_text": "\u039c\u03ac\u03b8\u03b5 \u03c0\u03ce\u03c2 \u03ad\u03bd\u03b1\u03c2 \u03b1\u03c0\u03bb\u03cc\u03c2 \u03ad\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2 \u03c3\u03c4\u03bf Predictify \u03c3\u03bf\u03c5 \u03b4\u03af\u03bd\u03b5\u03b9 10x \u03ba\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03b5\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ad\u03c8\u03b5\u03b9\u03c2 \u03c7\u03c9\u03c1\u03af\u03c2 \u03bd\u03b1 \u03c4\u03bf \u03be\u03ad\u03c1\u03b5\u03b9\u03c2.",
  "body_paragraphs": [
    "\u03a0\u03c1\u03b9\u03bd \u03bb\u03af\u03b3\u03b5\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2, \u03ae\u03bc\u03bf\u03c5\u03bd \u03be\u03cd\u03c0\u03bd\u03b9\u03bf\u03c2 \u03c3\u03c4\u03b9\u03c2 3 \u03c0.\u03bc. \u03ba\u03b1\u03b9 \u03ba\u03bf\u03af\u03c4\u03b1\u03b6\u03b1 \u03c4\u03b7\u03bd \u03b1\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u03b3\u03b9\u03b1 \u03c4\u03bf \u039c\u03af\u03bb\u03b1\u03bd-\u0393\u03b9\u03bf\u03c5\u03b2\u03ad\u03bd\u03c4\u03bf\u03c5\u03c2. \u0395\u03af\u03c7\u03b1 \u03b2\u03ac\u03bb\u03b5\u03b9 \u03c3\u03c7\u03b5\u03b4\u03cc\u03bd 50\u20ac \u03c3\u03b5 \u03ad\u03bd\u03b1 \u03c3\u03c4\u03bf\u03af\u03c7\u03b7\u03bc\u03b1, \u03b1\u03bb\u03bb\u03ac \u03ba\u03ac\u03c4\u03b9 \u03b4\u03b5\u03bd \u03bc\u03bf\u03c5 \u03ba\u03bf\u03bb\u03bb\u03bf\u03cd\u03c3\u03b5. \u03a4\u03cc\u03c4\u03b5 \u03b8\u03c5\u03bc\u03ae\u03b8\u03b7\u03ba\u03b1 \u03ad\u03bd\u03b1 \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03b7\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03c4\u03bf\u03c5 Predictify \u03c0\u03bf\u03c5 \u03c4\u03bf \u03b5\u03af\u03c7\u03b1 \u03b1\u03b3\u03bd\u03bf\u03ae\u03c3\u03b5\u03b9 \u03b5\u03bd\u03c4\u03b5\u03bb\u03ce\u03c2.",
    "\u03a4\u03bf AI \u03c4\u03bf\u03c5 Predictify \u03b4\u03b5\u03bd \u03c3\u03bf\u03c5 \u03b4\u03af\u03bd\u03b5\u03b9 \u03b1\u03c0\u03bb\u03ac \u03bc\u03b9\u03b1 \u03c0\u03c1\u03cc\u03b2\u03bb\u03b5\u03c8\u03b7. \u03a3\u03bf\u03c5 \u03b4\u03b5\u03af\u03c7\u03bd\u03b5\u03b9 \u03c4\u03b7 \u03b2\u03b1\u03b8\u03bc\u03bf\u03bb\u03bf\u03b3\u03af\u03b1 \u03b5\u03bc\u03c0\u03b9\u03c3\u03c4\u03bf\u03c3\u03cd\u03bd\u03b7\u03c2 \u2014 \u03b1\u03c0\u03cc 1% \u03ad\u03c9\u03c2 99%. \u0395\u03ba\u03b5\u03af\u03bd\u03b7 \u03c4\u03b7 \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae, \u03b5\u03af\u03b4\u03b1 \u03cc\u03c4\u03b9 \u03b7 \u03c0\u03c1\u03cc\u03b2\u03bb\u03b5\u03c8\u03b7 \u03b3\u03b9\u03b1 \u03c4\u03bf \u039c\u03af\u03bb\u03b1\u03bd \u03b5\u03af\u03c7\u03b5 \u03bc\u03cc\u03bd\u03bf 59% confidence, \u03c0\u03b1\u03c1\u03cc\u03bb\u03bf \u03c0\u03bf\u03c5 \u03bf\u03b9 \u03b1\u03c1\u03b9\u03b8\u03bc\u03bf\u03af \u03c6\u03b1\u03af\u03bd\u03bf\u03bd\u03c4\u03b1\u03bd \u03ba\u03b1\u03bb\u03bf\u03af. \u0391\u03c5\u03c4\u03ae \u03b7 \u03bc\u03b9\u03ba\u03c1\u03ae \u03bb\u03b5\u03c0\u03c4\u03bf\u03bc\u03ad\u03c1\u03b5\u03b9\u03b1 \u03bc\u03bf\u03c5 \u03ad\u03c3\u03c9\u03c3\u03b5 \u03c4\u03b1 \u03bb\u03b5\u03c6\u03c4\u03ac.",
    "\u0397 \u03b1\u03bb\u03ae\u03b8\u03b5\u03b9\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03cc\u03c4\u03b9 \u03c4\u03bf 90% \u03c4\u03c9\u03bd \u03c7\u03c1\u03b7\u03c3\u03c4\u03ce\u03bd \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9 \u03bc\u03cc\u03bd\u03bf \u03c4\u03b7\u03bd \u03c0\u03c1\u03cc\u03b2\u03bb\u03b5\u03c8\u03b7 \u03ba\u03b1\u03b9 \u03cc\u03c7\u03b9 \u03c4\u03b7\u03bd confidence score. \u0391\u03bb\u03bb\u03ac \u03b1\u03c5\u03c4\u03ae \u03b7 \u03b2\u03b1\u03b8\u03bc\u03bf\u03bb\u03bf\u03b3\u03af\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03bf \u03ba\u03bb\u03b5\u03b9\u03b4\u03af. \u0391\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03ba\u03ac\u03c4\u03c9 \u03b1\u03c0\u03cc 70%, \u03c4\u03bf AI \u03c3\u03b5 \u03c0\u03c1\u03bf\u03b5\u03b9\u03b4\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03cc\u03c4\u03b9 \u03c4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b1\u03c3\u03b1\u03c6\u03ae. \u0394\u03bf\u03ba\u03af\u03bc\u03b1\u03c3\u03ad \u03c4\u03bf \u03c3\u03c4\u03bf \u03b5\u03c0\u03cc\u03bc\u03b5\u03bd\u03bf \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9 \u2014 Premier League, La Liga, \u03cc,\u03c4\u03b9 \u03b8\u03b5\u03c2. \u0394\u03b5\u03c2 \u03c4\u03b7\u03bd confidence score \u03ba\u03b1\u03b9 \u03b1\u03c0\u03bf\u03c6\u03ac\u03c3\u03b9\u03c3\u03b5 \u03b1\u03bd \u03b8\u03b1 \u03c0\u03bf\u03bd\u03c4\u03ac\u03c1\u03b5\u03b9\u03c2.",
    "\u0386\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03bf Predictify \u03c4\u03ce\u03c1\u03b1, \u03b4\u03b9\u03ac\u03bb\u03b5\u03be\u03b5 \u03ad\u03bd\u03b1 \u03bc\u03b1\u03c4\u03c2, \u03ba\u03b1\u03b9 \u03ba\u03bf\u03af\u03c4\u03b1 \u03c4\u03b7\u03bd confidence score \u03c0\u03c1\u03b9\u03bd \u03c0\u03ac\u03c1\u03b5\u03b9\u03c2 \u03b1\u03c0\u03cc\u03c6\u03b1\u03c3\u03b7. \u0398\u03b1 \u03ba\u03b1\u03c4\u03b1\u03bb\u03ac\u03b2\u03b5\u03b9\u03c2 \u03b1\u03bc\u03ad\u03c3\u03c9\u03c2 \u03b3\u03b9\u03b1\u03c4\u03af \u03bb\u03ad\u03c9 \u03cc\u03c4\u03b9 \u03b1\u03bb\u03bb\u03ac\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9. P.S. \u2014 \u0391\u03bd \u03b8\u03ad\u03bb\u03b5\u03b9\u03c2 \u03bd\u03b1 \u03b4\u03b5\u03b9\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b9\u03c2 hidden \u03b1\u03bd\u03b1\u03bb\u03cd\u03c3\u03b5\u03b9\u03c2 \u03c0\u03bf\u03c5 \u03ad\u03c7\u03bf\u03c5\u03bd \u03bf\u03b9 Premium users, \u03b4\u03bf\u03ba\u03af\u03bc\u03b1\u03c3\u03b5 \u03c4\u03bf \u03b4\u03c9\u03c1\u03b5\u03ac\u03bd \u03c4\u03c1\u03b9\u03ae\u03bc\u03b5\u03c1\u03bf. \u039c\u03cc\u03bd\u03bf 12.99\u20ac \u03c4\u03bf\u03bd \u03bc\u03ae\u03bd\u03b1, \u03b1\u03bb\u03bb\u03ac \u03b7 \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03ac \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03b5\u03c1\u03ac\u03c3\u03c4\u03b9\u03b1."
