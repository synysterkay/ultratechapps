{
  "subject": "\u041f\u043e\u0447\u0435\u043c\u0443 \u044f \u0441\u043b\u0443\u0448\u0430\u044e \u0432 2 \u0447\u0430\u0441\u0430 \u043d\u043e\u0447\u0438",
  "preview_text": "\u041e\u0434\u0438\u043d \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u043d\u0430\u0448\u0451\u043b \u0444\u0443\u043d\u043a\u0446\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430 \u0432\u0441\u0451. \u0421\u043f\u043e\u0439\u043b\u0435\u0440: \u044d\u0442\u043e \u043d\u0435 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440.",
  "body_paragraphs": [
    "\u0412 2 \u0447\u0430\u0441\u0430 \u043d\u043e\u0447\u0438, \u043a\u043e\u0433\u0434\u0430 \u043f\u043e\u0435\u0437\u0434\u0430 \u0437\u0430\u043c\u043e\u043b\u043a\u0430\u044e\u0442, \u0430 \u0441\u043e\u0441\u0435\u0434\u0438 \u0441\u043f\u044f\u0442, \u044f \u043f\u043e\u043d\u044f\u043b, \u0447\u0442\u043e \u0441\u043b\u0443\u0448\u0430\u044e \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e. \u041d\u0435 \u0433\u0440\u043e\u043c\u043a\u043e \u2014 \u0447\u0438\u0441\u0442\u043e. \u0414\u0438\u0430\u043b\u043e\u0433\u0438 \u0432 \u043f\u043e\u0434\u043a\u0430\u0441\u0442\u0430\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0430\u043d\u044c\u0448\u0435 \u0442\u043e\u043d\u0443\u043b\u0438 \u0432 \u0448\u0443\u043c\u0435 \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0446\u0438\u0438, \u0432\u0434\u0440\u0443\u0433 \u0441\u0442\u0430\u043b\u0438 \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u044c\u043d\u043e \u044f\u0441\u043d\u044b\u043c\u0438. \u0418 \u0432\u0441\u0451 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u043e\u0434\u043d\u043e\u0439 \u043a\u043d\u043e\u043f\u043a\u0435, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u044f \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u043b 25 \u0434\u043d\u0435\u0439.",
    "\u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c. Loudify \u0438 \u0442\u0430\u043a \u0434\u0430\u0451\u0442 +200%, \u043d\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0430\u044f \u043c\u0430\u0433\u0438\u044f \u0432 AutoEQ, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u043c\u043d\u0438\u0442 \u0442\u0432\u043e\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438. \u041e\u0434\u0438\u043d \u0440\u0430\u0437 \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u043b \u2014 \u0438 \u043a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0437, \u043a\u043e\u0433\u0434\u0430 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0430\u0435\u0448\u044c AirPods, Sony \u0438\u043b\u0438 \u0434\u0430\u0436\u0435 \u0434\u0435\u0448\u0451\u0432\u044b\u0435 JBL, \u0437\u0432\u0443\u043a \u043f\u043e\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0441\u0430\u043c. \u0411\u0435\u0437 \u0442\u0430\u043d\u0446\u0435\u0432 \u0441 \u0431\u0443\u0431\u043d\u043e\u043c.",
    "\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u043b\u044e\u0434\u0438 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0432\u0438\u0434\u044f\u0442 10-\u043f\u043e\u043b\u043e\u0441\u043d\u044b\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u0438 \u0434\u0443\u043c\u0430\u044e\u0442: \u00ab\u0421\u043b\u043e\u0436\u043d\u043e\u00bb. \u041d\u043e \u0435\u0441\u0442\u044c \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u00ab\u0411\u044b\u0441\u0442\u0440\u0430\u044f \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u00bb: \u043d\u0430\u0436\u0438\u043c\u0430\u0435\u0448\u044c \u043d\u0430 \u0438\u043a\u043e\u043d\u043a\u0443 \u043f\u0440\u043e\u0444\u0438\u043b\u044f \u2014 \u0438 \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0448\u044c \u00ab\u041f\u043e\u0434\u043a\u0430\u0441\u0442\u044b\u00bb \u0438\u043b\u0438 \u00ab\u0418\u0433\u0440\u044b\u00bb. \u0412\u0443\u0430\u043b\u044f \u2014 \u0433\u043e\u043b\u043e\u0441\u0430 \u0432\u044b\u0445\u043e\u0434\u044f\u0442 \u043d\u0430 \u043f\u0435\u0440\u0432\u044b\u0439 \u043f\u043b\u0430\u043d, \u0430 \u0432\u0437\u0440\u044b\u0432\u044b \u043d\u0435 \u043e\u0433\u043b\u0443\u0448\u0430\u044e\u0442. \u0422\u044b \u0434\u0430\u0436\u0435 \u043d\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0448\u044c, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u0435\u0442\u0430\u043b\u0435\u0439 \u0442\u0435\u0440\u044f\u043b.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Loudify \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041d\u0430\u0436\u043c\u0438 \u00ab\u0410\u0443\u0434\u0438\u043e\u043f\u0440\u043e\u0444\u0438\u043b\u0438\u00bb \u0438 \u0432\u044b\u0431\u0435\u0440\u0438 \u0442\u043e\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u0442\u0432\u043e\u0435\u043c\u0443 \u0437\u0430\u043d\u044f\u0442\u0438\u044e. \u0410 \u0432 \u043a\u043e\u043d\u0446\u0435 \u043d\u0435\u0434\u0435\u043b\u0438 \u0437\u0430\u0433\u043b\u044f\u043d\u0438 \u0432 Sound DNA \u2014 \u0443\u0432\u0438\u0434\u0438\u0448\u044c, \u043a\u0430\u043a \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430\u0441\u044c \u0442\u0432\u043e\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043f\u0440\u043e\u0441\u043b\u0443\u0448\u0438\u0432\u0430\u043d\u0438\u044f.\n\nP.S. \u041e\u0434\u0438\u043d \u043f\u0430\u0440\u0435\u043d\u044c \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u043b AutoEQ \u0434\u043b\u044f \u0441\u0432\u043e\u0438\u0445 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u043e\u0432 \u0438 \u0441\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0443\u0441\u043b\u044b\u0448\u0430\u043b \u043d\u043e\u0432\u044b\u0439 \u0430\u043b\u044c\u0431\u043e\u043c \u0442\u0430\u043a, \u0431\u0443\u0434\u0442\u043e \u0432\u043f\u0435\u0440\u0432\u044b\u0435. \u0421\u043f\u043e\u0440\u0438\u043c, \u0442\u044b \u0442\u043e\u0436\u0435?"
