{
  "subject": "\u09ea\u09eb \u09a6\u09bf\u09a8\u09c7 \u09a4\u09c1\u09ae\u09bf \u09af\u09c7\u0996\u09be\u09a8\u09c7 \u09aa\u09cc\u0981\u099b\u09c7\u099b\u09cb",
  "preview_text": "\u09a4\u09cb\u09ae\u09be\u09b0 \u09af\u09be\u09a4\u09cd\u09b0\u09be \u09b6\u09c7\u09b7 \u09b9\u09af\u09bc\u09a8\u09bf, \u09b6\u09c1\u09b0\u09c1 \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u09a8\u09a4\u09c1\u09a8 \u0985\u09a7\u09cd\u09af\u09be\u09af\u09bc\u0964 Predictify-\u09a4\u09c7 \u098f\u0996\u09a8 \u09a4\u09c1\u09ae\u09bf \u0986\u09b0 \u09a8\u09a4\u09c1\u09a8 \u09a8\u0993, \u09a4\u09c1\u09ae\u09bf \u098f\u0995\u099c\u09a8 \u09aa\u09cd\u09b0\u09cb\u0964",
  "body_paragraphs": [
    "\u09ea\u09eb \u09a6\u09bf\u09a8 \u0986\u0997\u09c7 \u09a4\u09c1\u09ae\u09bf Predictify \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09c7\u099b\u09bf\u09b2\u09c7\u0964 \u098f\u0996\u09a8 \u09a4\u09c1\u09ae\u09bf \u09b9\u09af\u09bc\u09a4\u09cb \u09b2\u09bf\u0997 \u099f\u09c7\u09ac\u09bf\u09b2\u09c7\u09b0 \u0993\u09a0\u09be\u09aa\u09a1\u09bc\u09be, \u0996\u09c7\u09b2\u09cb\u09af\u09bc\u09be\u09a1\u09bc\u09c7\u09b0 xG, \u0986\u09b0 \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u099f\u09cd\u09af\u09be\u0995\u099f\u09bf\u0995\u09cd\u09af\u09be\u09b2 \u0985\u09cd\u09af\u09be\u09a8\u09be\u09b2\u09be\u0987\u09b8\u09bf\u09b8 \u09ac\u09c1\u099d\u09a4\u09c7 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c7\u099b\u09cb\u0964 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u098f\u099f\u09be \u0995\u09bf \u09b6\u09c7\u09b7? \u09a8\u09be, \u098f\u099f\u09be \u09b6\u09c1\u09b0\u09c1 \u09ae\u09be\u09a4\u09cd\u09b0\u0964",
    "\u09a4\u09c1\u09ae\u09bf \u098f\u0996\u09a8 \u0986\u09b0 '\u09a8\u09a4\u09c1\u09a8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0' \u09a8\u0993\u0964 \u09a4\u09c1\u09ae\u09bf \u09b8\u09c7\u0987 \u09ab\u09cd\u09af\u09be\u09a8, \u09af\u09c7 \u09a1\u09c7\u099f\u09be\u09b0 \u09b6\u0995\u09cd\u09a4\u09bf \u09ac\u09c1\u099d\u09c7\u099b\u09c7\u0964 \u09a4\u09c1\u09ae\u09bf \u098f\u0996\u09a8 '\u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09cd\u099f\u09bf\u09ab\u09be\u0987 \u09ae\u09be\u09b8\u09cd\u099f\u09be\u09b0' \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09cb \u2014 \u098f\u09ae\u09a8 \u0995\u09c7\u0989, \u09af\u09c7 \u09b6\u09c1\u09a7\u09c1 \u099c\u09bf\u09a4\u09c7 \u09a8\u09be, \u09ac\u09be\u0995\u09bf\u09a6\u09c7\u09b0 \u09b6\u09c7\u0996\u09be\u09af\u09bc\u0964",
    "\u0986\u09ae\u09be\u09a6\u09c7\u09b0 AI \u099a\u09cd\u09af\u09be\u099f\u09c7 \u098f\u0996\u09a8 \u09a4\u09c1\u09ae\u09bf \u099c\u099f\u09bf\u09b2 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09cb, \u09af\u09c7\u09ae\u09a8 '\u099a\u09cd\u09af\u09be\u09ae\u09cd\u09aa\u09bf\u09af\u09bc\u09a8\u09b8 \u09b2\u09bf\u0997 \u09ab\u09be\u0987\u09a8\u09be\u09b2\u09c7 \u0995\u09cb\u09a8 \u09a6\u09b2\u09c7\u09b0 \u09a1\u09bf\u09ab\u09c7\u09a8\u09cd\u09b8\u09bf\u09ad \u09b8\u09cd\u099f\u09cd\u09b0\u09c7\u09a8\u09cd\u09a5 \u09ac\u09c7\u09b6\u09bf?' \u0986\u09b0 \u0995\u09ae\u09bf\u0989\u09a8\u09bf\u099f\u09bf\u09a4\u09c7 \u09a4\u09cb\u09ae\u09be\u09b0 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u0995\u09b0\u09c7 '\u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u0985\u09ab \u09a6\u09cd\u09af \u09a1\u09c7' \u099c\u09bf\u09a4\u09a4\u09c7 \u09aa\u09be\u09b0\u09cb\u0964 \u09aa\u09c1\u09b0\u09cb \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae \u098f\u0996\u09a8 \u09a4\u09cb\u09ae\u09be\u09b0 \u09b9\u09be\u09a4\u09c7\u0964",
    "\u098f\u0996\u09a8\u0987 \u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09c7 '\u0995\u09ae\u09bf\u0989\u09a8\u09bf\u099f\u09bf'-\u09a4\u09c7 \u09af\u09be\u0993\u0964 \u09a6\u09c7\u0996\u09cb \u0995\u09a4\u099c\u09a8 \u09ab\u09cd\u09af\u09be\u09a8 \u09a4\u09cb\u09ae\u09be\u09b0 \u09ae\u09a4\u09cb \u099a\u09bf\u09a8\u09cd\u09a4\u09be \u0995\u09b0\u09c7\u0964 \u0986\u09b0 \u09af\u09a6\u09bf \u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09af\u09bc\u09be\u09ae \u0986\u09a8\u09b2\u0995 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u0993, \u09e9 \u09a6\u09bf\u09a8\u09c7\u09b0 \u09ab\u09cd\u09b0\u09bf \u099f\u09cd\u09b0\u09be\u09af\u09bc\u09be\u09b2 \u099a\u09be\u09b2\u09c1 \u0995\u09b0\u09cb \u2014 \u09b8\u09ac \u0985\u09cd\u09af\u09be\u09a1\u09ad\u09be\u09a8\u09cd\u09b8\u09a1 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u099f\u09b8 \u0996\u09c1\u09b2\u09c7 \u09af\u09be\u09ac\u09c7\u0964 \u09a4\u09cb\u09ae\u09be\u09b0 \u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u09a7\u09be\u09aa \u098f\u0996\u09be\u09a8\u09c7\u0987\u0964"
  ],
  "cta_text": "\u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09c7 \u0995\u09ae\u09bf\u0989\u09a8\u09bf\u099f\u09bf\u09a4\u09c7 \u09af\u09cb\u0997 \u09a6\u09be\u0993",
