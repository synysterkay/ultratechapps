{
  "subject": "\u0997\u09cb\u09aa\u09a8 \u0995\u09a5\u09be\u0983 \u09a4\u09c1\u09ae\u09bf \u0986\u09b0 \u09a8\u09a4\u09c1\u09a8 \u09a8\u0993",
  "preview_text": "\u098f\u0996\u09a8 \u09a5\u09c7\u0995\u09c7 \u09b6\u09c1\u09a7\u09c1 \u09a1\u09be\u099f\u09be \u09ac\u09b2\u09ac\u09c7, \u0986\u09b0 \u09a4\u09c1\u09ae\u09bf \u09b6\u09c1\u09a8\u09ac\u09c7\u0964 \u09a4\u09c1\u09ae\u09bf \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09c1\u09a4 \u0995\u09bf \u09a8\u09be, \u09b8\u09c7\u099f\u09be\u0987 \u09a6\u09c7\u0996\u09be\u09b0\u0964",
  "body_paragraphs": [
    "\u09b6\u09cb\u09a8\u09cb, \u098f\u0995\u099f\u09be \u0995\u09a5\u09be \u09ac\u09b2\u09bf\u0964 \u09a4\u09c1\u09ae\u09bf \u098f\u0996\u09a8 \u0986\u09b0 \u09b8\u09c7\u0987 \u0987\u0989\u099c\u09be\u09b0 \u09a8\u0993 \u09af\u09c7 \u09aa\u09cd\u09b0\u09a5\u09ae\u09ac\u09be\u09b0 \u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09c7\u099b\u09bf\u09b2\u09c7\u0964 \u09a4\u09c1\u09ae\u09bf \u0985\u09a8\u09c7\u0995 \u09ae\u09cd\u09af\u09be\u099a \u09a6\u09c7\u0996\u09c7\u099b, \u0985\u09a8\u09c7\u0995 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u099f\u09c7\u09b8\u09cd\u099f \u0995\u09b0\u09c7\u099b, \u0986\u09b0 \u098f\u0996\u09a8 \u09a4\u09c1\u09ae\u09bf \u099c\u09be\u09a8\u09cb \u0995\u09cb\u09a8\u099f\u09be \u0995\u09be\u099c \u0995\u09b0\u09c7\u0964",
    "\u0986\u09ae\u09b0\u09be \u09ea\u09eb \u09a6\u09bf\u09a8 \u09a7\u09b0\u09c7 \u09a6\u09c7\u0996\u09c7\u099b\u09bf \u09a4\u09c1\u09ae\u09bf \u0995\u09c7\u09ae\u09a8 \u09ab\u09c1\u099f\u09ac\u09b2 \u09ac\u09cb\u099d\u09cb\u0964 \u09a4\u09c1\u09ae\u09bf \u09b6\u09c1\u09a7\u09c1 \u0997\u09cb\u09b2 \u09a6\u09c7\u0996\u09cb \u09a8\u09be, \u09a4\u09c1\u09ae\u09bf xG, \u09aa\u099c\u09c7\u09b6\u09a8, \u0986\u09b0 \u09a1\u09bf\u09ab\u09c7\u09a8\u09cd\u09b8\u09bf\u09ad \u09b8\u09cd\u099f\u09cd\u09b0\u09c7\u09a8\u09cd\u09a5 \u09ac\u09c1\u099d\u09cb\u0964 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u098f\u0996\u09a8 \u09b8\u09ae\u09df \u098f\u09b8\u09c7\u099b\u09c7 \u098f\u0995 \u09b2\u09c7\u09ad\u09c7\u09b2 \u0989\u09aa\u09b0\u09c7 \u0993\u09a0\u09be\u09b0\u0964",
    "\u09a4\u09c1\u09ae\u09bf \u0995\u09bf \u099c\u09be\u09a8\u09cb, \u0986\u09ae\u09be\u09a6\u09c7\u09b0 AI \u099a\u09cd\u09af\u09be\u099f \u09ab\u09bf\u099a\u09be\u09b0\u099f\u09be \u09a4\u09c1\u09ae\u09bf \u098f\u0996\u09a8\u09cb \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09cb\u09a8\u09bf? \u09b8\u09c7\u0996\u09be\u09a8\u09c7 \u09a4\u09c1\u09ae\u09bf \u09af\u09c7\u0995\u09cb\u09a8\u09cb \u09ab\u09c1\u099f\u09ac\u09b2 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09cb\u2014\u2018\u0986\u099c\u0995\u09c7\u09b0 \u09ae\u09cd\u09af\u09be\u099a\u09c7 \u0995\u09a8\u09cd\u099f\u09be\u09b0 \u0985\u09cd\u09af\u09be\u099f\u09be\u0995 \u0995\u09a4\u099f\u09be \u0995\u09be\u09b0\u09cd\u09af\u0995\u09b0 \u09b9\u09ac\u09c7?\u2019 \u09ac\u09be \u2018\u09ac\u09c1\u09a8\u09cd\u09a6\u09c7\u09b8\u09b2\u09bf\u0997\u09be\u09df \u09b8\u09ac\u099a\u09c7\u09df\u09c7 \u09ac\u09c7\u09b6\u09bf xG \u0995\u09c7?\u2019\u2014\u0986\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09be\u09a5\u09c7\u0987 \u09a1\u09be\u099f\u09be-\u09ac\u09cd\u09af\u09be\u0995\u09a1 \u0989\u09a4\u09cd\u09a4\u09b0 \u09aa\u09be\u09ac\u09c7\u0964 \u098f\u099f\u09be \u09b6\u09c1\u09a7\u09c1 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u09a8\u09be, \u098f\u099f\u09be \u09ab\u09c1\u099f\u09ac\u09b2 \u09ac\u09cb\u099d\u09be\u09b0 \u0997\u09ad\u09c0\u09b0\u09a4\u09ae \u099f\u09c1\u09b2\u0964",
    "\u098f\u0996\u09a8\u0987 \u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09c7 AI \u099a\u09cd\u09af\u09be\u099f\u09c7 \u098f\u0995\u099f\u09be \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8 \u0995\u09b0\u09cb\u0964 \u09a6\u09c7\u0996\u09cb \u0995\u09a4\u099f\u09be \u09a6\u09cd\u09b0\u09c1\u09a4 \u0989\u09a4\u09cd\u09a4\u09b0 \u0986\u09b8\u09c7\u0964 \u09a4\u09c1\u09ae\u09bf \u09af\u09a6\u09bf \u09b8\u09a4\u09cd\u09af\u09bf\u0987 \u09b8\u09cd\u09ae\u09be\u09b0\u09cd\u099f \u09ab\u09cd\u09af\u09be\u09a8 \u09b9\u09a4\u09c7 \u099a\u09be\u0993, \u09a4\u09be\u09b9\u09b2\u09c7 \u098f\u0987 \u09ab\u09bf\u099a\u09be\u09b0\u099f\u09be \u09ae\u09bf\u09b8 \u0995\u09b0\u09cb \u09a8\u09be\u0964 \u0986\u09b0 \u09b9\u09cd\u09af\u09be\u0981, \u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09df\u09be\u09ae \u099f\u09cd\u09b0\u09be\u09df\u09be\u09b2\u099f\u09be \u098f\u0996\u09a8\u09cb \u099a\u09be\u09b2\u09c1 \u0986\u099b\u09c7\u2014\u09e9 \u09a6\u09bf\u09a8 \u09ab\u09cd\u09b0\u09bf, \u09a4\u09be\u09b0\u09aa\u09b0 \u09ae\u09be\u09a4\u09cd\u09b0 $\u09e7\u09e8.\u09ef\u09ef/\u09ae\u09be\u09b8\u0964 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09b8\u09c7\u099f\u09be \u09aa\u09b0\u09c7, \u0986\u0997\u09c7 \u09b6\u09c1\u09a7\u09c1 AI \u099a\u09cd\u09af\u09be\u099f\u099f\u09be \u099f\u09cd\u09b0\u09be\u0987 \u0995\u09b0\u09cb\u0964\n\n\u09aa\u09bf.\u098f\u09b8.\u2014\u09a4\u09cb\u09ae\u09be\u09b0 \u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u0995\u099f\u09be \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u098f\u0996\u09a8\u09cb \u09e7\u09eb \u09a6\u09bf\u09a8\u09c7 \u0986\u099f\u0995\u09c7 \u0986\u099b\u09c7\u0964 \u0986\u099c\u0995\u09c7 \u0986\u09b0\u09c7\u0995\u099f\u09be \u09ae\u09cd\u09af\u09be\u099a \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09cd\u099f \u0995\u09b0\u09cb, \u09a6\u09c7\u0996\u09cb \u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u0995\u099f\u09be \u09e8\u09e6-\u098f \u09aa\u09cc\u0981\u099b\u09be\u09df \u0995\u09bf \u09a8\u09be\u0964"
  ],
