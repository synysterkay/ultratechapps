{
  "subject": "\u51cc\u66683\u70b9\u7684\u8bba\u6587\u6551\u661f\u2014\u2014\u5979\u7684\u6545\u4e8b\u8ba9\u56e2\u961f\u6cea\u76ee",
  "preview_text": "\u4e00\u4f4d\u5927\u56db\u5b66\u751f\u7684\u7ecf\u5386\uff0c\u8ba9\u6211\u4eec\u610f\u8bc6\u5230\u5de5\u5177\u771f\u6b63\u7684\u529b\u91cf\u3002\u4f60\u4e5f\u80fd\u505a\u5230\u3002",
  "body_paragraphs": [
    "\u4e0a\u5468\uff0c\u6211\u4eec\u6536\u5230\u4e00\u5c01\u6765\u81ea\u5927\u56db\u5b66\u751f\u5c0f\u9648\u7684\u90ae\u4ef6\u3002\u5979\u8bf4\uff0c\u5979\u5728\u51cc\u66683\u70b9\uff0c\u76ef\u7740\u7a7a\u767d\u7684\u6587\u6863\uff0c\u773c\u6cea\u5dee\u70b9\u6389\u4e0b\u6765\u2014\u2014\u8bba\u6587\u622a\u6b62\u65e5\u671f\u5c31\u5728\u660e\u5929\uff0c\u5979\u8fd8\u6ca1\u5199\u51fa\u5f00\u5934\u3002\u4f4612\u5c0f\u65f6\u540e\uff0c\u5979\u63d0\u4ea4\u4e86\u4e00\u7bc7\u5b8c\u6574\u7684\u8bba\u6587\uff0c\u62ff\u5230\u4e86A-\u3002",
    "\u5c0f\u9648\u4e0d\u662f\u5929\u624d\u3002\u5979\u53ea\u662f\u7528\u4e86\u4e00\u4e2a\u529f\u80fd\uff0c\u628a8\u5c0f\u65f6\u7684\u6323\u624e\u538b\u7f29\u523010\u5206\u949f\u3002\u5f53\u5979\u5728\u6df1\u591c\u6253\u5f00\u6211\u4eec\u7684App\uff0c\u751f\u6210\u7b2c\u4e00\u4e2a\u8bba\u6587\u9648\u8ff0\u65f6\uff0c\u5979\u8bf4\u611f\u89c9\u50cf\u6709\u4eba\u9012\u7ed9\u5979\u4e00\u628a\u94a5\u5319\u3002\u4e0d\u662f\u9b54\u6cd5\uff0c\u662f\u5b9e\u5b9e\u5728\u5728\u7684\u8def\u5f84\u3002",
    "\u5979\u7528\u4e86\u2018\u5927\u7eb2\u5230\u5168\u6587\u2019\u529f\u80fd\u3002\u8f93\u5165\u51e0\u4e2a\u5173\u952e\u8bcd\uff0cApp\u5728\u51e0\u5206\u949f\u5185\u62c9\u51fa\u7ed3\u6784\u3001\u5f15\u7528\u3001\u751a\u81f3\u56fe\u8868\u3002\u7136\u540e\uff0c\u5979\u4e00\u952e\u5bfc\u51faPDF\uff0c\u683c\u5f0f\u5b8c\u7f8e\u3002\u5979\u8bf4\uff1a\u8fd9\u611f\u89c9\u50cf\u4f5c\u5f0a\uff0c\u4f46\u5176\u5b9e\u662f\u7701\u6389\u4e86\u6240\u6709\u5361\u5728\u74f6\u9888\u7684\u6d6a\u8d39\u3002",
    "\u73b0\u5728\uff0c\u8f6e\u5230\u4f60\u4f53\u9a8c\u8fd9\u79cd\u91ca\u653e\u3002\u6253\u5f00Thesis Generator\uff0c\u8bd5\u8bd5\u2018\u5927\u7eb2\u5230\u5168\u6587\u2019\u529f\u80fd\u3002P.S. \u5c0f\u9648\u540e\u6765\u544a\u8bc9\u6211\u4eec\uff0c\u5979\u628a\u8fd9\u591a\u51fa\u6765\u7684\u65f6\u95f4\u7528\u6765\u7761\u4e86\u4e2a\u597d\u89c9\u2014\u2014\u8fd9\u662f\u5f88\u591a\u5b66\u751f\u6700\u7f3a\u7684\u4e1c\u897f\u3002"
  ],
