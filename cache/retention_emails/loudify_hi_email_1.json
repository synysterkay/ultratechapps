{
  "subject": "30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u0906\u0935\u093e\u091c\u093c \u092c\u0926\u0932\u094b",
  "preview_text": "\u090f\u0915 \u0938\u093f\u0902\u092a\u0932 \u0938\u0947\u091f\u093f\u0902\u0917 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u094b \u092b\u091f\u093e\u092b\u091f \u091f\u094d\u092f\u0942\u0928 \u0915\u0930 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964 \u0915\u094b\u0908 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0935\u0947\u091f \u0928\u0939\u0940\u0902\u0964",
  "body_paragraphs": [
    "\u0924\u0941\u092e\u0928\u0947 \u0905\u092d\u0940-\u0905\u092d\u0940 Loudify \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u0936\u093e\u092f\u0926 \u0924\u0941\u092e \u0938\u094b\u091a \u0930\u0939\u0947 \u0939\u094b, '\u090f\u0915 \u0914\u0930 \u0910\u092a?' \u0932\u0947\u0915\u093f\u0928 \u0930\u0941\u0915\u094b\u0964 \u090f\u0915 \u092c\u093e\u0924 \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0924\u0941\u0930\u0902\u0924 \u0915\u093e\u092e \u0906\u090f\u0917\u0940 \u2014 \u0914\u0930 \u0907\u0938\u092e\u0947\u0902 \u0938\u093f\u0930\u094d\u092b 30 \u0938\u0947\u0915\u0902\u0921 \u0932\u0917\u0947\u0902\u0917\u0947\u0964",
    "\u091c\u092c \u0924\u0941\u092e \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0924\u0947 \u0939\u094b, \u0924\u094b AutoEQ \u0924\u0941\u0930\u0902\u0924 \u092a\u0939\u091a\u093e\u0928 \u0932\u0947\u0924\u093e \u0939\u0948 \u0915\u093f \u0924\u0941\u092e \u0915\u094d\u092f\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u0930\u0939\u0947 \u0939\u094b\u0964 \u092b\u093f\u0930 \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092e\u094d\u092f\u0942\u091c\u093f\u0915, \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u092f\u093e \u0917\u0947\u092e \u0915\u0947 \u0932\u093f\u090f \u0938\u093e\u0909\u0902\u0921 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0938\u0947\u091f \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0915\u0941\u091b \u0915\u0930\u0928\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092c\u0938 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0938\u0941\u0928\u094b \u2014 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0915\u0947, \u0938\u093f\u0930\u094d\u092b \u0938\u093e\u092b\u093c \u0914\u0930 \u0924\u0947\u091c\u093c \u0906\u0935\u093e\u091c\u093c\u0964",
    "\u092f\u0939 \u0935\u0939 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b 100,000+ \u0932\u093f\u0938\u0928\u0930\u094d\u0938 \u0928\u0947 \u092a\u0938\u0902\u0926 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u0924\u0941\u092e \u092d\u0940 \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e \u0938\u0915\u0924\u0947 \u0939\u094b\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u092a\u0930\u0964",
    "\u0905\u092c \u0910\u092a \u0916\u094b\u0932\u094b\u0964 \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u0947 \u092f\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u094b\u0964 \u0914\u0930 \u0926\u0947\u0916\u094b \u0915\u093f \u0915\u0948\u0938\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0906\u0935\u093e\u091c\u093c \u0905\u091a\u093e\u0928\u0915 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0938\u093e\u092b\u093c \u0914\u0930 \u0924\u0947\u091c\u093c \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u2014 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u0936\u0941\u0930\u0941\u0906\u0924 \u0939\u0948\u0964 \u0905\u0917\u0932\u0947 \u0908\u092e\u0947\u0932 \u092e\u0947\u0902 \u092e\u0948\u0902 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092c\u0924\u093e\u090a\u0902\u0917\u093e \u0915\u093f \u0915\u0948\u0938\u0947 \u0924\u0941\u092e \u0905\u092a\u0928\u0947 \u0938\u093e\u0909\u0902\u0921 DNA \u0915\u094b \u091f\u094d\u0930\u0948\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964"
