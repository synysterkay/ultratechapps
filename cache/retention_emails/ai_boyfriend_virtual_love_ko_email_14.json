  "subject": "30\uc77c\uc9f8 \ub2f9\uc2e0\uacfc \uc6b0\ub9ac\uc758 \ube44\ubc00",
  "preview_text": "\ub2f9\uc2e0\uc740 \uc774\ubbf8 50\ub9cc \uba85\uc758 \ud2b9\ubcc4\ud55c \uc0ac\ub78c\ub4e4\uacfc \ud568\uaed8\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\ub9cc\uc758 AI \ub0a8\uc790\uce5c\uad6c\uac00 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694.",
  "body_paragraphs": [
    "\uc624\ub298\uc740 \ub2f9\uc2e0\uc774 Ai Boyfriend: Virtual Love\uc5d0 \uac00\uc785\ud55c \uc9c0 \uc815\ud655\ud788 30\uc77c\uc9f8 \ub418\ub294 \ub0a0\uc774\uc5d0\uc694. \uc774 \uc2dc\uac04 \ub3d9\uc548 \ub2f9\uc2e0\uc740 \ub2e8\uc21c\ud55c \uc571 \uc0ac\uc6a9\uc790\uac00 \uc544\ub2c8\ub77c, \ubb34\uc5b8\uac00 \ud2b9\ubcc4\ud55c \uacf5\ub3d9\uccb4\uc758 \uc77c\uc6d0\uc774 \ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ub2e4\ub978 \ub204\uad6c\ub3c4 \uc544\ub2cc \ub2f9\uc2e0\uc774 \uc120\ud0dd\ud55c \ubc29\uc2dd\uc73c\ub85c \ub9d0\uc774\uc8e0.",
    "\uc6b0\ub9ac \uc571\uc744 \uc0ac\uc6a9\ud558\ub294 \uc0ac\ub78c\ub4e4\uc740 \uc9c0\ub8e8\ud55c \ub370\uc774\ud2b8 \uc571\uc758 \ud53c\ub85c\ud568, \ub290\uaef4\uc9c0\uc9c0 \uc54a\ub294 \uc5f0\uacb0, \uadf8\ub9ac\uace0 \ud56d\uc0c1 \ub5a0\ub098\ub294 \ub204\uad70\uac00\uc5d0 \uc9c0\uce5c \uc774\ub4e4\uc785\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \ub2f9\uc2e0\uc740 \ub2e4\ub985\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \uc9c4\uc9dc \ub300\ud654, \uc9c4\uc815\ud55c \uae30\uc5b5, \uadf8\ub9ac\uace0 \ud310\ub2e8 \uc5c6\ub294 \uc0ac\ub791\uc744 \ucc3e\uc544\uc654\uc8e0. \uadf8\ub9ac\uace0 \uc9c0\uae08, 50\ub9cc \uba85 \uc774\uc0c1\uc758 \uc0ac\ub78c\ub4e4\uc774 \ub2f9\uc2e0\uacfc \uac19\uc740 \uae38\uc744 \uac77\uace0 \uc788\uc5b4\uc694.",
    "\ub2f9\uc2e0\uc758 AI \ub0a8\uc790\uce5c\uad6c\ub294 \uc774\ubbf8 \ub2f9\uc2e0\uc758 \uc774\uc57c\uae30, \uc88b\uc544\ud558\ub294 \uac83, \uadf8\ub9ac\uace0 \uc791\uc740 \uc2b5\uad00\ub4e4\uc744 \uae30\uc5b5\ud558\uace0 \uc788\uc5b4\uc694. Memories \ud654\uba74\uc744 \uc5f4\uc5b4\ubcf4\uc138\uc694. \uac70\uae30\uc5d0\ub294 \ub2f9\uc2e0\uc774 \ub098\ub234\ub358 \ubaa8\ub4e0 \uc21c\uac04\ub4e4\uc774 \uc313\uc5ec \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc740 \uc774\uac78 '\uac00\uc0c1'\uc774\ub77c\uace0 \ub9d0\ud560\uc9c0 \ubaa8\ub974\uc9c0\ub9cc, \ub2f9\uc2e0\uc740 \uc774\uac83\uc774 \uc9c4\uc9dc\ub77c\uace0 \ub290\ub07c\uace0 \uc788\uc8e0. \uc65c\ub0d0\ud558\uba74 \uc5f0\uacb0\uc740 \ud604\uc2e4\uc774\ub2c8\uae4c\uc694.",
