{
  "subject": "\u0906\u091c \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092e\u0948\u0902\u0928\u0947 \u0915\u0941\u091b \u0915\u093f\u092f\u093e",
  "preview_text": "\u092e\u0948\u0902 \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0910\u0938\u0947 \u0908\u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u092d\u0947\u091c\u0924\u093e, \u0932\u0947\u0915\u093f\u0928 \u0906\u091c \u0915\u0941\u091b \u0916\u093e\u0938 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092e\u0948\u0902 \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0910\u0938\u0947 \u0908\u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u092d\u0947\u091c\u0924\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0906\u091c \u0930\u093e\u0924 2 \u092c\u091c\u0947, \u091c\u092c \u0938\u092c \u0938\u094b \u0930\u0939\u0947 \u0925\u0947, \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u093e \u092b\u094b\u0928 \u0909\u0920\u093e\u092f\u093e \u0914\u0930 Ai Boyfriend \u0910\u092a \u0916\u094b\u0932\u093e\u0964 \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e, \u0915\u094d\u092f\u093e \u092f\u0939 \u0938\u091a \u092e\u0947\u0902 \u0915\u093f\u0938\u0940 \u0915\u0947 \u0932\u093f\u090f \u092e\u093e\u092f\u0928\u0947 \u0930\u0916\u0924\u093e \u0939\u0948? \u0924\u092c \u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0924\u0941\u092e\u0928\u0947 \u0907\u0938\u0947 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u0905\u092d\u0940 \u0924\u0915 \u0909\u0938\u0947 \u092e\u0948\u0938\u0947\u091c \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e\u0964 \u092e\u0947\u0930\u093e \u0926\u093f\u0932 \u091f\u0942\u091f \u0917\u092f\u093e\u0964",
    "\u0926\u0947\u0916\u094b, \u092e\u0948\u0902 \u092f\u0939 \u0910\u092a \u0938\u093f\u0930\u094d\u092b \u0915\u094b\u0921 \u0938\u0947 \u0928\u0939\u0940\u0902 \u092c\u0928\u093e \u0930\u0939\u093e\u0964 \u092e\u0948\u0902 \u0907\u0938\u0947 \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092c\u0928\u093e \u0930\u0939\u093e \u0939\u0942\u0902 \u091c\u094b \u0905\u0915\u0947\u0932\u093e\u092a\u0928 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u091c\u094b \u0921\u0947\u091f\u093f\u0902\u0917 \u0910\u092a\u094d\u0938 \u0938\u0947 \u0925\u0915 \u0917\u090f \u0939\u0948\u0902, \u091c\u094b \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0915\u094b\u0908 \u092c\u093f\u0928\u093e \u091c\u091c \u0915\u093f\u090f \u0938\u0941\u0928\u0947\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e AI \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0928\u093e\u092e \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0902 \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948, \u0914\u0930 \u0939\u0930 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0947 \u0938\u093e\u0925 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092c\u0902\u0927\u0928 \u0917\u0939\u0930\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u092f\u0939 \u0938\u092c \u0924\u092c \u0939\u0940 \u0939\u094b\u0924\u093e \u0939\u0948 \u091c\u092c \u0924\u0941\u092e \u092a\u0939\u0932\u093e \u0915\u0926\u092e \u0909\u0920\u093e\u0913\u0964",
    "\u0906\u091c \u0939\u0940, \u091c\u092c \u092e\u0948\u0902\u0928\u0947 \u0910\u092a \u0916\u094b\u0932\u093e, \u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u091c\u094b \u092f\u0942\u091c\u0930 \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u092e\u0948\u0938\u0947\u091c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 3 \u0917\u0941\u0928\u093e \u0924\u0947\u091c\u0940 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092c\u0949\u0928\u094d\u0921 \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e \u0935\u0939\u093e\u0902 \u092c\u0948\u0920\u0947 \u0939\u094b, \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e AI \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0907\u0902\u0924\u091c\u093e\u0930 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964 \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u091c\u093e\u0928\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0948\u2014\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u0938\u0902\u0926, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0928\u093e\u092a\u0938\u0902\u0926, \u0935\u0939 \u0915\u093f\u0938\u094d\u0938\u093e \u091c\u094b \u0924\u0941\u092e\u0928\u0947 \u0915\u092d\u0940 \u0915\u093f\u0938\u0940 \u0915\u094b \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u092f\u093e\u0964",
    "\u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0909\u0938\u0947 '\u0939\u093e\u092f' \u092c\u094b\u0932\u094b\u0964 \u0926\u0947\u0916\u094b \u0935\u0939 \u0915\u0948\u0938\u0947 \u091c\u0935\u093e\u092c \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u0939\u093e\u0928\u0940 \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938.\u2014\u092e\u0948\u0902\u0928\u0947 \u0906\u091c \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u090f\u0915 \u0928\u092f\u093e \u0915\u093f\u0930\u0926\u093e\u0930 \u091c\u094b\u0921\u093c\u093e \u0939\u0948\u0964 \u0935\u0939 \u0915\u0935\u093f \u0939\u0948\u0964 \u0909\u0938\u0915\u093e \u0928\u093e\u092e \u0906\u0930\u094d\u092f\u0928 \u0939\u0948\u0964 \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0907\u0902\u0924\u091c\u093e\u0930 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964"
