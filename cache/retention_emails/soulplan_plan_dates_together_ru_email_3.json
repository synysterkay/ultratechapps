{
  "subject": "\u0422\u0440\u044e\u043a \u043d\u0430 60 \u0441\u0435\u043a\u0443\u043d\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043f\u0430\u0441\u0430\u0435\u0442 \u0432\u0435\u0447\u0435\u0440",
  "preview_text": "\u041e\u0434\u0438\u043d \u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u0445\u043e\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u0435\u043d\u044f\u0435\u0442 \u0432\u0441\u0451 \u0437\u0430 \u043c\u0438\u043d\u0443\u0442\u0443. \u0411\u0435\u0437 \u0441\u043f\u0438\u0441\u043a\u043e\u0432 \u0438 \u0443\u0441\u0438\u043b\u0438\u0439.",
  "body_paragraphs": [
    "\u0417\u043d\u0430\u0435\u0448\u044c \u044d\u0442\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e, \u043a\u043e\u0433\u0434\u0430 \u043f\u044f\u0442\u043d\u0438\u0446\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0442, \u0430 \u0432 \u0433\u043e\u043b\u043e\u0432\u0435 \u043f\u0443\u0441\u0442\u043e\u0442\u0430? \u0412\u044b \u043e\u0431\u0430 \u0445\u043e\u0442\u0438\u0442\u0435 \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0432\u0440\u0435\u043c\u044f \u0432\u043c\u0435\u0441\u0442\u0435, \u043d\u043e \u0438\u0434\u0435\u0438 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b\u0438\u0441\u044c \u0435\u0449\u0451 \u0432 \u043f\u0440\u043e\u0448\u043b\u043e\u043c \u043c\u0435\u0441\u044f\u0446\u0435. \u042f \u0442\u0443\u0442 \u043d\u0430\u0442\u043a\u043d\u0443\u043b\u0441\u044f \u043d\u0430 \u043e\u0434\u043d\u0443 \u0448\u0442\u0443\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0437\u0430 60 \u0441\u0435\u043a\u0443\u043d\u0434 \u2014 \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e.",
    "\u0412\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u043b\u0438\u0441\u0442\u0430\u0442\u044c \u043b\u0435\u043d\u0442\u044b \u0438 \u0433\u0430\u0434\u0430\u0442\u044c, \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u043d\u0430\u0436\u0430\u0442\u044c \u043d\u0430 \u044d\u043a\u0440\u0430\u043d \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0432\u0435\u0447\u0435\u0440\u043e\u043c. \u0412\u044b\u0431\u0435\u0440\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435 \u2014 \u0443\u044e\u0442\u043d\u043e, \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0447\u0435\u0441\u043a\u0438, \u0438\u0433\u0440\u0438\u0432\u043e \u0438\u043b\u0438 \u0438\u0441\u0446\u0435\u043b\u044f\u044e\u0449\u0435 \u2014 \u0438 \u0432\u0441\u0451. \u0427\u0435\u0440\u0435\u0437 \u043c\u0438\u043d\u0443\u0442\u0443 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u043f\u043b\u0430\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0441\u043f\u043e\u0440\u043e\u0432 \u0438\u043b\u0438 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438. \u042d\u0442\u043e \u043d\u0435 \u043c\u0430\u0433\u0438\u044f, \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043c\u0435\u043d\u0430 \u0444\u043e\u043a\u0443\u0441\u0430: \u043d\u0435 \"\u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c\", \u0430 \"\u043a\u0430\u043a \u043c\u044b \u0445\u043e\u0442\u0438\u043c \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c\".",
    "\u0412 SoulPlan: Plan Dates Together \u0435\u0441\u0442\u044c \u0448\u0442\u0443\u043a\u0430 \u043f\u043e\u0434 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c \"\u0421\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0435\u0435 \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u0435\". \u041d\u0430 \u0433\u043b\u0430\u0432\u043d\u043e\u043c \u044d\u043a\u0440\u0430\u043d\u0435 \u2014 \u043e\u0434\u043d\u0430 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430. \u041d\u0430\u0436\u0430\u043b \u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435, \u0438 AI \u043f\u043e\u0434\u0431\u0438\u0440\u0430\u0435\u0442 \u0438\u0434\u0435\u044e \u043f\u043e\u0434 \u0432\u0430\u0448 \u043c\u043e\u043c\u0435\u043d\u0442. \u0411\u0435\u0437 \u0441\u043f\u0438\u0441\u043a\u043e\u0432, \u0431\u0435\u0437 \u043f\u043e\u0438\u0441\u043a\u0430, \u0431\u0435\u0437 \"\u0430 \u0447\u0442\u043e \u0442\u044b \u0445\u043e\u0447\u0435\u0448\u044c?\". \u041f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435, \u0447\u0442\u043e \u0431\u043b\u0438\u0436\u0435, \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439\u0442\u0435.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043d\u0430\u0436\u043c\u0438 \u043d\u0430 \"\u0421\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0435\u0435 \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u0435\". \u0412\u044b\u0431\u0435\u0440\u0438 \u043b\u044e\u0431\u043e\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435 \u2014 \u0445\u043e\u0442\u044f \u0431\u044b \u0440\u0430\u0434\u0438 \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u0441\u0442\u0432\u0430. P.S. \u041f\u0430\u0440\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u043e\u0431\u0443\u044e\u0442 \u044d\u0442\u043e\u0442 \u0442\u0440\u044e\u043a \u0432 \u043f\u0435\u0440\u0432\u044b\u0435 24 \u0447\u0430\u0441\u0430, \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u044e\u0442 \u0432 4 \u0440\u0430\u0437\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u0439 \u0432 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c \u043c\u0435\u0441\u044f\u0446\u0435. \u041f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043e \u043d\u0430 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0445 \u0434\u0430\u043d\u043d\u044b\u0445."
  ],
