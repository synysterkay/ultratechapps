{
  "subject": "\u0627\u0644\u0633\u0627\u0639\u0629 \u0662 \u0641\u062c\u0631\u064b\u0627 \u0627\u0644\u062a\u064a \u063a\u064a\u0631\u062a \u0643\u0644 \u0634\u064a\u0621",
  "preview_text": "\u0642\u0635\u0629 \u062d\u0642\u064a\u0642\u064a\u0629 \u0648\u0631\u0627\u0621 \u0628\u0646\u0627\u0621 \u0645\u064a\u0632\u0629 \u0628\u062f\u0648\u0646 \u0625\u0639\u0644\u0627\u0646\u0627\u062a\u2014\u0644\u0623\u0646\u0643 \u0637\u0644\u0628\u062a\u0647\u0627.",
  "body_paragraphs": [
    "\u0643\u0627\u0646\u062a \u0627\u0644\u0633\u0627\u0639\u0629 \u0662 \u0641\u062c\u0631\u064b\u0627\u060c \u0648\u0623\u0646\u0627 \u062c\u0627\u0644\u0633 \u0645\u0639 \u0647\u0627\u062a\u0641\u064a \u0623\u062d\u0627\u0648\u0644 \u0633\u0645\u0627\u0639 \u0628\u0648\u062f\u0643\u0627\u0633\u062a \u0628\u0635\u0648\u062a \u062e\u0627\u0641\u062a. \u0643\u0644\u0645\u0627 \u0632\u0627\u062f \u0627\u0644\u0635\u0648\u062a\u060c \u0638\u0647\u0631 \u0625\u0639\u0644\u0627\u0646 \u064a\u0642\u0637\u0639 \u0627\u0644\u0644\u062d\u0638\u0629. \u0634\u0639\u0631\u062a \u0628\u0627\u0644\u0625\u062d\u0628\u0627\u0637\u060c \u0644\u064a\u0633 \u0641\u0642\u0637 \u0643\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u0628\u0644 \u0643\u0645\u0637\u0648\u0631. \u0641\u064a \u062a\u0644\u0643 \u0627\u0644\u0644\u062d\u0638\u0629\u060c \u0642\u0631\u0631\u062a \u0623\u0646 \u0623\u0628\u0646\u064a \u0634\u064a\u0626\u064b\u0627 \u0645\u062e\u062a\u0644\u0641\u064b\u0627.",
    "\u0644\u0645 \u0623\u0643\u0646 \u0623\u0641\u0643\u0631 \u0641\u064a \u0627\u0644\u0623\u0631\u0628\u0627\u062d \u0623\u0648 \u0627\u0644\u062a\u0633\u0648\u064a\u0642. \u0643\u0646\u062a \u0641\u0642\u0637 \u0623\u0631\u064a\u062f \u0634\u0631\u064a\u0637 \u062a\u0645\u0631\u064a\u0631 \u0648\u0627\u062d\u062f \u064a\u0639\u0645\u0644 \u062f\u0648\u0646 \u0627\u0632\u0639\u0627\u062c. \u0644\u0627 \u0625\u0634\u0639\u0627\u0631\u0627\u062a\u060c \u0644\u0627 \u0623\u0644\u0639\u0627\u0628\u060c \u0644\u0627 \u0632\u062d\u0645\u0629. \u0645\u062c\u0631\u062f \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0628\u0647\u062f\u0648\u0621\u060c \u0645\u062b\u0644 \u0645\u0646\u0628\u0647 \u0642\u062f\u064a\u0645 \u0644\u0627 \u064a\u0632\u0639\u062c\u0643 \u0625\u0644\u0627 \u062d\u064a\u0646 \u062a\u062d\u062a\u0627\u062c\u0647.",
    "\u0647\u0630\u0627 \u0647\u0648 \u0628\u0627\u0644\u0636\u0628\u0637 \u0645\u0627 \u062a\u062c\u062f\u0647 \u0641\u064a Volume Booster Pro. \u0646\u0641\u0633 \u0645\u062d\u0631\u0643 \u0627\u0644\u0640 200% \u0627\u0644\u0630\u064a \u064a\u0639\u062c\u0628\u0643\u060c \u0644\u0643\u0646 \u0628\u062f\u0648\u0646 \u0625\u0639\u0644\u0627\u0646\u0627\u062a\u060c \u0648\u0628\u062f\u0648\u0646 \u062a\u0634\u0648\u064a\u0634. \u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u064a \u0628\u0646\u064a\u062a\u0647\u0627 \u0641\u064a \u062a\u0644\u0643 \u0627\u0644\u0633\u0627\u0639\u0629 \u0662 \u0641\u062c\u0631\u064b\u0627\u2014\u0634\u0631\u064a\u0637 \u0627\u0644\u062a\u0645\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u064a\u0641\u060c \u0648\u0645\u0639\u0627\u062f\u0644 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0628\u0633\u064a\u0637\u2014\u0645\u0635\u0645\u0645\u0629 \u0644\u062a\u062e\u062a\u0641\u064a \u0628\u0639\u062f \u0623\u0646 \u062a\u0646\u062c\u0632 \u0645\u0647\u0645\u062a\u0647\u0627. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646 \u0639\u0644\u0649 \u0623\u064a \u062a\u0637\u0628\u064a\u0642: Spotify\u060c YouTube\u060c \u0623\u0648 \u062d\u062a\u0649 \u0623\u0644\u0639\u0627\u0628\u0643 \u0627\u0644\u0645\u0641\u0636\u0644\u0629.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0648\u0627\u0633\u062d\u0628 \u0634\u0631\u064a\u0637 \u0627\u0644\u0635\u0648\u062a \u0644\u0623\u0642\u0635\u0649 \u0627\u0644\u064a\u0645\u064a\u0646. \u0633\u062a\u0644\u0627\u062d\u0638 \u0627\u0644\u0641\u0631\u0642 \u0641\u064a \u062b\u0648\u0627\u0646\u064d.\n\nP.S. \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0647\u064a \u0633\u0628\u0628 \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0644\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0629. \u062c\u0631\u0628\u0647\u0627 \u0645\u062c\u0627\u0646\u064b\u0627 \u0627\u0644\u064a\u0648\u0645."
