{
  "subject": "\uc0c1\uc704 1% \ucee4\ud50c\uc774 \ub370\uc774\ud2b8\ub97c \uacc4\ud68d\ud558\ub294 \ubc95",
  "preview_text": "\uadf8\ub4e4\uc740 30\ucd08\uba74 \ub05d\ub0c5\ub2c8\ub2e4. \ub2f9\uc2e0\ub3c4 \uc624\ub298 \ubc24\ubd80\ud130 \ub530\ub77c\ud560 \uc218 \uc788\ub294 \ube44\ubc00 \uc6cc\ud06c\ud50c\ub85c\uc6b0\ub97c \uacf5\uac1c\ud569\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uc9c0\ub09c\uc8fc, \ud55c \ucee4\ud50c\uc774 \uc571\uc5d0\uc11c 3\ubd84 \ub9cc\uc5d0 \uc774\ubc88 \uc8fc\ub9d0 \uc804\uccb4\ub97c \uacc4\ud68d\ud588\uc2b5\ub2c8\ub2e4. \uadf8\ub4e4\uc740 '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ud55c \ubc88 \ud0ed\ud55c \ub4a4, \ud30c\ud2b8\ub108\uc5d0\uac8c '\uc624\ub298 \ub108 \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \ud480\uc2a4\ud06c\ub9b0 \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0c8\uc8e0. \ub2f9\uc2e0\ub3c4 \ub611\uac19\uc774 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
    "\uc0c1\uc704 1% \uc0ac\uc6a9\uc790\ub4e4\uc740 '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ud558\ub8e8 30\ucd08\ub9cc \uc501\ub2c8\ub2e4. \uae30\ubd84\uc744 \uace0\ub974\uba74 AI\uac00 \ubc14\ub85c \uce74\ub4dc\ub97c \ub744\uc6b0\uace0, \uadf8\ub4e4\uc740 \ubcf4\ub0b4\uae30\ub9cc \ud558\uba74 \ub05d. \uc774 \uac04\ub2e8\ud55c \ub8e8\ud2f4\uc774 \ub370\uc774\ud2b8 \ube48\ub3c4\ub97c 4\ubc30\ub85c \ub298\ub9bd\ub2c8\ub2e4. \uadf8\ub4e4\uc740 '\uacc4\ud68d \ud53c\ub85c'\ub97c \ub290\ub07c\uc9c0 \uc54a\uc544\uc694.",
    "\uc774 \uc6cc\ud06c\ud50c\ub85c\uc6b0\uc758 \ud575\uc2ec\uc740 '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \uae30\ub2a5\uc785\ub2c8\ub2e4. \ud648 \ud654\uba74\uc5d0\uc11c \uae30\ubd84 \ud558\ub098\ub9cc \uace0\ub974\uc138\uc694. 30\ucd08\uba74 \ub370\uc774\ud2b8\uac00 \uc644\uc131\ub429\ub2c8\ub2e4. \ud30c\ud2b8\ub108\ub294 \ub2f9\uc2e0\uc774 \uadf8\ub97c \uc0dd\uac01\ud588\ub2e4\ub294 \uc21c\uac04\uc744 \uacbd\ud5d8\ud558\uace0, \ub2f9\uc2e0\uc740 '\ub610 \ubb50\ud558\uc9c0?'\ub77c\ub294 \uace0\ubbfc\uc5d0\uc11c \ud574\ubc29\ub429\ub2c8\ub2e4.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0 '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ud55c \ubc88\ub9cc \uc368\ubcf4\uc138\uc694. \ucee4\ud50c \uc544\uc774\ub374\ud2f0\ud2f0\uac00 \ub354 \uc120\uba85\ud574\uc9c8 \uac70\uc608\uc694. P.S. '\uae30\uc5b5 \ud0c0\uc784\ub77c\uc778'\uc5d0 \uc624\ub298\uc758 \uc0ac\uc9c4\uc744 \ub0a8\uae30\uba74, \ud55c \ub2ec \ud6c4 \ub2f9\uc2e0\uc774 \uc5bc\ub9c8\ub098 \uc790\uc8fc \ub370\uc774\ud2b8\ub97c \ud588\ub294\uc9c0 \ub180\ub77c\uac8c \ub420 \uac81\ub2c8\ub2e4."
  ],
