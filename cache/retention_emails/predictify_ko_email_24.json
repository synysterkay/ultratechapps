{
  "subject": "\ud55c \uc0ac\uc6a9\uc790\uc758 \ud3ed\ub85c\uac00 \uc6b0\ub9ac \ud300\uc744 \uce68\ubb35\uc2dc\ucf30\ub2e4",
  "preview_text": "\uadf8\uac00 \ubc1c\uacac\ud55c \uc608\uce21 \ube44\ubc00, \ub2f9\uc2e0\ub3c4 \uc54c\uc544\uc57c \ud569\ub2c8\ub2e4. \ub180\ub77c\uc6b4 \uc774\uc57c\uae30\ub97c \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "\uc9c0\ub09c\uc8fc, \ud55c \uc0ac\uc6a9\uc790\uac00 \ubcf4\ub0b8 \uba54\uc2dc\uc9c0\uc5d0 \uc6b0\ub9ac \ud300 \uc804\uccb4\uac00 \uc228\uc744 \uba48\ucdc4\uc5b4. \uadf8\ub294 \ub2e8\uc21c\ud55c \ucd95\uad6c \ud32c\uc774\uc5c8\uc9c0\ub9cc, \ub370\uc774\ud130\ub97c \ubbff\uace0 \uc608\uce21\uc744 \ub530\ub77c\uac14\uc744 \ubfd0\uc778\ub370 \ud55c \ub2ec \ub9cc\uc5d0 \ub180\ub77c\uc6b4 \uacb0\uacfc\ub97c \uc5bb\uc5c8\ub2e4\uace0 \ud588\uc5b4. \uadf8\uc758 \uc774\uc57c\uae30\ub294 \uc6b0\ub9ac\uac00 \ub9cc\ub4e0 \uc774 \uc571\uc774 \uc2e4\uc81c\ub85c \uc0ac\ub78c\ub4e4\uc744 \ubcc0\ud654\uc2dc\ud0a8\ub2e4\ub294 \uac78 \uc99d\uba85\ud588\uc9c0.",
    "\uadf8\ub294 \uc6d0\ub798 '\uac10'\ub9cc \ubbff\uace0 \ubc30\ud305\ud558\ub2e4\uac00 \ub9e4\ubc88 \uc2e4\ud328\ud588\ub300. \uadf8\ub7f0\ub370 Predictify\uc758 AI \ubd84\uc11d\uc744 \uc2e0\ub8b0\ud558\uae30 \uc2dc\uc791\ud558\uba74\uc11c, \uacbd\uae30 \uc804\uc5d0 \uc81c\uacf5\ub418\ub294 xG\uc640 \uc218\ube44 \uac15\ub3c4 \uac19\uc740 \ub370\uc774\ud130\ub97c \uaf3c\uaf3c\ud788 \ud655\uc778\ud588\uc5b4. \uccab \uc8fc\uc5d0\ub294 \ubc18\uc2e0\ubc18\uc758\ud588\uc9c0\ub9cc, \uc810\uc810 \uc790\uc2e0\uac10\uc774 \ubd99\uc73c\uba74\uc11c \uc608\uce21 \uc131\uacf5\ub960\uc774 \ud655 \uc62c\ub77c\uac14\ub2e4\uace0 \ud574.",
    "\ud2b9\ud788 \uadf8\uac00 \uac00\uc7a5 \ub9ce\uc774 \uc0ac\uc6a9\ud55c \uae30\ub2a5\uc740 'AI \ucc44\ud305'\uc774\uc5c8\uc5b4. \uacbd\uae30 \uc804\uc5d0 '\uc774 \ud300\uc758 \ucd5c\uadfc 5\uacbd\uae30 \uc810\uc720\uc728\uacfc \ubd80\uc0c1\uc790 \uba85\ub2e8\uc774 \uacb0\uacfc\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \uc904\uae4c?' \uac19\uc740 \uc9c8\ubb38\uc744 \ub358\uc9c0\uba74, AI\uac00 \uc989\uc2dc \ub370\uc774\ud130\ub97c \ubd84\uc11d\ud574 \ub2f5\ubcc0\ud574\uc92c\ub300. \uc774\uac74 \ub2e8\uc21c\ud55c \uc608\uce21\uc744 \ub118\uc5b4, \ub108\ub97c \uc9c4\uc9dc \ucd95\uad6c \uc804\ubb38\uac00\ub85c \ub9cc\ub4e4\uc5b4\uc8fc\ub294 \ub3c4\uad6c\uc57c.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uace0 'AI \ucc44\ud305'\uc5d0 \ub4e4\uc5b4\uac00 \ubd10. \ub124\uac00 \uac00\uc7a5 \uad81\uae08\ud55c \uacbd\uae30\ub098 \uc120\uc218\uc5d0 \ub300\ud574 \ubb3c\uc5b4\ubcf4\ub294 \uac70\uc57c. P.S. \uc0ac\uc2e4 \uadf8 \uc0ac\uc6a9\uc790\ub294 \ud504\ub9ac\ubbf8\uc5c4 3\uc77c \ubb34\ub8cc \uccb4\ud5d8\uc744 \uc2dc\uc791\ud55c \uc9c0 \uc77c\uc8fc\uc77c \ub9cc\uc5d0 \uc815\uae30 \uad6c\ub3c5\uc790\ub85c \uc804\ud658\ud588\uc5b4. $12.99 \ud55c \ub2ec\uc774\uba74, \ub370\uc774\ud130\uac00 \uc99d\uba85\ud55c \uc2b9\ub9ac\ub97c \ub193\uce60 \uc218 \uc5c6\ub300."
  ],
