{
  "subject": "\ud55c \uc0ac\uc6a9\uc790\uac00 55\uc77c \ub9cc\uc5d0 \uc62c\ub9b0 \uc2b9\ub960 89%",
  "preview_text": "\uc774 \uc774\uc57c\uae30\ub97c \ub4e3\uace0 \ud300\u5168\u4f53\uac00 \uba48\ucdc4\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\ub3c4 \uc774 \ubc29\ubc95\uc744 \uc4f8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uc9c0\ub09c\uc8fc, \ud55c \uc0ac\uc6a9\uc790\uac00 \uc790\uc2e0\uc758 \uc608\uce21 \uae30\ub85d\uc744 \uacf5\uc720\ud588\ub294\ub370, \uc6b0\ub9ac \ud300 \uc804\uccb4\uac00 \uc77c\uc744 \uba48\ucd94\uace0 \uc77d\uc5c8\uc2b5\ub2c8\ub2e4. 55\uc77c \ub3d9\uc548 47\uacbd\uae30 \uc911 42\uacbd\uae30 \uc801\uc911, \uc2b9\ub960 89%. \uc6b4\uc774 \uc544\ub2c8\uc5c8\uc2b5\ub2c8\ub2e4. \uadf8\ub294 \ub370\uc774\ud130\ub97c \ubbff\uc5c8\uace0, Predictify\uc758 AI\uac00 \uadf8\ub97c \ub3c4\uc654\uc2b5\ub2c8\ub2e4.",
    "\uadf8\ub294 \ucc98\uc74c\uc5d0\ub294 '\uadf8\ub0e5 \uc7ac\ubbf8\ub85c' \uc2dc\uc791\ud588\ub2e4\uace0 \ub9d0\ud588\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \ub9e4 \uacbd\uae30 \uc804, AI\uac00 \ubd84\uc11d\ud55c \ubcc0\uc218\ub4e4\u2014xG, \uc810\uc720\uc728, \uc218\ube44 \uac15\ub3c4, \ucd5c\uadfc \ud3fc\u2014\uc744 \ud655\uc778\ud558\uace0 \ub098\uc11c\uc57c \uc790\uc2e0\uc758 \uc9c1\uac10\uc5d0 \ud655\uc2e0\uc744 \uac00\uc9c8 \uc218 \uc788\uc5c8\uc2b5\ub2c8\ub2e4. \uacb0\uacfc\ub294? \ub354 \uc774\uc0c1 '\uc544, \uc774\uac78 \ub193\ucce4\ub124'\ub77c\ub294 \ud6c4\ud68c\uac00 \uc5c6\uc5c8\uc2b5\ub2c8\ub2e4. \ub300\uc2e0, '\uc65c \uc774\uac78 \ub354 \uc77c\ucc0d \uc54c\uc558\uc744\uae4c'\ub77c\ub294 \uc0dd\uac01\ubfd0\uc774\uc5c8\uc2b5\ub2c8\ub2e4.",
    "\uc774\uc81c \ub2f9\uc2e0\ub3c4 \uac19\uc740 \ub3c4\uad6c\ub97c \uc190\uc5d0 \uc950\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc571\uc744 \uc5f4\uace0, \uc624\ub298 \uacbd\uae30 \uc911 \ud558\ub098\ub97c \uc120\ud0dd\ud574 \ubcf4\uc138\uc694\u2014\uc608\ub97c \ub4e4\uc5b4, '\ub9e8\uc2dc\ud2f0 vs \uc544\uc2a4\ub110' \uac19\uc740 \uc911\uc694\ud55c \ub9e4\uce58\uc5c5. AI\uac00 \uc81c\uacf5\ud558\ub294 \uc790\uc2e0\uac10 \uc810\uc218\uc640 \uc0c1\uc138\ud55c \ud1b5\uacc4\ub97c \ud655\uc778\ud574 \ubcf4\uc138\uc694. \uadf8 \uc0ac\uc6a9\uc790\ucc98\ub7fc, \ub2f9\uc2e0\ub3c4 \ub370\uc774\ud130\uac00 \ub9d0\ud574\uc8fc\ub294 \uc9c4\uc9dc \uc2b9\ubd80\ub97c \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0, \uc624\ub298\uc758 \uc608\uce21 \ud55c \uac1c\ub97c \uc9c1\uc811 \ud655\uc778\ud574 \ubcf4\uc138\uc694. P.S. \uadf8\uc758 \ube44\ubc00? \ub9e4\uc77c \ub85c\uadf8\uc778\ud558\uace0, AI \ucc44\ud305\uc73c\ub85c \uc9c8\ubb38\uc744 \ub358\uc9c0\ub294 \uac83\ubfd0\uc774\uc5c8\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\ub3c4 5\ucd08\uba74 \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
  ],
