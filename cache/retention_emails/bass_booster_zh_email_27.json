  "preview_text": "\u6211\u4eec\u5206\u6790\u4e8610,000\u540d\u7528\u6237\u7684\u542c\u6b4c\u4e60\u60ef\uff0c\u53d1\u73b0\u4e00\u4e2a\u8ba9\u6240\u6709Hip-Hop/EDM/Rock\u7231\u597d\u8005\u9707\u60ca\u7684\u4e8b\u5b9e\u3002\u6253\u5f00\u770b\u770b\uff0c\u4f60\u548c\u4f60\u7684\u624b\u673a\u5230\u5e95\u9519\u8fc7\u4e86\u4ec0\u4e48\u3002",
  "body_paragraphs": [
    "\u4f60\u77e5\u9053\u5417\uff1f\u6211\u4eec\u521a\u521a\u7ffb\u4e86\u4e00\u904d10,000\u540d\u7528\u6237\u7684\u542c\u6b4c\u6570\u636e\uff0c\u53d1\u73b0\u4e86\u4e00\u4e2a\u8ba9\u4eba\u540e\u80cc\u53d1\u51c9\u7684\u4e8b\u5b9e\uff1a\u8d85\u8fc770%\u7684\u4eba\uff0c\u7528\u624b\u673a\u542c\u6b4c\u65f6\uff0c\u6839\u672c\u6ca1\u6709\u771f\u6b63\u542c\u5230\u4f4e\u97f3\u3002\u4f60\u7684Hip-Hop\u9f13\u70b9\u3001EDM\u7684drop\uff0c\u5176\u5b9e\u90fd\u88ab\u624b\u673a\u626c\u58f0\u5668\u2018\u541e\u6389\u2019\u4e86\u3002\u542c\u8d77\u6765\u50cf\u9694\u7740\u4e00\u5c42\u68c9\u82b1\uff0c\u5bf9\u5417\uff1f",
