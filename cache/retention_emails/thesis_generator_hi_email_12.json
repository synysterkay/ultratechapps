{
  "subject": "\u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0935\u0939 \u0917\u0932\u0924\u0940 \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u090f\u0915 \u091b\u093e\u0924\u094d\u0930 \u0928\u0947 \u0935\u094b \u092b\u0940\u091a\u0930 \u0916\u094b\u091c\u093e \u091c\u094b \u0939\u0930 \u0915\u093f\u0938\u0940 \u0915\u094b \u091a\u093e\u0939\u093f\u090f\u0964 \u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902?",
  "body_paragraphs": [
    "\u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c \u0930\u0939\u0947 \u0925\u0947\u0964 \u090f\u0915 \u091b\u093e\u0924\u094d\u0930 8 \u0918\u0902\u091f\u0947 \u0938\u0947 \u0925\u0940\u0938\u093f\u0938 \u0932\u093f\u0916\u0928\u0947 \u092e\u0947\u0902 \u092b\u0902\u0938\u093e \u0925\u093e\u0964 \u0909\u0938\u0928\u0947 \u0938\u094b\u091a\u093e, '\u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0914\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964' \u0924\u092d\u0940 \u0909\u0938\u0928\u0947 \u0935\u0939 \u092c\u091f\u0928 \u0926\u092c\u093e\u092f\u093e \u091c\u094b \u0909\u0938\u0928\u0947 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u093e \u0925\u093e\u0964 \u0909\u0938\u0928\u0947 \u0938\u094b\u091a\u093e, '\u092f\u0939 \u0924\u094b \u092c\u0947\u0915\u093e\u0930 \u0939\u094b\u0917\u093e\u0964' \u0932\u0947\u0915\u093f\u0928 \u0905\u0917\u0932\u0947 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902, \u0909\u0938\u0915\u0940 \u092a\u0942\u0930\u0940 \u0925\u0940\u0938\u093f\u0938 \u0924\u0948\u092f\u093e\u0930 \u0925\u0940\u0964",
    "\u0935\u0939 \u092b\u0940\u091a\u0930 \u0925\u093e '\u0906\u0909\u091f\u0932\u093e\u0907\u0928 \u091f\u0942 \u092b\u0941\u0932 \u092a\u0947\u092a\u0930'\u0964 \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0907\u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0909\u0928\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u0939\u0940 \u0928\u0939\u0940\u0902 \u0915\u093f \u092f\u0939 \u0915\u093f\u0924\u0928\u093e \u0936\u0915\u094d\u0924\u093f\u0936\u093e\u0932\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0906\u092a\u0915\u0940 \u0916\u093e\u0932\u0940 \u092a\u0947\u091c \u0915\u094b 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u090f\u0915 \u092a\u0942\u0930\u093e \u092a\u0947\u092a\u0930 \u092c\u0928\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u2014\u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 AI \u0921\u093f\u091f\u0947\u0915\u094d\u0936\u0928 \u0915\u0947 \u0921\u0930 \u0915\u0947\u0964 \u0914\u0930 \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u0940 \u092c\u093e\u0924? \u092f\u0939 \u0906\u092a\u0915\u0947 \u0917\u094d\u0930\u0947\u0921 \u0915\u094b B+ \u0938\u0947 A- \u0924\u0915 \u0932\u0947 \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092a\u0928\u0947 \u0910\u092a \u092e\u0947\u0902, '\u0906\u0909\u091f\u0932\u093e\u0907\u0928' \u091f\u0948\u092c \u092a\u0930 \u091c\u093e\u090f\u0902\u0964 \u0935\u0939\u093e\u0902 \u090f\u0915 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u092c\u091f\u0928 \u0939\u0948 \u091c\u094b '\u092b\u0941\u0932 \u092a\u0947\u092a\u0930' \u0915\u0939\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0947 \u0926\u092c\u093e\u090f\u0902, \u0914\u0930 \u0905\u092a\u0928\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b \u0905\u092a\u0928\u0947 \u0938\u093e\u092e\u0928\u0947 \u091c\u0940\u0935\u0902\u0924 \u0939\u094b\u0924\u0947 \u0926\u0947\u0916\u0947\u0902\u0964 \u092f\u0939 \u090f\u0915 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902 \u0939\u0948\u2014\u092f\u0939 \u090f\u0915 \u0910\u0938\u093e \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b 50,000+ \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0928\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948\u2014\u0905\u092a\u0928\u093e \u092a\u0947\u092a\u0930 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u092f\u0939 \u092b\u0940\u091a\u0930 \u0906\u092a\u0915\u094b \u0915\u093f\u0924\u0928\u093e \u0938\u092e\u092f \u092c\u091a\u093e\u0924\u093e \u0939\u0948\u0964 P.S. \u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c AI \u091f\u0947\u0915\u094d\u0938\u094d\u091f' \u092b\u0940\u091a\u0930 \u092d\u0940 \u0939\u0948? \u092f\u0939 \u0906\u092a\u0915\u0947 AI-\u0932\u093f\u0916\u093f\u0924 \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0915\u094b \u0907\u0924\u0928\u093e \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u092c\u0928\u093e \u0926\u0947\u0924\u093e \u0939\u0948 \u0915\u093f Turnitin \u092d\u0940 \u0928\u0939\u0940\u0902 \u092a\u0915\u0921\u093c \u0938\u0915\u0924\u093e\u0964"
  ],
