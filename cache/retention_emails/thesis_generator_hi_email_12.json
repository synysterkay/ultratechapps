{
  "subject": "\u0935\u094b \u092b\u0940\u091a\u0930 \u091c\u094b 90% \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u094b \u0928\u0939\u0940\u0902 \u092a\u0924\u093e",
  "preview_text": "\u090f\u0915 \u092f\u0942\u091c\u0930 \u0928\u0947 \u0907\u0938\u0915\u0940 \u092e\u0926\u0926 \u0938\u0947 \u0930\u093e\u0924\u094b\u0902-\u0930\u093e\u0924 \u0905\u092a\u0928\u093e \u0917\u094d\u0930\u0947\u0921 \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964 \u0915\u094d\u092f\u093e \u0924\u0941\u092e \u092d\u0940 \u0907\u0938\u0947 \u0907\u0917\u094d\u0928\u094b\u0930 \u0915\u0930 \u0930\u0939\u0947 \u0939\u094b?",
  "body_paragraphs": [
    "\u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f Thesis Generator \u0938\u093f\u0930\u094d\u092b \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0915\u0932 \u090f\u0915 \u092f\u0942\u091c\u0930 \u0928\u0947 \u092e\u0941\u091d\u0947 \u092e\u0948\u0938\u0947\u091c \u0915\u093f\u092f\u093e \u0915\u093f \u0909\u0938\u0928\u0947 \u090f\u0915 \u0910\u0938\u093e \u092b\u0940\u091a\u0930 \u0916\u094b\u091c \u0932\u093f\u092f\u093e \u091c\u093f\u0938\u0928\u0947 \u0909\u0938\u0915\u0940 \u092a\u0942\u0930\u0940 \u0930\u093e\u0907\u091f\u093f\u0902\u0917 \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u092c\u0926\u0932 \u0926\u0940\u0964 \u0935\u094b \u092c\u094b\u0932\u093e, '\u092f\u093e\u0930, \u092f\u0947 \u0924\u094b \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u092d\u0940 \u0928\u0939\u0940\u0902 \u0925\u093e \u0915\u093f \u0910\u092a \u092e\u0947\u0902 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u0939\u0948\u0964' \u0909\u0938\u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0909\u0938\u0928\u0947 \u092a\u0939\u0932\u0947 8 \u0918\u0902\u091f\u0947 \u092e\u0947\u0902 \u090f\u0915 \u092a\u0947\u092a\u0930 \u0932\u093f\u0916\u093e \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u0907\u0938 \u092b\u0940\u091a\u0930 \u0915\u0940 \u092e\u0926\u0926 \u0938\u0947 \u0905\u092c \u0935\u094b \u0938\u093f\u0930\u094d\u092b 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u092a\u0942\u0930\u093e \u0906\u0909\u091f\u0932\u093e\u0907\u0928 \u0938\u0947 \u092a\u0947\u092a\u0930 \u092c\u0928\u093e \u0932\u0947\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0938\u094b\u091a\u094b, \u0924\u0941\u092e\u0928\u0947 \u0915\u093f\u0924\u0928\u0947 \u092b\u0940\u091a\u0930\u094d\u0938 \u0915\u094b \u0907\u0917\u094d\u0928\u094b\u0930 \u0915\u093f\u092f\u093e \u0939\u0948? \u091c\u092c \u0939\u092e\u0928\u0947 \u0909\u0938\u0938\u0947 \u092a\u0942\u091b\u093e \u0915\u093f \u0935\u094b \u0915\u094c\u0928 \u0938\u093e \u092b\u0940\u091a\u0930 \u0925\u093e, \u0924\u094b \u0909\u0938\u0928\u0947 \u0915\u0939\u093e \u0915\u093f 'Outline to Full Paper' \u092b\u0940\u091a\u0930\u0964 \u0939\u093e\u0901, \u0935\u0939\u0940 \u091c\u094b \u0924\u0941\u092e\u0928\u0947 \u0936\u093e\u092f\u0926 \u0913\u092a\u0928 \u092d\u0940 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e\u0964 \u0909\u0938\u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0907\u0938\u0938\u0947 \u0909\u0938\u0928\u0947 \u0905\u092a\u0928\u093e \u092a\u0942\u0930\u093e \u092a\u0947\u092a\u0930 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0938\u094d\u091f\u094d\u0930\u0947\u0938 \u0915\u0947 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930 \u0932\u093f\u092f\u093e, \u0914\u0930 \u0909\u0938\u0947 AI \u0921\u093f\u091f\u0947\u0915\u094d\u0936\u0928 \u0915\u093e \u0921\u0930 \u092d\u0940 \u0928\u0939\u0940\u0902 \u0930\u0939\u093e \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0910\u092a \u0915\u093e \u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u092b\u0940\u091a\u0930 \u0909\u0938\u0947 \u0915\u0935\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "\u0924\u094b \u092f\u0947 \u0939\u0948 \u0935\u094b \u092b\u0940\u091a\u0930 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0910\u092a \u092e\u0947\u0902 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0924\u0941\u092e\u0928\u0947 \u0936\u093e\u092f\u0926 \u0907\u0938\u0947 \u091f\u094d\u0930\u093e\u0908 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e\u0964 'Outline to Full Paper' \u2014 \u092c\u0938 \u0905\u092a\u0928\u093e \u0906\u0909\u091f\u0932\u093e\u0907\u0928 \u0921\u093e\u0932\u094b, \u0914\u0930 \u0926\u0947\u0916\u094b \u0915\u0948\u0938\u0947 \u0910\u092a \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u092a\u0942\u0930\u093e \u092a\u0947\u092a\u0930 \u0932\u093f\u0916\u0924\u093e \u0939\u0948, \u0938\u093e\u0907\u091f\u0947\u0936\u0928 \u0914\u0930 \u091f\u0947\u092c\u0932\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925\u0964 \u092f\u0947 \u0935\u0939\u0940 \u0939\u0948 \u091c\u094b \u090f\u0915 \u092f\u0942\u091c\u0930 \u0915\u094b \u092c\u0940+ \u0938\u0947 A- \u0924\u0915 \u0932\u0947 \u0917\u092f\u093e\u0964",
    "\u0924\u094b \u0905\u092c \u0915\u0930\u094b \u092f\u0947: \u0910\u092a \u0916\u094b\u0932\u094b, 'Outline to Full Paper' \u092b\u0940\u091a\u0930 \u092a\u0930 \u091c\u093e\u0913, \u0914\u0930 \u0905\u092a\u0928\u0947 \u0915\u093f\u0938\u0940 \u092a\u0941\u0930\u093e\u0928\u0947 \u0906\u0909\u091f\u0932\u093e\u0907\u0928 \u0915\u094b \u0921\u093e\u0932\u0915\u0930 \u0926\u0947\u0916\u094b \u0915\u093f \u0915\u093f\u0924\u0928\u0940 \u091c\u0932\u094d\u0926\u0940 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u090f\u0915 \u0924\u0948\u092f\u093e\u0930 \u092a\u0947\u092a\u0930 \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964 \u092e\u0948\u0902 \u0917\u093e\u0930\u0902\u091f\u0940 \u0926\u0947\u0924\u093e \u0939\u0942\u0901, \u0924\u0941\u092e \u092a\u0940\u091b\u0947 \u092e\u0941\u0921\u093c\u0915\u0930 \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u094b\u0917\u0947\u0964 \n\nP.S. \u2014 \u0905\u0917\u0930 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u092f\u0947 \u092b\u0940\u091a\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902 \u0939\u0948, \u0924\u094b \u090f\u0915 \u092c\u093e\u0930 \u0938\u094b\u091a\u094b: \u0924\u0941\u092e \u0939\u0930 \u092c\u093e\u0930 8 \u0918\u0902\u091f\u0947 \u092c\u0930\u094d\u092c\u093e\u0926 \u0915\u0930\u0928\u0947 \u0915\u094b \u0924\u0948\u092f\u093e\u0930 \u0939\u094b, \u091c\u092c\u0915\u093f \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u0938\u0947 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0915\u093e\u092e \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948?"
  ],
