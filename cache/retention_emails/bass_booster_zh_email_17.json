  "preview_text": "\u4f60\u8bd5\u8fc7\u75283\u5206\u949f\u8c03\u597dEQ\u5417\uff1f\u8fd9\u4e2a\u4e60\u60ef\u8ba9\u97f3\u4e50\u77ac\u95f4\u70b8\u88c2\uff0c\u8fde\u8033\u673a\u90fd\u50cf\u6362\u4e86\u65b0\u7684\u3002\u770b\u770b\u8fd9\u4e2a\u7b80\u5355\u7684\u6d41\u7a0b\u3002",
  "body_paragraphs": [
    "\u51cc\u66683\u70b9\uff0c\u6211\u8fd8\u5728\u8c03EQ\u3002\u4e0d\u662f\u4e3a\u4e86\u5b8c\u7f8e\uff0c\u53ea\u662f\u60f3\u8ba9\u4e00\u4e2a\u8001\u6b4c\u7684\u9f13\u70b9\u771f\u6b63\u6253\u8fc7\u6765\u3002\u7136\u540e\u6211\u53d1\u73b0\u4e86\u4e00\u4e2a\u7b80\u5355\u76843\u5206\u949f\u6d41\u7a0b\uff0c\u8ba9\u8fd9\u9996\u6b4c\u4ece\u2018\u80fd\u542c\u2019\u53d8\u6210\u4e86\u2018\u9707\u80f8\u53e3\u2019\u3002\u8fd9\u4e2a\u6d41\u7a0b\uff0c\u540e\u6765\u6210\u4e86\u6211\u6bcf\u5929\u7684\u56fa\u5b9a\u52a8\u4f5c\u3002",
    "\u4f60\u731c\u600e\u4e48\u7740\uff1f\u5927\u591a\u6570\u4eba\u7528Bass Booster\u53ea\u662f\u968f\u4fbf\u62d6\u4e00\u4e0bBoost\u6ed1\u5757\uff0c\u89c9\u5f97\u97f3\u91cf\u5927\u4e86\u5c31\u505c\u4e86\u3002\u4f46\u4f60\u9519\u8fc7\u4e86\u6700\u5173\u952e\u768410%\u2014\u2014\u90a310%\u8ba9\u4f4e\u97f3\u4ece\u2018\u6709\u2019\u53d8\u6210\u2018\u51b2\u2019\u3002\u771f\u76f8\u662f\uff0c\u4f60\u7684\u8033\u673a\u548c\u624b\u673a\u5587\u53ed\u6709\u80fd\u529b\u91ca\u653e\u66f4\u6df1\u7684\u4f4e\u9891\uff0c\u53ea\u662f\u9700\u8981\u4e00\u4e2a\u6b65\u9aa4\u987a\u5e8f\uff1a\u5148\u5f00Bass\u865a\u62dfizer\uff0c\u518d\u8c0310\u6bb5EQ\u768460Hz\u548c125Hz\u5404\u63a8\u9ad83dB\uff0c\u6700\u540e\u7528Boost\u6ed1\u5757\u62c9\u523080%\u3002\u5168\u7a0b\u4e0d\u52303\u5206\u949f\u3002",
