{
  "subject": "\u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0917\u0932\u0924\u0940 \u0915\u0940: \u092f\u0939 \u092b\u0940\u091a\u0930 20 \u092e\u093f\u0928\u091f \u092c\u0930\u094d\u092c\u093e\u0926 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e",
  "preview_text": "\u090f\u0915 \u0938\u091a\u094d\u091a\u093e\u0908 \u091c\u094b \u0906\u092a\u0915\u094b \u092a\u0924\u093e \u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964 \u0906\u092a\u0915\u093e 18 \u092e\u093f\u0928\u091f \u0939\u0930 \u0926\u093f\u0928 \u092c\u091a \u0938\u0915\u0924\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u092e\u0941\u091d\u0947 \u090f\u0939\u0938\u093e\u0938 \u0939\u0941\u0906 \u0915\u093f \u092e\u0948\u0902 \u092a\u093f\u091b\u0932\u0947 \u090f\u0915 \u092e\u0939\u0940\u0928\u0947 \u0938\u0947 \u0939\u0930 \u0926\u093f\u0928 20 \u092e\u093f\u0928\u091f \u092c\u0930\u094d\u092c\u093e\u0926 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964 \u0939\u0930 \u0938\u0941\u092c\u0939, \u0915\u093e\u092e \u092a\u0930 \u091c\u093e\u0924\u0947 \u0939\u0941\u090f, \u092e\u0948\u0902 \u0905\u092a\u0928\u0940 \u092a\u094d\u0932\u0947\u0932\u093f\u0938\u094d\u091f \u092e\u0947\u0902 \u0917\u093e\u0928\u0947 \u0922\u0942\u0902\u0922\u0924\u093e, \u092b\u093f\u0930 \u092c\u0948\u0938 \u092c\u0922\u093c\u093e\u0924\u093e, \u092b\u093f\u0930 \u091f\u094d\u0930\u0947\u092c\u0932 \u0920\u0940\u0915 \u0915\u0930\u0924\u093e... \u092f\u0939 \u0938\u092c \u0939\u0930 \u0917\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0938\u0947\u0964 \u092e\u0947\u0930\u0947 20 \u092e\u093f\u0928\u091f \u0938\u093f\u0930\u094d\u092b \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u0939\u0940 \u0928\u093f\u0915\u0932 \u091c\u093e\u0924\u0947 \u0925\u0947\u0964 \u0914\u0930 \u092e\u0948\u0902 \u0938\u094b\u091a\u0924\u093e \u0925\u093e \u0915\u093f \u092f\u0939\u0940 \u0924\u0930\u0940\u0915\u093e \u0939\u0948\u0964 \u092e\u0948\u0902 \u0917\u0932\u0924 \u0925\u093e\u0964",
    "\u092b\u093f\u0930 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0939\u095e\u094d\u0924\u0947 \u092a\u0939\u0932\u0947 \u090f\u0915 \u091a\u0940\u095b \u091f\u094d\u0930\u093e\u0908 \u0915\u0940\u0964 \u092e\u0948\u0902\u0928\u0947 Volume Booster \u092e\u0947\u0902 'Rock' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0938\u0947\u0935 \u0915\u0930 \u0926\u093f\u092f\u093e - \u091c\u0948\u0938\u093e \u092e\u0941\u091d\u0947 \u092a\u0938\u0902\u0926 \u0939\u0948, \u092c\u0948\u0938 \u0925\u094b\u0921\u093c\u093e \u091c\u094d\u092f\u093e\u0926\u093e, \u091f\u094d\u0930\u0947\u092c\u0932 \u0915\u094d\u0930\u093f\u0938\u094d\u092a\u0964 \u0905\u092c \u092e\u0948\u0902 \u092c\u0938 \u0910\u092a \u0916\u094b\u0932\u0924\u093e \u0939\u0942\u0902, \u090f\u0915 \u091f\u0948\u092a \u0915\u0930\u0924\u093e \u0939\u0942\u0902, \u0914\u0930 \u092e\u0947\u0930\u0940 \u092a\u0942\u0930\u0940 \u092a\u094d\u0932\u0947\u0932\u093f\u0938\u094d\u091f \u0935\u0948\u0938\u0940 \u0939\u0940 \u092c\u091c\u0924\u0940 \u0939\u0948 \u091c\u0948\u0938\u0940 \u092e\u0948\u0902 \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0902\u0964 \u0915\u094b\u0908 \u091d\u0902\u091d\u091f \u0928\u0939\u0940\u0902\u0964 \u091c\u094b \u0915\u093e\u092e 20 \u092e\u093f\u0928\u091f \u0915\u093e \u0925\u093e, \u0935\u094b \u0905\u092c 2 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0939\u0930 \u0926\u093f\u0928 18 \u092e\u093f\u0928\u091f \u092c\u091a \u0917\u090f\u0964 \u0938\u094b\u091a\u094b, \u090f\u0915 \u092e\u0939\u0940\u0928\u0947 \u092e\u0947\u0902 \u092f\u0947 9 \u0918\u0902\u091f\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u092e\u094d\u092f\u0942\u091c\u093f\u0915 \u0938\u0941\u0928\u0928\u0947 \u0915\u0947 \u0939\u0948\u0902\u0964",
    "\u092f\u0939\u0940 \u0935\u094b \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0939\u0948 \u091c\u094b 90% \u092f\u0942\u091c\u0930\u094d\u0938 \u092e\u093f\u0938 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u093f\u0932\u094d\u091f-\u0907\u0928 \u0907\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u0915\u0947 \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938 (Pop, Rock, Jazz, Electronic, Classical) \u0938\u093f\u0930\u094d\u092b \u0938\u091c\u093e\u0935\u091f \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964 \u0935\u094b \u0906\u092a\u0915\u0947 \u0938\u092e\u092f \u092c\u091a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0902\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0938\u0947\u091f \u0915\u0930\u094b, \u0914\u0930 \u092b\u093f\u0930 \u0939\u092e\u0947\u0936\u093e \u0915\u0947 \u0932\u093f\u090f \u092d\u0942\u0932 \u091c\u093e\u0913\u0964 \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u0939\u0930 \u092c\u093e\u0930 \u0935\u0948\u0938\u093e \u0939\u0940 \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0917\u093e, \u092c\u093f\u0928\u093e \u0906\u092a\u0915\u094b \u0939\u0930 \u092c\u093e\u0930 \u092e\u0947\u0939\u0928\u0924 \u0915\u0930\u0928\u0940 \u092a\u0921\u093c\u0947\u0964",
    "\u0906\u091c \u0939\u0940 Volume Booster \u0916\u094b\u0932\u094b\u0964 'Equalizer' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u094b\u0964 \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091c\u0947\u0928\u0930 \u0915\u093e \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091a\u0941\u0928\u094b, \u0925\u094b\u0921\u093c\u093e \u091f\u094d\u0935\u0940\u0915 \u0915\u0930\u094b \u0905\u0917\u0930 \u091a\u093e\u0939\u094b, \u0914\u0930 'Save' \u0926\u092c\u093e \u0926\u094b\u0964 \u0915\u0932 \u0938\u0941\u092c\u0939 \u091c\u092c \u092e\u094d\u092f\u0942\u091c\u093f\u0915 \u091a\u0932\u093e\u0913\u0917\u0947, \u0924\u094b \u092a\u0939\u0932\u0947 \u0917\u093e\u0928\u0947 \u0938\u0947 \u0939\u0940 \u0935\u0939\u0940 \u092a\u0930\u092b\u0947\u0915\u094d\u091f \u0938\u093e\u0909\u0902\u0921 \u092e\u093f\u0932\u0947\u0917\u093e\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0915\u093e \u0915\u093e\u092e, \u0939\u092e\u0947\u0936\u093e \u0915\u093e \u0906\u0930\u093e\u092e\u0964 P.S. Premium \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0924\u094b \u092f\u0947 \u0914\u0930 \u092d\u0940 \u0906\u0938\u093e\u0928 \u0939\u0948 - \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u0915\u0938\u094d\u091f\u092e \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938 \u0938\u0947\u0935 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964 \u0939\u0930 \u092e\u0942\u0921 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0938\u0947\u091f\u093f\u0902\u0917, \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u092e\u0947\u0902\u0964"
  ],
