  "subject": "2 \u092e\u093f\u0928\u091f \u0915\u093e \u0939\u0948\u0915 \u091c\u094b 20 \u092e\u093f\u0928\u091f \u092c\u091a\u093e\u090f\u0917\u093e",
  "preview_text": "\u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f\u0930 \u0915\u093e \u090f\u0915 \u0910\u0938\u093e \u092b\u0940\u091a\u0930 \u091c\u093f\u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0915\u0947 \u0906\u092a \u0930\u094b\u091c \u0915\u093e \u0938\u092e\u092f \u092c\u091a\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947\u0964",
  "body_paragraphs": [
    "\u0915\u094d\u092f\u093e \u0906\u092a\u0928\u0947 \u0915\u092d\u0940 \u0938\u094b\u091a\u093e \u0939\u0948 \u0915\u093f \u0906\u092a \u0930\u094b\u091c\u093e\u0928\u093e \u0915\u093f\u0924\u0928\u093e \u0938\u092e\u092f \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u092e\u0947\u0902 \u0916\u0930\u094d\u091a \u0915\u0930\u0924\u0947 \u0939\u0948\u0902? \u092e\u0948\u0902\u0928\u0947 \u0916\u0941\u0926 \u090f\u0915 \u0926\u093f\u0928 \u0917\u093f\u0928\u093e\u2014\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0916\u094b\u0932\u0928\u093e, \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b \u090a\u092a\u0930-\u0928\u0940\u091a\u0947 \u0915\u0930\u0928\u093e, \u092b\u093f\u0930 \u0938\u0947 \u091a\u0947\u0915 \u0915\u0930\u0928\u093e\u0964 \u0939\u0930 \u092c\u093e\u0930 \u0915\u092e \u0938\u0947 \u0915\u092e 2 \u092e\u093f\u0928\u091f\u0964 \u0905\u0917\u0930 \u0906\u092a \u0926\u093f\u0928 \u092e\u0947\u0902 10 \u092c\u093e\u0930 \u0910\u0938\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0939\u092b\u094d\u0924\u0947 \u092e\u0947\u0902 20 \u092e\u093f\u0928\u091f\u0964 \u092e\u0939\u0940\u0928\u0947 \u092e\u0947\u0902 80 \u092e\u093f\u0928\u091f\u0964 \u0938\u093f\u0930\u094d\u092b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0915\u0947 \u0932\u093f\u090f\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u091a\u0940\u091c \u0938\u0940\u0916\u0940 \u091c\u093f\u0938\u0928\u0947 \u092e\u0947\u0930\u093e \u092a\u0942\u0930\u093e \u0917\u0947\u092e \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964 Volume Booster - Sound Booster \u0915\u093e '\u0935\u0928-\u091f\u0948\u092a \u092c\u0942\u0938\u094d\u091f' \u092b\u0940\u091a\u0930\u0964 \u0907\u0938\u0947 \u0913\u092a\u0928 \u0915\u0930\u094b, \u090f\u0915 \u092c\u093e\u0930 \u091f\u0948\u092a \u0915\u0930\u094b, \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0938\u093f\u0938\u094d\u091f\u092e \u092e\u0948\u0915\u094d\u0938\u093f\u092e\u092e \u0938\u0947 200% \u0924\u0915 \u092c\u0922\u093c \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0907\u0902\u0924\u091c\u093e\u0930 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 2 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0915\u093e\u092e \u0916\u0924\u094d\u092e\u0964",
    "\u0905\u092c \u0938\u094b\u091a\u094b\u2014\u0905\u0917\u0930 \u0924\u0941\u092e \u0939\u0930 \u092c\u093e\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f 2 \u092e\u093f\u0928\u091f \u0915\u0940 \u092c\u091c\u093e\u092f \u0938\u093f\u0930\u094d\u092b 2 \u0938\u0947\u0915\u0902\u0921 \u0932\u0917\u093e\u0913\u0917\u0947, \u0924\u094b \u0924\u0941\u092e \u0939\u092b\u094d\u0924\u0947 \u092e\u0947\u0902 20 \u092e\u093f\u0928\u091f \u092c\u091a\u093e \u0938\u0915\u0924\u0947 \u0939\u094b\u0964 \u0935\u094b 20 \u092e\u093f\u0928\u091f \u0924\u0941\u092e \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u093e \u090f\u0915 \u090f\u092a\u093f\u0938\u094b\u0921 \u0938\u0941\u0928 \u0938\u0915\u0924\u0947 \u0939\u094b, \u092f\u093e \u0905\u092a\u0928\u0940 \u092a\u094d\u0932\u0947\u0932\u093f\u0938\u094d\u091f \u092e\u0947\u0902 \u090f\u0915 \u0914\u0930 \u0917\u093e\u0928\u093e \u090f\u0921\u091c\u0938\u094d\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964 \u092f\u0939 \u091b\u094b\u091f\u093e \u0938\u093e \u092c\u0926\u0932\u093e\u0935 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0930\u094b\u091c \u0915\u0940 \u0906\u0926\u0924 \u0915\u094b \u092c\u0926\u0932 \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
    "\u0924\u094b \u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u0935\u0928-\u091f\u0948\u092a \u092c\u0942\u0938\u094d\u091f' \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u094b\u0964 \u0926\u0947\u0916\u094b \u0915\u093f\u0924\u0928\u093e \u0906\u0938\u093e\u0928 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0932\u0947\u0935\u0932 \u0939\u0948\u0902\u2014\u0905\u0917\u0930 \u0924\u0941\u092e \u0905\u092d\u0940 \u092d\u0940 \u092b\u094d\u0930\u0940 \u092e\u0947\u0902 \u0939\u094b, \u0924\u094b \u090f\u0915 \u092c\u093e\u0930 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u091c\u0930\u0942\u0930 \u0932\u0947\u0928\u093e\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092b\u094b\u0928 \u090f\u0915 \u0928\u092f\u093e \u0921\u093f\u0935\u093e\u0907\u0938 \u091c\u0948\u0938\u093e \u0932\u0917\u0947\u0917\u093e\u0964"
