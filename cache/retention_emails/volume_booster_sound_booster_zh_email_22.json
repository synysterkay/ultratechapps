{
  "subject": "\u6211\u72af\u4e86\u4e2a\u5927\u9519\uff1a90%\u7528\u6237\u4e0d\u77e5\u9053\u7684\u9690\u85cf\u624b\u52bf",
  "preview_text": "\u7528\u4e86\u8fd9\u4e48\u4e45\uff0c\u624d\u53d1\u73b0\u8fd9\u4e2a\u624b\u52bf\u80fd\u77ac\u95f4\u8c03\u51fa\u4e13\u4e1a\u6a21\u5f0f\uff0c\u97f3\u91cf\u63d0\u5347\u5feb\u4e00\u500d\u3002",
  "body_paragraphs": [
    "\u8bf4\u5b9e\u8bdd\uff0c\u6211\u6709\u70b9\u4e0d\u597d\u610f\u601d\u5199\u8fd9\u5c01\u90ae\u4ef6\u3002\u56e0\u4e3a\u6211\u81ea\u5df1\u7528\u4e86\u5927\u534a\u5e74\uff0c\u4e0a\u5468\u624d\u53d1\u73b0\u8fd9\u4e2a\u624b\u52bf\u3002\u5f53\u65f6\u6211\u5728\u5065\u8eab\u623f\uff0c\u6234\u7740\u8033\u673a\uff0c\u624b\u6e7f\u6f09\u6f09\u7684\uff0c\u6839\u672c\u6ca1\u6cd5\u5728\u5c4f\u5e55\u4e0a\u7cbe\u51c6\u6ed1\u52a8\u8c03\u5747\u8861\u5668\u3002",
    "\u5c31\u5728\u6211\u5feb\u653e\u5f03\u7684\u65f6\u5019\uff0c\u624b\u6307\u65e0\u610f\u95f4\u5728\u97f3\u91cf\u6761\u4e0a\u5feb\u901f\u53cc\u51fb\u5e76\u957f\u6309\u2014\u2014\u6574\u4e2a\u754c\u9762\u7a81\u7136\u53d8\u4e86\u3002\u4e0d\u662f\u666e\u901a\u7684\u5747\u8861\u5668\uff0c\u800c\u662f\u4e00\u4e2a\u5b8c\u5168\u9690\u85cf\u7684\u4e13\u4e1a\u63a7\u5236\u9762\u677f\uff0c\u6240\u6709\u9ad8\u7ea7\u53c2\u6570\u76f4\u63a5\u89e6\u624b\u53ef\u53ca\u3002\u6211\u95ee\u4e86\u56e2\u961f\uff0c\u4ed6\u4eec\u8bf4\u8fd9\u662f\u4e13\u95e8\u7559\u7ed9\u6df1\u5ea6\u7528\u6237\u7684\u2018\u540e\u95e8\u2019\uff0c\u4ece\u6ca1\u516c\u5f00\u5ba3\u4f20\u8fc7\u3002",
    "\u8fd9\u4e2a\u9690\u85cf\u624b\u52bf\u80fd\u7ed5\u8fc7\u5e38\u89c4\u83dc\u5355\uff0c\u4e00\u79d2\u76f4\u8fbe\u2018\u9ad8\u7ea7\u5747\u8861\u5668\u2019\u7684\u6838\u5fc3\u3002\u4f60\u53ef\u4ee5\u5728\u4efb\u4f55\u754c\u9762\uff0c\u53ea\u8981\u5728\u5e94\u7528\u5185\u7684\u97f3\u91cf\u6ed1\u5757\u4e0a\u5feb\u901f\u53cc\u51fb\u5e76\u957f\u6309\uff0c\u5c31\u80fd\u53ec\u5524\u5b83\u3002\u8fd9\u610f\u5473\u7740\uff0c\u5f53\u4f60\u5728Spotify\u5207\u6b4c\u3001\u6216YouTube\u89c6\u9891\u7a81\u7136\u5c0f\u58f0\u65f6\uff0c\u8c03\u6574\u4f4e\u97f3\u548c\u4eba\u58f0\u589e\u5f3a\u7684\u901f\u5ea6\uff0c\u6bd4\u627e\u8bbe\u7f6e\u5feb\u81f3\u5c1110\u79d2\u3002",
    "\u73b0\u5728\u5c31\u53bb\u8bd5\u8bd5\u8fd9\u4e2a\u624b\u52bf\u3002\u5728\u5e94\u7528\u91cc\uff0c\u968f\u4fbf\u653e\u9996\u6b4c\uff0c\u627e\u5230\u97f3\u91cf\u6761\uff0c\u5feb\u901f\u53cc\u51fb\u7136\u540e\u522b\u677e\u624b\u3002\u4f60\u4f1a\u770b\u5230\u9b54\u6cd5\u53d1\u751f\u3002P.S. \u8fd9\u4e2a\u9762\u677f\u91cc\u7684\u2018\u52a8\u6001\u8303\u56f4\u538b\u7f29\u2019\u5f00\u5173\uff0c\u662f\u8ba9\u64ad\u5ba2\u4eba\u58f0\u5728\u5608\u6742\u5730\u94c1\u91cc\u4f9d\u7136\u6e05\u6670\u7684\u7ec8\u6781\u6b66\u5668\uff0c\u4f46\u8bb0\u5f97\u9002\u5ea6\u4f7f\u7528\u3002",
    "P.S. \u8fd9\u4e2a\u9762\u677f\u91cc\u7684\u2018\u52a8\u6001\u8303\u56f4\u538b\u7f29\u2019\u5f00\u5173\uff0c\u662f\u8ba9\u64ad\u5ba2\u4eba\u58f0\u5728\u5608\u6742\u5730\u94c1\u91cc\u4f9d\u7136\u6e05\u6670\u7684\u7ec8\u6781\u6b66\u5668\uff0c\u4f46\u8bb0\u5f97\u9002\u5ea6\u4f7f\u7528\u3002"
  ],
