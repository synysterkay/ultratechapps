{
  "subject": "\u0627\u0644\u0633\u0631 \u0627\u0644\u0630\u064a \u0644\u0645 \u0623\u062e\u0628\u0631 \u0628\u0647 \u0623\u062d\u062f\u0627 \u0639\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642",
  "preview_text": "\u0644\u0645\u0627\u0630\u0627 \u0628\u0646\u064a\u062a \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0641\u064a \u0627\u0644\u0633\u0627\u0639\u0629 2 \u0635\u0628\u0627\u062d\u0627\u061f \u0627\u0644\u0642\u0635\u0629 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629 \u0627\u0644\u062a\u064a \u0633\u062a\u063a\u064a\u0631 \u0637\u0631\u064a\u0642\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0643 \u0644\u0644\u062a\u0637\u0628\u064a\u0642.",
  "body_paragraphs": [
    "\u0641\u064a \u0627\u0644\u0633\u0627\u0639\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0635\u0628\u0627\u062d\u0627\u060c \u0643\u0646\u062a \u062c\u0627\u0644\u0633\u0627 \u0641\u064a \u063a\u0631\u0641\u0629 \u0627\u0644\u0645\u0639\u064a\u0634\u0629 \u0648\u062d\u062f\u064a\u060c \u0632\u0648\u062c\u062a\u064a \u0646\u0627\u0626\u0645\u0629 \u0641\u064a \u0627\u0644\u063a\u0631\u0641\u0629 \u0627\u0644\u0623\u062e\u0631\u0649. \u0643\u0646\u0627 \u0642\u062f \u0645\u0631\u0631\u0646\u0627 \u0628\u0623\u0633\u0628\u0648\u0639 \u0635\u0639\u0628\u060c \u0643\u0644\u0627\u0646\u0627 \u0645\u0634\u063a\u0648\u0644\u060c \u0648\u0644\u0645 \u0646\u062e\u0637\u0637 \u0644\u0623\u064a \u0645\u0648\u0639\u062f \u0645\u0646\u0630 \u0623\u0633\u0627\u0628\u064a\u0639. \u0634\u0639\u0631\u062a \u0628\u0627\u0644\u0630\u0646\u0628 \u0644\u0623\u0646\u0646\u064a \u062a\u0631\u0643\u062a \u0627\u0644\u0631\u0648\u062a\u064a\u0646 \u064a\u0633\u0631\u0642 \u0645\u0646\u0627 \u0627\u0644\u0644\u062d\u0638\u0627\u062a \u0627\u0644\u062c\u0645\u064a\u0644\u0629. \u0641\u064a \u062a\u0644\u0643 \u0627\u0644\u0644\u062d\u0638\u0629\u060c \u0623\u062f\u0631\u0643\u062a \u0623\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0630\u064a \u0646\u0628\u0646\u064a\u0647 \u0644\u0627 \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0645\u062c\u0631\u062f \u0642\u0627\u0626\u0645\u0629 \u0623\u0641\u0643\u0627\u0631\u060c \u0628\u0644 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0634\u064a\u0626\u0627 \u064a\u0630\u0643\u0631\u0643 \u0628\u0623\u0646 \u0627\u0644\u062d\u0628 \u064a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u062c\u0647\u062f.",
    "\u0647\u0643\u0630\u0627 \u0648\u0644\u062f\u062a \u0645\u064a\u0632\u0629 '\u0645\u0641\u0627\u062c\u0623\u0629 \u0627\u0644\u0634\u0631\u064a\u0643'\u060c \u0627\u0644\u062a\u064a \u062a\u0633\u0645\u062d \u0644\u0623\u062d\u062f\u0643\u0645\u0627 \u0628\u062a\u062e\u0637\u064a\u0637 \u0645\u0648\u0639\u062f \u0633\u0631\u0627\u060c \u0628\u064a\u0646\u0645\u0627 \u064a\u062a\u0644\u0642\u0649 \u0627\u0644\u0622\u062e\u0631 \u0625\u0634\u0639\u0627\u0631\u0627 \u0628\u0627\u0644\u0645\u0641\u0627\u062c\u0623\u0629. \u0644\u0645 \u0623\u0643\u0646 \u0623\u0631\u064a\u062f \u0645\u062c\u0631\u062f \u0623\u062f\u0627\u0629\u060c \u0623\u0631\u062f\u062a \u0634\u064a\u0626\u0627 \u064a\u0639\u064a\u062f \u0625\u0644\u064a\u0643\u0645 \u0627\u0644\u0625\u062b\u0627\u0631\u0629 \u0627\u0644\u062a\u064a \u0634\u0639\u0631\u062a\u0645 \u0628\u0647\u0627 \u0641\u064a \u0623\u0648\u0644 \u0645\u0648\u0639\u062f. \u0643\u0644 \u0632\u0648\u062c\u064a\u0646 \u064a\u062d\u062a\u0627\u062c\u0627\u0646 \u0625\u0644\u0649 \u0644\u062d\u0638\u0627\u062a \u0644\u0627 \u062a\u0646\u0633\u0649\u060c \u0648\u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0647\u064a \u0631\u0633\u0627\u0644\u062a\u064a \u0625\u0644\u064a\u0643\u0645: \u0627\u0644\u062d\u0628 \u0644\u064a\u0633 \u0635\u062f\u0641\u0629\u060c \u0628\u0644 \u0627\u062e\u062a\u064a\u0627\u0631.",
    "\u0644\u0630\u0644\u0643\u060c \u0639\u0646\u062f\u0645\u0627 \u062a\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0633\u062a\u0631\u0649 \u062e\u064a\u0627\u0631\u0627 \u062c\u062f\u064a\u062f\u0627 \u062a\u062d\u062a \u0627\u0633\u0645 '\u0645\u0648\u0639\u062f \u0645\u0641\u0627\u062c\u0626'. \u062c\u0631\u0628\u0647 \u0645\u0639 \u0634\u0631\u064a\u0643\u0643\u060c \u0627\u062e\u062a\u0631 \u0641\u0643\u0631\u0629 \u0645\u0646 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0628\u0646\u0627\u0621 \u0639\u0644\u0649 \u0627\u0647\u062a\u0645\u0627\u0645\u0627\u062a\u0643\u0645\u0627\u060c \u0648\u062f\u0639 \u0627\u0644\u0645\u0641\u0627\u062c\u0623\u0629 \u062a\u0635\u0646\u0639 \u0627\u0644\u0641\u0631\u0642. 230+ \u0632\u0648\u062c\u064a\u0646 \u0627\u0633\u062a\u062e\u062f\u0645\u0648\u0647\u0627 \u0628\u0627\u0644\u0641\u0639\u0644\u060c \u064892% \u0642\u0627\u0644\u0648\u0627 \u0625\u0646\u0647\u0627 \u062d\u0633\u0646\u062a \u0639\u0644\u0627\u0642\u062a\u0647\u0645. \u0623\u0646\u0627 \u0645\u062a\u0623\u0643\u062f \u0623\u0646\u0647\u0627 \u0633\u062a\u0639\u0645\u0644 \u0645\u0639\u0643\u0645\u0627 \u0623\u064a\u0636\u0627.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0642\u0627\u0626\u0645\u0629 '\u0645\u0648\u0639\u062f \u0645\u0641\u0627\u062c\u0626'\u060c \u0648\u062e\u0637\u0637 \u0644\u0623\u0648\u0644 \u0645\u0648\u0639\u062f \u0633\u0631\u064a \u0644\u0634\u0631\u064a\u0643\u0643. \u0633\u062a\u0646\u062f\u0647\u0634 \u0645\u0646 \u0631\u062f \u0641\u0639\u0644\u0647. P.S. \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0634\u0639\u0631 \u0628\u0627\u0644\u062a\u0631\u062f\u062f\u060c \u062a\u0630\u0643\u0631 \u0623\u0646 \u0623\u0635\u0639\u0628 \u062e\u0637\u0648\u0629 \u0647\u064a \u0627\u0644\u0623\u0648\u0644\u0649\u060c \u0644\u0643\u0646\u0647\u0627 \u062a\u0633\u062a\u062d\u0642. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u064a\u0648\u0645\u060c \u0648\u0623\u062e\u0628\u0631\u0646\u064a \u0643\u064a\u0641 \u0633\u0627\u0631\u062a \u0627\u0644\u0623\u0645\u0648\u0631."
  ],
