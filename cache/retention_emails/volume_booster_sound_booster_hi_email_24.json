{
  "subject": "\u090f\u0915 \u0917\u0932\u0924\u0940 \u091c\u093f\u0938\u0928\u0947 \u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0915\u094b \u0930\u094b\u0915 \u0926\u093f\u092f\u093e",
  "preview_text": "\u0930\u093e\u091c\u0947\u0936 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u092a\u0922\u093c\u0915\u0930 \u0939\u092e \u0938\u092c \u091a\u094c\u0902\u0915 \u0917\u090f\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b \u092d\u0940 \u092a\u0922\u093c\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964",
  "body_paragraphs": [
    "\u0930\u093e\u091c\u0947\u0936, \u0939\u092e\u093e\u0930\u093e \u090f\u0915 \u092f\u0942\u091c\u0930, \u092a\u093f\u091b\u0932\u0947 55 \u0926\u093f\u0928\u094b\u0902 \u0938\u0947 \u0905\u092a\u0928\u0947 \u092a\u0941\u0930\u093e\u0928\u0947 \u092b\u094b\u0928 \u092a\u0930 \u0938\u0902\u0917\u0940\u0924 \u0938\u0941\u0928 \u0930\u0939\u093e \u0925\u093e\u0964 \u0909\u0938\u0928\u0947 \u0938\u094b\u091a\u093e, '\u092c\u0938 \u092f\u0939\u0940 \u0939\u0948, \u0907\u0938\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0924\u094b \u0906\u0935\u093e\u091c\u093c \u0906 \u0939\u0940 \u0928\u0939\u0940\u0902 \u0938\u0915\u0924\u0940\u0964' \u092b\u093f\u0930 \u0909\u0938\u0928\u0947 \u090f\u0915 \u091a\u0940\u091c\u093c \u0906\u091c\u092e\u093e\u0908 \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964",
    "\u0909\u0938\u0928\u0947 \u0939\u092e\u0947\u0902 \u0932\u093f\u0916\u093e, '\u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u092e\u0947\u0930\u093e \u092b\u094b\u0928 \u092c\u0942\u0922\u093c\u093e \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932 \u092e\u0947\u0902, \u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0939\u0940 \u0938\u0902\u0917\u0940\u0924 \u0915\u093e \u0906\u0927\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092e\u093f\u0938 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964 \u091c\u092c \u092e\u0948\u0902\u0928\u0947 \u092c\u093e\u0938 \u092c\u0942\u0938\u094d\u091f\u0930 \u0914\u0930 \u0930\u0949\u0915 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u090f\u0915 \u0938\u093e\u0925 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e, \u0924\u094b \u0932\u0917\u093e \u091c\u0948\u0938\u0947 \u092e\u0948\u0902 \u0915\u0949\u0928\u094d\u0938\u0930\u094d\u091f \u092e\u0947\u0902 \u0939\u0942\u0901\u0964 \u092e\u0947\u0930\u0947 \u092a\u0941\u0930\u093e\u0928\u0947 \u0917\u093e\u0928\u0947 \u0928\u090f \u0932\u0917\u0928\u0947 \u0932\u0917\u0947\u0964' \u0909\u0938\u0915\u0940 \u092f\u0939 \u0932\u093e\u0907\u0928 \u092a\u0922\u093c\u0915\u0930 \u0939\u092e\u093e\u0930\u0940 \u092a\u0942\u0930\u0940 \u091f\u0940\u092e \u0928\u0947 \u0915\u093e\u092e \u0930\u094b\u0915 \u0926\u093f\u092f\u093e\u0964 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092f\u0939\u0940 \u0924\u094b \u0935\u0939 \u092d\u093e\u0935\u0928\u093e \u0939\u0948 \u091c\u093f\u0938\u0915\u0947 \u0932\u093f\u090f \u0939\u092e\u0928\u0947 \u092f\u0939 \u0910\u092a \u092c\u0928\u093e\u092f\u093e \u0925\u093e\u0964",
    "\u0930\u093e\u091c\u0947\u0936 \u0928\u0947 \u0935\u0939 \u0917\u0941\u092a\u094d\u0924 \u0939\u0925\u093f\u092f\u093e\u0930 \u0916\u094b\u091c \u0932\u093f\u092f\u093e \u091c\u094b \u0939\u091c\u093e\u0930\u094b\u0902 \u092f\u0942\u091c\u0930\u094d\u0938 \u0930\u094b\u091c \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902: \u0908\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u0915\u0947 \u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938 \u0915\u094b \u092c\u093e\u0938 \u092c\u0942\u0938\u094d\u091f\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092e\u093f\u0932\u093e\u0928\u093e\u0964 \u092f\u0939 \u0915\u0949\u092e\u094d\u092c\u094b \u0906\u092a\u0915\u0947 \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u0940 \u0932\u093f\u092e\u093f\u091f \u0938\u0947 200% \u0924\u0915 \u091c\u094b\u0930\u0926\u093e\u0930 \u092c\u0928\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0939\u0930 \u091c\u0947\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u092e\u0948\u091c\u093f\u0915\u0964",
    "\u0905\u092a\u0928\u0947 \u092b\u094b\u0935\u0930\u093f\u091f \u0917\u093e\u0928\u0947 \u092a\u0930 \u0930\u0949\u0915 \u092f\u093e \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0932\u0917\u093e\u090f\u0902, \u0914\u0930 \u092b\u093f\u0930 \u092c\u093e\u0938 \u092c\u0942\u0938\u094d\u091f\u0930 \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902\u0964 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0947\u0902 \u0915\u093f \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u0915\u093f\u0924\u0928\u093e \u0915\u0941\u091b \u091b\u0941\u092a\u093e \u0930\u0939\u093e \u0925\u093e\u0964 \u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0907\u0938 \u0915\u0949\u092e\u094d\u092c\u094b \u0915\u094b \u0906\u091c\u092e\u093e\u090f\u0902\u0964 P.S. \u0930\u093e\u091c\u0947\u0936 \u0905\u092c \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930 \u0939\u0948\u0964 \u0909\u0938\u0915\u093e \u0915\u0939\u0928\u093e \u0939\u0948 \u0915\u093f \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u0908\u0915\u094d\u0935\u0932\u093e\u0907\u091c\u093c\u0930 \u0915\u0902\u091f\u094d\u0930\u094b\u0932\u094d\u0938 \u0928\u0947 \u0909\u0938\u0915\u0947 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u0928\u0947 \u0915\u093e \u0924\u0930\u0940\u0915\u093e \u0939\u0940 \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964"
  ],
