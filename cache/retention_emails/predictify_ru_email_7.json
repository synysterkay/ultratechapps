{
  "subject": "\u0421\u0435\u043a\u0440\u0435\u0442 2AM: \u043a\u0430\u043a \u044f \u043d\u0430\u0448\u0435\u043b 89% \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c",
  "preview_text": "\u041e\u0434\u0438\u043d \u043d\u043e\u0447\u043d\u043e\u0439 \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442 \u0438\u0437\u043c\u0435\u043d\u0438\u043b \u0432\u0441\u0451. \u0423\u0437\u043d\u0430\u0439\u0442\u0435, \u043a\u0430\u043a \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c Predictify \u043d\u0430 10x \u043c\u043e\u0449\u043d\u0435\u0435.",
  "body_paragraphs": [
    "\u0411\u044b\u043b\u043e 2 \u043d\u043e\u0447\u0438. \u042f \u0441\u0438\u0434\u0435\u043b \u0441 \u043a\u043e\u0444\u0435 \u0438 \u0441\u043c\u043e\u0442\u0440\u0435\u043b \u043d\u0430 \u0433\u0440\u0430\u0444\u0438\u043a\u0438 xG, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 AI \u0432\u044b\u0434\u0430\u043b \u0437\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 5 \u043c\u0430\u0442\u0447\u0435\u0439 \u00ab\u0420\u0435\u0430\u043b\u0430\u00bb. \u0418 \u0432\u0434\u0440\u0443\u0433 \u043f\u043e\u043d\u044f\u043b: \u044f \u0432\u0441\u0451 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0441\u043c\u043e\u0442\u0440\u0435\u043b \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u0438\u0442\u043e\u0433\u043e\u0432\u044b\u0435 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u044b, \u0430 \u043d\u0435 \u043d\u0430 \u0434\u0430\u043d\u043d\u044b\u0435. \u0422\u044b \u0442\u043e\u0436\u0435 \u0442\u0430\u043a \u0434\u0435\u043b\u0430\u0435\u0448\u044c?",
    "\u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0432\u0438\u0434\u044f\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0444\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u0447\u0435\u0442\u0430 \u0438 \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u044c AI. \u041d\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0430\u044f \u043c\u0430\u0433\u0438\u044f \u2014 \u0432 \u0433\u043b\u0443\u0431\u0438\u043d\u0435. \u041a\u043e\u0433\u0434\u0430 \u044f \u043d\u0430\u0447\u0430\u043b \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u00ab\u043f\u043e\u0431\u0435\u0434\u0430/\u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u00bb, \u0430 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0435 \u043c\u0435\u0442\u0440\u0438\u043a\u0438: \u043e\u0436\u0438\u0434\u0430\u0435\u043c\u044b\u0435 \u0433\u043e\u043b\u044b (xG), \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u0435 \u0432 \u0448\u0442\u0440\u0430\u0444\u043d\u043e\u0439, \u0441\u0438\u043b\u0430 \u0430\u0442\u0430\u043a\u0438 \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445 15 \u043c\u0438\u043d\u0443\u0442\u0430\u0445 \u2014 \u043c\u043e\u0438 \u0441\u0442\u0430\u0432\u043a\u0438 \u0441\u0442\u0430\u043b\u0438 \u0442\u043e\u0447\u043d\u0435\u0435 \u043d\u0430 40%. \u042d\u0442\u043e \u043d\u0435 \u0442\u0435\u043e\u0440\u0438\u044f, \u044d\u0442\u043e \u0434\u0430\u043d\u043d\u044b\u0435 \u043e\u0442 Predictify.",
    "\u0412 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u0435\u0441\u0442\u044c \u0440\u0430\u0437\u0434\u0435\u043b \u00ab\u0413\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 \u043c\u0430\u0442\u0447\u0430\u00bb. \u0422\u0430\u043c AI \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u043f\u043e\u0447\u0435\u043c\u0443 \u043e\u043d \u0434\u0430\u043b 78% \u043d\u0430 \u043f\u043e\u0431\u0435\u0434\u0443 \u00ab\u0411\u0430\u0440\u0441\u044b\u00bb, \u0430 \u043d\u0435 60%. \u041e\u0442\u043a\u0440\u043e\u0439 \u043b\u044e\u0431\u043e\u0439 \u043f\u0440\u0435\u0434\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u043c\u0430\u0442\u0447 \u2014 \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u00ab\u041c\u0430\u043d \u0421\u0438\u0442\u0438\u00bb \u043f\u0440\u043e\u0442\u0438\u0432 \u00ab\u0410\u0440\u0441\u0435\u043d\u0430\u043b\u0430\u00bb \u2014 \u0438 \u043d\u0430\u0436\u043c\u0438 \u043d\u0430 \u00ab\u0414\u0435\u0442\u0430\u043b\u0438 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0430\u00bb. \u0423\u0432\u0438\u0434\u0438\u0448\u044c \u0440\u0430\u0437\u0431\u0438\u0432\u043a\u0443 \u043f\u043e xG, \u043e\u0431\u043e\u0440\u043e\u043d\u0435, \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0432\u0441\u0442\u0440\u0435\u0447. \u0412\u043e\u0442 \u0433\u0434\u0435 \u0441\u043a\u0440\u044b\u0442\u0430 \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u044c.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Predictify \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044c \u043c\u0430\u0442\u0447, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0442\u0435\u0431\u044f \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442. \u041d\u0430\u0436\u043c\u0438 \u043d\u0430 \u00ab\u0414\u0435\u0442\u0430\u043b\u0438 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0430\u00bb \u2014 \u0443\u0432\u0438\u0434\u0438\u0448\u044c, \u0447\u0442\u043e \u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0437\u0430 \u0446\u0438\u0444\u0440\u0430\u043c\u0438. P.S. \u042d\u0442\u0430 \u0444\u0438\u0447\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e, \u043d\u043e Premium \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043f\u043e\u043b\u043d\u0443\u044e \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043f\u043e 50 \u043b\u0438\u0433\u0430\u043c \u2014 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 3 \u0434\u043d\u044f \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e, \u0435\u0441\u043b\u0438 \u0437\u0430\u0445\u043e\u0447\u0435\u0448\u044c \u0431\u043e\u043b\u044c\u0448\u0435."
  ],
