{
  "subject": "\u0648\u06c1 2AM \u06a9\u0627 \u0644\u0645\u062d\u06c1 \u062c\u0633 \u0646\u06d2 \u0633\u0628 \u0628\u062f\u0644 \u062f\u06cc\u0627",
  "preview_text": "\u0645\u06cc\u06ba \u0646\u06d2 \u0631\u0627\u062a 2 \u0628\u062c\u06d2 \u06cc\u06c1 \u0641\u06cc\u0686\u0631 \u06a9\u06cc\u0648\u06ba \u0628\u0646\u0627\u06cc\u0627\u061f \u0627\u0635\u0644\u06cc \u06a9\u06c1\u0627\u0646\u06cc \u062c\u0627\u0646\u06cc\u06ba \u0627\u0648\u0631 \u0627\u067e\u0646\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0627\u06ba \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4",
  "body_paragraphs": [
    "\u0631\u0627\u062a \u06a9\u06d2 2 \u0628\u062c\u06d2 \u062a\u06be\u06d2\u06d4 \u0645\u06cc\u06ba \u0646\u06d2 \u0622\u062f\u06be\u06cc \u0631\u0627\u062a \u06a9\u0648 \u0628\u06cc\u0679\u06be \u06a9\u0631 \u0627\u06cc\u06a9 \u0641\u06cc\u0686\u0631 \u0628\u0646\u0627\u06cc\u0627 \u062c\u0633 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u06a9\u0633\u06cc \u0646\u06d2 \u0646\u06c1\u06cc\u06ba \u067e\u0648\u0686\u06be\u0627 \u062a\u06be\u0627\u06d4 \u06a9\u06cc\u0648\u06ba\u061f \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u0645\u06cc\u06ba \u062e\u0648\u062f \u0627\u06cc\u06a9 \u0641\u0679 \u0628\u0627\u0644 \u0641\u06cc\u0646 \u06c1\u0648\u06ba \u0627\u0648\u0631 \u062c\u0627\u0646\u062a\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u062c\u0628 \u0622\u067e \u06a9\u06cc \u0679\u06cc\u0645 \u06c1\u0627\u0631 \u0631\u06c1\u06cc \u06c1\u0648 \u062a\u0648 \u0635\u0631\u0641 '\u06af\u0679 \u0641\u06cc\u0644\u0646\u06af' \u06a9\u0627\u0641\u06cc \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u062a\u06cc\u06d4",
    "\u0645\u06cc\u0631\u06d2 \u062f\u0648\u0633\u062a \u06a9\u06c1\u062a\u06d2 \u062a\u06be\u06d2 '\u06af\u0679 \u0641\u06cc\u0644\u0646\u06af \u067e\u0631 \u0628\u06be\u0631\u0648\u0633\u06c1 \u06a9\u0631\u0648'\u060c \u0644\u06cc\u06a9\u0646 \u062c\u0628 10 \u0645\u06cc\u06ba \u0633\u06d2 8 \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0627\u06ba \u063a\u0644\u0637 \u0646\u06a9\u0644\u06cc\u06ba \u062a\u0648 \u067e\u062a\u06c1 \u0686\u0644\u0627 \u06a9\u06c1 \u0688\u06cc\u0679\u0627 \u06c1\u06cc \u0627\u0635\u0644 \u0633\u067e\u0631 \u067e\u0627\u0648\u0631 \u06c1\u06d2\u06d4 \u0627\u0633\u06cc \u0644\u06cc\u06d2 \u0645\u06cc\u06ba \u0646\u06d2 \u0648\u06c1 \u0631\u0627\u062a \u0688\u06cc\u0679\u0627 \u0628\u06cc\u0633 \u0645\u06cc\u06ba \u06af\u06be\u0633\u062a\u06d2 \u06af\u0632\u0627\u0631 \u062f\u06cc \u2014 \u06c1\u0631 \u0645\u06cc\u0686 \u06a9\u06d2 \u06c1\u0632\u0627\u0631\u0648\u06ba \u0645\u062a\u063a\u06cc\u0631\u0627\u062a \u06a9\u0627 \u062a\u062c\u0632\u06cc\u06c1 \u06a9\u0631\u0646\u06d2 \u0648\u0627\u0644\u06cc AI \u0628\u0646\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u06d4",
    "\u06cc\u06c1 \u0641\u06cc\u0686\u0631 \u0622\u067e \u06a9\u0648 \u06c1\u0631 \u0645\u06cc\u0686 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u06a9 \u06a9\u0627\u0646\u0641\u06cc\u0688\u06cc\u0646\u0633 \u0633\u06a9\u0648\u0631 \u062f\u06cc\u062a\u0627 \u06c1\u06d2 \u2014 \u062c\u062a\u0646\u0627 \u0633\u06a9\u0648\u0631 \u0632\u06cc\u0627\u062f\u06c1\u060c \u0627\u062a\u0646\u0627 \u06c1\u06cc \u0627\u0639\u062a\u0645\u0627\u062f \u0633\u06d2 \u0622\u067e \u0628\u06cc\u0679 \u0644\u06af\u0627 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u067e\u0631\u06cc\u0645\u0631 \u0644\u06cc\u06af \u0633\u06d2 \u0644\u06d2 \u06a9\u0631 MLS \u062a\u06a9\u060c 50 \u0633\u06d2 \u0632\u0627\u0626\u062f \u0644\u06cc\u06af\u0632 \u06a9\u0627 \u0688\u06cc\u0679\u0627 \u0622\u067e \u06a9\u06cc \u0627\u0646\u06af\u0644\u06cc\u0648\u06ba \u067e\u0631 \u06c1\u06d2\u06d4",
    "\u0622\u062c \u06c1\u06cc \u0627\u06cc\u067e \u06a9\u06be\u0648\u0644\u06cc\u06ba \u0627\u0648\u0631 \u0627\u067e\u0646\u06cc \u067e\u0633\u0646\u062f\u06cc\u062f\u06c1 \u0679\u06cc\u0645 \u06a9\u06d2 \u0627\u06af\u0644\u06d2 \u0645\u06cc\u0686 \u06a9\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u06a9\u06c1 \u0688\u06cc\u0679\u0627 \u0622\u067e \u06a9\u06cc \u06af\u0679 \u0641\u06cc\u0644\u0646\u06af \u0633\u06d2 \u06a9\u062a\u0646\u0627 \u0645\u062e\u062a\u0644\u0641 \u06c1\u06d2\u06d4 P.S. \u062c\u0648 \u0635\u0627\u0631\u0641 \u067e\u06c1\u0644\u06d2 3 \u062f\u0646\u0648\u06ba \u0645\u06cc\u06ba 5 \u0645\u06cc\u0686\u0648\u06ba \u06a9\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0627\u06ba \u0686\u06cc\u06a9 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0627\u0646 \u06a9\u06cc \u062c\u06cc\u062a \u06a9\u06cc \u0634\u0631\u062d 40% \u0632\u06cc\u0627\u062f\u06c1 \u06c1\u0648\u062a\u06cc \u06c1\u06d2\u06d4"
  ],
