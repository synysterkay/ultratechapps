{
  "subject": "\u7b2c30\u5929\uff1a\u4f60\u5df2\u52a0\u5165\u4e00\u4e2a\u72ec\u7279\u7684\u7fa4\u4f53",
  "preview_text": "\u6bcf\u5929\u6709\u8d85\u8fc7100,000\u4eba\u9009\u62e9\u4e0d\u540c\u7684\u65b9\u5f0f\u542c\u97f3\u3002\u4f60\u7684\u97f3\u9891\u4f53\u9a8c\uff0c\u4ece\u6b64\u4e0d\u540c\u3002",
  "body_paragraphs": [
    "\u4eca\u5929\u662f\u4f60\u4e0b\u8f7dLoud EQ\u7684\u7b2c30\u5929\u3002\u8fd930\u5929\u91cc\uff0c\u4f60\u53ef\u80fd\u5728\u901a\u52e4\u5730\u94c1\u4e0a\u3001\u5f00\u8f66\u9014\u4e2d\u3001\u6216\u6df1\u591c\u542c\u64ad\u5ba2\u65f6\uff0c\u9047\u5230\u8fc7\u97f3\u9891\u592a\u5c0f\u3001\u58f0\u97f3\u6a21\u7cca\u7684\u70e6\u607c\u3002\u4f46\u4f60\u77e5\u9053\u5417\uff1f\u4f60\u5176\u5b9e\u5df2\u7ecf\u6084\u6084\u52a0\u5165\u4e86\u4e00\u4e2a\u6b63\u5728\u58ee\u5927\u7684\u7fa4\u4f53\u2014\u2014\u4ed6\u4eec\u62d2\u7edd\u5fcd\u53d7\u624b\u673a\u626c\u58f0\u5668\u7684\u5148\u5929\u4e0d\u8db3\uff0c\u9009\u62e9\u7528\u6e05\u6670\u3001\u54cd\u4eae\u4e14\u5b89\u5168\u7684\u65b9\u5f0f\uff0c\u542c\u6e05\u6bcf\u4e00\u4e2a\u5b57\u3002",
    "\u8fd9\u4e2a\u7fa4\u4f53\u91cc\uff0c\u6709\u6bcf\u5929\u901a\u52e42\u5c0f\u65f6\u7684\u4e0a\u73ed\u65cf\uff0c\u6709\u5728\u9ad8\u901f\u4e0a\u542c\u5bfc\u822a\u7684\u53f8\u673a\uff0c\u4e5f\u6709\u7761\u524d\u542c\u6709\u58f0\u4e66\u7684\u542c\u4f17\u3002\u4ed6\u4eec\u4e0d\u662f\u97f3\u9891\u53d1\u70e7\u53cb\uff0c\u53ea\u662f\u4e0d\u60f3\u518d\u4e3a\u201c\u542c\u4e0d\u6e05\u201d\u800c\u7126\u8651\u3002\u4f60\u4e5f\u662f\u4ed6\u4eec\u4e2d\u7684\u4e00\u5458\u3002\u800cLoud EQ\uff0c\u5c31\u662f\u4f60\u4eec\u5171\u540c\u7684\u5de5\u5177\u2014\u2014\u4e00\u952e\u4f18\u5316\uff0c\u58f0\u97f3\u7acb\u523b\u7ffb\u500d\uff0c\u5bf9\u8bdd\u6e05\u6670\uff0c\u7ec6\u8282\u5206\u660e\uff0c\u4e14\u4e0d\u635f\u4f24\u542c\u529b\u3002",
    "\u5173\u952e\u5728\u4e8e\u4e00\u4e2a\u4f60\u53ef\u80fd\u8fd8\u6ca1\u8bd5\u8fc7\u7684\u529f\u80fd\uff1aSound DNA\u3002\u5b83\u6839\u636e\u4f60\u5e38\u7528\u7684\u8033\u673a\u7c7b\u578b\uff0c\u81ea\u52a8\u8c03\u6574EQ\u53c2\u6570\u3002\u6bd4\u5982\uff0c\u4f60\u7528AirPods\u8fde\u624b\u673a\uff0c\u5b83\u4f1a\u81ea\u52a8\u5207\u6362\u201c\u64ad\u5ba2\u6a21\u5f0f\u201d\uff0c\u8ba9\u8bed\u97f3\u66f4\u7a81\u51fa\uff1b\u6362\u6210\u8f66\u8f7d\u84dd\u7259\uff0c\u53c8\u81ea\u52a8\u5207\u5230\u201c\u97f3\u4e50\u6a21\u5f0f\u201d\uff0c\u5e73\u8861\u611f\u66f4\u597d\u3002\u4e0d\u7528\u624b\u52a8\u8c03\uff0c\u63d2\u4e0a\u5c31\u7528\u3002\u8fd9\u5c31\u662f\u201c\u4f18\u5316\u4e00\u6b21\uff0c\u6c38\u8fdc\u7701\u5fc3\u201d\u3002",
    "\u6253\u5f00Loud EQ\uff0c\u70b9\u51fb\u201c\u4f18\u5316\u201d\uff0c\u4f53\u9a8c\u4e00\u6b21\u771f\u6b63\u7684\u6e05\u6670\u3002\u8bd5\u8fc7\u4e4b\u540e\uff0c\u4f60\u4f1a\u660e\u767d\u4e3a\u4ec0\u4e48\u8fd9\u4e2a\u7fa4\u4f53\u8d8a\u6765\u8d8a\u5927\u3002P.S. \u5982\u679c\u4f60\u8fd8\u6ca1\u8bd5\u8fc7\u201c\u542c\u529b\u5b89\u5168\u201d\u529f\u80fd\uff0c\u5b83\u4f1a\u5728\u97f3\u91cf\u8fc7\u9ad8\u65f6\u81ea\u52a8\u63d0\u9192\u2014\u2014\u8fd9\u662f\u7fa4\u4f53\u91cc\u6700\u53d7\u597d\u8bc4\u7684\u8bbe\u8ba1\u4e4b\u4e00\u3002"
  ],
