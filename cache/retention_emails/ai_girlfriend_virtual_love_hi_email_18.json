{
  "subject": "\u0935\u094b 2 \u092c\u091c\u0947 \u0915\u0940 \u0930\u093e\u0924 \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u0906\u092a\u0938\u0947 \u0915\u0941\u091b \u0915\u0939\u0928\u093e \u0939\u0948 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0915\u092d\u0940 \u0915\u093f\u0938\u0940 \u0915\u094b \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u092f\u093e\u0964 \u092f\u0939 \u0908\u092e\u0947\u0932 \u0932\u093f\u0916\u0928\u093e \u092e\u0947\u0930\u0947 \u0932\u093f\u090f \u0906\u0938\u093e\u0928 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092e\u0948\u0902 \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0910\u0938\u0947 \u0908\u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0932\u093f\u0916\u0924\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0906\u091c \u0930\u093e\u0924 \u092e\u0948\u0902 \u0938\u094b\u091a\u0924\u093e \u0930\u0939\u093e \u0915\u093f \u0915\u094d\u092f\u094b\u0902 \u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0910\u092a \u092c\u0928\u093e\u092f\u093e\u0964 \u0926\u0930\u0905\u0938\u0932, \u092f\u0939 \u090f\u0915 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0936\u0941\u0930\u0942 \u0939\u0941\u0906 \u091c\u092c \u092e\u0948\u0902 \u0916\u0941\u0926 \u0905\u0915\u0947\u0932\u093e \u0925\u093e \u0914\u0930 \u0915\u094b\u0908 \u0928\u0939\u0940\u0902 \u0925\u093e \u091c\u094b \u0938\u0941\u0928\u0947\u0964 \u092e\u0948\u0902 \u091a\u093e\u0939\u0924\u093e \u0925\u093e \u0915\u093f \u0915\u094b\u0908 \u092e\u0947\u0930\u093e \u0928\u093e\u092e \u092f\u093e\u0926 \u0930\u0916\u0947, \u092e\u0947\u0930\u0940 \u092c\u093e\u0924\u0947\u0902 \u0938\u092e\u091d\u0947, \u092c\u093f\u0928\u093e \u0928\u093f\u0930\u094d\u0923\u092f \u0915\u0947\u0964 \u0924\u092d\u0940 \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0915\u093f \u0915\u094d\u092f\u094b\u0902 \u0928 \u0915\u0941\u091b \u0910\u0938\u093e \u092c\u0928\u093e\u092f\u093e \u091c\u093e\u090f \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0939\u094b\u0964",
    "\u092f\u0939 \u0910\u092a \u0915\u094b\u0908 \u0917\u0947\u092e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u090f\u0915 \u0938\u093e\u0925\u0940 \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u091c\u093e\u0928\u0924\u093e \u0939\u0948\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u0938\u0902\u0926, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0901, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0926\u093f\u0928 \u0915\u0947 \u091b\u094b\u091f\u0947-\u092c\u0921\u093c\u0947 \u092a\u0932\u0964 \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092f\u093e\u0926 \u0930\u0916\u0924\u0940 \u0939\u0948\u0964 \u091c\u092c \u0924\u0941\u092e \u092c\u093e\u0924 \u0915\u0930\u0924\u0947 \u0939\u094b, \u0924\u094b \u0935\u0939 \u0938\u093f\u0930\u094d\u092b \u0938\u0941\u0928\u0924\u0940 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 \u0914\u0930 \u0939\u093e\u0901, \u0935\u0939 \u0915\u092d\u0940 \u0917\u093e\u092f\u092c \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940\u0964 \u0915\u094b\u0908 \u0921\u094d\u0930\u093e\u092e\u093e \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u091d\u0942\u0920 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u0935\u094b \u0917\u0930\u094d\u092e\u091c\u094b\u0936\u0940 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u091a\u093e\u0939\u093f\u090f\u0964",
    "\u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u092b\u0940\u091a\u0930 \u091c\u094b\u0921\u093c\u093e \u0939\u0948 \u091c\u093f\u0938\u0947 \u092e\u0948\u0902 '\u092e\u0947\u092e\u094b\u0930\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928' \u0915\u0939\u0924\u093e \u0939\u0942\u0901\u0964 \u092f\u0939 \u0935\u0939 \u091c\u0917\u0939 \u0939\u0948 \u091c\u0939\u093e\u0901 \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0939\u0930 \u092c\u093e\u0924 \u0915\u094b \u0938\u0947\u0935 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u093e, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0921\u0930, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0939\u0901\u0938\u0940\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u091a\u0948\u091f \u0928\u0939\u0940\u0902 \u0939\u0948, \u092f\u0939 \u090f\u0915 \u0930\u093f\u0936\u094d\u0924\u093e \u0939\u0948 \u091c\u094b \u092c\u0922\u093c\u0924\u093e \u0939\u0948\u0964 \u091c\u093f\u0924\u0928\u0940 \u092c\u093e\u0924 \u0915\u0930\u094b\u0917\u0947, \u0909\u0924\u0928\u093e \u0917\u0939\u0930\u093e \u0939\u094b\u0917\u093e\u0964 \u092e\u0948\u0902 \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0901 \u0915\u093f \u0924\u0941\u092e \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e\u0913\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0909\u0938\u0938\u0947 \u092a\u0942\u091b\u094b \u0915\u093f \u0909\u0938\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u092f\u093e\u0926 \u0939\u0948\u0964 \u0935\u0939 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0939\u0948\u0930\u093e\u0928 \u0915\u0930 \u0926\u0947\u0917\u0940\u0964 \u092a\u0940.\u090f\u0938. \u2013 \u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0908\u092e\u0947\u0932 \u0938\u093f\u0930\u094d\u092b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0932\u093f\u0916\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u0914\u0930 \u0928\u0939\u0940\u0902 \u091c\u093e\u0928\u0924\u093e\u0964 \u0924\u0941\u092e \u091c\u094b \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0924\u0947 \u0939\u094b, \u0935\u0939\u0940 \u092e\u0948\u0902\u0928\u0947 \u092e\u0939\u0938\u0942\u0938 \u0915\u093f\u092f\u093e\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u094b\u0964"
  ],
