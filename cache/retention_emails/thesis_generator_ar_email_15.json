{
  "subject": "\u0627\u0644\u0644\u064a\u0644\u0629 \u0641\u064a 2 \u062f\u0642\u064a\u0642\u0629 \u0641\u0642\u0637",
  "preview_text": "\u0643\u064a\u0641 \u062a\u0646\u062c\u0632 \u0641\u064a \u062f\u0642\u064a\u0642\u062a\u064a\u0646 \u0645\u0627 \u0643\u0627\u0646 \u064a\u0623\u062e\u0630 \u0645\u0646\u0643 20 \u062f\u0642\u064a\u0642\u0629\u061f \u0627\u0644\u062c\u0648\u0627\u0628 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646.",
  "body_paragraphs": [
    "\u0623\u0639\u0631\u0641 \u0623\u0646\u0643 \u0645\u0634\u063a\u0648\u0644 \u0628\u0627\u0644\u062f\u0631\u0627\u0633\u0629 \u0648\u062a\u062d\u062a \u0636\u063a\u0637 \u0627\u0644\u0648\u0642\u062a. \u0643\u0644 \u0637\u0627\u0644\u0628 \u064a\u0639\u0627\u0646\u064a \u0645\u0646 \u0646\u0641\u0633 \u0627\u0644\u0634\u064a\u0621: \u0633\u0627\u0639\u0627\u062a \u0637\u0648\u064a\u0644\u0629 \u0645\u0646 \u0627\u0644\u062a\u062d\u062f\u064a\u0642 \u0641\u064a \u0634\u0627\u0634\u0629 \u0628\u064a\u0636\u0627\u0621\u060c \u062b\u0645 \u0647\u0644\u0639 \u0642\u0628\u0644 \u0627\u0644\u062a\u0633\u0644\u064a\u0645\u060c \u0648\u062e\u0648\u0641 \u0645\u0646 \u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u0633\u064a\u0626\u0629. \u0644\u0643\u0646\u064a \u0633\u0623\u062e\u0628\u0631\u0643 \u0628\u0634\u064a\u0621 \u063a\u064a\u0631 \u062d\u064a\u0627\u062a\u064a.",
    "\u0641\u064a \u0625\u062d\u062f\u0649 \u0627\u0644\u0644\u064a\u0627\u0644\u064a\u060c \u0643\u0627\u0646 \u0639\u0646\u062f\u064a \u0628\u062d\u062b \u064a\u0633\u062a\u063a\u0631\u0642 \u0639\u0627\u062f\u0629 20 \u062f\u0642\u064a\u0642\u0629 \u0644\u0625\u0646\u0634\u0627\u0621 \u062c\u062f\u0648\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u0648\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0646\u062a\u0627\u0626\u062c. \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0630\u0644\u0643\u060c \u0641\u062a\u062d\u062a \u062a\u0637\u0628\u064a\u0642 \u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0623\u0637\u0631\u0648\u062d\u0627\u062a \u0648\u062c\u0631\u0628\u062a \u0645\u064a\u0632\u0629 \u062a\u0648\u0644\u064a\u062f \u0627\u0644\u062c\u062f\u0627\u0648\u0644 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b. \u0641\u064a \u062f\u0642\u064a\u0642\u062a\u064a\u0646 \u0641\u0642\u0637\u060c \u0643\u0627\u0646 \u0627\u0644\u062c\u062f\u0648\u0644 \u062c\u0627\u0647\u0632\u0627\u064b \u0645\u0639 \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0648\u0627\u0644\u0645\u0635\u0627\u062f\u0631\u060c \u0648\u0628\u062f\u062a \u0648\u0643\u0623\u0646\u0647\u0627 \u0623\u062e\u0630\u062a \u0633\u0627\u0639\u0627\u062a. \u0643\u0627\u0646 \u0634\u0639\u0648\u0631\u0627\u064b \u0644\u0627 \u064a\u0648\u0635\u0641: \u062e\u0641\u0651 \u0648\u0632\u0646\u064a \u0648\u0627\u0631\u062a\u0641\u0639\u062a \u062b\u0642\u062a\u064a.",
    "\u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0647\u064a \u0645\u0627 \u0633\u062a\u0633\u062a\u062e\u062f\u0645\u0647\u0627 \u0627\u0644\u064a\u0648\u0645. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0642\u0633\u0645 \"\u062a\u0648\u0644\u064a\u062f \u0627\u0644\u062c\u062f\u0627\u0648\u0644 \u0648\u0627\u0644\u0631\u0633\u0648\u0645 \u0627\u0644\u0628\u064a\u0627\u0646\u064a\u0629\"\u060c \u0648\u0623\u062f\u062e\u0644 \u0628\u064a\u0627\u0646\u0627\u062a\u0643. \u0633\u062a\u062d\u0635\u0644 \u0639\u0644\u0649 \u062c\u062f\u0627\u0648\u0644 \u0648\u0631\u0633\u0648\u0645 \u0628\u064a\u0627\u0646\u064a\u0629 \u062c\u0627\u0647\u0632\u0629 \u0644\u0644\u062a\u0646\u0633\u064a\u0642 \u0645\u0639 \u0627\u0644\u0627\u0633\u062a\u0634\u0647\u0627\u062f\u0627\u062a. \u0644\u0627 \u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u064a\u062f\u0648\u064a \u0623\u0648 \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0627\u0644\u0645\u0635\u0627\u062f\u0631. \u0643\u0644 \u0634\u064a\u0621 \u0641\u064a \u0645\u062a\u0646\u0627\u0648\u0644 \u064a\u062f\u0643.",
    "\u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646: \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u0627\u0633\u062a\u062e\u062f\u0645 \u0645\u064a\u0632\u0629 \u0627\u0644\u062c\u062f\u0627\u0648\u0644 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629. \u0633\u062a\u0648\u0641\u0631 \u0648\u0642\u062a\u0627\u064b \u062b\u0645\u064a\u0646\u0627\u064b \u0648\u062a\u0634\u0639\u0631 \u0628\u0627\u0644\u0625\u0646\u062c\u0627\u0632. P.S. \u0625\u0630\u0627 \u062c\u0631\u0628\u062a \u0647\u0630\u0627 \u0645\u0646 \u0642\u0628\u0644\u060c \u0627\u0646\u0638\u0631 \u0625\u0644\u0649 \u0646\u062a\u0627\u0626\u062c\u0643 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0648\u0633\u062a\u0644\u0627\u062d\u0638 \u0627\u0644\u0641\u0631\u0642. \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u064a\u062a\u0639\u0644\u0645 \u0648\u064a\u0635\u0628\u062d \u0623\u0633\u0631\u0639 \u0645\u0639 \u0643\u0644 \u0627\u0633\u062a\u062e\u062f\u0627\u0645."
  ],
  "cta_text": "\u0627\u0641\u062a\u062d \u062a\u0637\u0628\u064a\u0642 \u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0623\u0637\u0631\u0648\u062d\u0627\u062a \u0627\u0644\u0622\u0646",
