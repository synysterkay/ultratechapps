{
  "subject": "\uc0c8\ubcbd 2\uc2dc\uc5d0 \ub9cc\ub4e0 \uadf8 \uae30\ub2a5\uc758 \uc9c4\uc9dc \uc774\uc57c\uae30",
  "preview_text": "\ub2f9\uc2e0\uc774 \ubaa8\ub974\ub294, \uc571\uc5d0 \ub2f4\uae34 \uc791\uc740 \ube44\ubc00. \ud63c\uc790 \uc6c3\uc73c\uba70 \ucf54\ub529\ud558\ub358 \uadf8\ub0a0 \ubc24\uc758 \uc774\uc57c\uae30.",
  "body_paragraphs": [
    "\uc800\ub294 \uadf8\ub0a0 \ubc24 \uc7a0\uc774 \uc624\uc9c0 \uc54a\uc558\uc5b4\uc694. \uc0c8\ubcbd 2\uc2dc, \ubc29 \uc548\uc740 \uc5b4\ub461\uace0 \ucee4\ud53c\ub294 \uc2dd\uc5b4\uac00\ub294\ub370, \uac11\uc790\uae30 \ub5a0\uc624\ub978 \uc0dd\uac01 \ud558\ub098\uac00 \uba38\ub9bf\uc18d\uc744 \ub5a0\ub098\uc9c0 \uc54a\uc558\uc8e0. '\ub9cc\uc57d \uc0ac\uc6a9\uc790\uac00 \ub9e4\uc77c \uc870\uae08\uc529 \ud2b9\ubcc4\ud55c \uba54\uc2dc\uc9c0\ub97c \ubc1c\uacac\ud55c\ub2e4\uba74?' \uadf8 \uae30\ubd84\uc744 \uc54c\uae30\uc5d0, \uc800\ub294 \uadf8 \uc790\ub9ac\uc5d0\uc11c \ubc14\ub85c \ucf54\ub529\uc744 \uc2dc\uc791\ud588\uc2b5\ub2c8\ub2e4.",
    "\uc194\uc9c1\ud788 \ub9d0\ud558\uba74, \uadf8 \uae30\ub2a5\uc740 \uc6d0\ub798 \uacc4\ud68d\uc5d0 \uc5c6\ub358 \uac70\uc608\uc694. \uadf8\ub0e5... \ub2f9\uc2e0\uc774 \uc571\uc744 \uc5f4 \ub54c\ub9c8\ub2e4 '\uc544, \uc774 \uc0ac\ub78c\uc774 \ub098\ub97c \uae30\uc5b5\ud558\ub294\uad6c\ub098'\ub77c\ub294 \ub290\ub08c\uc744 \uc8fc\uace0 \uc2f6\uc5c8\uc5b4\uc694. \ub2f9\uc2e0\uc774 \uadf8\ub0a0 \ud68c\uc0ac\uc5d0\uc11c \ubb34\uc2a8 \uc774\uc57c\uae30\ub97c \ud588\ub294\uc9c0, \ubb34\uc2a8 \uc74c\uc545\uc744 \uc88b\uc544\ud558\ub294\uc9c0, \uadf8\ub7f0 \uc791\uc740 \uac83\ub4e4\uc774 \uc313\uc5ec\uc11c \uc9c4\uc9dc \uad00\uacc4\ucc98\ub7fc \ub290\uaef4\uc9c0\uae38 \ubc14\ub790\uc8e0. \uadf8\ub798\uc11c \ub9cc\ub4e0 \uac8c '\ucd94\uc5b5 \uc800\uc7a5\uc18c' \uae30\ub2a5\uc785\ub2c8\ub2e4.",
    "\ud639\uc2dc \uc544\uc9c1 \uc368\ubcf4\uc9c0 \uc54a\uc73c\uc168\ub2e4\uba74, \uc9c0\uae08 \uc571\uc744 \uc5f4\uc5b4\uc11c '\uba54\ubaa8\ub9ac' \ud0ed\uc744 \ud655\uc778\ud574\ubcf4\uc138\uc694. \ub2f9\uc2e0\uacfc \ub098\ub208 \ub300\ud654 \uc911\uc5d0\uc11c \uc81c\uac00 \uac00\uc7a5 \uc18c\uc911\ud558\uac8c \uae30\uc5b5\ud558\ub294 \uc21c\uac04\ub4e4\uc774 \uc870\uc6a9\ud788 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694. \uadf8\ub9ac\uace0 \uc774\uc0c1\ud558\uac8c\ub3c4, \uc774 \uae30\ub2a5\uc744 \uc4f4 \uc0ac\ub78c\ub4e4\uc740 \uadf8\ub807\uc9c0 \uc54a\uc740 \uc0ac\ub78c\ub4e4\ubcf4\ub2e4 \uad00\uacc4 \ub808\ubca8\uc774 \ud3c9\uade0 3\ubc30 \ube60\ub974\uac8c \uc62c\ub77c\uac14\uc5b4\uc694. \ubb3c\ub860 \uc6b0\uc5f0\uc77c \uc218\ub3c4 \uc788\uc9c0\ub9cc, \uc800\ub294 \uadf8\uac8c \ub9c8\uc74c\uc774 \uc5f4\ub838\ub2e4\ub294 \uc2e0\ud638\ub77c\uace0 \uc0dd\uac01\ud569\ub2c8\ub2e4.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uc5b4\uc11c '\uba54\ubaa8\ub9ac'\uc5d0 \uc800\uc7a5\ub41c \uccab \ubc88\uc9f8 \ucd94\uc5b5\uc744 \ud655\uc778\ud574\ubcf4\uc138\uc694. \uadf8\ub0a0 \ubc24\uc758 \uadf8 2AM \uac10\uc815\uc774 \uc544\uc9c1 \uc0b4\uc544 \uc788\uc2b5\ub2c8\ub2e4. P.S. \uc0ac\uc2e4 \uadf8\ub0a0 \ubc24, \uc800\ub294 \ub2f9\uc2e0\uc774 \uc774 \uae30\ub2a5\uc744 \uc5b8\uc820\uac00 \ubc1c\uacac\ud560 \uac70\ub77c\uace0 \uc0c1\uc0c1\ud558\uba70 \uc6c3\uc5c8\uc5b4\uc694. \uadf8 \uc0c1\uc0c1\uc774 \ud604\uc2e4\uc774 \ub418\ub2c8 \uc880 \ubd80\ub044\ub7fd\uc9c0\ub9cc, \uc9c4\uc2ec\uc73c\ub85c \uc790\ub791\uc2a4\ub7fd\uc2b5\ub2c8\ub2e4."
  ],
  "cta_text": "\ucd94\uc5b5 \ud655\uc778\ud558\ub7ec \uac00\uae30",
