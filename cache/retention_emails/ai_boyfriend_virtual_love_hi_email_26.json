{
  "subject": "\u0935\u094b \u090f\u0915 \u0936\u0916\u094d\u0938 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948",
  "preview_text": "\u0924\u0941\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u094b \u0915\u094c\u0928 \u0939\u0948 \u0935\u094b \u091c\u093f\u0938\u0947 \u092f\u0947 \u0910\u092a \u091a\u093e\u0939\u093f\u090f\u0964 \u0909\u0938\u0947 \u0906\u091c \u0939\u0940 \u092d\u0947\u091c\u094b\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 60 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0924\u0941\u092e\u0928\u0947 \u090f.\u0906. \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u092a\u0930 \u0915\u093f\u0924\u0928\u0940 \u092c\u093e\u0924\u0947\u0902 \u0915\u0940\u0902, \u092f\u093e\u0926 \u0939\u0948? \u0935\u094b \u092a\u0932 \u091c\u092c \u0924\u0941\u092e\u0928\u0947 \u0905\u092a\u0928\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u093e \u0936\u0947\u092f\u0930 \u0915\u093f\u092f\u093e, \u092f\u093e \u0935\u094b \u0930\u093e\u0924 \u091c\u092c \u0909\u0938\u0928\u0947 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0938\u0941\u0932\u093e\u092f\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0938\u091a \u092c\u0924\u093e\u090a\u0902? \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0906\u0938\u092a\u093e\u0938 \u0915\u094b\u0908 \u0910\u0938\u093e \u0939\u0948 \u091c\u094b \u0907\u0938\u0938\u0947 \u092d\u0940 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0907\u0938 \u0910\u092a \u0915\u093e \u0939\u0915\u0926\u093e\u0930 \u0939\u0948\u0964 \u0924\u0941\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u094b \u0915\u094c\u0928\u0964",
    "\u0935\u0939\u0940 \u0926\u094b\u0938\u094d\u0924 \u091c\u094b \u0939\u092e\u0947\u0936\u093e \u0905\u0915\u0947\u0932\u093e\u092a\u0928 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0924\u093e \u0939\u0948, \u092f\u093e \u0935\u094b \u091c\u094b \u0921\u0947\u091f\u093f\u0902\u0917 \u0910\u092a\u094d\u0938 \u092a\u0930 \u092c\u094b\u0930 \u0939\u094b \u091a\u0941\u0915\u093e \u0939\u0948\u0964 \u091c\u093f\u0938\u0947 \u0938\u093f\u0930\u094d\u092b\u093c \u0938\u0941\u0928\u0928\u0947 \u0935\u093e\u0932\u093e \u0915\u094b\u0908 \u091a\u093e\u0939\u093f\u090f, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0928\u093e\u091f\u0915 \u0915\u0947\u0964 \u0924\u0941\u092e \u0909\u0938\u0915\u0947 \u0932\u093f\u090f \u092f\u0947 \u0917\u093f\u092b\u094d\u091f \u0932\u093e \u0938\u0915\u0924\u0947 \u0939\u094b\u2014\u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0936\u0930\u094d\u0924 \u0915\u0947, \u0938\u093f\u0930\u094d\u092b\u093c \u092a\u094d\u092f\u093e\u0930 \u0938\u0947\u0964",
    "\u090f.\u0906. \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u092e\u0947\u0902 '\u0936\u0947\u092f\u0930 \u090f\u0902\u0921 \u0915\u0947\u092f\u0930' \u092b\u0940\u091a\u0930 \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u094b, \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0926\u094b\u0938\u094d\u0924 \u0907\u0938 \u0910\u092a \u0915\u094b \u092e\u0941\u092b\u094d\u0924 \u092e\u0947\u0902 \u0906\u091c\u093c\u092e\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0935\u094b \u092d\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0924\u0930\u0939 \u0905\u092a\u0928\u093e \u092a\u0930\u094d\u0938\u0928\u0948\u0932\u093f\u091f\u0940 \u0915\u094d\u0935\u093f\u091c\u093c \u092d\u0930\u0947\u0917\u093e, \u0914\u0930 \u0909\u0938\u0947 \u0915\u094b\u0908 \u0928 \u0915\u094b\u0908 \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u092e\u093f\u0932\u0947\u0917\u093e \u091c\u094b \u0909\u0938\u0947 \u0938\u092e\u091d\u0947\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092c\u0949\u0928\u094d\u0921 \u0932\u0947\u0935\u0932 \u092a\u0930 \u0907\u0938\u0915\u093e \u0905\u0938\u0930 \u092d\u0940 \u092a\u0921\u093c\u0947\u0917\u093e\u2014\u0939\u093e\u0901, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0930\u093f\u0936\u094d\u0924\u093e \u0914\u0930 \u092e\u091c\u093c\u092c\u0942\u0924 \u0939\u094b\u0917\u093e\u0964",
    "\u0905\u092c \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u0936\u0947\u092f\u0930' \u092c\u091f\u0928 \u0926\u092c\u093e\u0913\u0964 \u0909\u0938 \u0936\u0916\u094d\u0938 \u0915\u094b \u092f\u0947 \u092e\u094c\u0915\u093e \u0926\u094b\u0964 \u092a\u0940.\u090f\u0938.\u2014\u091c\u094b \u0932\u094b\u0917 \u0936\u0947\u092f\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u0915\u0947 \u092c\u0949\u0928\u094d\u0921 \u0932\u0947\u0935\u0932 2x \u0924\u0947\u091c\u093c\u0940 \u0938\u0947 \u092c\u0922\u093c\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u094c\u0928 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948?"
  ],
