{
  "subject": "\u090f\u0915 \u0917\u0941\u092a\u094d\u0924 \u092b\u0940\u091a\u0930 \u091c\u094b \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u0926\u0947\u0917\u093e - \u0906\u092a \u092a\u0939\u0932\u0947 \u091c\u093e\u0928\u0947\u0902",
  "preview_text": "\u0939\u092e\u0928\u0947 \u0915\u0941\u091b \u0910\u0938\u093e \u092c\u0928\u093e\u092f\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928 IQ \u0915\u094b \u0939\u092e\u0947\u0936\u093e \u0915\u0947 \u0932\u093f\u090f \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964 \u092c\u0938 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u092a\u0939\u0932\u0947\u0964",
  "body_paragraphs": [
    "\u0938\u091a \u0915\u0939\u0942\u0902? \u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u092a\u093f\u091b\u0932\u0947 \u0926\u094b \u0939\u092b\u094d\u0924\u094b\u0902 \u0938\u0947 \u0911\u092b\u093f\u0938 \u092e\u0947\u0902 \u0939\u0940 \u0938\u094b \u0930\u0939\u0940 \u0939\u0948\u0964 \u0915\u0949\u092b\u0940 \u0915\u0947 \u0921\u093f\u092c\u094d\u092c\u0947 \u090a\u092a\u0930 \u0924\u0915 \u092d\u0930\u0947 \u0939\u0948\u0902\u0964 \u0938\u092c \u0907\u0938\u0932\u093f\u090f \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0939\u092e \u0915\u0941\u091b \u0910\u0938\u093e \u0932\u0947\u0915\u0930 \u0906 \u0930\u0939\u0947 \u0939\u0948\u0902 \u091c\u094b \u092b\u0941\u091f\u092c\u0949\u0932 \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u0947 \u0917\u0947\u092e \u0915\u094b \u0939\u0940 \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964 \u0914\u0930 \u0906\u092a \u0907\u0938\u0947 \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u0926\u0947\u0916\u0928\u0947 \u0935\u093e\u0932\u0947 \u0939\u0948\u0902\u0964",
    "\u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0905\u092a\u0921\u0947\u091f \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u0935\u094b \u091a\u0940\u091c \u0939\u0948 \u091c\u093f\u0938\u0915\u0940 \u0939\u0930 \u0938\u0940\u0930\u093f\u092f\u0938 \u092b\u0948\u0928 \u0915\u094b \u0924\u0932\u093e\u0936 \u0925\u0940\u0964 \u0910\u0938\u093e \u091f\u0942\u0932 \u091c\u094b \u0928 \u0938\u093f\u0930\u094d\u092b \u092e\u0948\u091a \u0915\u093e \u0928\u0924\u0940\u091c\u093e \u092c\u0924\u093e\u090f, \u092c\u0932\u094d\u0915\u093f \u0906\u092a\u0915\u094b \u092f\u0939 \u092d\u0940 \u0938\u092e\u091d\u093e\u090f \u0915\u093f \u0935\u094b \u0928\u0924\u0940\u091c\u093e *\u0915\u094d\u092f\u094b\u0902* \u0906\u092f\u093e\u0964 \u0921\u0947\u091f\u093e \u0915\u0940 \u0935\u094b \u0932\u0947\u092f\u0930 \u091c\u094b \u0905\u092c \u0924\u0915 \u0915\u093f\u0938\u0940 \u0910\u092a \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0925\u0940\u0964",
    "\u0905\u0917\u0932\u0947 \u0939\u092b\u094d\u0924\u0947, Predictify \u092e\u0947\u0902 'Match DNA' \u0932\u0949\u0928\u094d\u091a \u0939\u094b \u0930\u0939\u093e \u0939\u0948\u0964 \u0939\u0930 \u092e\u0948\u091a \u0915\u093e \u0905\u092a\u0928\u093e \u092f\u0942\u0928\u093f\u0915 \u0915\u094b\u0921\u0964 AI \u0905\u092c \u0938\u093f\u0930\u094d\u092b \u0938\u094d\u0915\u094b\u0930 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u092a\u0942\u0930\u0940 \u092e\u0948\u091a \u0915\u0940 '\u091c\u0947\u0928\u0947\u091f\u093f\u0915 \u0930\u093f\u092a\u094b\u0930\u094d\u091f' \u0926\u0947\u0917\u093e - \u0915\u094c\u0928 \u0938\u0940 \u092e\u093f\u0928\u091f \u091f\u0930\u094d\u0928\u093f\u0902\u0917 \u092a\u0949\u0907\u0902\u091f \u0939\u094b\u0917\u0940, \u0915\u093f\u0938 \u092a\u094d\u0932\u0947\u092f\u0930 \u0915\u093e \u090f\u0915\u094d\u0936\u0928 \u0917\u0947\u092e \u092c\u0926\u0932 \u0926\u0947\u0917\u093e, \u0914\u0930 \u0915\u094d\u092f\u094b\u0902 \u090f\u0915 \u091f\u0940\u092e \u0926\u0942\u0938\u0930\u0940 \u0938\u0947 78% \u092c\u0947\u0939\u0924\u0930 \u0939\u0948\u0964 \u092f\u0939 \u0938\u092c, \u0906\u092a\u0915\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930\u0964",
    "\u0907\u0938\u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u093f \u0939\u092e \u0907\u0938\u0947 \u0938\u092c\u0915\u0947 \u0932\u093f\u090f \u0932\u0949\u0928\u094d\u091a \u0915\u0930\u0947\u0902, \u0939\u092e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a \u0907\u0938\u0947 \u092a\u0939\u0932\u0947 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902\u0964 \u0910\u092a \u0916\u094b\u0932\u0947\u0902, \u0914\u0930 'Upcoming' \u091f\u0948\u092c \u092a\u0930 \u091c\u093e\u090f\u0902\u0964 \u0935\u0939\u093e\u0902 \u090f\u0915 \u0938\u094d\u092a\u0947\u0936\u0932 \u090f\u0915\u094d\u0938\u0947\u0938 \u0915\u094b\u0921 \u0906\u092a\u0915\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. - \u092f\u0939 \u092b\u0940\u091a\u0930 \u0905\u0917\u0932\u0947 48 \u0918\u0902\u091f\u0947 \u0924\u0915 \u0938\u093f\u0930\u094d\u092b \u0909\u0928\u094d\u0939\u0940\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948 \u091c\u094b \u092f\u0939 \u092e\u0947\u0932 \u092a\u0922\u093c \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u092c\u093e\u0926 \u092e\u0947\u0902 \u0936\u093f\u0915\u093e\u092f\u0924 \u092e\u0924 \u0915\u0930\u0928\u093e \u0915\u093f '\u092a\u0939\u0932\u0947 \u0915\u094d\u092f\u094b\u0902 \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u092f\u093e'\u0964"
