  "preview_text": "\uc571\uc744 68\uc77c \ub3d9\uc548 \uc0ac\uc6a9\ud55c \ub2f9\uc2e0\uc5d0\uac8c\ub9cc \ub4dc\ub9ac\ub294 \ud2b9\ubcc4\ud55c \ud61c\ud0dd\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc9c0\uae08 \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "68\uc77c \ub3d9\uc548 Predictify\uc640 \ud568\uaed8\ud574\uc918\uc11c \uc815\ub9d0 \uace0\ub9c8\uc6cc. \ub2f9\uc2e0 \uac19\uc740 \ud32c\uc774 \uc5c6\uc5c8\ub2e4\uba74 \uc774 \uc571\uc740 \uc9c0\uae08\uc758 10%\ub3c4 \uc548 \ub410\uc744 \uac70\uc57c. \uadf8\ub798\uc11c \uc624\ub298\uc740 \ud2b9\ubcc4\ud55c \uac78 \uc900\ube44\ud588\uc5b4.",
    "\ub9e4\uc77c \uacbd\uae30 \ub370\uc774\ud130\ub97c \ubd84\uc11d\ud558\uace0, AI \uc608\uce21\uc744 \ud655\uc778\ud558\uace0, \ucee4\ubba4\ub2c8\ud2f0\uc5d0\uc11c \ud1a0\ub860\ud558\ub294 \ubaa8\uc2b5\uc744 \ubcf4\uba74\uc11c '\uc774 \uc0ac\ub78c\uc740 \uc9c4\uc9dc \ucd95\uad6c\ub97c \uc0ac\ub791\ud558\ub294\uad6c\ub098' \ub290\uaf08\uc5b4. \uadf8\ub798\uc11c \uc7a5\uae30 \uc0ac\uc6a9\uc790\ub9cc\uc744 \uc704\ud55c \ube44\ubc00 \uacf5\uac04\uc744 \uc5f4\uae30\ub85c \uacb0\uc815\ud588\uc9c0.",
    "\uc774\uac74 \ud504\ub9ac\ubbf8\uc5c4 \uc720\uc800\uc5d0\uac8c\ub3c4 \uacf5\uac1c\ub418\uc9c0 \uc54a\uc740 '\uc778\uc0ac\uc774\ub354 \ub7a9'\uc774\uc57c. AI\uac00 \ubd84\uc11d\ud55c \ucd5c\uc2e0 \ud2b8\ub80c\ub4dc, \ub9ac\uadf8\ubcc4 \uc228\uc740 \ud328\ud134, \uadf8\ub9ac\uace0 \ub2e4\uc74c \uc8fc \uc2b9\ubd80\ucc98 \ub9e4\uce58\uc5d0 \ub300\ud55c \ub3c5\uc810 \uc778\uc0ac\uc774\ud2b8\ub97c \ub9e4\uc8fc \ubc1b\uc544\ubcfc \uc218 \uc788\uc5b4. \uc571 \ub0b4 '\ucee4\ubba4\ub2c8\ud2f0' \uc139\uc158\uc5d0\uc11c '\uc778\uc0ac\uc774\ub354 \ub7a9' \ucc44\ub110\uc744 \ucc3e\uc544\ubd10.",
    "\uc9c0\uae08 \ubc14\ub85c Predictify\ub97c \uc5f4\uace0 '\uc778\uc0ac\uc774\ub354 \ub7a9'\uc5d0 \ucc38\uac00\ud574. P.S. \uccab \ubc88\uc9f8 \uc778\uc0ac\uc774\ub354 \ub9ac\ud3ec\ud2b8\uc5d0\ub294 '\uc774\ubc88 \uc8fc\ub9d0 \ubc18\ub4dc\uc2dc \ubd10\uc57c \ud560 \uc5b8\ub354\ub3c5 \ub9e4\uce58 3\uc120'\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc5b4. \ub193\uce58\uc9c0 \ub9c8."
