{
  "subject": "68\uc77c \ub3d9\uc548 \uae30\ub2e4\ub9b0 \uc0ac\ub78c\ub9cc \ubc1b\ub294 \ube44\ubc00",
  "preview_text": "\ub2f9\uc2e0\uc774 68\uc77c \ub3d9\uc548 Predictify\uc640 \ud568\uaed8\ud55c \uc774\uc720\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc9c0\uae08\ub9cc \uacf5\uac1c\ud558\ub294 \ud2b9\ubcc4\ud55c \ud61c\ud0dd\uc744 \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "68\uc77c \ub3d9\uc548 Predictify\ub97c \uc0ac\uc6a9\ud574\uc918\uc11c \uc815\ub9d0 \uace0\ub9c8\uc6cc. \ub300\ubd80\ubd84\uc758 \uc720\uc800\ub294 2\uc8fc \uc548\uc5d0 \ub5a0\ub098\ub294\ub370, \ub2f9\uc2e0\uc740 \uc5ec\uc804\ud788 \uc5ec\uae30 \uc788\uc5b4. \uadf8\uac8c \uc758\ubbf8\ud558\ub294 \uac8c \ubb54\uc9c0 \uc54c\uc544? \ub2f9\uc2e0\uc740 \uc9c4\uc9dc \ucd95\uad6c\ub97c \uc0ac\ub791\ud558\ub294 \uc0ac\ub78c\uc774\ub77c\ub294 \uac70\uc57c. \uac8c\uc73c\ub978 \uc608\uce21\uc5d0 \ub9cc\uc871\ud558\uc9c0 \uc54a\uace0, \ub370\uc774\ud130\ub85c \uc2b9\ubd80\ub97c \ubcf4\uace0 \uc2f6\uc5b4\ud558\ub294 \uc0ac\ub78c.",
    "\uc624\ub298\uc740 \ud2b9\ubcc4\ud55c \uac78 \uc8fc\ub824\uace0 \ud574. Predictify\uc758 \ubaa8\ub4e0 \uc720\uc800\uac00 \ubc1b\ub294 \uac8c \uc544\ub2c8\uc57c. \uc624\uc9c1 68\uc77c \uc774\uc0c1 \uc0ac\uc6a9\ud55c \ub2f9\uc2e0 \uac19\uc740 \uace0\uc218\ub4e4\ub9cc\uc744 \uc704\ud55c \uac70\uc9c0. \ub0b4\ubd80 \ub370\uc774\ud130\uc5d0 \ub530\ub974\uba74, \uc774 \uc2dc\uc810\uc5d0\uc11c \uc571\uc744 \uc720\uc9c0\ud558\ub294 \uc720\uc800\ub294 \uc804\uccb4\uc758 15% \ubbf8\ub9cc\uc774\uc57c. \ub2f9\uc2e0\uc740 \uadf8 \uc5d8\ub9ac\ud2b8 \uadf8\ub8f9\uc5d0 \uc18d\ud574 \uc788\uc5b4.",
    "\uadf8\ub798\uc11c \uc9c0\uae08\ubd80\ud130 \ub2f9\uc2e0\ub9cc\uc744 \uc704\ud55c \uae30\ub2a5\uc744 \ud558\ub098 \uc54c\ub824\uc904\uac8c. 'AI \uc218\uc11d \ubd84\uc11d\uac00' \ubaa8\ub4dc\uc57c. \uc77c\ubc18 \uc720\uc800\ub294 \ud45c\uba74\uc801\uc778 \uc608\uce21\ub9cc \ubcf4\uc9c0\ub9cc, \uc774 \ubaa8\ub4dc\ub97c \ucf1c\uba74 AI\uac00 \uacbd\uae30 \uc804\uc5d0 500\uac1c \uc774\uc0c1\uc758 \ubcc0\uc218\ub97c \ubd84\uc11d\ud55c \uc0c1\uc138 \ub9ac\ud3ec\ud2b8\ub97c \ubcfc \uc218 \uc788\uc5b4. \uc608\ub97c \ub4e4\uc5b4, '\ub9e8\uc2dc\ud2f0 \ub300 \ub9ac\ubc84\ud480' \uacbd\uae30\uc5d0\uc11c xG \ucc28\uc774, \uc555\ubc15 \uc131\uacf5\ub960, \uc138\ud2b8\ud53c\uc2a4 \uc704\ud611\ub3c4 \uac19\uc740 \uc228\uaca8\uc9c4 \uc778\uc0ac\uc774\ud2b8\ub97c \ubc14\ub85c \ud655\uc778\ud560 \uc218 \uc788\uc9c0. \uc774\uac74 \ud504\ub9ac\ubbf8\uc5c4 \uad6c\ub3c5($12.99/\uc6d4, 3\uc77c \ubb34\ub8cc \uccb4\ud5d8)\uc5d0 \ud3ec\ud568\ub41c \uae30\ub2a5\uc774\uc9c0\ub9cc, \uc624\ub298\ub9cc \ud55c\uc815\uc73c\ub85c \ub2f9\uc2e0\uc5d0\uac8c 3\uc77c\uac04 \ubb34\ub8cc\ub85c \uc5f4\uc5b4\uc904\uac8c.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0 '\ud504\ub85c\ud544'\ub85c \uac00\uc11c '\ube44\ubc00 \uc120\ubb3c\ud568'\uc744 \ud655\uc778\ud574. \ucf54\ub4dc\ub97c \uc785\ub825\ud560 \ud544\uc694 \uc5c6\uc5b4, \uc790\ub3d9\uc73c\ub85c \ud65c\uc131\ud654\ub420 \uac70\uc57c. P.S. \uc774 \uae30\ud68c\ub294 48\uc2dc\uac04 \ud6c4\uc5d0 \uc0ac\ub77c\uc838. \uc774 \uae30\ub2a5\uc744 \uc601\uc6d0\ud788 \ub193\uce58\uace0 \uc2f6\uc9c0 \uc54a\ub2e4\uba74, \uc9c0\uae08 \uc6c0\uc9c1\uc5ec."
  ],
