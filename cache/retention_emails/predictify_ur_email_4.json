{
  "subject": "\u0622\u062c 2,347 \u0635\u0627\u0631\u0641\u06cc\u0646 \u0646\u06d2 \u06cc\u06c1 \u06a9\u06cc\u0627 \u0627\u0648\u0631 \u0645\u06cc\u06ba \u062d\u06cc\u0631\u0627\u0646 \u0631\u06c1 \u06af\u06cc\u0627",
  "preview_text": "\u0648\u06c1 \u0633\u0628 \u0622\u06af\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0622\u067e \u067e\u06cc\u0686\u06be\u06d2 \u0631\u06c1 \u06af\u0626\u06d2\u061f \u062c\u0627\u0646\u06cc\u06ba \u06a9\u06c1 \u0627\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u06a9\u0648\u0646 \u0633\u06cc \u0686\u0627\u0644 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc\u06d4",
  "body_paragraphs": [
    "\u06a9\u0644 \u0631\u0627\u062a 2,347 \u0635\u0627\u0631\u0641\u06cc\u0646 \u0646\u06d2 \u067e\u0631\u06cc\u0688\u06a9\u0679\u06cc\u0641\u0627\u0626\u06cc \u06a9\u06be\u0648\u0644\u0627 \u0627\u0648\u0631 \u0627\u067e\u0646\u06cc \u067e\u06cc\u0634 \u06af\u0648\u0626\u06cc\u0627\u06ba \u0686\u06cc\u06a9 \u06a9\u06cc\u06ba\u06d4 \u0627\u0646 \u0645\u06cc\u06ba \u0633\u06d2 89 \u0641\u06cc\u0635\u062f \u0646\u06d2 \u0628\u062a\u0627\u06cc\u0627 \u06a9\u06c1 \u0648\u06c1 \u067e\u06c1\u0644\u06d2 \u06a9\u0628\u06be\u06cc \u0627\u062a\u0646\u0627 \u062f\u0631\u0633\u062a \u0688\u06cc\u0679\u0627 \u0646\u06c1\u06cc\u06ba \u062f\u06cc\u06a9\u06be\u0627 \u062a\u06be\u0627\u06d4 \u0627\u0648\u0631 \u0622\u067e\u061f \u06a9\u06cc\u0627 \u0622\u067e \u0627\u0628\u06be\u06cc \u0628\u06be\u06cc \u0627\u067e\u0646\u06cc \u062c\u0628\u0644\u062a \u067e\u0631 \u0628\u06be\u0631\u0648\u0633\u06c1 \u06a9\u0631 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba\u061f",
    "\u06cc\u06c1 \u0635\u0627\u0631\u0641\u06cc\u0646 \u0635\u0631\u0641 \u0628\u06cc\u0679\u06be \u06a9\u0631 \u0646\u06c1\u06cc\u06ba \u062f\u06cc\u06a9\u06be\u062a\u06d2\u060c \u0648\u06c1 \u0627\u06d2 \u0622\u0626\u06cc \u06a9\u06d2 \u062a\u062c\u0632\u06cc\u06d2 \u0633\u06d2 \u0644\u06cc\u0633 \u06c1\u0648 \u06a9\u0631 \u0645\u06cc\u0686 \u06a9\u06cc \u06c1\u0631 \u062a\u0641\u0635\u06cc\u0644 \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0627\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u0622\u062c \u067e\u0631\u06cc\u0645\u06cc\u0626\u0631 \u0644\u06cc\u06af\u060c \u0644\u0627 \u0644\u06cc\u06af\u0627\u060c \u0627\u0648\u0631 \u0686\u06cc\u0645\u067e\u0626\u0646\u0632 \u0644\u06cc\u06af \u06a9\u06d2 50 \u0633\u06d2 \u0632\u0627\u0626\u062f \u0645\u06cc\u0686\u0648\u06ba \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u067e\u0648\u0686\u06be\u0627 \u0627\u0648\u0631 \u0627\u06d2 \u0622\u0626\u06cc \u0646\u06d2 \u0627\u0646\u06c1\u06cc\u06ba xG\u060c \u067e\u0648\u0632\u06cc\u0634\u0646 \u0627\u0648\u0631 \u0688\u06cc\u0641\u0646\u0633 \u06a9\u06cc \u0637\u0627\u0642\u062a \u0628\u062a\u0627\u0626\u06cc\u06d4 \u06a9\u06cc\u0627 \u0622\u067e \u0646\u06d2 \u0627\u067e\u0646\u06cc \u0679\u06cc\u0645 \u06a9\u0627 \u0627\u06af\u0644\u0627 \u0645\u06cc\u0686 \u0686\u06cc\u06a9 \u06a9\u06cc\u0627\u061f",
    "\u06cc\u06c1 \u0633\u0628 \u06a9\u0686\u06be \u0622\u067e \u06a9\u06cc \u0627\u0646\u06af\u0644\u06cc\u0648\u06ba \u067e\u0631 \u06c1\u06d2\u2014\u0635\u0631\u0641 \u067e\u06cc\u0634 \u06af\u0648\u0626\u06cc\u0627\u06ba \u0646\u06c1\u06cc\u06ba\u060c \u0628\u0644\u06a9\u06c1 \u06c1\u0631 \u0645\u06cc\u0686 \u06a9\u06d2 \u067e\u06cc\u0686\u06be\u06d2 \u0686\u06be\u067e\u06d2 \u0688\u06cc\u0679\u0627 \u06a9\u0627 \u062e\u0632\u0627\u0646\u06c1\u06d4 \u0622\u067e \u0627\u06d2 \u0622\u0626\u06cc \u0633\u06d2 \u0628\u0631\u0627\u06c1 \u0631\u0627\u0633\u062a \u0633\u0648\u0627\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0627\u067e\u0646\u06cc \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc \u0645\u06cc\u06ba \u0628\u062d\u062b \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0627\u0648\u0631 \u0622\u0626\u06cc \u06a9\u06cc\u0648 \u06a9\u0648\u0626\u0632 \u0645\u06cc\u06ba \u0627\u067e\u0646\u06cc \u0641\u0679 \u0628\u0627\u0644 \u0639\u0642\u0644 \u062b\u0627\u0628\u062a \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0644\u06cc\u06a9\u0646 \u0635\u0631\u0641 \u0648\u06c1\u06cc \u0644\u0648\u06af \u0622\u06af\u06d2 \u06c1\u06cc\u06ba \u062c\u0648 \u0627\u0628\u06be\u06cc \u0627\u06cc\u06a9\u0634\u0646 \u0644\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",
    "\u0627\u0628\u06be\u06cc \u0627\u06cc\u067e \u06a9\u06be\u0648\u0644\u06cc\u06ba \u0627\u0648\u0631 \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u06a9\u06c1 \u0622\u062c \u06a9\u0627 \u067e\u0648\u0679 \u0688\u06d2 (POTD) \u06a9\u06cc\u0627 \u06c1\u06d2\u2014\u0627\u0633 \u067e\u0631 \u0648\u0648\u0679 \u0688\u0627\u0644\u06cc\u06ba \u0627\u0648\u0631 \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u06a9\u06c1 \u06a9\u06cc\u0627 \u0622\u067e \u06a9\u06cc \u0631\u0627\u0626\u06d2 \u0633\u0628 \u0633\u06d2 \u0628\u06c1\u062a\u0631 \u06c1\u06d2\u06d4 \u067e\u06cc \u0627\u06cc\u0633: \u06c1\u0645\u0627\u0631\u06d2 \u067e\u0631\u06cc\u0645\u06cc\u0645 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u06c1\u0631 \u0631\u0648\u0632 3 \u0646\u0626\u06cc \u067e\u06cc\u0634 \u06af\u0648\u0626\u06cc\u0627\u06ba \u0645\u0644\u062a\u06cc \u06c1\u06cc\u06ba \u062c\u0648 \u0635\u0631\u0641 \u0627\u0646 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06a9\u06cc\u0627 \u0622\u067e \u0627\u0646 \u0645\u06cc\u06ba \u0634\u0627\u0645\u0644 \u06c1\u0648\u06ba \u06af\u06d2\u061f"
  ],
