{
  "subject": "\ub0b4 \uc5f0\uc778\uc774 \ubaa8\ub974\ub294 \ub098\ub9cc\uc758 \uafc0\ud301",
  "preview_text": "\ud30c\uc6cc \uc720\uc800\ub4e4\ub9cc \uc544\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5. \uc624\ub298 \ubc24, 10\ucd08\uba74 \uc644\ubcbd\ud55c \ub370\uc774\ud2b8\uac00 \uc644\uc131\ub429\ub2c8\ub2e4.",
  "body_paragraphs": [
    "3\uc8fc\uc9f8 \ub9e4\uc77c \uac19\uc740 \uc800\ub141 \ub8e8\ud2f4\uc5d0 \uc9c0\ucce4\ub2e4\uace0? \uc194\uc9c1\ud788 \ub9d0\ud574\uc918, \uc624\ub298 \ubc24\ub3c4 '\ubb50 \uba39\uc9c0?'\ub85c \uc2dc\uc791\ud560 \uac70\uc57c? \uc544\ub2c8\uba74 \uc9c4\uc9dc \ud2b9\ubcc4\ud55c \uac78 \uc6d0\ud574? \ub098\ub294 \ud6c4\uc790\uc57c, \uadf8\ub798\uc11c \uc774\uac78 \uc54c\ub824\uc8fc\ub824\uace0 \ud574.",
    "SoulPlan\uc744 50\uc77c\uc9f8 \uc4f0\uace0 \uc788\ub294 \ub108, \ubd84\uba85 \uc571 \uc18d\uc5d0 \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \uc544\uc9c1 \ubabb \ucc3e\uc558\uc744 \uac70\uc57c. \ud30c\uc6cc \uc720\uc800\ub4e4\uc740 \uc808\ub300 \uc785 \ubc16\uc5d0 \uc548 \ub0b4\ub294 \uafc0\ud301 \ud558\ub098: '\ud22c\ub098\uc787\uce20 \ub370\uc774\ud2b8' \uae30\ub2a5\uc5d0\uc11c \uac10\uc815\uc744 \uace0\ub97c \ub54c, '\ubaa8\ud5d8' \ubaa8\ub4dc\ub97c \ud0ed\ud558\uae30 \uc804\uc5d0 \uc0b4\uc9dd \uc67c\ucabd\uc73c\ub85c \uc2a4\uc640\uc774\ud504 \ud574\ubd10. \uac70\uae30\uc5d0 AI\uac00 \ub108\ub9cc\uc744 \uc704\ud574 \uc900\ube44\ud55c \uae5c\uc9dd \uce74\ub4dc\uac00 \uc228\uc5b4 \uc788\uc5b4. \ud3c9\ubc94\ud55c \ub370\uc774\ud2b8\ub294 NO, \uc624\ub298 \ubc24\uc740 \uc9c4\uc9dc '\ub108\uc640 \ub098'\uc758 \uc774\uc57c\uae30\ub97c \ub9cc\ub4e4\uc5b4.",
    "\uc774\uac74 \ucee4\ubba4\ub2c8\ud2f0\uc5d0\uc11c\ub3c4 \uc544\ubb34\ub3c4 \ub9d0 \uc548 \ud558\ub294 \ube44\ubc00 \ub2e8\ucd95\ud0a4\uc57c. '\ubaa8\ud5d8' \ubaa8\ub4dc\uc5d0\uc11c \uc67c\ucabd \uc2a4\uc640\uc774\ud504, \uadf8\uac8c \ub05d\uc774\uc57c. \ud30c\ud2b8\ub108\ub294 \uc804\ud600 \ubaa8\ub974\uace0, \uc624\uc9c1 \ub108\ub9cc \uc544\ub294 \uafc0\ud301\uc73c\ub85c \uc624\ub298 \ubc24\uc758 \ubd84\uc704\uae30\ub97c 180\ub3c4 \ubc14\uafd4\ubd10. 10\ucd08\uba74 \ucda9\ubd84\ud574, \uacc4\ud68d \ud53c\ub85c\ub294 \uc774\uc81c \uadf8\ub9cc.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uace0 '\ud22c\ub098\uc787\uce20 \ub370\uc774\ud2b8'\uc5d0\uc11c \ubaa8\ud5d8 \uac10\uc815\uc744 \uc120\ud0dd\ud55c \ub4a4, \uc67c\ucabd\uc73c\ub85c \uc2a4\uc640\uc774\ud504 \ud574\ubd10. \uadf8 \uce74\ub4dc\uac00 \ub108\ub97c \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4. P.S. \uc774 \uae30\ub2a5\uc740 \uc624\ub298 \ubc24\uae4c\uc9c0\ub9cc \ud2b9\ubcc4\ud788 \uacf5\uac1c\ud560\uac8c, \ub0b4\uc77c\uc774\uba74 \uc0ac\ub77c\uc838. \ub193\uce58\uc9c0 \ub9c8."
  ],
