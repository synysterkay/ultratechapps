  "subject": "\u51cc\u66683\u70b9\uff0c\u6211\u5220\u6389\u4e86Loudify\u7684\u4ee3\u7801",
  "preview_text": "\u4e00\u4e2a\u5f00\u53d1\u8005\u7684\u5766\u767d\uff1a\u4e3a\u4ec0\u4e48\u6211\u5728\u7b2c39\u5929\u7a81\u7136\u60f3\u5220\u6389\u81ea\u5df1\u5199\u7684App\uff0c\u4ee5\u53ca\u540e\u6765\u53d1\u751f\u7684\u4e8b\u3002",
  "body_paragraphs": [
    "\u4e0a\u5468\u51cc\u66683\u70b9\uff0c\u6211\u76ef\u7740Loudify\u7684\u4ee3\u7801\u5e93\uff0c\u624b\u6307\u60ac\u5728\u5220\u9664\u952e\u4e0a\u3002\u4e0d\u662f\u56e0\u4e3aBug\u2014\u2014\u800c\u662f\u56e0\u4e3a\u6211\u89c9\u5f97\u81ea\u5df1\u5199\u7684\u4e1c\u897f\uff0c\u53ef\u80fd\u6839\u672c\u4e0d\u503c\u5f97\u4f60\u7559\u7740\u3002",
    "\u4f60\u4e0b\u8f7d\u8fd9\u4e2aApp\uff0c\u662f\u4e3a\u4e86\u8ba9\u8033\u673a\u91cc\u7684\u58f0\u97f3\u7ec8\u4e8e\u5bf9\u5473\u3002\u4f46\u6211\u77e5\u9053\uff0c\u5927\u591a\u6570App\u6700\u540e\u90fd\u4f1a\u53d8\u6210\u624b\u673a\u91cc\u5403\u7070\u7684\u56fe\u6807\u3002\u6211\u4e5f\u4e00\u6837\uff0c\u88c5\u8fc7\u592a\u591a\u627f\u8bfa\u2018\u6539\u53d8\u4e00\u5207\u2019\u7684\u5de5\u5177\uff0c\u6700\u540e\u8fde\u6253\u5f00\u7684\u52a8\u529b\u90fd\u6ca1\u6709\u3002\u6240\u4ee5\u90a3\u5929\u665a\u4e0a\uff0c\u6211\u5dee\u70b9\u4eb2\u624b\u5220\u6389\u5b83\u3002",
    "\u4f46\u63a5\u7740\u6211\u6253\u5f00\u4e86Sound DNA\u2014\u2014\u4f60\u7684\u542c\u97f3\u62a5\u544a\u3002\u6211\u770b\u5230\u4e86\u4f60\u4e0a\u5468\u7684\u901a\u52e4\u6570\u636e\uff1a\u4f60\u5728\u566a\u6742\u5730\u94c1\u91cc\u628a\u7535\u5f71\u97f3\u91cf\u8c03\u5230+180%\uff0c\u5374\u6ca1\u6709\u5931\u771f\u3002\u90a3\u4e00\u523b\u6211\u7a81\u7136\u660e\u767d\uff0c\u8fd9\u4e2aApp\u4e0d\u662f\u6211\u7684\u4ee3\u7801\uff0c\u800c\u662f\u4f60\u8033\u6735\u4e0a\u7684\u6bcf\u4e00\u79d2\u3002",
    "\u6253\u5f00Loudify\uff0c\u770b\u770b\u4f60\u7684Sound DNA\u3002\u5b83\u4e0d\u4f1a\u6492\u8c0e\u3002P.S. \u5982\u679c\u4f60\u5728\u2018\u6bcf\u5468\u9876\u7ea7\u8fde\u51fb\u2019\u6392\u884c\u699c\u4e0a\u770b\u5230\u81ea\u5df1\u7684\u540d\u5b57\u2014\u2014\u90a3\u4e0d\u662f\u6211\u5199\u8fdb\u53bb\u7684\uff0c\u662f\u4f60\u81ea\u5df1\u6323\u6765\u7684\u3002"
