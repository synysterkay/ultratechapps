{
  "subject": "\u0421\u0435\u043a\u0440\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0442 90% \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f",
  "preview_text": "\u0415\u0441\u043b\u0438 \u0432\u044b \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0436\u0438\u043c\u0430\u043b\u0438 \u043a\u043d\u043e\u043f\u043a\u0443 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u044f, \u0432\u044b \u0443\u043f\u0443\u0441\u043a\u0430\u0435\u0442\u0435 90% \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0435\u0439. \u0418\u0441\u043f\u0440\u0430\u0432\u044c\u0442\u0435 \u044d\u0442\u043e \u0437\u0430 60 \u0441\u0435\u043a\u0443\u043d\u0434.",
  "body_paragraphs": [
    "\u0417\u043d\u0430\u0435\u0448\u044c, \u0447\u0442\u043e \u0441\u0430\u043c\u043e\u0435 \u0441\u043c\u0435\u0448\u043d\u043e\u0435? \u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043b\u044e\u0434\u0435\u0439 \u0441\u043a\u0430\u0447\u0438\u0432\u0430\u044e\u0442 \u043d\u0430\u0448 \u0431\u0443\u0441\u0442\u0435\u0440, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0438 \u0434\u0443\u043c\u0430\u044e\u0442: \"\u041d\u0443, \u043e\u043a, \u0437\u0432\u0443\u043a \u0441\u0442\u0430\u043b \u0433\u0440\u043e\u043c\u0447\u0435\". \u0418 \u043d\u0430 \u044d\u0442\u043e\u043c \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0442\u0441\u044f. \u0410 \u043f\u043e\u0442\u043e\u043c \u0436\u0430\u043b\u0443\u044e\u0442\u0441\u044f, \u0447\u0442\u043e \u0432 \u043c\u0435\u0442\u0440\u043e \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u043d\u0435 \u0441\u043b\u044b\u0448\u043d\u043e \u043f\u043e\u0434\u043a\u0430\u0441\u0442 \u0438\u043b\u0438 \u0447\u0442\u043e \u0431\u0430\u0441 \u0432 \u0442\u0440\u0435\u043a\u0435 \"\u043f\u043b\u043e\u0441\u043a\u0438\u0439\". \u042d\u0442\u043e \u043a\u0430\u043a \u043a\u0443\u043f\u0438\u0442\u044c Ferrari \u0438 \u0435\u0437\u0434\u0438\u0442\u044c \u043d\u0430 \u043d\u0435\u0439 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043e \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u0437\u0430 \u0443\u0433\u043b\u043e\u043c.",
    "\u041d\u0430\u0441\u0442\u043e\u044f\u0449\u0430\u044f \u043c\u0430\u0433\u0438\u044f \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u043d\u0435 \u0441 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438, \u0430 \u0441 \u0427\u0415\u0422\u041a\u041e\u0421\u0422\u0418. \u0428\u0443\u043c \u0443\u043b\u0438\u0446\u044b, \u0433\u0443\u043b \u043f\u043e\u0435\u0437\u0434\u0430, \u0448\u0451\u043f\u043e\u0442 \u0432 \u043f\u043e\u0434\u043a\u0430\u0441\u0442\u0435 \u2014 \u0432\u0441\u0451 \u044d\u0442\u043e \u0442\u043e\u043d\u0435\u0442 \u0432 \u043e\u0431\u0449\u0435\u043c \u0433\u0443\u043b\u0435. \u0421\u0435\u043a\u0440\u0435\u0442 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u0440\u0438\u0447\u0430\u0442\u044c \u0433\u0440\u043e\u043c\u0447\u0435 \u0432\u0441\u0435\u0445, \u0430 \u0447\u0442\u043e\u0431\u044b \u0442\u0432\u043e\u0439 \u0437\u0432\u0443\u043a \u041f\u0420\u041e\u0420\u042b\u0412\u0410\u041b\u0421\u042f \u0441\u043a\u0432\u043e\u0437\u044c \u043b\u044e\u0431\u043e\u0439 \u0448\u0443\u043c. \u041a\u0430\u043a \u043b\u0443\u0447 \u0444\u043e\u043d\u0430\u0440\u0438\u043a\u0430 \u0432 \u043f\u043e\u043b\u043d\u043e\u0439 \u0442\u0435\u043c\u043d\u043e\u0442\u0435. \u0418 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0435\u0441\u0442\u044c \u043e\u0434\u0438\u043d \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0439, \u043f\u043e\u0447\u0442\u0438 \u0432\u043e\u043b\u0448\u0435\u0431\u043d\u044b\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442, \u043e \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043c\u043d\u043e\u0433\u0438\u0435 \u0434\u0430\u0436\u0435 \u043d\u0435 \u0434\u043e\u0433\u0430\u0434\u044b\u0432\u0430\u044e\u0442\u0441\u044f.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u0440\u0430\u0437\u0434\u0435\u043b '\u042d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440'. \u0412\u0438\u0434\u0438\u0448\u044c \u043f\u0440\u0435\u0441\u0435\u0442 '\u041f\u043e\u043f' \u0438\u043b\u0438 '\u0420\u043e\u043a'? \u0417\u0430\u0431\u0443\u0434\u044c \u043f\u0440\u043e \u043d\u0438\u0445 \u043d\u0430 \u043c\u0438\u043d\u0443\u0442\u0443. \u0412\u043a\u043b\u044e\u0447\u0438 \u043f\u0440\u0435\u0441\u0435\u0442 '\u0420\u0430\u0437\u0433\u043e\u0432\u043e\u0440' \u0438\u043b\u0438 '\u041f\u043e\u0434\u043a\u0430\u0441\u0442'. \u0410 \u0442\u0435\u043f\u0435\u0440\u044c \u2014 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u2014 \u043e\u043f\u0443\u0441\u0442\u0438 \u043f\u043e\u043b\u0437\u0443\u043d\u043a\u0438 \u043d\u0438\u0437\u043a\u0438\u0445 \u0447\u0430\u0441\u0442\u043e\u0442 (\u0431\u0430\u0441) \u043d\u0430 20-30%, \u0430 \u043f\u043e\u043b\u0437\u0443\u043d\u043a\u0438 \u0432\u044b\u0441\u043e\u043a\u0438\u0445 \u0438 \u0441\u0440\u0435\u0434\u043d\u0438\u0445 \u0447\u0430\u0441\u0442\u043e\u0442 \u043f\u043e\u0434\u043d\u0438\u043c\u0438. \u0422\u044b \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u0432\u044b\u0440\u0435\u0436\u0435\u0448\u044c \u0444\u043e\u043d\u043e\u0432\u044b\u0439 \u0433\u0443\u043b \u0438 \u0432\u044b\u0442\u0430\u0449\u0438\u0448\u044c \u043d\u0430 \u043f\u0435\u0440\u0435\u0434\u043d\u0438\u0439 \u043f\u043b\u0430\u043d \u0433\u043e\u043b\u043e\u0441 \u0438\u043b\u0438 \u043c\u0435\u043b\u043e\u0434\u0438\u044e. \u042d\u0442\u043e \u043a\u0430\u043a \u043d\u0430\u0434\u0435\u0442\u044c \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438 \u0441 \u0448\u0443\u043c\u043e\u043f\u043e\u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435\u043c, \u043d\u043e \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0433\u043e \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430. \u0417\u0432\u0443\u043a \u043d\u0435 \u0441\u0442\u0430\u043d\u0435\u0442 \u0433\u0440\u043e\u043c\u0447\u0435 \u2014 \u043e\u043d \u0441\u0442\u0430\u043d\u0435\u0442 \u042f\u0421\u041d\u042b\u041c. \u0422\u044b \u0431\u0443\u0434\u0435\u0448\u044c \u0441\u043b\u044b\u0448\u0430\u0442\u044c \u043a\u0430\u0436\u0434\u043e\u0435 \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u0430\u043c\u043e\u043c \u0448\u0443\u043c\u043d\u043e\u043c \u0432\u0430\u0433\u043e\u043d\u0435.",
    "\u041f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u043e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 60 \u0441\u0435\u043a\u0443\u043d\u0434 \u043f\u043e\u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0438\u0440\u0443\u0439 \u0441 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440\u043e\u043c \u043f\u043e\u0434 \u0441\u0432\u043e\u0439 \u0442\u0435\u043a\u0443\u0449\u0438\u0439 \u0442\u0440\u0435\u043a \u0438\u043b\u0438 \u043f\u043e\u0434\u043a\u0430\u0441\u0442. \u041d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u043a\u043b\u044e\u0447\u0438 \u0431\u0443\u0441\u0442\u0435\u0440 \u2014 \u0421\u041a\u041e\u041d\u0424\u0418\u0413\u0423\u0420\u0418\u0420\u0423\u0419 \u0437\u0432\u0443\u043a \u043f\u043e\u0434 \u0441\u0440\u0435\u0434\u0443. \u042d\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u0442 \u0432\u0441\u0451. P.S. \u041a\u0441\u0442\u0430\u0442\u0438, \u0432 Premium-\u0432\u0435\u0440\u0441\u0438\u0438 \u044d\u0442\u043e\u0442 \u0442\u0440\u044e\u043a \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0432 10 \u0440\u0430\u0437 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0435\u0435 \u2014 \u0442\u0430\u043c \u043c\u043e\u0436\u043d\u043e \u0442\u043e\u0447\u0435\u0447\u043d\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u043a\u0430\u0436\u0434\u0443\u044e \u0447\u0430\u0441\u0442\u043e\u0442\u0443 \u0438 \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0441\u0432\u043e\u0439 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439, \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u043b\u044f \u0442\u0435\u0431\u044f, \u043f\u0440\u0435\u0441\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0441\u044f \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
  ],
