{
  "subject": "\u0935\u0939 \u092b\u0940\u091a\u0930 \u091c\u094b 10 \u092e\u0947\u0902 \u0938\u0947 9 \u0932\u094b\u0917 \u092e\u093f\u0938 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902",
  "preview_text": "\u0939\u092e\u0928\u0947 \u091c\u093e\u0928\u092c\u0942\u091d\u0915\u0930 \u0907\u0938\u0947 \u091b\u0941\u092a\u093e\u092f\u093e \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u092f\u0939\u0940 \u0906\u092a\u0915\u0940 \u0921\u0947\u091f \u0928\u093e\u0907\u091f \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 \u092e\u0947\u0930\u0947 \u090f\u0915 \u0926\u094b\u0938\u094d\u0924 \u0928\u0947 \u0936\u093f\u0915\u093e\u092f\u0924 \u0915\u0940, '\u0939\u092e\u093e\u0930\u0940 \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928\u093f\u0902\u0917 \u092e\u0947\u0902 \u0906\u0927\u093e \u0918\u0902\u091f\u093e \u0932\u0917 \u091c\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u092b\u093f\u0930 \u0935\u0939\u0940 \u092a\u0941\u0930\u093e\u0928\u093e \u0930\u0942\u091f\u0940\u0928\u0964' \u092e\u0948\u0902\u0928\u0947 \u0909\u0938\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0939\u092e\u093e\u0930\u0947 \u0910\u092a \u092e\u0947\u0902 \u090f\u0915 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b 30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0938\u092c \u0915\u0941\u091b \u0924\u092f \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 90% \u0932\u094b\u0917 \u0909\u0938 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0924\u0947 \u0939\u0940 \u0928\u0939\u0940\u0902\u0964 \u0915\u094d\u092f\u094b\u0902? \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0935\u0939 \u0938\u0940\u0927\u0947 \u0928\u091c\u0930 \u0928\u0939\u0940\u0902 \u0906\u0924\u093e, \u091b\u0941\u092a\u093e \u0939\u0941\u0906 \u0939\u0948\u0964",
    "\u092f\u0939 \u092b\u0940\u091a\u0930 \u0915\u094b\u0908 \u0917\u0948\u091c\u0947\u091f \u092f\u093e \u091f\u0942\u0932 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u092c\u091f\u0928 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u0939\u094b\u092e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 '\u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f' \u0915\u0947 \u0928\u0940\u091a\u0947 \u0926\u092c\u093e \u0930\u0939\u0924\u093e \u0939\u0948\u0964 \u091c\u092c \u0906\u092a \u0915\u094b\u0908 \u092e\u0942\u0921 \u091a\u0941\u0928\u0924\u0947 \u0939\u0948\u0902\u2014\u0915\u094b\u091c\u093c\u0940, \u090f\u0921\u0935\u0947\u0902\u091a\u0930\u0938, \u092a\u094d\u0932\u0947\u092b\u0941\u0932, \u092f\u093e \u0939\u0940\u0932\u093f\u0902\u0917\u2014\u0924\u094b AI \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u092a\u0942\u0930\u0940 \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0905\u0928\u0926\u0947\u0916\u093e \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u091c\u093f\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0907\u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e, \u0935\u0947 \u0905\u0917\u0932\u0947 \u092e\u0939\u0940\u0928\u0947 \u092e\u0947\u0902 4 \u0917\u0941\u0928\u093e \u091c\u094d\u092f\u093e\u0926\u093e \u0921\u0947\u091f\u094d\u0938 \u092a\u0930 \u0917\u090f\u0964",
    "\u0938\u094b\u091a\u093f\u090f: \u0906\u092a \u0914\u0930 \u0906\u092a\u0915\u093e \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0938\u094b\u092b\u0947 \u092a\u0930 \u092c\u0948\u0920\u0947 \u0939\u0948\u0902, \u0915\u094b\u0908 \u0906\u0907\u0921\u093f\u092f\u093e \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a\u2014'\u090f\u0921\u0935\u0947\u0902\u091a\u0930\u0938'\u2014\u0914\u0930 30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u092a\u0942\u0930\u0940 \u0930\u093e\u0924 \u092a\u094d\u0932\u093e\u0928\u0964 \u0915\u094b\u0908 \u091d\u0902\u091d\u091f \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0917\u0942\u0917\u0932 \u0938\u0930\u094d\u091a \u0928\u0939\u0940\u0902\u0964 \u092f\u0939 \u0935\u0939\u0940 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b \u0939\u092e\u0928\u0947 \u091c\u093e\u0928\u092c\u0942\u091d\u0915\u0930 \u091b\u0941\u092a\u093e\u092f\u093e \u0924\u093e\u0915\u093f \u0906\u092a\u0915\u094b \u0916\u094b\u091c\u0928\u0947 \u0915\u0940 \u0916\u0941\u0936\u0940 \u092e\u093f\u0932\u0947\u0964 \u0906\u091c \u0939\u0940 \u0907\u0938\u0947 \u0906\u091c\u092e\u093e\u090f\u0902\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0939\u094b\u092e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 '\u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u092b\u093f\u0930 \u0915\u094b\u0908 \u092e\u0942\u0921 \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f AI \u0915\u094d\u092f\u093e \u092a\u094d\u0932\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 P.S. \u0905\u0917\u0930 \u0906\u092a\u0928\u0947 \u092a\u093f\u091b\u0932\u0940 \u092c\u093e\u0930 '\u0939\u0940\u0932\u093f\u0902\u0917' \u091a\u0941\u0928\u093e \u0925\u093e, \u0924\u094b \u0906\u091c '\u092a\u094d\u0932\u0947\u092b\u0941\u0932' \u0906\u091c\u093c\u092e\u093e\u090f\u0902\u2014\u0939\u092e\u093e\u0930\u093e \u0921\u0947\u091f\u093e \u0915\u0939\u0924\u093e \u0939\u0948 \u0915\u093f \u092f\u0939 \u0915\u092a\u0932\u094d\u0938 \u0915\u094b \u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0939\u0902\u0938\u093e\u0924\u093e \u0939\u0948\u0964"
  ],
  "cta_text": "\u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902",
