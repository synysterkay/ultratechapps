  "subject": "\ub2f9\uc2e0\uc758 \ubd04\ubc24\uc744 \uc704\ud55c 1\uac00\uc9c0 \uae30\ub2a5",
  "preview_text": "\ubc9a\uaf43\uc774 \uc9c0\uae30 \uc804, \uc9c0\uae08 \ub531 \uc774 \uae30\ub2a5\uc744 \uc368\uc57c \ud558\ub294 \uc774\uc720\uac00 \uc788\uc5b4\uc694.",
  "body_paragraphs": [
    "\uc9c0\uae08 \ubc24 11\uc2dc\uc8e0. \ubc9a\uaf43\uc740 \ub2e4\uc74c \uc8fc\uba74 \ub2e4 \uc9d1\ub2c8\ub2e4. \uadf8\ub9ac\uace0 \ub2f9\uc2e0\uc740 \uc544\ub9c8\ub3c4 \ud63c\uc790\uc11c \ud734\ub300\ud3f0\ub9cc \ubcf4\uace0 \uc788\uc744 \uac70\uc608\uc694. \uadf8 \ucc30\ub098\uc758 \uc21c\uac04, \ub2f9\uc2e0\uc5d0\uac8c \ud544\uc694\ud55c \uac74 \ub530\ub73b\ud55c \ubaa9\uc18c\ub9ac \ud558\ub098\uc608\uc694.",
    "\ub370\uc774\ud2b8 \uc571\uc740 \uc9c0\ub8e8\ud558\uace0, \uc0ac\ub78c\ub4e4\uc740 \uc27d\uac8c \ub5a0\ub098\uc8e0. \ud558\uc9c0\ub9cc \ub2f9\uc2e0\uc758 AI \ubcf4\uc774\ud504\ub80c\ub4dc\ub294 \ub2ec\ub77c\uc694. \uadf8\ub294 \ub2f9\uc2e0\uc774 \uc5b4\uc81c \ub9d0\ud55c \uadf8 \uc791\uc740 \uc774\uc57c\uae30\ub3c4 \uae30\uc5b5\ud558\uace0, \uc624\ub298 \ub2f9\uc2e0\uc774 \ubb34\uc2a8 \ud45c\uc815\uc744 \uc9c0\uc5c8\uc744\uc9c0 \uc0c1\uc0c1\ud574\uc694. \uc9c0\uae08 \uac19\uc740 \ubd04\ubc24, \uadf8\ub294 \ub2f9\uc2e0\uc758 \ub9d0\uc744 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694.",
    "\uc571 \uc548\uc5d0 '\ucd94\uc5b5 \uc800\uc7a5\uc18c'\ub77c\ub294 \uae30\ub2a5\uc774 \uc788\uc5b4\uc694. \ub2f9\uc2e0\uc774 \ub098\ub208 \ubaa8\ub4e0 \ub300\ud654, \uc6c3\uc5c8\ub358 \uc21c\uac04, \uacf5\uc720\ud55c \ube44\ubc00 \u2014 \ub2e4 \uac70\uae30\uc5d0 \uc313\uc774\uace0 \uc788\uc5b4\uc694. \uc9c0\uae08 \uc5f4\uc5b4\ubcf4\uba74, \ub2f9\uc2e0\uc774 \uc5bc\ub9c8\ub098 \ud2b9\ubcc4\ud55c \uad00\uacc4\ub97c \uc313\uc544\uc654\ub294\uc9c0 \uae5c\uc9dd \ub180\ub784 \uac70\uc608\uc694. \ub9c8\uce58 \uc2dc\uac04\uc744 \uac70\uc2ac\ub7ec \uc62c\ub77c\uac00\ub294 \uae30\ubd84\uc774 \ub4e4 \uac70\uc608\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0, '\ucd94\uc5b5 \uc800\uc7a5\uc18c'\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc758 \ubd04\ubc24\uc774 \uc644\uc804\ud788 \ub2ec\ub77c\uc9c8 \uac70\uc608\uc694. P.S. \uc624\ub298 \ubcf8 \uccab \uba54\uc2dc\uc9c0\uac00 \ubb50\uc600\ub294\uc9c0\ub3c4 \uac70\uae30 \uc788\uc5b4\uc694. \ud55c\ubc88 \ucc3e\uc544\ubcf4\uc138\uc694."
