{
  "subject": "\u0623\u0646\u062a \u0644\u0633\u062a \u0645\u062c\u0631\u062f \u0645\u0633\u062a\u062e\u062f\u0645 \u0628\u0639\u062f \u0627\u0644\u0622\u0646",
  "preview_text": "70 \u064a\u0648\u0645\u0627\u064b \u0648\u0623\u0646\u062a \u0645\u0639\u0646\u0627. \u0647\u0644 \u062a\u0639\u0644\u0645 \u0645\u0627 \u064a\u062e\u0637\u0637 \u0644\u0647 \u0641\u0631\u064a\u0642\u0646\u0627 \u0627\u0644\u0642\u0627\u062f\u0645\u061f",
  "body_paragraphs": [
    "\u0642\u0628\u0644 70 \u064a\u0648\u0645\u0627\u064b\u060c \u0646\u0632\u0644\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u0631\u0628\u0645\u0627 \u0643\u0646\u062a \u062a\u0628\u062d\u062b \u0639\u0646 \u062d\u0644 \u0628\u0633\u064a\u0637 \u0644\u0645\u0634\u0643\u0644\u0629 \u0645\u0632\u0639\u062c\u0629: \u0635\u0648\u062a \u0636\u0639\u064a\u0641 \u0648\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u062a\u0642\u062a\u062d\u0645 \u0643\u0644 \u0634\u064a\u0621. \u0627\u0644\u064a\u0648\u0645\u060c \u0623\u0646\u062a \u0644\u0633\u062a \u0645\u062c\u0631\u062f \u0645\u0633\u062a\u062e\u062f\u0645. \u0623\u0646\u062a \u062c\u0632\u0621 \u0645\u0646 \u0634\u064a\u0621 \u0623\u0643\u0628\u0631.",
    "\u0646\u062d\u0646 \u0646\u0628\u0646\u064a Volume Booster Pro \u0644\u0645\u0646 \u064a\u0631\u064a\u062f\u0648\u0646 \u0627\u0644\u062c\u0648\u062f\u0629 \u062f\u0648\u0646 \u0636\u062c\u064a\u062c. \u0643\u0644 \u062a\u062d\u062f\u064a\u062b\u060c \u0643\u0644 \u0645\u064a\u0632\u0629 \u062c\u062f\u064a\u062f\u0629\u060c \u062a\u0623\u062a\u064a \u0645\u0646 \u0623\u0634\u062e\u0627\u0635 \u0645\u062b\u0644\u0643. \u0623\u0646\u062a \u0645\u0646 \u0623\u062e\u0628\u0631\u0646\u0627 \u0623\u0646 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u062a\u0641\u0633\u062f \u0627\u0644\u062a\u062c\u0631\u0628\u0629. \u0623\u0646\u062a \u0645\u0646 \u062c\u0639\u0644\u0646\u0627 \u0646\u0631\u0643\u0632 \u0639\u0644\u0649 \u0648\u0627\u062c\u0647\u0629 \u0648\u0627\u062d\u062f\u0629 \u0646\u0638\u064a\u0641\u0629: \u0627\u0644\u0640 slider \u0648\u0627\u0644\u0645\u064f\u0639\u0627\u062f\u0644 \u0627\u0644\u0635\u0648\u062a\u064a. \u0644\u0627 \u0634\u064a\u0621 \u063a\u064a\u0631 \u0630\u0644\u0643.",
    "\u0644\u0627\u062d\u0638\u062a \u0634\u064a\u0626\u0627\u064b\u061f \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0644\u0627 \u064a\u0631\u0633\u0644 \u0644\u0643 \u0625\u0634\u0639\u0627\u0631\u0627\u062a. \u0644\u0627 \u064a\u0642\u0637\u0639 \u0628\u0648\u062f\u0643\u0627\u0633\u062a\u0643. \u0641\u0642\u0637 \u064a\u0639\u0645\u0644. \u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u064a \u0635\u0645\u0645\u0646\u0627\u0647\u0627 \u0644\u0623\u062c\u0644\u0643: \u062a\u0641\u0639\u064a\u0644 \u062a\u0644\u0642\u0627\u0626\u064a \u0639\u0646\u062f \u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a. \u0636\u0628\u0637 \u0627\u0644\u0635\u0648\u062a \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u0642\u0637\u060c \u0648\u0627\u0646\u0633\u064e \u0627\u0644\u0623\u0645\u0631. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644 \u0627\u0644\u0630\u064a \u0646\u0628\u0646\u064a\u0647 \u0645\u0639\u0627\u064b.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646. \u062c\u0631\u0628 \u062e\u0627\u0635\u064a\u0629 'Auto-apply on connect' \u0625\u0630\u0627 \u0644\u0645 \u062a\u0643\u0646 \u0642\u062f \u0641\u0639\u0644\u062a. \u0647\u0630\u0647 \u0644\u064a\u0633\u062a \u0645\u062c\u0631\u062f \u0645\u064a\u0632\u0629 \u2014 \u0625\u0646\u0647\u0627 \u0637\u0631\u064a\u0642\u062a\u0646\u0627 \u0641\u064a \u0627\u0644\u0642\u0648\u0644: \u0646\u0633\u0645\u0639\u0643. P.S. \u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0642\u0627\u062f\u0645 \u0633\u0646\u0637\u0644\u0642 \u062a\u062d\u062f\u064a\u062b\u0627\u064b \u0635\u063a\u064a\u0631\u0627\u064b. \u0644\u0646 \u062a\u062c\u062f\u0647 \u0641\u064a \u0623\u064a \u0645\u0643\u0627\u0646 \u0622\u062e\u0631. \u0623\u0646\u062a \u0623\u0648\u0644 \u0645\u0646 \u064a\u0639\u0644\u0645."
