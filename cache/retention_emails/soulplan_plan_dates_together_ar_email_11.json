{
  "subject": "\u0627\u0644\u062e\u0631\u0627\u0641\u0629 \u0627\u0644\u062a\u064a \u062a\u0642\u062a\u0644 \u0627\u0644\u0631\u0648\u0645\u0627\u0646\u0633\u064a\u0629 \u0641\u064a 3 \u0623\u064a\u0627\u0645",
  "preview_text": "\u0627\u0644\u062c\u0645\u064a\u0639 \u064a\u0639\u062a\u0642\u062f \u0623\u0646 \u0627\u0644\u0639\u0641\u0648\u064a\u0629 \u0647\u064a \u0633\u0631 \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0627\u0644\u0646\u0627\u062c\u062d\u0629. \u0644\u0643\u0646 \u0627\u0644\u0623\u0628\u062d\u0627\u062b \u062a\u0642\u0648\u0644 \u0639\u0643\u0633 \u0630\u0644\u0643 \u062a\u0645\u0627\u0645\u0627.",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0647\u0630\u0627: \u0623\u0646\u062a \u0645\u062a\u0623\u062e\u0631 \u0639\u0646 \u0627\u0644\u0639\u0645\u0644\u060c \u0634\u0631\u064a\u0643\u0643 \u064a\u0634\u0627\u0647\u062f \u0627\u0644\u062a\u0644\u0641\u0627\u0632\u060c \u0648\u0641\u062c\u0623\u0629 \u062a\u0642\u0631\u0631 \u0623\u0646 \u062a\u0641\u0627\u062c\u0626\u0647 \u0628\u0645\u0648\u0639\u062f \u0639\u0634\u0627\u0621. \u062a\u0641\u062a\u062d \u0627\u0644\u0647\u0627\u062a\u0641\u060c \u062a\u0628\u062d\u062b \u0639\u0646 \u0645\u0637\u0639\u0645\u060c \u062a\u062a\u0635\u0644 \u0644\u0644\u062d\u062c\u0632\u2014\u0648\u0628\u0639\u062f \u0633\u0627\u0639\u0629 \u0643\u0627\u0645\u0644\u0629 \u0645\u0646 \u0627\u0644\u062a\u062e\u0637\u064a\u0637\u060c \u062a\u0634\u0639\u0631 \u0623\u0646\u0643 \u0623\u0631\u0647\u0642\u062a \u0646\u0641\u0633\u0643 \u0623\u0643\u062b\u0631 \u0645\u0645\u0627 \u0627\u0633\u062a\u0645\u062a\u0639\u062a. \u0647\u0630\u0647 \u0647\u064a \u0627\u0644\u0639\u0641\u0648\u064a\u0629 \u0627\u0644\u062a\u064a \u064a\u0628\u064a\u0639\u0647\u0627 \u0644\u0646\u0627 \u0627\u0644\u062c\u0645\u064a\u0639.",
    "\u0644\u0643\u0646 \u0627\u0644\u062d\u0642\u064a\u0642\u0629 \u0635\u0627\u062f\u0645\u0629: \u0627\u0644\u0623\u0632\u0648\u0627\u062c \u0627\u0644\u0630\u064a\u0646 \u064a\u062e\u0637\u0637\u0648\u0646 \u0644\u0645\u0648\u0627\u0639\u064a\u062f\u0647\u0645 \u0645\u0633\u0628\u0642\u0627\u2014\u062d\u062a\u0649 \u0644\u0648 \u0643\u0627\u0646\u062a \u0628\u0633\u064a\u0637\u0629\u2014\u064a\u0634\u0639\u0631\u0648\u0646 \u0628\u0631\u0648\u0645\u0627\u0646\u0633\u064a\u0629 \u0623\u0642\u0648\u0649 \u0628\u0646\u0633\u0628\u0629 40% \u0645\u0646 \u0623\u0648\u0644\u0626\u0643 \u0627\u0644\u0630\u064a\u0646 \u064a\u0639\u062a\u0645\u062f\u0648\u0646 \u0639\u0644\u0649 \u0627\u0644\u0639\u0641\u0648\u064a\u0629. \u0644\u0645\u0627\u0630\u0627\u061f \u0644\u0623\u0646 \u0627\u0644\u062a\u062e\u0637\u064a\u0637 \u064a\u0631\u0633\u0644 \u0631\u0633\u0627\u0644\u0629: '\u0623\u0646\u062a \u0645\u0647\u0645 \u0628\u0645\u0627 \u064a\u0643\u0641\u064a \u0644\u0623\u062e\u0635\u0635 \u0644\u0643 \u0648\u0642\u062a\u0627'. \u0625\u0646\u0647 \u0644\u064a\u0633 \u0631\u0648\u062a\u064a\u0646\u0627\u060c \u0628\u0644 \u0627\u062d\u062a\u0631\u0627\u0645.",
    "\u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0633\u0628\u0628 \u0627\u0644\u0630\u064a \u062c\u0639\u0644\u0646\u0627 \u0646\u0628\u0646\u064a '\u0645\u0648\u0639\u062f \u0627\u0644\u0644\u064a\u0644\u0629' \u0641\u064a \u0633\u0648\u0644\u0628\u0644\u0627\u0646. \u0644\u064a\u0633 \u0644\u0633\u0631\u0642\u0629 \u0639\u0641\u0648\u064a\u0629 \u0627\u0644\u0644\u062d\u0638\u0629\u060c \u0628\u0644 \u0644\u0645\u0646\u062d\u0643 30 \u062b\u0627\u0646\u064a\u0629 \u0641\u0642\u0637 \u0644\u062a\u062e\u062a\u0627\u0631 \u0645\u0632\u0627\u062c\u0643 (\u062f\u0627\u0641\u0626\u060c \u0645\u063a\u0627\u0645\u0631\u060c \u0645\u0631\u062d\u060c \u0645\u0647\u062f\u0626)\u2014\u0648\u0646\u062d\u0646 \u0646\u062e\u0637\u0637 \u0627\u0644\u0628\u0627\u0642\u064a. \u0634\u0631\u064a\u0643\u0643 \u0633\u064a\u0631\u0649 \u0644\u062d\u0638\u0629 '\u0641\u0643\u0631\u062a \u0641\u064a\u0643 \u0627\u0644\u0644\u064a\u0644\u0629' \u0627\u0644\u0643\u0627\u0645\u0644\u0629\u060c \u0648\u0633\u062a\u0634\u0639\u0631 \u0623\u0646\u0643 \u0628\u0630\u0644\u062a \u062c\u0647\u062f\u0627 \u062d\u0642\u064a\u0642\u064a\u0627 \u062f\u0648\u0646 \u0639\u0646\u0627\u0621.",
    "\u0627\u0644\u0622\u0646 \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u062e\u062a\u0631 '\u0645\u0648\u0639\u062f \u0627\u0644\u0644\u064a\u0644\u0629'\u060c \u0648\u0627\u062e\u062a\u0628\u0631 \u0627\u0644\u0641\u0631\u0642 \u0628\u0646\u0641\u0633\u0643. \u0633\u062a\u0631\u0649 \u0623\u0646 \u0627\u0644\u062a\u062e\u0637\u064a\u0637 \u0644\u064a\u0633 \u0639\u062f\u0648\u0627 \u0644\u0644\u0631\u0648\u0645\u0627\u0646\u0633\u064a\u0629\u2014\u0628\u0644 \u0647\u0648 \u0623\u062f\u0627\u062a\u0647\u0627 \u0627\u0644\u0623\u0642\u0648\u0649. \u062a\u0630\u0643\u0631: \u0627\u0644\u0639\u0641\u0648\u064a\u0629 \u062c\u0645\u064a\u0644\u0629\u060c \u0644\u0643\u0646 \u0627\u0644\u062a\u062e\u0637\u064a\u0637 \u0647\u0648 \u0645\u0627 \u064a\u0628\u0642\u064a \u0627\u0644\u062d\u0628 \u062d\u064a\u0627. \n\n\u0645\u0644\u0627\u062d\u0638\u0629: \u0627\u0644\u0623\u0632\u0648\u0627\u062c \u0627\u0644\u0630\u064a\u0646 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 '\u0645\u0648\u0639\u062f \u0627\u0644\u0644\u064a\u0644\u0629' \u0641\u064a \u0623\u0648\u0644 24 \u0633\u0627\u0639\u0629 \u064a\u062e\u0637\u0637\u0648\u0646 4 \u0623\u0636\u0639\u0627\u0641 \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0641\u064a \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u062a\u0627\u0644\u064a. \u0644\u0627 \u062a\u0646\u062a\u0638\u0631."
  ],
