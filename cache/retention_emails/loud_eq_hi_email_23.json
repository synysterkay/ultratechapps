{
  "subject": "\u0906\u092a\u0928\u0947 53 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0915\u094d\u092f\u093e \u0916\u094b\u092f\u093e",
  "preview_text": "\u092c\u093f\u0928\u093e \u0910\u092a \u0915\u0947 \u0935\u094b \u0915\u092e\u094d\u092f\u0942\u091f \u092f\u093e\u0926 \u0939\u0948? \u0905\u092c \u0938\u0941\u0928\u093f\u090f \u0915\u093f\u0924\u0928\u093e \u092c\u0926\u0932 \u0917\u092f\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "53 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947, \u0906\u092a\u0928\u0947 Loud EQ \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u0909\u0938 \u0926\u093f\u0928 \u0938\u0947 \u092a\u0939\u0932\u0947, \u0939\u0930 \u0915\u092e\u094d\u092f\u0942\u091f \u090f\u0915 \u091c\u0902\u0917 \u0925\u0940\u0964 \u091f\u094d\u0930\u0947\u0928 \u0915\u093e \u0936\u094b\u0930, \u0930\u094b\u0921 \u0915\u093e \u0939\u0949\u0930\u094d\u0928, \u0914\u0930 \u0906\u092a\u0915\u0947 \u0908\u092f\u0930\u092b\u094b\u0928 \u0938\u0947 \u092c\u0938 \u090f\u0915 \u092c\u0947\u091c\u093e\u0928 \u0906\u0935\u093e\u091c\u093c\u0964 \u0906\u092a \u0935\u0949\u0932\u094d\u092f\u0942\u092e 100% \u092a\u0930 \u0932\u0947 \u091c\u093e\u0924\u0947, \u092b\u093f\u0930 \u092d\u0940 \u0921\u093e\u092f\u0932\u0949\u0917 \u0916\u094b \u091c\u093e\u0924\u0947\u0964 \u092f\u093e\u0926 \u0939\u0948 \u0935\u094b \u091d\u0941\u0902\u091d\u0932\u093e\u0939\u091f? \u0935\u094b '\u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u092e\u0947\u0939\u0928\u0924'?",
    "\u0905\u092c \u0938\u094b\u091a\u093f\u090f\u0964 \u0906\u091c \u0915\u093e \u0915\u092e\u094d\u092f\u0942\u091f\u0964 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0924\u0928\u093e\u0935 \u0915\u0947, \u0939\u0930 \u0936\u092c\u094d\u0926 \u0938\u093e\u092b\u0964 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u093e \u0939\u0930 \u0932\u0939\u091c\u093e, \u0911\u0921\u093f\u092f\u094b\u092c\u0941\u0915 \u0915\u093e \u0939\u0930 \u092e\u094b\u0921\u093c\u0964 \u0906\u092a\u0915\u0940 \u091c\u0947\u092c \u092e\u0947\u0902 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u091c\u093e\u0926\u0942 \u0939\u0948 \u091c\u094b \u0939\u0930 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u094b \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0922\u093e\u0932\u0924\u093e \u0939\u0948\u0964 \u092b\u0930\u094d\u0915 \u0938\u093f\u0930\u094d\u092b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0915\u093e \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0938\u094d\u092a\u0937\u094d\u091f\u0924\u093e \u0915\u093e \u0939\u0948\u0964 \u0914\u0930 \u0939\u093e\u0901, \u0906\u092a\u0915\u0947 \u0938\u094d\u092a\u0940\u0915\u0930 \u0915\u094b \u0915\u094b\u0908 \u0916\u0924\u0930\u093e \u0928\u0939\u0940\u0902\u0964",
    "\u092f\u0939 \u0938\u092c \u0938\u0902\u092d\u0935 \u0939\u0948 \u090f\u0915 \u091f\u0948\u092a \u0938\u0947: Optimize \u092b\u0940\u091a\u0930\u0964 \u091c\u092c \u092d\u0940 \u0906\u092a \u0928\u090f \u0939\u0947\u0921\u092b\u094b\u0928 \u092f\u093e \u0938\u094d\u092a\u0940\u0915\u0930 \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, Loud EQ \u0911\u091f\u094b-\u091f\u094d\u092f\u0942\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u091f\u094d\u0930\u093e\u092f\u0932-\u090f\u0902\u0921-\u090f\u0930\u0930 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u0914\u0930 \u0906\u092a\u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0935\u0948\u0938\u0940 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948 \u091c\u0948\u0938\u0940 \u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092a\u0930, \u0906\u092a\u0915\u094b \u092a\u0942\u0930\u093e +200% \u092c\u0942\u0938\u094d\u091f \u0914\u0930 \u0938\u093e\u0909\u0902\u0921 DNA \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u2014\u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092a\u0930\u094d\u0938\u0928\u0932\u093e\u0907\u091c\u093c\u094d\u0921\u0964",
    "\u0906\u091c \u0939\u0940 Loud EQ \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u090f\u0915 \u092c\u093e\u0930 Optimize \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u093f\u0924\u0928\u093e \u092c\u0926\u0932 \u0917\u092f\u093e \u0939\u0948\u0964 P.S. \u0905\u0917\u0930 \u0906\u092a\u0928\u0947 \u0905\u092c \u0924\u0915 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0928\u0939\u0940\u0902 \u0932\u093f\u092f\u093e, \u0924\u094b \u092f\u0939\u0940 \u0935\u094b \u092a\u0932 \u0939\u0948\u0964 100,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0938\u093e\u092b \u0938\u0941\u0928 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964"
  ],
