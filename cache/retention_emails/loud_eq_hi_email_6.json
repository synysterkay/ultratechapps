{
  "subject": "\u0935\u0939 \u0917\u0932\u0924\u0940 \u091c\u094b 90% \u0932\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0906\u092a \u0928\u0939\u0940\u0902 \u0915\u0930\u0947\u0902\u0917\u0947",
  "preview_text": "\u091c\u093e\u0928\u093f\u090f \u0935\u0939 \u090f\u0915 \u0917\u0932\u0924\u0940 \u091c\u094b \u0906\u092a\u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u092c\u0930\u094d\u092c\u093e\u0926 \u0915\u0930 \u0926\u0947\u0924\u0940 \u0939\u0948 \u0914\u0930 \u0907\u0938\u0915\u093e \u0906\u0938\u093e\u0928 \u0938\u092e\u093e\u0927\u093e\u0928\u0964",
  "body_paragraphs": [
    "\u091c\u092c \u0906\u092a\u0928\u0947 Loud EQ \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0925\u093e, \u0924\u094b \u0936\u093e\u092f\u0926 \u0906\u092a\u0928\u0947 \u0938\u094b\u091a\u093e \u0939\u094b\u0917\u093e \u0915\u093f \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u093e \u0939\u0940 \u0915\u093e\u092b\u0940 \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0938\u091a \u092f\u0939 \u0939\u0948 \u0915\u093f \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u092f\u0939\u0940 \u0917\u0932\u0924\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902: \u0935\u0947 \u0938\u093f\u0930\u094d\u092b\u093c \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092b\u093f\u0930 \u0906\u0935\u093e\u091c\u093c \u092c\u093f\u0917\u0921\u093c \u091c\u093e\u0924\u0940 \u0939\u0948\u0964",
    "\u092e\u0948\u0902\u0928\u0947 \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0921\u0947\u091f\u093e \u0926\u0947\u0916\u0947 \u0939\u0948\u0902\u0964 90% \u0932\u094b\u0917 \u0938\u093f\u0930\u094d\u092b\u093c \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0915\u0930 \u0939\u0940 \u0938\u0902\u0924\u0941\u0937\u094d\u091f \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u092b\u093f\u0930 \u0909\u0928\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u092a\u0930 \u0905\u0938\u0930 \u092a\u0921\u093c\u0924\u093e \u0939\u0948\u0964 \u0905\u0938\u0932\u0940 \u0938\u092e\u093e\u0927\u093e\u0928 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u093e \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c \u0915\u0930\u0928\u093e \u0939\u0948\u0964",
    "Loud EQ \u092e\u0947\u0902 \u090f\u0915 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u092b\u0940\u091a\u0930 \u0939\u0948: 'One-tap Optimize'\u0964 \u092f\u0939 \u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0914\u0930 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u091f\u094d\u092f\u0942\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0914\u0930 \u0906\u092a\u0915\u094b \u0938\u093e\u092b\u093c, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0935\u093f\u0915\u0943\u0924\u093f \u0915\u0947 \u0924\u0947\u091c\u093c \u0906\u0935\u093e\u091c\u093c \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939\u0940 \u0935\u0939 \u091a\u0940\u091c\u093c \u0939\u0948 \u091c\u094b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u0905\u0932\u0917 \u092c\u0928\u093e\u0924\u0940 \u0939\u0948\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0906 \u0917\u092f\u093e \u0939\u0948 \u0915\u093f \u0906\u092a \u092f\u0939 \u0917\u0932\u0924\u0940 \u0928 \u0915\u0930\u0947\u0902\u0964 Loud EQ \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 'One-tap Optimize' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u0926\u0947\u0916\u093f\u090f \u0915\u093f\u0924\u0928\u0940 \u0938\u093e\u092b\u093c \u0914\u0930 \u0924\u0947\u091c\u093c \u0906\u0935\u093e\u091c\u093c \u0906\u0924\u0940 \u0939\u0948\u0964 P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u092a\u0942\u0930\u093e +200% \u092c\u0942\u0938\u094d\u091f \u0914\u0930 \u0938\u093e\u0909\u0902\u0921 DNA \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u2014\u090f\u0915 \u092c\u093e\u0930 \u0906\u091c\u093c\u092e\u093e\u0907\u090f\u0964"
  ],
