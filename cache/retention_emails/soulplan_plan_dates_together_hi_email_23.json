{
  "subject": "\u0935\u094b 2AM \u0915\u093e \u092a\u0932 \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u092a\u0939\u0932\u0947 \u0939\u092e \u0930\u094b\u091c\u093c \u092a\u094d\u0932\u093e\u0928\u093f\u0902\u0917 \u092e\u0947\u0902 \u0925\u0915 \u091c\u093e\u0924\u0947 \u0925\u0947\u0964 \u0905\u092c \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0914\u0930 \u0930\u093e\u0924 \u0916\u093e\u0938 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092b\u0930\u094d\u0915 \u0926\u0947\u0916\u094b\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u094b \u0926\u093f\u0928 \u091c\u092c \u0924\u0941\u092e \u0926\u094b\u0928\u094b\u0902 \u0915\u094b \u0921\u0947\u091f \u0915\u093e \u0906\u0907\u0921\u093f\u092f\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0924\u093e \u0925\u093e? \u092c\u0938 \u0930\u0942\u091f\u0940\u0928 \u092e\u0947\u0902 \u092b\u0902\u0938 \u091c\u093e\u0924\u0947 \u0925\u0947\u0964 \u0938\u094b\u091a\u0924\u0947 \u0925\u0947, '\u091a\u0932\u094b \u0915\u0941\u091b \u0928\u092f\u093e \u0915\u0930\u0947\u0902' \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u0935\u0939\u0940 \u092a\u093f\u091c\u093c\u094d\u091c\u093c\u093e-\u092e\u0942\u0935\u0940 \u0915\u093e \u091a\u0915\u094d\u0915\u0930\u0964 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u094b \u0932\u0917\u0924\u093e \u0925\u093e \u0915\u093f \u0935\u094b \u0907\u0928\u0935\u093f\u091c\u093c\u093f\u092c\u0932 \u0939\u0948\u0964 \u0914\u0930 \u0924\u0941\u092e \u0925\u0915 \u091c\u093e\u0924\u0947 \u0925\u0947 \u092a\u094d\u0932\u093e\u0928\u093f\u0902\u0917 \u0938\u0947\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u0905\u092c? \u0924\u0941\u092e \u0906\u091c \u0930\u093e\u0924 \u0915\u094b \u0926\u0947\u0916\u094b\u0964 SoulPlan \u0916\u094b\u0932\u094b \u0914\u0930 \u0926\u0947\u0916\u094b Tonight's Date \u092b\u0940\u091a\u0930\u0964 \u090f\u0915 \u092e\u0942\u0921 \u091a\u0941\u0928\u094b \u2014 cozy, adventurous, playful, healing \u2014 \u0914\u0930 \u092c\u0938 30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u092a\u0942\u0930\u0940 \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u091c\u092c \u0926\u0947\u0916\u0924\u093e \u0939\u0948 \u0935\u094b 'thought of you tonight' \u0938\u094d\u0915\u094d\u0930\u0940\u0928, \u0924\u094b \u0909\u0938\u0947 \u0932\u0917\u0924\u093e \u0939\u0948 \u0924\u0941\u092e\u0928\u0947 \u0938\u091a \u092e\u0947\u0902 \u0938\u094b\u091a\u093e\u0964 \u0914\u0930 \u0935\u094b \u0938\u094d\u092a\u093e\u0930\u094d\u0915 \u091c\u094b \u0930\u0942\u091f\u0940\u0928 \u092e\u0947\u0902 \u092e\u0930 \u0930\u0939\u093e \u0925\u093e, \u0935\u093e\u092a\u0938 \u091c\u0932 \u0909\u0920\u0924\u093e \u0939\u0948\u0964",
    "\u092b\u0930\u094d\u0915 \u0907\u0924\u0928\u093e \u090f\u092e\u094d\u092c\u0930\u094d\u0930\u093e\u0938\u093f\u0902\u0917 \u0939\u0948 \u0915\u093f \u0939\u092e \u092a\u0939\u0932\u0947 \u092a\u0930 \u0935\u093e\u092a\u0938 \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u0924\u0947\u0964 \u0905\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092a\u093e\u0938 Memory Timeline \u0939\u0948 \u2014 \u0939\u0930 \u0921\u0947\u091f \u0915\u0940 \u092b\u094b\u091f\u094b \u0914\u0930 \u0928\u094b\u091f, \u092e\u0939\u0940\u0928\u094b\u0902 \u092c\u093e\u0926 \u092d\u0940\u0964 Streak Counter \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u092b\u094d\u0930\u0940\u091c\u093c \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b \u092c\u093f\u0928\u093e \u092e\u094b\u092e\u0947\u0902\u091f\u092e \u0916\u094b\u090f\u0964 \u0914\u0930 Anniversaries Jar \u0924\u094b \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u092d\u0942\u0932\u0928\u0947 \u0926\u0947\u0924\u093e\u0964 \u0906\u091c \u0930\u093e\u0924 \u0939\u0940 \u090f\u0915 \u092c\u093e\u0930 SoulPlan \u0916\u094b\u0932\u094b, \u0914\u0930 Tonight's Date \u092a\u0930 \u090f\u0915 \u092e\u0942\u0921 \u091f\u0948\u092a \u0915\u0930\u094b\u0964 \u0926\u0947\u0916\u094b \u0915\u093f\u0924\u0928\u093e \u0906\u0938\u093e\u0928 \u0939\u0948\u0964",
    "P.S. \u2014 \u091c\u094b \u0915\u092a\u0932\u094d\u0938 \u092a\u0939\u0932\u0947 24 \u0918\u0902\u091f\u0947 \u092e\u0947\u0902 Tonight's Date \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u094b \u0905\u0917\u0932\u0947 \u092e\u0939\u0940\u0928\u0947 \u092e\u0947\u0902 4 \u0917\u0941\u0928\u093e \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0921\u0947\u091f\u094d\u0938 \u092a\u094d\u0932\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e \u092d\u0940 \u0935\u094b \u0928\u0902\u092c\u0930 \u092c\u0928 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964"
  ],
