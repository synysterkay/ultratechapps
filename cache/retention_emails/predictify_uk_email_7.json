{
  "subject": "\u0422\u0432\u0456\u0439 \u043f\u0435\u0440\u0448\u0438\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0437 \u043f\u043e\u0445\u0438\u0431\u043a\u043e\u044e 3%",
  "preview_text": "\u041e\u0434\u0438\u043d \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f, \u044f\u043a\u0435 \u0437\u043c\u0456\u043d\u044e\u0454 \u0432\u0441\u0435. \u0423\u044f\u0432\u0438, \u0449\u043e \u0442\u0438 \u0431\u0430\u0447\u0438\u0448, \u044f\u043a AI \u043f\u043e\u043c\u0438\u043b\u044f\u0454\u0442\u044c\u0441\u044f \u2014 \u0456 \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u044f\u0454\u0448 \u0446\u0435 \u0437\u0430 10 \u0441\u0435\u043a\u0443\u043d\u0434.",
  "body_paragraphs": [
    "\u0423\u044f\u0432\u0438: \u0442\u0438 \u0434\u0438\u0432\u0438\u0448\u0441\u044f \u043d\u0430 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 AI \u0434\u043b\u044f \u043c\u0430\u0442\u0447\u0443 \u00ab\u0428\u0430\u0445\u0442\u0430\u0440\u00bb \u2014 \u00ab\u0414\u0438\u043d\u0430\u043c\u043e\u00bb. \u0412\u0456\u043d \u043a\u0430\u0436\u0435 2:1, \u0430\u043b\u0435 \u0442\u0438 \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454\u0448 \u2014 \u0449\u043e\u0441\u044c \u043d\u0435 \u0442\u0435. \u042f \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0432: 70% \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u0438\u0439\u043c\u0430\u044e\u0442\u044c \u0446\u0438\u0444\u0440\u0438 \u0437\u0430 \u0447\u0438\u0441\u0442\u0443 \u043c\u043e\u043d\u0435\u0442\u0443. \u0410\u043b\u0435 \u0454 \u043e\u0434\u0438\u043d \u0441\u0435\u043a\u0440\u0435\u0442, \u044f\u043a\u0438\u0439 \u043f\u0435\u0440\u0435\u0442\u0432\u043e\u0440\u044e\u0454 \u0437\u0432\u0438\u0447\u0430\u0439\u043d\u0438\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u043d\u0430 \u0437\u0431\u0440\u043e\u044e.",
    "\u042f \u043f\u043e\u043c\u0456\u0442\u0438\u0432 \u0446\u0435 \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u043e, \u043a\u043e\u043b\u0438 \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0432 \u0434\u0430\u043d\u0456 \u0437\u0430 \u043e\u0441\u0442\u0430\u043d\u043d\u0456 14 \u0434\u043d\u0456\u0432. \u0423 Predictify \u0454 \u0444\u0443\u043d\u043a\u0446\u0456\u044f, \u044f\u043a\u0443 \u043c\u0430\u0439\u0436\u0435 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454: \u00ab\u041a\u043e\u0435\u0444\u0456\u0446\u0456\u0454\u043d\u0442 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u043e\u0441\u0442\u0456\u00bb \u2014 \u0446\u0435 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0446\u0438\u0444\u0440\u0430. \u0426\u0435 \u0442\u0432\u0456\u0439 \u0448\u0430\u043d\u0441 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438, \u0434\u0435 AI \u0441\u0443\u043c\u043d\u0456\u0432\u0430\u0454\u0442\u044c\u0441\u044f. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0434\u043b\u044f \u043c\u0430\u0442\u0447\u0443 \u00ab\u0420\u0435\u0430\u043b\u00bb \u2014 \u00ab\u0411\u0430\u0440\u0441\u0435\u043b\u043e\u043d\u0430\u00bb \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456\u0441\u0442\u044c 59% \u043e\u0437\u043d\u0430\u0447\u0430\u0454, \u0449\u043e \u0454 41% \u0448\u0430\u043d\u0441\u0443 \u043d\u0430 \u0456\u043d\u0448\u0438\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0411\u0456\u043b\u044c\u0448\u0456\u0441\u0442\u044c \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u044e\u0442\u044c \u0446\u0435, \u0430\u043b\u0435 \u0442\u0438 \u0442\u0435\u043f\u0435\u0440 \u0437\u043d\u0430\u0454\u0448.",
    "\u041e\u0441\u044c \u044f\u043a \u0446\u0435 \u043f\u0440\u0430\u0446\u044e\u0454: \u0432\u0456\u0434\u043a\u0440\u0438\u0439 \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u043c\u0430\u0442\u0447 \u0443 \u0440\u043e\u0437\u0434\u0456\u043b\u0456 \u00ab\u041f\u0440\u043e\u0433\u043d\u043e\u0437\u0438\u00bb. \u041d\u0430\u0442\u0438\u0441\u043d\u0438 \u043d\u0430 \u00ab\u0414\u0435\u0442\u0430\u043b\u0456\u00bb \u2014 \u0442\u0430\u043c \u043f\u043e\u0431\u0430\u0447\u0438\u0448 \u043d\u0435 \u043b\u0438\u0448\u0435 \u0440\u0430\u0445\u0443\u043d\u043e\u043a, \u0430 \u0439 \u0440\u043e\u0437\u043f\u043e\u0434\u0456\u043b \u0456\u043c\u043e\u0432\u0456\u0440\u043d\u043e\u0441\u0442\u0435\u0439. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, AI \u043c\u043e\u0436\u0435 \u0434\u0430\u0432\u0430\u0442\u0438 45% \u043d\u0430 \u043d\u0456\u0447\u0438\u044e, 30% \u043d\u0430 \u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0443 \u0433\u043e\u0441\u043f\u043e\u0434\u0430\u0440\u0456\u0432. \u0426\u0435 \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u0442\u043e\u0431\u0456 \u043f\u0440\u0438\u0439\u043c\u0430\u0442\u0438 \u0440\u0456\u0448\u0435\u043d\u043d\u044f, \u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043b\u0456\u043f\u043e \u0432\u0456\u0440\u0438\u0442\u0438. \u0421\u043f\u0440\u043e\u0431\u0443\u0439 \u043f\u0440\u044f\u043c\u043e \u0437\u0430\u0440\u0430\u0437 \u2014 \u0456 \u043f\u043e\u0431\u0430\u0447\u0438\u0448, \u044f\u043a \u0442\u0432\u043e\u0457 \u0441\u0442\u0430\u0432\u043a\u0438 \u0441\u0442\u0430\u043d\u0443\u0442\u044c \u0442\u043e\u0447\u043d\u0456\u0448\u0438\u043c\u0438.",
    "\u0412\u0456\u0434\u043a\u0440\u0438\u0439 Predictify, \u0437\u043d\u0430\u0439\u0434\u0438 \u043c\u0430\u0442\u0447 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456\u0448\u043d\u044c\u043e\u0433\u043e \u0442\u0443\u0440\u0443 \u0456 \u043f\u0435\u0440\u0435\u0432\u0456\u0440 \u00ab\u041a\u043e\u0435\u0444\u0456\u0446\u0456\u0454\u043d\u0442 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u043e\u0441\u0442\u0456\u00bb. \u0426\u0435 \u0437\u0430\u0439\u043c\u0435 30 \u0441\u0435\u043a\u0443\u043d\u0434. P.S. \u0414\u043e \u0440\u0435\u0447\u0456, Premium-\u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456 \u0431\u0430\u0447\u0430\u0442\u044c \u0449\u0435 \u0439 \u0456\u0441\u0442\u043e\u0440\u0438\u0447\u043d\u0443 \u0442\u043e\u0447\u043d\u0456\u0441\u0442\u044c AI \u0434\u043b\u044f \u043a\u043e\u0436\u043d\u043e\u0457 \u043b\u0456\u0433\u0438 \u2014 \u0446\u0435 \u044f\u043a \u043c\u0430\u0442\u0438 \u043e\u0441\u043e\u0431\u0438\u0441\u0442\u043e\u0433\u043e \u0430\u043d\u0430\u043b\u0456\u0442\u0438\u043a\u0430 \u0432 \u043a\u0438\u0448\u0435\u043d\u0456."
  ],
