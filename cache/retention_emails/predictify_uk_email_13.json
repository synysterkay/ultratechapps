{
  "subject": "\u0422\u0438 \u0442\u0443\u0442 \u0443\u0436\u0435 \u043c\u0456\u0441\u044f\u0446\u044c \u2013 \u043e\u0441\u044c \u0449\u043e \u043c\u0438 \u0437\u043d\u0430\u0439\u0448\u043b\u0438",
  "preview_text": "\u0422\u0432\u043e\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u0437\u0430 \u0446\u0435\u0439 \u0447\u0430\u0441 \u0432\u0440\u0430\u0436\u0430\u0454. \u0410\u043b\u0435 \u0454 \u043e\u0434\u043d\u0430 \u0440\u0456\u0447, \u044f\u043a\u0443 \u0442\u0438 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u0454\u0448. \u0412\u0456\u0434\u043a\u0440\u0438\u0439, \u0449\u043e\u0431 \u0434\u0456\u0437\u043d\u0430\u0442\u0438\u0441\u044f.",
  "body_paragraphs": [
    "\u041f\u0430\u043c\u2019\u044f\u0442\u0430\u0454\u0448 \u0442\u043e\u0439 \u0434\u0435\u043d\u044c, \u043a\u043e\u043b\u0438 \u0442\u0438 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0432 Predictify? \u041f\u0440\u043e\u0439\u0448\u043e\u0432 \u043c\u0430\u0439\u0436\u0435 \u043c\u0456\u0441\u044f\u0446\u044c, \u0456 \u044f \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0432 \u0442\u0432\u043e\u044e \u0430\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c. \u0417\u043d\u0430\u0454\u0448 \u0449\u043e? \u0422\u0438 \u0437\u0440\u043e\u0431\u0438\u0432 \u0431\u0456\u043b\u044c\u0448\u0435 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0456\u0432, \u043d\u0456\u0436 80% \u043d\u043e\u0432\u0438\u0445 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432. \u0410\u043b\u0435 \u043e\u0441\u044c \u0443 \u0447\u043e\u043c\u0443 \u0441\u0435\u043a\u0440\u0435\u0442: \u0431\u0456\u043b\u044c\u0448\u0456\u0441\u0442\u044c \u0437\u0443\u043f\u0438\u043d\u044f\u0454\u0442\u044c\u0441\u044f \u0441\u0430\u043c\u0435 \u0437\u0430\u0440\u0430\u0437, \u043a\u043e\u043b\u0438 AI \u043f\u043e\u0447\u0438\u043d\u0430\u0454 \u0434\u0430\u0432\u0430\u0442\u0438 \u043d\u0430\u0439\u0442\u043e\u0447\u043d\u0456\u0448\u0456 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0438. \u041d\u0435 \u0431\u0443\u0434\u044c \u043e\u0434\u043d\u0438\u043c \u0456\u0437 \u043d\u0438\u0445.",
    "\u0417\u0430 \u0446\u0435\u0439 \u0447\u0430\u0441 \u0442\u0438 \u0432\u0436\u0435 \u043f\u043e\u0431\u0430\u0447\u0438\u0432, \u044f\u043a \u0434\u0430\u043d\u0456 \u0431\u2019\u044e\u0442\u044c \u0456\u043d\u0442\u0443\u0457\u0446\u0456\u044e. \u0410\u043b\u0435 \u0454 \u043e\u0434\u043d\u0430 \u0444\u0443\u043d\u043a\u0446\u0456\u044f, \u044f\u043a\u0443 90% \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u044e\u0442\u044c, \u0456 \u0432\u043e\u043d\u0430 \u043c\u043e\u0436\u0435 \u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u0442\u0432\u043e\u044e \u0433\u0440\u0443 \u2013 AI Chat. \u0423\u044f\u0432\u0438: \u0442\u0438 \u043f\u0438\u0442\u0430\u0454\u0448, \u0447\u0438 \u0432\u0430\u0440\u0442\u043e \u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u043d\u0430 \u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0443 \u00ab\u0411\u0430\u0432\u0430\u0440\u0456\u0457\u00bb \u0437 \u0444\u043e\u0440\u043e\u044e, \u0456 \u043e\u0442\u0440\u0438\u043c\u0443\u0454\u0448 \u043c\u0438\u0442\u0442\u0454\u0432\u0443 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c \u0456\u0437 \u0440\u043e\u0437\u0431\u043e\u0440\u043e\u043c xG, \u0442\u0440\u0430\u0432\u043c \u0442\u0430 \u0456\u0441\u0442\u043e\u0440\u0456\u0457 \u043e\u0441\u043e\u0431\u0438\u0441\u0442\u0438\u0445 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0435\u0439. \u0426\u0435 \u044f\u043a \u043c\u0430\u0442\u0438 \u0430\u043d\u0430\u043b\u0456\u0442\u0438\u043a\u0430 \u0432 \u043a\u0438\u0448\u0435\u043d\u0456.",
    "\u041e\u0441\u044c \u0449\u043e \u044f \u043f\u0440\u043e\u043f\u043e\u043d\u0443\u044e: \u0432\u0456\u0434\u043a\u0440\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a, \u0437\u043d\u0430\u0439\u0434\u0438 \u0432\u043a\u043b\u0430\u0434\u043a\u0443 \u00abAI Chat\u00bb \u0456 \u043f\u043e\u0441\u0442\u0430\u0432 \u0439\u043e\u043c\u0443 \u043e\u0434\u043d\u0435 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u043f\u0440\u043e \u043c\u0430\u0442\u0447, \u044f\u043a\u0438\u0439 \u0442\u0435\u0431\u0435 \u0446\u0456\u043a\u0430\u0432\u0438\u0442\u044c. \u041f\u043e\u0434\u0438\u0432\u0438\u0441\u044c, \u043d\u0430\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0433\u043b\u0438\u0431\u043e\u043a\u043e \u0432\u0456\u043d \u043a\u043e\u043f\u0430\u0454. \u0414\u043e \u0440\u0435\u0447\u0456, \u044f\u043a\u0449\u043e \u0445\u043e\u0447\u0435\u0448 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0432\u0441\u0456\u0445 \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0456\u0439 \u2013 \u0441\u043f\u0440\u043e\u0431\u0443\u0439 Premium. \u0423\u0441\u044c\u043e\u0433\u043e $12.99 \u043d\u0430 \u043c\u0456\u0441\u044f\u0446\u044c, \u0456 \u043f\u0435\u0440\u0448\u0456 3 \u0434\u043d\u0456 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u043e. \u0410\u043b\u0435 \u043d\u0430\u0432\u0456\u0442\u044c \u0431\u0435\u0437 \u043d\u044c\u043e\u0433\u043e AI Chat \u2013 \u0442\u0432\u0456\u0439 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0439 \u0434\u0440\u0443\u0433.",
    "\u0417\u0440\u043e\u0431\u0438 \u0446\u0435 \u0437\u0430\u0440\u0430\u0437: \u043d\u0430\u043f\u0438\u0448\u0438 \u0432 AI Chat \u00ab\u0427\u0438 \u0432\u0430\u0440\u0442\u043e \u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u043d\u0430 \u0442\u043e\u0442\u0430\u043b \u0431\u0456\u043b\u044c\u0448\u0435 2.5 \u0432 \u043c\u0430\u0442\u0447\u0456 \u041b\u0456\u0432\u0435\u0440\u043f\u0443\u043b\u044c \u2013 \u0421\u0456\u0442\u0456?\u00bb \u0456 \u043f\u043e\u0434\u0438\u0432\u0438\u0441\u044c, \u0449\u043e \u0432\u0456\u043d \u0432\u0438\u0434\u0430\u0441\u0442\u044c. P.S. \u0414\u043e \u0440\u0435\u0447\u0456, \u0442\u0432\u0456\u0439 \u0441\u0442\u0440\u0456\u043a \u0443\u0436\u0435 12 \u0434\u043d\u0456\u0432 \u2013 \u043d\u0435 \u0437\u043b\u0430\u043c\u0430\u0439 \u0439\u043e\u0433\u043e \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456. \u041e\u0434\u0438\u043d \u043f\u0440\u043e\u043f\u0443\u0441\u043a, \u0456 \u0432\u0441\u0456 \u0431\u0435\u0439\u0434\u0436\u0456 \u0437\u0433\u043e\u0440\u044f\u0442\u044c."
  ],
