{
  "subject": "\u5766\u767d\uff1a90%\u7528\u6237\u90fd\u5ffd\u7565\u4e86\u8fd9\u4e2a\u81f4\u547d\u9519\u8bef",
  "preview_text": "\u6bcf\u5929\u82b13\u5206\u949f\u505a\u8fd9\u4ef6\u4e8b\uff0c\u80fd\u8ba9\u4f60\u7684\u624b\u673a\u97f3\u91cf\u6548\u679c\u63d0\u534710\u500d\u3002\u522b\u518d\u6d6a\u8d39\u8fd9\u4e2a\u5e94\u7528\u4e86\u3002",
  "body_paragraphs": [
    "\u6211\u6709\u4e2a\u670b\u53cb\uff0c\u548c\u4f60\u4e00\u6837\u7231\u7528\u6211\u4eec\u7684\u97f3\u91cf\u589e\u5f3a\u5668\u3002\u4f46\u4ed6\u4e00\u76f4\u62b1\u6028\u6548\u679c\u4e0d\u7a33\u5b9a\uff0c\u6709\u65f6\u9707\u64bc\u6709\u65f6\u5e73\u6de1\u3002\u76f4\u5230\u4e0a\u5468\u6211\u53bb\u4ed6\u5bb6\uff0c\u624d\u53d1\u73b0\u95ee\u9898\u6839\u672c\u4e0d\u5728\u5e94\u7528\uff0c\u800c\u5728\u4ed6\u81ea\u5df1\u3002\u4ed6\u72af\u4e86\u4e00\u4e2a\u51e0\u4e4e\u6240\u6709\u4eba\u90fd\u4f1a\u72af\u7684\u3001\u8ba9\u5e94\u7528\u6548\u679c\u5927\u6253\u6298\u6263\u7684\u9519\u3002",
    "\u79d8\u5bc6\u5728\u4e8e\u4e00\u4e2a3\u5206\u949f\u7684\u2018\u58f0\u97f3\u6821\u51c6\u4eea\u5f0f\u2019\u3002\u4e0d\u662f\u8bbe\u7f6e\u5b8c\u5c31\u4e22\u4e00\u8fb9\uff0c\u800c\u662f\u50cf\u5065\u8eab\u524d\u7684\u70ed\u8eab\u3002\u6bcf\u5929\u542c\u6b4c\u524d\uff0c\u82b13\u5206\u949f\uff1a1\uff09\u6253\u5f00\u5e94\u7528\uff0c\u9009\u4f60\u5e38\u542c\u7684\u97f3\u4e50\u7c7b\u578b\u9884\u8bbe\uff1b2\uff09\u64ad\u653e\u4f60\u6700\u7231\u7684\u90a3\u9996\u6b4c\u524d30\u79d2\uff1b3\uff09\u6839\u636e\u5f53\u4e0b\u73af\u5883\u5fae\u8c03\u5747\u8861\u5668\u4e2d\u95f4\u4e24\u4e2a\u9891\u6bb5\u3002\u5c31\u8fd9\u4e48\u7b80\u5355\u3002\u575a\u6301\u4e00\u5468\uff0c\u4f60\u7684\u8033\u6735\u4f1a\u8bb0\u4f4f\u2018\u6700\u4f73\u72b6\u6001\u2019\uff0c\u5e94\u7528\u4f1a\u4ece\u5de5\u5177\u53d8\u6210\u4f60\u542c\u89c9\u7684\u4e00\u90e8\u5206\u3002",
    "\u8fd9\u5176\u5b9e\u5c31\u662f\u5185\u7f6e\u5747\u8861\u5668\u7684\u6b63\u786e\u6253\u5f00\u65b9\u5f0f\u3002\u5b83\u4e0d\u662f\u2018\u8bbe\u7f6e\u4e00\u6b21\uff0c\u6c38\u4e45\u6709\u6548\u2019\u7684\u9b54\u6cd5\u5f00\u5173\uff0c\u800c\u662f\u9700\u8981\u6839\u636e\u4f60\u7684\u8bbe\u5907\u8001\u5316\u3001\u8033\u673a\u635f\u8017\u3001\u751a\u81f3\u5f53\u5929\u73af\u5883\u6e7f\u5ea6\uff08\u771f\u7684\uff09\u8fdb\u884c\u5fae\u8c03\u7684\u97f3\u4e50\u4f19\u4f34\u3002\u90a3\u4e9b\u89c9\u5f97\u2018\u6548\u679c\u53d8\u5dee\u2019\u7684\u7528\u6237\uff0c99%\u53ea\u662f\u5fd8\u4e86\u548c\u8fd9\u4e2a\u529f\u80fd\u4fdd\u6301\u2018\u5bf9\u8bdd\u2019\u3002",
    "\u4eca\u5929\u542c\u6b4c\u524d\uff0c\u7ed9\u81ea\u5df13\u5206\u949f\u3002\u6253\u5f00\u5e94\u7528\uff0c\u522b\u6025\u7740\u64ad\u6b4c\uff0c\u5148\u9009\u2018\u6447\u6eda\u2019\u6216\u2018\u7535\u5b50\u2019\u9884\u8bbe\uff0c\u7136\u540e\u624b\u52a8\u628a800Hz\u548c2.5kHz\u4e24\u4e2a\u6ed1\u5757\u7a0d\u5fae\u5f80\u4e0a\u63a8\u4e00\u70b9\u2014\u2014\u8fd9\u662f\u5927\u591a\u6570\u624b\u673a\u626c\u58f0\u5668\u7684\u751c\u871c\u70b9\u3002\u505a\u5b8c\u8fd9\u4e2a\uff0c\u518d\u53bb\u542c\u4f60\u4eca\u5929\u7684\u64ad\u653e\u5217\u8868\u3002\u4f60\u4f1a\u56de\u6765\u8c22\u6211\u7684\u3002P.S. \u575a\u63017\u5929\u8fd9\u4e2a\u4eea\u5f0f\u7684\u9ad8\u7ea7\u7528\u6237\u544a\u8bc9\u6211\uff0c\u4ed6\u4eec\u518d\u4e5f\u56de\u4e0d\u53bb\u4e86\uff0c\u751a\u81f3\u4e3a\u6b64\u5f00\u4e86\u6708\u5ea6\u8ba2\u9605\u2014\u2014\u56e0\u4e3a\u6bcf\u5929\u8fd93\u5206\u949f\uff0c\u8ba9\u4ed6\u4eec\u7684\u65e7\u624b\u673a\u542c\u8d77\u6765\u8d35\u4e86\u4e94\u5343\u5757\u3002",
    "\u73b0\u5728\u5c31\u53bb\u5b8c\u6210\u4eca\u5929\u76843\u5206\u949f\u58f0\u97f3\u6821\u51c6"
  ],
