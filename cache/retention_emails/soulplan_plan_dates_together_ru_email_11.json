{
  "subject": "\u041c\u0438\u0444, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u0435\u0442 \u0432\u0430\u0448\u0438 \u0432\u0435\u0447\u0435\u0440\u0430",
  "preview_text": "\u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043f\u0430\u0440 \u0432\u0435\u0440\u044f\u0442 \u0432 \u044d\u0442\u043e. \u041d\u043e \u043f\u0440\u0430\u0432\u0434\u0430 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u043e\u0441\u0442\u044c \u2014 \u043d\u0435 \u0442\u043e, \u0447\u0442\u043e \u0432\u044b \u0434\u0443\u043c\u0430\u0435\u0442\u0435.",
  "body_paragraphs": [
    "\u0412\u0441\u0435 \u0434\u0443\u043c\u0430\u044e\u0442, \u0447\u0442\u043e \u043b\u0443\u0447\u0448\u0438\u0435 \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u044f \u2014 \u044d\u0442\u043e \u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u043e\u0441\u0442\u044c. \u0412\u0441\u043f\u044b\u0448\u043a\u0430 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u0435\u043d\u0438\u044f, \u0432\u043d\u0435\u0437\u0430\u043f\u043d\u044b\u0439 \u043f\u043e\u0440\u044b\u0432, \u0438 \u0432\u043e\u0442 \u0432\u044b \u0443\u0436\u0435 \u0442\u0430\u043d\u0446\u0443\u0435\u0442\u0435 \u043f\u043e\u0434 \u043b\u0443\u043d\u043e\u0439. \u041d\u043e \u043f\u0440\u0430\u0432\u0434\u0430 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e 80% \u0442\u0430\u043a\u0438\u0445 \u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u044b\u0445 \u0432\u0435\u0447\u0435\u0440\u043e\u0432 \u0437\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0432\u044b\u0431\u043e\u0440\u043e\u043c \u0441\u043a\u0443\u0447\u043d\u043e\u0433\u043e \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430 \u0438\u043b\u0438 \u043f\u0438\u0446\u0446\u0435\u0439 \u043d\u0430 \u0434\u0438\u0432\u0430\u043d\u0435. \u041d\u0435 \u043f\u043e\u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u0432\u044b \u043d\u0435 \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u0447\u043d\u044b, \u0430 \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u043e\u0441\u0442\u044c \u2014 \u044d\u0442\u043e \u0441\u0442\u0440\u0435\u0441\u0441, \u0430 \u0441\u0442\u0440\u0435\u0441\u0441 \u0443\u0431\u0438\u0432\u0430\u0435\u0442 \u0438\u0441\u043a\u0440\u0443.",
    "\u0412\u043e\u0442 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e: \u043f\u0430\u0440\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u044e\u0442 \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u044f \u0445\u043e\u0442\u044f \u0431\u044b \u0437\u0430 \u0447\u0430\u0441, \u0432 4 \u0440\u0430\u0437\u0430 \u0447\u0430\u0449\u0435 \u0433\u043e\u0432\u043e\u0440\u044f\u0442, \u0447\u0442\u043e \u0432\u0435\u0447\u0435\u0440 \u0431\u044b\u043b \u0432\u043e\u043b\u0448\u0435\u0431\u043d\u044b\u043c. \u0414\u0435\u043b\u043e \u043d\u0435 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u0443\u0431\u0438\u0442\u044c \u0441\u044e\u0440\u043f\u0440\u0438\u0437, \u0430 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u0443\u0431\u0440\u0430\u0442\u044c \u0442\u0440\u0435\u0432\u043e\u0433\u0443. \u041a\u043e\u0433\u0434\u0430 \u0432\u044b \u0437\u043d\u0430\u0435\u0442\u0435, \u0447\u0442\u043e \u0432\u0430\u0441 \u0436\u0434\u0435\u0442, \u0432\u044b \u0440\u0430\u0441\u0441\u043b\u0430\u0431\u043b\u044f\u0435\u0442\u0435\u0441\u044c \u0438 \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0430\u0435\u0442\u0435\u0441\u044c \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c. \u0410 \u0440\u0430\u0441\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u0438\u0435 \u2014 \u044d\u0442\u043e \u0438 \u0435\u0441\u0442\u044c \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u043a\u0430.",
    "\u0418\u043c\u0435\u043d\u043d\u043e \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0432 SoulPlan \u0435\u0441\u0442\u044c \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u00ab\u0421\u0432\u0438\u0434\u0430\u043d\u0438\u0435 \u043d\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u00bb. \u0412\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435: \u0443\u044e\u0442\u043d\u043e\u0435, \u0438\u0433\u0440\u0438\u0432\u043e\u0435, \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u0438\u0441\u0446\u0435\u043b\u044f\u044e\u0449\u0435\u0435 \u2014 \u0438 \u0447\u0435\u0440\u0435\u0437 30 \u0441\u0435\u043a\u0443\u043d\u0434 \u0443 \u0432\u0430\u0441 \u0433\u043e\u0442\u043e\u0432 \u043f\u043b\u0430\u043d. \u041d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0433\u0430\u0434\u0430\u043d\u0438\u044f, \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0441\u0442\u0440\u0435\u0441\u0441\u0430. \u0422\u043e\u043b\u044c\u043a\u043e \u0432\u044b \u0438 \u0432\u0430\u0448 \u043f\u0430\u0440\u0442\u043d\u0435\u0440, \u0443\u0436\u0435 \u0431\u0435\u0437 \u043b\u0438\u0448\u043d\u0435\u0439 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0439 \u0431\u043e\u043b\u0438.",
    "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u00ab\u0421\u0432\u0438\u0434\u0430\u043d\u0438\u0435 \u043d\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u00bb. \u041f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u0430\u043c \u0441\u0435\u0439\u0447\u0430\u0441 \u043d\u0443\u0436\u043d\u043e. P.S. \u0427\u0435\u0440\u0435\u0437 2 \u043d\u0435\u0434\u0435\u043b\u0438 \u0432\u044b \u043f\u043e\u0439\u043c\u0435\u0442\u0435, \u0447\u0442\u043e \u043b\u0443\u0447\u0448\u0438\u0435 \u0441\u044e\u0440\u043f\u0440\u0438\u0437\u044b \u2014 \u044d\u0442\u043e \u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b \u0441\u0430\u043c\u0438 \u0432\u044b\u0431\u0440\u0430\u043b\u0438."
  ],
