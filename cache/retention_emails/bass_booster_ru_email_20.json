{
  "subject": "\u0422\u0432\u043e\u0439 45-\u0439 \u0434\u0435\u043d\u044c \u0441 \u043d\u0430\u043c\u0438",
  "preview_text": "\u0422\u044b \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043d\u043e\u0432\u0438\u0447\u043e\u043a. \u0412\u043e\u0442 \u0447\u0442\u043e \u0436\u0434\u0435\u0442 \u0442\u0435\u0431\u044f \u0434\u0430\u043b\u044c\u0448\u0435 \u0432 Bass Booster.",
  "body_paragraphs": [
    "45 \u0434\u043d\u0435\u0439 \u043d\u0430\u0437\u0430\u0434 \u0442\u044b \u0441\u043a\u0430\u0447\u0430\u043b Bass Booster \u0438 \u0432\u0440\u0443\u0431\u0438\u043b \u0442\u0440\u0435\u043a. \u041f\u043e\u043c\u043d\u0438\u0448\u044c \u0442\u043e\u0442 \u043f\u0435\u0440\u0432\u044b\u0439 \u0440\u0430\u0437, \u043a\u043e\u0433\u0434\u0430 \u0431\u0430\u0441 \u0443\u0434\u0430\u0440\u0438\u043b \u0442\u0430\u043a, \u0447\u0442\u043e \u043c\u0443\u0440\u0430\u0448\u043a\u0438 \u043f\u043e\u0448\u043b\u0438? \u0421 \u0442\u0435\u0445 \u043f\u043e\u0440 \u0442\u044b \u0443\u0436\u0435 \u043d\u0435 \u0442\u043e\u0442 \u0441\u043b\u0443\u0448\u0430\u0442\u0435\u043b\u044c \u2014 \u0442\u044b \u0437\u043d\u0430\u0435\u0448\u044c, \u043a\u0430\u043a \u0432\u044b\u0436\u0430\u0442\u044c \u0438\u0437 \u043a\u043e\u043b\u043e\u043d\u043e\u043a \u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u043e\u0432 \u0432\u0441\u0451. \u041d\u043e \u0438\u0433\u0440\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f.",
    "\u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u043d\u0430 \u0431\u0430\u0437\u043e\u0432\u043e\u043c \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0438. \u0422\u044b \u0436\u0435 \u043f\u0440\u043e\u0448\u0435\u043b \u044d\u0442\u043e\u0442 \u044d\u0442\u0430\u043f. \u0422\u0435\u043f\u0435\u0440\u044c \u0432\u0440\u0435\u043c\u044f \u043f\u0435\u0440\u0435\u0439\u0442\u0438 \u043d\u0430 \u043d\u043e\u0432\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u2014 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u044c \u0431\u044b\u0442\u044c \u043e\u0431\u044b\u0447\u043d\u044b\u043c \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c \u0438 \u0441\u0442\u0430\u0442\u044c \u0442\u0435\u043c, \u043a\u0442\u043e \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0437\u0432\u0443\u043a\u043e\u043c. \u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044c: \u043a\u0430\u0436\u0434\u044b\u0439 \u0442\u0440\u0435\u043a \u0437\u0432\u0443\u0447\u0438\u0442 \u0442\u0430\u043a, \u043a\u0430\u043a \u0437\u0430\u0434\u0443\u043c\u0430\u043b \u0438\u0441\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c, \u043d\u043e \u0441 \u0442\u0432\u043e\u0435\u0439 \u043b\u0438\u0447\u043d\u043e\u0439 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u043e\u0439.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 10-\u043f\u043e\u043b\u043e\u0441\u043d\u044b\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u0438 \u0441\u043e\u0437\u0434\u0430\u0439 \u0441\u0432\u043e\u0439 \u043f\u0440\u043e\u0444\u0438\u043b\u044c. \u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u043b\u0437\u0443\u043d\u043a\u0438 \u2014 \u044d\u0442\u043e \u0442\u0432\u043e\u0439 \u043f\u0443\u043b\u044c\u0442 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f. \u041f\u043e\u0434\u043d\u0438\u043c\u0438 \u043d\u0438\u0437\u043a\u0438\u0435 \u0447\u0430\u0441\u0442\u043e\u0442\u044b \u0434\u043b\u044f \u0445\u0438\u043f-\u0445\u043e\u043f\u0430, \u0434\u043e\u0431\u0430\u0432\u044c \u0432\u043e\u0437\u0434\u0443\u0445 \u0434\u043b\u044f EDM \u0438\u043b\u0438 \u0441\u0434\u0435\u043b\u0430\u0439 \u0440\u043e\u043a \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u044b\u043c. Bass Booster \u0442\u0435\u043f\u0435\u0440\u044c \u0437\u043d\u0430\u0435\u0442 \u0442\u0432\u043e\u0438 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0435\u043d\u0438\u044f. \u041d\u0430\u0447\u043d\u0438 \u0441 \u043f\u0440\u0435\u0441\u0435\u0442\u0430 '\u041c\u0443\u0437\u044b\u043a\u0430', \u0430 \u043f\u043e\u0442\u043e\u043c \u043f\u043e\u0434\u043a\u0440\u0443\u0442\u0438 \u043f\u043e\u0434 \u0441\u0435\u0431\u044f.",
    "\u041d\u0430\u0436\u043c\u0438 '\u041e\u0442\u043a\u0440\u044b\u0442\u044c Bass Booster' \u0438 \u0432\u043a\u043b\u044e\u0447\u0438 \u0442\u0440\u0435\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0442\u0435\u0431\u044f \u0437\u0430\u0436\u0438\u0433\u0430\u0435\u0442. \u0421\u0434\u0435\u043b\u0430\u0439 \u044d\u0442\u043e \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. P.S. \u0422\u044b \u0443\u0436\u0435 \u043f\u0440\u043e\u0448\u0435\u043b \u043f\u0443\u0442\u044c \u043e\u0442 \u043d\u043e\u0432\u0438\u0447\u043a\u0430 \u0434\u043e \u0437\u043d\u0430\u0442\u043e\u043a\u0430 \u2014 \u043f\u043e\u0440\u0430 \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u0442\u044c Premium, \u0433\u0434\u0435 \u043d\u0435\u0442 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0439 \u043f\u043e \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u044e \u0438 \u043f\u043e\u043b\u043d\u044b\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440. \u0421\u0434\u0435\u043b\u0430\u0439 \u0441\u0432\u043e\u0439 \u0437\u0432\u0443\u043a \u043b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u043c."
  ],
