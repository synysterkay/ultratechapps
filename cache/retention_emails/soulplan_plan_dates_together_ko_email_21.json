{
  "subject": "48\uc77c\ub9cc\uc5d0 \ub2ec\ub77c\uc9c4 3\uac00\uc9c0",
  "preview_text": "\ub2f9\uc2e0\uc774 \uc5c6\ub294 \uc0ac\uc774\uc5d0 \uc571\uc774 \uc870\uc6a9\ud788 \uc5c5\ub370\uc774\ud2b8\ub410\uc2b5\ub2c8\ub2e4. \ub193\uce5c \uae30\ub2a5\uc744 \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "48\uc77c \uc804\uc5d0 \ub9c8\uc9c0\ub9c9\uc73c\ub85c \uc571\uc744 \uc5f4\uc5c8\uc744 \ub54c, \ub2f9\uc2e0\uacfc \ud30c\ud2b8\ub108\ub294 \uc5b4\ub5a4 \ub0a0\uc744 \uacc4\ud68d\ud558\uace0 \uc788\uc5c8\ub098\uc694? \uadf8\ub54c \uc0dd\uac01\ud588\ub358 \uac83\ubcf4\ub2e4 \uc2dc\uac04\uc740 \ube60\ub974\uac8c \uc9c0\ub098\uac14\uc744 \uac70\uc608\uc694. \uadf8\ub7f0\ub370 \ub9d0\uc774\uc8e0, \ub2f9\uc2e0\uc774 \uc5c6\ub294 \ub3d9\uc548 \uc571 \uc548\uc5d0\uc11c \ubb34\uc5b8\uac00 \uc870\uc6a9\ud788 \ubc14\ub00c\uc5c8\uc2b5\ub2c8\ub2e4.",
    "\uc0ac\uc2e4 \uc6b0\ub9ac\ub294 \ub2f9\uc2e0\uc5d0\uac8c '\uc544\uc9c1 \ub108\ub97c \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4' \uac19\uc740 \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0b4\uace0 \uc2f6\uc9c0 \uc54a\uc558\uc5b4\uc694. \ub300\uc2e0, \ub2f9\uc2e0\uc774 \uc571\uc744 \uc5f4\uc5c8\uc744 \ub54c '\uc5b4? \uc774\uac74 \ucc98\uc74c \ubcf4\ub294\ub370?'\ub77c\ub294 \ubc18\uc751\uc744 \uc6d0\ud588\uc8e0. \uadf8\ub798\uc11c \uc9c0\ub09c 48\uc77c \ub3d9\uc548, \ud30c\ud2b8\ub108\uac00 \ub2f9\uc2e0\uc744 \uc704\ud574 \uc800\uc7a5\ud55c \uc704\uc2dc\ub9ac\uc2a4\ud2b8\uc5d0\uc11c AI\uac00 \uc9c1\uc811 \uace0\ub978 \uae5c\uc9dd \ub370\uc774\ud2b8 \uce74\ub4dc\uac00 \ub098\ud0c0\ub098\uae30 \uc2dc\uc791\ud588\uc2b5\ub2c8\ub2e4. \uc774 \uce74\ub4dc\ub294 \ub2f9\uc2e0\uc774 \uc571\uc744 \uc5f4\uba74 \uac00\uc7a5 \uba3c\uc800 \ubcf4\uc774\ub294 Tonight's Date \uc601\uc5ed\uc5d0 \uc790\ub9ac \uc7a1\uace0 \uc788\uc5b4\uc694. \uc544\ubb34\ub3c4 \ubcf4\uc9c0 \ubabb\ud55c \uc791\uc740 \ubc18\uc804\uc774\uc5d0\uc694.",
    "\uc774 \uae30\ub2a5\uc740 \ub2e8\uc21c\ud55c \ub370\uc774\ud2b8 \uc81c\uc548\uc774 \uc544\ub2d9\ub2c8\ub2e4. \ud30c\ud2b8\ub108\uac00 \ub2f9\uc2e0\uc744 \uc704\ud574 \uace0\ub978 \uc704\uc2dc\ub9ac\uc2a4\ud2b8\uc5d0\uc11c AI\uac00 \uadf8\ub0a0\uc758 \ubd84\uc704\uae30\uc640 \uc2dc\uac04\uc5d0 \ub9de\ub294 \ud558\ub098\uc758 \uce74\ub4dc\ub97c \uc120\ud0dd\ud574 \ubcf4\uc5ec\uc918\uc694. 'cozy'\ub098 'playful' \uac19\uc740 \uac10\uc815 \ud558\ub098\ub9cc \uc120\ud0dd\ud558\uba74 30\ucd08 \uc548\uc5d0 \uc624\ub298 \ubc24\uc774 \uc644\uc131\ub429\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \uba54\ubaa8\ub9ac \ud0c0\uc784\ub77c\uc778\uc5d0\ub3c4 \uc790\ub3d9\uc73c\ub85c \uae30\ub85d\ub418\uace0, \ud30c\ud2b8\ub108\ub294 '\uc624\ub298 \ubc24 \ub108\ub97c \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \ud480\uc2a4\ud06c\ub9b0 \uc21c\uac04\uc744 \ubc1b\uac8c \ub3fc\uc694. \uacc4\ud68d\uc758 \ud53c\ub85c\ub294 \uc5c6\uace0, \uc11c\ub85c\ub97c \ud5a5\ud55c \ubc30\ub824\ub9cc \ub0a8\uc2b5\ub2c8\ub2e4.",
    "\uc571\uc744 \uc5f4\uace0 Tonight's Date\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694. \ud30c\ud2b8\ub108\uac00 \ub2f9\uc2e0\uc744 \uc704\ud574 \uc900\ube44\ud55c \uae5c\uc9dd \uce74\ub4dc\uac00 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694. P.S. \uc774 \uae30\ub2a5\uc744 \ubcf8 \ucee4\ud50c\ub4e4\uc740 \uccab 24\uc2dc\uac04 \uc548\uc5d0 \ub370\uc774\ud2b8\ub97c \uacc4\ud68d\ud560 \ud655\ub960\uc774 4\ubc30 \ub192\uc544\uc9c4\ub2e4\ub294 \uc0ac\uc2e4, \uc54c\uace0 \uacc4\uc168\ub098\uc694?"
  ],
