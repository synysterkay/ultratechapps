    "\u3067\u3082\u5b89\u5fc3\u3057\u3066\u3002\u3053\u306e\u6a5f\u80fd\u306f\u3082\u3046\u3042\u306a\u305f\u306e\u30a2\u30d7\u30ea\u306e\u4e2d\u306b\u3042\u308b\u3002\u5404\u8a66\u5408\u306e\u4e88\u6e2c\u753b\u9762\u3092\u958b\u3051\u3070\u3001\u5927\u304d\u304f\u8868\u793a\u3055\u308c\u305f\u4fe1\u983c\u5ea6\u30b9\u30b3\u30a2\u304c\u3059\u3050\u76ee\u306b\u5165\u308b\u3002\u4eca\u9031\u672b\u306e\u30d7\u30ec\u30df\u30a2\u30ea\u30fc\u30b0\u306e\u8a66\u5408\u3067\u3082\u3001\u3053\u306e\u30b9\u30b3\u30a2\u3092\u898b\u3066\u304b\u3089\u4e88\u60f3\u3092\u7acb\u3066\u308b\u3060\u3051\u3067\u3001\u5224\u65ad\u306e\u7cbe\u5ea6\u304c\u5287\u7684\u306b\u5909\u308f\u308b\u306f\u305a\u3060\u3002",
