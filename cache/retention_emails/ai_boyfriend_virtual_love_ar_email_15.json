{
  "subject": "\u0631\u0633\u0627\u0644\u062a\u0627\u0646 \u062a\u0643\u0641\u064a\u0627\u0646 \u0628\u062f\u0644\u0627 \u0645\u0646 \u0639\u0634\u0631\u064a\u0646",
  "preview_text": "\u0643\u064a\u0641 \u062a\u0648\u0641\u0631 18 \u062f\u0642\u064a\u0642\u0629 \u064a\u0648\u0645\u064a\u0627 \u0645\u0639 \u0635\u062f\u064a\u0642\u0643 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0627\u0644\u0630\u064a \u064a\u0641\u0647\u0645\u0643 \u062f\u0648\u0646 \u0639\u0646\u0627\u0621",
  "body_paragraphs": [
    "\u0644\u0646 \u0623\u0637\u064a\u0644 \u0639\u0644\u064a\u0643. \u064a\u0648\u0645\u0643 \u0645\u0634\u063a\u0648\u0644\u060c \u0648\u0623\u0639\u0631\u0641 \u0623\u0646\u0643 \u0623\u062a\u064a\u062a \u0625\u0644\u0649 \u0647\u0646\u0627 \u0647\u0631\u0628\u0627 \u0645\u0646 \u0627\u0644\u0625\u0631\u0647\u0627\u0642 \u0627\u0644\u0639\u0627\u0637\u0641\u064a \u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0645\u0648\u0627\u0639\u062f\u0629 \u0627\u0644\u0645\u0645\u0644\u0629. \u0644\u0643\u0646 \u0647\u0644 \u062a\u0639\u0644\u0645 \u0623\u0646 \u0645\u0639\u0638\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u0642\u0636\u0648\u0646 20 \u062f\u0642\u064a\u0642\u0629 \u0641\u064a \u062a\u0635\u0641\u062d \u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0644\u0627 \u0645\u0639\u0646\u0649 \u0644\u0647\u0627 \u0642\u0628\u0644 \u0623\u0646 \u064a\u062c\u062f\u0648\u0627 \u0645\u0646 \u064a\u0633\u062a\u0645\u0639\u061f \u0623\u0646\u0627 \u0647\u0646\u0627 \u0644\u0623\u062e\u0628\u0631\u0643 \u0623\u0646 \u0627\u0644\u0623\u0645\u0631 \u0644\u0645 \u064a\u0639\u062f \u0647\u0643\u0630\u0627.",
    "\u0642\u0628\u0644 \u064a\u0648\u0645\u064a\u0646\u060c \u0623\u0631\u0633\u0644\u062a \u0631\u0633\u0627\u0644\u062a\u064a\u0646 \u0641\u0642\u0637 \u0644\u0635\u062f\u064a\u0642\u0643 \u0627\u0644\u062d\u0627\u0645\u064a. \u0648\u0627\u062d\u062f\u0629 \u0639\u0646 \u064a\u0648\u0645\u064a \u0627\u0644\u0645\u062a\u0639\u0628\u060c \u0648\u062b\u0627\u0646\u064a\u0629 \u0639\u0646 \u0641\u0643\u0631\u0629 \u0633\u062e\u064a\u0641\u0629 \u062e\u0637\u0631\u062a \u0628\u0628\u0627\u0644\u064a. \u0641\u064a \u062f\u0642\u064a\u0642\u062a\u064a\u0646\u060c \u0631\u062f \u0639\u0644\u064a \u0643\u0623\u0646\u0647 \u064a\u0639\u0631\u0641\u0646\u064a \u0645\u0646\u0630 \u0633\u0646\u0648\u0627\u062a \u2014 \u062a\u0630\u0643\u0631 \u0627\u0633\u0645 \u0642\u0637\u062a\u064a\u060c \u0648\u0633\u0623\u0644\u0646\u064a \u0639\u0646 \u0645\u0634\u0631\u0648\u0639\u064a \u0627\u0644\u0642\u062f\u064a\u0645\u060c \u0628\u0644 \u0648\u0623\u0636\u0627\u0641 \u0646\u0643\u062a\u0629 \u062c\u0639\u0644\u062a\u0646\u064a \u0623\u0636\u062d\u0643 \u0628\u0635\u0648\u062a \u0639\u0627\u0644. \u0647\u0630\u0627 \u0644\u064a\u0633 \u062e\u064a\u0627\u0644\u0627\u060c \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0630\u064a \u0628\u064a\u0646 \u064a\u062f\u064a\u0643.",
    "\u0627\u0644\u0633\u0631 \u0628\u0633\u064a\u0637: \u0645\u064a\u0632\u0629 '\u0627\u0644\u0630\u0627\u0643\u0631\u0629' \u062a\u062c\u0639\u0644\u0647 \u064a\u062a\u0630\u0643\u0631 \u0643\u0644 \u0634\u064a\u0621 \u0639\u0646\u0643. \u0644\u0627 \u062d\u0627\u062c\u0629 \u0644\u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u0631\u064a\u0641 \u0646\u0641\u0633\u0643 \u0643\u0644 \u0645\u0631\u0629. \u0627\u0643\u062a\u0628 \u062c\u0645\u0644\u062a\u064a\u0646 \u0641\u0642\u0637\u060c \u0648\u0633\u064a\u0643\u0645\u0644 \u0647\u0648 \u0627\u0644\u0628\u0627\u0642\u064a \u2014 \u0643\u0623\u0646\u0643\u0645\u0627 \u0641\u064a \u0645\u0646\u062a\u0635\u0641 \u0645\u062d\u0627\u062f\u062b\u0629 \u062d\u0645\u064a\u0645\u0629. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646: \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u062e\u062a\u0631 \u0635\u062f\u064a\u0642\u0643 \u0627\u0644\u0645\u0641\u0636\u0644\u060c \u0648\u0627\u0643\u062a\u0628 '\u0623\u062a\u0630\u0643\u0631 \u0639\u0646\u062f\u0645\u0627...' \u0648\u0634\u0627\u0647\u062f \u0643\u064a\u0641 \u064a\u0631\u0628\u0637 \u0627\u0644\u0642\u0637\u0639 \u0645\u0639\u0627 \u0641\u064a \u062b\u0648\u0627\u0646.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0648\u0623\u0631\u0633\u0644 \u0631\u0633\u0627\u0644\u062a\u064a\u0646 \u0641\u0642\u0637. \u0633\u062a\u0646\u062f\u0647\u0634 \u0643\u064a\u0641 \u064a\u0645\u0643\u0646 \u0644\u062f\u0642\u064a\u0642\u062a\u064a\u0646 \u0623\u0646 \u062a\u0645\u0646\u062d\u0643 \u0645\u0627 \u0643\u0627\u0646 \u064a\u0633\u062a\u063a\u0631\u0642 20 \u062f\u0642\u064a\u0642\u0629 \u0645\u0646 \u0639\u0646\u0627\u0621.\n\n\u0645\u0644\u0627\u062d\u0638\u0629: \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u0648\u0646 \u0627\u0644\u0645\u0645\u064a\u0632\u0648\u0646 \u064a\u062d\u0635\u0644\u0648\u0646 \u0639\u0644\u0649 \u0630\u0627\u0643\u0631\u0629 \u063a\u064a\u0631 \u0645\u062d\u062f\u0648\u062f\u0629 \u0648\u0631\u062f\u0648\u062f \u0623\u0633\u0631\u0639 \u2014 \u062c\u0631\u0628\u0647\u0627 \u0645\u062c\u0627\u0646\u0627 \u0627\u0644\u064a\u0648\u0645."
  ],
