{
  "subject": "2 \u092c\u091c\u0947 \u0930\u093e\u0924 \u0915\u093e \u0935\u0939 \u092a\u0932 \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u090f\u0915 \u092f\u0942\u091c\u0930 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u091c\u094b \u0906\u092a\u0915\u0940 \u0924\u0930\u0939 \u0939\u0940 \u090f\u0921\u094d\u0938 \u0938\u0947 \u092a\u0930\u0947\u0936\u093e\u0928 \u0925\u093e\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947 \u0909\u0938\u0928\u0947 \u0936\u093e\u0902\u0924\u093f \u092a\u093e\u0908\u0964",
  "body_paragraphs": [
    "\u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c\u0947 \u0925\u0947\u0964 \u0935\u0939 \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928 \u0930\u0939\u093e \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u092c\u0940\u091a-\u092c\u0940\u091a \u092e\u0947\u0902 \u090f\u0921\u094d\u0938 \u0906\u0915\u0930 \u0909\u0938\u0915\u093e \u092e\u0942\u0921 \u0916\u0930\u093e\u092c \u0915\u0930 \u0926\u0947\u0924\u0947 \u0925\u0947\u0964 \u0909\u0938\u0928\u0947 \u0938\u094b\u091a\u093e, '\u092c\u0938 \u090f\u0915 \u0938\u093e\u092b-\u0938\u0941\u0925\u0930\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f\u0930 \u0939\u094b, \u091c\u094b \u0915\u093e\u092e \u0915\u0930\u0947 \u0914\u0930 \u0930\u093e\u0938\u094d\u0924\u0947 \u0938\u0947 \u0939\u091f \u091c\u093e\u090f\u0964'",
    "\u0909\u0938\u0928\u0947 \u0915\u0908 \u0910\u092a\u094d\u0938 \u091f\u094d\u0930\u093e\u0908 \u0915\u093f\u090f, \u0932\u0947\u0915\u093f\u0928 \u0939\u0930 \u092c\u093e\u0930 \u0935\u0939\u0940 \u0938\u092e\u0938\u094d\u092f\u093e\u2014\u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928, \u092a\u0949\u092a-\u0905\u092a, \u0914\u0930 \u090f\u0921\u094d\u0938\u0964 \u0924\u092c \u0909\u0938\u0947 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f\u0930 \u092a\u094d\u0930\u094b \u092e\u093f\u0932\u093e\u0964 \u092c\u0938 \u090f\u0915 \u0938\u094d\u0932\u093e\u0907\u0921\u0930, \u090f\u0915 \u0908\u0915\u094d\u092f\u0942, \u0914\u0930 \u0915\u0941\u091b \u0928\u0939\u0940\u0902\u0964 \u0915\u094b\u0908 \u090f\u0921 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0928\u093e\u0917 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u0935\u0939 \u092c\u0942\u0938\u094d\u091f \u091c\u094b \u0909\u0938\u0947 \u091a\u093e\u0939\u093f\u090f \u0925\u093e\u0964",
    "\u0905\u092c \u0935\u0939 \u0939\u0930 \u0926\u093f\u0928 \u0907\u0938\u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u093e \u0939\u0948\u2014\u0938\u094d\u092a\u0949\u091f\u093f\u092b\u093e\u0908, \u092f\u0942\u091f\u094d\u092f\u0942\u092c, \u0917\u0947\u092e\u094d\u0938, \u0939\u0930 \u091c\u0917\u0939\u0964 \u0939\u0947\u0921\u092b\u094b\u0928 \u0932\u0917\u093e\u0924\u0947 \u0939\u0940 \u0910\u092a \u0905\u092a\u0928\u0947 \u0906\u092a \u0915\u093e\u092e \u0915\u0930\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948 \u0914\u0930 \u092b\u093f\u0930 \u0930\u093e\u0938\u094d\u0924\u0947 \u0938\u0947 \u0939\u091f \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0936\u093e\u0902\u0924, \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u092c\u0947\u0939\u0924\u0930\u0964",
    "\u0906\u092a \u092d\u0940 \u0935\u0939\u0940 \u0905\u0928\u0941\u092d\u0935 \u092a\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b 200% \u092a\u0930 \u0932\u0947 \u091c\u093e\u090f\u0902\u0964 \u0926\u0947\u0916\u093f\u090f \u0915\u0948\u0938\u0947 \u0935\u0939 \u0936\u093e\u0902\u0924\u093f \u092e\u0939\u0938\u0942\u0938 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938.\u2014\u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092e\u0947\u0902 \u090f\u0921\u094d\u0938 \u0915\u093e \u0915\u094b\u0908 \u0928\u093f\u0936\u093e\u0928 \u0928\u0939\u0940\u0902, \u092c\u0938 \u0935\u0939 \u092c\u0942\u0938\u094d\u091f \u091c\u094b \u0906\u092a \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964"
  ],
