{
  "subject": "\u0633\u0631\u0651\u064a \u0627\u0644\u0630\u064a \u0643\u0627\u062f \u064a\u0636\u064a\u0639: 90% \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u062a\u062c\u0627\u0647\u0644\u0648\u0646 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629",
  "preview_text": "\u0643\u0646\u062a \u0633\u0623\u062d\u062a\u0641\u0638 \u0628\u0647\u0630\u0627 \u0644\u0646\u0641\u0633\u064a\u060c \u0644\u0643\u0646 \u0644\u0627 \u064a\u0645\u0643\u0646\u0646\u064a \u0627\u0644\u0633\u0645\u0627\u062d \u0644\u0643 \u0628\u0641\u0648\u0627\u062a\u0647. \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u062a\u063a\u064a\u0651\u0631 \u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0644\u0639\u0628\u0629.",
  "body_paragraphs": [
    "\u0623\u0639\u062a\u0631\u0641 \u0644\u0643 \u0628\u0634\u064a\u0621. \u0641\u064a \u0627\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u0623\u0648\u0644\u0649 \u0644\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0643\u0646\u062a \u0623\u062a\u062c\u0627\u0647\u0644 \u0645\u064a\u0632\u0629 \u0648\u0627\u062d\u062f\u0629 \u062a\u0645\u0627\u0645\u064b\u0627. \u0638\u0646\u0646\u062a\u0647\u0627 \u0645\u062c\u0631\u062f \u062a\u0641\u0635\u064a\u0644 \u062b\u0627\u0646\u0648\u064a. \u062b\u0645 \u062d\u062f\u062b \u0645\u0627 \u062c\u0639\u0644\u0646\u064a \u0623\u063a\u064a\u0631 \u0631\u0623\u064a\u064a \u0644\u0644\u0623\u0628\u062f. \u062a\u062e\u064a\u0651\u0644 \u0623\u0646\u0643 \u062a\u062a\u062c\u0627\u0647\u0644 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0629 \u0627\u0644\u0648\u062d\u064a\u062f\u0629 \u0627\u0644\u062a\u064a \u064a\u0645\u0643\u0646 \u0623\u0646 \u062a\u0646\u0642\u0630 \u0631\u0647\u0627\u0646\u0643.",
    "\u0645\u0639\u0638\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u0646\u062f\u0641\u0639\u0648\u0646 \u0645\u0628\u0627\u0634\u0631\u0629 \u0646\u062d\u0648 \u0627\u0644\u062a\u0646\u0628\u0624\u0627\u062a. \u064a\u0631\u064a\u062f\u0648\u0646 \u0627\u0644\u0631\u0642\u0645 \u0648\u0627\u0644\u0641\u0648\u0632 \u0641\u0642\u0637. \u0644\u0643\u0646 \u0627\u0644\u0645\u062d\u062a\u0631\u0641\u064a\u0646 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u064a\u0646 \u064a\u0639\u0631\u0641\u0648\u0646 \u0623\u0646 \u0627\u0644\u0633\u0631\u0651 \u0644\u064a\u0633 \u0641\u064a '\u0645\u0627\u0630\u0627' \u0633\u064a\u0641\u0648\u0632\u060c \u0628\u0644 \u0641\u064a '\u0644\u0645\u0627\u0630\u0627' \u0633\u064a\u0641\u0648\u0632. \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062e\u0627\u0645 \u062f\u0648\u0646 \u0641\u0647\u0645 \u0627\u0644\u0633\u064a\u0627\u0642 \u0647\u064a \u0645\u062b\u0644 \u062d\u0635\u0627\u0646 \u0633\u0631\u064a\u0639 \u0641\u064a \u0637\u064a\u0646 \u0639\u0645\u064a\u0642.",
    "\u0647\u0646\u0627 \u064a\u0623\u062a\u064a \u062f\u0648\u0631 '\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u0644\u0627\u0621\u0645\u0629 \u0644\u0644\u0645\u0633\u0627\u0641\u0629' \u062f\u0627\u062e\u0644 \u0643\u0644 \u0628\u0637\u0627\u0642\u0629 \u0633\u0628\u0627\u0642. \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0644\u0627 \u064a\u062d\u0644\u0644 \u0641\u0642\u0637 \u0633\u0631\u0639\u0629 \u0627\u0644\u062d\u0635\u0627\u0646\u060c \u0628\u0644 \u064a\u062d\u0644\u0644 \u0628\u0627\u0644\u0636\u0628\u0637 \u0643\u064a\u0641 \u064a\u062a\u0623\u062b\u0631 \u0623\u062f\u0627\u0624\u0647 \u0628\u0643\u0644 \u0645\u062a\u0631 \u0625\u0636\u0627\u0641\u064a \u0641\u064a \u0627\u0644\u0645\u0636\u0645\u0627\u0631. \u0647\u0644 \u062a\u0639\u0644\u0645 \u0623\u0646 \u0628\u0639\u0636 \u0627\u0644\u062e\u064a\u0648\u0644 \u062a\u062e\u0633\u0631 \u062b\u0648\u0627\u0646\u064d \u062d\u0627\u0633\u0645\u0629 \u0628\u0639\u062f \u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0640 2000 \u0645\u062a\u0631\u061f \u0647\u0630\u0627 \u0645\u0627 \u064a\u062d\u062f\u062f \u0627\u0644\u0641\u0627\u0626\u0632 \u0645\u0646 \u0627\u0644\u062e\u0627\u0633\u0631.",
    "\u0627\u0641\u062a\u062d \u062a\u0637\u0628\u064a\u0642 Predictify \u0627\u0644\u0622\u0646. \u0627\u062e\u062a\u0631 \u0623\u064a \u0633\u0628\u0627\u0642\u060c \u0648\u0627\u0646\u0642\u0631 \u0639\u0644\u0649 \u0623\u064a \u062d\u0635\u0627\u0646\u060c \u0648\u0627\u0628\u062d\u062b \u0639\u0646 \u0642\u0633\u0645 '\u0645\u0644\u0627\u0621\u0645\u0629 \u0627\u0644\u0645\u0633\u0627\u0641\u0629'. \u0634\u0627\u0647\u062f \u0643\u064a\u0641 \u064a\u062d\u0644\u0651\u0644 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0623\u062f\u0627\u0621\u0647 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a \u0639\u0646\u062f \u0647\u0630\u0647 \u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0628\u0627\u0644\u0636\u0628\u0637. \u0647\u0630\u0647 \u0644\u064a\u0633\u062a \u0646\u0635\u0627\u0626\u062d\u060c \u0647\u0630\u0647 \u062a\u0623\u0645\u064a\u0646 \u0636\u062f \u0627\u0644\u062e\u0633\u0627\u0631\u0629. P.S.: \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0641\u062d\u0635\u0648\u0646 \u0647\u0630\u0627 \u0627\u0644\u0642\u0633\u0645 \u0642\u0628\u0644 \u0627\u0644\u0631\u0647\u0627\u0646 \u062a\u062a\u062d\u0633\u0646 \u0646\u062a\u0627\u0626\u062c\u0647\u0645 \u0628\u0646\u0633\u0628\u0629 68%. \u0644\u0627 \u062a\u0643\u0646 \u0645\u0646 \u0627\u0644\u0640 90% \u0627\u0644\u0630\u064a\u0646 \u064a\u0641\u0648\u0651\u062a\u0648\u0646\u0647\u0627.",
    "\u0627\u0641\u062a\u062d Predictify \u0627\u0644\u0622\u0646 \u0648\u0627\u062e\u062a\u0628\u0631 '\u0645\u0644\u0627\u0621\u0645\u0629 \u0627\u0644\u0645\u0633\u0627\u0641\u0629' \u0628\u0646\u0641\u0633\u0643. \u0627\u0628\u062f\u0623 \u0628\u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629 \u0644\u0645\u062f\u0629 3 \u0623\u064a\u0627\u0645 \u0644\u062a\u0631\u0649 \u0643\u0644 \u0627\u0644\u062a\u062d\u0644\u064a\u0644\u0627\u062a \u063a\u064a\u0631 \u0627\u0644\u0645\u062d\u062f\u0648\u062f\u0629."
  ],
