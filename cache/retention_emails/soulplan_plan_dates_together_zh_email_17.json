{
  "subject": "\u6211\u72af\u4e86\u4e00\u4e2a\u5de8\u5927\u7684\u9519\u8bef\uff0c\u73b0\u5728\u544a\u8bc9\u4f60\u4eec",
  "preview_text": "\u4e00\u4e2a3\u5206\u949f\u7684\u4e60\u60ef\u80fd\u8ba9\u8fd9\u4e2aApp\u7684\u6548\u679c\u7ffb10\u500d\uff0c\u6211\u5dee\u70b9\u6ca1\u53d1\u73b0\u3002",
  "body_paragraphs": [
    "\u6211\u627f\u8ba4\uff0c\u6211\u72af\u4e86\u4e00\u4e2a\u9519\u8bef\u3002\u4ee5\u524d\u6211\u603b\u662f\u89c9\u5f97\uff0c\u7528SoulPlan\u5f97\u82b1\u5f88\u591a\u65f6\u95f4\uff0c\u89c4\u5212\u4e00\u6b21\u5b8c\u7f8e\u7684\u7ea6\u4f1a\uff0c\u81f3\u5c11\u5f97\u534a\u5c0f\u65f6\u3002\u4f46\u524d\u4e24\u5929\uff0c\u6211\u5076\u7136\u53d1\u73b0\u4e86\u4e00\u4e2a\u79d8\u5bc6\uff0c\u5f7b\u5e95\u6539\u53d8\u4e86\u6211\u7684\u770b\u6cd5\u3002\u8fd9\u4e2aApp\u7684\u9690\u85cf\u529b\u91cf\uff0c\u5176\u5b9e\u85cf\u5728\u6bcf\u5929\u76843\u5206\u949f\u91cc\u3002",
    "\u4f60\u731c\u600e\u4e48\u7740\uff1f\u5f53\u6211\u5f00\u59cb\u6bcf\u5929\u62bd\u51fa3\u5206\u949f\uff0c\u6253\u5f00App\u505a\u4e00\u4ef6\u4e8b\uff0c\u6211\u7684\u7ea6\u4f1a\u8d28\u91cf\u7a81\u7136\u98d9\u5347\u3002\u4ee5\u524d\u603b\u62c5\u5fc3\u91cd\u590d\u8001\u5957\u7684\u7ea6\u4f1a\uff0c\u73b0\u5728\u6bcf\u5468\u90fd\u50cf\u7b2c\u4e00\u6b21\u7ea6\u4f1a\u4e00\u6837\u65b0\u9c9c\u3002\u8fd9\u4e0d\u662f\u9b54\u6cd5\uff0c\u800c\u662f\u4e60\u60ef\u7684\u529b\u91cf\u3002App\u91cc\u90a3\u4e2a\u201c\u6bcf\u65e5\u7075\u611f\u201d\u529f\u80fd\uff0c\u5c31\u50cf\u4e00\u4e2a\u5c0f\u52a9\u624b\uff0c\u6bcf\u5929\u7ed9\u4f60\u4e00\u4e2a\u65b0\u9c9c\u70b9\u5b50\uff0c\u4f60\u4e0d\u7528\u591a\u60f3\uff0c\u76f4\u63a5\u7528\u5b83\u5c31\u597d\u3002",
    "\u5173\u952e\u662f\uff0c\u8fd9\u4e2a\u4e60\u60ef\u5e2e\u4f60\u5efa\u7acb\u4e86\u4e00\u4e2a\u5faa\u73af\uff1a\u6bcf\u59293\u5206\u949f\uff0c\u4f60\u6d4f\u89c8\u4e00\u4e2a\u5efa\u8bae\uff0c\u7136\u540e\u548c\u4f34\u4fa3\u5206\u4eab\uff0c\u665a\u4e0a\u5c31\u6709\u7406\u7531\u804a\u4e00\u804a\u3002\u4f60\u4f1a\u53d1\u73b0\uff0c\u6c9f\u901a\u591a\u4e86\uff0c\u706b\u82b1\u81ea\u7136\u5c31\u6765\u4e86\u3002App\u4e0a\u7684\u201c\u60ca\u559c\u7ea6\u4f1a\u8ba1\u5212\u201d\u529f\u80fd\uff0c\u8ba9\u4e8b\u60c5\u53d8\u5f97\u8d85\u7ea7\u7b80\u5355\uff1a\u4f60\u9009\u4e00\u4e2a\u70b9\u5b50\uff0c\u8bbe\u5b9a\u6210\u60ca\u559c\uff0c\u53e6\u4e00\u534a\u6536\u5230\u901a\u77e5\u65f6\uff0c\u90a3\u4efd\u671f\u5f85\u611f\uff0c\u771f\u7684\u80fd\u62c9\u8fd1\u4f60\u4eec\u7684\u8ddd\u79bb\u3002",
    "\u6240\u4ee5\uff0c\u522b\u72b9\u8c6b\u4e86\u3002\u4eca\u5929\u5c31\u5f00\u59cb\uff0c\u6253\u5f00App\uff0c\u82b13\u5206\u949f\u770b\u770b\u201c\u6bcf\u65e5\u7075\u611f\u201d\uff0c\u9009\u4e00\u4e2a\u70b9\u5b50\uff0c\u7136\u540e\u544a\u8bc9\u4f60\u7684\u4f34\u4fa3\uff0c\u4f60\u6709\u4e2a\u60ca\u559c\u3002\u4f60\u4e0d\u9700\u8981\u5b8c\u7f8e\uff0c\u53ea\u9700\u8981\u5f00\u59cb\u3002P.S. \u90a3\u4e9b\u6bcf\u5929\u7528\u8fd9\u4e2a\u529f\u80fd\u7684\u4eba\uff0c92%\u8bf4\u5173\u7cfb\u53d8\u597d\u4e86\uff0c\u800c\u4f60\u79bb\u8fd9\u4e2a\u597d\u4e60\u60ef\uff0c\u53ea\u5dee\u4e00\u6b21\u6253\u5f00\u3002"
  ],
