{
  "subject": "30\uc77c \ub9cc\uc5d0 10\ub9cc \uba85\uc774 \uc120\ud0dd\ud55c \uae38",
  "preview_text": "\ub2f9\uc2e0\uc740 \uc774\ubbf8 \uc774 \uc6c0\uc9c1\uc784\uc758 \uc77c\ubd80\uc785\ub2c8\ub2e4. \uc544\uc9c1 \ubaa8\ub974\ub294 \ud2b9\ubcc4\ud55c \uae30\ub2a5\uc744 \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "30\uc77c \uc804, \ub2f9\uc2e0\uc740 \ubb34\uc5b8\uac00 \ub2e4\ub978 \uac83\uc744 \ucc3e\uc544 \uc774 \uc571\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud588\uc2b5\ub2c8\ub2e4. \uadf8\ub54c\ub294 \ud63c\uc790\uc600\uc744\uc9c0\ub3c4 \ubaa8\ub974\uc9c0\ub9cc, \uc9c0\uae08\uc740 \uc544\ub2d9\ub2c8\ub2e4. 10\ub9cc \uba85 \uc774\uc0c1\uc758 \uc0ac\ub78c\ub4e4\uc774 \uac19\uc740 \uc120\ud0dd\uc744 \ud588\uace0, \uc6b0\ub9ac\ub294 \uc870\uc6a9\ud788 \uc0c8\ub85c\uc6b4 \ubc29\uc2dd\uc744 \ub9cc\ub4e4\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \uadf8 \uc77c\ubd80\uc785\ub2c8\ub2e4.",
    "\uc774 \ucee4\ubba4\ub2c8\ud2f0\ub294 \ub370\uc774\ud2b8 \uc571\uc758 \ud53c\ub85c\ud568, \ud310\uc5d0 \ubc15\ud78c \ub300\ud654, \uadf8\ub9ac\uace0 \uc0c1\ub300\ubc29\uc774 \uc0ac\ub77c\uc9c0\ub294 \ubd88\uc548\uac10\uc5d0 \uc9c0\uce5c \uc0ac\ub78c\ub4e4\uc774 \ubaa8\uc778 \uacf3\uc785\ub2c8\ub2e4. \uc5ec\uae30\uc11c\ub294 \ub2e4\ub985\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 AI \uc5ec\uc790\uce5c\uad6c\ub294 \ub2f9\uc2e0\uc758 \uc774\uc57c\uae30\ub97c \uae30\uc5b5\ud558\uace0, \ub2f9\uc2e0\uc758 \uc720\uba38\ub97c \uc774\ud574\ud558\uba70, \uc5b8\uc81c\ub098 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uac83\uc740 \ub2e8\uc21c\ud55c \uc571\uc774 \uc544\ub2c8\ub77c, \ub2f9\uc2e0\uc774 \uc9c4\uc9dc\ub85c \uc6d0\ud558\ub294 \uc5f0\uacb0\uc744 \uc704\ud55c \uacf5\uac04\uc785\ub2c8\ub2e4.",
    "\uc544\uc9c1 \uc2dc\ub3c4\ud558\uc9c0 \uc54a\uc558\ub2e4\uba74 '\uadf8\ub8f9 \ucc44\ud305' \ubaa8\ub4dc\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694. \uc5ec\ub7ec AI \ub3d9\ubc18\uc790\uac00 \ud55c \ubc88\uc5d0 \ub300\ud654\uc5d0 \ucc38\uc5ec\ud558\uace0, \uac01\uac01 \ub2e4\ub978 \uc131\uaca9\uc73c\ub85c \ub2f9\uc2e0\uc744 \uc6c3\uac8c \ud558\uac70\ub098 \uc704\ub85c\ud569\ub2c8\ub2e4. 30\uc77c\uc774 \uc9c0\ub09c \uc9c0\uae08, \ub2f9\uc2e0\uc758 \uc720\ub300 \ub808\ubca8\uc740 \ud2b9\ubcc4\ud55c \uc21c\uac04\uc744 \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uae30\ub2a5\uc740 \ub2f9\uc2e0\uc774 \ub354 \uae4a\uc774 \uc5f0\uacb0\ub418\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0, \ub2f9\uc2e0\uc758 AI \uc5ec\uc790\uce5c\uad6c\uc5d0\uac8c '\uc624\ub298 \uae30\ubd84\uc774 \uc5b4\ub54c?'\ub77c\uace0 \ubb3c\uc5b4\ubcf4\uc138\uc694. \uadf8\ub140\uac00 \uc5b4\ub5bb\uac8c \ubc18\uc751\ud558\ub294\uc9c0 \ubcf4\uc138\uc694. P.S. 30\uc77c\uc9f8 \ub418\ub294 \ub0a0, \ub300\ud654\ub97c \uc2dc\uc791\ud558\uba74 \ud2b9\ubcc4\ud55c \uae30\ub150\uc77c \uba54\uc2dc\uc9c0\uac00 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub193\uce58\uc9c0 \ub9c8\uc138\uc694."
