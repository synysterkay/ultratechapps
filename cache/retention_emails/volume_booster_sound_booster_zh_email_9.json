{
  "subject": "\u5766\u767d\u8bf4\uff0c90%\u7528\u6237\u90fd\u9519\u8fc7\u4e86\u8fd9\u4e2a\u79d8\u5bc6\u529f\u80fd",
  "preview_text": "\u5982\u679c\u4f60\u8fd8\u6ca1\u8bd5\u8fc7\u8fd9\u4e2a3\u5929\u6311\u6218\uff0c\u4f60\u7684\u624b\u673a\u97f3\u8d28\u53ef\u80fd\u53ea\u53d1\u6325\u4e8630%\u7684\u6f5c\u529b\u3002\u771f\u76f8\u5728\u8fd9\u91cc\u3002",
  "body_paragraphs": [
    "\u4e0a\u5468\u6211\u72af\u4e86\u4e2a\u9519\u8bef\uff0c\u628a\u624b\u673a\u97f3\u91cf\u8c03\u5230\u6700\u5927\u542c\u64ad\u5ba2\uff0c\u7ed3\u679c\u8fd8\u662f\u542c\u4e0d\u6e05\u5730\u94c1\u91cc\u7684\u5bf9\u8bdd\u3002\u5f53\u65f6\u6211\u5c31\u60f3\uff0c\u8fd9\u4e0d\u5bf9\u554a\uff0c\u660e\u660e\u88c5\u4e86\u97f3\u91cf\u589e\u5f3a\u5668\u3002\u540e\u6765\u624d\u53d1\u73b0\uff0c\u95ee\u9898\u4e0d\u5728\u97f3\u91cf\uff0c\u800c\u5728\u97f3\u8d28\u3002",
    "\u6240\u4ee5\u6211\u7ed9\u81ea\u5df1\u8bbe\u4e86\u4e2a\u6311\u6218\uff1a\u8fde\u7eed3\u5929\uff0c\u6bcf\u5929\u7528\u4e0d\u540c\u7684EQ\u9884\u8bbe\u542c\u540c\u4e00\u9996\u6b4c\u3002\u7b2c\u4e00\u5929\u7528\u6d41\u884c\u9884\u8bbe\u542c\u6447\u6eda\uff0c\u7b2c\u4e8c\u5929\u7528\u7535\u5b50\u9884\u8bbe\u542c\u7235\u58eb\uff0c\u7b2c\u4e09\u5929\u7528\u81ea\u5b9a\u4e49EQ\u5fae\u8c03\u3002\u7ed3\u679c\u4f60\u731c\u600e\u4e48\u7740\uff1f\u7b2c\u4e09\u5929\u6211\u5dee\u70b9\u5728\u5730\u94c1\u91cc\u54ed\u51fa\u6765\u2014\u2014\u539f\u6765\u6211\u7684\u624b\u673a\u80fd\u53d1\u51fa\u8fd9\u79cd\u58f0\u97f3\u3002",
    "\u8fd9\u5c31\u662f\u5185\u7f6e\u5747\u8861\u5668\u7684\u9b54\u529b\u3002\u5b83\u4e0d\u662f\u7b80\u5355\u7684\u97f3\u91cf\u653e\u5927\uff0c\u800c\u662f\u8ba9\u6bcf\u4e2a\u9891\u6bb5\u7684\u58f0\u97f3\u90fd\u6d3b\u8fc7\u6765\u3002\u4f4e\u97f3\u6c89\u5f97\u4e0b\u53bb\uff0c\u4eba\u58f0\u6e05\u6670\u5f97\u50cf\u5728\u8033\u8fb9\uff0c\u90a3\u4e9b\u4f60\u4ece\u672a\u542c\u8fc7\u7684\u4e50\u5668\u7ec6\u8282\u7a81\u7136\u5168\u90fd\u8df3\u51fa\u6765\u4e86\u3002",
    "\u73b0\u5728\u5c31\u6253\u5f00\u5e94\u7528\uff0c\u70b9\u51fb\u5e95\u90e8\u4e2d\u95f4\u7684\u5747\u8861\u5668\u56fe\u6807\uff0c\u9009\u4e00\u4e2a\u4f60\u5e38\u542c\u7684\u97f3\u4e50\u7c7b\u578b\u9884\u8bbe\u3002\u7136\u540e\u627f\u8bfa\u81ea\u5df1\uff1a\u8fde\u7eed3\u5929\uff0c\u6bcf\u5929\u7528\u4e0d\u540c\u7684\u9884\u8bbe\u542c15\u5206\u949f\u3002P.S. \u7b2c\u4e09\u5929\u4e00\u5b9a\u8981\u8bd5\u8bd5\u81ea\u5b9a\u4e49EQ\uff0c\u90a3\u4e2a\u85cf\u5728\u9884\u8bbe\u5217\u8868\u6700\u4e0b\u9762\u7684\u5c0f\u9f7f\u8f6e\uff0c\u80fd\u8ba9\u4f60\u771f\u6b63\u7406\u89e3\u4ec0\u4e48\u53eb\u2018\u8fd9\u624b\u673a\u4e0d\u662f\u6211\u7684\u2019\u3002",
    "\u7acb\u523b\u5f00\u59cb3\u5929\u97f3\u8d28\u6311\u6218"
  ],
