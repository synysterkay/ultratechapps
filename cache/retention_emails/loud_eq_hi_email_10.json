{
  "subject": "\u0935\u094b 3 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u091c\u094b \u0939\u092e\u093e\u0930\u0947 1% \u092f\u0942\u091c\u093c\u0930 \u0930\u094b\u091c\u093c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902",
  "preview_text": "\u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947 \u0939\u092e\u093e\u0930\u0947 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930 \u0905\u092a\u0928\u0947 \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u0915\u094d\u0930\u093f\u0938\u094d\u091f\u0932 \u0915\u094d\u0932\u093f\u092f\u0930 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u0938 2 \u092e\u093f\u0928\u091f \u092e\u0947\u0902\u0964",
  "body_paragraphs": [
    "\u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a 1% \u092f\u0942\u091c\u093c\u0930 \u0905\u0932\u0917 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u094b \u0939\u0930 \u0926\u093f\u0928 3 \u091a\u0940\u091c\u093c\u0947\u0902 \u0938\u0947\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u0906\u092a \u0936\u093e\u092f\u0926 \u092e\u093f\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964",
    "\u092a\u0939\u0932\u093e: \u0935\u094b 'Optimize' \u092c\u091f\u0928 \u0926\u092c\u093e\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u093e \u0928\u093e\u092e \u091a\u0941\u0928\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u093e\u0901, \u0935\u094b \u091b\u094b\u091f\u093e \u0938\u0947\u091f\u093f\u0902\u0917 \u092e\u0947\u0928\u0942\u0964 \u0926\u0942\u0938\u0930\u093e: \u0935\u094b \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0915\u094b \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u2014\u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917, \u092e\u094d\u092f\u0942\u091c\u093c\u093f\u0915 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917\u0964 \u0924\u0940\u0938\u0930\u093e: \u0935\u094b +200% \u092c\u0942\u0938\u094d\u091f \u0915\u094b \u0939\u092e\u0947\u0936\u093e \u0911\u0928 \u0930\u0916\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0939\u093f\u092f\u0930\u093f\u0902\u0917-\u0938\u0947\u092b \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u0915\u094b \u091a\u0947\u0915 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u092f\u0947 \u0924\u0940\u0928\u094b\u0902 \u0915\u093e\u092e \u0906\u092a\u0915\u0947 \u0910\u092a \u092e\u0947\u0902 \u092a\u0939\u0932\u0947 \u0938\u0947 \u092e\u094c\u091c\u0942\u0926 \u0939\u0948\u0902\u0964 \u092c\u0938 \u0909\u0928\u094d\u0939\u0947\u0902 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0928\u0947 \u0915\u093e \u0924\u0930\u0940\u0915\u093e \u091c\u093e\u0928\u0928\u093e \u0939\u0948\u0964 Premium \u092f\u0942\u091c\u093c\u0930 \u0924\u094b \u0907\u0938\u0947 \u0930\u094b\u091c\u093c \u0915\u0940 \u0906\u0926\u0924 \u092c\u0928\u093e \u0932\u0947\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0905\u092c \u0906\u092a\u0915\u0940 \u092c\u093e\u0930\u0940\u0964 \u0910\u092a \u0916\u094b\u0932\u0947\u0902, 'Optimize' \u092a\u0930 \u091c\u093e\u090f\u0902, \u0914\u0930 \u0905\u092a\u0928\u093e \u0921\u093f\u0935\u093e\u0907\u0938 \u091a\u0941\u0928\u0947\u0902\u0964 P.S. \u0905\u0917\u0930 \u0906\u092a\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 Premium \u091f\u094d\u0930\u093e\u092f\u0932 \u0928\u0939\u0940\u0902 \u0932\u093f\u092f\u093e, \u0924\u094b \u092f\u0947 \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0901 (\u091c\u0948\u0938\u0947 Sound DNA) \u0906\u092a\u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0938\u093e\u092b \u0906\u0935\u093e\u091c\u093c \u0926\u0947\u0902\u0917\u0940\u0964"
  ],
