{
  "subject": "90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u092f\u0939 \u0917\u0932\u0924\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0906\u092a \u0928 \u0915\u0930\u0947\u0902",
  "preview_text": "\u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u091f\u094d\u0930\u093f\u0915 \u091c\u094b \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u090f\u0915\u094d\u092f\u0942\u0930\u0947\u0938\u0940 \u0924\u0941\u0930\u0902\u0924 \u092c\u0926\u0932 \u0926\u0947\u0917\u0940\u0964 \u0907\u0938\u0947 \u092e\u093f\u0938 \u092e\u0924 \u0915\u0930\u0947\u0902\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u092f\u0942\u091c\u093c\u0930 \u0915\u094b \u0926\u0947\u0916\u093e \u091c\u094b \u092c\u093e\u0930-\u092c\u093e\u0930 \u0917\u0932\u0924 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964 \u0909\u0938\u0915\u0940 \u092a\u094d\u0930\u0949\u092c\u094d\u0932\u092e \u0938\u093e\u092b \u0925\u0940: \u0935\u0939 \u0938\u093f\u0930\u094d\u092b\u093c '\u0935\u093f\u0928\u0930' \u0926\u0947\u0916 \u0930\u0939\u093e \u0925\u093e, '\u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930' \u0928\u0939\u0940\u0902\u0964 \u092f\u0939 \u0935\u0939\u0940 \u0917\u0932\u0924\u0940 \u0939\u0948 \u091c\u094b \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092b\u093f\u0930 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f '\u090f\u092a \u0915\u093e\u092e \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e'\u0964",
    "\u092f\u0939\u093e\u0901 \u090f\u0915 60-\u0938\u0947\u0915\u0902\u0921 \u0915\u093e \u0939\u0948\u0915 \u0939\u0948: \u0915\u092d\u0940 \u092d\u0940 \u0938\u093f\u0930\u094d\u092b\u093c \u091f\u0940\u092e \u0915\u0947 \u0928\u093e\u092e \u092a\u0930 \u0926\u093e\u0902\u0935 \u0928 \u0932\u0917\u093e\u090f\u0902\u0964 \u0939\u092e\u093e\u0930\u093e AI \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u0935\u0947\u0930\u093f\u090f\u092c\u0932\u094d\u0938 \u091a\u0947\u0915 \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u090f\u0915 '\u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930' \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0905\u0917\u0930 \u0938\u094d\u0915\u094b\u0930 85% \u0938\u0947 \u090a\u092a\u0930 \u0939\u0948, \u0924\u094b \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0930\u0949\u0915 \u0938\u0949\u0932\u093f\u0921 \u0939\u0948\u0964 70% \u0915\u0947 \u0928\u0940\u091a\u0947? \u0930\u093f\u0938\u094d\u0915 \u092c\u0939\u0941\u0924 \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0964 \u092f\u0939 \u090f\u0915 \u0928\u0902\u092c\u0930 \u0906\u092a\u0915\u0940 \u0917\u0947\u092e \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u092c\u0926\u0932 \u0938\u0915\u0924\u093e \u0939\u0948\u0964",
    "\u0907\u0938\u0932\u093f\u090f \u0905\u0917\u0932\u0940 \u092c\u093e\u0930 \u091c\u092c \u090f\u092a \u0916\u094b\u0932\u0947\u0902, \u0938\u0940\u0927\u0947 \u0915\u093f\u0938\u0940 \u092e\u0948\u091a \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u0947 \u0920\u0940\u0915 \u0928\u0940\u091a\u0947 \u0906\u092a\u0915\u094b 'AI \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938: 92%' \u091c\u0948\u0938\u093e \u0928\u0902\u092c\u0930 \u0926\u093f\u0916\u0947\u0917\u093e\u0964 \u092f\u0939\u0940 \u0935\u0939 \u091b\u0941\u092a\u093e \u0939\u0941\u0906 \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u094b \u092c\u0924\u093e\u0924\u093e \u0939\u0948 \u0915\u093f AI \u0915\u093f\u0924\u0928\u093e \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u091f \u0939\u0948\u0964 \u0907\u0938\u0947 \u091a\u0947\u0915 \u0915\u093f\u090f \u092c\u093f\u0928\u093e \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0926\u0947\u0916\u0928\u093e, \u092c\u093f\u0928\u093e \u0938\u094d\u0915\u094b\u0930\u092c\u094b\u0930\u094d\u0921 \u0926\u0947\u0916\u0947 \u092e\u0948\u091a \u0915\u093e \u0928\u0924\u0940\u091c\u093e \u092c\u0924\u093e\u0928\u0947 \u091c\u0948\u0938\u093e \u0939\u0948\u0964",
    "\u0905\u092d\u0940 Predictify \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0906\u091c \u0915\u0947 \u0915\u093f\u0938\u0940 \u090f\u0915 \u092e\u0948\u091a \u0915\u093e \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u091a\u0947\u0915 \u0915\u0930\u0947\u0902\u0964 \u0938\u093f\u0930\u094d\u092b\u093c 60 \u0938\u0947\u0915\u0902\u0921\u0964 \u092b\u093f\u0930 \u0926\u0947\u0916\u093f\u090f\u0917\u093e \u0906\u092a\u0915\u0940 \u0938\u094b\u091a \u0915\u0948\u0938\u0947 \u092c\u0926\u0932\u0924\u0940 \u0939\u0948\u0964 P.S.: \u091c\u094b \u0932\u094b\u0917 \u092f\u0939 \u091f\u094d\u0930\u093f\u0915 \u0905\u092a\u0928\u093e\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0905\u0915\u094d\u0938\u0930 3-\u0926\u093f\u0928 \u0915\u0947 \u092b\u094d\u0930\u0940 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0915\u0947 \u092c\u093e\u0926 \u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093e\u0907\u092c \u0915\u0930 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u090f\u0915 \u092c\u093e\u0930 \u092f\u0939 '\u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938' \u0926\u093f\u0916\u0928\u0947 \u0932\u0917\u0947, \u0924\u094b \u092c\u093f\u0928\u093e \u0907\u0938\u0915\u0947 \u0915\u093e\u092e \u0915\u0930\u0928\u093e \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0932\u0917\u0924\u093e \u0939\u0948\u0964"
