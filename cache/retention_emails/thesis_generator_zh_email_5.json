    "\u90a3\u4e00\u523b\uff0c\u6211\u60f3\u8d77\u81ea\u5df1\u5927\u5b66\u65f6\u4e5f\u662f\u8fd9\u6837\uff1aDeadline\u524d\u591c\uff0c\u77aa\u7740\u7a7a\u767dWord\u6587\u6863\uff0c\u8111\u5b50\u91cc\u53ea\u6709\u4e00\u53e5\u8bdd\u2014\u2014'\u6211\u5b8c\u4e86\u3002'\u7ed3\u679c\u5462\uff1f\u6211\u5199\u4e86\u4e2a\u4e1c\u897f\uff0c\u4e0d\u4ec5\u6551\u4e86\u81ea\u5df1\uff0c\u8fd8\u6551\u4e865\u4e07\u4e2a\u548c\u4f60\u4e00\u6837\u7684\u5b66\u751f\u3002",
    "\u90a3\u4e2a\u51cc\u66682\u70b9\u7684\u9519\u8bef\uff0c\u5c31\u662f\u9020\u4e86'\u4e00\u952e\u751f\u6210\u5927\u7eb2'\u529f\u80fd\u3002\u4e0d\u662f\u8ba9\u4f60\u6284\uff0c\u662f\u8ba9\u4f60\u4ece\u7a7a\u767d\u91cc\u8df3\u51fa\u6765\u3002\u8f93\u5165\u4e3b\u9898\uff0c10\u5206\u949f\u62ff\u5230\u601d\u7ef4\u5bfc\u56fe+\u5927\u7eb2+\u5f15\u7528\u3002\u518d\u4e5f\u4e0d\u7528\u4ece\u96f6\u5f00\u59cb\u3002",
