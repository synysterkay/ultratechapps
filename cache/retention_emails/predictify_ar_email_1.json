{
  "subject": "\u062a\u0648\u0642\u0639\u0643 \u0644\u0647\u062f\u0641 \u0645\u0628\u0627\u0628\u064a \u0627\u0644\u064a\u0648\u0645",
  "preview_text": "\u0647\u062f\u0641 \u0645\u0628\u0627\u0628\u064a \u0623\u0645\u0627\u0645 \u0627\u0644\u0631\u064a\u0627\u0644\u061f \u062f\u0642\u064a\u0642\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u0642\u0637 \u062a\u0639\u0637\u064a\u0643 \u0627\u0644\u0646\u062a\u064a\u062c\u0629",
  "body_paragraphs": [
    "\u0641\u064a \u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u0623\u0645\u0633\u060c \u0633\u062c\u0644 \u0663\u066a \u0641\u0642\u0637 \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u062a\u0648\u0642\u0639\u0647\u0645 \u0627\u0644\u0635\u062d\u064a\u062d \u0644\u0647\u062f\u0641 \u0645\u0628\u0627\u0628\u064a. \u0623\u0646\u062a\u061f \u0644\u0627 \u062a\u062a\u0631\u0643 \u0627\u0644\u0641\u0631\u0635\u0629 \u062a\u0641\u0648\u062a\u0643.",
    "Predictify \u064a\u062d\u0644\u0644 \u0622\u0644\u0627\u0641 \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0642\u0628\u0644 \u0643\u0644 \u0645\u0628\u0627\u0631\u0627\u0629\u2014\u0645\u0646 xG \u0625\u0644\u0649 \u0642\u0648\u0629 \u0627\u0644\u062f\u0641\u0627\u0639. \u062a\u0648\u0642\u0639\u0643 \u0627\u0644\u062a\u0627\u0644\u064a \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u0643\u0648\u0646 \u062f\u0642\u064a\u0642\u064b\u0627 \u0628\u0646\u0633\u0628\u0629 \u0669\u0660\u066a.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0627\u0643\u062a\u0628 \u0623\u064a \u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u064a\u0648\u0645. \u0633\u062a\u0631\u0649 \u062a\u0648\u0642\u0639 AI \u0628\u062f\u0642\u0629 \u0663\u0660 \u062b\u0627\u0646\u064a\u0629 \u0641\u0642\u0637. \u0644\u0627 \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0623\u064a \u062e\u0628\u0631\u0629.",
    "\u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646: \u0627\u0641\u062a\u062d Predictify\u060c \u0627\u062e\u062a\u0631 \u0645\u0628\u0627\u0631\u0627\u0629\u060c \u0648\u0634\u0627\u0647\u062f \u0627\u0644\u062a\u0648\u0642\u0639. P.S. \u0643\u0644 \u062a\u0648\u0642\u0639 \u0635\u062d\u064a\u062d \u064a\u0645\u0646\u062d\u0643 \u0646\u0642\u0627\u0637\u064b\u0627 \u0641\u064a \u0633\u0644\u0645 \u0627\u0644\u0642\u064a\u0627\u062f\u0629\u2014\u0647\u0644 \u0623\u0646\u062a \u062c\u0627\u0647\u0632 \u0644\u062a\u062d\u062f\u064a AI\u061f"
  ],
