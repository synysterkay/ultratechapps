{
  "subject": "\u674e\u660e\u7684\u6545\u4e8b\u8ba9\u6211\u4eec\u7684\u56e2\u961f\u5b89\u9759\u4e86\u4e0b\u6765",
  "preview_text": "\u4e00\u4e2a\u7528\u6237\u7684\u65e5\u5e38\u901a\u52e4\uff0c\u5982\u4f55\u4ece\u5608\u6742\u53d8\u6210\u6e05\u6670\u3002\u4ed6\u7684\u6545\u4e8b\uff0c\u4e5f\u8bb8\u662f\u4f60\u7684\u6545\u4e8b\u3002",
  "body_paragraphs": [
    "\u4e0a\u5468\u4e09\u4e0b\u5348\uff0c\u6211\u4eec\u7684\u652f\u6301\u90ae\u7bb1\u6536\u5230\u4e86\u4e00\u5c01\u5f88\u957f\u7684\u4fe1\u3002\u53d1\u4ef6\u4eba\u662f\u674e\u660e\uff0c\u4ed6\u6bcf\u5929\u901a\u52e4\u4e24\u5c0f\u65f6\uff0c\u5730\u94c1\u4e0a\u542c\u64ad\u5ba2\uff0c\u4f46\u624b\u673a\u97f3\u91cf\u8c03\u5230\u6700\u5927\uff0c\u8fd8\u662f\u542c\u4e0d\u6e05\u3002\u4ed6\u8bf4\uff0c\u4ed6\u51e0\u4e4e\u653e\u5f03\u4e86\u3002",
    "\u7136\u540e\u4ed6\u4e0b\u8f7d\u4e86Loud EQ\uff0c\u8bd5\u4e86\u8bd5\u4e00\u952e\u4f18\u5316\u3002\u4ed6\u5199\u9053\uff0c\u2018\u7b2c\u4e00\u6b21\u5728\u5730\u94c1\u4e0a\uff0c\u6211\u542c\u5230\u4e86\u64ad\u5ba2\u4e2d\u4e3b\u6301\u4eba\u7684\u6bcf\u4e2a\u5b57\uff0c\u5c31\u50cf\u4ed6\u4eec\u5728\u65c1\u8fb9\u8bf4\u8bdd\u3002\u2019 \u8fd9\u5c01\u4fe1\u8ba9\u6211\u4eec\u6574\u4e2a\u56e2\u961f\u505c\u4e86\u4e0b\u6765\u3002\u4e0d\u662f\u56e0\u4e3a\u4ed6\u7528\u4e86\u9ad8\u7ea7\u529f\u80fd\uff0c\u800c\u662f\u56e0\u4e3a\u90a3\u79cd\u2018\u7ec8\u4e8e\u542c\u6e05\u4e86\u2019\u7684\u7247\u523b\uff0c\u8ba9\u4ed6\u7684\u901a\u52e4\u4ece\u714e\u71ac\u53d8\u6210\u4e86\u4eab\u53d7\u3002",
    "\u4f60\u5927\u6982\u4e5f\u6709\u7c7b\u4f3c\u7684\u7ecf\u5386\u2014\u2014\u90a3\u4e9b\u566a\u97f3\u4e2d\u4e22\u5931\u7684\u5bf9\u8bdd\uff0c\u90a3\u4e9b\u91cd\u590d\u56de\u653e\u5374\u542c\u4e0d\u6e05\u7684\u7247\u6bb5\u3002Loud EQ\u76845\u6bb5\u5747\u8861\u5668\u548c\u4e00\u952e\u4f18\u5316\uff0c\u5c31\u662f\u4e3a\u8fd9\u4e2a\u8bbe\u8ba1\u7684\u3002\u5b83\u4e0d\u53ea\u662f\u4e00\u4e2a\u97f3\u91cf\u653e\u5927\u5668\uff0c\u800c\u662f\u5e2e\u4f60\u627e\u5230\u9002\u5408\u5f53\u524d\u73af\u5883\u7684\u97f3\u6548\uff0c\u6bd4\u5982\u5728\u5730\u94c1\u4e0a\uff0c\u5b83\u4f1a\u81ea\u52a8\u538b\u4f4e\u4f4e\u9891\u566a\u97f3\uff0c\u7a81\u51fa\u4eba\u58f0\u3002",
    "\u6253\u5f00Loud EQ\uff0c\u8bd5\u8bd5\u4e00\u952e\u4f18\u5316\u3002\u63d2\u4e0a\u8033\u673a\uff0c\u70b9\u4e00\u4e0b\uff0c\u542c\u542c\u770b\u662f\u5426\u50cf\u674e\u660e\u90a3\u6837\uff0c\u53d1\u73b0\u4e00\u4e2a\u66f4\u6e05\u6670\u7684\u4e16\u754c\u3002P.S. \u674e\u660e\u540e\u6765\u5347\u7ea7\u4e86\u9ad8\u7ea7\u7248\uff0c\u56e0\u4e3a\u4ed6\u53d1\u73b0\u81ea\u52a8\u9002\u914d\u84dd\u7259\u8033\u673a\u7684\u529f\u80fd\uff0c\u8ba9\u4ed6\u5728\u4e0d\u540c\u8bbe\u5907\u95f4\u5207\u6362\u65f6\uff0c\u518d\u4e5f\u4e0d\u7528\u624b\u52a8\u8c03\u4e86\u3002"
  ],
