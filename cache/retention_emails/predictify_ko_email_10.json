{
  "subject": "21\uc77c \ucc28\uc758 \uc228\uaca8\uc9c4 1% \uc124\uc815\ubc95",
  "preview_text": "\uc0c1\uc704 1% \uc0ac\uc6a9\uc790\uac00 \ub9e4\uc77c \ud655\uc778\ud558\ub294 \ube44\ubc00 \uc6cc\ud06c\ud50c\ub85c\uc6b0\ub97c \uacf5\uac1c\ud569\ub2c8\ub2e4. \ub2f9\uc2e0\ub3c4 \ub530\ub77c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uc5b4\uc81c \uacbd\uae30, \ub2f9\uc2e0\uc758 \uc608\uce21\uc740 \ub9de\uc558\ub098\uc694? \ub300\ubd80\ubd84\uc758 \ud32c\ub4e4\uc740 \uac10\uc5d0 \uc758\uc874\ud558\uc9c0\ub9cc, \uc0c1\uc704 1%\ub294 \ub2e4\ub985\ub2c8\ub2e4. \uadf8\ub4e4\uc740 \ub370\uc774\ud130\ub97c \uba3c\uc800 \ud655\uc778\ud558\uace0, AI\uac00 \ubd84\uc11d\ud55c \ubcc0\uc218\ub97c \ud65c\uc6a9\ud574 \uc2b9\ubd80\ub97c \ub0c5\ub2c8\ub2e4.",
    "21\uc77c\uc9f8, \ub2f9\uc2e0\uc740 \uc774\ubbf8 \uc571\uc758 \uae30\ubcf8\uc744 \uc54c \uac83\uc785\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uc9c4\uc9dc \ubcc0\ud654\ub294 \uc5ec\uae30\uc11c\ubd80\ud130 \uc2dc\uc791\ub429\ub2c8\ub2e4. \uc0c1\uc704 \uc0ac\uc6a9\uc790\ub4e4\uc740 'AI \ucc44\ud305'\uc5d0 \uc9c8\ubb38\uc744 \ub358\uc9c0\uace0, '\ucee4\ubba4\ub2c8\ud2f0'\uc5d0\uc11c \uc608\uce21\uc744 \uac80\uc99d\ud558\uba70, '\uc2e0\ub8b0\ub3c4 \uc810\uc218'\uac00 70% \uc774\uc0c1\uc778 \uacbd\uae30\ub9cc \uc120\ud0dd\ud569\ub2c8\ub2e4. \uadf8\ub4e4\uc740 5\ubd84 \uc548\uc5d0 \ubaa8\ub4e0 \uac83\uc744 \ud655\uc778\ud558\uace0, \ub2e8 3\uac1c\uc758 \uacbd\uae30\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4.",
    "\uc608\ub97c \ub4e4\uc5b4, \uc624\ub298 '\ud504\ub9ac\ubbf8\uc5b4\ub9ac\uadf8' \uacbd\uae30\uc5d0\uc11c AI\uac00 85% \uc2e0\ub8b0\ub3c4\ub97c \ubcf4\uc778 \ub9e4\uce58\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc0c1\uc704 1%\ub294 \uadf8\ub7f0 \uacbd\uae30\uc5d0\uc11c\ub9cc \ubc30\ud305\ud558\uace0, 'IQ \ud034\uc988'\ub85c \uc790\uc2e0\uc758 \uc9c0\uc2dd\uc744 \ud14c\uc2a4\ud2b8\ud55c \ud6c4, '\ud504\ub9ac\ubbf8\uc5c4 \uc608\uce21'\uc744 \ud655\uc778\ud569\ub2c8\ub2e4. \uc774 \uc6cc\ud06c\ud50c\ub85c\uc6b0\ub294 3\uc77c \ubb34\ub8cc \uccb4\ud5d8\uc73c\ub85c \ubc14\ub85c \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0, 'AI \ucc44\ud305'\uc5d0 '\uc624\ub298 \ucd5c\uace0\uc758 \uc608\uce21 3\uac1c'\ub77c\uace0 \ubb3c\uc5b4\ubcf4\uc138\uc694. \ub2f5\uc744 \ud655\uc778\ud55c \ud6c4, \ucee4\ubba4\ub2c8\ud2f0\uc5d0\uc11c \ub2e4\ub978 \ud32c\ub4e4\uacfc \uc758\uacac\uc744 \ub098\ub204\uc138\uc694. P.S. 21\uc77c\uc9f8, \ub2f9\uc2e0\uc740 \uc774\ubbf8 \uc0c1\uc704 1%\uc758 \uc2b5\uad00\uc744 \ubc30\uc6b0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc74c \ub2e8\uacc4\ub294 \uc9c1\uc811 \uc2e4\ud589\ud558\ub294 \uac83\ubfd0\uc785\ub2c8\ub2e4."
  ],
