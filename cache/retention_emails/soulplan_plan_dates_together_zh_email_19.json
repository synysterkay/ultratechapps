{
  "subject": "\u4e00\u4e2a\u79d8\u5bc6\u529f\u80fd\u5373\u5c06\u4e0a\u7ebf\uff0c\u53ea\u6709\u4f60\u770b\u5230",
  "preview_text": "\u63d0\u524d\u544a\u8bc9\u4f60\uff0c\u4f46\u522b\u544a\u8bc9\u522b\u4eba\u2014\u2014\u6211\u4eec\u6b63\u5728\u6d4b\u8bd5\u4e00\u4e2a\u4f1a\u8ba9\u4f60\u4eec\u5173\u7cfb\u66f4\u8fd1\u7684\u65b0\u529f\u80fd\u3002",
  "body_paragraphs": [
    "\u6211\u6709\u4e2a\u79d8\u5bc6\u8981\u544a\u8bc9\u4f60\u3002\u5176\u5b9e\u6211\u4e0d\u8be5\u8bf4\u7684\uff0c\u4f46\u4f60\u662f\u6211\u4eec\u6700\u5fe0\u5b9e\u7684\u7528\u6237\u4e4b\u4e00\uff0c\u6240\u4ee5\u5148\u7ed9\u4f60\u900f\u4e2a\u98ce\u3002\u63a5\u4e0b\u6765\u51e0\u5468\uff0c\u6211\u4eec\u4f1a\u63a8\u51fa\u4e00\u4e2a\u529f\u80fd\uff0c\u4e13\u95e8\u89e3\u51b3\u4f60\u90a3\u4e2a\u2018\u4eca\u665a\u53bb\u54ea\u513f\u2019\u7684\u5c34\u5c2c\u65f6\u523b\u3002",
    "\u60f3\u8c61\u4e00\u4e0b\uff1a\u4f60\u6253\u5f00SoulPlan\uff0c\u70b9\u4e00\u4e0b\uff0c\u7136\u540e\u4e00\u4e2a\u5b8c\u7f8e\u7684\u7ea6\u4f1a\u65b9\u6848\u50cf\u9b54\u672f\u4e00\u6837\u5f39\u51fa\u6765\u2014\u2014\u57fa\u4e8e\u4f60\u4eec\u4fe9\u771f\u5b9e\u7684\u5174\u8da3\u3001\u4e0a\u6b21\u7684\u56de\u5fc6\uff0c\u751a\u81f3\u4f60\u94b1\u5305\u7684\u627f\u53d7\u529b\u3002\u4e0d\u662f\u968f\u4fbf\u5806\u780c\uff0c\u800c\u662f\u771f\u6b63\u8ba9\u4f60\u4eec\u4fe9\u90fd\u5fc3\u52a8\u7684\u9009\u62e9\u3002\u6211\u4eec\u5185\u90e8\u6d4b\u8bd5\u65f6\uff0c\u6709\u4eba\u76f4\u63a5\u54ed\u4e86\uff0c\u4e0d\u662f\u5938\u5f20\uff0c\u662f\u611f\u52a8\u5230\u54ed\u3002",
    "\u8fd9\u4e2a\u529f\u80fd\u53eb\u2018\u7075\u611f\u95ea\u73b0\u2019\u2014\u2014\u5b83\u4f1a\u5728\u4f60\u6700\u9700\u8981\u7684\u65f6\u5019\u7ed9\u4f60\u4e00\u8bb0\u6d6a\u6f2b\u91cd\u51fb\u3002\u4f46\u4f60\u73b0\u5728\u5c31\u80fd\u8bd5\u8bd5\u5b83\u7684\u96cf\u5f62\uff1a\u6253\u5f00SoulPlan\u7684\u2018\u53d1\u73b0\u2019\u9875\u9762\uff0c\u70b9\u90a3\u4e2a\u2018\u968f\u673a\u60ca\u559c\u2019\u6309\u94ae\u3002\u6ca1\u9519\uff0c\u5c31\u662f\u90a3\u4e2a\u4f60\u4e00\u76f4\u6ca1\u6562\u70b9\u7684\u5c0f\u661f\u661f\u3002\u5b83\u4f1a\u6839\u636e\u4f60\u4eec\u7684\u5386\u53f2\u8bb0\u5f55\uff0c\u751f\u6210\u4e00\u4e2a\u4f60\u4ece\u6ca1\u60f3\u8fc7\u7684\u7ea6\u4f1a\u70b9\u5b50\u3002",
    "\u73b0\u5728\u5c31\u6253\u5f00SoulPlan\uff0c\u70b9\u90a3\u4e2a\u5c0f\u661f\u661f\uff0c\u7136\u540e\u544a\u8bc9\u6211\u4f60\u53d1\u73b0\u4e86\u4ec0\u4e48\u3002\u6211\u4fdd\u8bc1\uff0c\u4f60\u4f1a\u88ab\u60ca\u559c\u5230\u3002P.S. \u522b\u544a\u8bc9\u522b\u4eba\u8fd9\u4e2a\u529f\u80fd\u2014\u2014\u8ba9\u5b83\u6210\u4e3a\u6211\u4eec\u4e4b\u95f4\u7684\u5c0f\u79d8\u5bc6\u3002\u7b49\u6b63\u5f0f\u4e0a\u7ebf\u65f6\uff0c\u4f60\u4f1a\u662f\u90a3\u4e2a\u6700\u65e9\u7528\u4e0a\u7684\u60c5\u4fa3\u3002"
  ],
