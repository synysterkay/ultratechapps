  "subject": "\u0e1a\u0e2d\u0e25\u0e27\u0e31\u0e19\u0e19\u0e35\u0e49 3 \u0e04\u0e39\u0e48\u0e17\u0e35\u0e48 AI \u0e1f\u0e31\u0e19\u0e18\u0e07 80%+",
  "preview_text": "\u0e40\u0e1b\u0e34\u0e14\u0e41\u0e2d\u0e1b\u0e40\u0e0a\u0e47\u0e04\u0e2a\u0e16\u0e34\u0e15\u0e34\u0e01\u0e48\u0e2d\u0e19\u0e40\u0e15\u0e30 \u0e23\u0e39\u0e49\u0e41\u0e25\u0e49\u0e27\u0e23\u0e27\u0e22\u0e01\u0e27\u0e48\u0e32\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e19\u0e04\u0e38\u0e13\u0e41\u0e19\u0e48 \u0e40\u0e1b\u0e34\u0e14 Predictify \u0e14\u0e39\u0e40\u0e25\u0e22",
