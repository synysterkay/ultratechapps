{
  "subject": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0916\u093e\u0938 \u0906 \u0930\u0939\u093e \u0939\u0948",
  "preview_text": "\u0939\u092e\u0928\u0947 \u0915\u0941\u091b \u0928\u092f\u093e \u092c\u0928\u093e\u092f\u093e \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0921\u0947\u091f \u0928\u093e\u0907\u091f\u094d\u0938 \u0915\u094b \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964 \u092a\u0939\u0932\u0947 \u0938\u0941\u0928\u094b, \u092b\u093f\u0930 \u0926\u0947\u0916\u0928\u093e\u0964",
  "body_paragraphs": [
    "\u0938\u094b\u091a\u094b, \u0905\u0917\u0930 \u0924\u0941\u092e \u0915\u0932 \u0930\u093e\u0924 \u0915\u094b\u0908 \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b \u092c\u093f\u0928\u093e \u0915\u0941\u091b \u0938\u094b\u091a\u0947? \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0914\u0930 \u0938\u092c \u0915\u0941\u091b \u0924\u0948\u092f\u093e\u0930\u0964 \u0939\u093e\u0901, \u0939\u092e\u0928\u0947 \u0915\u0941\u091b \u0910\u0938\u093e \u0939\u0940 \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964",
    "\u0939\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u091c\u093f\u0902\u0926\u0917\u0940 \u092e\u0947\u0902 \u0930\u094b\u091c \u090f\u0915 \u0939\u0940 \u0930\u0942\u091f\u0940\u0928 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948 - \u0915\u093e\u092e, \u0918\u0930, \u092b\u093f\u0930 \u0935\u0939\u0940 \u092a\u0941\u0930\u093e\u0928\u0940 \u0921\u0947\u091f \u0906\u0907\u0921\u093f\u092f\u093e\u091c\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u092c \u0939\u092e \u0932\u093e \u0930\u0939\u0947 \u0939\u0948\u0902 \u090f\u0915 \u0928\u092f\u093e \u092b\u0940\u091a\u0930 \u091c\u094b \u0939\u0930 \u0936\u093e\u092e \u0915\u094b \u0916\u093e\u0938 \u092c\u0928\u093e \u0926\u0947\u0917\u093e\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0924\u094b\u0939\u092b\u093e \u0939\u0948, \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092c\u0924\u093e\u090f\u0917\u093e \u0915\u093f \u0935\u0939 \u0939\u092e\u0947\u0936\u093e \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0926\u093f\u0932 \u092e\u0947\u0902 \u0939\u0948\u0964",
    "\u0907\u0938\u0947 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 '\u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f' - \u090f\u0915 \u0910\u0938\u093e \u092b\u0940\u091a\u0930 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092e\u0942\u0921 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u090f\u0915 \u092a\u0930\u092b\u0947\u0915\u094d\u091f \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928 \u0915\u0930\u0947\u0917\u093e\u0964 \u091a\u093e\u0939\u0947 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0915\u0949\u091c\u0940 \u091a\u093e\u0939\u093f\u090f \u092f\u093e \u090f\u0921\u0935\u0947\u0902\u091a\u0930\u0938, \u092c\u0938 \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u0914\u0930 \u0938\u092c \u0924\u0948\u092f\u093e\u0930\u0964 \u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0926\u0947\u0916\u094b \u0915\u093f \u092f\u0939 \u0915\u0948\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948 - \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u092f\u0939 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u094b\u0964 \u092c\u0938 \u090f\u0915 \u092e\u093f\u0928\u091f, \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0921\u0947\u091f \u0924\u0948\u092f\u093e\u0930\u0964 P.S. \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u091c\u092c \u092f\u0939 \u0926\u0947\u0916\u0947\u0917\u093e, \u0924\u094b \u0909\u0938\u0947 \u0932\u0917\u0947\u0917\u093e \u0915\u093f \u0924\u0941\u092e\u0928\u0947 \u0909\u0938\u0915\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0916\u093e\u0938 \u0938\u094b\u091a\u093e \u0939\u0948 - \u0914\u0930 \u092f\u0939 \u0938\u091a \u0939\u0948\u0964"
  ],
