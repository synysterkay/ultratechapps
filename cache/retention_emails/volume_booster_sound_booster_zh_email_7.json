{
  "subject": "\u7b2c14\u5929\u7684\u79d8\u5bc6\uff1a\u4f60\u7684\u624b\u673a\u97f3\u54cd\u5176\u5b9e\u88ab\u9501\u4f4f\u4e86",
  "preview_text": "\u4e00\u4e2a\u7b80\u5355\u8bbe\u7f6e\uff0c\u8ba9\u4f60\u7684\u97f3\u91cf\u7ffb\u500d\uff0c\u4f4e\u97f3\u66f4\u6c89\uff0c\u97f3\u8d28\u77ac\u95f4\u63d0\u5347\u2014\u201490%\u7684\u4eba\u4e0d\u77e5\u9053\u8fd9\u4e2a\u6280\u5de7\u3002",
  "body_paragraphs": [
    "\u60f3\u8c61\u4e00\u4e0b\uff0c\u4f60\u82b1\u4e86\u4e0a\u5343\u5757\u4e70\u624b\u673a\uff0c\u4f46\u5b83\u4e00\u76f4\u7528\u534a\u529f\u7387\u8fd0\u884c\u626c\u58f0\u5668\u3002\u8fd9\u4e0d\u662f\u4f60\u7684\u9519\u2014\u2014\u5382\u5546\u6545\u610f\u9650\u5236\u4e86\u97f3\u91cf\uff0c\u6015\u4f60\u70b8\u5f00\u8033\u6735\u3002\u4f46\u6211\u77e5\u9053\u4e00\u4e2a\u7ed5\u8fc7\u5b83\u7684\u65b9\u6cd5\uff0c\u800c\u4e14\u5c31\u5728\u4f60\u7684\u53e3\u888b\u91cc\u3002",
    "14\u5929\u524d\u4f60\u4e0b\u8f7d\u4e86Volume Booster\uff0c\u53ef\u80fd\u53ea\u662f\u70b9\u4e86\u4e00\u4e0b\u90a3\u4e2a\u5927\u6309\u94ae\u3002\u4f46\u90a3\u53ea\u662f\u51b0\u5c71\u4e00\u89d2\u3002\u771f\u6b63\u7684\u9b54\u6cd5\u85cf\u5728\u5747\u8861\u5668\u91cc\u2014\u2014\u90a3\u4e9b\u5199\u7740\u201cPop\u201d\u3001\u201cRock\u201d\u7684\u9884\u8bbe\u4e0d\u662f\u88c5\u9970\uff0c\u5b83\u4eec\u662f\u89e3\u9501\u6df1\u5c42\u4f4e\u97f3\u548c\u6e05\u6670\u5ea6\u7684\u94a5\u5319\u3002\u6bd4\u5982\uff0cJazz\u6a21\u5f0f\u80fd\u63d0\u5347\u4e2d\u9891\uff0c\u8ba9\u4f60\u5728\u5608\u6742\u5730\u94c1\u91cc\u542c\u6e05\u6bcf\u4e00\u4e2a\u64ad\u5ba2\u5355\u8bcd\uff1bElectronic\u6a21\u5f0f\u5219\u91ca\u653e\u9ad8\u9891\uff0c\u8ba9\u97f3\u4e50\u4e0d\u518d\u7cca\u6210\u4e00\u56e2\u3002",
    "\u6253\u5f00app\uff0c\u70b9\u51fb\u201c\u5747\u8861\u5668\u201d\uff0c\u8bd5\u8bd5\u201cBass Booster\u201d\u9884\u8bbe\u2014\u2014\u7136\u540e\u64ad\u653e\u4f60\u6700\u7231\u7684\u90a3\u9996\u4f4e\u97f3\u91cd\u7684\u6b4c\u3002\u4f60\u4f1a\u542c\u5230\u4e4b\u524d\u4ece\u672a\u6ce8\u610f\u5230\u7684\u7ec6\u8282\uff0c\u50cf\u7b2c\u4e00\u6b21\u6234\u4e0a\u964d\u566a\u8033\u673a\u3002\u8fd9\u4e0d\u662f\u7384\u5b66\uff0c\u662f\u9891\u7387\u8c03\u6574\u7684\u7269\u7406\u6548\u679c\u3002",
    "\u73b0\u5728\u5c31\u6253\u5f00Volume Booster\uff0c\u628a\u97f3\u91cf\u62c9\u5230150%\u4ee5\u4e0a\uff0c\u540c\u65f6\u9009\u4e00\u4e2a\u9884\u8bbe\u3002\u4f60\u7684\u8033\u6735\u4f1a\u611f\u8c22\u4f60\u3002P.S. \u5982\u679c\u4f60\u8bd5\u4e86\u201cRock\u201d\u9884\u8bbe\u542c\u5409\u4ed6solo\uff0c\u8bb0\u5f97\u544a\u8bc9\u6211\u4f60\u7684\u611f\u53d7\u2014\u2014\u6211\u4fdd\u8bc1\u4f60\u4f1a\u56de\u6765\u611f\u8c22\u6211\u3002"
