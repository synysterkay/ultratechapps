{
  "subject": "\u0648\u06c1 3 \u0645\u0646\u0679 \u062c\u0648 \u0622\u067e \u06a9\u06cc \u067e\u06cc\u0634 \u06af\u0648\u0626\u06cc\u0627\u06ba \u0628\u062f\u0644 \u062f\u06cc\u06ba \u06af\u06d2",
  "preview_text": "\u06a9\u06cc\u0627 \u0622\u067e \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 90% \u0635\u0627\u0631\u0641\u06cc\u0646 \u06cc\u06c1 \u063a\u0644\u0637\u06cc \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u061f \u06cc\u06c1 \u0627\u06cc\u06a9 \u0631\u0627\u0632 \u06c1\u06d2 \u062c\u0648 \u0622\u067e \u06a9\u06cc \u06a9\u0627\u0645\u06cc\u0627\u0628\u06cc \u06a9\u0648 10x \u06a9\u0631 \u062f\u06d2 \u06af\u0627\u06d4",
  "body_paragraphs": [
    "\u0645\u06cc\u06ba \u0646\u06d2 \u0633\u0648\u0686\u0627 \u062a\u06be\u0627 \u06a9\u06c1 \u0645\u06cc\u06ba \u0641\u0679\u0628\u0627\u0644 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0633\u0628 \u06a9\u0686\u06be \u062c\u0627\u0646\u062a\u0627 \u06c1\u0648\u06ba\u06d4 \u0644\u06cc\u06a9\u0646 \u062c\u0628 \u0645\u06cc\u06ba \u0646\u06d2 Predictify \u0645\u06cc\u06ba \u06cc\u06c1 \u0686\u0627\u0644 \u0622\u0632\u0645\u0627\u0626\u06cc \u062a\u0648 \u0645\u062c\u06be\u06d2 \u0627\u062d\u0633\u0627\u0633 \u06c1\u0648\u0627 \u06a9\u06c1 \u0645\u06cc\u06ba \u06a9\u062a\u0646\u0627 \u063a\u0644\u0637 \u062a\u06be\u0627\u06d4 \u06cc\u06c1 \u0635\u0631\u0641 3 \u0645\u0646\u0679 \u06a9\u0627 \u0645\u0639\u0645\u0648\u0644 \u06c1\u06d2\u060c \u0644\u06cc\u06a9\u0646 \u0627\u0633 \u0646\u06d2 \u0645\u06cc\u0631\u06d2 \u0645\u06cc\u0686 \u062f\u06cc\u06a9\u06be\u0646\u06d2 \u06a9\u0627 \u0627\u0646\u062f\u0627\u0632 \u06c1\u06cc \u0628\u062f\u0644 \u062f\u06cc\u0627\u06d4",
    "\u0628\u0627\u062a \u06cc\u06c1 \u06c1\u06d2 \u06a9\u06c1 \u0632\u06cc\u0627\u062f\u06c1 \u062a\u0631 \u0644\u0648\u06af \u0635\u0631\u0641 \u0627\u067e\u0646\u06cc \u062c\u0628\u0644\u062a \u067e\u0631 \u0628\u06be\u0631\u0648\u0633\u06c1 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u067e\u06be\u0631 \u062d\u06cc\u0631\u0627\u0646 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0627\u0646 \u06a9\u06cc \u067e\u06cc\u0634 \u06af\u0648\u0626\u06cc\u0627\u06ba \u06a9\u06cc\u0648\u06ba \u063a\u0644\u0637 \u06c1\u0648\u062a\u06cc \u06c1\u06cc\u06ba\u06d4 \u0644\u06cc\u06a9\u0646 Predictify \u06a9\u0627 \u0631\u0627\u0632 \u0688\u06cc\u0679\u0627 \u0645\u06cc\u06ba \u06c1\u06d2\u06d4 \u0631\u0648\u0632\u0627\u0646\u06c1 \u0635\u0631\u0641 3 \u0645\u0646\u0679 \u0644\u06af\u0627 \u06a9\u0631 AI \u06a9\u06cc \u062a\u062c\u0632\u06cc\u06c1 \u06a9\u0631\u062f\u06c1 \u0627\u0639\u062f\u0627\u062f \u0648 \u0634\u0645\u0627\u0631 \u062f\u06cc\u06a9\u06be\u06cc\u06ba\u2014\u062c\u06cc\u0633\u06d2 \u06a9\u06c1 xG\u060c \u062f\u0641\u0627\u0639\u06cc \u0637\u0627\u0642\u062a\u060c \u0627\u0648\u0631 \u062d\u0645\u0644\u06c1 \u0622\u0648\u0631 \u06a9\u0627\u0631\u06a9\u0631\u062f\u06af\u06cc\u2014\u0627\u0648\u0631 \u0622\u067e \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u06af\u06d2 \u06a9\u06c1 \u0622\u067e \u06a9\u06cc \u067e\u06cc\u0634 \u06af\u0648\u0626\u06cc\u0627\u06ba \u06a9\u062a\u0646\u06cc \u062f\u0631\u0633\u062a \u06c1\u0648 \u062c\u0627\u062a\u06cc \u06c1\u06cc\u06ba\u06d4",
    "\u06cc\u06c1 \u0645\u0639\u0645\u0648\u0644 \u0622\u067e \u06a9\u0648 'Confidence Scores' \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u062f\u06cc\u062a\u0627 \u06c1\u06d2\u060c \u062c\u06c1\u0627\u06ba \u0622\u067e \u062c\u0627\u0646 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 AI \u06a9\u0648 \u0627\u067e\u0646\u06cc \u067e\u06cc\u0634 \u06af\u0648\u0626\u06cc \u067e\u0631 \u06a9\u062a\u0646\u0627 \u06cc\u0642\u06cc\u0646 \u06c1\u06d2\u06d4 \u0627\u0648\u0631 \u0633\u0628 \u0633\u06d2 \u0627\u0686\u06be\u06cc \u0628\u0627\u062a\u061f \u0622\u067e 'IQ Quiz' \u0645\u06cc\u06ba \u062d\u0635\u06c1 \u0644\u06d2 \u06a9\u0631 \u0627\u067e\u0646\u06d2 \u0641\u0679\u0628\u0627\u0644 \u0639\u0644\u0645 \u06a9\u0648 \u0628\u06be\u06cc \u062c\u0627\u0646\u0686 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0644\u06cc\u0688\u0631 \u0628\u0648\u0631\u0688 \u067e\u0631 \u0686\u0691\u06be \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1 \u0633\u0628 \u0635\u0631\u0641 3 \u0645\u0646\u0679 \u0645\u06cc\u06ba \u0645\u0645\u06a9\u0646 \u06c1\u06d2\u06d4",
