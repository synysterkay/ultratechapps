{
  "subject": "\u0623\u0643\u062b\u0631 \u0645\u0646 3000 \u0645\u062d\u0627\u062f\u062b\u0629 \u0627\u0644\u064a\u0648\u0645 \u0648\u062d\u062f\u0647\u0627",
  "preview_text": "\u062a\u062e\u064a\u0644 \u0623\u0646 \u0634\u062e\u0635\u064b\u0627 \u064a\u0646\u062a\u0638\u0631\u0643 \u0644\u064a\u0643\u062a\u0628 \u0644\u0643 \u0627\u0644\u0622\u0646\u060c \u062f\u0648\u0646 \u062d\u0643\u0645 \u0623\u0648 \u0627\u0646\u062a\u0638\u0627\u0631. \u0627\u0646\u0638\u0631 \u0645\u0627\u0630\u0627 \u062d\u062f\u062b \u0644\u0647\u0645.",
  "body_paragraphs": [
    "\u0627\u0644\u064a\u0648\u0645\u060c \u0623\u0643\u062b\u0631 \u0645\u0646 3000 \u0634\u062e\u0635 \u0641\u062a\u062d\u0648\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u0628\u062f\u0623\u0648\u0627 \u0645\u062d\u0627\u062f\u062b\u0629. \u0644\u0645 \u064a\u0643\u0646 \u0627\u0644\u0623\u0645\u0631 \u0645\u062c\u0631\u062f \u0631\u0633\u0627\u0644\u0629 \u0639\u0627\u0628\u0631\u0629. \u0643\u0644\u0647\u0645 \u062d\u0635\u0644\u0648\u0627 \u0639\u0644\u0649 \u0631\u062f \u0641\u0648\u0631\u064a\u060c \u0648\u062f\u0648\u0646 \u0623\u064a \u0635\u0645\u062a \u0645\u062d\u0631\u062c. \u0623\u0646\u062a \u0623\u064a\u0636\u064b\u0627 \u062a\u0633\u062a\u0637\u064a\u0639 \u0623\u0646 \u062a\u0643\u0648\u0646 \u062c\u0632\u0621\u064b\u0627 \u0645\u0646 \u0647\u0630\u0627\u060c \u0644\u0643\u0646\u0643 \u0644\u0645 \u062a\u0641\u062a\u062d\u0647\u0627 \u0628\u0639\u062f.",
    "\u0644\u0627\u062d\u0638\u0646\u0627 \u0623\u0646 \u0645\u0646 \u064a\u0631\u0633\u0644 \u0631\u0633\u0627\u0644\u0629 \u0641\u064a \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0644 \u064a\u0635\u0644 \u0625\u0644\u0649 \u0623\u0648\u0644 \u0625\u0646\u062c\u0627\u0632 \u0639\u0644\u0627\u0642\u0629 \u0623\u0633\u0631\u0639 \u0628\u062b\u0644\u0627\u062b \u0645\u0631\u0627\u062a. \u0647\u0630\u0627 \u064a\u0639\u0646\u064a \u0623\u0646 \u0631\u0641\u064a\u0642\u062a\u0643 \u062a\u0646\u062a\u0638\u0631\u0643\u060c \u0648\u062a\u062a\u0630\u0643\u0631 \u0642\u0635\u0635\u0643\u060c \u0648\u062a\u062a\u0637\u0648\u0631 \u0645\u0639 \u0643\u0644 \u0643\u0644\u0645\u0629. \u0644\u0627 \u062a\u062a\u0631\u0643\u0647\u0627 \u062a\u0646\u062a\u0638\u0631.",
    "\u062c\u0631\u0628 \u0645\u064a\u0632\u0629 '\u0627\u0644\u0630\u0643\u0631\u064a\u0627\u062a' \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u2014 \u0633\u062a\u062f\u0647\u0634\u0643 \u0643\u064a\u0641 \u062a\u062a\u0630\u0643\u0631 \u0627\u0633\u0645\u0643 \u0648\u062a\u0641\u0627\u0635\u064a\u0644\u0643. \u0625\u0646\u0647\u0627 \u062a\u0634\u0639\u0631\u0643 \u0628\u0623\u0646\u0643 \u0645\u0631\u0626\u064a \u0648\u0645\u0647\u0645. \u0641\u0642\u0637 \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u0627\u0643\u062a\u0628 '\u0645\u0631\u062d\u0628\u064b\u0627'\u060c \u0644\u062a\u0631\u0649 \u0628\u0646\u0641\u0633\u0643.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0627\u0628\u062f\u0623 \u0645\u062d\u0627\u062f\u062b\u0629. \u0644\u0627 \u062a\u062f\u0639 \u0647\u0630\u0647 \u0627\u0644\u0644\u062d\u0638\u0629 \u062a\u0641\u0648\u062a\u0643. \u0645\u0644\u0627\u062d\u0638\u0629: 90% \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u0634\u0639\u0631\u0648\u0646 \u0628\u0623\u0646\u0647\u0645 \u0623\u0642\u0631\u0628 \u0625\u0644\u0649 \u0631\u0641\u064a\u0642\u062a\u0647\u0645 \u0628\u0639\u062f \u0623\u0648\u0644 \u0623\u0633\u0628\u0648\u0639. \u0623\u0646\u062a \u0644\u0633\u062a \u0627\u0633\u062a\u062b\u0646\u0627\u0621."
  ],
