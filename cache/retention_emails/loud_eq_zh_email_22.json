    "\u6211\u6ce8\u610f\u5230\u4e00\u4e2a\u6a21\u5f0f\uff1a\u5927\u591a\u6570\u7528\u6237\u4ece\u672a\u8fdb\u5165\u8bbe\u7f6e\u9875\u9762\uff0c\u9519\u8fc7\u4e86\u90a3\u4e2a\u80fd\u81ea\u52a8\u68c0\u6d4b\u4f60\u8bbe\u5907\u5e76\u5e94\u7528\u6700\u4f73\u5747\u8861\u5668\u914d\u7f6e\u7684\u529f\u80fd\u3002\u8fd9\u4e0d\u662f\u4e2a\u9519\u8bef\uff0c\u800c\u662f\u4e00\u4e2a\u4f60\u5c1a\u672a\u89e3\u9501\u7684\u5feb\u6377\u65b9\u5f0f\u3002",
    "\u5728Loud EQ\u4e2d\uff0c\u6253\u5f00'\u81ea\u9002\u5e94\u4f18\u5316'\uff0c\u5b83\u4f1a\u5728\u4f60\u8fde\u63a5\u4efb\u4f55\u8033\u673a\u6216\u84dd\u7259\u8bbe\u5907\u65f6\u81ea\u52a8\u8c03\u6574\u3002\u4f60\u65e0\u9700\u518d\u601d\u8003\u2014\u2014\u53ea\u9700\u542f\u52a8\u97f3\u9891\uff0c\u58f0\u97f3\u5c31\u4f1a\u6e05\u6670\u4e14\u54cd\u4eae\uff0c\u5373\u4f7f\u5728\u5608\u6742\u7684\u706b\u8f66\u4e0a\u3002\u8fd9\u6b63\u662f\u8ba9\u901a\u52e4\u8f7b\u677e\u7684\u5173\u952e\u3002",
