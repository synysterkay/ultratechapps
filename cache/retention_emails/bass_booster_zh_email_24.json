    "\u4ed6\u7528\u7684\u529f\u80fd\u5f88\u7b80\u5355\uff1a\u6253\u5f00 Bass Booster\uff0c\u628a\u589e\u5f3a\u6ed1\u5757\u62c9\u5230 80%\uff0c\u7136\u540e\u5207\u5230\u201c\u97f3\u4e50\u201d\u9884\u8bbe\u3002\u5c31\u8fd9\u6837\uff0c\u4e00\u9996\u6b4c\u8ba9\u4ed6\u4ece\u201c\u5c06\u5c31\u542c\u201d\u53d8\u6210\u201c\u5fc5\u987b\u5206\u4eab\u201d\u3002\u4f60\u4e0d\u662f\u9700\u8981\u4e00\u526f\u65b0\u8033\u673a\u3002\u4f60\u53ea\u9700\u8981\u8ba9\u65e7\u8bbe\u5907\uff0c\u7206\u53d1\u51fa\u5b83\u672c\u8be5\u6709\u7684\u58f0\u97f3\u3002",
