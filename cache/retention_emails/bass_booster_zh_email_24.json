  "preview_text": "\u4e00\u4e2a\u666e\u901a\u7528\u6237\u7684\u6545\u4e8b\uff0c\u8ba9\u6211\u4eec\u6574\u4e2a\u56e2\u961f\u505c\u4e0b\u5de5\u4f5c\u3002\u4ed6\u8bf4\u4e86\u4e00\u53e5\u8bdd\uff0c\u6539\u53d8\u4e86\u6211\u4eec\u770b\u5f85 Bass Booster \u7684\u65b9\u5f0f\u3002",
  "body_paragraphs": [
    "\u4e0a\u5468\u4e09\u51cc\u6668\u4e09\u70b9\uff0c\u6211\u4eec\u6536\u5230\u4e00\u6761\u7528\u6237\u6d88\u606f\u3002\u5185\u5bb9\u5f88\u77ed\uff0c\u53ea\u6709\u4e00\u53e5\u8bdd\uff0c\u5374\u8ba9\u6574\u4e2a\u56e2\u961f\u653e\u4e0b\u624b\u91cc\u7684\u5496\u5561\uff0c\u56f4\u5728\u4e00\u8d77\u8bfb\u4e86\u4e09\u904d\u3002",
