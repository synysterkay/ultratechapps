  "subject": "\u0648\u06c1 \u063a\u0644\u0637\u06cc \u062c\u0648 \u0645\u06cc\u06ba \u0646\u06d2 53 \u062f\u0646 \u062a\u06a9 \u06a9\u06cc",
  "preview_text": "\u067e\u06c1\u0644\u06d2 \u0645\u06cc\u06ba \u0627\u0646\u062f\u06be\u0627 \u062a\u06be\u0627\u060c \u0627\u0628 \u0645\u06cc\u06ba \u062f\u06cc\u06a9\u06be\u062a\u0627 \u06c1\u0648\u06ba\u06d4 \u06cc\u06c1 \u0641\u0631\u0642 \u0634\u0631\u0645\u0646\u0627\u06a9 \u06c1\u06d2\u06d4 \u06a9\u06cc\u0627 \u0622\u067e \u0628\u06be\u06cc \u0648\u06c1\u06cc \u063a\u0644\u0637\u06cc \u06a9\u0631 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba\u061f",
  "body_paragraphs": [
