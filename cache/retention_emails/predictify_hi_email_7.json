{
  "subject": "\u0935\u094b 2AM \u0915\u093e \u092e\u0948\u091a \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u091f\u094d\u0930\u093f\u0915 \u091c\u093f\u0938\u0928\u0947 \u092e\u0947\u0930\u0947 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u094b 10x \u0915\u0930 \u0926\u093f\u092f\u093e\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947\u0964",
  "body_paragraphs": [
    "\u092e\u0948\u0902 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0909\u0920\u093e \u0925\u093e\u0964 \u0906\u0901\u0916\u0947\u0902 \u0916\u0941\u0932\u0940, \u0926\u093f\u092e\u093e\u0917 \u091a\u093e\u0932\u0942\u0964 \u0938\u094b\u091a\u093e \u091a\u0932\u094b \u090f\u0915 \u092e\u0948\u091a \u0926\u0947\u0916 \u0932\u0947\u0902 \u2014 \u092c\u094d\u0930\u093e\u0917\u093e\u0902\u091f\u093f\u0928\u094b \u092c\u0928\u093e\u092e \u0907\u0902\u091f\u0930\u0928\u0948\u0936\u0928\u0932\u0964 \u0915\u094b\u0908 \u092c\u0921\u093c\u093e \u092e\u0948\u091a \u0928\u0939\u0940\u0902, \u0932\u0947\u0915\u093f\u0928 \u0915\u0941\u091b \u0905\u0932\u0917 \u0932\u0917\u093e\u0964 \u0924\u092d\u0940 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u091a\u0940\u091c\u093c \u0928\u094b\u091f\u093f\u0938 \u0915\u0940 \u091c\u094b \u092e\u0947\u0930\u0947 \u092a\u0942\u0930\u0947 \u0916\u0947\u0932 \u0915\u094b \u092c\u0926\u0932 \u0917\u0908\u0964",
    "\u0905\u0938\u0932 \u092e\u0947\u0902, \u092e\u0948\u0902 \u0939\u092e\u0947\u0936\u093e '\u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917' \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u0915\u0930\u0924\u093e \u0925\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u0909\u0938 \u0930\u093e\u0924, \u092e\u0948\u0902\u0928\u0947 \u0921\u0947\u091f\u093e \u0915\u094b \u0926\u0947\u0916\u093e \u2014 xG, \u092a\u0949\u091c\u093c\u0947\u0936\u0928, \u0921\u093f\u092b\u0947\u0902\u0938\u093f\u0935 \u0938\u094d\u091f\u094d\u0930\u0947\u0902\u0925\u0964 \u0914\u0930 \u092a\u093e\u092f\u093e \u0915\u093f \u0905\u0938\u0932\u0940 \u0935\u0948\u0932\u094d\u092f\u0942 \u0909\u0928 \u0906\u0902\u0915\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u091b\u093f\u092a\u0940 \u0939\u0948 \u091c\u094b \u0906\u092e \u092b\u0948\u0928 \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u0924\u093e\u0964 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u091f\u093f\u092a: \u0939\u0947\u0921-\u091f\u0942-\u0939\u0947\u0921 \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940 \u0915\u0947 \u0938\u093e\u0925-\u0938\u093e\u0925 '\u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930' \u0915\u094b \u0926\u0947\u0916\u0947\u0902\u0964 \u092f\u0939\u0940 \u0935\u094b \u0939\u0925\u093f\u092f\u093e\u0930 \u0939\u0948 \u091c\u094b \u092a\u094d\u0930\u094b \u092f\u0942\u091c\u093c\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",
    "Predictify \u092e\u0947\u0902 \u092f\u0939 \u0938\u092c \u092e\u093f\u0932\u0924\u093e \u0939\u0948 \u2014 \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f AI \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923, \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930, \u0914\u0930 \u0917\u0939\u0930\u0947 \u0906\u0902\u0915\u0921\u093c\u0947\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 '\u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u0938\u094d\u091f\u0948\u091f\u094d\u0938' \u091f\u0948\u092c \u0916\u094b\u0932\u0947\u0902\u0964 \u0906\u092a \u0926\u0947\u0916\u0947\u0902\u0917\u0947 \u0915\u093f \u0915\u0948\u0938\u0947 \u090f\u0915 59% \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0915\u0949\u0932 \u092d\u0940 \u0906\u092a\u0915\u094b 10x \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u092c\u0928\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u0905\u092a\u0928\u0947 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u094b \u0905\u0917\u0932\u0947 \u0932\u0947\u0935\u0932 \u092a\u0930 \u0932\u0947 \u091c\u093e\u0928\u0947 \u0915\u093e\u0964 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0906\u091c \u0915\u0947 \u0915\u093f\u0938\u0940 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f '\u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u090f\u0928\u093e\u0932\u093f\u0938\u093f\u0938' \u0926\u0947\u0916\u0947\u0902\u0964 P.S. \u2014 \u0905\u0917\u0930 \u0906\u092a \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0906\u091c\u093c\u092e\u093e\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0938\u093e\u0930\u0947 \u092a\u094d\u0930\u094b \u091f\u093f\u092a\u094d\u0938 \u0905\u0928\u0932\u0949\u0915 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u0938 3 \u0926\u093f\u0928 \u0915\u093e \u092b\u094d\u0930\u0940 \u091f\u094d\u0930\u093e\u092f\u0932 \u0939\u0948, \u0915\u094b\u0908 \u0930\u093f\u0938\u094d\u0915 \u0928\u0939\u0940\u0902\u0964"
  ],
