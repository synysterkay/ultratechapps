{
  "subject": "\u092f\u0939 \u090f\u0915 \u0917\u0932\u0924\u0940 \u0925\u0940 \u091c\u094b 90% \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902",
  "preview_text": "\u092e\u0948\u0902\u0928\u0947 \u092d\u0940 \u092f\u0939\u0940 \u0915\u093f\u092f\u093e \u0925\u093e, \u091c\u092c \u0924\u0915 \u092e\u0941\u091d\u0947 \u092f\u0939 \u0938\u091a\u094d\u091a\u093e\u0908 \u0928\u0939\u0940\u0902 \u092a\u0924\u093e \u091a\u0932\u0940\u0964 \u0906\u092a\u0915\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u093f\u092f\u093e\u0901 \u0905\u092d\u0940 \u092c\u0926\u0932\u0928\u0947 \u0935\u093e\u0932\u0940 \u0939\u0948\u0902\u0964",
  "body_paragraphs": [
    "\u092a\u0939\u0932\u0947 \u092e\u0948\u0902 \u092d\u0940 \u0938\u093f\u0930\u094d\u092b \u0938\u094d\u0915\u094b\u0930 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0926\u0947\u0916\u0924\u093e \u0925\u093e \u0914\u0930 \u092c\u093e\u0915\u0940 \u0938\u092c \u0907\u0917\u094d\u0928\u094b\u0930 \u0915\u0930 \u0926\u0947\u0924\u093e \u0925\u093e\u0964 \u092c\u0921\u093c\u0940 \u0917\u0932\u0924\u0940 \u0925\u0940\u0964 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0905\u0938\u0932\u0940 \u091c\u0940\u0924 \u0924\u094b Confidence Score \u0914\u0930 xG \u0921\u0947\u091f\u093e \u0915\u0947 \u092c\u0940\u091a \u091b\u0941\u092a\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948, \u0914\u0930 \u092e\u0948\u0902 \u0909\u0938\u0947 \u092e\u093f\u0938 \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964",
    "\u092f\u0939\u093e\u0901 \u0915\u093e \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u092f\u0939 \u0939\u0948: AI \u0938\u093f\u0930\u094d\u092b '3-1' \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u0924\u093e, \u092c\u0924\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0909\u0938\u0947 \u092f\u0939 \u0928\u0924\u0940\u091c\u093e 87% \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0915\u094d\u092f\u094b\u0902 \u092e\u093f\u0932 \u0930\u0939\u093e \u0939\u0948\u0964 \u0915\u093f\u0938 \u091f\u0940\u092e \u0915\u093e xG \u091c\u094d\u092f\u093e\u0926\u093e \u0939\u0948, \u0915\u094c\u0928 \u0938\u093e \u0921\u093f\u092b\u0947\u0902\u0938 \u0932\u0940\u0915 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964 \u092f\u0939 \u0921\u0947\u091f\u093e \u0939\u0940 \u0906\u092a\u0915\u094b \u0909\u0938 1 \u0935\u0948\u0932\u094d\u092f\u0942 \u092c\u0947\u091f \u0924\u0915 \u0932\u0947 \u091c\u093e\u0924\u093e \u0939\u0948 \u091c\u094b \u092c\u093e\u0915\u0940 \u0938\u092c \u092e\u093f\u0938 \u0915\u0930 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0905\u092c Predictify \u092e\u0947\u0902 \u091c\u093e\u090f\u0902 \u0914\u0930 \u0915\u093f\u0938\u0940 \u092d\u0940 \u092e\u0948\u091a \u0915\u0947 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u0928\u0940\u091a\u0947 \u0938\u094d\u0915\u094d\u0930\u0949\u0932 \u0915\u0930\u0947\u0902\u0964 \u0935\u0939\u093e\u0901 \u0906\u092a\u0915\u094b Confidence Score, \u0939\u0930 \u091f\u0940\u092e \u0915\u093e \u0905\u091f\u0948\u0915\u093f\u0902\u0917/\u0921\u093f\u092b\u0947\u0902\u0938\u093f\u0935 \u090f\u0928\u093e\u0932\u093f\u0938\u093f\u0938, \u0914\u0930 \u092a\u094d\u0932\u0947\u092f\u0930 xG \u092e\u093f\u0932\u0947\u0917\u093e\u0964 \u092f\u0939\u0940 \u0935\u094b \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u0938\u094d\u091f\u0948\u091f\u094d\u0938 \u0939\u0948\u0902 \u091c\u094b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092e\u0947\u0902 \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092e\u093f\u0932\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0928\u094d\u0939\u0947\u0902 \u0926\u0947\u0916\u0947 \u092c\u093f\u0928\u093e \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0905\u0927\u0942\u0930\u093e \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u090f\u0915 \u092e\u0948\u091a \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0909\u0938\u0915\u0947 \u0938\u093e\u0930\u0947 \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u0938\u094d\u091f\u0948\u091f\u094d\u0938 \u0916\u094b\u0932\u0915\u0930 \u0926\u0947\u0916\u0947\u0902\u0964 \u0906\u092a\u0915\u0940 \u0938\u094b\u091a \u092c\u0926\u0932 \u091c\u093e\u090f\u0917\u0940\u0964\n\nP.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0915\u0947 3-\u0926\u093f\u0928 \u0915\u0947 \u092b\u094d\u0930\u0940 \u091f\u094d\u0930\u093e\u092f\u0932 \u092e\u0947\u0902 \u092f\u0947 \u0938\u093e\u0930\u0947 \u0921\u0947\u091f\u093e \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092e\u093f\u0932\u0924\u0947 \u0939\u0948\u0902\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0907\u0938 \u0924\u0930\u0939 \u0938\u0947 \u090f\u0928\u093e\u0932\u093f\u0938\u093f\u0938 \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u093f\u090f, \u092b\u093f\u0930 \u092a\u0941\u0930\u093e\u0928\u0947 \u0924\u0930\u0940\u0915\u0947 \u092a\u0930 \u0935\u093e\u092a\u0938 \u091c\u093e\u0928\u093e \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0939\u094b\u0917\u093e\u0964"
  ],
