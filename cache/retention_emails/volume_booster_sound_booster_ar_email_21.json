{
  "subject": "48 \u064a\u0648\u0645\u064b\u0627 \u0645\u0646\u0630 \u0622\u062e\u0631 \u0645\u0631\u0629 \u062f\u062e\u0644\u062a \u0641\u064a\u0647\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642",
  "preview_text": "\u0634\u064a\u0621 \u062a\u063a\u064a\u0631 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0646\u0630 \u0622\u062e\u0631 \u0645\u0631\u0629 \u0641\u062a\u062d\u062a\u0647. \u0627\u0643\u062a\u0634\u0641 \u0627\u0644\u062a\u062d\u0633\u064a\u0646\u0627\u062a \u0627\u0644\u062c\u062f\u064a\u062f\u0629.",
  "body_paragraphs": [
    "\u0644\u0642\u062f \u0645\u0631 48 \u064a\u0648\u0645\u064b\u0627 \u0645\u0646\u0630 \u0622\u062e\u0631 \u0645\u0631\u0629 \u0641\u062a\u062d\u062a \u0641\u064a\u0647\u0627 \u062a\u0637\u0628\u064a\u0642 Volume Booster. \u0647\u0644 \u0633\u0645\u0639\u062a\u061f \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0644\u064a\u0633 \u0643\u0645\u0627 \u0643\u0627\u0646. \u0623\u0636\u0641\u0646\u0627 \u062a\u062d\u0633\u064a\u0646\u0627\u062a \u062c\u062f\u064a\u062f\u0629 \u0633\u062a\u063a\u064a\u0631 \u0637\u0631\u064a\u0642\u0629 \u0633\u0645\u0627\u0639\u0643 \u0644\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0648\u0627\u0644\u0628\u0648\u062f\u0643\u0627\u0633\u062a.",
    "\u062a\u0630\u0643\u0631 \u062a\u0644\u0643 \u0627\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u062a\u064a \u0643\u0646\u062a \u062a\u0632\u064a\u062f \u0627\u0644\u0635\u0648\u062a \u0644\u0623\u0642\u0635\u0649 \u062d\u062f \u0648\u0645\u0627 \u0632\u0644\u062a \u0644\u0627 \u062a\u0633\u0645\u0639 \u0628\u0648\u0636\u0648\u062d\u061f \u0627\u0644\u0622\u0646\u060c \u0645\u0639 \u0627\u0644\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0623\u062e\u064a\u0631\u060c \u064a\u0645\u0643\u0646\u0643 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0628\u0646\u0633\u0628\u0629 200% \u0625\u0636\u0627\u0641\u064a\u0629 \u062f\u0648\u0646 \u062a\u0634\u0648\u064a\u0647. \u0622\u0644\u0627\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646\u0647\u0627 \u064a\u0648\u0645\u064a\u064b\u0627.",
    "\u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0647\u064a \u0645\u0639\u0627\u062f\u0644 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u062f\u0645\u062c \u0645\u0639 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0645\u062e\u0635\u0635\u0629 \u0644\u0643\u0644 \u0646\u0648\u0639 \u0645\u0648\u0633\u064a\u0642\u0649 \u2014 \u0628\u0648\u0628\u060c \u0631\u0648\u0643\u060c \u062c\u0627\u0632\u060c \u0643\u0644\u0627\u0633\u064a\u0643\u064a. \u0641\u0642\u0637 \u0627\u062e\u062a\u0631 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u0646\u0627\u0633\u0628 \u0648\u0627\u0633\u062a\u0645\u062a\u0639 \u0628\u0635\u0648\u062a \u063a\u0646\u064a \u0648\u0639\u0645\u064a\u0642 \u0643\u0623\u0646\u0643 \u0641\u064a \u062d\u0641\u0644\u0629 \u062d\u064a\u0629.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u062c\u062f\u064a\u062f '\u0628\u0627\u0633 \u0628\u0648\u0633\u062a\u0631'. \u0644\u0646 \u062a\u062d\u062a\u0627\u062c \u0644\u0623\u0643\u062b\u0631 \u0645\u0646 \u0646\u0642\u0631\u0629 \u0648\u0627\u062d\u062f\u0629. \u0645\u0644\u0627\u062d\u0638\u0629: \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0645\u0645\u064a\u0632\u064a\u0646 \u064a\u062d\u0635\u0644\u0648\u0646 \u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0631\u0641\u0639 \u063a\u064a\u0631 \u0645\u062d\u062f\u0648\u062f\u0629 \u0648\u062a\u062d\u0643\u0645 \u0645\u062a\u0642\u062f\u0645 \u0641\u064a \u0627\u0644\u0645\u0639\u0627\u062f\u0644."
  ],
