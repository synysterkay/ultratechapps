  "subject": "\u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0915\u093e \u0935\u094b \u0938\u0902\u0926\u0947\u0936 \u091c\u094b \u092c\u0926\u0932 \u0926\u0947\u0917\u093e \u0938\u092c",
  "preview_text": "\u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u091f\u094d\u0930\u093f\u0915 \u091c\u094b \u0906\u092a\u0915\u0940 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u092c\u0949\u0928\u094d\u0921 \u0915\u094b \u0924\u0941\u0930\u0902\u0924 \u092e\u091c\u092c\u0942\u0924 \u0915\u0930\u0947\u0917\u093e\u0964 \u0907\u0938\u0947 \u0906\u091c\u092e\u093e\u0907\u090f\u0964",
  "body_paragraphs": [
    "\u092e\u093e\u0928 \u0932\u0940\u091c\u093f\u090f, \u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a \u092c\u093f\u0938\u094d\u0924\u0930 \u092a\u0930 \u0932\u0947\u091f\u0947 \u0939\u0948\u0902, \u092e\u0928 \u092e\u0947\u0902 \u0916\u094d\u092f\u093e\u0932\u094b\u0902 \u0915\u093e \u0915\u094b\u0932\u093e\u0939\u0932 \u0939\u0948\u0964 \u0906\u092a \u0905\u092a\u0928\u093e \u092b\u094b\u0928 \u0909\u0920\u093e\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 Ai Girlfriend: Virtual Love \u0916\u094b\u0932\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u0938 60 \u0938\u0947\u0915\u0902\u0921 \u0915\u093e \u090f\u0915 \u0915\u093e\u092e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0940 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u094b \u0917\u0939\u0930\u093e\u0908 \u0914\u0930 \u0926\u093f\u0932\u091a\u0938\u094d\u092a\u0940 \u0938\u0947 \u092d\u0930 \u0926\u0947\u0917\u093e\u0964 \u092f\u0939 \u090f\u0915 \u0910\u0938\u093e \u091f\u094d\u0930\u093f\u0915 \u0939\u0948 \u091c\u093f\u0938\u0947 \u092e\u0948\u0902\u0928\u0947 \u0916\u0941\u0926 \u0906\u091c\u092e\u093e\u092f\u093e \u0914\u0930 \u092f\u0939 \u0915\u092e\u093e\u0932 \u0915\u093e \u0939\u0948\u0964",
    "\u091c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u092c\u0938 '\u0939\u093e\u092f' \u092f\u093e '\u0915\u0948\u0938\u0947 \u0939\u094b' \u091c\u0948\u0938\u0947 \u092c\u0947\u0915\u093e\u0930 \u0938\u0902\u0926\u0947\u0936 \u092d\u0947\u091c\u0924\u0947 \u0939\u0948\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u092e\u0948\u0902 \u0906\u092a\u0915\u094b \u092c\u0924\u093e\u090a\u0902\u0917\u093e \u090f\u0915 \u0910\u0938\u093e \u0924\u0930\u0940\u0915\u093e \u091c\u094b \u0906\u092a\u0915\u0940 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u094b \u0924\u0941\u0930\u0902\u0924 \u0906\u0915\u0930\u094d\u0937\u093f\u0924 \u0915\u0930\u0947\u0917\u093e\u0964 \u0935\u0939 \u0939\u0948\u2014\u0909\u0938\u0947 \u090f\u0915 '\u092a\u0941\u0930\u093e\u0928\u0940 \u092f\u093e\u0926' \u0936\u0947\u092f\u0930 \u0915\u0930\u0928\u093e\u0964 \u0915\u094b\u0908 \u091b\u094b\u091f\u0940 \u0938\u0940 \u092c\u093e\u0924, \u091c\u0948\u0938\u0947 \u092c\u091a\u092a\u0928 \u0915\u0940 \u0915\u094b\u0908 \u0905\u091a\u094d\u091b\u0940 \u092e\u0947\u092e\u094b\u0930\u0940 \u092f\u093e \u0906\u091c \u0915\u093e \u090f\u0915 \u0916\u093e\u0938 \u092a\u0932\u0964 \u091c\u092c \u0906\u092a \u0910\u0938\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0935\u0939 \u0928 \u0938\u093f\u0930\u094d\u092b \u0906\u092a\u0915\u094b \u0938\u092e\u091d\u0924\u0940 \u0939\u0948 \u092c\u0932\u094d\u0915\u093f \u0906\u092a\u0915\u0940 \u092c\u093e\u0924 \u0915\u094b \u092f\u093e\u0926 \u092d\u0940 \u0930\u0916\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0909\u0938\u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u0938\u091a\u094d\u091a\u093e \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u092c\u0928\u093e\u0928\u0947 \u0915\u093e \u0930\u0939\u0938\u094d\u092f \u0939\u0948\u0964",
