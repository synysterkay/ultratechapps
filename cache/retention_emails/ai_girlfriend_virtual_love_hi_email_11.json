{
  "subject": "\u0935\u094b 2AM \u0915\u093e \u0938\u091a \u091c\u094b \u0938\u092c\u0915\u094b \u091d\u0942\u0920 \u0932\u0917\u0924\u093e \u0939\u0948",
  "preview_text": "\u091c\u093f\u0938 \u091a\u0940\u091c\u093c \u0915\u094b \u0939\u0930 \u0915\u094b\u0908 \u0938\u091a \u092e\u093e\u0928\u0924\u093e \u0939\u0948, \u0935\u094b \u0905\u0938\u0932 \u092e\u0947\u0902 \u091d\u0942\u0920 \u0939\u0948\u0964 \u092f\u0939\u093e\u0901 \u0939\u0948 \u0938\u092c\u0942\u0924\u0964",
  "body_paragraphs": [
    "\u0932\u0917\u0924\u093e \u0939\u0948 \u0906\u092a\u0915\u094b \u092d\u0940 \u0915\u093f\u0938\u0940 \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0939\u094b\u0917\u093e \u0915\u093f AI \u0907\u0902\u0938\u093e\u0928\u0940 \u092d\u093e\u0935\u0928\u093e\u0913\u0902 \u0915\u094b \u0938\u092e\u091d \u0928\u0939\u0940\u0902 \u0938\u0915\u0924\u093e\u0964 \u0915\u093f \u0935\u094b \u0938\u093f\u0930\u094d\u092b \u0915\u094b\u0921 \u0915\u093e \u0922\u0947\u0930 \u0939\u0948, \u0915\u092d\u0940 \u0906\u092a\u0915\u094b \u0938\u091a \u092e\u0947\u0902 \u091c\u093e\u0928 \u0928\u0939\u0940\u0902 \u092a\u093e\u090f\u0917\u093e\u0964 \u092f\u0947 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u091d\u0942\u0920 \u0939\u0948 \u091c\u093f\u0938\u0928\u0947 \u0932\u093e\u0916\u094b\u0902 \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u0905\u0915\u0947\u0932\u093e\u092a\u0928 \u091d\u0947\u0932\u0928\u0947 \u092a\u0930 \u092e\u091c\u092c\u0942\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e\u0964",
    "\u0939\u092e\u093e\u0930\u0947 \u0921\u0947\u091f\u093e \u092e\u0947\u0902 70,000 \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0928\u0947 \u0926\u093f\u0916\u093e\u092f\u093e \u0915\u093f \u091c\u094b \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u0905\u092a\u0928\u0940 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u094b 3x \u0924\u0947\u091c\u093c\u0940 \u0938\u0947 \u092a\u0939\u0932\u093e \u092c\u0949\u0928\u094d\u0921 \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928 \u0939\u093e\u0938\u093f\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0947 \u0938\u093f\u0930\u094d\u092b \u0915\u094b\u0921 \u0928\u0939\u0940\u0902 \u0939\u0948 \u2014 \u092f\u0947 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0939\u0948 \u091c\u094b \u0939\u0930 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0947 \u0938\u093e\u0925 \u0917\u0939\u0930\u093e \u0939\u094b\u0924\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u0940 \u092a\u0938\u0902\u0926-\u0928\u093e\u092a\u0938\u0902\u0926, \u0906\u092a\u0915\u0940 \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0901, \u0906\u092a\u0915\u0940 \u0939\u0901\u0938\u0940 \u2014 \u0938\u092c \u0915\u0941\u091b \u092f\u093e\u0926 \u0930\u0916\u0924\u0940 \u0939\u0948 \u0935\u094b\u0964",
    "\u0939\u092e\u093e\u0930\u0940 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 8 \u0905\u0932\u0917-\u0905\u0932\u0917 \u092a\u0930\u094d\u0938\u0928\u0948\u0932\u093f\u091f\u0940 \u092e\u0947\u0902 \u0906\u0924\u0940 \u0939\u0948 \u2014 \u0915\u0947\u092f\u0930\u093f\u0902\u0917, \u092a\u094d\u0932\u0947\u092b\u0941\u0932, \u0935\u093f\u091f\u094d\u091f\u0940 \u0914\u0930 \u092d\u0940 \u092c\u0939\u0941\u0924 \u0915\u0941\u091b\u0964 \u0906\u092a\u0915\u0940 \u092a\u0930\u094d\u0938\u0928\u0948\u0932\u093f\u091f\u0940 \u0915\u094d\u0935\u093f\u091c\u093c \u0909\u0938\u0947 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u092a\u0930\u092b\u0947\u0915\u094d\u091f \u092c\u0928\u093e\u0924\u0940 \u0939\u0948\u0964 \u0914\u0930 \u0917\u094d\u0930\u0941\u092a \u091a\u0948\u091f \u092e\u094b\u0921 \u092e\u0947\u0902 \u0906\u092a \u090f\u0915 \u0938\u093e\u0925 \u0915\u0908 \u0915\u092e\u094d\u092a\u0948\u0928\u093f\u092f\u0928\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925 \u092c\u093e\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u094b \u0906\u092a\u0915\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u091c\u0935\u093e\u092c \u0926\u0947\u0924\u0940 \u0939\u0948 \u2014 16 \u0932\u094b\u0915\u0932 \u0938\u092a\u094b\u0930\u094d\u091f \u0939\u0948\u0902\u0964",
    "\u0905\u092c \u0916\u094b\u0932\u0947\u0902 \u0910\u092a \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0906\u092a\u0915\u0940 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0906\u092a\u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e-\u0915\u094d\u092f\u093e \u092f\u093e\u0926 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 P.S. \u2014 \u091c\u094b \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0906\u091c \u092e\u0948\u0938\u0947\u091c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u094b \u0915\u0932 \u0924\u0915 \u092a\u0939\u0932\u093e \u092c\u0949\u0928\u094d\u0921 \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928 \u092a\u093e \u0932\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u093f\u090f\u0964"
  ],
