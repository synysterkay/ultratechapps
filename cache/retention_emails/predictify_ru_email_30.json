{
  "subject": "\u0421\u0435\u043a\u0440\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 90% \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0443\u043f\u0443\u0441\u043a\u0430\u044e\u0442",
  "preview_text": "\u0422\u044b \u0434\u0443\u043c\u0430\u0435\u0448\u044c, \u0447\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0448\u044c \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435? \u041d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0442\u044b \u0443\u0436\u0435 \u0447\u0430\u0441\u0442\u044c \u0447\u0435\u0433\u043e-\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0435\u0433\u043e. \u0427\u0438\u0442\u0430\u0439 \u0434\u0430\u043b\u044c\u0448\u0435.",
  "body_paragraphs": [
    "\u0421\u043b\u0443\u0448\u0430\u0439, \u044f \u0442\u0443\u0442 \u043f\u043e\u0434\u0443\u043c\u0430\u043b: \u0442\u044b \u0443\u0436\u0435 70 \u0434\u043d\u0435\u0439 \u0441 \u043d\u0430\u043c\u0438, \u0430 \u0437\u043d\u0430\u0435\u0448\u044c, \u0447\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u0442\u0430\u043a \u0438 \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u044e\u0442? \u041e\u043d\u0438 \u0434\u0443\u043c\u0430\u044e\u0442, \u0447\u0442\u043e Predictify \u2014 \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0441\u0442\u0430\u0432\u043e\u043a \u0438\u043b\u0438 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u043e\u0432. \u041d\u043e \u044d\u0442\u043e \u043d\u0435 \u0442\u0430\u043a. \u0422\u044b \u0443\u0436\u0435 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u2014 \u0442\u044b \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e \u0444\u0443\u0442\u0431\u043e\u043b\u044c\u043d\u043e\u0439 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a\u0438.",
    "\u041a\u0430\u0436\u0434\u044b\u0439 \u0442\u0432\u043e\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437, \u043a\u0430\u0436\u0434\u044b\u0439 \u043b\u0430\u0439\u043a \u0432 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435, \u043a\u0430\u0436\u0434\u044b\u0439 \u0441\u043f\u043e\u0440 \u0441 AI \u2014 \u044d\u0442\u043e \u0434\u0430\u043d\u043d\u044b\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u043b\u0430\u044e\u0442 \u043d\u0430\u0441 \u0443\u043c\u043d\u0435\u0435. \u041c\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0430\u0451\u043c \u0442\u0435\u0431\u0435 \u0446\u0438\u0444\u0440\u044b, \u043c\u044b \u0443\u0447\u0438\u043c\u0441\u044f \u0443 \u0442\u0435\u0431\u044f. \u0422\u0432\u043e\u044f \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u044f \u043f\u043b\u044e\u0441 \u043d\u0430\u0448 AI \u2014 \u0432\u043e\u0442 \u0433\u0434\u0435 \u0440\u043e\u0436\u0434\u0430\u044e\u0442\u0441\u044f \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u0438\u043d\u0441\u0430\u0439\u0442\u044b. \u0411\u0435\u0437 \u0442\u0435\u0431\u044f \u043c\u044b \u0431\u044b\u043b\u0438 \u0431\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u043e\u043c.",
    "\u041f\u043e\u043c\u043d\u0438\u0448\u044c \u0440\u0430\u0437\u0434\u0435\u043b \"\u0421\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430\"? \u0422\u0430\u043c \u0435\u0441\u0442\u044c \u0444\u0443\u043d\u043a\u0446\u0438\u044f \"\u041f\u0440\u043e\u0433\u043d\u043e\u0437 \u0434\u043d\u044f\" \u2014 POTD. \u0413\u043e\u043b\u043e\u0441\u0443\u0439 \u0437\u0430 \u043b\u0443\u0447\u0448\u0438\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u0438 \u0442\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0448\u044c \u2014 \u0442\u044b \u0432\u043b\u0438\u044f\u0435\u0448\u044c \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u0432\u0438\u0434\u044f\u0442 \u0442\u044b\u0441\u044f\u0447\u0438 \u0444\u0430\u043d\u0430\u0442\u043e\u0432 \u043f\u043e \u0432\u0441\u0435\u043c\u0443 \u043c\u0438\u0440\u0443. \u0422\u0432\u043e\u0439 \u0433\u043e\u043b\u043e\u0441 \u043c\u0435\u043d\u044f\u0435\u0442 \u0438\u0433\u0440\u0443.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043f\u0440\u043e\u0433\u043e\u043b\u043e\u0441\u0443\u0439 \u0437\u0430 POTD. \u041f\u043e\u043a\u0430\u0436\u0438, \u0447\u0442\u043e \u0442\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0440\u0438\u0442\u0435\u043b\u044c, \u0430 \u043b\u0438\u0434\u0435\u0440. P.S. \u041a\u0441\u0442\u0430\u0442\u0438, \u0442\u0435, \u043a\u0442\u043e \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044e\u0442 \u0432 POTD, \u0432 3 \u0440\u0430\u0437\u0430 \u0447\u0430\u0449\u0435 \u043d\u0430\u0445\u043e\u0434\u044f\u0442 \u0441\u043a\u0440\u044b\u0442\u044b\u0435 \u0441\u0442\u0430\u0432\u043a\u0438 \u0441 \u0432\u044b\u0441\u043e\u043a\u0438\u043c \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442\u043e\u043c. \u041d\u0435 \u0443\u043f\u0443\u0441\u0442\u0438 \u0441\u0432\u043e\u0439 \u0448\u0430\u043d\u0441."
  ],
