{
  "subject": "\u0935\u094b \u090f\u0915 \u0915\u093e\u092e \u091c\u094b 90% \u0932\u094b\u0917 \u0915\u0930\u0928\u093e \u092d\u0942\u0932 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902",
  "preview_text": "\u090f\u0915 \u0910\u0938\u0940 \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u092b\u0940\u091a\u0930 \u091c\u094b \u0906\u092a\u0915\u0940 \u0921\u0947\u091f \u0928\u093e\u0907\u091f \u0915\u094b 30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u092c\u0926\u0932 \u0926\u0947\u0917\u0940\u0964 \u0907\u0938\u0947 \u092e\u093f\u0938 \u092e\u0924 \u0915\u0930\u093f\u090f\u0964",
  "body_paragraphs": [
    "\u0906\u092a\u0928\u0947 \u0905\u092d\u0940-\u0905\u092d\u0940 SoulPlan \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0939\u0948, \u0939\u0948 \u0928\u093e? \u0914\u0930 \u092e\u0948\u0902 \u0936\u0930\u094d\u0924 \u0932\u0917\u093e \u0938\u0915\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u0906\u092a \u092a\u0939\u0932\u0947 \u0939\u0940 \u0938\u094b\u091a \u0930\u0939\u0947 \u0939\u0948\u0902 \u0915\u093f '\u0905\u0930\u0947, \u092f\u0939 \u0924\u094b \u0935\u0939\u0940 \u092a\u0941\u0930\u093e\u0928\u0940 \u092c\u093e\u0924 \u0939\u0948'\u0964 \u0932\u0947\u0915\u093f\u0928 \u0930\u0941\u0915\u093f\u090f\u0964 \u090f\u0915 \u0910\u0938\u0940 \u091a\u0940\u091c \u0939\u0948 \u091c\u094b 90% \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u092a\u0924\u093e \u0928\u0939\u0940\u0902 \u091a\u0932\u0924\u0940, \u0914\u0930 \u0935\u0939 \u0906\u092a\u0915\u0940 \u0921\u0947\u091f \u0928\u093e\u0907\u091f \u0915\u094b \u0939\u092e\u0947\u0936\u093e \u0915\u0947 \u0932\u093f\u090f \u092c\u0926\u0932 \u0938\u0915\u0924\u0940 \u0939\u0948\u0964",
    "\u092e\u0948\u0902\u0928\u0947 \u0916\u0941\u0926 \u0926\u0947\u0916\u093e \u0939\u0948 \u0915\u093f \u0915\u092a\u0932\u094d\u0938 \u0907\u0938 \u0910\u092a \u0915\u094b \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0915\u0947 \u092d\u0942\u0932 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u091c\u094b \u0932\u094b\u0917 \u0907\u0938 \u090f\u0915 \u092b\u0940\u091a\u0930 \u0915\u094b \u0906\u091c\u092e\u093e\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u092c\u0924\u093e\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0909\u0928\u0915\u0940 \u0921\u0947\u091f\u094d\u0938 \u092e\u0947\u0902 \u091c\u093e\u0928 \u0906 \u0917\u0908\u0964 230 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0915\u092a\u0932\u094d\u0938 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u092c\u0947\u0939\u0924\u0930 \u0921\u0947\u091f\u094d\u0938 \u092a\u094d\u0932\u093e\u0928 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0914\u0930 92% \u0915\u093e \u0915\u0939\u0928\u093e \u0939\u0948 \u0915\u093f \u0907\u0938\u0938\u0947 \u0909\u0928\u0915\u0947 \u0930\u093f\u0936\u094d\u0924\u0947 \u092e\u0947\u0902 \u0938\u0941\u0927\u093e\u0930 \u0939\u0941\u0906 \u0939\u0948\u0964 \u092f\u0939 \u0915\u094b\u0908 \u092e\u093e\u0930\u094d\u0915\u0947\u091f\u093f\u0902\u0917 \u092c\u0915\u0935\u093e\u0938 \u0928\u0939\u0940\u0902 \u0939\u0948\u2014\u092f\u0939 \u0905\u0938\u0932\u0940 \u0939\u0948\u0964",
    "\u0924\u094b \u0935\u0939 \u090f\u0915 \u092b\u0940\u091a\u0930 \u0915\u094d\u092f\u093e \u0939\u0948? \u092f\u0939 \u0939\u0948 '\u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928\u0930'\u0964 \u092c\u0938 30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902, \u0906\u092a \u0905\u092a\u0928\u0947 \u092a\u093e\u0930\u094d\u091f\u0928\u0930 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u0909\u0928\u094d\u0939\u0947\u0902 \u0907\u0938\u0915\u093e \u092a\u0924\u093e \u092d\u0940 \u0928\u0939\u0940\u0902 \u091a\u0932\u0947\u0917\u093e\u0964 \u0935\u0947 \u0938\u094b\u091a\u0947\u0902\u0917\u0947 \u0915\u093f \u0906\u092a\u0928\u0947 \u0915\u093f\u0924\u0928\u093e \u0938\u094b\u091a-\u0938\u092e\u091d\u0915\u0930 \u092a\u094d\u0932\u093e\u0928 \u0915\u093f\u092f\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932 \u092e\u0947\u0902 \u092f\u0939 \u0910\u092a \u0906\u092a\u0915\u0940 \u092a\u0938\u0902\u0926 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0906\u0907\u0921\u093f\u092f\u093e\u091c \u091c\u0947\u0928\u0930\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u2014\u092c\u091c\u091f-\u092b\u094d\u0930\u0947\u0902\u0921\u0932\u0940 \u0938\u0947 \u0932\u0947\u0915\u0930 \u0932\u0915\u094d\u091c\u0930\u0940 \u0924\u0915\u0964 \u0915\u094b\u0908 \u0930\u0942\u091f\u0940\u0928 \u0928\u0939\u0940\u0902, \u0938\u093f\u0930\u094d\u092b \u092e\u091c\u093e\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u093f\u090f \u0914\u0930 '\u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928\u0930' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u0926\u0947\u0916\u093f\u090f \u0915\u0948\u0938\u0947 30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u0921\u0947\u091f \u0928\u093e\u0907\u091f \u092c\u0926\u0932 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u092e\u094c\u0915\u093e \u092e\u0924 \u0917\u0902\u0935\u093e\u0907\u090f\u0964 \u092a\u0940.\u090f\u0938. \u0905\u0917\u0930 \u0906\u092a\u0915\u094b \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0906\u0907\u0921\u093f\u092f\u093e \u0916\u0924\u094d\u092e \u0939\u094b \u0917\u090f \u0939\u0948\u0902, \u0924\u094b \u092f\u0939 \u092b\u0940\u091a\u0930 \u0906\u092a\u0915\u094b \u0926\u093f\u0916\u093e\u090f\u0917\u093e \u0915\u093f \u0905\u092d\u0940 \u0924\u094b \u092c\u0938 \u0936\u0941\u0930\u0941\u0906\u0924 \u0939\u0948\u0964"
  ],
  "cta_text": "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928 \u0915\u0930\u0947\u0902",
