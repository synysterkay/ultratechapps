{
  "subject": "\u0997\u09cb\u09aa\u09a8 \u09b6\u09b0\u09cd\u099f\u0995\u09be\u099f \u09af\u09be \u09ef\u09e6% \u0987\u0989\u099c\u09be\u09b0 \u099c\u09be\u09a8\u09c7 \u09a8\u09be",
  "preview_text": "\u0986\u09ae\u09be\u09b0 \u098f\u0995\u099f\u09be \u09ac\u09dc \u09ad\u09c1\u09b2 \u099b\u09bf\u09b2, \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u098f\u0996\u09a8 \u09a0\u09bf\u0995 \u0995\u09b0\u09c7\u099b\u09bf\u0964 \u09a4\u09c1\u09ae\u09bf \u0995\u09bf \u099c\u09be\u09a8\u09cb \u098f\u0987 \u09ab\u09bf\u099a\u09be\u09b0\u099f\u09be?",
  "body_paragraphs": [
    "\u0986\u09ae\u09be\u09b0 \u098f\u0995\u099f\u09be \u09ac\u09dc \u09ad\u09c1\u09b2 \u099b\u09bf\u09b2\u0964 \u09aa\u09cd\u09b0\u09a5\u09ae \u0995\u09df\u09c7\u0995 \u09ae\u09be\u09b8 \u0986\u09ae\u09bf \u09b6\u09c1\u09a7\u09c1 \u09ac\u09c7\u09b8\u09bf\u0995 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u09a6\u09c7\u0996\u09a4\u09be\u09ae, \u0986\u09b0 \u09ad\u09be\u09ac\u09a4\u09be\u09ae \u098f\u09a4\u09c7\u0987 \u09af\u09a5\u09c7\u09b7\u09cd\u099f\u0964 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09a4\u09be\u09b0\u09aa\u09b0 \u098f\u0995\u09a6\u09bf\u09a8 \u0986\u09ae\u09bf \u0986\u09ac\u09bf\u09b7\u09cd\u0995\u09be\u09b0 \u0995\u09b0\u09b2\u09be\u09ae \u098f\u0995\u099f\u09be \u0997\u09cb\u09aa\u09a8 \u09b6\u09b0\u09cd\u099f\u0995\u09be\u099f\u2014\u09af\u09c7\u099f\u09be \u09aa\u09c7\u09b6\u09be\u09a6\u09be\u09b0 \u0987\u0989\u099c\u09be\u09b0\u09b0\u09be \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7, \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0995\u09c7\u0989 \u0995\u0996\u09a8\u09cb \u09ac\u09b2\u09c7 \u09a8\u09be\u0964 \u098f\u0987 \u09b6\u09b0\u09cd\u099f\u0995\u09be\u099f\u099f\u09be \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u09aa\u09b0 \u0986\u09ae\u09be\u09b0 \u099c\u09df\u09c7\u09b0 \u09b9\u09be\u09b0 \u09ea\u09e6% \u09ac\u09c7\u09dc\u09c7 \u0997\u09c7\u099b\u09c7\u0964 \u09b6\u09c1\u09a7\u09c1 \u099c\u09c7\u09a4\u09be \u09a8\u09df, \u09ac\u09cb\u099d\u09be\u09b0 \u09ae\u09be\u09a4\u09cd\u09b0\u09be \u09ac\u09a6\u09b2\u09c7 \u0997\u09c7\u099b\u09c7\u0964",
    "\u09a4\u09c1\u09ae\u09bf \u0995\u09bf \u0995\u0996\u09a8\u09cb \u09ad\u09c7\u09ac\u09c7\u099b\u09cb, \u0995\u09c7\u09a8 \u0995\u09bf\u099b\u09c1 \u0987\u0989\u099c\u09be\u09b0 \u09b8\u09ac\u09b8\u09ae\u09df \u09b8\u09a0\u09bf\u0995 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u09a6\u09c7\u09df? \u0995\u09be\u09b0\u09a3 \u09a4\u09be\u09b0\u09be \u09b6\u09c1\u09a7\u09c1 AI-\u09b0 \u09b8\u09cd\u0995\u09cb\u09b0 \u09a6\u09c7\u0996\u09c7 \u09a8\u09be, \u09a4\u09be\u09b0\u09be \u09a1\u09c7\u099f\u09be\u09b0 \u0997\u09ad\u09c0\u09b0\u09c7 \u09a1\u09c1\u09ac \u09a6\u09c7\u09df\u0964 Predictify-\u09a4\u09c7 \u098f\u0995\u099f\u09be \u09ab\u09bf\u099a\u09be\u09b0 \u0986\u099b\u09c7\u2014\u098f\u09a1\u09ad\u09be\u09a8\u09cd\u09b8\u09a1 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u099f\u09b8 \u099f\u09cd\u09af\u09be\u09ac\u0964 \u09b8\u09c7\u0996\u09be\u09a8\u09c7 xG, \u09aa\u099c\u09c7\u09b6\u09a8, \u09a1\u09bf\u09ab\u09c7\u09a8\u09cd\u09b8\u09bf\u09ad \u09b8\u09cd\u099f\u09cd\u09b0\u09c7\u09a8\u09cd\u09a5\u2014\u098f\u0987 \u09b8\u09ac \u09a1\u09c7\u099f\u09be \u0998\u09be\u0981\u099f\u09b2\u09c7 \u09a4\u09c1\u09ae\u09bf \u09ac\u09c1\u099d\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7 \u0995\u09c7\u09a8 \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u09ab\u09b2\u09be\u09ab\u09b2 \u0986\u09b8\u099b\u09c7\u0964 \u098f\u099f\u09be \u0995\u09cb\u09a8\u09cb \u099c\u09be\u09a6\u09c1 \u09a8\u09df, \u098f\u099f\u09be \u09a1\u09c7\u099f\u09be \u09b8\u09be\u09df\u09c7\u09a8\u09cd\u09b8\u0964",
    "\u0986\u09ae\u09be\u09b0 \u09aa\u09cd\u09b0\u09bf\u09df \u09b6\u09b0\u09cd\u099f\u0995\u09be\u099f\u099f\u09be \u09b9\u09b2\u09cb: \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u0986\u0997\u09c7 AI \u099a\u09cd\u09af\u09be\u099f\u09c7 \u0997\u09bf\u09df\u09c7 \u099c\u09bf\u099c\u09cd\u099e\u09c7\u09b8 \u0995\u09b0\u09cb '\u098f\u0987 \u09ae\u09cd\u09af\u09be\u099a\u09c7 \u0995\u09cb\u09a8 \u09a6\u09b2\u09c7\u09b0 \u09aa\u099c\u09c7\u09b6\u09a8 \u09ac\u09c7\u09b6\u09bf \u09b9\u09ac\u09c7?' \u0985\u09a5\u09ac\u09be '\u0995\u09cb\u09a8 \u0996\u09c7\u09b2\u09cb\u09df\u09be\u09dc\u09c7\u09b0 xG \u09ac\u09c7\u09b6\u09bf?'\u0964 AI-\u09b0 \u0989\u09a4\u09cd\u09a4\u09b0 \u0986\u09b8\u09c7 \u09b8\u09c7\u0995\u09c7\u09a8\u09cd\u09a1\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7, \u0986\u09b0 \u09a4\u09c1\u09ae\u09bf \u09aa\u09c7\u09df\u09c7 \u09af\u09be\u0993 \u09aa\u09c7\u09b6\u09be\u09a6\u09be\u09b0 \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u0995\u09a6\u09c7\u09b0 \u09ae\u09a4\u09cb \u09a4\u09a5\u09cd\u09af\u0964 \u09ac\u09c7\u09b6\u09bf\u09b0\u09ad\u09be\u0997 \u0987\u0989\u099c\u09be\u09b0 \u098f\u0987 \u09ab\u09bf\u099a\u09be\u09b0\u099f\u09be \u098f\u09dc\u09bf\u09df\u09c7 \u09af\u09be\u09df, \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09aa\u09be\u0993\u09df\u09be\u09b0 \u0987\u0989\u099c\u09be\u09b0\u09b0\u09be \u098f\u099f\u09be \u09a6\u09bf\u09df\u09c7 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c7\u0964",
    "\u098f\u0996\u09a8\u0987 \u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09c7 '\u098f\u09a1\u09ad\u09be\u09a8\u09cd\u09b8\u09a1 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u099f\u09b8' \u099f\u09cd\u09af\u09be\u09ac\u09c7 \u09af\u09be\u0993\u0964 \u098f\u0995\u099f\u09bf \u09ae\u09cd\u09af\u09be\u099a \u09b8\u09bf\u09b2\u09c7\u0995\u09cd\u099f \u0995\u09b0\u09cb, \u0986\u09b0 \u09a6\u09c7\u0996\u09cb \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u09a1\u09c7\u099f\u09be \u09a4\u09cb\u09ae\u09be\u09b0 \u099a\u09cb\u0996 \u0996\u09c1\u09b2\u09c7 \u09a6\u09c7\u09df\u0964 \u09af\u09a6\u09bf \u09a4\u09c1\u09ae\u09bf \u0986\u09b0\u0993 \u0997\u09ad\u09c0\u09b0\u09c7 \u09af\u09c7\u09a4\u09c7 \u099a\u09be\u0993, \u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09df\u09be\u09ae \u099f\u09cd\u09b0\u09be\u09df\u09be\u09b2\u099f\u09be \u09a8\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09cb\u2014\u09ae\u09be\u09a4\u09cd\u09b0 \u09e9 \u09a6\u09bf\u09a8\u09c7\u09b0 \u09ab\u09cd\u09b0\u09bf \u099f\u09cd\u09b0\u09be\u09df\u09be\u09b2, $\u09e7\u09e8.\u09ef\u09ef/\u09ae\u09be\u09b8\u0964 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u0997\u09c7 \u098f\u0987 \u09b6\u09b0\u09cd\u099f\u0995\u09be\u099f\u099f\u09be \u099f\u09c7\u09b8\u09cd\u099f \u0995\u09b0\u09c7 \u09a6\u09c7\u0996\u09cb\u0964 P.S. \u098f\u0987 \u0987\u09ae\u09c7\u0987\u09b2\u099f\u09be \u09b6\u09c1\u09a7\u09c1 \u09a4\u09c1\u09ae\u09bf \u09aa\u09c7\u09df\u09c7\u099b\u09cb\u2014\u0986\u09ae\u09bf \u09b6\u09c1\u09a7\u09c1 \u0995\u09bf\u099b\u09c1 \u0987\u0989\u099c\u09be\u09b0\u0995\u09c7 \u09aa\u09be\u09a0\u09bf\u09df\u09c7\u099b\u09bf\u0964 \u0985\u09a8\u09cd\u09af\u09a6\u09c7\u09b0 \u099c\u09be\u09a8\u09bf\u0993 \u09a8\u09be, \u098f\u099f\u09be \u09af\u09c7\u09a8 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09bf\u0995\u09cd\u09b0\u09c7\u099f \u09a5\u09be\u0995\u09c7\u0964"
  ],
  "cta_text": "\u098f\u0996\u09a8 \u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09c7 \u09a6\u09c7\u0996\u09cb \u09b6\u09b0\u09cd\u099f\u0995\u09be\u099f\u099f\u09be",
