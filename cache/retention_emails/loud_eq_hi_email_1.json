{
  "subject": "30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u0906\u0935\u093e\u091c\u093c \u092c\u0926\u0932\u0947\u0902",
  "preview_text": "\u090f\u0915 \u091f\u0948\u092a \u0938\u0947 \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u0938\u093e\u092b\u093c \u0914\u0930 \u0924\u0947\u091c\u093c \u092c\u0928\u093e\u090f\u0902, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u091d\u0902\u091d\u091f \u0915\u0947\u0964",
  "body_paragraphs": [
    "\u0906\u092a\u0928\u0947 \u0905\u092d\u0940-\u0905\u092d\u0940 Loud EQ \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u092e\u0948\u0902 \u091c\u093e\u0928\u0924\u093e \u0939\u0942\u0901 \u0915\u093f \u0906\u092a \u0936\u093e\u092f\u0926 \u0935\u094d\u092f\u0938\u094d\u0924 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u092e\u0948\u0902 \u0906\u092a\u0915\u094b \u090f\u0915 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0926\u093f\u0916\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0901 \u091c\u094b \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u094b \u092c\u0926\u0932 \u0926\u0947\u0917\u0940\u0964 \u092c\u0938 30 \u0938\u0947\u0915\u0902\u0921 \u0932\u0917\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u091c\u092c \u0906\u092a \u092e\u0947\u091f\u094d\u0930\u094b \u092e\u0947\u0902 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u0917\u093e\u0921\u093c\u0940 \u091a\u0932\u093e \u0930\u0939\u0947 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0911\u0921\u093f\u092f\u094b \u0905\u0915\u094d\u0938\u0930 \u0926\u092c \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0921\u093e\u092f\u0932\u0949\u0917 \u0938\u093e\u092b\u093c \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0924\u0947, \u0914\u0930 \u0906\u092a\u0915\u094b \u0935\u0949\u0932\u094d\u092f\u0942\u092e 100% \u0915\u0930\u0915\u0947 \u092d\u0940 \u0938\u094d\u091f\u094d\u0930\u0947\u0928 \u0915\u0930\u0928\u093e \u092a\u0921\u093c\u0924\u093e \u0939\u0948\u0964 Loud EQ \u0915\u0940 'Optimize' \u092b\u0940\u091a\u0930 \u0907\u0938\u0947 \u0920\u0940\u0915 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0915\u0930\u0947\u0902, \u0914\u0930 \u092f\u0939 \u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u091f\u094d\u092f\u0942\u0928 \u0915\u0930 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964",
    "\u092f\u0939 \u092b\u0940\u091a\u0930 \u0906\u092a\u0915\u094b +200% \u0924\u0915 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0926\u0947\u0924\u093e \u0939\u0948, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0915\u0947\u0964 \u091a\u093e\u0939\u0947 \u0906\u092a Spotify \u0938\u0941\u0928 \u0930\u0939\u0947 \u0939\u094b\u0902, YouTube \u0926\u0947\u0916 \u0930\u0939\u0947 \u0939\u094b\u0902, \u092f\u093e Audible \u092a\u0930 \u0915\u094b\u0908 \u0915\u093f\u0924\u093e\u092c, \u092f\u0939 \u0938\u092c \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u0940 \u092c\u093e\u0924? \u092f\u0939 \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092d\u0940 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u0917\u093f\u0932\u094d\u091f \u0928\u0939\u0940\u0902, \u0938\u093f\u0930\u094d\u092b\u093c \u0938\u093e\u092b\u093c \u0914\u0930 \u0924\u0947\u091c\u093c \u0906\u0935\u093e\u091c\u093c\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 'Optimize' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924 \u0915\u094b \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964 P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0935\u0930\u094d\u091c\u0928 \u092e\u0947\u0902 \u0906\u092a\u0915\u094b 5-band EQ \u0914\u0930 \u091a\u093e\u0930 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u092e\u093f\u0932\u0924\u0947 \u0939\u0948\u0902, \u091c\u094b \u0906\u092a\u0915\u0947 \u0939\u0930 \u0938\u0941\u0928\u0928\u0947 \u0915\u0947 \u0905\u0928\u0941\u092d\u0935 \u0915\u094b \u0915\u0938\u094d\u091f\u092e\u093e\u0907\u091c\u093c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
  ],
