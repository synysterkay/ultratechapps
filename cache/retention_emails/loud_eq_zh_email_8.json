  "preview_text": "\u4e00\u4e2a\u901a\u52e4\u8005\u5982\u4f55\u7528Loud EQ\u5728\u5608\u6742\u5730\u94c1\u91cc\u542c\u6e05\u6bcf\u53e5\u5bf9\u8bdd\u7684\u771f\u5b9e\u7ecf\u5386",
  "body_paragraphs": [
    "\u674e\u4f1f\u6bcf\u5929\u5750\u5730\u94c1\u4e24\u5c0f\u65f6\uff0c\u8f66\u53a2\u91cc\u566a\u97f3\u50cf\u4e00\u5835\u5899\u3002\u4ed6\u628a\u97f3\u91cf\u8c03\u5230100%\uff0c\u8fd8\u662f\u542c\u4e0d\u6e05\u64ad\u5ba2\u91cc\u7684\u5bf9\u8bdd\uff0c\u8d8a\u542c\u8d8a\u70e6\u8e81\u3002\u4e0a\u5468\u4e09\uff0c\u4ed6\u8bd5\u4e86\u8bd5Loud EQ\u7684\u4e00\u952e\u4f18\u5316\u3002",
    "\u7ed3\u679c\u8ba9\u4ed6\u610f\u5916\uff1a\u58f0\u97f3\u4e0d\u4ec5\u5927\u4e86\uff0c\u800c\u4e14\u6bcf\u4e2a\u5b57\u90fd\u6e05\u6670\uff0c\u6ca1\u6709\u523a\u8033\u7684\u9ad8\u9891\u3002\u4ed6\u544a\u8bc9\u6211\uff0c\u90a3\u4e00\u523b\u4ed6\u7ec8\u4e8e\u4e0d\u7528\u518d\u8ddf\u97f3\u91cf\u640f\u6597\u4e86\u3002\u4f60\u7ecf\u5386\u8fc7\u8fd9\u79cd\u5417\uff1f\u8033\u6735\u7d2f\u4e86\uff0c\u4f46\u5185\u5bb9\u8fd8\u6ca1\u542c\u5b8c\u3002",
    "\u8fd9\u5c31\u662f\u4e3a\u4ec0\u4e48\u6211\u4eec\u8bbe\u8ba1\u4e86\u97f3\u9891\u914d\u7f6e\u6587\u4ef6\u2014\u2014\u7279\u522b\u662f\u64ad\u5ba2\u6a21\u5f0f\uff0c\u4e13\u95e8\u7a81\u51fa\u4eba\u58f0\uff0c\u538b\u5236\u73af\u5883\u566a\u97f3\u3002\u4f60\u6253\u5f00Loud EQ\uff0c\u8bd5\u8bd5\u64ad\u5ba2\u6a21\u5f0f\uff0c\u542c\u542c\u533a\u522b\u3002\u5b83\u4e0d\u4f1a\u66ff\u4f60\u505a\u51b3\u5b9a\uff0c\u4f46\u4f1a\u7ed9\u4f60\u4e00\u4e2a\u66f4\u8212\u670d\u7684\u9009\u62e9\u3002",
    "\u73b0\u5728\u6253\u5f00Loud EQ\uff0c\u70b9\u5f00\u64ad\u5ba2\u914d\u7f6e\u6587\u4ef6\uff0c\u542c\u4f60\u6700\u559c\u6b22\u7684\u4e00\u96c6\u3002\u4e09\u79d2\u5185\uff0c\u4f60\u4f1a\u611f\u53d7\u5230\u53d8\u5316\u3002",
