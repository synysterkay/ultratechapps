{
  "subject": "\ubc24 11\uc2dc\uc5d0 \uae68\ub2ec\uc740 \ud55c \uac00\uc9c0",
  "preview_text": "\ub300\ubd80\ubd84\uc758 \ucee4\ud50c\uc774 \ub193\uce58\ub294 \uae30\ub2a5 \ud558\ub098\uac00 \uc624\ub298 \ubc24\uc744 \ubc14\uafc9\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \uc18c\uc6b8\ud50c\ub79c\uc5d0 \uc228\uaca8\uc9c4 \ube44\ubc00\uc744 \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "\uc5b4\uc82f\ubc24, \ud55c \ucee4\ud50c\uc774 \uc6b0\ub9ac \uc571\uc744 \uc5f4\uc5c8\uc5b4\uc694. \ub458 \ub2e4 \ud53c\uace4\ud588\uace0, '\ubb50 \ud558\uc9c0?' \ud558\ub294 \uadf8 \uc21c\uac04. \uadf8\ub7f0\ub370 \uadf8\ub4e4\uc740 30\ucd08 \ub9cc\uc5d0 \uc624\ub298 \ubc24\uc744 \uacc4\ud68d\ud588\uc2b5\ub2c8\ub2e4. \ub300\ubd80\ubd84\uc758 \uc0ac\uc6a9\uc790\uac00 \ubaa8\ub974\ub294 \uae30\ub2a5 \ub355\ubd84\uc774\uc5c8\uc8e0. \uadf8\uac8c \ubb58\uae4c\uc694?",
    "\uc18c\uc6b8\ud50c\ub79c\uc744 \ub2e4\uc6b4\ubc1b\uc740 \ub9ce\uc740 \ubd84\ub4e4\uc774 '\ud22c\ub098\uc787 \ub370\uc774\ud2b8' \uae30\ub2a5\uc744 \uc2a4\ud0b5\ud569\ub2c8\ub2e4. \uadf8\ub0e5 \uba54\uc778 \ud654\uba74\uc5d0 \uc788\ub294 \uc791\uc740 \uce74\ub4dc \ud558\ub098\ub77c\uace0 \uc0dd\uac01\ud558\uac70\ub4e0\uc694. \ud558\uc9c0\ub9cc \uadf8 \uce74\ub4dc\uac00 \uac00\uc7a5 \uac15\ub825\ud55c \ubb34\uae30\uc608\uc694. \ud55c \ubc88\uc758 \ud0ed\uc73c\ub85c \ubb34\ub4dc\ub97c \uace0\ub974\uba74, AI\uac00 \ub2f9\uc2e0\uacfc \ud30c\ud2b8\ub108\ub97c \uc704\ud55c \uc644\ubcbd\ud55c \ub370\uc774\ud2b8\ub97c \uc81c\uc548\ud569\ub2c8\ub2e4. \uacc4\ud68d\uc5d0 \uc9c0\uce5c \ub2f9\uc2e0\uc744 \uc704\ud574 \ud0dc\uc5b4\ub09c \uae30\ub2a5\uc774\uc5d0\uc694.",
    "\uc774\uac8c \ub2e4\uac00 \uc544\ub2d9\ub2c8\ub2e4. \ud30c\ud2b8\ub108\uac00 \uc81c\uc548\uc744 \ubcf4\ub0b4\uba74, \uadf8\ub4e4\uc740 '\uc624\ub298 \ubc24 \ub108\ub97c \uc0dd\uac01\ud588\uc5b4'\ub77c\ub294 \ud480\uc2a4\ud06c\ub9b0 \uc21c\uac04\uc744 \uacbd\ud5d8\ud569\ub2c8\ub2e4. \ub2e8\uc21c\ud55c \uc54c\ub9bc\uc774 \uc544\ub2c8\ub77c, \ub9c8\uc74c\uc744 \uc804\ud558\ub294 \ud2b9\ubcc4\ud55c \uc21c\uac04\uc774\uc8e0. \ub2f9\uc2e0\uc774 \uc78a\uace0 \uc788\ub358 \uae30\ub2a5\uc774 \uc624\ub298 \ubc24\uc744 \ud2b9\ubcc4\ud558\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc5b4\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0, \uba54\uc778 \ud654\uba74\uc758 '\ud22c\ub098\uc787 \ub370\uc774\ud2b8'\ub97c \ud0ed\ud558\uc138\uc694. \ubb34\ub4dc\ub97c \uace0\ub974\uae30\ub9cc \ud558\uba74 \ub429\ub2c8\ub2e4. P.S. \uc5b4\uc81c \ub370\uc774\ud2b8\ub97c \uacc4\ud68d\ud55c \uadf8 \ucee4\ud50c, \uc9c0\uae08\uae4c\uc9c0 4\ubc30 \ub354 \ub9ce\uc740 \ub370\uc774\ud2b8\ub97c \uc990\uae30\uace0 \uc788\ub2e4\ub294 \uc0ac\uc2e4, \uc54c\uace0 \uacc4\uc168\ub098\uc694?"
  ],
