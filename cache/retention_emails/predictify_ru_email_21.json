{
  "subject": "\u0422\u0432\u043e\u0438 3 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0430 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438\u0441\u044c \u0437\u0430 \u043d\u043e\u0447\u044c",
  "preview_text": "\u041f\u043e\u043a\u0430 \u0442\u044b \u043d\u0435 \u0441\u043c\u043e\u0442\u0440\u0435\u043b, AI \u043f\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043b \u043c\u0430\u0442\u0447\u0438 \u0443\u0438\u043a\u0435\u043d\u0434\u0430. \u041e\u0434\u0438\u043d \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0443\u043f\u0430\u043b \u043d\u0430 20% \u2014 \u0437\u0430\u0439\u0434\u0438, \u043f\u043e\u043a\u0430 \u043d\u0435 \u043f\u043e\u0437\u0434\u043d\u043e.",
  "body_paragraphs": [
    "\u0412\u0447\u0435\u0440\u0430 \u0432 3 \u0447\u0430\u0441\u0430 \u043d\u043e\u0447\u0438 \u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0435 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e \u043a\u043e\u0435-\u0447\u0442\u043e. AI \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u043b \u043c\u043e\u0434\u0435\u043b\u0438 \u0434\u043b\u044f 14 \u043c\u0430\u0442\u0447\u0435\u0439 \u0443\u0438\u043a\u0435\u043d\u0434\u0430 \u2014 \u0438 \u0442\u0440\u0438 \u0442\u0432\u043e\u0438\u0445 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0430 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438\u0441\u044c. \u041e\u0434\u0438\u043d \u0443\u043f\u0430\u043b \u0441 72% \u0434\u043e 51% \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u0438. \u0414\u0440\u0443\u0433\u043e\u0439 \u2014 \u0432\u044b\u0440\u043e\u0441 \u0434\u043e 84%. \u0422\u044b \u0431\u044b \u0445\u043e\u0442\u0435\u043b \u0443\u0437\u043d\u0430\u0442\u044c \u043e\u0431 \u044d\u0442\u043e\u043c \u0434\u043e \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0448\u044c \u0434\u0435\u043d\u044c\u0433\u0438, \u043f\u0440\u0430\u0432\u0434\u0430?",
    "\u041c\u044b \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0438 \u043d\u043e\u0432\u0443\u044e \u0444\u0438\u0447\u0443: \u0442\u0435\u043f\u0435\u0440\u044c Predictify \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u043a\u0430\u043a \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u044c AI \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0415\u0441\u043b\u0438 \u0442\u044b \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u043b \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043d\u0435\u0434\u0435\u043b\u044e \u043d\u0430\u0437\u0430\u0434, \u0442\u044b \u044d\u0442\u043e\u0433\u043e \u043d\u0435 \u0432\u0438\u0434\u0435\u043b. \u0422\u0435\u043f\u0435\u0440\u044c \u043a\u0430\u0436\u0434\u044b\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u2014 \u0436\u0438\u0432\u043e\u0439 \u0433\u0440\u0430\u0444\u0438\u043a: \u0432\u0447\u0435\u0440\u0430 \u0431\u044b\u043b\u043e 65%, \u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f 81% \u2014 \u0438 \u0442\u044b \u0432\u0438\u0434\u0438\u0448\u044c, \u043f\u043e\u0447\u0435\u043c\u0443 (\u0441\u043c\u0435\u043d\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u0430, \u0442\u0440\u0430\u0432\u043c\u0430, \u043f\u043e\u0433\u043e\u0434\u0430).",
    "\u042d\u0442\u043e \u043d\u0435 \u043c\u0430\u0440\u043a\u0435\u0442\u0438\u043d\u0433. \u042d\u0442\u043e \u0434\u0430\u043d\u043d\u044b\u0435. \u0422\u044b \u043c\u043e\u0436\u0435\u0448\u044c \u0437\u0430\u0439\u0442\u0438 \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043e\u0442\u043a\u0440\u044b\u0442\u044c \u043b\u044e\u0431\u043e\u0439 \u043c\u0430\u0442\u0447 \u0438\u0437 Premier League \u0438\u043b\u0438 La Liga \u2014 \u0438 \u0443\u0432\u0438\u0434\u0435\u0442\u044c, \u043a\u0430\u043a AI \u043f\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043b \u0432\u0441\u0451 \u0437\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 48 \u0447\u0430\u0441\u043e\u0432. \u0414\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u0442\u044b \u0434\u0430\u0432\u043d\u043e \u043d\u0435 \u0437\u0430\u0445\u043e\u0434\u0438\u043b, \u0442\u0432\u043e\u0438 \u0441\u0442\u0430\u0440\u044b\u0435 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u044b \u0432\u0441\u0451 \u0435\u0449\u0451 \u0442\u0430\u043c. \u041d\u043e \u043e\u043d\u0438 \u043c\u043e\u0433\u043b\u0438 \u0443\u0441\u0442\u0430\u0440\u0435\u0442\u044c.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Predictify \u0441\u0435\u0439\u0447\u0430\u0441 \u2014 \u043f\u0440\u043e\u0432\u0435\u0440\u044c, \u043a\u0430\u043a\u0438\u0435 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u044b \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0438\u0441\u044c \u0437\u0430 \u043d\u043e\u0447\u044c. \u042d\u0442\u043e \u0437\u0430\u0439\u043c\u0435\u0442 30 \u0441\u0435\u043a\u0443\u043d\u0434. P.S. \u041e\u0434\u0438\u043d \u043c\u0430\u0442\u0447 \u0438\u0437 \u0442\u0432\u043e\u0435\u0439 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u2014 \u0420\u0435\u0430\u043b \u043f\u0440\u043e\u0442\u0438\u0432 \u0411\u0430\u0440\u0441\u044b \u2014 AI \u0442\u0435\u043f\u0435\u0440\u044c \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u0435\u0442 \u0432 89% \u043d\u0430 \u043f\u043e\u0431\u0435\u0434\u0443 \u0433\u043e\u0441\u0442\u0435\u0439. \u0421\u043f\u043e\u0440\u0438\u043c, \u0442\u044b \u043d\u0435 \u043e\u0436\u0438\u0434\u0430\u043b?"
  ],
  "cta_text": "\u041e\u0442\u043a\u0440\u044b\u0442\u044c Predictify \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u044b",
