{
  "subject": "3\u79d2\u949f\uff0c\u8ba9\u4eca\u665a\u7ea6\u4f1a\u7115\u7136\u4e00\u65b0",
  "preview_text": "\u4e00\u4e2a\u7b80\u5355\u52a8\u4f5c\uff0c\u7acb\u5373\u6539\u53d8\u7ea6\u4f1a\u4f53\u9a8c\u3002\u4e86\u89e3\u8fd9\u4e2a\u6280\u5de7\uff0c\u8ba9\u4f34\u4fa3\u611f\u53d7\u5230\u4f60\u7684\u7528\u5fc3\u3002",
  "body_paragraphs": [
    "\u6628\u665a\uff0c\u5c0f\u9648\u548c\u5973\u53cb\u7684\u7ea6\u4f1a\u5dee\u70b9\u53d8\u6210\u4f8b\u884c\u516c\u4e8b\u3002\u4ed6\u4eec\u5750\u5728\u6c99\u53d1\u4e0a\uff0c\u7ffb\u7740\u624b\u673a\uff0c\u5374\u627e\u4e0d\u5230\u4e00\u4e2a\u4e24\u4eba\u90fd\u60f3\u53bb\u7684\u5730\u65b9\u3002\u76f4\u5230\u5c0f\u9648\u70b9\u5f00\u4e86SoulPlan\u7684\u4e00\u4e2a\u5c0f\u529f\u80fd\u2014\u2014\u4e0d\u662f\u7ffb\u904d\u5217\u8868\uff0c\u800c\u662f\u8f7b\u8f7b\u70b9\u4e86\u4e00\u4e0b\u5c4f\u5e55\u4e0a\u7684\u4e00\u4e2a\u9009\u9879\u3002",
    "\u8fd9\u4e2a\u52a8\u4f5c\u53ea\u82b1\u4e863\u79d2\u949f\uff0c\u5374\u8ba9\u4ed6\u4eec\u5ea6\u8fc7\u4e86\u4e00\u4e2a\u5145\u6ee1\u60ca\u559c\u7684\u591c\u665a\u3002\u4f60\u6709\u6ca1\u6709\u60f3\u8fc7\uff0c\u7ea6\u4f1a\u80fd\u4e0d\u80fd\u50cf\u7ffb\u4e66\u4e00\u6837\u7b80\u5355\uff1f\u4e00\u4e2a\u5ff5\u5934\uff0c\u4e00\u4e2a\u52a8\u4f5c\uff0c\u7136\u540e\u4e00\u5207\u5c31\u81ea\u7136\u800c\u7136\u5730\u53d1\u751f\u4e86\u3002\u8fd9\u4e2a\u5c0f\u6280\u5de7\u5c31\u662f\uff1a\u4e0d\u8981\u89c4\u5212\u592a\u591a\uff0c\u53ea\u9009\u4e00\u4e2a\u6838\u5fc3\u6c1b\u56f4\uff0c\u8ba9\u5176\u4ed6\u90e8\u5206\u81ea\u7136\u8ddf\u4e0a\u3002",
    "\u5728SoulPlan\u91cc\uff0c\u8fd9\u4e2a\u6280\u5de7\u88ab\u6d53\u7f29\u6210\u201c\u4eca\u665a\u4e4b\u7ea6\u201d\u529f\u80fd\u3002\u4f60\u53ea\u9700\u70b9\u4e00\u4e0b\u5fc3\u60c5\u2014\u2014\u6e29\u99a8\u3001\u5192\u9669\u3001\u6b22\u4e50\u6216\u6cbb\u6108\u2014\u2014\u5e94\u7528\u5c31\u4f1a\u4e3a\u4f60\u5339\u914d\u4e00\u4e2a\u5b8c\u6574\u7684\u7ea6\u4f1a\u65b9\u6848\u3002\u4e0d\u7528\u7ea0\u7ed3\u7ec6\u8282\uff0c\u4e0d\u7528\u53cd\u590d\u8ba8\u8bba\uff0c\u56e0\u4e3a\u90a3\u4e2a\u65b9\u6848\u5df2\u7ecf\u57fa\u4e8e\u4f60\u4eec\u7684\u5386\u53f2\u548c\u504f\u597d\u505a\u597d\u4e86\u3002",
    "\u4eca\u665a\u8bd5\u8bd5\u770b\uff1a\u6253\u5f00SoulPlan\uff0c\u5728\u4e3b\u5c4f\u5e55\u4e0a\u8f7b\u8f7b\u70b9\u4e00\u4e0b\u201c\u4eca\u665a\u4e4b\u7ea6\u201d\uff0c\u9009\u4e00\u4e2a\u4f60\u4eec\u6700\u6e34\u671b\u7684\u6c1b\u56f4\u3002\u8ba9\u4f34\u4fa3\u770b\u5230\u4f60\u7684\u9009\u62e9\uff0c\u7136\u540e\u4e00\u8d77\u4eab\u53d7\u8fd9\u4e2a\u77ac\u95f4\u3002P.S. \u8fd9\u4e2a\u7b80\u5355\u7684\u52a8\u4f5c\u4f1a\u8ba9\u4f60\u7684\u7ea6\u4f1a\u89c4\u5212\u6548\u7387\u63d0\u53474\u500d\u2014\u2014\u6839\u636e\u6211\u4eec\u7528\u6237\u7684\u6570\u636e\uff0c\u90a3\u4e9b\u7b2c\u4e00\u5929\u5c1d\u8bd5\u7684\u4eba\uff0c\u63a5\u4e0b\u6765\u4e00\u4e2a\u6708\u7ea6\u4f1a\u9891\u7387\u589e\u52a0\u4e864\u500d\u3002",
    "\u8ba9\u4eca\u665a\u6210\u4e3a\u4f60\u4eec\u7684\u8d77\u70b9\uff0c\u800c\u4e0d\u662f\u7ec8\u70b9\u3002"
  ],
