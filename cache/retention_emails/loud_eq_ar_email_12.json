{
  "subject": "\u0645\u064a\u0632\u0629 \u0623\u062e\u0641\u0627\u0647\u0627 \u0639\u0646\u0643 \u0669\u0660\u066a \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646",
  "preview_text": "\u0642\u0628\u0644 \u0623\u0633\u0628\u0648\u0639\u060c \u0623\u062d\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0643\u062a\u0634\u0641 \u0634\u064a\u0626\u064b\u0627 \u063a\u064a\u0651\u0631 \u0643\u0644 \u0634\u064a\u0621. \u0647\u0644 \u062a\u0639\u0631\u0641\u0647\u061f",
  "body_paragraphs": [
    "\u0643\u0627\u0646 \u064a\u062c\u0644\u0633 \u0641\u064a \u0627\u0644\u0642\u0637\u0627\u0631\u060c \u064a\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0644\u0623\u0642\u0635\u0649 \u062d\u062f\u060c \u0648\u064a\u0638\u0644 \u064a\u0633\u0645\u0639 \u0647\u0645\u0647\u0645\u0629 \u0641\u0642\u0637. \u0638\u0646 \u0623\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0644\u0627 \u064a\u0646\u0641\u0639. \u0644\u0643\u0646\u0647 \u0636\u063a\u0637 \u0632\u0631\u064b\u0627 \u0648\u0627\u062d\u062f\u064b\u0627 \u0628\u0627\u0644\u0635\u062f\u0641\u0629. \u0644\u0645 \u064a\u0639\u062f \u0628\u062d\u0627\u062c\u0629 \u0644\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.",
    "\u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0645\u062f\u0641\u0648\u0646\u0629 \u0641\u064a \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a. \u0645\u0639\u0638\u0645 \u0627\u0644\u0646\u0627\u0633 \u064a\u062a\u062c\u0627\u0647\u0644\u0648\u0646\u0647\u0627 \u0644\u0623\u0646\u0647\u0627 \u0644\u0627 \u062a\u0638\u0647\u0631 \u0641\u0648\u0631\u064b\u0627. \u0644\u0643\u0646\u0647\u0627 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0635\u0648\u062a \u064a\u0632\u0639\u062c \u0623\u0630\u0646\u0643 \u0648\u0635\u0648\u062a \u064a\u0635\u0644 \u0644\u0643\u0644 \u0643\u0644\u0645\u0629. \u062d\u062a\u0649 \u0641\u064a \u0632\u062d\u0627\u0645 \u0627\u0644\u0637\u0631\u064a\u0642.",
    "\u0625\u0646\u0647\u0627 \u0645\u064a\u0632\u0629 '\u0636\u0628\u0637 \u062a\u0644\u0642\u0627\u0626\u064a' \u0627\u0644\u062a\u064a \u062a\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0633\u0645\u0627\u0639\u062a\u0643 \u0648\u062a\u0636\u0628\u0637 \u0627\u0644\u0635\u0648\u062a \u062d\u0633\u0628 \u0645\u062d\u064a\u0637\u0643. \u0644\u0627 \u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u062a\u0634\u0648\u064a\u0634. \u0644\u0627 \u0645\u0632\u064a\u062f \u0645\u0646 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0625\u0644\u0649 \u0661\u0660\u0660\u066a. \u0641\u0642\u0637 \u0646\u0642\u0627\u0621 \u0648\u0648\u0636\u0648\u062d.",
    "\u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u060c \u0648\u0627\u062e\u062a\u0631 '\u0636\u0628\u0637 \u062a\u0644\u0642\u0627\u0626\u064a'. \u0627\u0633\u0645\u0639 \u0627\u0644\u0641\u0631\u0642 \u0628\u0646\u0641\u0633\u0643. \u0645\u0644\u0627\u062d\u0638\u0629: \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0630\u064a \u0627\u0643\u062a\u0634\u0641\u0647\u0627\u061f \u0627\u0644\u0622\u0646 \u0644\u0627 \u064a\u0633\u062a\u062e\u062f\u0645 \u0623\u064a \u062a\u0637\u0628\u064a\u0642 \u0622\u062e\u0631."
  ],
