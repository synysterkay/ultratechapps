{
  "subject": "\u062e\u062f\u0639\u0629 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u062a\u064a \u064a\u062e\u0641\u064a\u0647\u0627 \u0639\u0646\u0643 \u0627\u0644\u0645\u062d\u062a\u0631\u0641\u0648\u0646",
  "preview_text": "\u0644\u0627 \u062a\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0644\u0623\u0642\u0635\u0649 \u062d\u062f \u0628\u0639\u062f \u0627\u0644\u064a\u0648\u0645. \u062c\u0631\u0628 \u0647\u0630\u0647 \u0627\u0644\u062e\u062f\u0639\u0629 \u0627\u0644\u062a\u064a \u0633\u062a\u063a\u064a\u0631 \u0643\u0644 \u0634\u064a\u0621 \u0641\u064a \u062a\u0637\u0628\u064a\u0642 Loud EQ.",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u0641\u064a \u0645\u062a\u0631\u0648 \u0645\u0632\u062f\u062d\u0645\u060c \u062a\u0633\u0645\u0639 \u0636\u062c\u064a\u062c \u0627\u0644\u0645\u062d\u0631\u0643 \u0648\u0632\u062d\u0627\u0645 \u0627\u0644\u0646\u0627\u0633\u060c \u0648\u0643\u0644 \u0645\u0627 \u062a\u0631\u064a\u062f\u0647 \u0647\u0648 \u0633\u0645\u0627\u0639 \u0628\u0648\u062f\u0643\u0627\u0633\u062a\u0643 \u0628\u0648\u0636\u0648\u062d. \u062a\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0644\u0623\u0642\u0635\u0649 \u062d\u062f\u060c \u0644\u0643\u0646 \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u062a\u062a\u062f\u0627\u062e\u0644 \u0648\u062a\u0636\u064a\u0639 \u0648\u0633\u0637 \u0627\u0644\u0636\u0648\u0636\u0627\u0621. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u060c \u0644\u0643\u0646\u0647 \u0644\u064a\u0633 \u0627\u0644\u062d\u0644.",
    "\u0647\u0644 \u062a\u0639\u0644\u0645 \u0623\u0646 80% \u0645\u0646 \u0645\u0633\u062a\u062e\u062f\u0645\u064a \u0627\u0644\u0647\u0648\u0627\u062a\u0641 \u064a\u0631\u0641\u0639\u0648\u0646 \u0627\u0644\u0635\u0648\u062a \u0644\u0623\u0642\u0635\u0649 \u062d\u062f \u0628\u0634\u0643\u0644 \u064a\u0648\u0645\u064a\u061f \u0647\u0630\u0627 \u064a\u0633\u0628\u0628 \u062a\u0634\u0648\u064a\u0634 \u0648\u0625\u062c\u0647\u0627\u062f \u0644\u0644\u0633\u0645\u0639 \u0628\u0633\u0631\u0639\u0629. \u0644\u0643\u0646 \u0647\u0646\u0627\u0643 \u062e\u062f\u0639\u0629 \u0628\u0633\u064a\u0637\u0629 \u064a\u0633\u062a\u062e\u062f\u0645\u0647\u0627 \u0645\u062d\u062a\u0631\u0641\u0648 \u0627\u0644\u0635\u0648\u062a: \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0643\u0644\u0647\u060c \u064a\u0631\u0643\u0632\u0648\u0646 \u0639\u0644\u0649 \u062a\u0631\u062f\u062f\u0627\u062a \u0627\u0644\u0643\u0644\u0627\u0645 \u0641\u0642\u0637. \u0641\u064a Loud EQ\u060c \u0644\u062f\u064a\u0646\u0627 \u062e\u0627\u0635\u064a\u0629 \"\u0627\u0644\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0630\u0643\u064a\" \u0627\u0644\u062a\u064a \u062a\u0641\u0639\u0644 \u0630\u0644\u0643 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0627\u062e\u062a\u0631 \u0645\u0644\u0641 \"\u0627\u0644\u0628\u0648\u062f\u0643\u0627\u0633\u062a\" \u0645\u0646 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0635\u0648\u062a\u064a\u0629. \u0633\u062a\u0644\u0627\u062d\u0638 \u0623\u0646 \u0627\u0644\u0623\u0635\u0648\u0627\u062a \u0627\u0644\u0645\u0646\u062e\u0641\u0636\u0629 \u0648\u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0629 \u062a\u0636\u062e\u0645\u062a\u060c \u0628\u064a\u0646\u0645\u0627 \u062a\u0628\u0642\u0649 \u0627\u0644\u062a\u0631\u062f\u062f\u0627\u062a \u0627\u0644\u0639\u0627\u0644\u064a\u0629 \u0646\u0638\u064a\u0641\u0629. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0645\u062c\u0631\u062f \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0648\u062a\u062d\u0633\u064a\u0646\u0647 \u0641\u0639\u0644\u064a\u0627\u064b. \u062c\u0631\u0628\u0647 \u0639\u0644\u0649 \u0623\u064a \u0628\u0648\u062f\u0643\u0627\u0633\u062a \u0623\u0648 \u0641\u064a\u062f\u064a\u0648 \u0641\u064a \u0645\u062a\u0631\u0648 \u0627\u0644\u0623\u0646\u0641\u0627\u0642 \u0623\u0648 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0642\u064a\u0627\u062f\u0629.",
    "\u0627\u0641\u062a\u062d Loud EQ \u0627\u0644\u0622\u0646\u060c \u0648\u0627\u062e\u062a\u0631 \u0645\u0644\u0641 \u0627\u0644\u0628\u0648\u062f\u0643\u0627\u0633\u062a. \u0627\u0633\u062a\u0645\u0639 \u0644\u062f\u0642\u064a\u0642\u062a\u064a\u0646 \u0641\u0642\u0637. \u0633\u062a\u0634\u0639\u0631 \u0628\u0627\u0644\u0641\u0631\u0642 \u0641\u0648\u0631\u0627\u064b. P.S. \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0631\u064a\u062f \u0623\u0642\u0635\u0649 \u0642\u0648\u0629\u060c \u062c\u0631\u0628 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u0627\u0644\u0645\u0645\u064a\u0632 \u0644\u064a\u0648\u0645 \u0648\u0627\u062d\u062f \u0645\u062c\u0627\u0646\u0627\u064b. \u0633\u062a\u062d\u0635\u0644 \u0639\u0644\u0649 +200% \u0635\u0648\u062a \u062f\u0648\u0646 \u062a\u0634\u0648\u064a\u0647."
  ],
