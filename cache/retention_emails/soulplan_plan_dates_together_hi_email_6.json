{
  "subject": "\u0935\u094b 5 \u0938\u0947\u0915\u0902\u0921 \u0915\u0940 \u0917\u0932\u0924\u0940 \u091c\u094b \u0930\u094b\u092e\u093e\u0902\u0938 \u0916\u0924\u094d\u092e \u0915\u0930 \u0926\u0947\u0924\u0940 \u0939\u0948",
  "preview_text": "\u091c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0915\u092a\u0932\u094d\u0938 \u092f\u0939\u0940 \u0917\u0932\u0924\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092b\u093f\u0930 \u0938\u094b\u091a\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0938\u094d\u092a\u093e\u0930\u094d\u0915 \u0915\u094d\u092f\u094b\u0902 \u0916\u094b \u0917\u092f\u093e\u0964 \u091c\u093e\u0928\u093f\u090f \u0906\u0938\u093e\u0928 \u092b\u093f\u0915\u094d\u0938\u0964",
  "body_paragraphs": [
    "\u0930\u0941\u0915\u094b, \u090f\u0915 \u092c\u093e\u0924 \u092c\u0924\u093e\u090a\u0902? \u0924\u0941\u092e\u0928\u0947 \u0936\u093e\u092f\u0926 \u0935\u0939\u0940 \u0915\u093f\u092f\u093e \u091c\u094b 80% \u0932\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u2014 \u0924\u0941\u092e\u0928\u0947 \u0905\u092a\u0928\u0940 \u0921\u0947\u091f \u0915\u094b '\u092a\u0930\u092b\u0947\u0915\u094d\u091f' \u092c\u0928\u093e\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0940\u0964 \u0914\u0930 \u0935\u0939\u0940\u0902 \u0917\u0932\u0924\u0940 \u0939\u094b \u0917\u0908\u0964 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u0917\u0932\u0924\u0940 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u094d\u0932\u093e\u0928\u093f\u0902\u0917 \u0915\u094b \u092c\u0930\u094d\u092c\u093e\u0926 \u0915\u0930 \u0938\u0915\u0924\u0940 \u0939\u0948, \u0935\u094b \u0939\u0948 '\u0913\u0935\u0930\u0925\u093f\u0902\u0915\u093f\u0902\u0917'\u0964 \u0924\u0941\u092e\u0928\u0947 \u0907\u0924\u0928\u093e \u0938\u094b\u091a\u093e \u0915\u093f \u0921\u0947\u091f \u0915\u092d\u0940 \u0939\u0941\u0908 \u0939\u0940 \u0928\u0939\u0940\u0902\u0964",
    "\u0938\u0941\u0928\u094b, \u0939\u092e\u0928\u0947 \u0921\u0947\u091f\u093e \u092e\u0947\u0902 \u0926\u0947\u0916\u093e \u0939\u0948: \u091c\u094b \u0915\u092a\u0932\u094d\u0938 \u0905\u092a\u0928\u0940 \u092a\u0939\u0932\u0940 \u0921\u0947\u091f \u0915\u094b '\u092a\u0930\u092b\u0947\u0915\u094d\u091f' \u092c\u0928\u093e\u0928\u0947 \u092e\u0947\u0902 \u0932\u0917 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u090f\u0915 \u092e\u0939\u0940\u0928\u0947 \u092e\u0947\u0902 4 \u0917\u0941\u0928\u093e \u0915\u092e \u0921\u0947\u091f\u094d\u0938 \u092a\u0930 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u094d\u092f\u094b\u0902? \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092a\u0930\u092b\u0947\u0915\u094d\u0936\u0928 \u0915\u093e \u0926\u092c\u093e\u0935 \u092a\u094d\u0932\u093e\u0928\u093f\u0902\u0917 \u0915\u094b \u0925\u0915\u093e\u0928 \u092c\u0928\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u092b\u093f\u0930 \u0930\u094b\u092e\u093e\u0902\u0938 \u0930\u0942\u091f\u0940\u0928 \u092e\u0947\u0902 \u092c\u0926\u0932 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0938\u093e\u0925\u0940 '\u0905\u0926\u0943\u0936\u094d\u092f' \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0928\u0947 \u0932\u0917\u0924\u093e \u0939\u0948\u0964",
    "\u092f\u0939\u093e\u0902 \u0905\u0938\u0932\u0940 \u091c\u093e\u0926\u0942 \u0939\u0948: '\u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f' \u092b\u0940\u091a\u0930\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0915\u0930\u094b \u2014 \u0915\u094b\u091c\u093c\u0940, \u090f\u0921\u0935\u0947\u0902\u091a\u0930\u0938, \u092a\u094d\u0932\u0947\u092b\u0941\u0932 \u092f\u093e \u0939\u0940\u0932\u093f\u0902\u0917 \u092e\u0942\u0921 \u091a\u0941\u0928\u094b\u0964 30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0906\u091c \u0915\u0940 \u0921\u0947\u091f \u0924\u0948\u092f\u093e\u0930\u0964 \u0915\u094b\u0908 \u092a\u094d\u0932\u093e\u0928\u093f\u0902\u0917 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u092a\u094d\u0930\u0947\u0936\u0930 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u0924\u0941\u092e \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u093e\u0930\u094d\u091f\u0928\u0930\u0964 \u0914\u0930 \u091c\u092c \u0924\u0941\u092e \u092d\u0947\u091c\u094b\u0917\u0947, \u0924\u094b \u0909\u0928\u094d\u0939\u0947\u0902 \u090f\u0915 \u0916\u0942\u092c\u0938\u0942\u0930\u0924 '\u0925\u0949\u091f \u0911\u092b \u092f\u0942 \u091f\u0941\u0928\u093e\u0907\u091f' \u092b\u0941\u0932-\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092e\u094b\u092e\u0947\u0902\u091f \u092e\u093f\u0932\u0947\u0917\u093e \u2014 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0928\u0939\u0940\u0902\u0964",
    "\u0905\u092c \u0915\u0930\u094b \u092f\u0947: \u0906\u091c \u0930\u093e\u0924, \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u091f\u0941\u0928\u093e\u0907\u091f\u094d\u0938 \u0921\u0947\u091f' \u092a\u0930 \u090f\u0915 \u092e\u0942\u0921 \u091f\u0948\u092a \u0915\u0930\u094b\u0964 \u092c\u0938 \u0907\u0924\u0928\u093e \u0939\u0940\u0964 \u0926\u0947\u0916\u094b \u0915\u0948\u0938\u0947 \u0935\u094b \u092a\u0930\u092b\u0947\u0915\u094d\u0936\u0928 \u0915\u093e \u092c\u094b\u091d \u0909\u0924\u0930 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u2014 \u092f\u093e\u0926 \u0930\u0916\u0928\u093e, \u0938\u094d\u092a\u093e\u0930\u094d\u0915 \u092a\u094d\u0932\u093e\u0928\u093f\u0902\u0917 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902, \u092a\u0932 \u092e\u0947\u0902 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092e\u0947\u0902\u092e\u094b\u0930\u0940 \u091f\u093e\u0907\u092e\u0932\u093e\u0907\u0928 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u0907\u0902\u0924\u091c\u093e\u0930 \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948 \u2014 \u0909\u0938\u0947 \u092d\u0930\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u094b\u0964"
  ],
