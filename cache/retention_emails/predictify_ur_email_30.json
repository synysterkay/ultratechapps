{
  "subject": "\u0622\u067e \u06a9\u0627 70 \u062f\u0646 \u06a9\u0627 \u0633\u0641\u0631 \u0627\u0648\u0631 \u0627\u06cc\u06a9 \u0628\u0691\u06cc \u0628\u0627\u062a",
  "preview_text": "70 \u062f\u0646\u0648\u06ba \u0645\u06cc\u06ba \u0622\u067e \u0646\u06d2 \u06a9\u06cc\u0627 \u06a9\u06cc\u0627\u061f \u0627\u06cc\u06a9 \u0627\u06cc\u0633\u06cc \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc \u06a9\u0627 \u062d\u0635\u06c1 \u0628\u0646\u06cc\u06ba \u062c\u0648 \u0641\u0679 \u0628\u0627\u0644 \u06a9\u0648 \u0633\u0645\u062c\u06be\u062a\u06cc \u06c1\u06d2\u06d4 \u0627\u0628 \u0648\u0642\u062a \u06c1\u06d2 \u06a9\u0686\u06be \u0628\u0691\u0627 \u06a9\u0631\u0646\u06d2 \u06a9\u0627\u06d4",
  "body_paragraphs": [
    "70 \u062f\u0646 \u067e\u06c1\u0644\u06d2 \u0622\u067e \u0646\u06d2 Predictify \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u06cc\u0627 \u062a\u06be\u0627\u06d4 \u0634\u0627\u06cc\u062f \u0622\u067e \u06a9\u0648 \u06cc\u0627\u062f \u0628\u06be\u06cc \u0646\u06c1 \u06c1\u0648\u060c \u0644\u06cc\u06a9\u0646 \u0622\u067e \u0646\u06d2 \u0627\u06cc\u06a9 \u0633\u0641\u0631 \u0634\u0631\u0648\u0639 \u06a9\u06cc\u0627 \u062a\u06be\u0627\u06d4 \u0622\u062c \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u0628\u062a\u0627\u0646\u0627 \u0686\u0627\u06c1\u062a\u0627 \u06c1\u0648\u06ba \u06a9\u06c1 \u0622\u067e \u0635\u0631\u0641 \u0627\u06cc\u06a9 \u0635\u0627\u0631\u0641 \u0646\u06c1\u06cc\u06ba \u0631\u06c1\u06d2 \u2014 \u0622\u067e \u0627\u06cc\u06a9 \u062a\u062d\u0631\u06cc\u06a9 \u06a9\u0627 \u062d\u0635\u06c1 \u0628\u0646 \u0686\u06a9\u06d2 \u06c1\u06cc\u06ba\u06d4",
    "\u06c1\u0631 \u0645\u06cc\u0686\u060c \u06c1\u0631 \u067e\u06cc\u0634\u0646 \u06af\u0648\u0626\u06cc\u060c \u06c1\u0631 IQ \u06a9\u0648\u0626\u0632 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u0627 \u062d\u0635\u06c1 \u06c1\u0645\u06cc\u06ba \u062f\u06a9\u06be\u0627\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0641\u0679 \u0628\u0627\u0644 \u0635\u0631\u0641 \u0627\u06cc\u06a9 \u06a9\u06be\u06cc\u0644 \u0646\u06c1\u06cc\u06ba\u060c \u0628\u0644\u06a9\u06c1 \u0627\u06cc\u06a9 \u0645\u0634\u0646 \u06c1\u06d2\u06d4 \u0622\u067e \u06a9\u06cc \u0688\u06cc\u0679\u0627 \u067e\u0631 \u0645\u0628\u0646\u06cc \u0628\u0635\u06cc\u0631\u062a\u060c \u0622\u067e \u06a9\u06cc \u067e\u06cc\u0634\u0646 \u06af\u0648\u0626\u06cc\u0627\u06ba\u060c \u0627\u0648\u0631 \u0622\u067e \u06a9\u06cc \u06af\u0641\u062a\u06af\u0648 \u0646\u06d2 \u0627\u06cc\u06a9 \u0627\u06cc\u0633\u06cc \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc \u0628\u0646\u0627\u0626\u06cc \u06c1\u06d2 \u062c\u0648 \u062c\u0630\u0628\u0627\u062a \u0633\u06d2 \u0622\u06af\u06d2 \u0628\u0691\u06be \u06a9\u0631 \u062d\u0642\u0627\u0626\u0642 \u06a9\u0648 \u062f\u06cc\u06a9\u06be\u062a\u06cc \u06c1\u06d2\u06d4",
    "\u0627\u0628 \u0648\u0642\u062a \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u0627\u067e\u0646\u06cc \u0645\u06cc\u0631\u0627\u062b \u06a9\u0648 \u0645\u0636\u0628\u0648\u0637 \u06a9\u0631\u06cc\u06ba\u06d4 Predictify \u06a9\u06cc '\u0644\u06cc\u06af\u06cc\u0633\u06cc \u0645\u0634\u0646' \u0641\u06cc\u0686\u0631 \u0622\u067e \u06a9\u0648 \u0628\u062a\u0627\u062a\u06cc \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u0646\u06d2 \u06a9\u062a\u0646\u06d2 \u0645\u06cc\u0686\u0632 \u06a9\u0627 \u062a\u062c\u0632\u06cc\u06c1 \u06a9\u06cc\u0627\u060c \u06a9\u062a\u0646\u06cc \u067e\u06cc\u0634\u0646 \u06af\u0648\u0626\u06cc\u0627\u06ba \u062f\u0631\u0633\u062a \u062a\u06be\u06cc\u06ba\u060c \u0627\u0648\u0631 \u0622\u067e \u06a9\u06cc \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc \u0645\u06cc\u06ba \u06a9\u062a\u0646\u06cc \u0639\u0632\u062a \u06c1\u06d2\u06d4 \u06cc\u06c1 \u0635\u0631\u0641 \u0627\u0639\u062f\u0627\u062f \u0646\u06c1\u06cc\u06ba\u060c \u06cc\u06c1 \u0622\u067e \u06a9\u06cc \u0634\u0646\u0627\u062e\u062a \u06c1\u06d2\u06d4",
    "\u0622\u062c \u06c1\u06cc \u0627\u06cc\u067e \u06a9\u06be\u0648\u0644\u06cc\u06ba \u0627\u0648\u0631 \u0627\u067e\u0646\u0627 Legacy Score \u062f\u06cc\u06a9\u06be\u06cc\u06ba\u06d4 \u06cc\u06c1 \u0622\u067e \u06a9\u0627 \u0644\u0645\u062d\u06c1 \u06c1\u06d2\u06d4 \u0627\u0648\u0631 \u0627\u06af\u0631 \u0622\u067e \u0646\u06d2 \u0627\u0628\u06be\u06cc \u062a\u06a9 Premium \u0622\u0632\u0645\u0627\u06cc\u0627 \u0646\u06c1\u06cc\u06ba\u060c \u062a\u0648 3 \u062f\u0646 \u06a9\u0627 \u0645\u0641\u062a \u0679\u0631\u0627\u0626\u0644 \u0622\u067e \u06a9\u0627 \u0645\u0646\u062a\u0638\u0631 \u06c1\u06d2 \u2014 \u062a\u0627\u06a9\u06c1 \u0622\u067e \u06c1\u0631 \u0645\u06cc\u0686 \u06a9\u06cc \u06af\u06c1\u0631\u06cc \u0628\u0635\u06cc\u0631\u062a \u062d\u0627\u0635\u0644 \u06a9\u0631 \u0633\u06a9\u06cc\u06ba\u06d4 P.S. \u0622\u067e \u06a9\u06cc 70 \u062f\u0646 \u06a9\u06cc \u0645\u062d\u0646\u062a \u06a9\u0648 \u06c1\u0645 \u0646\u06d2 \u0627\u06cc\u06a9 \u062e\u0627\u0635 \u0628\u06cc\u062c \u0645\u06cc\u06ba \u0628\u062f\u0644 \u062f\u06cc\u0627 \u06c1\u06d2 \u2014 \u0627\u0633\u06d2 \u062d\u0627\u0635\u0644 \u06a9\u0631\u0646\u0627 \u0646\u06c1 \u0628\u06be\u0648\u0644\u06cc\u06ba\u06d4"
