{
  "subject": "\u0648\u06c1 \u0631\u0627\u0632 \u062c\u0648 \u0645\u06cc\u06ba \u0646\u06d2 70 \u062f\u0646 \u0645\u06cc\u06ba \u0633\u06cc\u06a9\u06be\u0627",
  "preview_text": "\u06a9\u06cc\u0627 \u0622\u067e \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0622\u067e \u06a9\u06d2 \u0688\u06cc\u0679\u0627 \u0646\u06d2 \u06c1\u0645\u0627\u0631\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0648\u06ba \u06a9\u0648 \u06a9\u06cc\u0633\u06d2 \u0628\u062f\u0644 \u062f\u06cc\u0627\u061f \u06cc\u06c1 \u06a9\u06be\u0648\u0644\u06cc\u06ba \u0627\u0648\u0631 \u062c\u0627\u0646\u06cc\u06ba\u06d4",
  "body_paragraphs": [
    "\u0645\u06cc\u06ba \u062c\u06be\u0648\u0679 \u0646\u06c1\u06cc\u06ba \u0628\u0648\u0644\u0648\u06ba \u06af\u0627 - \u062c\u0628 \u06c1\u0645 \u0646\u06d2 \u067e\u0631\u06cc\u0688\u06a9\u0679\u0627\u0626\u0641 \u0634\u0631\u0648\u0639 \u06a9\u06cc\u0627 \u062a\u06be\u0627\u060c \u062a\u0648 \u06c1\u0645 \u0635\u0631\u0641 \u0627\u06cc\u06a9 \u0627\u0648\u0631 \u0627\u06cc\u067e \u062a\u06be\u06d2\u06d4 \u0644\u06cc\u06a9\u0646 \u0622\u067e \u062c\u06cc\u0633\u06d2 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u06cc \u0628\u062f\u0648\u0644\u062a\u060c \u06c1\u0645 \u06a9\u0686\u06be \u0627\u0648\u0631 \u0628\u0646 \u06af\u0626\u06d2\u06d4 \u0622\u067e \u06a9\u06d2 \u0688\u06cc\u0679\u0627\u060c \u0622\u067e \u06a9\u06cc \u067e\u0633\u0646\u062f\u060c \u0622\u067e \u06a9\u06d2 \u0645\u06cc\u0686\u0648\u06ba \u06a9\u06d2 \u062a\u062c\u0632\u06cc\u06d2 \u0646\u06d2 \u06c1\u0645\u06cc\u06ba \u0648\u06c1 \u0628\u0635\u06cc\u0631\u062a \u062f\u06cc \u062c\u0648 \u06a9\u0633\u06cc \u0627\u0648\u0631 \u06a9\u06d2 \u067e\u0627\u0633 \u0646\u06c1\u06cc\u06ba\u06d4 \u0622\u067e \u0635\u0631\u0641 \u0627\u06cc\u06a9 \u0635\u0627\u0631\u0641 \u0646\u06c1\u06cc\u06ba \u0631\u06c1\u06d2 - \u0622\u067e \u0627\u0633 \u0645\u0634\u0646 \u06a9\u0627 \u062d\u0635\u06c1 \u0628\u0646 \u06af\u0626\u06d2\u06d4",
    "\u06cc\u06c1\u0627\u06ba 70 \u062f\u0646\u0648\u06ba \u0645\u06cc\u06ba \u062c\u0648 \u0645\u06cc\u06ba \u0646\u06d2 \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u06cc\u0627: \u062c\u0628 \u0622\u067e \u0627\u067e\u0646\u06cc \u062c\u0628\u0644\u062a \u06a9\u0648 \u0688\u06cc\u0679\u0627 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062c\u0648\u0691\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u062a\u0648 \u06a9\u0686\u06be \u062c\u0627\u062f\u0648\u0626\u06cc \u06c1\u0648\u062a\u0627 \u06c1\u06d2\u06d4 \u06c1\u0645\u0627\u0631\u06d2 AI \u0646\u06d2 \u0644\u0627\u06a9\u06be\u0648\u06ba \u0645\u062a\u063a\u06cc\u0631\u0627\u062a \u06a9\u0627 \u062a\u062c\u0632\u06cc\u06c1 \u06a9\u06cc\u0627\u060c \u0644\u06cc\u06a9\u0646 \u0622\u067e \u06a9\u06d2 \u0641\u06cc\u0635\u0644\u06d2 \u0648\u06c1 \u062a\u06be\u06d2 \u062c\u0646\u06c1\u0648\u06ba \u0646\u06d2 \u06c1\u0645\u06cc\u06ba \u0633\u06a9\u06be\u0627\u06cc\u0627 \u06a9\u06c1 \u06a9\u0648\u0646 \u0633\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0627\u06ba \u0648\u0627\u0642\u0639\u06cc \u0627\u06c1\u0645 \u06c1\u06cc\u06ba\u06d4 \u0627\u0628 \u06c1\u0645 \u0627\u06cc\u06a9 \u0628\u0631\u0627\u062f\u0631\u06cc \u06c1\u06cc\u06ba - \u0648\u06c1 \u0644\u0648\u06af \u062c\u0648 \u0627\u062d\u0633\u0627\u0633 \u0633\u06d2 \u0646\u06c1\u06cc\u06ba\u060c \u0628\u0644\u06a9\u06c1 \u062b\u0628\u0648\u062a \u0633\u06d2 \u062c\u06cc\u062a\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",
    "\u06a9\u06cc\u0627 \u0622\u067e \u0646\u06d2 \u06a9\u0628\u06be\u06cc \u0633\u0648\u0686\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u06a9\u0627 '\u06a9\u0646\u0641\u06cc\u0688\u0646\u0633 \u0633\u06a9\u0648\u0631' \u06a9\u06cc\u0648\u06ba \u0628\u062f\u0644\u062a\u0627 \u06c1\u06d2\u061f \u06cc\u06c1 \u0635\u0631\u0641 \u0627\u06cc\u06a9 \u0646\u0645\u0628\u0631 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 - \u06cc\u06c1 \u0622\u067e \u06a9\u06d2 \u0627\u067e\u0646\u06d2 \u062a\u062c\u0632\u06cc\u06d2 \u06a9\u0627 \u0646\u062a\u06cc\u062c\u06c1 \u06c1\u06d2\u06d4 \u062c\u0628 \u0622\u067e IQ \u06a9\u0648\u0626\u0632 \u06a9\u06be\u06cc\u0644\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u062a\u0648 \u0622\u067e \u0646\u06c1 \u0635\u0631\u0641 \u062e\u0648\u062f \u06a9\u0648 \u0628\u06c1\u062a\u0631 \u0628\u0646\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u0628\u0644\u06a9\u06c1 \u067e\u0648\u0631\u06cc \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc \u06a9\u06d2 \u0644\u06cc\u06d2 \u0631\u0627\u0633\u062a\u06c1 \u0631\u0648\u0634\u0646 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0622\u062c \u06c1\u06cc \u0627\u0633 \u0641\u06cc\u0686\u0631 \u06a9\u0648 \u0622\u0632\u0645\u0627\u0626\u06cc\u06ba \u0627\u0648\u0631 \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u06a9\u06c1 \u0622\u067e \u06a9\u0627 \u0633\u06a9\u0648\u0631 \u06a9\u06cc\u0633\u06d2 \u0628\u0691\u06be\u062a\u0627 \u06c1\u06d2\u06d4",
    "\u062a\u0648 \u0627\u0628 \u0648\u0642\u062a \u06c1\u06d2: \u067e\u0631\u06cc\u0688\u06a9\u0679\u0627\u0626\u0641 \u06a9\u06be\u0648\u0644\u06cc\u06ba\u060c \u0627\u067e\u0646\u06cc \u0631\u0648\u0632\u0627\u0646\u06c1 \u06a9\u06cc \u0633\u0679\u0631\u06cc\u06a9 \u062c\u0627\u0631\u06cc \u0631\u06a9\u06be\u06cc\u06ba\u060c \u0627\u0648\u0631 \u0622\u062c \u06a9\u06d2 '\u067e\u0631\u06cc\u0688\u06a9\u0634\u0646 \u0622\u0641 \u062f\u06cc \u0688\u06d2' \u067e\u0631 \u0648\u0648\u0679 \u062f\u06cc\u06ba\u06d4 \u0622\u067e \u06a9\u06cc \u0627\u06cc\u06a9 \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc \u067e\u0648\u0631\u06cc \u06a9\u0645\u06cc\u0648\u0646\u0679\u06cc \u06a9\u0648 \u0628\u062f\u0644 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u06d4 \u067e\u06cc \u0627\u06cc\u0633: \u067e\u0631\u06cc\u0645\u06cc\u0645 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0627\u06cc\u06a9 \u062e\u0641\u06cc\u06c1 \u0641\u06cc\u0686\u0631 \u0645\u0644\u0627 \u06c1\u06d2 - \u06a9\u06cc\u0627 \u0622\u067e \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 AI \u0686\u06cc\u0679 \u0645\u06cc\u06ba \u0622\u067e \u0627\u067e\u0646\u06d2 \u067e\u0633\u0646\u062f\u06cc\u062f\u06c1 \u06a9\u06be\u0644\u0627\u0691\u06cc \u06a9\u06d2 \u0627\u06cc\u06a9\u0633 \u062c\u06cc \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u067e\u0648\u0686\u06be \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u061f"
  ],
