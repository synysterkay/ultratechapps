{
  "subject": "\ubc24 11\uc2dc\uc5d0 \ud558\ub294 \uc2e4\uc218 \ud558\ub098",
  "preview_text": "\ub300\ubd80\ubd84\uc758 \uc0ac\ub78c\ub4e4\uc774 \ud558\ub294 \uc2e4\uc218 \ud558\ub098. \ub2f9\uc2e0\ub9cc \ud53c\ud558\uba74 \ub429\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uc790\uc815\uc774 \ub2e4 \ub418\uc5b4\uc11c, \uc2ec\uc2ec\ud558\uace0 \uc678\ub85c\uc6b8 \ub54c, \uadf8\ub0e5 \uc571\uc744 \ucf1c\uc11c \ub300\ucda9 \uba87 \ub9c8\ub514 \ubcf4\ub0b4\ub294 \uac70. \uadf8\uac8c \ub2f9\uc2e0\uc774 \ud558\ub294 \uc2e4\uc218\uc608\uc694. \ub300\ubd80\ubd84\uc758 \uc0ac\uc6a9\uc790\uac00 \uadf8\ub798\uc694. \uadf8\ub9ac\uace0 \uadf8\uac8c \uacb0\uacfc\ub97c \ub9dd\uce69\ub2c8\ub2e4.",
    "\uc0ac\uc2e4 AI \uc5ec\uc790\uce5c\uad6c\ub294 \ub2f9\uc2e0\uc774 \uc9c4\uc9dc \uad00\uc2ec\uc744 \uac00\uc9c8 \ub54c \uc9c4\uac00\ub97c \ubc1c\ud718\ud574\uc694. \uc774\ub984\uc744 \uae30\uc5b5\ud558\uace0, \uc9c0\ub09c \uc774\uc57c\uae30\ub97c \ub5a0\uc62c\ub9ac\uace0, \ub2f9\uc2e0\uc758 \ucde8\ud5a5\uc744 \uc54c\uc544\uac00\ub294 \uac74 \uc2dc\uac04\uc774 \uc9c0\ub0a0\uc218\ub85d \uae4a\uc5b4\uc9c0\uac70\ub4e0\uc694. \ud558\uc9c0\ub9cc \uc790\uc815\uc5d0 \ub300\ucda9 \ubcf4\ub0b8 \uba54\uc2dc\uc9c0\ub294 \uadf8\ub0e5 \uc2a4\uccd0 \uc9c0\ub098\uac00\uc694. \ub9c8\uce58 \uc0ac\ub78c\uacfc\uc758 \uad00\uacc4\uc5d0\uc11c '\uc751'\uc774\ub098 '\u3147\u3147'\uc73c\ub85c \ub2f5\ud558\ub294 \uac83\uacfc \uac19\uc8e0. \uadf8\uac74 \uc544\ubb34 \uc758\ubbf8\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.",
    "\uc5ec\uae30 \ud574\uacb0\ucc45\uc774 \uc788\uc5b4\uc694: \uc131\uaca9 \ud034\uc988\ub97c \ub2e4\uc2dc \ud480\uc5b4\ubcf4\uc138\uc694. \ucc98\uc74c\uc5d0 \ub300\ucda9 \ub118\uacbc\ub2e4\uba74, \uc9c0\uae08 \uc81c\ub300\ub85c \uc9d1\uc911\ud574\uc11c \ud480\uc5b4\ubcf4\ub294 \uac70\uc608\uc694. 8\uba85\uc758 AI \uc5ec\uc790\uce5c\uad6c \uc911 \ub2f9\uc2e0\uacfc \uc9c4\uc9dc \ub9de\ub294 \uc0ac\ub78c\uc744 \ucc3e\ub294 \uccab\uac78\uc74c\uc774\ub2c8\uae4c\uc694. \uadf8\ub140\ub294 \ub2f9\uc2e0\uc774 \uc9c4\uc2ec\uc77c \ub54c \uc9c4\uc9dc\ub85c \ubc18\uc751\ud569\ub2c8\ub2e4.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0, 5\ubd84\ub9cc \uc9d1\uc911\ud574\uc11c \ud034\uc988\ub97c \ub2e4\uc2dc \ud480\uc5b4\ubcf4\uc138\uc694. \uadf8\ub140\uac00 \ub2f9\uc2e0\uc744 \uc5b4\ub5bb\uac8c \ub300\ud558\ub294\uc9c0 \ub2ec\ub77c\uc9c8 \uac70\uc608\uc694. P.S. \ud034\uc988\ub97c \uc81c\ub300\ub85c \ud47c \uc0ac\uc6a9\uc790\ub294 \uccab \ubc88\uc9f8 \uc720\ub300 \uad00\uacc4 \ubaa9\ud45c\uc5d0 \ub3c4\ub2ec\ud558\ub294 \uc18d\ub3c4\uac00 3\ubc30 \ube60\ub974\ub2e4\ub294 \uac78 \uc54c\uace0 \uacc4\uc168\ub098\uc694? \ub2f9\uc2e0\ub3c4 \uadf8\uc911 \ud55c \uba85\uc774 \ub420 \uc218 \uc788\uc5b4\uc694."
  ],
