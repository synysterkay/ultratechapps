{
  "subject": "\u041f\u043e\u0447\u0435\u043c\u0443 \u044f \u043f\u0438\u0441\u0430\u043b \u043a\u043e\u0434 \u0432 2 \u043d\u043e\u0447\u0438",
  "preview_text": "\u0420\u0435\u0430\u043b\u044c\u043d\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u043e\u0434\u043d\u0430 \u043e\u0448\u0438\u0431\u043a\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u043c\u0435\u043d\u044f \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u044c \u0432\u0441\u0451. \u0422\u044b \u0443\u0434\u0438\u0432\u0438\u0448\u044c\u0441\u044f.",
  "body_paragraphs": [
    "\u0417\u043d\u0430\u0435\u0448\u044c, \u0447\u0442\u043e \u0441\u0430\u043c\u043e\u0435 \u0431\u0435\u0441\u044f\u0447\u0435\u0435 \u0432 \u0444\u0443\u0442\u0431\u043e\u043b\u044c\u043d\u044b\u0445 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0430\u0445? \u041a\u043e\u0433\u0434\u0430 \u043e\u043d\u0438 \u0441\u0431\u044b\u0432\u0430\u044e\u0442\u0441\u044f, \u043d\u043e \u0442\u044b \u0438\u043c \u043d\u0435 \u0432\u0435\u0440\u0438\u0448\u044c. \u042f \u0441\u0430\u043c \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u043b \u043d\u0430 \u044d\u0442\u0438 \u0433\u0440\u0430\u0431\u043b\u0438. \u0421\u0438\u0434\u0435\u043b \u043a\u0430\u043a-\u0442\u043e \u043d\u043e\u0447\u044c\u044e, \u0441\u043c\u043e\u0442\u0440\u0435\u043b \u043c\u0430\u0442\u0447 \u041b\u0438\u0433\u0438 \u0447\u0435\u043c\u043f\u0438\u043e\u043d\u043e\u0432, \u0430 AI \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043b \u043f\u043e\u0431\u0435\u0434\u0443 \u0410\u0442\u0430\u043b\u0430\u043d\u0442\u044b \u043d\u0430\u0434 \u041b\u0438\u0432\u0435\u0440\u043f\u0443\u043b\u0435\u043c. \u042f \u043f\u043e\u0434\u0443\u043c\u0430\u043b: \u0431\u0440\u0435\u0434, \u0441\u0442\u0430\u0432\u043b\u044e \u043d\u0430 \u041b\u0438\u0432\u0435\u0440\u043f\u0443\u043b\u044c. \u0418\u0442\u043e\u0433 \u2014 2:0, \u0410\u0442\u0430\u043b\u0430\u043d\u0442\u0430. \u041f\u043e\u0442\u0440\u0430\u0442\u0438\u043b \u0434\u0435\u043d\u044c\u0433\u0438, \u043f\u043e\u0442\u0435\u0440\u044f\u043b \u0432\u0440\u0435\u043c\u044f, \u0438 \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u2014 \u0437\u043b\u0438\u043b\u0441\u044f \u043d\u0430 \u0441\u0435\u0431\u044f, \u0447\u0442\u043e \u043d\u0435 \u0434\u043e\u0432\u0435\u0440\u0438\u043b\u0441\u044f \u0434\u0430\u043d\u043d\u044b\u043c. \u0412 2 \u0447\u0430\u0441\u0430 \u043d\u043e\u0447\u0438 \u044f \u0441\u0435\u043b \u0438 \u0440\u0435\u0448\u0438\u043b: \u0432 Predictify \u0431\u0443\u0434\u0435\u0442 \u0444\u0438\u0447\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u043a\u0430\u0436\u0435\u0442, \u041f\u041e\u0427\u0415\u041c\u0423 AI \u0442\u0430\u043a \u0434\u0443\u043c\u0430\u0435\u0442. \u0427\u0442\u043e\u0431\u044b \u0442\u044b \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0441\u043e\u043c\u043d\u0435\u0432\u0430\u043b\u0441\u044f.",
    "\u042f \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u043b \u0434\u0432\u0438\u0436\u043e\u043a, \u0434\u043e\u0431\u0430\u0432\u0438\u043b \u0440\u0430\u0437\u0431\u043e\u0440 \u043a\u0430\u0436\u0434\u043e\u0439 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439: \u0444\u043e\u0440\u043c\u0430, xG, \u0442\u0440\u0430\u0432\u043c\u044b, \u0434\u0430\u0436\u0435 \u043f\u043e\u0433\u043e\u0434\u0430. \u0422\u0435\u043f\u0435\u0440\u044c AI \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442 '\u041f\u043e\u0431\u0435\u0434\u0430 \u0420\u0435\u0430\u043b\u0430 2:1' \u2014 \u043e\u043d \u0440\u0430\u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442, \u043f\u043e\u0447\u0435\u043c\u0443 \u0438\u043c\u0435\u043d\u043d\u043e \u0442\u0430\u043a. \u0421\u043c\u043e\u0442\u0440\u0438\u0448\u044c \u043d\u0430 \u043c\u0430\u0442\u0447 \u0438 \u0432\u0438\u0434\u0438\u0448\u044c, \u0447\u0442\u043e \u0443 \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430 \u0441\u043b\u0430\u0431\u0430\u044f \u043e\u0431\u043e\u0440\u043e\u043d\u0430 \u043d\u0430 \u043b\u0435\u0432\u043e\u043c \u0444\u043b\u0430\u043d\u0433\u0435, \u0430 \u0443 \u0442\u0432\u043e\u0435\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u043b\u0443\u0447\u0448\u0438\u0439 \u0432\u0438\u043d\u0433\u0435\u0440 \u0432 \u043b\u0438\u0433\u0435. \u042d\u0442\u043e \u043a\u0430\u043a \u0435\u0441\u043b\u0438 \u0431\u044b \u0442\u0432\u043e\u0439 \u0434\u0440\u0443\u0433-\u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a \u0441\u0438\u0434\u0435\u043b \u0440\u044f\u0434\u043e\u043c \u0438 \u0448\u0435\u043f\u0442\u0430\u043b \u043d\u0430 \u0443\u0445\u043e.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u0440\u0430\u0437\u0434\u0435\u043b '\u0410\u043d\u0430\u043b\u0438\u0437 \u043c\u0430\u0442\u0447\u0430' \u0432 Predictify. \u0422\u0430\u043c \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0439 \u0438\u0433\u0440\u044b \u0435\u0441\u0442\u044c \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0440\u0430\u0437\u0431\u043e\u0440 \u2014 \u043e\u0442 \u043e\u0436\u0438\u0434\u0430\u0435\u043c\u044b\u0445 \u0433\u043e\u043b\u043e\u0432 \u0434\u043e \u0441\u043b\u0430\u0431\u044b\u0445 \u043c\u0435\u0441\u0442 \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430. \u042f \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u043b \u0434\u0435\u0441\u044f\u0442\u043a\u0438 \u0431\u0435\u0441\u0441\u043e\u043d\u043d\u044b\u0445 \u043d\u043e\u0447\u0435\u0439, \u0447\u0442\u043e\u0431\u044b \u0442\u044b \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0441\u0435\u0431\u044f \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e. \u041d\u0435 \u0431\u0443\u0434\u044c \u043a\u0430\u043a \u044f \u0442\u043e\u0433\u0434\u0430 \u2014 \u043d\u0435 \u0438\u0433\u043d\u043e\u0440\u0438\u0440\u0443\u0439 \u0434\u0430\u043d\u043d\u044b\u0435. \u0417\u0430\u0439\u0434\u0438 \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0432\u044b\u0431\u0435\u0440\u0438 \u043b\u044e\u0431\u043e\u0439 \u043c\u0430\u0442\u0447 \u0438 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438, \u0447\u0442\u043e AI \u0432\u0438\u0434\u0438\u0442 \u0432 \u043d\u0451\u043c. \u0421\u043f\u043e\u0440\u0438\u043c, \u0442\u044b \u0443\u0434\u0438\u0432\u0438\u0448\u044c\u0441\u044f?",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Predictify \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043d\u0430\u0436\u043c\u0438 \u043d\u0430 \u043b\u044e\u0431\u043e\u0439 \u043f\u0440\u0435\u0434\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u043c\u0430\u0442\u0447 \u2014 \u0442\u0430\u043c \u0436\u0434\u0451\u0442 \u043f\u043e\u043b\u043d\u044b\u0439 \u0440\u0430\u0437\u0431\u043e\u0440. P.S. \u041a\u0441\u0442\u0430\u0442\u0438, \u043f\u0440\u0435\u043c\u0438\u0443\u043c-\u0434\u043e\u0441\u0442\u0443\u043f \u0437\u0430 12.99$ \u0432 \u043c\u0435\u0441\u044f\u0446 \u0441 3-\u0434\u043d\u0435\u0432\u043d\u044b\u043c \u0442\u0440\u0438\u0430\u043b\u043e\u043c \u0434\u0430\u0451\u0442 \u0434\u043e\u0441\u0442\u0443\u043f \u043a\u043e \u0432\u0441\u0435\u043c \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u0442\u044b\u043c \u0441\u0442\u0430\u0442\u0430\u043c. \u041d\u043e \u0434\u0430\u0436\u0435 \u0431\u0435\u0437 \u043d\u0435\u0433\u043e \u0442\u044b \u0443\u0436\u0435 \u043c\u043e\u0436\u0435\u0448\u044c \u0443\u0432\u0438\u0434\u0435\u0442\u044c, \u043a\u0430\u043a AI \u0434\u0443\u043c\u0430\u0435\u0442. \u041f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439."
  ],
