  "subject": "\u062a\u062d\u0644\u064a\u0644 10,000 \u0645\u0633\u062a\u062e\u062f\u0645 \u0643\u0634\u0641 \u0634\u064a\u0626\u064b\u0627 \u0635\u0627\u062f\u0645\u064b\u0627",
  "preview_text": "\u0647\u0644 \u062a\u0639\u0644\u0645 \u0623\u0646 83% \u0645\u0646 \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a \u0627\u0644\u062e\u0627\u0637\u0626\u0629 \u062a\u0623\u062a\u064a \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u062e\u0637\u0623 \u0627\u0644\u0634\u0627\u0626\u0639\u061f \u0627\u0643\u062a\u0634\u0641 \u0627\u0644\u0633\u0631 \u0627\u0644\u0630\u064a \u064a\u063a\u064a\u0631 \u0637\u0631\u064a\u0642\u0629 \u062a\u062d\u0644\u064a\u0644\u0643 \u0644\u0644\u0645\u0628\u0627\u0631\u064a\u0627\u062a.",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u062a\u0631\u0627\u0647\u0646 \u0639\u0644\u0649 \u0641\u0648\u0632 \u0631\u064a\u0627\u0644 \u0645\u062f\u0631\u064a\u062f\u060c \u0644\u0643\u0646 AI \u064a\u0642\u0648\u0644 \u063a\u064a\u0631 \u0630\u0644\u0643. \u0642\u0645\u0646\u0627 \u0628\u062a\u062d\u0644\u064a\u0644 10,000 \u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u0648\u062c\u062f\u0646\u0627 \u0634\u064a\u0626\u064b\u0627 \u064a\u063a\u064a\u0631 \u0643\u0644 \u0634\u064a\u0621: 83% \u0645\u0646 \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a \u0627\u0644\u062e\u0627\u0637\u0626\u0629 \u0643\u0627\u0646\u062a \u0628\u0633\u0628\u0628 \u062a\u062c\u0627\u0647\u0644 \u0639\u0627\u0645\u0644 \u0648\u0627\u062d\u062f \u0628\u0633\u064a\u0637\u2014\u0627\u0644\u062a\u0634\u0643\u064a\u0644\u0629 \u0627\u0644\u0645\u062a\u0648\u0642\u0639\u0629 \u0642\u0628\u0644 24 \u0633\u0627\u0639\u0629 \u0645\u0646 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629. \u0646\u0639\u0645\u060c \u0647\u0630\u0627 \u0627\u0644\u0631\u0642\u0645 \u0635\u0627\u062f\u0645.",
    "\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0644\u0627 \u062a\u0643\u0630\u0628. \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u0627\u0639\u062a\u0645\u062f\u0648\u0627 \u0639\u0644\u0649 '\u0627\u0644\u062d\u062f\u0633' \u0641\u0642\u0637 \u062e\u0633\u0631\u0648\u0627 3 \u0623\u0636\u0639\u0627\u0641 \u0645\u0646 \u0627\u062e\u062a\u0627\u0631\u0648\u0627 \u0627\u0644\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u062a\u0642\u062f\u0645. \u0644\u0643\u0646 \u0627\u0644\u0641\u0631\u0642 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u061f \u0645\u0646 \u064a\u0633\u062a\u062e\u062f\u0645 \u0645\u064a\u0632\u0629 '\u0627\u0644\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u062a\u0643\u062a\u064a\u0643\u064a' \u064a\u0632\u064a\u062f \u062f\u0642\u0629 \u062a\u0648\u0642\u0639\u0627\u062a\u0647 \u0628\u0646\u0633\u0628\u0629 40%. \u0647\u0644 \u0623\u0646\u062a \u0645\u0646\u0647\u0645\u061f",
    "\u0641\u064a Predictify\u060c \u0646\u0645\u0646\u062d\u0643 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0645\u062c\u0631\u062f \u062a\u0648\u0642\u0639\u0627\u062a. \u0623\u062f\u062e\u0644 \u0623\u064a \u0645\u0628\u0627\u0631\u0627\u0629\u2014\u0645\u062b\u0644 \u0628\u0631\u0634\u0644\u0648\u0646\u0629 \u0636\u062f \u0623\u062a\u0644\u062a\u064a\u0643\u0648 \u0645\u062f\u0631\u064a\u062f\u2014\u0648\u0634\u0627\u0647\u062f AI \u064a\u062d\u0644\u0644 5,000 \u0645\u062a\u063a\u064a\u0631: \u0645\u0646 xG \u0625\u0644\u0649 \u0627\u0644\u0636\u063a\u0637 \u0627\u0644\u062f\u0641\u0627\u0639\u064a. \u0643\u0644 \u062a\u0648\u0642\u0639 \u064a\u0623\u062a\u064a \u0645\u0639 \u062f\u0631\u062c\u0629 \u062b\u0642\u0629\u060c \u062a\u0639\u0631\u0641 \u0645\u062a\u0649 \u062a\u0643\u0648\u0646 \u0645\u062a\u0623\u0643\u062f\u064b\u0627 \u0648\u0645\u062a\u0649 \u062a\u062a\u0631\u062f\u062f.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628 \u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u064a\u0648\u0645. \u0627\u0628\u062d\u062b \u0639\u0646 \u0623\u064a \u0641\u0631\u064a\u0642 \u0641\u064a '\u0627\u0644\u0628\u062d\u062b \u0627\u0644\u0630\u0643\u064a' \u0648\u0627\u0646\u0638\u0631 \u0625\u0644\u0649 \u0627\u0644\u0641\u0631\u0642 \u0628\u0646\u0641\u0633\u0643. \u0645\u0644\u0627\u062d\u0638\u0629: \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0645\u0645\u064a\u0632\u0648\u0646 \u064a\u062d\u0635\u0644\u0648\u0646 \u0639\u0644\u0649 \u062a\u062d\u0644\u064a\u0644 \u0645\u062a\u0642\u062f\u0645 \u0644\u0640 50+ \u062f\u0648\u0631\u064a\u2014\u062c\u0631\u0628 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629 \u0644\u0645\u062f\u0629 3 \u0623\u064a\u0627\u0645 \u0648\u0627\u0631\u0641\u0639 \u062f\u0642\u062a\u0643."
