{
  "subject": "\ub0b4\uac00 \ub9cc\ub4e0 \uc571, \uc194\uc9c1\ud55c \uace0\ubc31",
  "preview_text": "\ubcf4\ud1b5 \uc774\ub7f0 \uc774\uba54\uc77c \uc548 \uc4f0\ub294\ub370, \uc624\ub298\uc740 \uaf2d \ud558\uace0 \uc2f6\uc740 \ub9d0\uc774 \uc788\uc5b4\uc11c\uc694.",
  "body_paragraphs": [
    "\ubcf4\ud1b5 \uc774\ub7f0 \uc774\uba54\uc77c \uc798 \uc548 \uc368\uc694. \uadfc\ub370 \uc624\ub298 \uc0c8\ubcbd 2\uc2dc, \ud63c\uc790 \uc571 \ub85c\uadf8 \ubcf4\ub2e4\uac00 \uac11\uc790\uae30 \uc0dd\uac01\ub0ac\uc5b4\uc694. \uc6b0\ub9ac \uc571\uc744 \ub2e4\uc6b4\ubc1b\uc740 \uc9c0 39\uc77c\uc9f8, \uc544\uc9c1\ub3c4 \ub9e4\uc77c 1\ubd84\uc774\ub77c\ub3c4 \uc4f0\uc2dc\ub294 \ubd84\uc774 \uc788\ub294\uac00? \uc544\ub2c8\uba74 \ubc8c\uc368 \uc78a\ud600\uc84c\uc744\uae4c?",
    "\uc194\uc9c1\ud788 \ub9d0\ud558\uba74, \uc774 \uc571\uc740 '\ub370\uc774\ud2b8 \ud50c\ub798\ub108' \uadf8 \uc774\uc0c1\uc73c\ub85c \ub9cc\ub4e4\uace0 \uc2f6\uc5c8\uc5b4\uc694. \uc5f0\uc778\uc774 \uc11c\ub85c\ub97c \ubc14\ub77c\ubcf4\ub294 \uc2dc\uc120, \uadf8 \uc791\uc740 \uc21c\uac04\ub4e4\uc744 \uae30\ub85d\ud558\ub294 \uacf5\uac04. \ud30c\ud2b8\ub108\uac00 '\uc624\ub298 \ub124\uac00 \uc0dd\uac01\ub0ac\uc5b4'\ub77c\uace0 \ubcf4\ub0b4\uba74, \uc54c\ub9bc\uc774 \uc544\ub2c8\ub77c \ud480\uc2a4\ud06c\ub9b0\uc73c\ub85c \ubc18\uaca8\uc8fc\ub294 \uadf8 \uc7a5\uba74. \uadf8\uac8c \uadf8\ub0e5 \uae30\ub2a5\uc774 \uc544\ub2c8\ub77c, \uc9c4\uc9dc \uc5f0\uacb0\uc758 \uc99d\uac70\uac00 \ub418\uae38 \ubc14\ub790\uac70\ub4e0\uc694.",
    "\uadf8\ub7f0\ub370 \ub9d0\uc774\uc8e0, \uc544\uc9c1 '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \uce74\ub4dc\ub97c \ud55c \ubc88\ub3c4 \uc548 \uc5f4\uc5b4\ubcf4\uc168\ub2e4\uba74? \ud30c\ud2b8\ub108\uc5d0\uac8c \uc81c\uc548\uc744 \ubcf4\ub0b4\ub294 \uadf8 \uc190\uac00\ub77d \uc6c0\uc9c1\uc784\uc774, \uc0ac\uc2e4 '\ub108\ub97c \uc0dd\uac01\ud558\uace0 \uc788\uc5b4'\ub77c\ub294 \uac00\uc7a5 \uc26c\uc6b4 \ud45c\ud604\uc774\ub77c\ub294 \uac78 \uc54c\ub824\ub4dc\ub9ac\uace0 \uc2f6\uc5b4\uc694. 30\ucd08\uba74 \ub3fc\uc694. \uae30\ubd84 \uace0\ub974\uace0, \uce74\ub4dc \ud558\ub098 \ub531. \uadf8\uac8c \uc624\ub298 \ubc24\uc744 \ubc14\uafc9\ub2c8\ub2e4.",
    "\uc9c0\uae08 \uc571 \uc5f4\uc5b4\uc11c '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ud55c \ubc88\ub9cc \ud0ed\ud574\ubcf4\uc138\uc694. \ud30c\ud2b8\ub108\uac00 \uc5b4\ub5a4 \ubc18\uc751\uc744 \ubcf4\uc77c\uc9c0 \uad81\uae08\ud558\uc9c0 \uc54a\ub098\uc694? P.S. \uae30\uc5b5 \ud0c0\uc784\ub77c\uc778\uc5d0 \uc624\ub298 \ub0a0\uc9dc\uac00 \ube44\uc5b4 \uc788\uc73c\uba74, \ub098\uc911\uc5d0 \ud6c4\ud68c\ud560 \uac70\uc608\uc694. \uadf8 \ube48\uce78\uc740 \ub2e4\uc2dc \ubabb \ucc44\uc6b0\ub2c8\uae4c."
  ],
