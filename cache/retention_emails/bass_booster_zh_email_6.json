{
  "subject": "\u4f60\u6b63\u5728\u72af\u7684\u7b2c11\u5929\u9519\u8bef",
  "preview_text": "\u5927\u591a\u6570\u4eba\u5728\u7b2c3\u5929\u5c31\u653e\u5f03\u4e86\uff0c\u4f46\u7b2c11\u5929\u624d\u662f\u771f\u6b63\u6539\u53d8\u7684\u65f6\u523b\u3002",
  "body_paragraphs": [
    "\u542c\u7740\u3002\u4f60\u5b89\u88c5\u4e86Bass Booster\uff0c\u7136\u540e\u5462\uff1f\u5927\u591a\u6570\u7528\u6237\u72af\u7684\u7b2c\u4e00\u4e2a\u9519\u8bef\u662f\u2014\u2014\u4ed6\u4eec\u53ea\u6ed1\u4e86\u4e00\u4e0bBoost\u6ed1\u5757\uff0c\u89c9\u5f97\u201c\u54e6\uff0c\u5927\u58f0\u4e86\u201d\uff0c\u7136\u540e\u5c31\u5173\u6389\u4e86\u3002\u8fd9\u5c31\u50cf\u4e70\u4e86\u8f86\u8dd1\u8f66\u5374\u53ea\u5f00\u4e86\u4e00\u6863\u3002\u4f60\u9519\u8fc7\u4e86\u771f\u6b63\u7684\u6838\u5fc3\u3002",
    "\u771f\u76f8\u662f\uff1a\u4f60\u7684\u624b\u673a\u548c\u8033\u673a\u672c\u8eab\u5c31\u50cf\u88ab\u9609\u5272\u7684\u97f3\u54cd\u3002\u7cfb\u7edf\u9ed8\u8ba4\u7684EQ\u628a\u4f60\u6700\u559c\u6b22\u7684Drop\u524a\u6210\u4e86\u7eb8\u7247\u3002\u4f60\u4ee5\u4e3a\u201c\u5927\u58f0\u201d\u5c31\u591f\u4e86\uff1f\u4e0d\u3002\u4f60\u9700\u8981\u628a\u4f4e\u9891\u4ece\u7b3c\u5b50\u91cc\u653e\u51fa\u6765\u3002\u90a3\u4e2a\u201c\u7830\u201d\u7684\u611f\u89c9\uff0c\u90a3\u4e2a\u8ba9\u4f60\u80f8\u53e3\u4e00\u9707\u7684\u77ac\u95f4\u2014\u2014\u4e0d\u662f\u97f3\u91cf\uff0c\u662f\u9891\u7387\u3002",
    "\u6211\u544a\u8bc9\u4f60\uff0c90%\u7684\u4eba\u4ece\u6ca1\u78b0\u8fc7\u90a3\u4e2a10\u6bb5EQ\u3002\u4ed6\u4eec\u4e0d\u77e5\u9053\uff0c\u53ea\u8981\u628a60Hz\u62c9\u9ad83\u683c\uff0c\u518d\u5fae\u8c03125Hz\uff0c\u4f60\u7684Hip-Hop\u5c31\u4f1a\u4ece\u201c\u542c\u6b4c\u201d\u53d8\u6210\u201c\u88ab\u6b4c\u6253\u4e2d\u201d\u3002\u5c31\u50cf\u7ed9\u4f60\u7684\u8033\u6735\u88c5\u4e86\u4e00\u4e2a\u5c0f\u578b\u7684Subwoofer\u3002\u6253\u5f00Bass Booster\uff0c\u70b9EQ\uff0c\u9009\u201c\u97f3\u4e50\u201d\u9884\u8bbe\u2014\u2014\u7136\u540e\u611f\u53d7\u3002",
    "\u73b0\u5728\u6253\u5f00\u5e94\u7528\u3002\u53bbEQ\u9875\u9762\uff0c\u628a60Hz\u62c9\u5230\u9876\uff0c\u7136\u540e\u653e\u4e00\u9996\u4f60\u719f\u6089\u7684\u6b4c\u3002\u4f60\u7acb\u523b\u4f1a\u77e5\u9053\u6211\u5728\u8bf4\u4ec0\u4e48\u3002P.S. \u5982\u679c\u4f60\u60f3\u8981\u66f4\u731b\uff0cPremium\u7684\u65e0\u9650Boost\u548c\u5b8c\u657410\u6bb5EQ\u80fd\u8ba9\u4f60\u81ea\u5b9a\u4e49\u5230\u5934\u53d1\u7ad6\u8d77\u6765\u3002\u8bd5\u8bd5\u770b\u2014\u2014\u4f60\u5df2\u7ecf\u6709\u514d\u8d39\u8bd5\u7528\u4e86\uff0c\u522b\u6d6a\u8d39\u3002"
  ],
