{
  "subject": "63 \u0434\u043d\u044f, 10000 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439, \u043e\u0434\u0438\u043d \u0432\u044b\u0432\u043e\u0434",
  "preview_text": "\u041c\u044b \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b\u0438 \u0434\u0430\u043d\u043d\u044b\u0435 \u0437\u0430 63 \u0434\u043d\u044f. \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0432\u0430\u0441 \u0443\u0434\u0438\u0432\u0438\u0442.",
  "body_paragraphs": [
    "63 \u0434\u043d\u044f \u043d\u0430\u0437\u0430\u0434 \u0432\u044b \u0441\u043a\u0430\u0447\u0430\u043b\u0438 Volume Booster Pro. \u0417\u0430 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f 10 000 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u043f\u0440\u043e\u0448\u043b\u0438 \u0442\u043e\u0442 \u0436\u0435 \u043f\u0443\u0442\u044c. \u041c\u044b \u0438\u0437\u0443\u0447\u0438\u043b\u0438 \u0438\u0445 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u2014 \u0438 \u043d\u0430\u0448\u043b\u0438 \u043a\u043e\u0435-\u0447\u0442\u043e \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e\u0435.",
    "\u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043e\u0434\u0438\u043d \u0440\u0430\u0437. \u041d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c. \u0418 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0437\u0430\u0445\u043e\u0434\u0438\u0442 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438. \u0417\u0432\u0443\u0447\u0438\u0442 \u0437\u043d\u0430\u043a\u043e\u043c\u043e? \u041d\u043e \u0432\u043e\u0442 \u0447\u0442\u043e \u0441\u0442\u0440\u0430\u043d\u043d\u043e: \u0442\u0435, \u043a\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u0430\u0432\u0442\u043e\u0437\u0430\u043f\u0443\u0441\u043a \u043f\u0440\u0438 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u043e\u0432, \u0441\u043b\u0443\u0448\u0430\u044e\u0442 \u043c\u0443\u0437\u044b\u043a\u0443 \u043d\u0430 30% \u0433\u0440\u043e\u043c\u0447\u0435. \u0418 \u043d\u0435 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u044e\u0442\u0441\u044f \u043a \u0441\u043b\u0430\u0439\u0434\u0435\u0440\u0443.",
    "\u0424\u0443\u043d\u043a\u0446\u0438\u044f \u00ab\u0410\u0432\u0442\u043e-\u0431\u0443\u0441\u0442\u00bb \u2014 \u044d\u0442\u043e \u0442\u0438\u0445\u0430\u044f \u0441\u0438\u043b\u0430. \u0412\u044b \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0435 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438, \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0434\u0435\u043b\u0430\u0435\u0442 \u0441\u0432\u043e\u0451 \u0434\u0435\u043b\u043e, \u0430 \u0432\u044b \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u0442\u0435 \u043e \u043d\u0451\u043c. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439, \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0439. \u041f\u0440\u043e\u0441\u0442\u043e \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0431\u0435\u0437 \u0440\u0435\u043a\u043b\u0430\u043c\u044b, \u043a\u0430\u043a \u0438 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c.",
    "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0443\u0439\u0442\u0435 \u00ab\u0410\u0432\u0442\u043e-\u0431\u0443\u0441\u0442\u00bb \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445. P.S. \u0417\u0430 63 \u0434\u043d\u044f \u0443 \u0432\u0430\u0441 \u0431\u044b\u043b\u043e \u0440\u043e\u0432\u043d\u043e 0 \u043f\u0440\u0435\u0440\u044b\u0432\u0430\u043d\u0438\u0439 \u043e\u0442 \u0440\u0435\u043a\u043b\u0430\u043c\u044b. \u041c\u044b \u043e\u0431\u0435\u0449\u0430\u043b\u0438 \u2014 \u043c\u044b \u0441\u0434\u0435\u043b\u0430\u043b\u0438."
