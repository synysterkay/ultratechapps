    "\u305d\u306e\u6a5f\u80fd\u3068\u306f\u3001\u300cConfidence Score\u300d\u3067\u3059\u3002\u5404\u4e88\u6e2c\u306e\u6a2a\u306b\u3042\u308b\u3042\u306e\u5c0f\u3055\u306a\u30d1\u30fc\u30bb\u30f3\u30c6\u30fc\u30b8\u3002\u3053\u308c\u306f\u3001AI\u304c\u305d\u306e\u4e88\u6e2c\u306b\u5bfe\u3057\u3066\u3069\u308c\u3060\u3051\u78ba\u4fe1\u3092\u6301\u3063\u3066\u3044\u308b\u304b\u3092\u793a\u3059\u3001\u552f\u4e00\u7121\u4e8c\u306e\u6307\u6a19\u300285%\u3068\u8868\u793a\u3055\u308c\u3066\u3044\u308c\u3070\u3001\u305d\u308c\u306f\u904e\u53bb\u306e\u985e\u4f3c\u30c7\u30fc\u30bf\u306b\u57fa\u3065\u304f\u9ad8\u3044\u78ba\u5ea6\u300250%\u306a\u3089\u3001\u8a66\u5408\u306f\u4e94\u5206\u4e94\u5206\u3002\u3053\u306e\u6570\u5b57\u3092\u77e5\u308b\u3060\u3051\u3067\u3001\u3042\u306a\u305f\u306e\u6d1e\u5bdf\u306f\u5358\u306a\u308b\u300c\u5f53\u3066\u305a\u3063\u307d\u3046\u300d\u304b\u3089\u300c\u30c7\u30fc\u30bf\u306b\u88cf\u6253\u3061\u3055\u308c\u305f\u6226\u7565\u300d\u306b\u5909\u308f\u308a\u307e\u3059\u3002",
    "\u4eca\u3059\u3050\u30a2\u30d7\u30ea\u3092\u958b\u3044\u3066\u3001\u4eca\u591c\u306e\u8a66\u5408\u306eConfidence Score\u3092\u30c1\u30a7\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3069\u306e\u4e88\u6e2c\u304c\u672c\u7269\u306e\u300c\u4fa1\u5024\u300d\u3092\u6301\u3063\u3066\u3044\u308b\u304b\u3001\u4e00\u76ee\u3067\u308f\u304b\u308a\u307e\u3059\u3002P.S. \u3053\u306e\u6a5f\u80fd\u3092\u7121\u8996\u3057\u7d9a\u3051\u308b\u30e6\u30fc\u30b6\u30fc\u306f\u3001\u5e73\u5747\u3057\u30663\u500d\u3082\u591a\u304f\u306e\u300c\u898b\u9003\u3057\u305f\u30c1\u30e3\u30f3\u30b9\u300d\u3092\u5f8c\u6094\u3057\u3066\u3044\u308b\u3068\u3044\u3046\u5185\u90e8\u30c7\u30fc\u30bf\u304c\u3042\u308a\u307e\u3059\u3002",
