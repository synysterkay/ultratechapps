  "preview_text": "\u3053\u308c\u3092\u4f7f\u308f\u306a\u3044\u3068\u3001\u305b\u3063\u304b\u304f\u306eAI\u4e88\u6e2c\u306e\u771f\u4fa1\u3092\u534a\u5206\u3082\u5f15\u304d\u51fa\u305b\u3066\u3044\u306a\u3044\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002",
  "body_paragraphs": [
    "\u6b63\u76f4\u306b\u8a00\u3046\u3068\u3001\u6700\u521d\u306e\u30e1\u30fc\u30eb\u3067\u306f\u8a00\u3044\u306b\u304f\u304b\u3063\u305f\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u591a\u304f\u306e\u30e6\u30fc\u30b6\u30fc\u304c\u3001\u3053\u306e\u30a2\u30d7\u30ea\u306e\u6700\u3082\u5f37\u529b\u306a\u90e8\u5206\u3092\u5b8c\u5168\u306b\u898b\u843d\u3068\u3057\u3066\u3044\u308b\u3093\u3067\u3059\u3002\u30c7\u30fc\u30bf\u306b\u57fa\u3065\u304b\u306a\u3044\u76f4\u611f\u3067\u4e88\u60f3\u3092\u7acb\u3066\u7d9a\u3051\u308b\u306e\u3068\u540c\u3058\u304f\u3089\u3044\u3001\u3082\u3063\u305f\u3044\u306a\u3044\u3053\u3068\u3067\u3059\u3002",
