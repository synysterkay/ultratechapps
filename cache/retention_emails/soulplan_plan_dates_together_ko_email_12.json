{
  "subject": "\uc9c0\ub09c\uc8fc \ud654\uc694\uc77c \ubc24 11\uc2dc, \uadf8\ub140\uac00 \ud55c \ub9d0",
  "preview_text": "\ud55c \ucee4\ud50c\uc774 \uc774 \uae30\ub2a5\uc744 \ubc1c\uacac\ud558\uace0 \ubaa8\ub4e0 \uac8c \ub2ec\ub77c\uc84c\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\ub3c4 \uc544\uc9c1 \ubaa8\ub974\ub294 \uadf8 \uae30\ub2a5.",
  "body_paragraphs": [
    "\uc9c0\ub09c\uc8fc \ud654\uc694\uc77c, \ubc24 11\uc2dc. \ud55c \uc0ac\uc6a9\uc790\uac00 \uc571\uc744 \uc5f4\uc5c8\uc5b4\uc694. \ud3c9\uc18c\ucc98\ub7fc \uc624\ub298\uc758 \ub370\uc774\ud2b8\ub97c \ud655\uc778\ud558\ub824\uace0\uc694. \uadf8\ub7f0\ub370 \uadf8\ub0a0\ub530\ub77c \ud30c\ud2b8\ub108\uac00 \ubcf4\ub0b8 \uc81c\uc548\uc774 \ud558\ub098 \uc788\uc5c8\uc8e0. '\uc624\ub298\uc740 \uadf8\ub0e5 \uc9d1\uc5d0\uc11c \uc601\ud654 \ubcf4\ub294 \uac8c \uc5b4\ub54c?'\ub77c\ub294 \uba54\uc2dc\uc9c0\uc5d0, \uadf8\ub294 \uc5b4\uae68\ub97c \uc73c\uc4f1\ud558\uba70 '\uc88b\uc544'\ub77c\uace0 \ub2f5\ud588\uc5b4\uc694. \uadf8\ub0a0 \ubc24, \ub450 \uc0ac\ub78c\uc740 \ud3c9\ubc94\ud55c \ud654\uc694\uc77c\uc744 \uc78a\uc9c0 \ubabb\ud560 \ucd94\uc5b5\uc73c\ub85c \ubc14\uafe8\uc2b5\ub2c8\ub2e4. \uc774 \ubcc0\ud654\ub294 \ub2e8\uc21c\ud55c \uae30\ub2a5 \ud558\ub098\uc5d0\uc11c \uc2dc\uc791\ub410\uc5b4\uc694.",
    "\uadf8 \uae30\ub2a5\uc740 \ubc14\ub85c '\uc704\uc2dc\ub9ac\uc2a4\ud2b8'\uc785\ub2c8\ub2e4. \ucc98\uc74c \uc571\uc744 \ucf1c\uba74 \ubcf4\uc774\ub294 '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\uc5d0\ub9cc \uc9d1\uc911\ud558\ub290\ub77c, \ub9ce\uc740 \ucee4\ud50c\uc774 \uc774 \uc228\uaca8\uc9c4 \ubcf4\uc11d\uc744 \ub193\uce58\uace0 \uc788\uc5b4\uc694. \uc704\uc2dc\ub9ac\uc2a4\ud2b8\ub294 \ub2e8\uc21c\ud55c \uc800\uc7a5\uc18c\uac00 \uc544\ub2d9\ub2c8\ub2e4. \ud30c\ud2b8\ub108\uac00 '\uc5b8\uc820\uac00 \ud574\ubcf4\uace0 \uc2f6\uc740' \uc544\uc774\ub514\uc5b4\ub97c \ubaa8\uc544\ub450\uba74, AI\uac00 \uadf8\uac78 \ubd84\uc11d\ud574 \ub531 \ub9de\ub294 \uc21c\uac04\uc5d0 \uc81c\uc548\uc73c\ub85c \ubc14\uafd4\uc918\uc694. \ud55c \ucee4\ud50c\uc740 \uc774 \uae30\ub2a5 \ub355\ubd84\uc5d0 3\uc8fc \ub9cc\uc5d0 \ub370\uc774\ud2b8 \ud69f\uc218\uac00 \ub450 \ubc30\ub85c \ub298\uc5c8\uace0, \uc11c\ub85c\uc5d0 \ub300\ud55c \uc774\ud574\ub3c4 \uae4a\uc5b4\uc84c\ub2e4\uace0 \ub9d0\ud588\uc5b4\uc694.",
    "\ub2f9\uc2e0\uc758 \uc704\uc2dc\ub9ac\uc2a4\ud2b8, \uc9c0\uae08 \ud655\uc778\ud574\ubcf4\uc168\ub098\uc694? \uc544\ub9c8\ub3c4 \ud30c\ud2b8\ub108\uac00 \ubab0\ub798 \ub123\uc5b4\ub454 \uc544\uc774\ub514\uc5b4\uac00 \uae30\ub2e4\ub9ac\uace0 \uc788\uc744\uc9c0\ub3c4 \ubab0\ub77c\uc694. '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \ud654\uba74\uc5d0\uc11c \uc624\ub978\ucabd \uc0c1\ub2e8\uc758 \ubcc4\ud45c\ub97c \ud0ed\ud558\uba74 \ubc14\ub85c \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac70\uae30\uc5d4 \ub2f9\uc2e0\uc774 \uc78a\uace0 \uc788\ub358, \ud639\uc740 \uc544\uc9c1 \uaebc\ub0b4\uc9c0 \ubabb\ud55c \ub85c\ub9e8\uc2a4\uc758 \uc528\uc557\uc774 \uc228\uc5b4 \uc788\uc5b4\uc694.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uc5b4 \uc704\uc2dc\ub9ac\uc2a4\ud2b8\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694. \uadf8 \uc548\uc5d0 \ud30c\ud2b8\ub108\uc758 \ub9c8\uc74c\uc774 \ub2f4\uaca8 \uc788\uc744 \ud14c\ub2c8\uae4c. P.S. \ub9cc\uc57d \uc704\uc2dc\ub9ac\uc2a4\ud2b8\uac00 \ube44\uc5b4 \uc788\ub2e4\uba74, \uc624\ub298 \ubc24 \ud30c\ud2b8\ub108\uc5d0\uac8c '\ub124\uac00 \uac00\uc7a5 \uac00\uace0 \uc2f6\uc740 \ub370\uc774\ud2b8 \uc7a5\uc18c\ub294 \uc5b4\ub514\uc57c?'\ub77c\uace0 \ubb3c\uc5b4\ubcf4\ub294 \uac83\ub3c4 \uc88b\uc740 \uc2dc\uc791\uc774\uc5d0\uc694."
  ],
