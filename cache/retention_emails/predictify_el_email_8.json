{
  "subject": "\u0397 \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1 \u03c4\u03bf\u03c5 \u0393\u03b9\u03ce\u03c1\u03b3\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03ac\u03bb\u03bb\u03b1\u03be\u03b5 \u03c4\u03b1 \u03c0\u03ac\u03bd\u03c4\u03b1",
  "preview_text": "\u0391\u03c0\u03cc \u03c4\u03bf \u03c0\u03bf\u03c5\u03b8\u03b5\u03bd\u03ac, \u03bc\u03b9\u03b1 \u03b1\u03c0\u03bb\u03ae \u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03c4\u03bf\u03bd \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b5 \u03c3\u03b5 \u03ad\u03bd\u03b1 \u03c4\u03b1\u03be\u03af\u03b4\u03b9 \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03c0\u03b5\u03c1\u03af\u03bc\u03b5\u03bd\u03b5. \u039c\u03ac\u03b8\u03b5 \u03c4\u03b9 \u03ad\u03ba\u03b1\u03bd\u03b5 \u03ba\u03b1\u03b9 \u03c0\u03ce\u03c2 \u03ac\u03bb\u03bb\u03b1\u03be\u03b5 \u03c4\u03bf\u03bd \u03c4\u03c1\u03cc\u03c0\u03bf \u03c0\u03bf\u03c5 \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9 \u03c4\u03bf \u03c0\u03bf\u03b4\u03cc\u03c3\u03c6\u03b1\u03b9\u03c1\u03bf.",
  "body_paragraphs": [
    "\u0398\u03c5\u03bc\u03ac\u03c3\u03b1\u03b9 \u03b5\u03ba\u03b5\u03af\u03bd\u03b7 \u03c4\u03b7 \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae \u03c0\u03bf\u03c5 \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9\u03c2 \u03ad\u03bd\u03b1 \u03bc\u03b1\u03c4\u03c2 \u03ba\u03b1\u03b9 \u03bd\u03b9\u03ce\u03b8\u03b5\u03b9\u03c2 \u03cc\u03c4\u03b9 \u03ba\u03ac\u03c4\u03b9 \u03c3\u03bf\u03c5 \u03be\u03b5\u03c6\u03b5\u03cd\u03b3\u03b5\u03b9; \u039f \u0393\u03b9\u03ce\u03c1\u03b3\u03bf\u03c2, \u03ad\u03bd\u03b1\u03c2 \u03c6\u03af\u03bb\u03bf\u03c2 \u03c0\u03bf\u03c5 \u03b1\u03b3\u03b1\u03c0\u03ac\u03b5\u03b9 \u03c4\u03b7 La Liga \u03cc\u03c3\u03bf \u03b5\u03c3\u03cd, \u03b5\u03af\u03c7\u03b5 \u03b1\u03ba\u03c1\u03b9\u03b2\u03ce\u03c2 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf \u03c3\u03c5\u03bd\u03b1\u03af\u03c3\u03b8\u03b7\u03bc\u03b1 \u03c0\u03c1\u03b9\u03bd \u03b1\u03c0\u03cc \u03b4\u03cd\u03bf \u03b2\u03b4\u03bf\u03bc\u03ac\u03b4\u03b5\u03c2. \u0395\u03af\u03c7\u03b5 \u03c7\u03ac\u03c3\u03b5\u03b9 \u03c4\u03c1\u03af\u03b1 \u03c3\u03c4\u03bf\u03b9\u03c7\u03ae\u03bc\u03b1\u03c4\u03b1 \u03c3\u03c4\u03b7 \u03c3\u03b5\u03b9\u03c1\u03ac, \u03b2\u03b1\u03c3\u03b9\u03b6\u03cc\u03bc\u03b5\u03bd\u03bf\u03c2 \u03c3\u03c4\u03b7 \u03b4\u03b9\u03b1\u03af\u03c3\u03b8\u03b7\u03c3\u03ae \u03c4\u03bf\u03c5.",
    "\u039c\u03ad\u03c7\u03c1\u03b9 \u03c0\u03bf\u03c5 \u03b1\u03c0\u03bf\u03c6\u03ac\u03c3\u03b9\u03c3\u03b5 \u03bd\u03b1 \u03b4\u03bf\u03ba\u03b9\u03bc\u03ac\u03c3\u03b5\u03b9 \u03ba\u03ac\u03c4\u03b9 \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03b5\u03c4\u03b9\u03ba\u03cc. \u0386\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03bf Predictify, \u03b5\u03af\u03b4\u03b5 \u03c4\u03b7\u03bd \u03b1\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u03b3\u03b9\u03b1 \u03c4\u03bf \u03bc\u03b1\u03c4\u03c2 \u039c\u03c0\u03b1\u03c1\u03c4\u03c3\u03b5\u03bb\u03cc\u03bd\u03b1 \u2013 \u0392\u03b1\u03bb\u03ad\u03bd\u03b8\u03b9\u03b1, \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03ba\u03ac\u03bb\u03c5\u03c8\u03b5 \u03cc\u03c4\u03b9 \u03b7 \u03ac\u03bc\u03c5\u03bd\u03b1 \u03c4\u03b7\u03c2 \u0392\u03b1\u03bb\u03ad\u03bd\u03b8\u03b9\u03b1 \u03b5\u03af\u03c7\u03b5 20% \u03c7\u03b1\u03bc\u03b7\u03bb\u03cc\u03c4\u03b5\u03c1\u03b7 \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u03c3\u03c4\u03bf xG \u03b1\u03c0\u03cc \u03c4\u03bf \u03c3\u03c5\u03bd\u03b7\u03b8\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf. \u0397 AI \u03c4\u03bf\u03c5 \u03ad\u03b4\u03b5\u03b9\u03be\u03b5 \u03ad\u03bd\u03b1 confidence score 78% \u03b3\u03b9\u03b1 \u03bd\u03af\u03ba\u03b7 \u03c4\u03b7\u03c2 \u039c\u03c0\u03b1\u03c1\u03c4\u03c3\u03b5\u03bb\u03cc\u03bd\u03b1, \u03b1\u03bb\u03bb\u03ac \u03bc\u03b5 \u03bb\u03b9\u03b3\u03cc\u03c4\u03b5\u03c1\u03b1 \u03b1\u03c0\u03cc 2.5 \u03b3\u03ba\u03bf\u03bb. \u0391\u03c5\u03c4\u03ae \u03b7 \u03bb\u03b5\u03c0\u03c4\u03bf\u03bc\u03ad\u03c1\u03b5\u03b9\u03b1 \u03ac\u03bb\u03bb\u03b1\u03be\u03b5 \u03c4\u03b7\u03bd \u03c0\u03c1\u03cc\u03b2\u03bb\u03b5\u03c8\u03ae \u03c4\u03bf\u03c5.",
    "\u0391\u03c0\u03cc \u03c4\u03cc\u03c4\u03b5, \u03bf \u0393\u03b9\u03ce\u03c1\u03b3\u03bf\u03c2 \u03b4\u03b5\u03bd \u03b2\u03b1\u03c3\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c0\u03b9\u03b1 \u03c3\u03c4\u03bf \u03ad\u03bd\u03c3\u03c4\u03b9\u03ba\u03c4\u03bf. \u03a7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03b9\u03c2 deep player stats, \u03c4\u03b7\u03bd \u03b1\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u03c4\u03b1\u03ba\u03c4\u03b9\u03ba\u03ae\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b1 head-to-head \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03b3\u03b9\u03b1 \u03ba\u03ac\u03b8\u03b5 \u03bc\u03b1\u03c4\u03c2. \u039a\u03b1\u03b9 \u03c4\u03bf \u03ba\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03bf; \u039c\u03c0\u03bf\u03c1\u03b5\u03af\u03c2 \u03bd\u03b1 \u03ba\u03ac\u03bd\u03b5\u03b9\u03c2 \u03c4\u03bf \u03af\u03b4\u03b9\u03bf. \u039c\u03c0\u03b5\u03c2 \u03c3\u03c4\u03bf IQ Quiz, \u03b4\u03b5\u03c2 \u03c0\u03bf\u03cd \u03b2\u03c1\u03af\u03c3\u03ba\u03b5\u03c3\u03b1\u03b9 \u03c3\u03c4\u03b7 \u03b2\u03b1\u03b8\u03bc\u03bf\u03bb\u03bf\u03b3\u03af\u03b1 \u03ba\u03b1\u03b9 \u03ac\u03c1\u03c7\u03b9\u03c3\u03b5 \u03bd\u03b1 \u03ba\u03b5\u03c1\u03b4\u03af\u03b6\u03b5\u03b9\u03c2.",
    "\u0386\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03bf Predictify \u03c4\u03ce\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03b4\u03b5\u03c2 \u03ad\u03bd\u03b1 \u03bc\u03b1\u03c4\u03c2 \u03bc\u03b5 \u03c4\u03b1 \u03bc\u03ac\u03c4\u03b9\u03b1 \u03c4\u03b7\u03c2 AI. P.S. \u0397 \u03b1\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u03b3\u03b9\u03b1 \u03c4\u03bf \u03b1\u03c5\u03c1\u03b9\u03b1\u03bd\u03cc clasico \u03ad\u03c7\u03b5\u03b9 \u03ae\u03b4\u03b7 \u03b1\u03bd\u03ad\u03b2\u03b5\u03b9 \u2014 \u03c1\u03af\u03be\u03b5 \u03bc\u03b9\u03b1 \u03bc\u03b1\u03c4\u03b9\u03ac \u03c0\u03c1\u03b9\u03bd \u03c4\u03bf \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9."
