{
  "subject": "\u03a4\u03bf \u03bb\u03ac\u03b8\u03bf\u03c2 \u03c0\u03bf\u03c5 \u03ad\u03ba\u03b1\u03bd\u03b1 \u03c3\u03c4\u03b1 \u03c0\u03c1\u03bf\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03ac \u03bc\u03bf\u03c5",
  "preview_text": "\u0388\u03bd\u03b1\u03c2 \u03c6\u03af\u03bb\u03bf\u03c2 \u03bc\u03bf\u03c5 \u03b5\u03af\u03c7\u03b5 \u03c4\u03b1 \u03af\u03b4\u03b9\u03b1 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ae\u03bc\u03b1\u03c4\u03b1 \u03bc\u03b5 \u03c3\u03ad\u03bd\u03b1. \u0394\u03b5\u03c2 \u03c0\u03ce\u03c2 \u03c4\u03b1 \u03bb\u03cd\u03c3\u03b1\u03bc\u03b5.",
  "body_paragraphs": [
    "\u03a6\u03af\u03bb\u03b5, \u03b8\u03c5\u03bc\u03ac\u03bc\u03b1\u03b9 \u03cc\u03c4\u03b1\u03bd \u03c0\u03c1\u03c9\u03c4\u03bf\u03be\u03b5\u03ba\u03af\u03bd\u03b7\u03c3\u03b1 \u03bd\u03b1 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03ce \u03c4\u03bf Predictify, \u03ae\u03bc\u03bf\u03c5\u03bd \u03c4\u03b5\u03bb\u03b5\u03af\u03c9\u03c2 \u03c7\u03b1\u03bc\u03ad\u03bd\u03bf\u03c2. \u0388\u03ba\u03b1\u03bd\u03b1 \u03c0\u03c1\u03bf\u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03ac \u03bc\u03b5 \u03b2\u03ac\u03c3\u03b7 \u03c4\u03bf \u03ad\u03bd\u03c3\u03c4\u03b9\u03ba\u03c4\u03bf, \u03b1\u03bb\u03bb\u03ac \u03c4\u03b9\u03c2 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b5\u03c2 \u03c6\u03bf\u03c1\u03ad\u03c2 \u03ad\u03c0\u03b5\u03c6\u03c4\u03b1 \u03ad\u03be\u03c9. \u039c\u03b9\u03b1 \u03bc\u03ad\u03c1\u03b1, \u03ad\u03bd\u03b1\u03c2 \u03c6\u03af\u03bb\u03bf\u03c2 \u03bc\u03bf\u03c5, \u03bf \u0393\u03b9\u03ce\u03c1\u03b3\u03bf\u03c2, \u03bc\u03bf\u03c5 \u03b5\u03af\u03c0\u03b5 \u03cc\u03c4\u03b9 \u03b5\u03af\u03c7\u03b5 \u03c4\u03b1 \u03af\u03b4\u03b9\u03b1 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ae\u03bc\u03b1\u03c4\u03b1. '\u039a\u03ac\u03b8\u03b5 \u03c6\u03bf\u03c1\u03ac \u03c0\u03bf\u03c5 \u03c0\u03bf\u03bd\u03c4\u03ac\u03c1\u03c9 \u03c3\u03b5 \u03ad\u03bd\u03b1\u03bd \u03b1\u03b3\u03ce\u03bd\u03b1, \u03bd\u03b9\u03ce\u03b8\u03c9 \u03cc\u03c4\u03b9 \u03b4\u03b5\u03bd \u03ad\u03c7\u03c9 \u03ba\u03b1\u03bc\u03af\u03b1 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03b9\u03b4\u03ad\u03b1', \u03bc\u03bf\u03c5 \u03b5\u03af\u03c0\u03b5. '\u0391\u03c0\u03bb\u03ac \u03bc\u03b1\u03bd\u03c4\u03b5\u03cd\u03c9'. \u0391\u03c5\u03c4\u03cc \u03bc\u03bf\u03c5 \u03b8\u03cd\u03bc\u03b9\u03c3\u03b5 \u03b5\u03bc\u03ad\u03bd\u03b1.",
    "\u039f \u0393\u03b9\u03ce\u03c1\u03b3\u03bf\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c6\u03b1\u03bd\u03b1\u03c4\u03b9\u03ba\u03cc\u03c2 \u03bf\u03c0\u03b1\u03b4\u03cc\u03c2 \u03c4\u03bf\u03c5 \u039f\u03bb\u03c5\u03bc\u03c0\u03b9\u03b1\u03ba\u03bf\u03cd \u03ba\u03b1\u03b9 \u03c4\u03b7\u03c2 Premier League. \u0395\u03af\u03c7\u03b5 \u03c7\u03ac\u03c3\u03b5\u03b9 \u03c0\u03bf\u03bb\u03bb\u03ac \u03c3\u03c4\u03bf\u03b9\u03c7\u03ae\u03bc\u03b1\u03c4\u03b1 \u03b5\u03c0\u03b5\u03b9\u03b4\u03ae \u03b4\u03b5\u03bd \u03b5\u03af\u03c7\u03b5 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1. \u039c\u03ad\u03c7\u03c1\u03b9 \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b1\u03ba\u03ac\u03bb\u03c5\u03c8\u03b5 \u03c4\u03bf AI \u03c4\u03bf\u03c5 Predictify. '\u039e\u03ad\u03c1\u03b5\u03b9\u03c2 \u03c4\u03b9;' \u03bc\u03bf\u03c5 \u03b5\u03af\u03c0\u03b5 \u03bc\u03b9\u03b1 \u03bc\u03ad\u03c1\u03b1. '\u03a4\u03bf AI \u03b1\u03bd\u03ad\u03bb\u03c5\u03c3\u03b5 \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03b7\u03b3\u03bf\u03cd\u03bc\u03b5\u03bd\u03b7 \u03b1\u03c0\u03cc\u03b4\u03bf\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03bf\u03bc\u03ac\u03b4\u03b1\u03c2, \u03c4\u03b1 xG, \u03ba\u03b1\u03b9 \u03c4\u03b9\u03c2 \u03b1\u03bc\u03c5\u03bd\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b1\u03b4\u03c5\u03bd\u03b1\u03bc\u03af\u03b5\u03c2. \u039a\u03b1\u03b9 \u03bc\u03bf\u03c5 \u03ad\u03b4\u03c9\u03c3\u03b5 \u03ad\u03bd\u03b1 confidence score 87% \u03b3\u03b9\u03b1 \u03bc\u03b9\u03b1 \u03bd\u03af\u03ba\u03b7. \u039a\u03b1\u03b9 \u03ad\u03c0\u03b5\u03c3\u03b5 \u03b1\u03ba\u03c1\u03b9\u03b2\u03ce\u03c2!' \u0391\u03c0\u03cc \u03c4\u03cc\u03c4\u03b5, \u03c3\u03c4\u03b1\u03bc\u03ac\u03c4\u03b7\u03c3\u03b5 \u03bd\u03b1 \u03bc\u03b1\u03bd\u03c4\u03b5\u03cd\u03b5\u03b9 \u03ba\u03b1\u03b9 \u03ac\u03c1\u03c7\u03b9\u03c3\u03b5 \u03bd\u03b1 \u03be\u03ad\u03c1\u03b5\u03b9.",
    "\u03a4\u03bf \u03bc\u03c5\u03c3\u03c4\u03b9\u03ba\u03cc \u03b5\u03af\u03bd\u03b1\u03b9 \u03bf\u03b9 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ad\u03c8\u03b5\u03b9\u03c2 \u03bc\u03b5 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1, \u03cc\u03c7\u03b9 \u03bc\u03b5 \u03ad\u03bd\u03c3\u03c4\u03b9\u03ba\u03c4\u03bf. \u039c\u03ad\u03c3\u03b1 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae, \u03c5\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9 \u03bc\u03b9\u03b1 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03c0\u03bf\u03c5 \u03bb\u03ad\u03b3\u03b5\u03c4\u03b1\u03b9 'AI Predictions'. \u03a3\u03bf\u03c5 \u03b4\u03b5\u03af\u03c7\u03bd\u03b5\u03b9 confidence scores, xG, \u03ba\u03b1\u03b9 head-to-head \u03b1\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u03b3\u03b9\u03b1 \u03ba\u03ac\u03b8\u03b5 \u03b1\u03b3\u03ce\u03bd\u03b1. \u0391\u03bd\u03c4\u03af \u03bd\u03b1 \u03b2\u03b1\u03c3\u03af\u03b6\u03b5\u03c3\u03b1\u03b9 \u03c3\u03c4\u03bf \u03c3\u03c5\u03bd\u03b1\u03af\u03c3\u03b8\u03b7\u03bc\u03b1, \u03b1\u03c6\u03ae\u03bd\u03b5\u03b9\u03c2 \u03c4\u03bf AI \u03bd\u03b1 \u03c3\u03bf\u03c5 \u03c0\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b1\u03bb\u03ae\u03b8\u03b5\u03b9\u03b1. \u039f \u0393\u03b9\u03ce\u03c1\u03b3\u03bf\u03c2 \u03c4\u03bf \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03ce\u03c1\u03b1 \u03b3\u03b9\u03b1 \u03ba\u03ac\u03b8\u03b5 \u03b1\u03b3\u03ce\u03bd\u03b1, \u03ba\u03b1\u03b9 \u03c4\u03b1 \u03ba\u03ad\u03c1\u03b4\u03b7 \u03c4\u03bf\u03c5 \u03ad\u03c7\u03bf\u03c5\u03bd \u03b1\u03bd\u03ad\u03b2\u03b5\u03b9 \u03c3\u03b7\u03bc\u03b1\u03bd\u03c4\u03b9\u03ba\u03ac.",
    "\u0391\u03bd\u03bf\u03af\u03be\u03b5 \u03c4\u03bf Predictify \u03c4\u03ce\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03c0\u03ae\u03b3\u03b1\u03b9\u03bd\u03b5 \u03c3\u03c4\u03bf 'AI Predictions'. \u0394\u03b5\u03c2 \u03ad\u03bd\u03b1\u03bd \u03b1\u03b3\u03ce\u03bd\u03b1 \u03c0\u03bf\u03c5 \u03c3\u03b5 \u03b5\u03bd\u03b4\u03b9\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03ba\u03b1\u03b9 \u03c3\u03cd\u03b3\u03ba\u03c1\u03b9\u03bd\u03b5 \u03c4\u03bf confidence score \u03bc\u03b5 \u03c4\u03bf \u03ad\u03bd\u03c3\u03c4\u03b9\u03ba\u03c4\u03cc \u03c3\u03bf\u03c5. \u0398\u03b1 \u03b5\u03ba\u03c0\u03bb\u03b1\u03b3\u03b5\u03af\u03c2 \u03b1\u03c0\u03cc \u03c4\u03b7 \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03ac. P.S. \u039c\u03b7\u03bd \u03be\u03b5\u03c7\u03ac\u03c3\u03b5\u03b9\u03c2 \u03bd\u03b1 \u03c4\u03c3\u03b5\u03ba\u03ac\u03c1\u03b5\u03b9\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03bf IQ Quiz \u2014 \u03bf \u0393\u03b9\u03ce\u03c1\u03b3\u03bf\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 #12 \u03c3\u03c4\u03b7\u03bd \u03c0\u03b1\u03b3\u03ba\u03cc\u03c3\u03bc\u03b9\u03b1 \u03ba\u03b1\u03c4\u03ac\u03c4\u03b1\u03be\u03b7 \u03ba\u03b1\u03b9 \u03bb\u03ad\u03b5\u03b9 \u03cc\u03c4\u03b9 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c0\u03b9\u03bf \u03b5\u03b8\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03ba\u03b9 \u03b1\u03c0\u03cc \u03c4\u03b1 \u03c3\u03c4\u03bf\u03b9\u03c7\u03ae\u03bc\u03b1\u03c4\u03b1!"
  ],
