{
  "subject": "\u0637\u0631\u064a\u0642\u0629 \u062a\u062e\u062a\u0635\u0631 20 \u062f\u0642\u064a\u0642\u0629 \u0641\u064a \u062f\u0642\u064a\u0642\u062a\u064a\u0646",
  "preview_text": "\u0643\u064a\u0641 \u062a\u0648\u0641\u0631 \u0648\u0642\u062a\u0643 \u0645\u0639 Bass Booster \u0648\u062a\u062d\u0635\u0644 \u0639\u0644\u0649 \u0635\u0648\u062a \u062c\u0647\u064a\u0631 \u0642\u0648\u064a \u0641\u064a \u062b\u0648\u0627\u0646\u064d",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u062a\u0633\u062a\u0645\u0639 \u0644\u0623\u063a\u0646\u064a\u062a\u0643 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0639\u0644\u0649 Spotify\u060c \u0648\u062a\u0634\u0639\u0631 \u0623\u0646 \u0627\u0644\u0635\u0648\u062a \u0645\u0633\u0637\u062d\u060c \u0628\u062f\u0648\u0646 \u0639\u0645\u0642. \u0643\u0646\u062a \u062a\u0642\u0636\u064a 20 \u062f\u0642\u064a\u0642\u0629 \u0641\u064a \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u060c \u062a\u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a\u060c \u062a\u062e\u0641\u0636\u0647\u060c \u062a\u062c\u0631\u0628 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0623\u062e\u0631\u0649\u060c \u0648\u062a\u0646\u062a\u0647\u064a \u0628\u062e\u064a\u0628\u0629 \u0623\u0645\u0644. \u0647\u0630\u0627 \u0643\u0627\u0646 \u0648\u0636\u0639\u064a \u0642\u0628\u0644 Bass Booster.",
    "\u0627\u0644\u062d\u0642\u064a\u0642\u0629 \u0623\u0646 \u062a\u0648\u0641\u064a\u0631 \u0627\u0644\u0648\u0642\u062a \u0644\u064a\u0633 \u062d\u0644\u0645\u064b\u0627. \u0645\u0639 Bass Booster\u060c \u0643\u0644 \u0645\u0627 \u062a\u062d\u062a\u0627\u062c\u0647 \u0647\u0648 \u062f\u0642\u064a\u0642\u062a\u064a\u0646. \u0627\u0633\u062d\u0628 \u0634\u0631\u064a\u0637 Boost \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629\u060c \u0648\u0633\u064a\u0635\u0628\u062d \u0635\u0648\u062a\u0643 \u0623\u0639\u0644\u0649 \u0628\u0640200% \u0645\u0646 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0646\u0638\u0627\u0645. \u0644\u0627 \u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0639\u0627\u0646\u0627\u0629 \u0645\u0639 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0647\u0627\u062a\u0641 \u0627\u0644\u0645\u0645\u0644\u0629.",
    "\u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u0633\u0631\u064a\u0629 \u0647\u064a Bass Virtualizer. \u0641\u064a \u062f\u0642\u064a\u0642\u062a\u064a\u0646\u060c \u064a\u0645\u0643\u0646\u0643 \u062a\u0634\u063a\u064a\u0644\u0647\u0627 \u0645\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0648\u0633\u062a\u0634\u0639\u0631 \u0623\u0646 \u0627\u0644\u062f\u0631\u0648\u0628 \u062a\u0636\u0631\u0628 \u0641\u064a \u0635\u062f\u0631\u0643 \u062d\u062a\u0649 \u0639\u0644\u0649 \u0633\u0645\u0627\u0639\u0627\u062a \u0627\u0644\u0623\u0630\u0646 \u0627\u0644\u0631\u062e\u064a\u0635\u0629. \u062c\u0631\u0628\u0647\u0627 \u0639\u0644\u0649 \u0623\u063a\u0646\u064a\u062a\u0643 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u0641\u064a Hip-Hop \u0623\u0648 EDM\u060c \u0648\u0633\u062a\u0631\u0649 \u0627\u0644\u0641\u0631\u0642.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0627\u0633\u062d\u0628 Boost \u0625\u0644\u0649 \u0623\u0642\u0635\u0649 \u0627\u0644\u064a\u0645\u064a\u0646\u060c \u0648\u0627\u0633\u062a\u0645\u0639. \u0644\u0627 \u062a\u0641\u0648\u062a \u0647\u0630\u0647 \u0627\u0644\u062f\u0642\u064a\u0642\u062a\u064a\u0646. P.S. \u0625\u0630\u0627 \u062c\u0631\u0628\u062a\u0647\u0627 \u0639\u0644\u0649 \u0623\u063a\u0646\u064a\u0629 'Sicko Mode'\u060c \u0633\u062a\u0634\u0639\u0631 \u0648\u0643\u0623\u0646\u0643 \u0641\u064a \u062d\u0641\u0644\u0629 \u062d\u064a\u0629."
  ],
