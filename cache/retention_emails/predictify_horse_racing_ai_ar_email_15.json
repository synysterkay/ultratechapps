{
  "subject": "\u062f\u0642\u064a\u0642\u062a\u0627\u0646 \u0641\u0642\u0637 \u0643\u0627\u0646\u062a \u0643\u0644 \u0645\u0627 \u062a\u062d\u062a\u0627\u062c\u0647",
  "preview_text": "\u0643\u064a\u0641 \u062a\u0648\u0641\u0631 \u0633\u0627\u0639\u062a\u064a\u0646 \u0645\u0646 \u0627\u0644\u062a\u062d\u0644\u064a\u0644 \u0648\u062a\u0635\u0644 \u0644\u0644\u0646\u062a\u0627\u0626\u062c \u0627\u0644\u0623\u0642\u0648\u0649 \u0641\u064a \u062f\u0642\u064a\u0642\u062a\u064a\u0646\u061f \u0627\u0644\u0642\u0635\u0629 \u0647\u0646\u0627.",
  "body_paragraphs": [
    "\u0623\u062a\u0630\u0643\u0631 \u0623\u0648\u0644 \u0645\u0631\u0629 \u062c\u0644\u0633\u062a \u0641\u064a\u0647\u0627 \u0645\u0639 \u0643\u062a\u064a\u0628 \u0627\u0644\u0633\u0628\u0627\u0642\u0627\u062a \u0648\u062d\u0627\u0648\u0644\u062a \u062a\u062d\u0644\u064a\u0644 \u0643\u0644 \u062e\u064a\u0644\u061f \u0643\u0646\u062a \u0623\u0642\u0636\u064a 20 \u062f\u0642\u064a\u0642\u0629 \u0623\u062a\u0639\u0628 \u0639\u064a\u0646\u064a \u0628\u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0648\u0627\u0644\u062c\u062f\u0627\u0648\u0644\u060c \u0648\u0623\u062d\u064a\u0627\u0646\u064b\u0627 \u0623\u0637\u0644\u0639 \u0628\u0646\u062a\u064a\u062c\u0629 \u062e\u0627\u0637\u0626\u0629. \u0627\u0644\u064a\u0648\u0645\u060c \u062e\u0644\u064a\u0646\u0627 \u0646\u062e\u062a\u0635\u0631 \u0647\u0627\u0644\u0648\u0642\u062a.",
    "\u0641\u064a Predictify\u060c \u0635\u0645\u0645\u0646\u0627 \u0634\u064a\u0626\u064b\u0627 \u064a\u063a\u064a\u0631 \u0643\u0644 \u0634\u064a\u0621: \u0627\u0644\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0644\u064a \u0643\u0627\u0646 \u064a\u0623\u062e\u0630 \u0645\u0646\u0643 20 \u062f\u0642\u064a\u0642\u0629 \u0635\u0627\u0631 \u064a\u062a\u0645 \u0641\u064a \u062f\u0642\u064a\u0642\u062a\u064a\u0646 \u0641\u0642\u0637. \u0643\u0644 \u0645\u0627 \u062a\u062d\u062a\u0627\u062c\u0647 \u0647\u0648 \u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0633\u0628\u0627\u0642\u060c \u0648\u062e\u0644 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u064a\u0639\u0645\u0644 \u0627\u0644\u0628\u0627\u0642\u064a. \u064a\u062d\u0644\u0644 \u0622\u0644\u0627\u0641 \u0627\u0644\u0645\u062a\u063a\u064a\u0631\u0627\u062a \u2014 \u0623\u062f\u0627\u0621 \u0627\u0644\u062c\u0648\u0643\u064a\u060c \u0627\u0633\u062a\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u062f\u0631\u0628\u060c \u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0636\u0645\u0627\u0631\u060c \u0648\u062d\u062a\u0649 \u0627\u0644\u0637\u0642\u0633 \u2014 \u0648\u064a\u0639\u0637\u064a\u0643 \u0646\u062a\u064a\u062c\u0629 \u0645\u0628\u0627\u0634\u0631\u0629 \u0628\u062f\u0631\u062c\u0629 \u062b\u0642\u0629 \u0648\u0627\u0636\u062d\u0629.",
    "\u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0645\u0648 \u0628\u0633 \u062a\u062e\u062a\u0635\u0631 \u0627\u0644\u0648\u0642\u062a\u060c \u0644\u0643\u0646\u0647\u0627 \u062a\u0639\u0637\u064a\u0643 \u062b\u0642\u0629 \u0623\u0643\u0628\u0631 \u0641\u064a \u0627\u062e\u062a\u064a\u0627\u0631\u0627\u062a\u0643. \u0628\u062f\u0644 \u0645\u0627 \u062a\u062a\u0648\u0647 \u0641\u064a \u0627\u0644\u0623\u0631\u0642\u0627\u0645\u060c \u062a\u0631\u0643\u0632 \u0639\u0644\u0649 \u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0631\u0628\u062d\u0629. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u064a\u0648\u0645: \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u062e\u062a\u0631 \u0623\u064a \u0633\u0628\u0627\u0642 \u0645\u0646 \u0643\u0623\u0633 \u0627\u0644\u0639\u0627\u0644\u0645 \u0644\u0644\u062e\u064a\u0648\u0644 \u0623\u0648 \u0643\u064a\u0646\u062a\u0627\u0643\u064a \u062f\u064a\u0631\u0628\u064a\u060c \u0648\u0634\u0648\u0641 \u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0641\u064a \u062f\u0642\u064a\u0642\u062a\u064a\u0646.",
    "\u0627\u0641\u062a\u062d Predictify \u0627\u0644\u0622\u0646 \u0648\u0627\u062e\u062a\u0628\u0631 \u0627\u0644\u0641\u0631\u0642 \u0628\u0646\u0641\u0633\u0643. \u062d\u0631\u0631 \u0648\u0642\u062a\u0643 \u0644\u0644\u0641\u0648\u0632\u060c \u0645\u0634 \u0644\u0644\u062a\u062d\u0644\u064a\u0644. \u0645\u0644\u0627\u062d\u0638\u0629: \u0625\u0630\u0627 \u062c\u0631\u0628\u062a \u0627\u0644\u0645\u064a\u0632\u0629 \u0639\u0644\u0649 \u0633\u0628\u0627\u0642\u064a\u0646 \u0645\u062e\u062a\u0644\u0641\u064a\u0646\u060c \u0628\u062a\u0644\u0627\u062d\u0638 \u0623\u0646 \u0648\u0642\u062a \u0627\u0644\u062a\u062d\u0644\u064a\u0644 \u064a\u0642\u0644 \u0643\u0644 \u0645\u0631\u0629 \u2014 \u0644\u0623\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u064a\u062a\u0639\u0644\u0645 \u0645\u0646\u0643."
