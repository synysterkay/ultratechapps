{
  "subject": "500 \u043f\u0430\u0440 \u0443\u0436\u0435 \u0437\u0434\u0435\u0441\u044c. \u0422\u044b \u0441 \u043d\u0430\u043c\u0438?",
  "preview_text": "\u0412\u0437\u0433\u043b\u044f\u043d\u0438 \u043d\u0430 \u043b\u0435\u043d\u0442\u0443 \u2014 \u0442\u0432\u043e\u0438 \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u044f \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u044e\u0442 \u0434\u0440\u0443\u0433\u0438\u0445. \u0422\u044b \u0447\u0430\u0441\u0442\u044c \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0442 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435.",
  "body_paragraphs": [
    "\u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044c: \u043a\u0430\u0436\u0434\u0443\u044e \u043d\u043e\u0447\u044c 500 \u043f\u0430\u0440 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442 SoulPlan \u0438 \u0432\u044b\u0431\u0438\u0440\u0430\u044e\u0442 \u0432\u0435\u0447\u0435\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435 \u043f\u043e\u0445\u043e\u0436 \u043d\u0430 \u0432\u0447\u0435\u0440\u0430\u0448\u043d\u0438\u0439. \u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u2014 \u044d\u0442\u043e \u0442\u0438\u0445\u043e\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u043b\u044e\u0434\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0441\u0442\u0430\u043b\u0438 \u043e\u0442 \u0440\u0443\u0442\u0438\u043d\u044b \u0438 \u0440\u0435\u0448\u0438\u043b\u0438: \u0438\u0445 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u044e\u0442 \u0431\u043e\u043b\u044c\u0448\u0435\u0433\u043e. \u0422\u044b \u0443\u0436\u0435 \u0441\u0440\u0435\u0434\u0438 \u043d\u0438\u0445.",
    "\u041a\u043e\u0433\u0434\u0430 \u0442\u044b \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0435\u0448\u044c \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u0435 \u0437\u0430 30 \u0441\u0435\u043a\u0443\u043d\u0434 \u0447\u0435\u0440\u0435\u0437 'Tonight's Date', \u0442\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043f\u0430\u0441\u0430\u0435\u0448\u044c \u0432\u0435\u0447\u0435\u0440 \u2014 \u0442\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0448\u044c\u0441\u044f \u0447\u0430\u0441\u0442\u044c\u044e \u043f\u043b\u0435\u043c\u0435\u043d\u0438, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0434\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442: \u0438\u0441\u043a\u0440\u0430 \u043d\u0435 \u0433\u0430\u0441\u043d\u0435\u0442, \u0435\u0441\u043b\u0438 \u0437\u0430 \u043d\u0435\u0439 \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0442\u044c. \u0414\u0440\u0443\u0433\u0438\u0435 \u043f\u0430\u0440\u044b \u0432\u0438\u0434\u044f\u0442 \u0442\u0432\u043e\u0439 \u0432\u044b\u0431\u043e\u0440, \u0441\u0442\u0430\u0432\u044f\u0442 \u043b\u0430\u0439\u043a\u0438, \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0438\u0440\u0443\u044e\u0442. \u0422\u044b \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u0435\u0448\u044c \u0438\u0445, \u0434\u0430\u0436\u0435 \u043d\u0435 \u0437\u043d\u0430\u044f \u043e\u0431 \u044d\u0442\u043e\u043c.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u0432\u043a\u043b\u0430\u0434\u043a\u0443 'Community of couples' \u0438 \u0443\u0432\u0438\u0434\u044c: \u0442\u0432\u043e\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u2014 \u043d\u0435 \u043e\u0434\u0438\u043d\u043e\u0447\u043d\u0430\u044f. \u0417\u0434\u0435\u0441\u044c \u0434\u0435\u043b\u044f\u0442\u0441\u044f \u043c\u043e\u043c\u0435\u043d\u0442\u0430\u043c\u0438, \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0442 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430, \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0442, \u0447\u0442\u043e \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u043a\u0430 \u2014 \u044d\u0442\u043e \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430, \u0430 \u043d\u0435 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e\u0441\u0442\u044c. \u041a\u0430\u0436\u0434\u044b\u0439 \u043f\u043e\u0441\u0442 \u2014 \u043a\u0430\u043a \u0448\u0435\u043f\u043e\u0442: '\u041c\u044b \u0441\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u0441\u044f, \u0438 \u0442\u044b \u0441\u043c\u043e\u0436\u0435\u0448\u044c'.",
    "\u041d\u0430\u0436\u043c\u0438 \u043d\u0430 \u043b\u0435\u043d\u0442\u0443 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043e\u0441\u0442\u0430\u0432\u044c \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439 \u043f\u043e\u0434 \u0438\u0441\u0442\u043e\u0440\u0438\u0435\u0439 \u0434\u0440\u0443\u0433\u043e\u0439 \u043f\u0430\u0440\u044b. \u0422\u0432\u043e\u0439 \u0433\u043e\u043b\u043e\u0441 \u2014 \u0447\u0430\u0441\u0442\u044c \u044d\u0442\u043e\u0433\u043e. P.S. \u0417\u0430\u043c\u0435\u0442\u0438\u043b, \u0447\u0442\u043e \u0442\u0432\u043e\u044f Memory Timeline \u0443\u0436\u0435 \u043f\u043e\u043f\u043e\u043b\u043d\u0438\u043b\u0430\u0441\u044c? \u0427\u0435\u0440\u0435\u0437 \u043c\u0435\u0441\u044f\u0446 \u0442\u044b \u0431\u0443\u0434\u0435\u0448\u044c \u043b\u0438\u0441\u0442\u0430\u0442\u044c \u0435\u0451 \u0438 \u0443\u043b\u044b\u0431\u0430\u0442\u044c\u0441\u044f \u2014 \u043a\u0430\u043a \u0438 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 500."
  ],
