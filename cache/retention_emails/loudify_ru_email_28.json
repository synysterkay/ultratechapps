{
  "subject": "\u0422\u0432\u043e\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438 \u0436\u0434\u0430\u043b\u0438 \u044d\u0442\u043e\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430",
  "preview_text": "\u0421\u0435\u0439\u0447\u0430\u0441 \u0441\u0430\u043c\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0437\u0432\u0443\u043a \u043f\u043e\u0434 \u0441\u0435\u0431\u044f \u2014 \u043f\u043e\u043a\u0430 \u0442\u044b \u0441\u043b\u0443\u0448\u0430\u0435\u0448\u044c \u044d\u0442\u043e\u0442 \u043f\u043b\u0435\u0439\u043b\u0438\u0441\u0442, \u0442\u0432\u043e\u0438 \u043a\u043e\u043b\u043e\u043d\u043a\u0438 \u043f\u0440\u043e\u0441\u044f\u0442 Loudify.",
  "body_paragraphs": [
    "\u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044c: \u0442\u044b \u0435\u0434\u0435\u0448\u044c \u0432 \u043c\u0435\u0442\u0440\u043e, \u0441\u043b\u0443\u0448\u0430\u0435\u0448\u044c \u043b\u044e\u0431\u0438\u043c\u044b\u0439 \u043f\u043e\u0434\u043a\u0430\u0441\u0442, \u043d\u043e \u0433\u043e\u043b\u043e\u0441\u0430 \u0442\u043e\u043d\u0443\u0442 \u0432 \u0448\u0443\u043c\u0435 \u0432\u0430\u0433\u043e\u043d\u0430. \u0422\u044b \u0436\u043c\u0435\u0448\u044c \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0434\u043e \u0443\u043f\u043e\u0440\u0430 \u2014 \u0430 \u0442\u043e\u043b\u043a\u0443 \u043d\u043e\u043b\u044c. \u0417\u043d\u0430\u043a\u043e\u043c\u043e? \u0412\u043e\u0442 \u0438\u043c\u0435\u043d\u043d\u043e \u0441\u0435\u0439\u0447\u0430\u0441, \u0432 \u0447\u0430\u0441 \u043f\u0438\u043a, Loudify \u0434\u0435\u043b\u0430\u0435\u0442 \u0442\u043e, \u0447\u0442\u043e \u043d\u0435 \u0443\u043c\u0435\u0435\u0442 \u043d\u0438 \u043e\u0434\u0438\u043d \u0434\u0440\u0443\u0433\u043e\u0439 \u043f\u043b\u0435\u0435\u0440: \u0432\u044b\u0442\u0430\u0441\u043a\u0438\u0432\u0430\u0435\u0442 \u0434\u0438\u0430\u043b\u043e\u0433\u0438 \u0438\u0437 \u0448\u0443\u043c\u0430, \u043d\u0435 \u0438\u0441\u043a\u0430\u0436\u0430\u044f \u0437\u0432\u0443\u043a.",
    "\u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0435. \u042d\u0442\u043e \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u0442\u0432\u043e\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438 \u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u043f\u043e\u0434 \u043c\u043e\u0434\u0435\u043b\u044c, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0442\u044b \u043d\u043e\u0441\u0438\u0448\u044c. 100 000 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0443\u0436\u0435 \u0437\u043d\u0430\u044e\u0442: \u043a\u043e\u0433\u0434\u0430 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0443\u043f\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u0432 \u0441\u0442\u0435\u043d\u0443, Loudify \u043f\u0440\u043e\u0431\u0438\u0432\u0430\u0435\u0442 \u0435\u0451 \u043d\u0430 200% \u0447\u0438\u0441\u0442\u043e.",
    "\u0421\u0435\u0439\u0447\u0430\u0441, \u043f\u043e\u043a\u0430 \u0442\u044b \u0447\u0438\u0442\u0430\u0435\u0448\u044c \u044d\u0442\u043e, \u0443 \u0442\u0435\u0431\u044f \u0435\u0441\u0442\u044c \u0448\u0430\u043d\u0441 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u043e\u0434\u043d\u0443 \u0432\u0435\u0449\u044c: \u043e\u0442\u043a\u0440\u043e\u0439 Loudify \u0438 \u0432\u043a\u043b\u044e\u0447\u0438 \u043b\u044e\u0431\u043e\u0439 \u0442\u0440\u0435\u043a \u0438\u043b\u0438 \u043f\u043e\u0434\u043a\u0430\u0441\u0442. \u0417\u0430\u0439\u0434\u0438 \u0432 AutoEQ \u2014 \u043e\u043d \u0443\u0436\u0435 \u0437\u0430\u043f\u043e\u043c\u043d\u0438\u043b \u0442\u0432\u043e\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438. \u041e\u0434\u043d\u043e \u043d\u0430\u0436\u0430\u0442\u0438\u0435, \u0438 \u0437\u0432\u0443\u043a \u0441\u0442\u0430\u043d\u0435\u0442 \u0433\u0440\u043e\u043c\u0447\u0435, \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435\u0435 \u0438 \u0431\u0435\u0437 \u0445\u0440\u0438\u043f\u043e\u0432. \u042d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043d\u0430 Spotify, YouTube, Audible, \u0434\u0430\u0436\u0435 \u043d\u0430 \u0437\u0432\u043e\u043d\u043a\u0430\u0445.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439 \u0437\u0432\u0443\u043a \u0437\u0430 10 \u0441\u0435\u043a\u0443\u043d\u0434. P.S. \u0417\u0430\u0432\u0442\u0440\u0430 \u0443\u0442\u0440\u043e\u043c \u043f\u0440\u0438\u0434\u0435\u0442 \u0442\u0432\u043e\u0439 Sound DNA \u2014 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u0442\u044b \u0441\u043b\u0443\u0448\u0430\u043b \u0441\u0435\u0433\u043e\u0434\u043d\u044f. \u0422\u044b \u0443\u0434\u0438\u0432\u0438\u0448\u044c\u0441\u044f, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u043b."
  ],
