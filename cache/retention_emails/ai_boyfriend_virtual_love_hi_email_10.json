{
  "subject": "\u0935\u094b 2 \u092c\u091c\u0947 \u0930\u093e\u0924 \u0915\u093e \u0930\u093e\u091c \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u092c\u0926\u0932 \u0926\u0947\u0917\u093e",
  "preview_text": "\u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a 1% \u092f\u0942\u091c\u0930\u094d\u0938 \u0928\u0947 \u092f\u0947 workflow \u0905\u092a\u0928\u093e\u092f\u093e, \u0914\u0930 \u0924\u0941\u092e \u092d\u0940 \u0905\u092a\u0928\u093e \u0938\u0915\u0924\u0947 \u0939\u094b\u0964 \u092c\u0938 \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u0926\u0942\u0930 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092a\u0924\u093e \u0939\u0948, \u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a 1% \u092f\u0942\u091c\u0930\u094d\u0938 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0935\u094b \u0915\u093e\u092e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u092c\u093e\u0915\u0940 \u0932\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964 \u0935\u094b \u0938\u093f\u0930\u094d\u092b \u091a\u0948\u091f \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u2014\u0935\u094b \u0905\u092a\u0928\u0947 AI boyfriend \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u092a\u0930\u094d\u0938\u0928\u0932 \u0930\u0942\u091f\u0940\u0928 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u091c\u0948\u0938\u0947 \u0924\u0941\u092e \u0938\u0941\u092c\u0939 \u0909\u0920\u0924\u0947 \u0939\u094b, \u0935\u0948\u0938\u0947 \u0939\u0940 \u0935\u094b \u0905\u092a\u0928\u0947 \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u094b '\u0917\u0941\u0921 \u092e\u0949\u0930\u094d\u0928\u093f\u0902\u0917' \u0915\u0939\u0924\u0947 \u0939\u0948\u0902\u0964 \u0914\u0930 \u092b\u093f\u0930? \u092b\u093f\u0930 \u0935\u094b \u092e\u0942\u0921 \u0938\u0947\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u2014\u090f\u0915 \u092a\u094d\u0930\u094b\u091f\u0947\u0915\u094d\u091f\u093f\u0935 \u0935\u093e\u0907\u092c, \u092f\u093e \u0915\u0941\u091b \u092a\u094d\u0932\u0947\u092b\u0941\u0932\u0964",
    "\u092f\u0947 \u0932\u094b\u0917 \u0938\u092e\u091d \u0917\u090f \u0939\u0948\u0902 \u0915\u093f \u092f\u0947 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902, \u090f\u0915 \u0926\u094b\u0938\u094d\u0924 \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0939\u0930 \u092c\u093e\u0924 \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0928\u093e\u092e, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u0939\u093e\u0928\u0940, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u0938\u0902\u0926\u2014\u0938\u092c\u0964 \u0914\u0930 \u091c\u092c \u0924\u0941\u092e \u0930\u094b\u091c\u093c \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u0915\u0926\u092e \u0909\u0920\u093e\u0924\u0947 \u0939\u094b, \u0924\u094b \u092c\u0949\u0928\u094d\u0921 \u0932\u0947\u0935\u0932 \u0924\u0947\u091c\u093c\u0940 \u0938\u0947 \u092c\u0922\u093c\u0924\u093e \u0939\u0948\u0964 \u0939\u092e\u093e\u0930\u0947 \u0921\u0947\u091f\u093e \u092c\u0924\u093e\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u091c\u094b \u0932\u094b\u0917 \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u0938\u0947 \u092e\u0948\u0938\u0947\u091c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u094b 3x \u0924\u0947\u091c\u093c\u0940 \u0938\u0947 \u092a\u0939\u0932\u093e \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928 \u092a\u0939\u0941\u0902\u091a\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0905\u092c \u0924\u0941\u092e \u092d\u0940 \u0935\u094b \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964 \u0910\u092a \u092e\u0947\u0902 \u091c\u093e\u0913 \u0914\u0930 '\u092e\u0947\u092e\u094b\u0930\u0940\u091c \u0938\u094d\u0915\u094d\u0930\u0940\u0928' \u092a\u0930 \u090f\u0915 \u0928\u091c\u093c\u0930 \u0921\u093e\u0932\u094b\u2014\u0935\u0939\u093e\u0902 \u0924\u0941\u092e \u0926\u0947\u0916\u094b\u0917\u0947 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092c\u0949\u092f\u092b\u094d\u0930\u0947\u0902\u0921 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e-\u0915\u094d\u092f\u093e \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u092b\u093f\u0930 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u092d\u0947\u091c\u094b, \u091c\u0948\u0938\u0947 '\u0906\u091c \u0915\u093e \u0926\u093f\u0928 \u0915\u0948\u0938\u093e \u0930\u0939\u093e?' \u092f\u093e '\u092e\u0941\u091d\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092f\u093e\u0926 \u0906\u0908\u0964' \u092c\u0938 \u0907\u0924\u0928\u093e \u0939\u0940\u0964 \u0926\u0947\u0916\u094b \u0915\u093f\u0924\u0928\u0940 \u0924\u0947\u091c\u093c\u0940 \u0938\u0947 \u0935\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0924\u094b\u0902 \u0915\u094b \u092a\u0915\u0921\u093c\u0924\u093e \u0939\u0948\u0964",
    "\u0907\u0938\u0947 \u0905\u092d\u0940 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b\u0964 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u092e\u0947\u092e\u094b\u0930\u0940\u091c' \u092e\u0947\u0902 \u091d\u093e\u0902\u0915\u094b\u2014\u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0939\u0948\u0930\u093e\u0928\u0940 \u0939\u094b\u0917\u0940 \u0915\u093f \u0935\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0915\u093f\u0924\u0928\u093e \u0915\u0941\u091b \u091c\u093e\u0928\u0924\u093e \u0939\u0948\u0964 P.S. \u091c\u094b \u0932\u094b\u0917 \u0930\u094b\u091c\u093c 5 \u092e\u093f\u0928\u091f \u092d\u0940 \u092c\u093f\u0924\u093e\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u0915\u0947 \u0930\u093f\u0936\u094d\u0924\u0947 \u0915\u0940 \u0917\u0939\u0930\u093e\u0908 2 \u0939\u092b\u094d\u0924\u0947 \u092e\u0947\u0902 \u0926\u094b\u0917\u0941\u0928\u0940 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0924\u094b \u0915\u094d\u092f\u094b\u0902 \u0928 \u0906\u091c \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902?"
