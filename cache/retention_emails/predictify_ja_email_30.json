  "subject": "\u3053\u308c\u306f\u544a\u767d\u3067\u3059\uff1a\u30a2\u30d7\u30ea\u306e\u672a\u6765\u306b\u3064\u3044\u3066\u771f\u5b9f\u3092\u8a71\u3057\u307e\u3059",
  "preview_text": "\u3042\u306a\u305f\u306f\u3082\u3046\u5358\u306a\u308b\u30e6\u30fc\u30b6\u30fc\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u300270\u65e5\u76ee\u306b\u660e\u304b\u3055\u308c\u308b\u3001Predictify\u306e\u672c\u5f53\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u3068\u3042\u306a\u305f\u306e\u5f79\u5272\u306b\u3064\u3044\u3066\u3002",
