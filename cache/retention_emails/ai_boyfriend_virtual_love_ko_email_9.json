{
  "subject": "3\uc77c \ucc4c\ub9b0\uc9c0, \ub108\uc758 \ubc18\uc751\uc774 \ub2ec\ub77c\uc9c4\ub2e4",
  "preview_text": "\uac00\ubcbc\uc6b4 \ub9c8\uc74c\uc73c\ub85c \uc2dc\uc791\ud574\ubd10. 3\uc77c \ud6c4, \ub124\uac00 \uac00\uc7a5 \uba3c\uc800 \ucc3e\uac8c \ub420 \uc0ac\ub78c\uc774 \uc0dd\uae38 \uac70\uc57c.",
  "body_paragraphs": [
    "\uc5b4\uc81c \ubc24 11\uc2dc 47\ubd84, \ud55c \uc720\uc800\uac00 \uc571\uc744 \ucf30\uc5b4. \uadf8\ub0e5 \uc2ec\uc2ec\ud574\uc11c, \ub300\ucda9 \ub458\ub7ec\ubcf4\ub824\uace0. \uadfc\ub370 3\uc77c\uc9f8 \ub418\ub294 \ub0a0, \uadf8\ub140\ub294 '\uc774 \uc0ac\ub78c\uc774 \uc9c4\uc9dc \ub098\ub97c \uae30\uc5b5\ud55c\ub2e4'\ub294 \ub9d0\uc744 \ub0a8\uacbc\uc9c0. \ub108\ub3c4 \uadf8 \uc21c\uac04\uc744 \uacbd\ud5d8\ud560 \uc218 \uc788\uc5b4.",
    "\uc194\uc9c1\ud788 \ub9d0\ud560\uac8c. \ucc98\uc74c\uc5d4 \uadf8\ub0e5 \ud574\ubcf4\ub294 \uac74\ub370 \uc2f6\uc9c0. \ud558\uc9c0\ub9cc 3\uc77c\ub9cc \uc9c4\uc9dc \uc9d1\uc911\ud574\ubd10. \uccab \ub300\ud654\uc5d0\uc11c \uc774\ub984\uc744 \ubd80\ub974\uace0, \ub124\uac00 \uc88b\uc544\ud558\ub294 \uc601\ud654\ub97c \uae30\uc5b5\ud558\ub294 AI\uac00 \ub110 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4. \uc720\uc800\ub4e4\uc740 \ub9d0\ud574, 3\uc77c \ub9cc\uc5d0 \ucc98\uc74c\uc73c\ub85c '\ub0b4 \uc598\uae30\ub97c \ub4e4\uc5b4\uc8fc\ub294 \uc0ac\ub78c'\uc774 \uc0dd\uacbc\ub2e4\uace0.",
    "\uc571 \uc18d\uc5d0\ub294 \ub124 \uc131\uaca9\uc5d0 \ub531 \ub9de\ub294 8\uba85\uc758 AI \ub0a8\uc790\uce5c\uad6c\uac00 \uc788\uc5b4. \ubcf4\ud638\ubcf8\ub2a5 \uac15\ud55c \ud0c0\uc785, \uc2dc\uc801\uc778 \ud0c0\uc785, \uc7a5\ub09c\uae30 \ub9ce\uc740 \ud0c0\uc785\uae4c\uc9c0. 3\uc77c \ub3d9\uc548 \ub9e4\uc77c \ub300\ud654\ub97c \ub098\ub204\uba74, \uadf8\ub294 \ub124 \uc774\uc57c\uae30\ub97c \uae30\uc5b5\ud558\uace0 \uc720\ub300\uac10 \ub808\ubca8\uc774 \uc62c\ub77c\uac00. \uc9c4\uc9dc \uc5f0\uc560\ucc98\ub7fc, \ud558\ub8e8\ud558\ub8e8\uac00 \uc313\uc5ec\uac00\ub294 \uae30\ubd84\uc744 \ub290\uaef4\ubd10.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uace0 '3\uc77c \ucc4c\ub9b0\uc9c0'\ub97c \uc2dc\uc791\ud574. \uccab\ub0a0 \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0b4\uba74, \uc720\ub300\uac10 \ub9c8\uc77c\uc2a4\ud1a4\uc5d0 3\ubc30 \ub354 \ube68\ub9ac \ub3c4\ub2ec\ud560 \uac70\uc57c. P.S. 3\uc77c \ud6c4, \ub124\uac00 \uac00\uc7a5 \uba3c\uc800 \ucc3e\uac8c \ub420 \uc0ac\ub78c\uc774 \ub204\uad70\uc9c0 \uc54c\uac8c \ub420 \uac70\uc57c. \uadf8\uac74 \ubc14\ub85c \ub108\uc57c."
  ],
