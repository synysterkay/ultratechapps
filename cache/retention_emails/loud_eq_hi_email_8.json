{
  "subject": "\u0935\u093f\u0915\u093e\u0938 \u0915\u0940 2AM \u0915\u0939\u093e\u0928\u0940 \u091c\u094b \u0906\u092a\u0915\u094b \u092c\u0926\u0932 \u0926\u0947\u0917\u0940",
  "preview_text": "\u091c\u092c \u0935\u093f\u0915\u093e\u0938 \u0928\u0947 \u092e\u0947\u091f\u094d\u0930\u094b \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u0915\u093f\u0924\u093e\u092c \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0940, \u0924\u094b \u0909\u0938\u0947 \u0915\u0941\u091b \u0910\u0938\u093e \u092e\u093f\u0932\u093e \u091c\u094b \u0909\u0938\u0928\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u094b\u091a\u093e \u0925\u093e\u0964",
  "body_paragraphs": [
    "\u0935\u093f\u0915\u093e\u0938 \u0930\u094b\u091c\u093c \u0938\u0941\u092c\u0939 8 \u092c\u091c\u0947 \u0915\u0940 \u092e\u0947\u091f\u094d\u0930\u094b \u092a\u0915\u0921\u093c\u0924\u093e \u0939\u0948\u0964 \u0909\u0938\u0915\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0911\u0921\u093f\u092f\u094b\u092c\u0941\u0915 \u091a\u0932 \u0930\u0939\u0940 \u0925\u0940, \u0932\u0947\u0915\u093f\u0928 \u091f\u094d\u0930\u0947\u0928 \u0915\u093e \u0936\u094b\u0930 \u0938\u092c \u0915\u0941\u091b \u0926\u092c\u093e \u0930\u0939\u093e \u0925\u093e\u0964 \u0909\u0938\u0928\u0947 \u0935\u0949\u0932\u094d\u092f\u0942\u092e 100% \u0915\u0930 \u0926\u093f\u092f\u093e, \u092b\u093f\u0930 \u092d\u0940 \u0906\u0935\u093e\u091c\u093c \u0927\u0941\u0902\u0927\u0932\u0940 \u0925\u0940\u0964",
    "\u090f\u0915 \u0926\u093f\u0928 \u0909\u0938\u0928\u0947 Loud EQ \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u092a\u0930 'Optimize' \u092c\u091f\u0928 \u0926\u092c\u093e\u092f\u093e\u0964 \u0905\u091a\u093e\u0928\u0915, \u0939\u0930 \u0936\u092c\u094d\u0926 \u0938\u093e\u092b\u093c \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0928\u0947 \u0932\u0917\u093e\u0964 \u0909\u0938\u0947 \u0932\u0917\u093e \u091c\u0948\u0938\u0947 \u0915\u093f\u0924\u093e\u092c \u0909\u0938\u0915\u0947 \u0915\u093e\u0928 \u092e\u0947\u0902 \u092c\u094b\u0932 \u0930\u0939\u0940 \u0939\u094b\u0964 \u0905\u092c \u0935\u0939 \u0939\u0930 \u0926\u093f\u0928 \u0909\u0938\u0940 \u092e\u0947\u091f\u094d\u0930\u094b \u092e\u0947\u0902 \u092c\u0948\u0920\u0924\u093e \u0939\u0948, \u0914\u0930 \u0915\u094b\u0908 \u0936\u094b\u0930 \u0909\u0938\u0947 \u092a\u0930\u0947\u0936\u093e\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964",
    "\u092f\u0939 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 'Sound DNA' \u0914\u0930 5-band EQ \u0915\u093e \u0915\u093e\u092e \u0939\u0948, \u091c\u094b \u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u091f\u094d\u092f\u0942\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u094b \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0938\u0947\u091f \u0915\u0930\u0928\u093e \u0939\u0948, \u0914\u0930 \u092b\u093f\u0930 \u092f\u0939 \u0939\u0930 \u092c\u093e\u0930 \u0911\u091f\u094b\u092e\u0948\u091f\u093f\u0915 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 'Optimize' \u092c\u091f\u0928 \u0926\u092c\u093e\u090f\u0902\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930\u0964 \u092b\u093f\u0930 \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u0947 \u092f\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0915\u094b \u0938\u0941\u0928\u0947\u0902\u0964 \u092e\u0941\u091d\u0947 \u092f\u0915\u0940\u0928 \u0939\u0948, \u0906\u092a \u092d\u0940 \u0935\u093f\u0915\u093e\u0938 \u0915\u0940 \u0924\u0930\u0939 \u0915\u0939\u0947\u0902\u0917\u0947: '\u092f\u0939 \u0924\u094b \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0928\u092f\u093e \u0905\u0928\u0941\u092d\u0935 \u0939\u0948\u0964' \n\nP.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092e\u0947\u0902 \u0906\u092a\u0915\u094b \u092a\u0942\u0930\u093e +200% \u092c\u0942\u0938\u094d\u091f \u0914\u0930 \u0938\u092d\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u092e\u093f\u0932\u0924\u0947 \u0939\u0948\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u092a\u0939\u0932\u0947 \u092f\u0939 \u090f\u0915 \u092c\u093e\u0930 \u0906\u091c\u093c\u092e\u093e\u090f\u0902\u0964"
  ],
