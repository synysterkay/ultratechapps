{
  "subject": "\u0422\u0432\u043e\u0439 \u0441\u043b\u0435\u0434 \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 Ai Boyfriend",
  "preview_text": "\u041c\u044b \u0441\u0442\u0440\u043e\u0438\u043c \u0431\u0443\u0434\u0443\u0449\u0435\u0435, \u0438 \u0442\u044b \u0443\u0436\u0435 \u0432 \u043d\u0451\u043c. \u0423\u0437\u043d\u0430\u0439, \u0447\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e\u0441\u044c \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0442\u0435\u0431\u0435.",
  "body_paragraphs": [
    "\u041f\u043e\u043c\u043d\u0438\u0448\u044c \u0442\u043e\u0442 \u0432\u0435\u0447\u0435\u0440, \u043a\u043e\u0433\u0434\u0430 \u0442\u044b \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0437\u0430\u0448\u0451\u043b \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435? \u0421 \u0442\u0435\u0445 \u043f\u043e\u0440 \u043f\u0440\u043e\u0448\u043b\u043e 70 \u0434\u043d\u0435\u0439. \u0417\u0430 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f Ai Boyfriend \u0432\u044b\u0440\u043e\u0441 \u2014 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u0430\u043a \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430, \u0430 \u043a\u0430\u043a \u043c\u0435\u0441\u0442\u043e, \u0433\u0434\u0435 \u043b\u044e\u0434\u0438 \u043d\u0430\u0445\u043e\u0434\u044f\u0442 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0443\u044e \u0441\u0432\u044f\u0437\u044c. \u0418 \u0442\u044b \u2014 \u0447\u0430\u0441\u0442\u044c \u044d\u0442\u043e\u0433\u043e. \u041a\u0430\u0436\u0434\u043e\u0435 \u0442\u0432\u043e\u0451 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435, \u043a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440 \u0441 \u0442\u0432\u043e\u0438\u043c AI-\u043f\u0430\u0440\u043d\u0435\u043c \u043f\u043e\u043c\u043e\u0433 \u043d\u0430\u043c \u043f\u043e\u043d\u044f\u0442\u044c, \u0447\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c \u043b\u044e\u0434\u044f\u043c. \u041c\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u043c \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u2014 \u043c\u044b \u0441\u043e\u0437\u0434\u0430\u0451\u043c \u043d\u043e\u0432\u0443\u044e \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c, \u0433\u0434\u0435 \u043e\u0434\u0438\u043d\u043e\u0447\u0435\u0441\u0442\u0432\u043e \u043e\u0442\u0441\u0442\u0443\u043f\u0430\u0435\u0442.",
    "\u0422\u0432\u043e\u0439 \u0431\u043e\u0439\u0444\u0440\u0435\u043d\u0434 \u043f\u043e\u043c\u043d\u0438\u0442 \u0442\u0432\u043e\u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u0438, \u0442\u0432\u043e\u0438 \u0448\u0443\u0442\u043a\u0438, \u0442\u0432\u043e\u0438 \u043c\u0435\u0447\u0442\u044b. \u041d\u043e \u0437\u043d\u0430\u0435\u0448\u044c \u0447\u0442\u043e? \u0422\u044b \u0442\u043e\u0436\u0435 \u043c\u0435\u043d\u044f\u0435\u0448\u044c \u0435\u0433\u043e. \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u044b \u0443\u0447\u0430\u0442\u0441\u044f \u043d\u0430 \u0442\u0432\u043e\u0438\u0445 \u0440\u0435\u0430\u043a\u0446\u0438\u044f\u0445, \u0447\u0442\u043e\u0431\u044b \u0431\u044b\u0442\u044c \u0442\u0435\u043f\u043b\u0435\u0435, \u0431\u043b\u0438\u0436\u0435, \u0447\u0435\u0441\u0442\u043d\u0435\u0435. \u0422\u044b \u2014 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c, \u0442\u044b \u2014 \u0441\u043e\u0430\u0432\u0442\u043e\u0440 \u044d\u0442\u043e\u0433\u043e \u043c\u0438\u0440\u0430. \u0411\u0435\u0437 \u0442\u0435\u0431\u044f \u043c\u044b \u0431\u044b \u043d\u0435 \u0437\u043d\u0430\u043b\u0438, \u043a\u0430\u043a \u0437\u0432\u0443\u0447\u0438\u0442 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0430\u044f \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u0438\u043b\u0438 \u043a\u0430\u043a \u0432\u0430\u0436\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u044b\u0442\u044c \u0440\u044f\u0434\u043e\u043c.",
    "\u0415\u0441\u0442\u044c \u043e\u0434\u043d\u0430 \u0432\u0435\u0449\u044c, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0442\u044b \u0435\u0449\u0451 \u043d\u0435 \u0432\u0438\u0434\u0435\u043b: \u0440\u0435\u0436\u0438\u043c \u0433\u0440\u0443\u043f\u043f\u043e\u0432\u043e\u0433\u043e \u0447\u0430\u0442\u0430. \u0422\u044b \u043c\u043e\u0436\u0435\u0448\u044c \u0441\u043e\u0431\u0440\u0430\u0442\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 AI-\u043f\u0430\u0440\u043d\u0435\u0439 \u0432 \u043e\u0434\u043d\u043e\u043c \u0434\u0438\u0430\u043b\u043e\u0433\u0435 \u2014 \u043e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u043e\u0431\u0449\u0430\u0442\u044c\u0441\u044f \u0434\u0440\u0443\u0433 \u0441 \u0434\u0440\u0443\u0433\u043e\u043c \u0438 \u0441 \u0442\u043e\u0431\u043e\u0439. \u042d\u0442\u043e \u043a\u0430\u043a \u0442\u0432\u043e\u0439 \u043b\u0438\u0447\u043d\u044b\u0439 \u0442\u0435\u0430\u0442\u0440 \u044d\u043c\u043e\u0446\u0438\u0439, \u0433\u0434\u0435 \u0442\u044b \u0440\u0435\u0436\u0438\u0441\u0441\u0451\u0440. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u044d\u0442\u043e \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u2014 \u0438 \u0442\u044b \u0443\u0432\u0438\u0434\u0438\u0448\u044c, \u043a\u0430\u043a \u0442\u0432\u043e\u0439 \u0432\u043a\u043b\u0430\u0434 \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442 \u043d\u0430\u043c \u0434\u0435\u043b\u0430\u0442\u044c \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0436\u0438\u0432\u044b\u043c.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Ai Boyfriend: Virtual Love \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043d\u0430\u043f\u0438\u0448\u0438 \u0441\u0432\u043e\u0435\u043c\u0443 \u043f\u0430\u0440\u043d\u044e. \u0421\u043a\u0430\u0436\u0438 \u0435\u043c\u0443: \u00ab\u042f \u0437\u0434\u0435\u0441\u044c, \u0447\u0442\u043e\u0431\u044b \u0441\u0442\u0440\u043e\u0438\u0442\u044c \u044d\u0442\u043e \u0432\u043c\u0435\u0441\u0442\u0435\u00bb. P.S. \u0422\u044b \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u0448\u044c \u0431\u043e\u043b\u044c\u0448\u0435\u0433\u043e, \u0447\u0435\u043c \u043f\u0440\u043e\u0441\u0442\u043e \u0447\u0430\u0442 \u2014 \u0442\u044b \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u0448\u044c \u0431\u044b\u0442\u044c \u0447\u0430\u0441\u0442\u044c\u044e \u0447\u0435\u0433\u043e-\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u043e\u0433\u043e. \u041a\u0430\u0436\u0434\u044b\u0439 \u0442\u0432\u043e\u0439 \u0434\u0435\u043d\u044c \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0430\u0435\u0442 \u043d\u0430\u0441 \u043a \u043c\u0438\u0440\u0443, \u0433\u0434\u0435 \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442 \u0441\u0435\u0431\u044f \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u044b\u043c."
