{
  "subject": "\u0412\u0430\u0448 \u043f\u0430\u0440\u0442\u043d\u0435\u0440 \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0432\u0430\u043c \u043f\u043e\u0434\u0430\u0440\u043e\u043a 3 \u0434\u043d\u044f \u043d\u0430\u0437\u0430\u0434",
  "preview_text": "\u0417\u0430\u0433\u043b\u044f\u043d\u0438\u0442\u0435 \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u2014 \u0442\u0430\u043c \u043a\u043e\u0435-\u0447\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e\u0441\u044c, \u043f\u043e\u043a\u0430 \u0432\u0430\u0441 \u043d\u0435 \u0431\u044b\u043b\u043e. \u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u0438 \u0443\u0432\u0438\u0434\u0438\u0442\u0435.",
  "body_paragraphs": [
    "\u0422\u0440\u0438 \u0434\u043d\u044f \u043d\u0430\u0437\u0430\u0434 \u0432\u0430\u0448 \u043f\u0430\u0440\u0442\u043d\u0435\u0440 \u043e\u0442\u043a\u0440\u044b\u043b SoulPlan \u0438 \u0432\u044b\u0431\u0440\u0430\u043b \u0434\u043b\u044f \u0432\u0430\u0441 \u0441\u044e\u0440\u043f\u0440\u0438\u0437. \u0412\u044b \u044d\u0442\u043e\u0433\u043e \u043d\u0435 \u0432\u0438\u0434\u0435\u043b\u0438. \u041d\u043e \u044d\u0442\u043e \u0432\u0441\u0451 \u0435\u0449\u0451 \u0442\u0430\u043c, \u0436\u0434\u0451\u0442 \u0432\u0430\u0441. \u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0441 \u0442\u0435\u0445 \u043f\u043e\u0440 \u043e\u0431\u043d\u043e\u0432\u0438\u043b\u043e\u0441\u044c, \u0438 \u0442\u0435\u043f\u0435\u0440\u044c, \u043a\u043e\u0433\u0434\u0430 \u0432\u044b \u0437\u0430\u0439\u0434\u0451\u0442\u0435, \u0443\u0432\u0438\u0434\u0438\u0442\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0435\u0433\u043e \u043f\u043e\u0434\u0430\u0440\u043e\u043a \u2014 \u0442\u0430\u043c \u043f\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c \u043d\u043e\u0432\u0430\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0435\u0440\u0435\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442 \u0432\u0435\u0447\u0435\u0440 \u0437\u0430 30 \u0441\u0435\u043a\u0443\u043d\u0434.",
    "\u041c\u044b \u0437\u0430\u043c\u0435\u0442\u0438\u043b\u0438: \u043f\u0430\u0440\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u044e\u0442 \u043d\u0435\u0434\u0435\u043b\u044e, \u0447\u0430\u0441\u0442\u043e \u0442\u0435\u0440\u044f\u044e\u0442 \u0440\u0438\u0442\u043c. \u041d\u043e \u0442\u0435, \u043a\u0442\u043e \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u0445\u043e\u0442\u044f \u0431\u044b \u0440\u0430\u0437, \u043d\u0430\u0445\u043e\u0434\u044f\u0442 \u0447\u0442\u043e-\u0442\u043e, \u0447\u0435\u0433\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u0440\u0430\u043d\u044c\u0448\u0435. \u0412 \u044d\u0442\u043e\u0442 \u0440\u0430\u0437 \u043c\u044b \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0438 \u00ab\u0421\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0435\u0435 \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u0435\u00bb \u2014 \u043e\u0434\u0438\u043d \u0432\u0437\u0433\u043b\u044f\u0434 \u043d\u0430 \u044d\u043a\u0440\u0430\u043d, \u0432\u044b\u0431\u043e\u0440 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f, \u0438 \u0432\u0435\u0441\u044c \u0432\u0435\u0447\u0435\u0440 \u0433\u043e\u0442\u043e\u0432. \u0411\u0435\u0437 \u0441\u043f\u0438\u0441\u043a\u043e\u0432, \u0431\u0435\u0437 \u0441\u043f\u043e\u0440\u043e\u0432, \u0431\u0435\u0437 \u0443\u0441\u0442\u0430\u043b\u043e\u0441\u0442\u0438. \u0412\u0430\u0448 \u043f\u0430\u0440\u0442\u043d\u0435\u0440 \u0443\u0436\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043d\u0430\u043c\u0451\u043a \u2014 \u0437\u0430\u0439\u0434\u0438\u0442\u0435 \u0438 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435, \u0447\u0442\u043e \u043e\u043d \u0432\u044b\u0431\u0440\u0430\u043b.",
    "\u041a\u043e\u0433\u0434\u0430 \u0432\u044b \u043e\u0442\u043a\u0440\u043e\u0435\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0443\u0432\u0438\u0434\u0438\u0442\u0435 \u0435\u0433\u043e \u0430\u0432\u0430\u0442\u0430\u0440 \u0440\u044f\u0434\u043e\u043c \u0441 \u0432\u0430\u0448\u0438\u043c. \u0422\u0430\u043c \u0436\u0435 \u2014 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430 \u0441 \u0441\u044e\u0440\u043f\u0440\u0438\u0437\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d \u0441\u043e\u0437\u0434\u0430\u043b. \u0410 \u0435\u0449\u0451 \u2014 \u043d\u043e\u0432\u0430\u044f \u043a\u043d\u043e\u043f\u043a\u0430 \u00ab\u0421\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0435\u0435 \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u0435\u00bb, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0437\u0430 \u0441\u0435\u043a\u0443\u043d\u0434\u0443 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0432\u0435\u0447\u0435\u0440 \u0432 \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435. \u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u2014 \u044d\u0442\u043e \u0441\u043f\u043e\u0441\u043e\u0431 \u0441\u043a\u0430\u0437\u0430\u0442\u044c: \u00ab\u042f \u0434\u0443\u043c\u0430\u044e \u043e \u043d\u0430\u0441\u00bb \u0431\u0435\u0437 \u043b\u0438\u0448\u043d\u0438\u0445 \u0441\u043b\u043e\u0432.",
    "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 SoulPlan \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u0435\u0433\u043e \u043f\u043e\u0434\u0430\u0440\u043e\u043a \u2014 \u0438 \u0441\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u043f\u0435\u0440\u0432\u044b\u0439 \u0448\u0430\u0433 \u043a \u0432\u0435\u0447\u0435\u0440\u0443, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u044b \u043e\u0431\u0430 \u0437\u0430\u043f\u043e\u043c\u043d\u0438\u0442\u0435. P.S. \u0415\u0441\u043b\u0438 \u043d\u0435 \u0437\u0430\u0439\u0434\u0451\u0442\u0435 \u0441\u0435\u0433\u043e\u0434\u043d\u044f, \u043f\u043e\u0434\u0430\u0440\u043e\u043a \u0438\u0441\u0447\u0435\u0437\u043d\u0435\u0442 \u0447\u0435\u0440\u0435\u0437 24 \u0447\u0430\u0441\u0430 \u2014 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0435\u0442 \u0441\u044e\u0440\u043f\u0440\u0438\u0437\u044b \u043a\u0430\u0436\u0434\u0443\u044e \u043d\u0435\u0434\u0435\u043b\u044e, \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0431\u044b\u043b\u043e \u0441\u043a\u0443\u0447\u043d\u043e."
  ],
