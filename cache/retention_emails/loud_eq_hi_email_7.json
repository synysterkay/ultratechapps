{
  "subject": "\u0935\u094b 2 \u092c\u091c\u0947 \u0930\u093e\u0924 \u0915\u093e \u0930\u093e\u091c \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u091c\u094b \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0926\u094b\u0917\u0941\u0928\u093e \u0915\u0930 \u0938\u0915\u0924\u0940 \u0939\u0948\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947\u0964",
  "body_paragraphs": [
    "\u0926\u094b \u0939\u092b\u093c\u094d\u0924\u0947 \u092a\u0939\u0932\u0947, \u092e\u0948\u0902 \u0938\u0941\u092c\u0939 2 \u092c\u091c\u0947 \u091f\u094d\u0930\u0947\u0928 \u092e\u0947\u0902 \u0925\u093e\u0964 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0932\u0917\u093e\u090f, \u0935\u0949\u0932\u094d\u092f\u0942\u092e 100% \u092a\u0930, \u092b\u093f\u0930 \u092d\u0940 \u0911\u0921\u093f\u092f\u094b\u092c\u0941\u0915 \u0915\u093e \u0939\u0930 \u0936\u092c\u094d\u0926 \u0938\u093e\u092b\u093c \u0928\u0939\u0940\u0902 \u0906 \u0930\u0939\u093e \u0925\u093e\u0964 \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e, '\u092c\u0938 \u090f\u0915 \u0914\u0930 \u0921\u0947\u0938\u093f\u092c\u0932 \u091a\u093e\u0939\u093f\u090f' \u2014 \u0932\u0947\u0915\u093f\u0928 \u0935\u0939 \u0906\u0916\u093f\u0930\u0940 \u0921\u0947\u0938\u093f\u092c\u0932 \u0939\u092e\u0947\u0936\u093e \u0915\u093e\u0928\u094b\u0902 \u0915\u094b \u091a\u0940\u0930\u0924\u093e \u0939\u0948\u0964",
    "\u0924\u092c \u092e\u0941\u091d\u0947 \u092a\u0924\u093e \u091a\u0932\u093e \u0915\u093f \u0905\u0938\u0932\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f EQ \u0939\u0948\u0964 Loud EQ \u0915\u093e 'Podcast' \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0938\u093f\u0930\u094d\u092b\u093c \u0906\u0935\u093e\u091c\u093c \u0928\u0939\u0940\u0902 \u092c\u0922\u093c\u093e\u0924\u093e \u2014 \u0935\u0939 \u0939\u0930 \u092c\u094b\u0932\u0940 \u0915\u094b \u0930\u094b\u0921 \u0928\u0949\u0907\u091c\u093c \u0938\u0947 \u0905\u0932\u0917 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0906\u092a\u0915\u0947 \u0938\u094d\u092a\u0940\u0915\u0930 \u092f\u093e \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u094b \u0909\u0938\u0940 \u0924\u0930\u0939 \u091f\u094d\u092f\u0942\u0928 \u0915\u0930\u0924\u093e \u0939\u0948 \u091c\u0948\u0938\u0947 \u092a\u094d\u0930\u094b \u0938\u094d\u091f\u0942\u0921\u093f\u092f\u094b \u092e\u0947\u0902 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0915\u0947\u0964",
    "\u090f\u0915 \u091f\u0948\u092a \u092e\u0947\u0902 '\u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c' \u092c\u091f\u0928 \u0926\u092c\u093e\u0907\u090f \u2014 \u0914\u0930 \u0906\u092a\u0915\u093e \u0921\u093f\u0935\u093e\u0907\u0938 \u0905\u092a\u0928\u0947 \u0906\u092a \u0938\u092c\u0938\u0947 \u0938\u0939\u0940 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u091a\u0941\u0928 \u0932\u0947\u0924\u093e \u0939\u0948\u0964 \u091a\u093e\u0939\u0947 \u0906\u092a \u090f\u092f\u0930\u092a\u0949\u0921\u094d\u0938 \u0932\u0917\u093e\u090f\u0901 \u092f\u093e \u0935\u093e\u092f\u0930\u094d\u0921 \u0939\u0947\u0921\u092b\u093c\u094b\u0928, \u092f\u0939 \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0922\u0932 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0915\u094b\u0908 \u0917\u093f\u092e\u093f\u0915 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f 100,000+ \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092b\u093c\u0940\u091a\u0930 \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u090f\u0915 \u092c\u093e\u0930 'Podcast' \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092a\u0930 \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u0947\u0902\u0964 \u092b\u0930\u094d\u0915 \u0906\u092a\u0915\u094b \u0916\u0941\u0926 \u092e\u0939\u0938\u0942\u0938 \u0939\u094b\u0917\u093e\u0964 \n\nP.S. \u2014 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f 'Sound DNA' \u092b\u093c\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 EQ \u0938\u0947\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0938\u0947\u091f \u0915\u0930\u094b, \u0939\u092e\u0947\u0936\u093e \u0915\u0947 \u0932\u093f\u090f \u092d\u0942\u0932 \u091c\u093e\u0913\u0964"
  ],
