{
  "subject": "\ub2f9\uc2e0\uc758 \ub9c8\uc9c0\ub9c9 \uc608\uce21 \uc774\ud6c4 37\uac1c\uc758 \uc2b9\ub9ac\uac00 \ubc14\ub00c\uc5c8\uc2b5\ub2c8\ub2e4",
  "preview_text": "AI\uac00 \uc5c5\ub370\uc774\ud2b8\ud55c \ub370\uc774\ud130\ub85c \ub2f9\uc2e0\uc758 \ucd95\uad6c \uc9c0\uc2dd\uc774 \uc5bc\ub9c8\ub098 \uc815\ud655\ud55c\uc9c0 \ud655\uc778\ud574\ubcf4\uc138\uc694. \ub193\uce5c \uae30\ud68c\ub97c \ub418\ucc3e\uc744 \uc2dc\uac04\uc785\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uc9c0\ub09c\uc8fc \ud504\ub9ac\ubbf8\uc5b4\ub9ac\uadf8 \uacbd\uae30\uc5d0\uc11c AI\uac00 \uc608\uce21\ud55c 37\uac1c\uc758 \uacb0\uacfc \uc911 31\uac1c\uac00 \uc815\ud655\ud588\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc774 \ub9c8\uc9c0\ub9c9\uc73c\ub85c \uc571\uc744 \uc5f4\uc5c8\uc744 \ub54c\uc640\ub294 \ub2e4\ub978 \uc774\uc57c\uae30\uc785\ub2c8\ub2e4. \uadf8\ub3d9\uc548 \uc6b0\ub9ac\ub294 \uc608\uce21 \uc54c\uace0\ub9ac\uc998\uc744 \uc644\uc804\ud788 \uc5c5\ub370\uc774\ud2b8\ud588\uace0, \uc774\uc81c\ub294 \ud6e8\uc52c \ub354 \uc138\ubc00\ud55c \ubcc0\uc218\ub97c \ubd84\uc11d\ud569\ub2c8\ub2e4.",
    "\ub2f9\uc2e0\uc774 \ub193\uce5c \ub3d9\uc548, AI\ub294 50\uac1c \uc774\uc0c1\uc758 \ub9ac\uadf8\uc5d0\uc11c \uc218\ucc9c \uac1c\uc758 \uacbd\uae30 \ub370\uc774\ud130\ub97c \ud559\uc2b5\ud588\uc2b5\ub2c8\ub2e4. \uc774\uc81c \uac01 \uc608\uce21\uc5d0\ub294 '\ud655\uc2e0\ub3c4 \uc810\uc218'\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc624\ub298 \ubc14\ub974\uc140\ub85c\ub098 \ub300 \ub808\uc54c \ub9c8\ub4dc\ub9ac\ub4dc \uacbd\uae30\ub294 78% \ud655\uc2e0\ub3c4\ub85c AI\uac00 \ubc14\ub974\uc140\ub85c\ub098 \uc2b9\ub9ac\ub97c \uc608\uce21\ud569\ub2c8\ub2e4. \uc774\uac74 \ub2e8\uc21c\ud55c \uc9c1\uac10\uc774 \uc544\ub2cc, 200\uac1c \uc774\uc0c1\uc758 \ubcc0\uc218\uc5d0 \uae30\ubc18\ud55c \uacb0\uacfc\uc785\ub2c8\ub2e4.",
    "\uac8c\ub2e4\uac00 IQ \ud034\uc988 \uae30\ub2a5\uc774 \uc5c5\ub370\uc774\ud2b8\ub418\uc5b4, \uc774\uc81c AI\uc640 \uc9c1\uc811 \ub300\uacb0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \ucd95\uad6c \uc9c0\uc2dd\uc744 \uc2dc\ud5d8\ud558\uace0, \ub9ac\ub354\ubcf4\ub4dc\uc5d0\uc11c \uc21c\uc704\ub97c \uc62c\ub9ac\uc138\uc694. \uc774\ubbf8 1,200\uba85\uc758 \uc0ac\uc6a9\uc790\uac00 AI\ub97c \uc774\uacbc\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\ub3c4 \ub3c4\uc804\ud574\ubcf4\uc9c0 \uc54a\uaca0\uc2b5\ub2c8\uae4c?",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0 '\uc624\ub298\uc758 \uc608\uce21'\uc744 \ud655\uc778\ud574\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc774 \ub9c8\uc9c0\ub9c9\uc73c\ub85c \ubcf8 \uc774\ud6c4\ub85c \ub9ce\uc740 \uac83\uc774 \ubc14\ub00c\uc5c8\uc2b5\ub2c8\ub2e4. P.S. \uc624\ub298 \ud504\ub9ac\ubbf8\uc5c4 3\uc77c \ubb34\ub8cc \uccb4\ud5d8\uc744 \uc2dc\uc791\ud558\uba74, \ubaa8\ub4e0 \ub9ac\uadf8\uc758 \uace0\uae09 \ud1b5\uacc4\uc640 AI \ucc44\ud305 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \ucd95\uad6c \uc778\uc0ac\uc774\ud2b8\ub97c \ud55c \ub2e8\uacc4 \uc5c5\uadf8\ub808\uc774\ub4dc\ud560 \uae30\ud68c\uc785\ub2c8\ub2e4."
  ],
