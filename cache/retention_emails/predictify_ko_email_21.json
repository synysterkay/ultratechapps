{
  "subject": "\ub2f9\uc2e0\uc774 \ubaa8\ub974\ub294 \uc0ac\uc774\uc5d0 \ubc14\ub010 \uac83",
  "preview_text": "\uc571\uc774 \ub2ec\ub77c\uc84c\uc5b4\uc694. \ub2f9\uc2e0\uc774 \ub9c8\uc9c0\ub9c9\uc73c\ub85c \uc5f4\uc5c8\uc744 \ub54c\uc640\ub294 \uc644\uc804\ud788 \ub2e4\ub978 \uae30\ub2a5\uc774 \uc228\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \ub193\uce58\uc9c0 \ub9c8\uc138\uc694.",
  "body_paragraphs": [
    "\uc194\uc9c1\ud788 \ub9d0\ud560\uac8c\uc694. \ub2f9\uc2e0\uc774 \ub5a0\ub09c \uc774\ud6c4\ub85c, Predictify\ub294 \uc644\uc804\ud788 \uc0c8\ub85c\uc6cc\uc84c\uc5b4\uc694. AI\uac00 \ubd84\uc11d\ud558\ub294 \ubcc0\uc218\uac00 3\ubc30 \ub298\uc5c8\uace0, \uc608\uce21 \uc815\ud655\ub3c4\uac00 \ud3ed\ubc1c\uc801\uc73c\ub85c \uc62c\ub790\uc2b5\ub2c8\ub2e4. \ucd5c\uadfc 2\uc8fc\uac04 \ud504\ub9ac\ubbf8\uc5b4\ub9ac\uadf8 \uacbd\uae30\uc5d0\uc11c 87% \uc801\uc911\ub960\uc744 \uae30\ub85d\ud588\ub294\ub370, \uc774\uac74 \ub2e8\uc21c\ud55c \uc6b4\uc774 \uc544\ub2d9\ub2c8\ub2e4. \ub370\uc774\ud130\uac00 \ub9d0\ud574\uc8fc\ub294 \uc9c4\uc2e4\uc774\uc5d0\uc694.",
    "\ub2f9\uc2e0\uc774 \ub193\uce5c \uac8c \ubb54\uc9c0 \uc54c\ub824\uc904\uae4c\uc694? AI \ucc44\ud305 \uae30\ub2a5\uc774 \uc5c5\ub370\uc774\ud2b8\ub418\uc5b4\uc11c, '\uc624\ub298 \uc190\ud765\ubbfc\uc758 xG\ub294?' \uac19\uc740 \uc9c8\ubb38\uc5d0 0.5\ucd08 \ub9cc\uc5d0 \ub2f5\ubcc0\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub354 \uc774\uc0c1 \ub9c9\uc5f0\ud55c \uc9c1\uac10\uc5d0 \ubca0\ud305\ud558\uc9c0 \ub9c8\uc138\uc694. \ucee4\ubba4\ub2c8\ud2f0\uc5d0\uc11c '\uc624\ub298\uc758 \uc608\uce21'\uc5d0 \ud22c\ud45c\ud558\uace0, \ub2e4\ub978 \ud32c\ub4e4\uacfc \uc804\ub7b5\uc744 \uacf5\uc720\ud558\ub294 \uc7ac\ubbf8\ub3c4 \ucd94\uac00\ub410\uc5b4\uc694. \ud558\ub8e8\ub77c\ub3c4 \ub2a6\uac8c \ud655\uc778\ud558\uba74, \ub2f9\uc2e0\ub9cc \uc190\ud574\uc785\ub2c8\ub2e4.",
    "\uac00\uc7a5 \ud070 \ubcc0\ud654\ub294 'IQ \ud034\uc988'\uc785\ub2c8\ub2e4. AI\uc640 \uaca8\ub904 \ucd95\uad6c \uc9c0\uc2dd\uc744 \uc2dc\ud5d8\ud558\uace0, \ub9ac\ub354\ubcf4\ub4dc\uc5d0\uc11c \uc21c\uc704\ub97c \uc62c\ub9ac\uc138\uc694. 3\uc77c \ubb34\ub8cc \uccb4\ud5d8\uc73c\ub85c \ud504\ub9ac\ubbf8\uc5c4 \uae30\ub2a5(\uc6d4 12.99\ub2ec\ub7ec)\uc744 \uc368\ubcf4\uba74, \ubaa8\ub4e0 \uacbd\uae30\uc758 \uace0\uae09 \ud1b5\uacc4\uc640 \ubb34\uc81c\ud55c \uc608\uce21\uc744 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ubbf8 \uc218\ucc9c \uba85\uc758 \ud32c\ub4e4\uc774 \uc774 \uae30\ub2a5\uc73c\ub85c \uc2b9\ubd80\ub97c \uac78\uace0 \uc788\uc5b4\uc694.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uc5b4\ubcf4\uc138\uc694. \uc5c5\ub370\uc774\ud2b8\ub41c 'AI \uc608\uce21' \ud0ed\uc744 \ud655\uc778\ud558\uace0, \uccab \ubc88\uc9f8 \ub9e4\uce58\uc758 \ucee8\ud53c\ub358\uc2a4 \uc2a4\ucf54\uc5b4\ub97c \uc810\uac80\ud574\ubcf4\ub294 \uac81\ub2c8\ub2e4. P.S. \ucd5c\uadfc \ucd94\uac00\ub41c '\ub370\uc77c\ub9ac \uc2a4\ud2b8\ub9ad' \ubcf4\ub108\uc2a4\ub97c \ub193\uce58\uba74, \uc313\uc544\uc628 \uc5c5\uc801\uc774 \uc0ac\ub77c\uc9c8 \uc218\ub3c4 \uc788\uc5b4\uc694. \uc624\ub298 \ub85c\uadf8\uc778\ud558\uace0 7\uc77c \uc5f0\uc18d \uc2a4\ud2b8\ub9ad\uc744 \uc2dc\uc791\ud558\uc138\uc694 \u2014 \ub2f9\uc2e0\uc774 \uac00\uc7a5 \ub611\ub611\ud55c \ud32c\uc784\uc744 \uc99d\uba85\ud560 \uc2dc\uac04\uc785\ub2c8\ub2e4."
  ],
