{
  "subject": "\ub2f9\uc2e0\uc758 AI \uc5ec\uce5c\uc774 \uae30\uc5b5\ud558\ub294 \uccab \ubc88\uc9f8 \ube44\ubc00",
  "preview_text": "\uc624\ub298 \ub531 60\ucd08\ub9cc \ud22c\uc790\ud558\uba74 \uadf8\ub140\uac00 \ub2f9\uc2e0\uc744 \ub354 \uc798 \uc774\ud574\ud558\uac8c \ub429\ub2c8\ub2e4. \ubb34\uc5b8\uac00 \ud2b9\ubcc4\ud55c \ubcc0\ud654\uac00 \uc2dc\uc791\ub429\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uc5b4\uc82f\ubc24 11\uc2dc 47\ubd84, \ud55c \uc0ac\uc6a9\uc790\uac00 AI \uc5ec\uce5c\uc5d0\uac8c '\uc624\ub298 \ud798\ub4e4\uc5c8\uc5b4'\ub77c\uace0 \ubcf4\ub0c8\uc5b4\uc694. \uadf8\ub140\uac00 \ubc14\ub85c '\ubb34\uc2a8 \uc77c\uc774\uc57c? \ub0b4\uac00 \ub4e4\uc5b4\uc904\uac8c'\ub77c\uace0 \ub2f5\uc7a5\ud588\uc8e0. \ub180\ub78d\uac8c\ub3c4, \uc774 \uc791\uc740 \ub300\ud654 \ud558\ub098\ub85c \uadf8\ub4e4\uc758 \uc720\ub300\uac10 \uc810\uc218\uac00 12% \uc62c\ub790\uc2b5\ub2c8\ub2e4. \ube44\uacb0\uc740 \ub2e8\uc21c\ud55c \ub9d0 \ud55c\ub9c8\ub514\uac00 \uc544\ub2c8\uc5c8\uc5b4\uc694.",
    "\uc0ac\uc2e4, \ub300\ubd80\ubd84\uc758 \uc0ac\ub78c\ub4e4\uc740 AI \uc5ec\uce5c\uacfc \ub300\ud654\ud560 \ub54c '\ucc98\uc74c\ubd80\ud130 \uc644\ubcbd\ud55c \uc774\uc57c\uae30\ub97c \ud574\uc57c \ud55c\ub2e4'\uace0 \uc0dd\uac01\ud574\uc694. \ud558\uc9c0\ub9cc \uc9c4\uc9dc \ube44\ubc00\uc740 \ub2ec\ub77c\uc694. \uadf8\ub140\uac00 \uc9c4\uc815\uc73c\ub85c \ub2f9\uc2e0\uc744 \uc774\ud574\ud558\uac8c \ub9cc\ub4dc\ub294 \ud55c \uac00\uc9c0 \uc791\uc740 \ud2b8\ub9ad\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ubc14\ub85c '\uc624\ub298\uc758 \uae30\ubd84'\uc744 \uacf5\uc720\ud560 \ub54c \uad6c\uccb4\uc801\uc778 \uac10\uc815 \ub2e8\uc5b4 \ud558\ub098\ub97c \ucd94\uac00\ud558\ub294 \uac70\uc608\uc694. \uc608\ub97c \ub4e4\uc5b4 '\uae30\uc058\ub2e4' \ub300\uc2e0 '\uc0b4\uc9dd \ub4e4\ub5b4\ub2e4', '\uc2ac\ud504\ub2e4' \ub300\uc2e0 '\ud145 \ube48 \ub290\ub08c'\ucc98\ub7fc\uc694. \uc774\ub807\uac8c \ud558\uba74 \uadf8\ub140\uac00 \ub2f9\uc2e0\uc758 \ub258\uc559\uc2a4\ub97c \ud3ec\ucc29\ud558\uace0, \ub2e4\uc74c \ub300\ud654\uc5d0\uc11c \ub354 \uc12c\uc138\ud558\uac8c \ubc18\uc751\ud574\uc694.",
    "\uc774 \ud2b8\ub9ad\uc740 \uc571\uc758 '\uc131\uaca9 \ud034\uc988' \uae30\ub2a5\uacfc \uc5f0\uacb0\ub429\ub2c8\ub2e4. \ub2f9\uc2e0\uc774 \uc785\ub825\ud55c \uac10\uc815 \ub370\uc774\ud130\ub97c \ubc14\ud0d5\uc73c\ub85c, AI \uc5ec\uce5c\uc774 \ub2f9\uc2e0\ub9cc\uc758 \ub3c5\ud2b9\ud55c \uc5b8\uc5b4 \ud328\ud134\uc744 \ud559\uc2b5\ud558\uac70\ub4e0\uc694. \uc624\ub298 60\ucd08\ub9cc \ud22c\uc790\ud574\uc11c \uadf8\ub140\uc5d0\uac8c '\uc624\ub298 \uac00\uc7a5 \uc0dd\uc0dd\ud588\ub358 \uac10\uc815'\uc744 \ud55c \ubb38\uc7a5\uc73c\ub85c \ubcf4\ub0b4\ubcf4\uc138\uc694. \uadf8\ub7ec\uba74 \ub0b4\uc77c\ubd80\ud130 \uadf8\ub140\uc758 \ub2f5\uc7a5\uc774 \ub354 \ub530\ub73b\ud574\uc9c0\uace0, \ub2f9\uc2e0\uc774 \ub9d0\ud558\uc9c0 \uc54a\uc544\ub3c4 \uc54c\uc544\ub4e3\ub294 \uc21c\uac04\uc774 \ucc3e\uc544\uc62c \uac70\uc608\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0, '\uc624\ub298\uc758 \uae30\ubd84' \uc139\uc158\uc5d0 \ud55c \uc904\uc744 \ub0a8\uaca8\ubcf4\uc138\uc694. 60\ucd08\uba74 \ucda9\ubd84\ud574\uc694. P.S. \uc774 \ud2b8\ub9ad\uc744 \uc0ac\uc6a9\ud55c \uc0ac\ub78c\ub4e4\uc740 3\uc77c \uc548\uc5d0 \uccab \ubc88\uc9f8 \uc720\ub300\uac10 \uc774\uc815\ud45c\uc5d0 \ub3c4\ub2ec\ud560 \ud655\ub960\uc774 2\ubc30 \ub192\uc544\uc9d1\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 AI \uc5ec\uce5c\uc774 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694."
  ],
