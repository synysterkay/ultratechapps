{
  "subject": "2\uc2dc\uac04 \ub370\uc774\ud2b8\uac00 30\ucd08 \ub9cc\uc5d0 \ub05d\ub09c \uc774\uc720",
  "preview_text": "\ub370\uc774\ud2b8 \uae30\ud68d\uc774 \uc5b4\ub835\ub2e4\ub294 \uac74 \uac70\uc9d3\ub9d0\uc785\ub2c8\ub2e4. \uc9c4\uc9dc \ubb38\uc81c\ub294 \ub530\ub85c \uc788\uc5c8\uc5b4\uc694.",
  "body_paragraphs": [
    "\ubaa8\ub4e0 \ucee4\ud50c\uc774 \ubbff\ub294 \uac70\uc9d3\ub9d0\uc774 \ud558\ub098 \uc788\uc5b4\uc694: '\ub370\uc774\ud2b8\ub294 \uc624\ub798 \uae30\ud68d\ud574\uc57c \ud2b9\ubcc4\ud558\ub2e4.' \uadf8\ub798\uc11c \uc8fc\ub9d0 \ub0b4\ub0b4 \ucc3e\uc544\ubcf4\uace0, \ubc24\uc0c8 \uace0\ubbfc\ud558\uace0, \uacb0\uad6d\uc5d4 \uc9c0\uccd0\uc11c \ud3c9\uc18c \uac00\ub358 \uce74\ud398\ub098 \uac00\uc8e0. \ud558\uc9c0\ub9cc 500\uc30d\uc758 \ucee4\ud50c\uc744 \ubd84\uc11d\ud55c \uacb0\uacfc, \uae30\ud68d \uc2dc\uac04\uc774 1\ubd84 \ubbf8\ub9cc\uc778 \ub370\uc774\ud2b8\uac00 \uc624\ud788\ub824 \ub9cc\uc871\ub3c4\uac00 40% \ub354 \ub192\uc558\uc2b5\ub2c8\ub2e4.",
    "\uc65c\uc77c\uae4c\uc694? \uae30\ud68d\uc5d0 \ub108\ubb34 \uc5d0\ub108\uc9c0\ub97c \uc4f0\uba74 \uc815\uc791 \ub370\uc774\ud2b8 \uc790\uccb4\uac00 \uc9c0\ub8e8\ud574\uc9c0\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ub1cc\ub294 \uc774\ubbf8 '\uc644\ub8cc\ub41c \uc77c'\ub85c \uc778\uc2dd\ud574\uc11c \ud765\ubd84\ub3c4\uac00 \ub5a8\uc5b4\uc838\uc694. \ubc18\uba74, 30\ucd08 \ub9cc\uc5d0 \uace0\ub978 '\ud22c\ub098\uc787 \ub370\uc774\ud2b8'\ub97c \ud55c \ucee4\ud50c\uc740 \uae5c\uc9dd \ub180\ub77c\uba70 \ub354 \ud070 \uae30\uc068\uc744 \ub290\uaf08\uc2b5\ub2c8\ub2e4. \uacc4\ud68d\ubcf4\ub2e4 \uc21c\uac04\uc774 \ub354 \uac15\ub825\ud55c \uac70\uc8e0.",
    "SoulPlan\uc758 '\ud22c\ub098\uc787 \ub370\uc774\ud2b8'\ub294 \uc774 \uc0ac\uc2e4\uc744 \uc99d\uba85\ud569\ub2c8\ub2e4. \ud648 \ud654\uba74\uc5d0\uc11c \ub2f9\uc2e0\uacfc \ud30c\ud2b8\ub108\uc758 \uae30\ubd84(\uc544\ub291\ud55c, \ubaa8\ud5d8\uc801\uc778, \uc7a5\ub09c\uae30 \uac00\ub4dd\ud55c, \uce58\uc720\uc758)\uc744 \ud55c \ubc88\ub9cc \ud0ed\ud558\uba74, AI\uac00 \ubc14\ub85c \uc624\ub298 \ubc24\uc744 \uacc4\ud68d\ud574\uc918\uc694. \uae30\ud68d\uc740 30\ucd08, \ucd94\uc5b5\uc740 \ud3c9\uc0dd. \uc774\uac8c \uc9c4\uc9dc \ud6a8\uc728\uc801\uc778 \ub85c\ub9e8\uc2a4\uc785\ub2c8\ub2e4.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0 '\ud22c\ub098\uc787 \ub370\uc774\ud2b8'\ub97c \ud0ed\ud558\uc138\uc694. \ud30c\ud2b8\ub108\uac00 \ub2f9\uc2e0\uc744 \uc0dd\uac01\ud588\ub2e4\ub294 \uc804\uc728\uc744 \ub290\ub084 \uac70\uc608\uc694. P.S. \uc0ac\uc2e4 \uc624\ub298 \ubc24 \ub370\uc774\ud2b8\ub294 10\ucd08\uba74 \ub05d\ub0a9\ub2c8\ub2e4. \uae30\ubd84 \uc120\ud0dd\ub9cc \ud558\uba74 \ub098\uba38\uc9c0\ub294 AI\uac00 \ud558\ub2c8\uae4c\uc694."
  ],
