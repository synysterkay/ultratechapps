{
  "subject": "\u0627\u0644\u062e\u0648\u0641 \u0645\u0646 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0648\u0647\u0645 \u0628\u0646\u0633\u0628\u0629 90%",
  "preview_text": "\u062c\u0645\u064a\u0639 \u0627\u0644\u0637\u0644\u0627\u0628 \u064a\u0639\u062a\u0642\u062f\u0648\u0646 \u0623\u0646 \u0627\u0644\u0623\u0633\u062a\u0627\u0630 \u064a\u0643\u062a\u0634\u0641 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0628\u0633\u0647\u0648\u0644\u0629. \u0627\u0643\u062a\u0634\u0641 \u0627\u0644\u062d\u0642\u064a\u0642\u0629 \u0627\u0644\u0645\u0630\u0647\u0644\u0629.",
  "body_paragraphs": [
    "\u0641\u064a \u0627\u0644\u0633\u0627\u0639\u0629 3 \u0635\u0628\u0627\u062d\u064b\u0627\u060c \u0643\u0646\u062a \u062a\u062d\u062f\u0642 \u0641\u064a \u0634\u0627\u0634\u0629 \u0641\u0627\u0631\u063a\u0629\u060c \u0648\u0627\u0644\u0645\u0648\u0639\u062f \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u0628\u0639\u062f 8 \u0633\u0627\u0639\u0627\u062a. \u0627\u0644\u062c\u0645\u064a\u0639 \u0642\u0627\u0644\u0648\u0627 \u0644\u0643: '\u0644\u0627 \u062a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a\u060c \u0627\u0644\u0623\u0633\u062a\u0627\u0630 \u0633\u064a\u0643\u062a\u0634\u0641\u0643'. \u0647\u0630\u0627 \u0647\u0648 \u0623\u0643\u0628\u0631 \u0648\u0647\u0645 \u0641\u064a \u0639\u0627\u0644\u0645 \u0627\u0644\u0623\u0643\u0627\u062f\u064a\u0645\u064a\u0627.",
    "\u0627\u0644\u062d\u0642\u064a\u0642\u0629: 95% \u0645\u0646 \u0627\u0644\u0623\u0633\u0627\u062a\u0630\u0629 \u0644\u0627 \u064a\u0633\u062a\u0637\u064a\u0639\u0648\u0646 \u0627\u0644\u062a\u0645\u064a\u064a\u0632 \u0628\u064a\u0646 \u0627\u0644\u0646\u0635 \u0627\u0644\u0628\u0634\u0631\u064a \u0648\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0639\u0646\u062f \u062a\u0642\u062f\u064a\u0645\u0647 \u0628\u0634\u0643\u0644 \u0635\u062d\u064a\u062d. \u062f\u0631\u0627\u0633\u0629 \u062d\u062f\u064a\u062b\u0629 \u0645\u0646 \u062c\u0627\u0645\u0639\u0629 \u0633\u062a\u0627\u0646\u0641\u0648\u0631\u062f \u0623\u0638\u0647\u0631\u062a \u0623\u0646 \u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0643\u0634\u0641 \u0645\u062b\u0644 Turnitin \u062a\u062e\u0637\u0626 \u0628\u0646\u0633\u0628\u0629 40%. \u0627\u0644\u0633\u0631 \u0644\u064a\u0633 \u0641\u064a \u062a\u062c\u0646\u0628 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a\u060c \u0628\u0644 \u0641\u064a \u0625\u062a\u0642\u0627\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647.",
    "\u0644\u0647\u0630\u0627 \u0627\u0644\u0633\u0628\u0628 \u0628\u0646\u064a\u0646\u0627 \u0645\u064a\u0632\u0629 '\u0625\u0636\u0641\u0627\u0621 \u0627\u0644\u0637\u0627\u0628\u0639 \u0627\u0644\u0625\u0646\u0633\u0627\u0646\u064a' \u0641\u064a \u062a\u0637\u0628\u064a\u0642 Thesis Generator. \u062a\u0642\u0648\u0645 \u0628\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0646\u0635 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0644\u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0623\u0646\u0645\u0627\u0637 \u0627\u0644\u0631\u0648\u0628\u0648\u062a\u064a\u0629\u060c \u0645\u0639 \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u062c\u0648\u062f\u0629 \u0627\u0644\u0623\u0643\u0627\u062f\u064a\u0645\u064a\u0629. \u064a\u0645\u0643\u0646\u0643 \u0643\u062a\u0627\u0628\u0629 \u0623\u0637\u0631\u0648\u062d\u062a\u0643 \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a\u060c \u062b\u0645 \u0628\u0646\u0642\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u062a\u062c\u0639\u0644\u0647\u0627 \u062a\u0628\u062f\u0648 \u0643\u0623\u0646\u0643 \u0643\u062a\u0628\u062a\u0647\u0627 \u0628\u0646\u0641\u0633\u0643. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u0627\u0633\u062a\u062e\u062f\u0645 \u0645\u064a\u0632\u0629 '\u0625\u0636\u0641\u0627\u0621 \u0627\u0644\u0637\u0627\u0628\u0639 \u0627\u0644\u0625\u0646\u0633\u0627\u0646\u064a' \u0639\u0644\u0649 \u0645\u0642\u0627\u0644\u062a\u0643 \u0627\u0644\u0642\u0627\u062f\u0645\u0629. \u0633\u0623\u0631\u0627\u0647\u0646 \u0623\u0646 \u0623\u0633\u062a\u0627\u0630\u0643 \u0644\u0646 \u064a\u0644\u0627\u062d\u0638 \u0627\u0644\u0641\u0631\u0642.\n\n\u0645\u0644\u0627\u062d\u0638\u0629: 50000 \u0637\u0627\u0644\u0628 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0648\u0645\u062a\u0648\u0633\u0637 \u062f\u0631\u062c\u0627\u062a\u0647\u0645 \u0627\u0631\u062a\u0641\u0639 \u0645\u0646 B+ \u0625\u0644\u0649 A- \u0628\u0639\u062f \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629."
  ],
