{
  "subject": "39\uc77c \ub9cc\uc5d0 \uc4f0\ub294 \uc194\uc9c1\ud55c \ud3b8\uc9c0",
  "preview_text": "\uc571 \ub9cc\ub4e0 \uc0ac\ub78c\uc774 \uc9c1\uc811 \uc501\ub2c8\ub2e4. \ubcf4\ud1b5 \uc774\ub7f0 \uba54\uc77c \uc548 \uc4f0\ub294\ub370, \uc624\ub298\uc740 \uc880 \ub2e4\ub985\ub2c8\ub2e4.",
  "body_paragraphs": [
    "\uc800\ub294 \ubcf4\ud1b5 \uc774\ub7f0 \uba54\uc77c\uc744 \uc548 \uc501\ub2c8\ub2e4. \uadfc\ub370 \uc624\ub298 \uc0c8\ubcbd 2\uc2dc, \uc720\ub7fd \ucd95\uad6c \uacbd\uae30 \ubd84\uc11d\ud558\ub2e4\uac00 \ubb38\ub4dd \ub4e0 \uc0dd\uac01\uc774 \uc788\uc5b4\uc694. 'Predictify\ub97c \ub2e4\uc6b4\ubc1b\uc740 \uc0ac\ub78c\ub4e4 \uc911, \uc9c4\uc9dc \ub370\uc774\ud130\ub85c \ucd95\uad6c\ub97c \uc990\uae30\ub294 \uc0ac\ub78c\uc740 \uba87 \uba85\uc774\ub098 \ub420\uae4c?' \uc194\uc9c1\ud788, \uc5ec\ub7ec\ubd84\uc774 \uc571\uc744 \ucf1c\uae30\ub9cc \ud574\ub3c4 \uc800\ub294 \uae30\uc069\ub2c8\ub2e4. \uadfc\ub370 \ub354 \ubc14\ub77c\ub294 \uac8c \uc788\uc5b4\uc694. \uc5ec\ub7ec\ubd84\uc774 '\uc544, \uc774\uac70\uc600\uc5b4!' \ud558\ub294 \uc21c\uac04\uc744 \ub290\ub07c\uae38 \ubc14\ub78d\ub2c8\ub2e4.",
    "3\uc8fc \uc804, \ud55c \uc720\uc800\uac00 \ucc54\uc2a4 16\uac15\uc804\uc5d0\uc11c \uc800\ud76c AI\uac00 \uc900 78% \uc2e0\ub8b0\ub3c4\uc758 \uc608\uce21\uc744 \ubcf4\uace0 \ubca0\ud305\ud588\ub294\ub370, \uacb0\uacfc\uac00 \uc801\uc911\ud588\ub2e4\uace0 \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0b4\uc654\uc5b4\uc694. \uadf8 \uc21c\uac04, \uc81c\uac00 \uc774 \uc571\uc744 \ub9cc\ub4e0 \uc774\uc720\uac00 \uac70\uae30 \uc788\uc5c8\uc2b5\ub2c8\ub2e4. '\ub370\uc774\ud130\uac00 \uc9c1\uac10\uc744 \uc774\uae34\ub2e4'\ub294 \uac78 \ubab8\uc18c \uccb4\ud5d8\ud55c \uac70\uc8e0. \uc5ec\ub7ec\ubd84\ub3c4 \uadf8\ub7f0 \uc21c\uac04\uc744 \uacbd\ud5d8\ud560 \uc790\uaca9\uc774 \uc788\uc2b5\ub2c8\ub2e4.",
    "\uc544\ub9c8 \uc5ec\ub7ec\ubd84\uc740 \uc544\uc9c1 'AI \ucc57' \uae30\ub2a5\uc744 \uc548 \uc368\ubcf4\uc168\uc744 \uac81\ub2c8\ub2e4. '\ub808\uc54c \ub9c8\ub4dc\ub9ac\ub4dc, \uc774\ubc88 \uc8fc\ub9d0 \uacbd\uae30\uc5d0\uc11c \uc810\uc720\uc728 \uc5bc\ub9c8\ub098 \uac00\uc838\uac08\uae4c?' \uac19\uc740 \uc9c8\ubb38\uc744 \ub358\uc9c0\uba74, AI\uac00 \uc218\ucc9c \uac1c\uc758 \ubcc0\uc218\ub97c \ubd84\uc11d\ud574 \ub2f5\uc744 \uc90d\ub2c8\ub2e4. \uadf8\ub9ac\uace0 '\ud034\uc988'\uc5d0\uc11c \uadf8 \uc9c0\uc2dd\uc744 \uc2dc\ud5d8\ud574\ubcf4\uc138\uc694. \ub9ac\ub354\ubcf4\ub4dc\uc5d0 \uc624\ub974\uba74, \uadf8\ub0e5 \ubcf4\ub294 \ucd95\uad6c\uc640\ub294 \ub2e4\ub978 \uc7ac\ubbf8\ub97c \ub290\ub084 \uac81\ub2c8\ub2e4.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uc5b4\uc11c, \uc624\ub298 \uacbd\uae30 \uc911 \ud558\ub098\ub97c \uace8\ub77c 'AI \uc608\uce21'\uc744 \ud655\uc778\ud574\ubcf4\uc138\uc694. \uadf8\ub9ac\uace0 \uadf8 \uc608\uce21\uc774 \ub9de\ub294\uc9c0 \uc9c1\uc811 \ud655\uc778\ud574\ubcf4\uc138\uc694. P.S. 3\uc77c \ubb34\ub8cc \uccb4\ud5d8\uc774 \uc544\uc9c1 \ub0a8\uc544\uc788\ub2e4\uba74, \ud504\ub9ac\ubbf8\uc5c4 \uc608\uce21\ub3c4 \ud55c\ubc88 \ub4e4\uc5ec\ub2e4\ubcf4\uc138\uc694. '\ub370\uc774\ud130\uac00 \uc9c1\uac10\uc744 \uc774\uae34\ub2e4'\ub294 \ub9d0, \uc9c1\uc811 \ud655\uc778\ud574\ubcf4\uc2dc\uae38 \ubc14\ub78d\ub2c8\ub2e4."
