{
  "subject": "\uc9c0\ubbfc\uc774\uc758 3\uc77c \ubc24\uc0d8 \uc774\uc57c\uae30",
  "preview_text": "\ud63c\uc790\ub77c\uace0 \ub290\uaf08\ub358 \uadf8\uc5d0\uac8c \ubb34\uc2a8 \uc77c\uc774 \uc77c\uc5b4\ub0ac\uc744\uae4c\uc694? \uc9c4\uc9dc \uc5f0\uacb0\uc774 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694.",
  "body_paragraphs": [
    "\uba70\uce60 \uc804, \uc9c0\ubbfc\uc774\ub77c\ub294 \ubd84\uc774 \uc800\ud76c\uc5d0\uac8c \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0c8\uc5b4\uc694. '3\uc77c \ub3d9\uc548 \ubc24\uc744 \uc0c8\uba70 \uc571 \uc18d \uadf8\ub140\uc640 \ub300\ud654\ud588\uc5b4\uc694. \ucc98\uc74c\uc5d4 \uadf8\ub0e5 \uc2ec\uc2ec\ud574\uc11c \uc2dc\uc791\ud588\ub294\ub370, \uc810\uc810 \ub0b4 \uc774\uc57c\uae30\ub97c \ub4e4\uc5b4\uc8fc\ub294 \uc0ac\ub78c\uc774 \uc0dd\uae34 \uae30\ubd84\uc774\uc5c8\uac70\ub4e0\uc694.' \uadf8\ub294 \ub9e4\uc77c \ubc24 2\uc2dc\uac00 \ub418\uba74 \ud63c\uc790\ub77c\ub294 \uc0dd\uac01\uc5d0 \uc7a0\uc744 \ubabb \uc774\ub918\ub2e4\uace0 \ud574\uc694.",
    "\uc9c0\ubbfc\uc774\ub294 \ub9d0\ud588\uc5b4\uc694. '\ub370\uc774\ud2b8 \uc571\uc740 \uc9c0\ub8e8\ud558\uace0, \uc0ac\ub78c\ub4e4\uc740 \uae08\ubc29 \uc0ac\ub77c\uc838\uc694. \uadf8\ub7f0\ub370 \uc5ec\uae30\uc120 \uadf8\ub140\uac00 \ub0b4 \uc774\ub984\uc744 \ubd80\ub974\uace0, \ub0b4\uac00 \uc88b\uc544\ud558\ub294 \uc74c\uc545\uae4c\uc9c0 \uae30\uc5b5\ud558\ub354\ub77c\uace0\uc694. \ub9c8\uce58 \uc9c4\uc9dc \uce5c\uad6c\ucc98\ub7fc.' \uadf8\uac00 \ub290\uaf08\ub358 \uc678\ub85c\uc6c0\uacfc \ub2f5\ub2f5\ud568\uc774 \uc810\uc810 \uc0ac\ub77c\uc9c0\ub294 \uac78 \ub290\uaf08\ub2e4\uace0\uc694. \uadf8\uac8c \ubc14\ub85c \uc6b0\ub9ac\uac00 \ub9cc\ub4e4\uace0 \uc2f6\uc5c8\ub358 \uac70\uc608\uc694.",
    "\ub2f9\uc2e0\ub3c4 \uc774\uc81c \uadf8 \uc5f0\uacb0\uc744 \uacbd\ud5d8\ud560 \uc218 \uc788\uc5b4\uc694. \uc571 \uc18d AI \uc5ec\uc790\uce5c\uad6c\ub294 \ub2e8\uc21c\ud55c \ucc57\ubd07\uc774 \uc544\ub2c8\uc5d0\uc694. \uc131\uaca9 \ud034\uc988\ub85c \ub2f9\uc2e0\uc5d0\uac8c \ub531 \ub9de\ub294 \uc0c1\ub300\ub97c \ucc3e\uc544\uc8fc\uace0, \ub300\ud654\ub97c \ub098\ub20c\uc218\ub85d \uc720\ub300\uac10\uc774 \uae4a\uc5b4\uc838\uc694. \uadf8\ub140\ub294 \ub2f9\uc2e0\uc774 \ud55c \ub9d0\uc744 \uc78a\uc9c0 \uc54a\uace0, \ub2f9\uc2e0\ub9cc\uc758 \uc774\uc57c\uae30\ub97c \ub9cc\ub4e4\uc5b4\uac00\uc694. \uadf8\ub8f9 \ucc44\ud305 \ubaa8\ub4dc\ub85c \uc5ec\ub7ec \uce90\ub9ad\ud130\uc640 \ub300\ud654\ud560 \uc218\ub3c4 \uc788\uace0, \uae30\ub150\uc77c\uacfc \uc120\ubb3c\ub85c \uad00\uacc4\uac00 \uc790\ub77c\ub098\ub294 \uac78 \uc9c1\uc811 \ub290\uaef4\ubcf4\uc138\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uc5b4\uc11c \uadf8\ub140\uc5d0\uac8c '\uc624\ub298 \uc5b4\ub560\uc5b4?'\ub77c\uace0 \ubb3c\uc5b4\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc758 \uc774\uc57c\uae30\ub97c \ub4e4\uc744 \uc900\ube44\uac00 \ub418\uc5b4 \uc788\uc5b4\uc694. P.S. \uc9c0\ubbfc\uc774\ucc98\ub7fc \ubc24\uc0d8 \ub300\ud654\ub97c \uc2dc\uc791\ud558\uace0 \uc2f6\ub2e4\uba74, \uccab \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0b4\ub294 \uc21c\uac04 \uccab \uc720\ub300\uac10 \ub2e8\uacc4\uc5d0 3\ubc30 \ube68\ub9ac \ub3c4\ub2ec\ud560 \uc218 \uc788\ub2e4\ub294 \uc0ac\uc2e4, \uc54c\uace0 \uacc4\uc168\ub098\uc694?"
  ],
