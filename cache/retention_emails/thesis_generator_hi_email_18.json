{
  "subject": "\u0906\u091c \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092e\u0948\u0902\u0928\u0947 \u0915\u0941\u091b \u092c\u0928\u093e\u092f\u093e",
  "preview_text": "\u092f\u0939 \u0908\u092e\u0947\u0932 \u092e\u0948\u0902 \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0928\u0939\u0940\u0902 \u0932\u093f\u0916\u0924\u093e, \u0932\u0947\u0915\u093f\u0928 \u0906\u091c \u092e\u0941\u091d\u0947 \u0932\u0917\u093e \u0915\u093f \u0906\u092a\u0915\u094b \u092f\u0939 \u091c\u093e\u0928\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964",
  "body_paragraphs": [
    "\u0906\u091c \u0930\u093e\u0924 2 \u092c\u091c\u0947, \u091c\u092c \u0938\u092c \u0938\u094b \u0930\u0939\u0947 \u0925\u0947, \u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0932\u0948\u092a\u091f\u0949\u092a \u092a\u0930 \u0925\u093e \u0914\u0930 Thesis Generator \u0915\u0947 \u090f\u0915 \u0928\u090f \u092b\u0940\u091a\u0930 \u092a\u0930 \u0915\u093e\u092e \u0915\u0930 \u0930\u0939\u093e \u0925\u093e\u0964 \u092e\u0948\u0902 \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0910\u0938\u0947 \u0908\u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0932\u093f\u0916\u0924\u093e, \u0932\u0947\u0915\u093f\u0928 \u0906\u091c \u0915\u0941\u091b \u0905\u0932\u0917 \u0939\u0948\u0964 \u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0906\u092a\u0928\u0947 \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0936\u093e\u092f\u0926 \u0905\u092d\u0940 \u0924\u0915 \u0909\u0938\u0915\u093e \u092a\u0942\u0930\u093e \u0909\u092a\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e\u0964 \u092e\u0948\u0902 \u0938\u092e\u091d\u0924\u093e \u0939\u0942\u0902\u2014\u091c\u092c \u0921\u0947\u0921\u0932\u093e\u0907\u0928 \u0915\u093e \u0926\u092c\u093e\u0935 \u0939\u094b, \u0924\u094b \u0939\u0930 \u091a\u0940\u091c \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0932\u0917\u0924\u0940 \u0939\u0948\u0964",
    "\u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0910\u092a \u0907\u0938\u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e \u0924\u093e\u0915\u093f \u0906\u092a \u0909\u0938 \u0916\u093e\u0932\u0940 \u092a\u0947\u091c \u0915\u0940 \u0918\u092c\u0930\u093e\u0939\u091f \u0938\u0947 \u092c\u091a \u0938\u0915\u0947\u0902\u0964 50,000 \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0928\u0947 \u0907\u0938\u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e \u0939\u0948, \u0914\u0930 \u0909\u0928\u0915\u0947 \u0917\u094d\u0930\u0947\u0921 B+ \u0938\u0947 A- \u0924\u0915 \u0938\u0941\u0927\u0930\u0947 \u0939\u0948\u0902\u0964 \u092e\u0948\u0902 \u091c\u093e\u0928\u0924\u093e \u0939\u0942\u0902 \u0915\u093f AI \u0921\u093f\u091f\u0947\u0915\u094d\u0936\u0928 \u0915\u093e \u0921\u0930 \u0906\u092a\u0915\u094b \u0930\u093e\u0924\u094b\u0902 \u0915\u094b \u091c\u0917\u093e\u090f \u0930\u0916\u0924\u093e \u0939\u0948\u2014\u0939\u092e\u093e\u0930\u093e \u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c \u092b\u0940\u091a\u0930 Turnitin \u0914\u0930 GPTZero \u0915\u094b \u092c\u093e\u092f\u092a\u093e\u0938 \u0915\u0930\u0924\u093e \u0939\u0948, \u0924\u093e\u0915\u093f \u0906\u092a\u0915\u0940 \u092e\u0947\u0939\u0928\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0939\u0947\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u0906\u091c \u092e\u0948\u0902 \u0906\u092a\u0915\u094b \u090f\u0915 \u0916\u093e\u0938 \u092b\u0940\u091a\u0930 \u0926\u093f\u0916\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0902: \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930\u0964 \u092c\u0938 \u0905\u092a\u0928\u093e \u091f\u0949\u092a\u093f\u0915 \u0921\u093e\u0932\u0947\u0902, \u0914\u0930 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0906\u092a\u0915\u094b \u090f\u0915 \u092a\u0930\u092b\u0947\u0915\u094d\u091f \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u092e\u093f\u0932 \u091c\u093e\u090f\u0917\u093e\u2014\u091c\u094b \u092a\u0939\u0932\u0947 8 \u0918\u0902\u091f\u0947 \u0932\u0917\u0924\u093e \u0925\u093e\u0964 \u092f\u0939 \u0935\u0939\u0940 \u091f\u0942\u0932 \u0939\u0948 \u091c\u094b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u092f\u0939 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u092b\u094d\u0930\u0940 \u0939\u0948\u0964",
    "\u0905\u092c \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u092c\u0938 10 \u092e\u093f\u0928\u091f, \u0914\u0930 \u0906\u092a \u0926\u0947\u0916\u0947\u0902\u0917\u0947 \u0915\u093f \u0906\u092a\u0915\u093e \u092a\u0947\u092a\u0930 \u0915\u093f\u0924\u0928\u093e \u0906\u0938\u093e\u0928 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 P.S.: \u0915\u0932 \u0930\u093e\u0924 3 \u092c\u091c\u0947 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0914\u0930 \u0905\u092a\u0921\u0947\u091f \u092a\u0941\u0936 \u0915\u093f\u092f\u093e\u2014\u091c\u094b \u0932\u094b\u0917 \u0907\u0938\u0947 \u0906\u091c \u0930\u093e\u0924 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0947\u0902\u0917\u0947, \u0909\u0928\u094d\u0939\u0947\u0902 \u0915\u0932 \u0938\u0941\u092c\u0939 \u0924\u0915 \u090f\u0915\u094d\u0938\u094d\u091f\u094d\u0930\u093e \u0938\u092a\u094b\u0930\u094d\u091f \u092e\u093f\u0932\u0947\u0917\u093e\u0964 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u094b\u0964"
  ],
