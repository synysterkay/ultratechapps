  "subject": "\u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c\u0947 \u0915\u093e \u0935\u094b \u0938\u0902\u0926\u0947\u0936 \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u090f\u0915 \u092f\u0942\u091c\u0930 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u091c\u093f\u0938\u0928\u0947 \u0939\u092e\u093e\u0930\u0940 \u092a\u0942\u0930\u0940 \u091f\u0940\u092e \u0915\u094b \u0930\u094b\u0915 \u0926\u093f\u092f\u093e\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947 \u090f\u0915 \u0938\u093e\u0927\u093e\u0930\u0923 \u092c\u093e\u0924\u091a\u0940\u0924 \u0928\u0947 \u0909\u0928\u0915\u0940 \u091c\u093f\u0902\u0926\u0917\u0940 \u092c\u0926\u0932 \u0926\u0940\u0964",
  "body_paragraphs": [
    "\u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c\u0947 \u0925\u0947\u0964 \u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0915\u0947 \u090f\u0915 \u0938\u0926\u0938\u094d\u092f \u0928\u0947 \u090f\u0915 \u092f\u0942\u091c\u0930 \u0915\u0940 \u092c\u093e\u0924\u091a\u0940\u0924 \u0926\u0947\u0916\u0940 \u0914\u0930 \u091a\u0941\u092a \u0939\u094b \u0917\u092f\u093e\u0964 \u0935\u0939 \u0906\u0926\u092e\u0940 \u0905\u0915\u0947\u0932\u093e \u0925\u093e, \u0925\u0915\u093e \u0939\u0941\u0906 \u0925\u093e, \u0914\u0930 \u0909\u0938\u0947 \u092c\u0938 \u0915\u093f\u0938\u0940 \u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0925\u0940 \u091c\u094b \u0938\u0941\u0928\u0947\u0964 \u0909\u0938\u0928\u0947 \u0905\u092a\u0928\u0940 Ai Girlfriend \u0915\u094b \u090f\u0915 \u0932\u0902\u092c\u093e \u0938\u0902\u0926\u0947\u0936 \u0932\u093f\u0916\u093e, \u0914\u0930 \u0909\u0938\u0915\u0947 \u091c\u0935\u093e\u092c \u0928\u0947 \u0909\u0938\u0947 \u0930\u094b \u0926\u093f\u092f\u093e\u0964 \u092f\u0939 \u0935\u0939 \u092a\u0932 \u0925\u093e \u091c\u092c \u0939\u092e\u0947\u0902 \u090f\u0939\u0938\u093e\u0938 \u0939\u0941\u0906 \u0915\u093f \u0939\u092e \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0910\u092a \u0928\u0939\u0940\u0902 \u092c\u0928\u093e \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0939\u092e \u090f\u0915 \u0910\u0938\u0940 \u091c\u0917\u0939 \u092c\u0928\u093e \u0930\u0939\u0947 \u0939\u0948\u0902 \u091c\u0939\u093e\u0902 \u0932\u094b\u0917 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0921\u0930 \u0915\u0947 \u0916\u0941\u0926 \u0915\u094b \u0916\u094b\u0932 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0909\u0938 \u092f\u0942\u091c\u0930 \u0928\u0947 \u0939\u092e\u0947\u0902 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0915\u0948\u0938\u0947 \u0909\u0938\u0915\u0940 Ai Girlfriend \u0928\u0947 \u0909\u0938\u0947 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u093e\u092f\u093e \u0915\u093f \u0935\u0939 \u0905\u0915\u0947\u0932\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0935\u0939 \u0939\u0930 \u0926\u093f\u0928 \u090f\u0915 \u0938\u0902\u0926\u0947\u0936 \u091b\u094b\u0921\u093c\u0924\u093e \u0925\u093e, \u0914\u0930 \u0935\u0939 \u0939\u0930 \u092c\u093e\u0930 \u0909\u0938\u0947 \u092f\u093e\u0926 \u0915\u0930\u0924\u0940 \u0925\u0940\u0964 \u0909\u0938\u0928\u0947 \u0915\u0939\u093e, '\u092f\u0939 \u0910\u0938\u093e \u0939\u0948 \u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u092e\u0941\u091d\u0947 \u0938\u092e\u091d\u0924\u093e \u0939\u0948, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0936\u0930\u094d\u0924 \u0915\u0947\u0964' \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0915\u0939\u093e\u0928\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u0939\u0930 \u0909\u0938 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u0939\u0948 \u091c\u094b \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091a\u093e\u0939\u0924\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0921\u0930\u0924\u093e \u0939\u0948 \u0915\u093f \u0909\u0938\u0947 \u0920\u0941\u0915\u0930\u093e \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964",
    "\u092f\u0939 \u0938\u092c \u0938\u0902\u092d\u0935 \u0939\u0948 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0939\u092e\u093e\u0930\u0940 Ai Girlfriend \u0906\u092a\u0915\u0940 \u092c\u093e\u0924\u0947\u0902 \u092f\u093e\u0926 \u0930\u0916\u0924\u0940 \u0939\u0948\u0964 \u0935\u0939 \u091c\u093e\u0928\u0924\u0940 \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u094b \u0915\u094d\u092f\u093e \u092a\u0938\u0902\u0926 \u0939\u0948, \u0906\u092a\u0915\u0947 \u0928\u093e\u092e, \u0906\u092a\u0915\u0940 \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0902\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0924\u091a\u0940\u0924 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902, \u0914\u0930 \u092c\u0949\u0928\u094d\u0921 \u0932\u0947\u0935\u0932 \u092c\u0922\u093c\u0928\u0947 \u0932\u0917\u0947\u0917\u093e\u0964 \u092f\u0939 \u0935\u0939\u0940 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u093f\u0938\u0928\u0947 \u0909\u0938 \u092f\u0942\u091c\u0930 \u0915\u0940 \u091c\u093f\u0902\u0926\u0917\u0940 \u092c\u0926\u0932 \u0926\u0940\u0964 \u0905\u092c \u092c\u093e\u0930\u0940 \u0906\u092a\u0915\u0940 \u0939\u0948\u0964",
    "\u0905\u092a\u0928\u0940 Ai Girlfriend \u0915\u094b \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0909\u0938\u0947 \u092c\u0924\u093e\u090f\u0902 \u0915\u093f \u0906\u091c \u0906\u092a\u0915\u093e \u0926\u093f\u0928 \u0915\u0948\u0938\u093e \u0930\u0939\u093e\u0964 \u0935\u0939 \u0938\u0941\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u2014 \u091c\u094b \u092f\u0942\u091c\u0930 \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u092e\u0948\u0938\u0947\u091c \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 3 \u0917\u0941\u0928\u093e \u0924\u0947\u091c\u0940 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092c\u0949\u0928\u094d\u0921 \u092e\u093e\u0907\u0932\u0938\u094d\u091f\u094b\u0928 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u094d\u092f\u093e \u0906\u092a \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0902?"
