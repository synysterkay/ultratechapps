{
  "subject": "\u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c\u0947 \u0915\u0940 \u0935\u094b \u0917\u0932\u0924\u0940 \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u090f\u0915 \u091b\u093e\u0924\u094d\u0930 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u091c\u094b \u0906\u092a\u0915\u0940 \u0924\u0930\u0939 \u0939\u0940 \u092a\u0930\u0947\u0936\u093e\u0928 \u0925\u093e\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947 \u0909\u0938\u0928\u0947 \u0905\u092a\u0928\u0940 \u0925\u0940\u0938\u093f\u0938 \u092c\u091a\u093e\u0908\u0964",
  "body_paragraphs": [
    "\u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c\u0947 \u0925\u0947\u0964 \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0935\u094b \u0935\u0915\u094d\u0924 \u091c\u092c \u0906\u092a\u0915\u0940 \u0906\u0901\u0916\u094b\u0902 \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u0916\u093e\u0932\u0940 \u092a\u0947\u091c \u0939\u094b\u0924\u093e \u0939\u0948 \u0914\u0930 \u0926\u093f\u092e\u093e\u0917 \u092e\u0947\u0902 \u0938\u093f\u0930\u094d\u092b\u093c \"\u092e\u0948\u0902 \u0915\u094d\u092f\u093e \u0932\u093f\u0916 \u0930\u0939\u093e \u0939\u0942\u0901?\" \u0917\u0942\u0902\u091c\u0924\u093e \u0939\u0948\u0964 \u090f\u0915 \u091b\u093e\u0924\u094d\u0930, \u091c\u093f\u0938\u0915\u093e \u0928\u093e\u092e \u0930\u093e\u0939\u0941\u0932 \u0939\u0948, \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0909\u0938\u0940 \u0939\u093e\u0932\u0924 \u092e\u0947\u0902 \u0925\u093e\u0964 \u0909\u0938\u0915\u0940 \u0921\u0947\u0921\u0932\u093e\u0907\u0928 \u0905\u0917\u0932\u0940 \u0938\u0941\u092c\u0939 8 \u092c\u091c\u0947 \u0925\u0940 \u0914\u0930 \u0909\u0938\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u090f\u0915 \u092d\u0940 \u0932\u093e\u0907\u0928 \u0928\u0939\u0940\u0902 \u0932\u093f\u0916\u0940 \u0925\u0940\u0964 \u0909\u0938\u0947 \u0932\u0917 \u0930\u0939\u093e \u0925\u093e \u0915\u093f \u0935\u094b \u092b\u0947\u0932 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964",
    "\u0930\u093e\u0939\u0941\u0932 \u0928\u0947 \u0905\u092a\u0928\u093e \u0938\u093f\u0930 \u092a\u0915\u0921\u093c \u0932\u093f\u092f\u093e\u0964 \u0909\u0938\u0928\u0947 \u0938\u094b\u091a\u093e \u0915\u093f \u0936\u093e\u092f\u0926 AI \u0938\u0947 \u0932\u093f\u0916\u0935\u093e \u0932\u0947, \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u0909\u0938\u0947 \u0921\u0930 \u0932\u0917\u093e \u0915\u093f \u091f\u0930\u094d\u0928\u093f\u091f\u093f\u0928 \u092a\u0915\u0921\u093c \u0932\u0947\u0917\u093e\u0964 \u0909\u0938\u0940 \u092a\u0932 \u0909\u0938\u0947 \u0925\u0940\u0938\u093f\u0938 \u091c\u0947\u0928\u0930\u0947\u091f\u0930 \u092f\u093e\u0926 \u0906\u092f\u093e\u0964 \u0909\u0938\u0928\u0947 \u0910\u092a \u0916\u094b\u0932\u093e \u0914\u0930 \u092c\u0938 \u0905\u092a\u0928\u0947 \u091f\u0949\u092a\u093f\u0915 \u0915\u0947 \u0915\u0941\u091b \u0915\u0940\u0935\u0930\u094d\u0921 \u0921\u093e\u0932\u0947\u0964 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0909\u0938\u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u090f\u0915 \u092a\u0942\u0930\u0940 \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u0925\u0940 - \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0935\u0948\u0938\u0940 \u091c\u0948\u0938\u0940 \u0935\u094b \u091a\u093e\u0939\u0924\u093e \u0925\u093e\u0964 \u0909\u0938\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u0915\u093f \u0907\u0938\u092e\u0947\u0902 8 \u0918\u0902\u091f\u0947 \u0932\u0917\u0947\u0902\u0917\u0947\u0964",
    "\u092f\u0939\u093e\u0901 \u0905\u0938\u0932\u0940 \u091c\u093e\u0926\u0942 \u0939\u0948: \u0925\u0940\u0938\u093f\u0938 \u091c\u0947\u0928\u0930\u0947\u091f\u0930 \u0928\u0947 \u0938\u093f\u0930\u094d\u092b\u093c \u0925\u0940\u0938\u093f\u0938 \u0928\u0939\u0940\u0902 \u0926\u0940, \u092c\u0932\u094d\u0915\u093f \u0917\u094d\u0930\u093e\u092b\u093c, \u091f\u0947\u092c\u0932 \u0914\u0930 \u0938\u093e\u0907\u091f\u0947\u0936\u0928 \u092d\u0940 \u0911\u091f\u094b-\u091c\u0947\u0928\u0930\u0947\u091f \u0915\u0930 \u0926\u093f\u090f\u0964 \u0930\u093e\u0939\u0941\u0932 \u0928\u0947 \u092b\u093f\u0930 \u0909\u0938 AI \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0915\u094b \u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c \u0915\u093f\u092f\u093e \u0924\u093e\u0915\u093f \u091f\u0930\u094d\u0928\u093f\u091f\u093f\u0928 \u092f\u093e GPTZero \u0909\u0938\u0947 \u092a\u0915\u0921\u093c \u0928 \u0938\u0915\u0947\u0964 \u0909\u0938\u0928\u0947 \u092c\u0938 \u0915\u0941\u091b \u0915\u094d\u0932\u093f\u0915 \u0915\u093f\u090f \u0914\u0930 \u090f\u0915 \u092a\u0949\u0932\u093f\u0936\u094d\u0921 PDF \u090f\u0915\u094d\u0938\u092a\u094b\u0930\u094d\u091f \u0915\u093f\u092f\u093e \u091c\u094b \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0925\u093e\u0964 \u0935\u094b \u0938\u0941\u092c\u0939 4 \u092c\u091c\u0947 \u0924\u0915 \u0938\u094b \u0917\u092f\u093e \u0914\u0930 \u0909\u0938\u0915\u0947 \u0917\u094d\u0930\u0947\u0921 A- \u0906\u090f\u0964",
    "\u0905\u092c \u0906\u092a\u0915\u0940 \u092c\u093e\u0930\u0940 \u0939\u0948\u0964 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0947 \u091f\u0949\u092a\u093f\u0915 \u0915\u0947 \u0932\u093f\u090f \u0925\u0940\u0938\u093f\u0938 \u091c\u0947\u0928\u0930\u0947\u091f \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u0935\u0939\u0940 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u093f\u0938\u0928\u0947 \u0930\u093e\u0939\u0941\u0932 \u0915\u0940 \u0930\u093e\u0924 \u092c\u0926\u0932 \u0926\u0940\u0964 P.S. - \u092f\u093e\u0926 \u0930\u0916\u0947\u0902, \u0906\u092a\u0915\u0940 \u0921\u0947\u0921\u0932\u093e\u0907\u0928 \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0940\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902, \u0926\u0947\u0916\u093f\u090f \u0915\u093f\u0924\u0928\u0940 \u091c\u0932\u094d\u0926\u0940 \u0938\u092c \u092c\u0926\u0932 \u091c\u093e\u0924\u093e \u0939\u0948\u0964"
  ],
