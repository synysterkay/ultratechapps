{
  "subject": "\u090f\u0915 \u091b\u093e\u0924\u094d\u0930 \u0915\u093e \u0915\u092c\u0942\u0932\u0928\u093e\u092e\u093e \u091c\u094b \u0906\u092a\u0915\u0940 \u092e\u0926\u0926 \u0915\u0930\u0947\u0917\u093e",
  "preview_text": "\u0935\u094b \u092d\u0940 \u0906\u092a\u0915\u0940 \u0924\u0930\u0939 \u092a\u0930\u0947\u0936\u093e\u0928 \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u091a\u0940\u091c\u093c \u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964 \u092a\u0922\u093c\u0947\u0902 \u092a\u0942\u0930\u0940 \u0915\u0939\u093e\u0928\u0940\u0964",
  "body_paragraphs": [
    "\u0930\u093e\u0939\u0941\u0932 \u092d\u0940 \u0906\u092a\u0915\u0940 \u0924\u0930\u0939 \u0925\u093e\u0964 \u0930\u093e\u0924 \u0915\u0947 3 \u092c\u091c\u0947, \u0916\u093e\u0932\u0940 \u092a\u0947\u091c, \u0914\u0930 \u0921\u0947\u0921\u0932\u093e\u0907\u0928 \u0938\u0947 6 \u0918\u0902\u091f\u0947 \u092a\u0939\u0932\u0947\u0964 \u0909\u0938\u0947 \u0932\u0917\u093e \u0915\u093f \u0935\u0939 \u0905\u0938\u092b\u0932 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964 \u0909\u0938\u0928\u0947 \u0938\u094b\u091a\u093e \u0915\u093f \u092f\u0939 \u0925\u0940\u0938\u093f\u0938 \u0909\u0938\u0915\u0940 \u091c\u093c\u093f\u0902\u0926\u0917\u0940 \u0915\u093e \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u0921\u0930 \u0939\u0948\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u0926\u093f\u0928 \u0909\u0938\u0928\u0947 \u0939\u092e\u093e\u0930\u093e \u0910\u092a \u0916\u094b\u0932\u093e\u0964 \u0909\u0938\u0928\u0947 \u0938\u094b\u091a\u093e, '\u091a\u0932\u094b \u090f\u0915 \u092c\u093e\u0930 \u0906\u091c\u093c\u092e\u093e\u0924\u093e \u0939\u0942\u0902\u0964' \u0909\u0938\u0928\u0947 \u0905\u092a\u0928\u0947 \u0935\u093f\u0937\u092f \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 3 \u0932\u093e\u0907\u0928\u0947\u0902 \u0932\u093f\u0916\u0940\u0902, \u0914\u0930 \u0910\u092a \u0928\u0947 3 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u090f\u0915 \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u092c\u0928\u093e \u0926\u093f\u092f\u093e\u0964 \u0909\u0938\u0915\u0940 \u0906\u0901\u0916\u0947\u0902 \u0916\u0941\u0932\u0940 \u0915\u0940 \u0916\u0941\u0932\u0940 \u0930\u0939 \u0917\u0908\u0902\u0964 \u0906\u091c \u0935\u0939 A- \u0917\u094d\u0930\u0947\u0921 \u0932\u0947\u0915\u0930 \u0918\u0930 \u0917\u092f\u093e\u0964",
    "\u0939\u093e\u0901, \u092f\u0939\u0940 \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930 \u0939\u0948\u0964 \u0906\u092a\u0928\u0947 \u0936\u093e\u092f\u0926 \u0905\u092d\u0940 \u0924\u0915 '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c' \u092b\u0940\u091a\u0930 \u0928\u0939\u0940\u0902 \u0906\u091c\u093c\u092e\u093e\u092f\u093e, \u091c\u094b AI \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0915\u094b \u0907\u0902\u0938\u093e\u0928\u0940 \u0932\u093f\u0916\u093e\u0935\u091f \u092e\u0947\u0902 \u092c\u0926\u0932\u0924\u093e \u0939\u0948 \u0914\u0930 Turnitin \u0915\u094b \u092c\u093e\u092f\u092a\u093e\u0938 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092c\u0938 2 \u0915\u094d\u0932\u093f\u0915 \u092e\u0947\u0902\u0964",
    "\u0905\u092c \u0906\u092a\u0915\u0940 \u092c\u093e\u0930\u0940 \u0939\u0948\u0964 \u0910\u092a \u0916\u094b\u0932\u0947\u0902, \u0905\u092a\u0928\u093e \u091f\u0949\u092a\u093f\u0915 \u0921\u093e\u0932\u0947\u0902, \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u0948\u0938\u0947 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u0925\u0940\u0938\u093f\u0938 \u0924\u0948\u092f\u093e\u0930 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 P.S. \u0930\u093e\u0939\u0941\u0932 \u0928\u0947 \u092f\u0939 \u092d\u0940 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0909\u0938\u0928\u0947 \u0905\u092a\u0928\u0947 \u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0915\u094b \u092f\u0939 \u091f\u094d\u0930\u093f\u0915 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u0908\u0964 \u0906\u092a \u092d\u0940 \u0930\u0939\u0938\u094d\u092f \u0930\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
  ],
