{
  "subject": "\u041f\u0438\u0441\u044c\u043c\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u044f \u043d\u0435 \u0445\u043e\u0442\u0435\u043b \u043f\u0438\u0441\u0430\u0442\u044c",
  "preview_text": "\u042f \u043e\u0431\u044b\u0447\u043d\u043e \u043d\u0435 \u043f\u0438\u0448\u0443 \u0442\u0430\u043a\u043e\u0435. \u041d\u043e \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u2014 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435. \u041f\u0440\u043e\u0447\u0438\u0442\u0430\u0439, \u044d\u0442\u043e \u0432\u0430\u0436\u043d\u043e.",
  "body_paragraphs": [
    "\u042f \u043e\u0431\u044b\u0447\u043d\u043e \u043d\u0435 \u043f\u0438\u0448\u0443 \u0442\u0430\u043a\u0438\u0435 \u043f\u0438\u0441\u044c\u043c\u0430. \u0421\u0435\u0440\u044c\u0451\u0437\u043d\u043e. \u0417\u0430 39 \u0434\u043d\u0435\u0439 \u044f \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b 17 \u0448\u0442\u0443\u043a, \u0438 \u043d\u0438 \u043e\u0434\u043d\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043b\u0438\u0447\u043d\u044b\u043c. \u041d\u043e \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u044f \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u044f\u0434\u0443 \u0438 \u0441\u043a\u0430\u0436\u0443 \u0442\u0435\u0431\u0435 \u043f\u0440\u0430\u0432\u0434\u0443: \u044f \u0441\u043e\u0437\u0434\u0430\u043b Bass Booster \u043d\u0435 \u0434\u043b\u044f \u0434\u0435\u043d\u0435\u0433. \u042f \u0441\u043e\u0437\u0434\u0430\u043b \u0435\u0433\u043e \u043f\u043e\u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u043d\u0435\u043d\u0430\u0432\u0438\u0434\u0435\u043b \u0441\u043b\u0443\u0448\u0430\u0442\u044c \u043c\u0443\u0437\u044b\u043a\u0443 \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0435. \u041f\u043b\u043e\u0441\u043a\u0438\u0439 \u0437\u0432\u0443\u043a, \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0431\u0430\u0441\u0430 \u2014 \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u043e\u043b\u044c. \u0418 \u044f \u0437\u043d\u0430\u044e, \u0442\u044b \u0442\u043e\u0436\u0435 \u044d\u0442\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044c.",
    "\u041a\u043e\u0433\u0434\u0430 \u044f \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u043b \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0443 \u043c\u0435\u043d\u044f \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0438 \u043e\u0434\u043d\u043e\u0439 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438. \u042f \u0441\u0438\u0434\u0435\u043b \u043d\u043e\u0447\u044c\u044e, \u0441\u043b\u0443\u0448\u0430\u043b \u0442\u0440\u0435\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u043b \u0440\u0430\u0437\u0440\u044b\u0432\u0430\u0442\u044c \u043a\u043e\u043b\u043e\u043d\u043a\u0438, \u0430 \u0432 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u0445 \u2014 \u0442\u0438\u0448\u0438\u043d\u0430. \u0422\u043e\u0433\u0434\u0430 \u044f \u043f\u043e\u043d\u044f\u043b: \u043b\u0438\u0431\u043e \u044f \u0434\u0435\u043b\u0430\u044e \u0447\u0442\u043e-\u0442\u043e, \u0447\u0442\u043e \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u0442 \u0437\u0432\u0443\u043a, \u043b\u0438\u0431\u043e \u0431\u0440\u043e\u0441\u0430\u044e. \u042f \u0432\u044b\u0431\u0440\u0430\u043b \u043f\u0435\u0440\u0432\u043e\u0435. \u0418 \u0441\u0435\u0433\u043e\u0434\u043d\u044f, \u043a\u043e\u0433\u0434\u0430 9 \u0442\u044b\u0441\u044f\u0447 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u043a\u0430\u0447\u0430\u044e\u0442 \u0431\u0430\u0441, \u044f \u0437\u043d\u0430\u044e \u2014 \u044d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442.",
    "\u0412\u043e\u0442 \u0447\u0442\u043e \u044f \u0445\u043e\u0447\u0443, \u0447\u0442\u043e\u0431\u044b \u0442\u044b \u0441\u0434\u0435\u043b\u0430\u043b \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041e\u0442\u043a\u0440\u043e\u0439 Bass Booster \u0438 \u043d\u0430\u0436\u043c\u0438 \u043d\u0430 \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a Boost. \u041f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0442\u044f\u043d\u0438 \u0435\u0433\u043e \u0432\u0432\u0435\u0440\u0445 \u0434\u043e \u0443\u043f\u043e\u0440\u0430. \u041d\u0435 \u0431\u043e\u0439\u0441\u044f \u2014 \u044d\u0442\u043e \u043d\u0435 \u0441\u043b\u043e\u043c\u0430\u0435\u0442 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438. \u0422\u044b \u0443\u0441\u043b\u044b\u0448\u0438\u0448\u044c, \u043a\u0430\u043a Hip-Hop \u0438\u043b\u0438 EDM \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442 \u0434\u044b\u0448\u0430\u0442\u044c. \u0414\u0430\u0436\u0435 \u043d\u0430 \u0434\u0435\u0448\u0451\u0432\u044b\u0445 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u0445. \u042f \u043e\u0431\u0435\u0449\u0430\u044e.",
    "\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u044d\u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u0441\u0434\u0435\u043b\u0430\u0439 \u0433\u0440\u043e\u043c\u0447\u0435. \u041f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. P.S. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u043f\u043e\u043b\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u2014 \u0432\u043a\u043b\u044e\u0447\u0438 \u043f\u0440\u0435\u043c\u0438\u0443\u043c \u043d\u0430 \u0434\u0435\u043d\u044c. \u0411\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e. \u0423\u0432\u0438\u0434\u0438\u0448\u044c, \u043a\u0430\u043a 10-\u043f\u043e\u043b\u043e\u0441\u043d\u044b\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u043c\u0435\u043d\u044f\u0435\u0442 \u0432\u0441\u0451."
  ],
