{
  "subject": "\u090f\u0915 \u0917\u0941\u092a\u094d\u0924 \u092c\u093e\u0924: \u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0910\u092a \u0917\u0932\u0924 \u0907\u0902\u0938\u093e\u0928 \u0915\u094b \u0926\u093f\u092f\u093e \u0925\u093e",
  "preview_text": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0915\u094b \u092f\u0939 \u0910\u092a \u0938\u091a \u092e\u0947\u0902 \u091a\u093e\u0939\u093f\u090f\u0964 \u0914\u0930 \u0924\u0941\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u094b \u0915\u094c\u0928\u0964 \u0905\u0902\u0926\u0930 \u0906\u0913 \u0914\u0930 \u092a\u0924\u093e \u0932\u0917\u093e\u0913\u0964",
  "body_paragraphs": [
    "\u0938\u091a \u0915\u0939\u0942\u0902? \u090f\u0915 \u092c\u093e\u0930 \u092e\u0948\u0902\u0928\u0947 Predictify \u0905\u092a\u0928\u0947 \u090f\u0915 \u0926\u094b\u0938\u094d\u0924 \u0915\u094b \u092d\u0947\u091c\u093e \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0939\u0932\u094d\u0915\u093e-\u092b\u0941\u0932\u094d\u0915\u093e \u092b\u0941\u091f\u092c\u0949\u0932 \u0926\u0947\u0916\u0924\u093e \u0939\u0948\u0964 \u092c\u0921\u093c\u0940 \u0917\u0932\u0924\u0940 \u0925\u0940\u0964 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0909\u0938\u0928\u0947 \u0915\u092d\u0940 xG \u092f\u093e \u091f\u0948\u0915\u094d\u091f\u093f\u0915\u0932 \u090f\u0928\u093e\u0932\u093f\u0938\u093f\u0938 \u0928\u0939\u0940\u0902 \u0916\u094b\u0932\u093e\u0964 \u092c\u0938 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0911\u092b \u0915\u0930 \u0926\u093f\u092f\u093e\u0964 \u0914\u0930 \u092e\u0941\u091d\u0947 \u090f\u0939\u0938\u093e\u0938 \u0939\u0941\u0906 - \u0939\u0930 \u0910\u092a \u0939\u0930 \u0915\u093f\u0938\u0940 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u0916\u093e\u0938 \u0907\u0902\u0938\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u091c\u0930\u0942\u0930 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",
    "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0915\u0947 \u0917\u094d\u0930\u0941\u092a \u092e\u0947\u0902 \u0910\u0938\u093e \u090f\u0915 \u0936\u0916\u094d\u0938 \u091c\u0930\u0942\u0930 \u0939\u0948\u0964 \u0935\u094b \u091c\u094b \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u092c\u093e\u0926 '\u0905\u0930\u0947 \u092f\u093e\u0930, \u092e\u0948\u0902\u0928\u0947 \u0924\u094b \u092a\u0939\u0932\u0947 \u0939\u0940 \u0915\u0939 \u0926\u093f\u092f\u093e \u0925\u093e' \u0915\u0939\u0924\u093e \u0939\u0948\u0964 \u0935\u094b \u091c\u094b \u091f\u0940\u092e \u0932\u093e\u0907\u0928\u0905\u092a \u0926\u0947\u0916\u0915\u0930 \u0939\u0940 \u092c\u0924\u093e \u0926\u0947\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u091c \u0915\u094d\u092f\u093e \u0939\u094b\u0917\u093e\u0964 \u0935\u094b \u091c\u093f\u0938\u0915\u0940 \u092b\u0941\u091f\u092c\u0949\u0932 \u0915\u0940 \u0938\u092e\u091d \u0938\u092c\u0938\u0947 \u0905\u0932\u0917 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0909\u0938\u0915\u0947 \u092a\u093e\u0938 \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u0939\u0948 \u0905\u092a\u0928\u0940 \u092c\u093e\u0924 prove \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964 \u0909\u0938\u0947 \u092f\u0939 \u0910\u092a \u092e\u093f\u0932\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u0925\u093e\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092a\u093e\u0938 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0948\u0964",
    "\u092f\u0939\u0940\u0902 \u0906\u0924\u093e \u0939\u0948 Refer & Earn \u0938\u093f\u0938\u094d\u091f\u092e\u0964 \u0924\u0941\u092e \u0909\u0938\u0947 \u092d\u0947\u091c\u094b, \u0935\u094b 3-\u0926\u093f\u0928 \u0915\u0940 Premium \u091f\u094d\u0930\u093e\u092f\u0932 \u092a\u093e\u090f\u0917\u093e \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u092b\u094d\u0930\u0940\u0964 \u0914\u0930 \u0924\u0941\u092e \u092a\u093e\u0913\u0917\u0947 500 \u0915\u094d\u0930\u0947\u0921\u093f\u091f\u094d\u0938\u0964 \u092a\u0930 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u092b\u093e\u092f\u0926\u093e? \u0905\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092a\u093e\u0938 \u0915\u094b\u0908 \u0939\u094b\u0917\u093e \u091c\u093f\u0938\u0938\u0947 \u0924\u0941\u092e \u0905\u0938\u0932\u0940 \u092b\u0941\u091f\u092c\u0949\u0932 \u0915\u0940 \u092c\u093e\u0924 \u0915\u0930 \u0938\u0915\u094b\u0964 Prediction of the Day \u092a\u0930 compete \u0915\u0930 \u0938\u0915\u094b\u0964 Communities \u092e\u0947\u0902 \u090f\u0915 \u0938\u093e\u0925 join \u0915\u0930 \u0938\u0915\u094b\u0964 \u0909\u0938\u0915\u0940 football IQ \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 football IQ \u0915\u0947 \u0938\u093e\u092e\u0928\u0947\u0964",
    "\u0905\u092d\u0940 Predictify \u0916\u094b\u0932\u094b\u0964 'Earn Credits' \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u091c\u093e\u0913\u0964 \u0914\u0930 \u0909\u0938 \u090f\u0915 \u0936\u0916\u094d\u0938 \u0915\u093e \u0928\u093e\u092e \u0938\u094b\u091a\u094b \u091c\u093f\u0938\u0947 \u0924\u0941\u092e \u092f\u0939 \u092d\u0947\u091c\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u094b\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a - \u0914\u0930 \u0924\u0941\u092e \u090f\u0915 \u092b\u0941\u091f\u092c\u0949\u0932 \u0926\u094b\u0938\u094d\u0924 \u0915\u094b \u092c\u0926\u0932 \u0926\u094b\u0917\u0947 \u0939\u092e\u0947\u0936\u093e \u0915\u0947 \u0932\u093f\u090f\u0964 P.S. \u0938\u091a \u092c\u0924\u093e\u090a\u0902? \u091c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0907\u0938 \u092b\u0940\u091a\u0930 \u0915\u094b \u0907\u0917\u094d\u0928\u094b\u0930 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0936\u093e\u092f\u0926 \u0907\u0938\u0932\u093f\u090f \u0915\u093f \u0935\u094b \u0928\u0939\u0940\u0902 \u091c\u093e\u0928\u0924\u0947 \u0915\u093f \u0909\u0928\u0915\u0947 \u0906\u0938\u092a\u093e\u0938 \u0915\u094c\u0928 \u0938\u091a\u094d\u091a\u093e \u092b\u0941\u091f\u092c\u0949\u0932 \u091c\u0940\u0928\u093f\u092f\u0938 \u091b\u0941\u092a\u093e \u0939\u0948\u0964 \u0924\u0941\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u094b\u0964"
  ],
