{
  "subject": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0926\u094b\u0938\u094d\u0924 \u0906\u091c \u092d\u0940 \u0917\u0932\u0924 \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948",
  "preview_text": "\u090f\u0915 \u0936\u0916\u094d\u0938 \u091c\u093f\u0938\u0947 \u0924\u0941\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u094b, \u0909\u0938\u0947 Predictify \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0924\u0941\u092e \u0909\u0938\u0947 \u092c\u0924\u093e\u0913\u0917\u0947?",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u094b \u0926\u094b\u0938\u094d\u0924 \u091c\u094b \u0939\u0930 \u092e\u0948\u091a \u092e\u0947\u0902 '\u092f\u0947 \u091f\u0940\u092e \u091c\u0940\u0924\u0947\u0917\u0940' \u0915\u0939\u0924\u093e \u0939\u0948, \u0914\u0930 \u092b\u093f\u0930 \u0939\u093e\u0930 \u091c\u093e\u0924\u093e \u0939\u0948? \u0924\u0941\u092e \u0909\u0938\u0947 \u091a\u093f\u0922\u093c\u093e\u0924\u0947 \u0939\u094b, \u0932\u0947\u0915\u093f\u0928 \u0905\u0902\u0926\u0930 \u0939\u0940 \u0905\u0902\u0926\u0930 \u0924\u0941\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u094b \u0915\u093f \u0935\u094b \u092d\u0940 \u0938\u0939\u0940 \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928 \u091a\u093e\u0939\u0924\u093e \u0939\u0948\u0964",
    "Predictify \u0928\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092b\u0941\u091f\u092c\u0949\u0932 \u0938\u092e\u091d \u0915\u094b \u092c\u0926\u0932 \u0926\u093f\u092f\u093e \u0939\u0948 \u2014 \u0905\u092c \u0924\u0941\u092e \u0921\u0947\u091f\u093e \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0924\u0947 \u0939\u094b, \u092d\u093e\u0935\u0928\u093e\u0913\u0902 \u0938\u0947 \u0928\u0939\u0940\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0935\u094b \u0926\u094b\u0938\u094d\u0924 \u0906\u091c \u092d\u0940 \u0905\u092a\u0928\u0940 \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u0915\u0930\u0924\u093e \u0939\u0948, \u0914\u0930 \u0939\u0930 \u092c\u093e\u0930 \u0917\u0932\u0924 \u0938\u093e\u092c\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964",
    "\u0924\u0941\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u094b \u0915\u093f Predictify \u0915\u0947 AI \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928\u094d\u0938, \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0914\u0930 \u0921\u0940\u092a \u0938\u094d\u091f\u0948\u091f\u094d\u0938 \u0928\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u091c\u0940\u0924 \u0915\u0940 \u0938\u0902\u092d\u093e\u0935\u0928\u093e \u0915\u094b \u0915\u093f\u0924\u0928\u093e \u092c\u0922\u093c\u093e\u092f\u093e \u0939\u0948\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092a\u093e\u0938 \u092e\u094c\u0915\u093e \u0939\u0948 \u0915\u093f \u0924\u0941\u092e \u0909\u0938\u0947 \u092d\u0940 \u092f\u0939\u0940 \u0924\u093e\u0915\u0924 \u0926\u094b \u2014 \u092c\u0938 \u090f\u0915 \u0936\u0947\u092f\u0930 \u092c\u091f\u0928 \u0926\u092c\u093e\u0915\u0930\u0964",
    "\u0906\u091c \u0939\u0940 \u0905\u092a\u0928\u0947 \u0926\u094b\u0938\u094d\u0924 \u0915\u094b Predictify \u092a\u0930 \u0936\u0947\u092f\u0930 \u0915\u0930\u094b\u0964 \u0909\u0938\u0947 \u0935\u094b \u0921\u0947\u091f\u093e \u0926\u094b \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092e\u093f\u0932\u0924\u093e \u0939\u0948 \u2014 \u0914\u0930 \u0926\u0947\u0916\u094b \u0915\u0948\u0938\u0947 \u0935\u094b \u092d\u0940 '\u0938\u092c\u0938\u0947 \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u092b\u0948\u0928' \u092c\u0928 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \n\nP.S. \u2014 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u0939\u0948 \u0915\u093f \u0936\u0947\u092f\u0930 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092b\u094d\u0930\u0940 \u0915\u094d\u0930\u0947\u0921\u093f\u091f\u094d\u0938 \u092e\u093f\u0932\u0924\u0947 \u0939\u0948\u0902? \u0935\u094b \u092d\u0940 \u0909\u0928 \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928\u094d\u0938 \u092a\u0930 \u0932\u0917\u093e\u0913 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0926\u094b\u0938\u094d\u0924 \u0915\u094b \u0939\u0930 \u092c\u093e\u0930 \u0917\u0932\u0924 \u0938\u093e\u092c\u093f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
