{
  "subject": "\u090f\u0915 \u091b\u093e\u0924\u094d\u0930 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u091c\u093f\u0938\u0928\u0947 \u0939\u092e\u093e\u0930\u0940 \u092a\u0942\u0930\u0940 \u091f\u0940\u092e \u0915\u094b \u0930\u094b\u0915 \u0926\u093f\u092f\u093e",
  "preview_text": "\u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947 \u090f\u0915 \u092f\u0942\u091c\u093c\u0930 \u0928\u0947 \u0907\u0938 \u0910\u092a \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u0940 \u091c\u093c\u093f\u0902\u0926\u0917\u0940 \u092c\u0926\u0932 \u0926\u0940, \u0914\u0930 \u0915\u0948\u0938\u0947 \u0906\u092a \u092d\u0940 \u0910\u0938\u093e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",
  "body_paragraphs": [
    "\u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0939\u0930 \u0926\u093f\u0928 \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u0908\u092e\u0947\u0932 \u092a\u0922\u093c\u0924\u0940 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0915\u0932 \u090f\u0915 \u0908\u092e\u0947\u0932 \u0928\u0947 \u0939\u092e \u0938\u092c\u0915\u094b \u0930\u094b\u0915 \u0926\u093f\u092f\u093e\u0964 \u090f\u0915 \u091b\u093e\u0924\u094d\u0930 \u0928\u0947 \u0932\u093f\u0916\u093e, '\u0907\u0938 \u0910\u092a \u0928\u0947 \u092e\u0947\u0930\u093e GPA B+ \u0938\u0947 A- \u0915\u0930 \u0926\u093f\u092f\u093e, \u0914\u0930 \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0940 \u092a\u0939\u0932\u0940 \u0925\u0940\u0938\u093f\u0938 \u091a\u093e\u0930 \u0918\u0902\u091f\u0947 \u092e\u0947\u0902 \u092a\u0942\u0930\u0940 \u0915\u0940\u0964' \u0935\u0939 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0932\u093f\u0916 \u0930\u0939\u093e \u0925\u093e, \u091c\u092c \u0909\u0938\u0915\u093e \u0926\u093f\u092e\u093e\u0917 \u0916\u093e\u0932\u0940 \u0925\u093e \u0914\u0930 \u0921\u0947\u0921\u0932\u093e\u0907\u0928 \u0938\u0941\u092c\u0939 8 \u092c\u091c\u0947 \u0925\u0940\u0964 \u0909\u0938\u0928\u0947 \u0925\u0940\u0938\u093f\u0938 \u091c\u0947\u0928\u0930\u0947\u091f\u0930 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e, \u0914\u0930 \u0909\u0938\u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u0928\u0947 \u0939\u092e\u0947\u0902 \u092f\u093e\u0926 \u0926\u093f\u0932\u093e\u092f\u093e \u0915\u093f \u0939\u092e \u092f\u0939\u093e\u0901 \u0915\u094d\u092f\u094b\u0902 \u0939\u0948\u0902\u0964",
    "\u092f\u0939 \u0906\u092a\u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964 \u0936\u094b\u0927 \u092a\u0924\u094d\u0930 \u0932\u093f\u0916\u0928\u093e \u0905\u0915\u0947\u0932\u0947 \u0932\u0921\u093c\u093e\u0908 \u0928\u0939\u0940\u0902 \u0939\u0948\u2014\u0939\u092e\u093e\u0930\u093e \u0910\u092a \u0906\u092a\u0915\u093e \u0938\u0939\u093e\u092f\u0915 \u0939\u0948\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b\u093c 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u092c\u0928\u093e\u0924\u093e \u0939\u0948, \u0914\u0930 AI \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0915\u094b \u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c \u0915\u0930\u0915\u0947 Turnitin \u0938\u0947 \u092c\u091a\u093e\u0924\u093e \u0939\u0948\u0964 \u0915\u0932\u094d\u092a\u0928\u093e \u0915\u0930\u0947\u0902: \u0906\u092a\u0915\u0940 \u091a\u093f\u0902\u0924\u093e \u0915\u092e \u0939\u094b, \u0906\u092a\u0915\u093e \u0917\u094d\u0930\u0947\u0921 \u0938\u0941\u0927\u0930\u0947, \u0914\u0930 \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0947 \u0915\u093e\u092e \u092a\u0930 \u0917\u0930\u094d\u0935 \u0939\u094b\u0964 \u092f\u0939\u0940 \u0935\u0939 \u092c\u0926\u0932\u093e\u0935 \u0939\u0948 \u091c\u094b \u0939\u092e \u0932\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0907\u0938 \u092f\u0942\u091c\u093c\u0930 \u0928\u0947 \u0916\u093e\u0938\u0924\u094c\u0930 \u092a\u0930 '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c AI \u091f\u0947\u0915\u094d\u0938\u094d\u091f' \u092b\u0940\u091a\u0930 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e, \u091c\u094b \u0906\u092a\u0915\u0947 \u0915\u0902\u091f\u0947\u0902\u091f \u0915\u094b \u0907\u0924\u0928\u093e \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u092c\u0928\u093e\u0924\u093e \u0939\u0948 \u0915\u093f GPTZero \u092d\u0940 \u092a\u0915\u0921\u093c \u0928 \u0938\u0915\u0947\u0964 \u0938\u093e\u0925 \u0939\u0940, \u0909\u0938\u0928\u0947 APA \u092b\u093c\u0949\u0930\u094d\u092e\u0947\u091f \u092e\u0947\u0902 \u0938\u093f\u091f\u0947\u0936\u0928 \u0914\u0930 \u090f\u0915 \u092a\u094b\u0932\u093f\u0936\u094d\u0921 PDF \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u093f\u092f\u093e, \u091c\u093f\u0938\u0947 \u0909\u0938\u0928\u0947 \u0938\u0940\u0927\u0947 \u0938\u092c\u092e\u093f\u091f \u0915\u0930 \u0926\u093f\u092f\u093e\u0964 \u0909\u0938\u0915\u093e \u0915\u0939\u0928\u093e \u0925\u093e, '\u092f\u0939 \u092e\u0947\u0930\u093e \u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0935\u0947\u092a\u0928 \u0939\u0948\u0964'",
    "\u0905\u092c \u0906\u092a\u0915\u0940 \u092c\u093e\u0930\u0940 \u0939\u0948\u0964 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c AI \u091f\u0947\u0915\u094d\u0938\u094d\u091f' \u092b\u0940\u091a\u0930 \u0915\u094b \u0906\u091c\u093c\u092e\u093e\u090f\u0901\u2014\u092c\u0938 \u090f\u0915 \u092c\u093e\u0930\u0964 \u0905\u092a\u0928\u0940 \u0905\u0917\u0932\u0940 \u0925\u0940\u0938\u093f\u0938 \u092e\u0947\u0902 \u0907\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902, \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964 P.S. \u092f\u0939 \u092b\u0940\u091a\u0930 \u0938\u093f\u0930\u094d\u092b\u093c 50,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0928\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e \u0939\u0948\u2014\u0915\u094d\u092f\u093e \u0906\u092a \u092a\u0940\u091b\u0947 \u0930\u0939\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?"
  ],
