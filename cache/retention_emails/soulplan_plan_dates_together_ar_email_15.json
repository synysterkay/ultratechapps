{
  "subject": "\u0627\u0644\u0633\u0627\u0639\u0629 2 \u0635\u0628\u0627\u062d\u064b\u0627 \u0627\u0644\u062a\u064a \u063a\u064a\u0631\u062a \u0643\u0644 \u0634\u064a\u0621",
  "preview_text": "\u0643\u064a\u0641 \u062a\u0648\u0641\u0631 20 \u062f\u0642\u064a\u0642\u0629 \u0645\u0646 \u0627\u0644\u062a\u062e\u0637\u064a\u0637 \u0641\u064a \u062b\u0627\u0646\u064a\u062a\u064a\u0646 \u0641\u0642\u0637 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642",
  "body_paragraphs": [
    "\u0641\u064a \u0627\u0644\u0633\u0627\u0639\u0629 2 \u0635\u0628\u0627\u062d\u064b\u0627\u060c \u0643\u0646\u062a \u0623\u0646\u0627 \u0648\u0634\u0631\u064a\u0643\u062a\u064a \u0646\u062a\u0635\u0641\u062d \u0627\u0644\u0647\u0648\u0627\u062a\u0641 \u0628\u0645\u0644\u0644. \u0642\u0644\u062a: \"\u0644\u0646\u0628\u062d\u062b \u0639\u0646 \u0641\u0643\u0631\u0629 \u0645\u0648\u0639\u062f\". \u0628\u0639\u062f 20 \u062f\u0642\u064a\u0642\u0629 \u0645\u0646 \u0627\u0644\u062a\u0645\u0631\u064a\u0631 \u0648\u0627\u0644\u0645\u0642\u0627\u0631\u0646\u0629\u060c \u0627\u0633\u062a\u0633\u0644\u0645\u0646\u0627 \u0648\u0642\u0631\u0631\u0646\u0627 \u062a\u0623\u062c\u064a\u0644\u0647\u0627. \u0641\u064a \u062a\u0644\u0643 \u0627\u0644\u0644\u062d\u0638\u0629 \u0623\u062f\u0631\u0643\u062a: \u0627\u0644\u062a\u062e\u0637\u064a\u0637 \u0644\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0644\u064a\u0633 \u0635\u0639\u0628\u064b\u0627\u060c \u0644\u0643\u0646\u0647 \u064a\u0633\u0631\u0642 \u0648\u0642\u062a\u064b\u0627 \u062b\u0645\u064a\u0646\u064b\u0627 \u0645\u0646 \u0627\u0644\u0639\u0644\u0627\u0642\u0629.",
    "\u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0633\u0628\u0628 \u0648\u0631\u0627\u0621 \u0628\u0646\u0627\u0621 \u0645\u064a\u0632\u0629 \"\u0645\u0648\u0639\u062f \u0627\u0644\u0644\u064a\u0644\u0629\". \u0628\u062f\u0644\u064b\u0627 \u0645\u0646 \u0642\u0636\u0627\u0621 20 \u062f\u0642\u064a\u0642\u0629 \u0641\u064a \u0627\u0644\u0628\u062d\u062b \u0648\u0627\u0644\u062a\u0641\u0643\u064a\u0631\u060c \u062a\u062d\u062a\u0627\u062c \u0641\u0642\u0637 30 \u062b\u0627\u0646\u064a\u0629. \u0627\u062e\u062a\u0631 \u0627\u0644\u0645\u0632\u0627\u062c: \u062f\u0627\u0641\u0626\u060c \u0645\u063a\u0627\u0645\u0631\u060c \u0645\u0631\u062d\u060c \u0623\u0648 \u0645\u0631\u064a\u062d. \u0627\u0636\u063a\u0637 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629. \u0627\u0644\u0645\u0648\u0639\u062f \u062c\u0627\u0647\u0632. \u0646\u0639\u0645\u060c \u0628\u0647\u0630\u0647 \u0627\u0644\u0628\u0633\u0627\u0637\u0629.",
    "\u0627\u0644\u0623\u0632\u0648\u0627\u062c \u0627\u0644\u0630\u064a\u0646 \u0627\u0633\u062a\u062e\u062f\u0645\u0648\u0627 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0641\u064a \u0623\u0648\u0644 24 \u0633\u0627\u0639\u0629 \u062e\u0637\u0637\u0648\u0627 \u0644\u0640 4 \u0623\u0636\u0639\u0627\u0641 \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u062e\u0644\u0627\u0644 \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u062a\u0627\u0644\u064a. \u0627\u0644\u0633\u0631 \u0644\u064a\u0633 \u0641\u064a \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0645\u0639\u0642\u062f\u0629\u060c \u0628\u0644 \u0641\u064a \u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0627\u062d\u062a\u0643\u0627\u0643. \u0628\u062f\u0644\u064b\u0627 \u0645\u0646 \"\u0633\u0623\u062e\u0637\u0637 \u063a\u062f\u064b\u0627\"\u060c \u064a\u0635\u0628\u062d \u0627\u0644\u0645\u0648\u0639\u062f \u062d\u0642\u064a\u0642\u0629 \u0641\u064a \u062b\u0648\u0627\u0646\u064d.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0627\u062e\u062a\u0631 \"\u0645\u0648\u0639\u062f \u0627\u0644\u0644\u064a\u0644\u0629\"\u060c \u0648\u0627\u062e\u062a\u0631 \u0627\u0644\u0645\u0632\u0627\u062c. \u0647\u0630\u0627 \u0643\u0644 \u0634\u064a\u0621. \u0623\u0634\u0639\u0631 \u0628\u0627\u0644\u0641\u0631\u0642 \u0628\u0646\u0641\u0633\u0643.\n\n\u0645\u0644\u0627\u062d\u0638\u0629: \u062d\u062a\u0649 \u0644\u0648 \u0644\u0645 \u062a\u0643\u0646 \u0645\u062a\u062d\u0645\u0633\u064b\u0627 \u0627\u0644\u064a\u0648\u0645\u060c \u062c\u0631\u0628\u0647\u0627 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629. \u0633\u062a\u0646\u062f\u0647\u0634 \u0643\u064a\u0641 \u064a\u0645\u0643\u0646 \u0644\u0640 30 \u062b\u0627\u0646\u064a\u0629 \u0623\u0646 \u062a\u0646\u0642\u0630 \u0623\u0645\u0633\u064a\u0629 \u0643\u0627\u0645\u0644\u0629."
  ],
