{
  "subject": "\u0935\u094b 2 \u092c\u091c\u0947 \u0915\u093e \u0930\u093e\u091c \u091c\u094b \u091f\u0949\u092a 1% \u092f\u0942\u091c\u0930\u094d\u0938 \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902",
  "preview_text": "\u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a 1% \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u093e \u0935\u0930\u094d\u0915\u092b\u093c\u094d\u0932\u094b \u0906\u092a\u0915\u094b \u092c\u0924\u093e\u090f\u0901\u0917\u0947 \u0915\u0948\u0938\u0947 \u0905\u092a\u0928\u0947 \u092b\u093c\u094b\u0928 \u0938\u0947 \u092c\u093e\u0938 \u0928\u093f\u0915\u093e\u0932\u0947\u0902\u0964",
  "body_paragraphs": [
    "\u0938\u0941\u0928\u094b, \u0939\u0930 \u0915\u094b\u0908 \u0938\u094b\u091a\u0924\u093e \u0939\u0948 \u0915\u093f \u092c\u093e\u0938 \u0938\u093f\u0930\u094d\u092b\u093c \u092c\u0921\u093c\u0947 \u0938\u094d\u092a\u0940\u0915\u0930\u094b\u0902 \u0938\u0947 \u0906\u0924\u093e \u0939\u0948\u0964 \u0917\u0932\u0924\u0964 \u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a 1% \u092f\u0942\u091c\u0930\u094d\u0938 \u0928\u0947 \u090f\u0915 \u0905\u0932\u0917 \u0924\u0930\u0940\u0915\u093e \u0916\u094b\u091c\u093e \u0939\u0948\u0964 \u0935\u0947 \u0930\u093e\u0924 2 \u092c\u091c\u0947, \u091c\u092c \u0926\u0941\u0928\u093f\u092f\u093e \u0938\u094b\u0924\u0940 \u0939\u0948, \u0905\u092a\u0928\u0947 \u092b\u093c\u094b\u0928 \u092a\u0930 \u090f\u0915 \u0938\u0947\u091f\u093f\u0902\u0917 \u092c\u0926\u0932\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0935\u0947 \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f 'Bass Boost' \u0915\u094b 'Extreme' \u092a\u0930 \u0930\u0916\u0928\u093e \u0915\u093e\u092b\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0935\u0947 \u092a\u0939\u0932\u0947 'EQ' \u092e\u0947\u0902 'Bass Booster' \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091a\u0941\u0928\u0924\u0947 \u0939\u0948\u0902, \u092b\u093f\u0930 'Volume Boost' \u0915\u094b 200% \u0924\u0915 \u0932\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0909\u0938\u0915\u0947 \u092c\u093e\u0926 '3D Surround' \u0911\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939\u0940 \u0935\u0930\u094d\u0915\u092b\u093c\u094d\u0932\u094b \u0939\u0948\u0964 \u092c\u093e\u0915\u0940 \u0938\u092c \u092b\u093c\u094d\u0932\u0948\u091f \u0939\u0948\u0964",
    "\u091c\u092c \u0906\u092a \u092f\u0939 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0921\u094d\u0930\u0949\u092a \u0906\u092a\u0915\u0947 \u0938\u0940\u0928\u0947 \u092e\u0947\u0902 \u0917\u0942\u0902\u091c\u0924\u093e \u0939\u0948\u0964 \u0908\u092f\u0930\u092c\u0921\u094d\u0938 \u092a\u0930 \u092d\u0940\u0964 \u092f\u0939 \u0915\u094b\u0908 \u092e\u0948\u091c\u093f\u0915 \u0928\u0939\u0940\u0902, \u092c\u0938 \u090f\u0915 \u0938\u0939\u0940 \u0915\u094d\u0930\u092e \u0939\u0948\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u092a\u093e\u0938 'Unlimited Boost' \u0914\u0930 'Full 10-Band EQ' \u0939\u0948, \u091c\u094b \u0906\u092a\u0915\u094b \u0914\u0930 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u092f\u0939 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b\u0964 'EQ' \u092e\u0947\u0902 \u091c\u093e\u0913, 'Bass Booster' \u091a\u0941\u0928\u094b, \u092b\u093f\u0930 \u092c\u0942\u0938\u094d\u091f \u0915\u094b 200% \u092a\u0930 \u0932\u0947 \u091c\u093e\u0913\u0964 P.S. \u0905\u0917\u0930 \u0924\u0941\u092e \u091a\u093e\u0939\u094b \u0915\u093f \u0939\u0930 \u0917\u093e\u0928\u093e \u0910\u0938\u0947 \u0932\u0917\u0947 \u091c\u0948\u0938\u0947 \u0932\u093e\u0907\u0935 \u0938\u092c\u0935\u0942\u092b\u0930 \u0939\u094b, \u0924\u094b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0936\u0941\u0930\u0942 \u0915\u0930\u094b\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092b\u093c\u094b\u0928 \u0915\u094b \u092a\u0924\u093e \u0939\u0948 \u0915\u093f \u0909\u0938\u092e\u0947\u0902 \u0914\u0930 \u0915\u094d\u092f\u093e \u0939\u0948\u0964"
  ],
