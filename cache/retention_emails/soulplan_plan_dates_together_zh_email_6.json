{
  "subject": "\u90a3\u5bf9\u60c5\u4fa3\u72af\u7684\u7b2c1\u4e2a\u9519\u8bef",
  "preview_text": "\u4ed6\u4eec\u5dee\u70b9\u6bc1\u6389\u6240\u6709\u6d6a\u6f2b\u77ac\u95f4\uff0c\u4f46\u4e00\u4e2a\u7b80\u5355\u7684\u8c03\u6574\u8ba9\u4e00\u5207\u4e0d\u540c\u3002\u770b\u770b\u4f60\u4e2d\u62db\u4e86\u5417\uff1f",
  "body_paragraphs": [
    "\u8fd8\u8bb0\u5f97\u4f60\u4eec\u4e0a\u6b21\u7ea6\u4f1a\u662f\u4ec0\u4e48\u65f6\u5019\u5417\uff1f\u4e0d\u662f\u90a3\u79cd\u968f\u4fbf\u5403\u987f\u996d\uff0c\u800c\u662f\u771f\u6b63\u5c5e\u4e8e\u4f60\u4eec\u4fe9\u7684\u591c\u665a\u3002\u6700\u8fd1\u6211\u4eec\u53d1\u73b0\u4e00\u4e2a\u4ee4\u4eba\u9707\u60ca\u7684\u4e8b\u5b9e\uff1a90%\u7684\u4f34\u4fa3\u5728\u4e0b\u8f7d\u5e94\u7528\u540e\uff0c\u4f1a\u72af\u540c\u4e00\u4e2a\u81f4\u547d\u7684\u9519\u8bef\u2014\u2014\u4ed6\u4eec\u8981\u4e48\u5ffd\u7565\u4eca\u665a\u7684\u65e5\u671f\uff0c\u8981\u4e48\u628a\u5b83\u5f53\u4f5c\u4e00\u4e2a\u4efb\u52a1\u6e05\u5355\u3002\u7ed3\u679c\u5462\uff1f\u8ba1\u5212\u75b2\u52b3\u4f9d\u7136\u5b58\u5728\uff0c\u706b\u82b1\u66f4\u5feb\u7184\u706d\u3002",
    "\u8fd9\u542c\u8d77\u6765\u719f\u6089\u5417\uff1f\u4f60\u6253\u5f00\u5e94\u7528\uff0c\u6d4f\u89c8\u4e00\u5806\u70b9\u5b50\uff0c\u7136\u540e\u5173\u6389\u5b83\uff0c\u56e0\u4e3a\u611f\u89c9\u50cf\u5728\u52a0\u73ed\u3002\u4f46\u771f\u76f8\u662f\uff1a\u65b0\u9c9c\u611f\u4e0d\u9700\u8981\u590d\u6742\u3002\u90a3\u4e9b\u82b130\u79d2\u70b9\u51fb\u4e00\u4e2a\u5fc3\u60c5\u6309\u94ae\u7684\u4f34\u4fa3\u2014\u2014\u6bd4\u5982\u4eca\u665a\u7684\u65e5\u671f\u2014\u2014\u6bd4\u90a3\u4e9b\u82b1\u534a\u5c0f\u65f6\u7cbe\u5fc3\u7b56\u5212\u7684\u4eba\u591a\u8ba1\u52124\u500d\u3002\u4e0d\u662f\u56e0\u4e3a\u4ed6\u4eec\u66f4\u6d6a\u6f2b\uff0c\u800c\u662f\u56e0\u4e3a\u4ed6\u4eec\u8ba9\u7b80\u5355\u6210\u4e3a\u4e60\u60ef\u3002",
    "\u770b\uff0cSoulPlan\u8bbe\u8ba1\u7684\u7cbe\u9ad3\u5c31\u5728\u4e8e\u6b64\uff1a\u4e00\u4e2a\u7b80\u5355\u7684\u70b9\u51fb\uff0c\u4e00\u4e2a\u5fc3\u60c5\u9009\u62e9\uff0c\u4e00\u4e2a\u7acb\u5373\u884c\u52a8\u7684\u51b2\u52a8\u3002\u5f53\u4f60\u6253\u5f00\u5bb6\u5c4f\u5e55\u65f6\uff0c\u4f60\u4f1a\u770b\u5230\u4f60\u548c\u4f60\u7684\u4f34\u4fa3\u2014\u2014\u4e0d\u662f\u4e00\u4e2a\u4eba\u7684\u540d\u5b57\uff0c\u800c\u662f\u4f60\u4eec\u4fe9\u3002\u4eca\u665a\u7684\u65e5\u671f\u5361\u7247\u7b49\u7740\u4f60\uff1a\u9009\u62e9\u6e29\u99a8\u3001\u5192\u9669\u3001\u73a9\u4e50\u6216\u6cbb\u6108\uff0c\u7136\u540e\u4e00\u5207\u5c31\u7eea\u3002\u8fd9\u4e0d\u662f\u9b54\u6cd5\uff0c\u8fd9\u662f\u79d1\u5b66\u3002",
    "\u73b0\u5728\u6253\u5f00\u5e94\u7528\uff0c\u70b9\u51fb\u4eca\u665a\u7684\u65e5\u671f\uff0c\u9009\u62e9\u4e00\u4e2a\u5fc3\u60c5\uff0c\u7136\u540e\u544a\u8bc9\u4f60\u7684\u4f34\u4fa3\u4f60\u7b49\u4e0d\u53ca\u4e86\u3002P.S. \u6211\u4eec\u77e5\u9053\u4f60\u5fd9\uff0c\u4f46\u8bb0\u4f4f\uff1a\u4e00\u4e2a30\u79d2\u7684\u601d\u8003\u6bd4\u4e00\u4e2a\u5b8c\u7f8e\u7684\u8ba1\u5212\u66f4\u91cd\u8981\u2014\u2014\u800c\u4f60\u7684\u4f34\u4fa3\u6b63\u5728\u7b49\u5f85\u90a3\u4e2a\u4fe1\u53f7\u3002"
  ],
