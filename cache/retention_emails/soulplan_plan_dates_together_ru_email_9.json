{
  "subject": "\u0422\u0440\u0435\u0445\u0434\u043d\u0435\u0432\u043d\u044b\u0439 \u0432\u044b\u0437\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u0437\u043c\u0435\u043d\u0438\u0442 \u0432\u0430\u0448\u0443 \u0440\u0443\u0442\u0438\u043d\u0443",
  "preview_text": "\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 3 \u0434\u043d\u044f \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u044f \u043f\u043e-\u043d\u043e\u0432\u043e\u043c\u0443. \u0423\u0432\u0438\u0434\u0438\u0442\u0435 \u0440\u0430\u0437\u043d\u0438\u0446\u0443, \u043a\u043e\u0433\u0434\u0430 \u043f\u0430\u0440\u0442\u043d\u0435\u0440 \u0437\u0430\u043c\u0435\u0442\u0438\u0442. \u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u0441\u0435\u043a\u0440\u0435\u0442 \u0432\u043d\u0443\u0442\u0440\u0438.",
  "body_paragraphs": [
    "\u0417\u043d\u0430\u0435\u0448\u044c, \u0447\u0442\u043e \u0441\u0430\u043c\u043e\u0435 \u0441\u0442\u0440\u0430\u0448\u043d\u043e\u0435 \u0432 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f\u0445? \u041d\u0435 \u0441\u0441\u043e\u0440\u044b, \u0430 \u0440\u0443\u0442\u0438\u043d\u0430. \u0422\u0440\u0435\u0442\u044c\u044f \u043f\u044f\u0442\u043d\u0438\u0446\u0430 \u043f\u043e\u0434\u0440\u044f\u0434 \u0441 \u043f\u0438\u0446\u0446\u0435\u0439 \u0438 Netflix. \u041c\u043e\u043b\u0447\u0430\u043b\u0438\u0432\u043e\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435: \"\u041d\u0443, \u0445\u043e\u0442\u044c \u0442\u0430\u043a\". \u042f \u0441\u0430\u043c \u043f\u043e\u043f\u0430\u043b \u0432 \u044d\u0442\u0443 \u043b\u043e\u0432\u0443\u0448\u043a\u0443, \u043f\u043e\u043a\u0430 \u043d\u0435 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442. \u0422\u0440\u0438 \u0434\u043d\u044f. \u0412\u0441\u0435\u0433\u043e \u0442\u0440\u0438 \u0434\u043d\u044f, \u0447\u0442\u043e\u0431\u044b \u043f\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0432\u0430\u0448\u0443 \u0440\u043e\u043c\u0430\u043d\u0442\u0438\u043a\u0443. \u0418 \u043f\u043e\u0432\u0435\u0440\u044c, \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0443\u0434\u0438\u0432\u044f\u0442 \u0434\u0430\u0436\u0435 \u0441\u043a\u0435\u043f\u0442\u0438\u043a\u043e\u0432.",
    "\u0412\u043e\u0442 \u0432 \u0447\u0435\u043c \u0444\u0438\u0448\u043a\u0430: \u043c\u044b \u0437\u0430\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u044b \u043d\u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438. \u0425\u043e\u0440\u043e\u0448\u0438\u0435 \u043d\u043e\u0432\u043e\u0441\u0442\u0438 \u2014 \u043d\u043e\u0432\u044b\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u0444\u043e\u0440\u043c\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u0437\u0430 72 \u0447\u0430\u0441\u0430. \u041f\u043b\u043e\u0445\u0438\u0435 \u2014 \u0435\u0441\u043b\u0438 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043c\u0435\u043d\u044f\u0442\u044c, \u0432\u044b \u0437\u0430\u0441\u0442\u0440\u044f\u043d\u0435\u0442\u0435 \u0432 \"\u0437\u043e\u043d\u0435 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u0430\" \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0439. \u041d\u043e \u0443 \u043d\u0430\u0441 \u0435\u0441\u0442\u044c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043b\u043e\u043c\u0430\u0435\u0442 \u044d\u0442\u043e\u0442 \u0448\u0430\u0431\u043b\u043e\u043d. \u0422\u0432\u043e\u0439 \u043f\u0430\u0440\u0442\u043d\u0435\u0440 \u043d\u0435 \u043f\u0440\u043e\u0441\u0438\u0442 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u044f \u2014 \u043e\u043d \u0445\u043e\u0447\u0435\u0442, \u0447\u0442\u043e\u0431\u044b \u0442\u044b \u043f\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0434\u0443\u043c\u0430\u0435\u0448\u044c \u043e \u043d\u0435\u043c. \u0418 \u044d\u0442\u043e \u043f\u0440\u043e\u0449\u0435, \u0447\u0435\u043c \u043a\u0430\u0436\u0435\u0442\u0441\u044f.",
    "\u0412 SoulPlan \u0435\u0441\u0442\u044c \u0444\u0443\u043d\u043a\u0446\u0438\u044f \"\u0427\u0435\u043b\u043b\u0435\u043d\u0434\u0436 3 \u0434\u043d\u044f\". \u0422\u044b \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0448\u044c \u0442\u0435\u043c\u0443: \u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u043e\u0441\u0442\u044c, \u0431\u044e\u0434\u0436\u0435\u0442, \u0441\u044e\u0440\u043f\u0440\u0438\u0437. \u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u0443\u0435\u0442 \u0442\u0440\u0438 \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u043d\u0430 \u0432\u0435\u0447\u0435\u0440. \u041f\u0435\u0440\u0432\u044b\u0439 \u0434\u0435\u043d\u044c \u2014 \u043b\u0435\u0433\u043a\u0438\u0439 \u0448\u0430\u0433 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0437\u0430\u0432\u0430\u0440\u0438\u0442\u044c \u0447\u0430\u0439 \u0438 \u043e\u0431\u0441\u0443\u0434\u0438\u0442\u044c \u043c\u0435\u0447\u0442\u044b). \u0412\u0442\u043e\u0440\u043e\u0439 \u2014 \u043a\u0440\u0435\u0430\u0442\u0438\u0432 (\u0443\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0443\u0436\u0438\u043d \u043f\u0440\u0438 \u0441\u0432\u0435\u0447\u0430\u0445 \u0438\u0437 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0435\u0441\u0442\u044c \u0432 \u0445\u043e\u043b\u043e\u0434\u0438\u043b\u044c\u043d\u0438\u043a\u0435). \u0422\u0440\u0435\u0442\u0438\u0439 \u2014 \u043f\u043e\u043b\u043d\u044b\u0439 \u0441\u044e\u0440\u043f\u0440\u0438\u0437 (\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0441\u0430\u043c\u043e \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0435\u0442 \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u0435, \u0430 \u0442\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u043d\u044f\u0435\u0448\u044c). 230+ \u043f\u0430\u0440 \u0443\u0436\u0435 \u043f\u0440\u043e\u0448\u043b\u0438 \u044d\u0442\u043e\u0442 \u0447\u0435\u043b\u043b\u0435\u043d\u0434\u0436, \u0438 92% \u0433\u043e\u0432\u043e\u0440\u044f\u0442, \u0447\u0442\u043e \u0438\u0441\u043a\u0440\u0430 \u0432\u0435\u0440\u043d\u0443\u043b\u0430\u0441\u044c.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043d\u0430\u0436\u043c\u0438 \"\u041d\u0430\u0447\u0430\u0442\u044c 3-\u0434\u043d\u0435\u0432\u043d\u044b\u0439 \u0432\u044b\u0437\u043e\u0432\". \u041f\u0435\u0440\u0432\u043e\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u0435 \u0437\u0430\u0439\u043c\u0435\u0442 5 \u043c\u0438\u043d\u0443\u0442. \u0421\u0434\u0435\u043b\u0430\u0439 \u044d\u0442\u043e, \u043f\u043e\u043a\u0430 \u044f \u043d\u0435 \u0441\u0442\u0435\u0440 \u044d\u0442\u043e\u0442 \u0441\u043e\u0432\u0435\u0442 \u0438\u0437 \u043f\u0438\u0441\u044c\u043c\u0430. P.S. \u0415\u0441\u043b\u0438 \u043f\u0430\u0440\u0442\u043d\u0435\u0440 \u0441\u043f\u0440\u043e\u0441\u0438\u0442, \u043e\u0442\u043a\u0443\u0434\u0430 \u0438\u0434\u0435\u044f \u2014 \u0441\u043a\u0430\u0436\u0438, \u0447\u0442\u043e \u0443 \u0442\u0435\u0431\u044f \u043f\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c \u043d\u043e\u0432\u0430\u044f \u0441\u0443\u043f\u0435\u0440\u0441\u0438\u043b\u0430. \u041d\u0435 \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0439 \u0441\u0435\u043a\u0440\u0435\u0442. \u041f\u0443\u0441\u0442\u044c \u0433\u0430\u0434\u0430\u0435\u0442."
  ],
