{
  "subject": "\u0906\u091c 1,247 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u092f\u0939 \u0915\u093f\u092f\u093e",
  "preview_text": "\u092a\u0924\u093e \u0939\u0948 \u0915\u093f \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0915\u094d\u092f\u093e \u092a\u093e\u092f\u093e? \u0906\u092a \u092d\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 Volume Booster Pro \u092e\u0947\u0902 \u090f\u0915 \u091a\u0940\u091c\u093c \u092c\u0926\u0932 \u0926\u0940\u0964",
  "body_paragraphs": [
    "\u0938\u0941\u092c\u0939 \u0915\u0947 7 \u092c\u091c\u0947 \u0925\u0947\u0964 \u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0906\u091c 1,247 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 Volume Booster Pro \u0916\u094b\u0932\u093e \u0914\u0930 \u090f\u0915 \u0916\u093e\u0938 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b \u0918\u0941\u092e\u093e\u092f\u093e\u0964 \u0935\u0939 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0938\u093f\u0930\u094d\u092b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0928\u0939\u0940\u0902 \u092c\u0922\u093c\u093e\u0924\u093e\u2014\u092f\u0939 \u0909\u0928\u0915\u0947 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f, \u0917\u093e\u0928\u0947, \u0917\u0947\u092e \u0915\u094b \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0930\u0941\u0915\u093e\u0935\u091f \u0915\u0947 200% \u0924\u0915 \u0924\u0947\u091c\u093c \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u0935\u0939 \u0936\u093e\u0902\u0924, \u0938\u093e\u092b \u0906\u0935\u093e\u091c\u093c \u091c\u094b \u0935\u0947 \u091a\u093e\u0939\u0924\u0947 \u0925\u0947\u0964",
    "\u092f\u0939 \u0935\u0939\u0940 \u0932\u094b\u0917 \u0939\u0948\u0902 \u091c\u094b \u092a\u0939\u0932\u0947 \u092b\u094d\u0930\u0940 \u0935\u0930\u094d\u091c\u0928 \u092e\u0947\u0902 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928\u094b\u0902 \u0938\u0947 \u0925\u0915 \u0917\u090f \u0925\u0947\u0964 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u090f\u0915 \u0939\u0940 \u0915\u093e\u092e \u0915\u093f\u092f\u093e: \u0939\u0947\u0921\u092b\u094b\u0928 \u0932\u0917\u093e\u092f\u093e, \u0910\u092a \u0916\u094b\u0932\u093e, \u0914\u0930 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b \u0911\u0928 \u0915\u093f\u092f\u093e\u0964 \u0905\u092c \u0935\u0947 \u0939\u0930 \u0938\u094d\u0930\u094b\u0924\u2014Spotify, YouTube, \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f\u2014\u0915\u094b \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0930\u0941\u0915\u093e\u0935\u091f \u0915\u0947 \u0938\u0941\u0928 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0914\u0930 \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u0940 \u092c\u093e\u0924? \u0910\u092a \u0905\u092a\u0928\u0947 \u0906\u092a \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u093e \u0939\u0948, \u092b\u093f\u0930 \u0930\u093e\u0938\u094d\u0924\u0947 \u0938\u0947 \u0939\u091f \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u0928\u093e\u0917 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0917\u0947\u092e \u0928\u0939\u0940\u0902\u0964",
    "\u092f\u0939 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 '\u0911\u091f\u094b-\u0905\u092a\u094d\u0932\u093e\u0908' \u092b\u0940\u091a\u0930 \u0939\u0948\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0938\u0947\u091f \u0915\u0930\u094b, \u092b\u093f\u0930 \u092d\u0942\u0932 \u091c\u093e\u0913\u0964 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0924\u0941\u092e \u0939\u0947\u0921\u092b\u094b\u0928 \u0932\u0917\u093e\u0913\u0917\u0947, \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0915\u0947 \u092c\u0922\u093c \u091c\u093e\u090f\u0917\u093e\u0964 \u092c\u0938 \u0935\u0939 \u0936\u093e\u0902\u0924, \u0938\u093e\u092b \u0906\u0935\u093e\u091c\u093c\u0964 \u0915\u094b\u0908 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0928\u0939\u0940\u0902\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u0911\u091f\u094b-\u0905\u092a\u094d\u0932\u093e\u0908' \u0915\u094b \u0911\u0928 \u0915\u0930\u094b\u0964 \u092f\u0939 \u0935\u0939 \u092c\u0926\u0932\u093e\u0935 \u0939\u0948 \u091c\u094b 1,247 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0915\u093f\u092f\u093e\u0964 P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u090f\u0915 \u092c\u093e\u0930 \u0915\u0940 \u0916\u0930\u0940\u0926 \u092f\u093e \u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093f\u092a\u094d\u0936\u0928\u2014\u0926\u094b\u0928\u094b\u0902 \u092e\u0947\u0902 \u092a\u0942\u0930\u093e \u092b\u0940\u091a\u0930 \u0905\u0928\u0932\u0949\u0915 \u0939\u0948\u0964 \u0915\u094b\u0908 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0928\u0939\u0940\u0902, \u0938\u093f\u0930\u094d\u092b \u0935\u0939 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u091c\u094b \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
  ],
