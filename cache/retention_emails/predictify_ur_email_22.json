{
  "subject": "\u0648\u06c1 \u0634\u0627\u0631\u0679 \u06a9\u0679 \u062c\u0648 \u0635\u0631\u0641 5 \u0641\u06cc\u0635\u062f \u0635\u0627\u0631\u0641\u06cc\u0646 \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba",
  "preview_text": "\u0627\u06cc\u06a9 \u0686\u06be\u0648\u0679\u06cc \u0633\u06cc \u0679\u0631\u06a9 \u062c\u0648 \u0622\u067e \u06a9\u06d2 \u067e\u06cc\u0634\u06af\u0648\u0626\u06cc\u0648\u06ba \u06a9\u0648 \u0628\u062f\u0644 \u062f\u06d2 \u06af\u06cc\u06d4 \u06a9\u06cc\u0627 \u0622\u067e \u0646\u06d2 \u06cc\u06c1 \u0622\u0632\u0645\u0627\u06cc\u0627 \u06c1\u06d2\u061f",
  "body_paragraphs": [
    "\u06a9\u0644 \u0631\u0627\u062a 2 \u0628\u062c\u06d2 \u0645\u06cc\u06ba \u0646\u06d2 \u062f\u06cc\u06a9\u06be\u0627 \u06a9\u06c1 \u06c1\u0645\u0627\u0631\u06d2 \u06a9\u0686\u06be \u067e\u0627\u0648\u0631 \u06cc\u0648\u0632\u0631\u0632 \u06a9\u0686\u06be \u0627\u06cc\u0633\u0627 \u06a9\u0631 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba \u062c\u0648 \u0645\u06cc\u06ba \u0646\u06d2 \u06a9\u0628\u06be\u06cc \u0633\u0648\u0686\u0627 \u0628\u06be\u06cc \u0646\u06c1\u06cc\u06ba \u062a\u06be\u0627\u06d4 \u0648\u06c1 \u0645\u06cc\u0686 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0635\u0631\u0641 5 \u0645\u0646\u0679 \u0644\u06af\u0627 \u06a9\u0631 \u0627\u06cc\u0633\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062d\u0627\u0635\u0644 \u06a9\u0631 \u0631\u06c1\u06d2 \u062a\u06be\u06d2 \u062c\u0648 \u0639\u0627\u0645 \u0637\u0648\u0631 \u067e\u0631 \u0635\u0631\u0641 \u067e\u0631\u06cc\u0645\u06cc\u0645 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0645\u0644\u062a\u06cc \u06c1\u06cc\u06ba\u06d4",
    "\u0628\u0627\u062a \u06cc\u06c1 \u06c1\u06d2 \u06a9\u06c1 \u062c\u0628 \u0622\u067e Predictify \u0645\u06cc\u06ba \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0645\u06cc\u0686 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u062a\u0648 \u0622\u067e \u06a9\u0648 \u0627\u06cc\u06a9 \u0686\u06be\u0648\u0679\u0627 \u0633\u0627 '\u067e\u06cc\u0634\u0646\u0644' \u0628\u0679\u0646 \u0646\u0638\u0631 \u0622\u062a\u0627 \u06c1\u06d2 \u2014 \u0634\u0627\u06cc\u062f \u0622\u067e \u0646\u06d2 \u0627\u0633\u06d2 \u062f\u06cc\u06a9\u06be\u0627 \u0628\u06be\u06cc \u0646\u06c1\u06cc\u06ba\u06d4 \u06cc\u06c1 \u0628\u0679\u0646 \u0622\u067e \u06a9\u0648 AI \u06a9\u06cc \u062e\u0641\u06cc\u06c1 \u062a\u06c1\u0648\u06ba \u0645\u06cc\u06ba \u0644\u06d2 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u062c\u06c1\u0627\u06ba xG\u060c \u067e\u0632\u06cc\u0634\u0646\u060c \u0627\u0648\u0631 \u062f\u0641\u0627\u0639\u06cc \u06a9\u0645\u0632\u0648\u0631\u06cc\u0648\u06ba \u06a9\u0627 \u062a\u062c\u0632\u06cc\u06c1 \u0686\u06be\u067e\u0627 \u06c1\u0648\u062a\u0627 \u06c1\u06d2\u06d4",
    "\u06cc\u06c1 \u0648\u06c1\u06cc \u0686\u06cc\u0632 \u06c1\u06d2 \u062c\u0648 \u067e\u0627\u0648\u0631 \u06cc\u0648\u0632\u0631\u0632 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u062a\u0627\u06a9\u06c1 \u0648\u06c1 59% \u0627\u0639\u062a\u0645\u0627\u062f \u0648\u0627\u0644\u06d2 \u0645\u06cc\u0686\u0648\u06ba \u06a9\u0648 \u0628\u06be\u06cc 80% \u062a\u06a9 \u0644\u06d2 \u0622\u0626\u06cc\u06ba\u06d4 \u0622\u067e \u06a9\u0648 \u0635\u0631\u0641 \u0627\u062a\u0646\u0627 \u06a9\u0631\u0646\u0627 \u06c1\u06d2 \u06a9\u06c1 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0645\u06cc\u0686 \u06a9\u06cc \u067e\u06cc\u0634\u06af\u0648\u0626\u06cc \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u060c \u067e\u06be\u0631 '\u067e\u06cc\u0634\u0646\u0644' \u0628\u0679\u0646 \u062f\u0628\u0627\u0626\u06cc\u06ba\u060c \u0627\u0648\u0631 AI \u06a9\u06cc \u062e\u0641\u06cc\u06c1 \u0631\u067e\u0648\u0631\u0679 \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u2014 \u06cc\u06c1 \u0645\u0641\u062a \u06c1\u06d2\u060c \u0644\u06cc\u06a9\u0646 \u0635\u0631\u0641 \u0686\u0646\u062f \u0644\u0648\u06af \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4",
    "\u0622\u062c \u06c1\u06cc \u0627\u0633\u06d2 \u0622\u0632\u0645\u0627\u0626\u06cc\u06ba: \u0627\u06cc\u06a9 \u0645\u06cc\u0686 \u06a9\u06be\u0648\u0644\u06cc\u06ba\u060c '\u067e\u06cc\u0634\u0646\u0644' \u0628\u0679\u0646 \u062f\u0628\u0627\u0626\u06cc\u06ba\u060c \u0627\u0648\u0631 \u062f\u06cc\u06a9\u06be\u06cc\u06ba \u06a9\u06c1 \u0622\u067e \u06a9\u06cc \u067e\u06cc\u0634\u06af\u0648\u0626\u06cc \u06a9\u06cc\u0633\u06d2 \u0628\u062f\u0644\u062a\u06cc \u06c1\u06d2\u06d4 P.S. \u2014 \u0627\u06af\u0631 \u0622\u067e \u0646\u06d2 \u067e\u0686\u06be\u0644\u06d2 \u06c1\u0641\u062a\u06d2 \u06a9\u06d2 67% \u0627\u0639\u062a\u0645\u0627\u062f \u0648\u0627\u0644\u06d2 \u0645\u06cc\u0686 \u06a9\u0648 \u06cc\u0627\u062f \u06a9\u06cc\u0627\u060c \u062a\u0648 \u06cc\u06c1 \u0648\u06c1\u06cc \u0686\u06cc\u0632 \u06c1\u06d2 \u062c\u0648 \u0622\u067e \u06a9\u0648 \u06c1\u0631 \u0628\u0627\u0631 \u062c\u06cc\u062a\u0646\u06d2 \u0645\u06cc\u06ba \u0645\u062f\u062f \u062f\u06d2 \u06af\u06cc\u06d4"
  ],
