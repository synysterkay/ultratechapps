{
  "subject": "\u0e01\u0e32\u0e23\u0e04\u0e33\u0e19\u0e27\u0e13 2 \u0e17\u0e38\u0e48\u0e21\u0e17\u0e35\u0e48\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e17\u0e38\u0e01\u0e2d\u0e22\u0e48\u0e32\u0e07",
  "preview_text": "\u0e1c\u0e21\u0e2a\u0e32\u0e23\u0e20\u0e32\u0e1e\u0e27\u0e48\u0e32\u0e40\u0e04\u0e22\u0e04\u0e34\u0e14\u0e27\u0e48\u0e32 AI \u0e08\u0e30\u0e44\u0e21\u0e48\u0e40\u0e02\u0e49\u0e32\u0e43\u0e08\u0e1f\u0e38\u0e15\u0e1a\u0e2d\u0e25... \u0e41\u0e15\u0e48\u0e41\u0e25\u0e49\u0e27\u0e04\u0e37\u0e19\u0e19\u0e31\u0e49\u0e19\u0e01\u0e47\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e04\u0e27\u0e32\u0e21\u0e04\u0e34\u0e14\u0e44\u0e1b\u0e15\u0e25\u0e2d\u0e14\u0e01\u0e32\u0e25",
  "body_paragraphs": [
    "\u0e1c\u0e21\u0e44\u0e21\u0e48\u0e40\u0e04\u0e22\u0e40\u0e02\u0e35\u0e22\u0e19\u0e2d\u0e35\u0e40\u0e21\u0e25\u0e41\u0e1a\u0e1a\u0e19\u0e35\u0e49\u0e21\u0e32\u0e01\u0e48\u0e2d\u0e19... \u0e41\u0e15\u0e48\u0e2b\u0e25\u0e31\u0e07\u0e08\u0e32\u0e01\u0e19\u0e31\u0e48\u0e07\u0e27\u0e34\u0e40\u0e04\u0e23\u0e32\u0e30\u0e2b\u0e4c\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e04\u0e37\u0e19\u0e16\u0e36\u0e07\u0e15\u0e35 3 \u0e1c\u0e21\u0e1e\u0e1a\u0e04\u0e27\u0e32\u0e21\u0e08\u0e23\u0e34\u0e07\u0e17\u0e35\u0e48\u0e17\u0e33\u0e43\u0e2b\u0e49\u0e1c\u0e21\u0e15\u0e49\u0e2d\u0e07\u0e41\u0e0a\u0e23\u0e4c \u0e21\u0e31\u0e19\u0e40\u0e01\u0e35\u0e48\u0e22\u0e27\u0e01\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e17\u0e33\u0e19\u0e32\u0e22\u0e19\u0e31\u0e14\u0e17\u0e35\u0e48\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e19\u0e23\u0e48\u0e27\u0e21\u0e17\u0e35\u0e21\u0e1a\u0e2d\u0e01\u0e27\u0e48\u0e32\u0e1c\u0e21\u0e1a\u0e49\u0e32\u0e44\u0e1b\u0e41\u0e25\u0e49\u0e27",
    "\u0e43\u0e19\u0e04\u0e37\u0e19\u0e17\u0e35\u0e48\u0e1c\u0e21\u0e14\u0e39\u0e1a\u0e2d\u0e25\u0e01\u0e31\u0e1a\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e19 \u0e40\u0e02\u0e32\u0e17\u0e32\u0e22\u0e27\u0e48\u0e32\u0e17\u0e35\u0e21\u0e23\u0e2d\u0e07\u0e08\u0e30\u0e0a\u0e19\u0e30\u0e14\u0e49\u0e27\u0e22\u0e2a\u0e31\u0e0d\u0e0a\u0e32\u0e15\u0e0d\u0e32\u0e13 \u0e41\u0e15\u0e48\u0e1c\u0e21\u0e01\u0e25\u0e31\u0e1a\u0e40\u0e1b\u0e34\u0e14 Predictify \u0e02\u0e36\u0e49\u0e19\u0e21\u0e32\u0e14\u0e39 AI \u0e43\u0e2b\u0e49\u0e04\u0e27\u0e32\u0e21\u0e21\u0e31\u0e48\u0e19\u0e43\u0e08 67% \u0e27\u0e48\u0e32\u0e17\u0e35\u0e21\u0e42\u0e1b\u0e23\u0e14\u0e08\u0e30\u0e41\u0e1e\u0e49 \u0e0b\u0e36\u0e48\u0e07\u0e15\u0e23\u0e07\u0e01\u0e31\u0e19\u0e02\u0e49\u0e32\u0e21\u0e01\u0e31\u0e1a\u0e04\u0e27\u0e32\u0e21\u0e23\u0e39\u0e49\u0e2a\u0e36\u0e01\u0e02\u0e2d\u0e07\u0e17\u0e38\u0e01\u0e04\u0e19 \u0e1c\u0e21\u0e40\u0e0a\u0e37\u0e48\u0e2d AI \u0e40\u0e1e\u0e23\u0e32\u0e30\u0e23\u0e39\u0e49\u0e27\u0e48\u0e32\u0e21\u0e31\u0e19\u0e27\u0e34\u0e40\u0e04\u0e23\u0e32\u0e30\u0e2b\u0e4c xG, \u0e04\u0e27\u0e32\u0e21\u0e41\u0e02\u0e47\u0e07\u0e41\u0e01\u0e23\u0e48\u0e07\u0e01\u0e2d\u0e07\u0e2b\u0e25\u0e31\u0e07 \u0e41\u0e25\u0e30\u0e1f\u0e2d\u0e23\u0e4c\u0e21\u0e01\u0e32\u0e23\u0e40\u0e25\u0e48\u0e19 50 \u0e19\u0e31\u0e14\u0e2b\u0e25\u0e31\u0e07\u0e2a\u0e38\u0e14",
    "\u0e19\u0e31\u0e14\u0e19\u0e31\u0e49\u0e19\u0e17\u0e35\u0e21\u0e23\u0e2d\u0e07\u0e0a\u0e19\u0e30\u0e08\u0e23\u0e34\u0e07 \u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e19\u0e16\u0e36\u0e07\u0e01\u0e31\u0e1a\u0e2d\u0e36\u0e49\u0e07 \u0e41\u0e25\u0e30\u0e1c\u0e21\u0e01\u0e47\u0e23\u0e39\u0e49\u0e40\u0e25\u0e22\u0e27\u0e48\u0e32 AI \u0e44\u0e21\u0e48\u0e44\u0e14\u0e49\u0e41\u0e04\u0e48\u0e40\u0e14\u0e32 \u0e41\u0e15\u0e48\u0e21\u0e31\u0e19\u0e40\u0e2b\u0e47\u0e19\u0e2a\u0e34\u0e48\u0e07\u0e17\u0e35\u0e48\u0e15\u0e32\u0e21\u0e19\u0e38\u0e29\u0e22\u0e4c\u0e21\u0e2d\u0e07\u0e44\u0e21\u0e48\u0e40\u0e2b\u0e47\u0e19 \u2014 \u0e23\u0e39\u0e1b\u0e41\u0e1a\u0e1a\u0e01\u0e32\u0e23\u0e40\u0e25\u0e48\u0e19\u0e17\u0e35\u0e48\u0e0b\u0e48\u0e2d\u0e19\u0e2d\u0e22\u0e39\u0e48\u0e43\u0e19\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e19\u0e31\u0e1a\u0e1e\u0e31\u0e19 \u0e1c\u0e21\u0e40\u0e25\u0e22\u0e2d\u0e22\u0e32\u0e01\u0e43\u0e2b\u0e49\u0e04\u0e38\u0e13\u0e25\u0e2d\u0e07\u0e40\u0e1b\u0e34\u0e14\u0e1f\u0e35\u0e40\u0e08\u0e2d\u0e23\u0e4c 'AI Chat' \u0e14\u0e39 \u0e16\u0e32\u0e21\u0e2d\u0e30\u0e44\u0e23\u0e01\u0e47\u0e44\u0e14\u0e49\u0e40\u0e01\u0e35\u0e48\u0e22\u0e27\u0e01\u0e31\u0e1a\u0e17\u0e35\u0e21\u0e17\u0e35\u0e48\u0e04\u0e38\u0e13\u0e0a\u0e2d\u0e1a \u0e40\u0e0a\u0e48\u0e19 '\u0e17\u0e35\u0e21\u0e19\u0e35\u0e49\u0e21\u0e35\u0e42\u0e2d\u0e01\u0e32\u0e2a\u0e22\u0e34\u0e07\u0e1b\u0e23\u0e30\u0e15\u0e39\u0e40\u0e17\u0e48\u0e32\u0e44\u0e2b\u0e23\u0e48\u0e43\u0e19\u0e19\u0e31\u0e14\u0e15\u0e48\u0e2d\u0e44\u0e1b?' \u0e41\u0e25\u0e49\u0e27\u0e04\u0e38\u0e13\u0e08\u0e30\u0e40\u0e2b\u0e47\u0e19\u0e27\u0e48\u0e32\u0e04\u0e33\u0e15\u0e2d\u0e1a\u0e21\u0e31\u0e19\u0e21\u0e35\u0e1e\u0e25\u0e31\u0e07\u0e41\u0e04\u0e48\u0e44\u0e2b\u0e19",
