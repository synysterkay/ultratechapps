  "subject": "\ud55c \ub2ec \ub9cc\uc5d0 \ubc1d\ud600\uc9c4 \ub2f9\uc2e0\uc758 \ucd95\uad6c IQ",
  "preview_text": "30\uc77c \ub3d9\uc548 Predictify\ub97c \uc0ac\uc6a9\ud55c \ub2f9\uc2e0\uc758 \uae30\ub85d\uc774 \uacf5\uac1c\ub429\ub2c8\ub2e4. \ud655\uc778\ud558\uc9c0 \uc54a\uc73c\uba74 \ud6c4\ud68c\ud560\uc9c0\ub3c4 \ubab0\ub77c\uc694.",
  "body_paragraphs": [
    "\ucd95\uad6c\ub294 \uacb0\uacfc\ub97c \ubcf4\ub294 \uac8c \uc544\ub2c8\ub77c \uc77d\ub294 \uac70\uc57c. \ud55c \ub2ec \uc804, \ub2f9\uc2e0\uc740 \uadf8\ub0e5 \uac10\uc5d0 \uc758\uc874\ud588\uc744\uc9c0\ub3c4 \ubab0\ub77c. \ud558\uc9c0\ub9cc \uc9c0\uae08\uc740 \ub2e4\ub974\uc9c0? Predictify\uac00 \ub2f9\uc2e0\uc5d0\uac8c \ub370\uc774\ud130\uc758 \ub208\uc744 \uc5f4\uc5b4\uc92c\uc73c\ub2c8\uae4c.",
    "28\uc77c \ub3d9\uc548 \ub2f9\uc2e0\uc774 \ub9cc\ub4e0 \uc608\uce21, \ub9de\ud78c \uacbd\uae30, \uc313\uc740 \uc5f0\uc18d \uae30\ub85d\uc744 \ud55c \ubc88 \ubcf4\uc790. \uc6b0\ub9ac AI\uac00 \ubd84\uc11d\ud55c \uac74\ub370, \ub2f9\uc2e0\uc758 \uc815\ud655\ub3c4\uac00 \ubc8c\uc368 \ud3c9\uade0\ubcf4\ub2e4 15% \ub192\uc544\uc84c\uc5b4. \ub180\ub78d\uc9c0 \uc54a\uc544? \uc774\uac8c \ucd95\uad6c IQ\uac00 \uc9c4\uc9dc\ub85c \uc62c\ub77c\uac04 \uc99d\uac70\uc57c.",
    "\uadf8\ub7f0\ub370 \ub9d0\uc774\uc57c, \ub2f9\uc2e0\uc774 \uc544\uc9c1 \uc548 \uc368\ubcf8 \uae30\ub2a5\uc774 \ud558\ub098 \uc788\uc5b4. 'AI \ucc44\ud305'\uc774\uc57c. \uac70\uae30\uc11c '\uc624\ub298 \ub808\uc54c \ub9c8\ub4dc\ub9ac\ub4dc\uac00 \uc774\uae38 \ud655\ub960\uc774 \uc65c 68%\uc57c?'\ub77c\uace0 \ubb3c\uc5b4\ubcf4\uba74, AI\uac00 xG, \uc218\ube44 \uc57d\uc810, \ucd5c\uadfc \ud3fc\uae4c\uc9c0 \ub2e4 \ubd84\uc11d\ud574\uc11c \ub2f5\ud574\uc918. \ud55c \ubc88\ub9cc \uc368\ubd10, \uc911\ub3c5\ub420 \uac78.",
    "\uc9c0\uae08 \ubc14\ub85c Predictify\ub97c \uc5f4\uace0 'AI \ucc44\ud305'\uc5d0 \ub4e4\uc5b4\uac00\ubd10. '\ub0b4 \ud55c \ub2ec \uae30\ub85d'\uc774\ub77c\uace0 \uce58\uba74, \ub2f9\uc2e0\uc774 \uc774\ub8ec \ubaa8\ub4e0 \uac78 \ubcf4\uc5ec\uc904\uac8c. P.S. \ud504\ub9ac\ubbf8\uc5c4\uc744 \uc4f0\uba74 \uc774\ub7f0 \ubd84\uc11d\uc774 \ud558\ub8e8 \uc885\uc77c \ubb34\uc81c\ud55c\uc774\uc57c. 3\uc77c \ubb34\ub8cc\ub2c8\uae4c \ubd80\ub2f4 \uac16\uc9c0 \ub9d0\uace0."
  ],
