{
  "subject": "\u0627\u0641\u0633\u0627\u0646\u0647\u200c\u0627\u06cc \u06a9\u0647 \u06f9\u06f0\u066a \u0647\u0648\u0627\u062f\u0627\u0631\u0627\u0646 \u0641\u0648\u062a\u0628\u0627\u0644 \u0628\u0627\u0648\u0631 \u062f\u0627\u0631\u0646\u062f",
  "preview_text": "\u0647\u0645\u0647 \u0645\u06cc\u200c\u06af\u0646 \u062a\u06cc\u0645 \u0628\u0632\u0631\u06af\u200c\u062a\u0631 \u0647\u0645\u06cc\u0634\u0647 \u0628\u0631\u0646\u062f\u0647\u200c\u0633\u062a. \u0627\u0645\u0627 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0645\u0627 \u0686\u06cc\u0632 \u062f\u06cc\u06af\u0647\u200c\u0627\u06cc \u0646\u0634\u0648\u0646 \u0645\u06cc\u062f\u0647. \u0627\u06cc\u0646\u0648 \u0628\u0628\u06cc\u0646.",
  "body_paragraphs": [
    "\u0631\u0627\u0633\u062a\u0634 \u0631\u0648 \u0628\u062e\u0648\u0627\u06cc\u060c \u0645\u0646\u0645 \u0642\u0628\u0644\u0627\u064b \u0641\u06a9\u0631 \u0645\u06cc\u200c\u06a9\u0631\u062f\u0645 \u062a\u06cc\u0645 \u0628\u0632\u0631\u06af\u200c\u062a\u0631 \u062a\u0648 \u062a\u0627\u0631\u06cc\u062e \u0647\u0645\u06cc\u0634\u0647 \u0634\u0627\u0646\u0633 \u0628\u06cc\u0634\u062a\u0631\u06cc \u062f\u0627\u0631\u0647. \u0648\u0644\u06cc \u06cc\u0647 \u0634\u0628\u060c \u0633\u0627\u0639\u062a \u06f3 \u0635\u0628\u062d\u060c \u062f\u0627\u0634\u062a\u0645 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u06f5\u06f0\u06f0 \u0628\u0627\u0632\u06cc \u0627\u062e\u06cc\u0631 \u0644\u06cc\u06af \u0642\u0647\u0631\u0645\u0627\u0646\u0627\u0646 \u0631\u0648 \u062a\u0648 Predictify \u0686\u06a9 \u0645\u06cc\u200c\u06a9\u0631\u062f\u0645. \u0646\u062a\u06cc\u062c\u0647 \u0686\u06cc \u0628\u0648\u062f\u061f \u062a\u06cc\u0645\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u062a\u0648 \u06f1\u06f0 \u0633\u0627\u0644 \u0627\u062e\u06cc\u0631 \u0642\u0647\u0631\u0645\u0627\u0646 \u0646\u0634\u062f\u0646\u060c \u062a\u0648 \u06f6\u06f5\u066a \u0645\u0648\u0627\u0642\u0639 \u062a\u06cc\u0645 \u0628\u0632\u0631\u06af\u200c\u062a\u0631 \u0631\u0648 \u0634\u06a9\u0633\u062a \u062f\u0627\u062f\u0646. \u0627\u06cc\u0646 \u06cc\u0647 \u062d\u0642\u06cc\u0642\u062a \u062a\u0644\u062e\u0647 \u0628\u0631\u0627\u06cc \u0627\u0648\u0646\u0627\u06cc\u06cc \u06a9\u0647 \u0641\u0642\u0637 \u0628\u0647 \u0627\u0633\u0645 \u062a\u06cc\u0645 \u0646\u06af\u0627\u0647 \u0645\u06cc\u200c\u06a9\u0646\u0646.",
    "\u0645\u06cc\u200c\u062f\u0648\u0646\u06cc \u0686\u0631\u0627\u061f \u0686\u0648\u0646 \u0641\u0648\u062a\u0628\u0627\u0644 \u062f\u06cc\u06af\u0647 \u0641\u0642\u0637 \u0628\u062e\u062a \u0648 \u0627\u0642\u0628\u0627\u0644 \u0646\u06cc\u0633\u062a. \u0641\u0627\u06a9\u062a\u0648\u0631\u0647\u0627\u06cc\u06cc \u0645\u062b\u0644 xG\u060c \u0645\u0627\u0644\u06a9\u06cc\u062a \u0648\u0627\u0642\u0639\u06cc\u060c \u0642\u062f\u0631\u062a \u062f\u0641\u0627\u0639\u06cc \u062a\u0648 \u0628\u0627\u0632\u06cc\u200c\u0647\u0627\u06cc \u062e\u0627\u0631\u062c \u0627\u0632 \u062e\u0648\u0646\u0647 - \u0627\u06cc\u0646\u0627 \u0647\u0645\u0647 \u0631\u0648 AI \u0645\u0627 \u062a\u062d\u0644\u06cc\u0644 \u0645\u06cc\u200c\u06a9\u0646\u0647. \u0648 \u0646\u0634\u0648\u0646 \u0645\u06cc\u062f\u0647 \u06a9\u0647 \u062a\u06cc\u0645 \u0645\u062a\u0648\u0633\u0637 \u0628\u0627 \u0627\u0633\u062a\u0631\u0627\u062a\u0698\u06cc \u062f\u0631\u0633\u062a \u0645\u06cc\u200c\u062a\u0648\u0646\u0647 \u063a\u0648\u0644\u200c\u0647\u0627 \u0631\u0648 \u0632\u0645\u06cc\u0646 \u0628\u0632\u0646\u0647. \u062f\u0642\u06cc\u0642\u0627\u064b \u0645\u062b\u0644 \u0647\u0645\u0648\u0646 \u0628\u0627\u0632\u06cc \u0645\u0639\u0631\u0648\u0641 \u0644\u0633\u062a\u0631\u0633\u06cc\u062a\u06cc \u06a9\u0647 \u0647\u0645\u0647 \u0631\u0648 \u0634\u06af\u0641\u062a\u200c\u0632\u062f\u0647 \u06a9\u0631\u062f.",
    "\u0627\u06cc\u0646\u062c\u0627\u0633\u062a \u06a9\u0647 Predictify \u0628\u0647 \u06a9\u0627\u0631\u062a \u0645\u06cc\u0627\u062f. \u0648\u0642\u062a\u06cc \u0645\u06cc\u200c\u062e\u0648\u0627\u06cc \u06cc\u0647 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u062f\u0642\u06cc\u0642 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u060c \u0641\u0642\u0637 \u0628\u0647 \u0627\u0633\u0645 \u062a\u06cc\u0645 \u0646\u06af\u0627\u0647 \u0646\u06a9\u0646. \u0628\u0631\u0648 \u062a\u0648 \u0628\u062e\u0634 \"\u062a\u062d\u0644\u06cc\u0644 \u062a\u0627\u06a9\u062a\u06cc\u06a9\u06cc\" \u0647\u0631 \u0628\u0627\u0632\u06cc. \u0627\u0648\u0646\u062c\u0627 \u0645\u06cc\u200c\u0628\u06cc\u0646\u06cc \u06a9\u0647 AI \u0686\u0637\u0648\u0631 \u0642\u062f\u0631\u062a \u062d\u0645\u0644\u0647 \u0648 \u0636\u0639\u0641 \u062f\u0641\u0627\u0639\u06cc \u0631\u0648 \u0645\u0642\u0627\u06cc\u0633\u0647 \u06a9\u0631\u062f\u0647. \u06cc\u0647 \u0646\u06af\u0627\u0647 \u0628\u0647 \u0627\u0645\u062a\u06cc\u0627\u0632 \u0627\u0637\u0645\u06cc\u0646\u0627\u0646 \u0628\u0646\u062f\u0627\u0632 - \u0627\u06af\u0647 \u0628\u0627\u0644\u0627\u06cc \u06f7\u06f0\u066a \u0628\u0648\u062f\u060c \u06cc\u0639\u0646\u06cc \u062f\u0627\u062f\u0647\u200c\u0647\u0627 \u067e\u0634\u062a\u0634 \u0647\u0633\u062a\u0646.",
    "\u0647\u0645\u06cc\u0646 \u0627\u0644\u0627\u0646 \u0627\u067e \u0631\u0648 \u0628\u0627\u0632 \u06a9\u0646 \u0648 \u0628\u0627\u0632\u06cc \u0627\u0645\u0631\u0648\u0632 \u0631\u0648 \u0686\u06a9 \u06a9\u0646. \u0628\u0628\u06cc\u0646 AI \u0628\u0647\u062a \u0686\u06cc \u0645\u06cc\u200c\u06af\u0647. \u0634\u0627\u06cc\u062f \u0627\u0632 \u0646\u062a\u06cc\u062c\u0647\u200c\u0627\u06cc \u06a9\u0647 \u0645\u06cc\u200c\u0628\u06cc\u0646\u06cc \u0634\u0648\u06a9\u0647 \u0628\u0634\u06cc. P.S. \u0627\u0648\u0646 \u062a\u06cc\u0645\u06cc \u06a9\u0647 \u0641\u06a9\u0631 \u0645\u06cc\u200c\u06a9\u0646\u06cc \u0647\u0645\u06cc\u0634\u0647 \u0645\u06cc\u200c\u0628\u0631\u0647\u060c \u0627\u06cc\u0646 \u0628\u0627\u0631 \u0634\u0627\u06cc\u062f \u0646\u0628\u0627\u0632\u0647 - \u0648\u0644\u06cc \u062f\u0627\u062f\u0647\u200c\u0647\u0627 \u0645\u06cc\u200c\u062a\u0648\u0646\u0646 \u062d\u0642\u06cc\u0642\u062a \u0631\u0648 \u0644\u0648 \u0628\u062f\u0647\u0646."
  ],
