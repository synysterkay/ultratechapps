{
  "subject": "\u0634\u0647\u0631 \u0643\u0627\u0645\u0644 \u0645\u0646 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0646\u0642\u064a \u2013 \u0625\u0644\u064a\u0643 \u0645\u0627 \u062d\u0642\u0642\u062a\u0647",
  "preview_text": "\u0644\u0642\u062f \u0645\u0631 28 \u064a\u0648\u0645\u064b\u0627 \u0639\u0644\u0649 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0643 \u0644\u0640 Loudify. \u0647\u0644 \u062a\u0639\u0631\u0641 \u0643\u0645 \u0633\u0627\u0639\u0629 \u0627\u0633\u062a\u0645\u0639\u062a \u0648\u0643\u0645 \u0645\u0631\u0629 \u062a\u0645 \u062a\u062e\u0635\u064a\u0635 \u0627\u0644\u0635\u0648\u062a \u0644\u0643\u061f",
  "body_paragraphs": [
    "\u0644\u0642\u062f \u0645\u0631 \u0634\u0647\u0631 \u0643\u0627\u0645\u0644 \u0645\u0646\u0630 \u0623\u0646 \u0628\u062f\u0623\u062a \u0631\u062d\u0644\u062a\u0643 \u0645\u0639 Loudify. \u0641\u064a 28 \u064a\u0648\u0645\u064b\u0627\u060c \u0627\u0633\u062a\u0645\u0639\u062a \u0625\u0644\u0649 \u0645\u0626\u0627\u062a \u0627\u0644\u0623\u063a\u0627\u0646\u064a\u060c \u0648\u0634\u0627\u0647\u062f\u062a \u0623\u0641\u0644\u0627\u0645\u064b\u0627\u060c \u0648\u0644\u0639\u0628\u062a \u0623\u0644\u0639\u0627\u0628\u064b\u0627\u060c \u0648\u0643\u0644 \u0630\u0644\u0643 \u0628\u0635\u0648\u062a \u0623\u0639\u0644\u0649 \u0648\u0623\u0646\u0642\u0649 \u0645\u0645\u0627 \u062a\u0633\u0645\u062d \u0628\u0647 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0647\u0627\u062a\u0641\u0643. \u0647\u0644 \u062a\u0630\u0643\u0631 \u0639\u0646\u062f\u0645\u0627 \u0643\u0627\u0646 \u0627\u0644\u0635\u0648\u062a \u064a\u062e\u062a\u0641\u064a \u062a\u062d\u062a \u0636\u0648\u0636\u0627\u0621 \u0627\u0644\u0642\u0637\u0627\u0631 \u0623\u0648 \u0627\u0644\u0645\u0631\u0648\u062d\u0629\u061f \u0627\u0644\u0622\u0646\u060c \u0643\u0644 \u0634\u064a\u0621 \u0648\u0627\u0636\u062d.",
    "\u0647\u0630\u0627 \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u062a\u0637\u0628\u064a\u0642 \u2013 \u0625\u0646\u0647\u0627 \u0623\u062f\u0627\u0629 \u062a\u0639\u064a\u062f \u062a\u0639\u0631\u064a\u0641 \u0643\u064a\u0641 \u062a\u0633\u0645\u0639. \u0644\u0642\u062f \u0642\u0645\u0646\u0627 \u0628\u062a\u062d\u0644\u064a\u0644 \u0639\u0627\u062f\u0627\u062a\u0643 \u0627\u0644\u0633\u0645\u0639\u064a\u0629 \u0648\u0623\u0631\u0633\u0644\u0646\u0627 \u0644\u0643 \u062a\u0642\u0631\u064a\u0631 Sound DNA \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u064a. \u0631\u0628\u0645\u0627 \u0644\u0627\u062d\u0638\u062a \u0623\u0646 AutoEQ \u064a\u062a\u0630\u0643\u0631 \u0633\u0645\u0627\u0639\u0627\u062a\u0643 \u0641\u064a \u0643\u0644 \u0645\u0631\u0629 \u062a\u062a\u0635\u0644 \u0628\u0647\u0627. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u062a\u062e\u0635\u064a\u0635 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u060c \u0648\u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u0648\u0639\u062f.",
    "\u0644\u0643\u0646 \u0627\u0644\u0625\u0646\u062c\u0627\u0632 \u0627\u0644\u0623\u0643\u0628\u0631 \u0644\u0645 \u064a\u0623\u062a \u0628\u0639\u062f. \u0641\u064a \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0623\u0648\u0644\u060c \u0645\u0639\u0638\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0644\u0627 \u064a\u0643\u062a\u0634\u0641\u0648\u0646 \u0634\u064a\u0626\u064b\u0627 \u0648\u0627\u062d\u062f\u064b\u0627: \u0645\u064a\u0632\u0629 +200% \u0644\u0644\u0635\u0648\u062a \u0645\u0639 AutoEQ \u0627\u0644\u0645\u062a\u0645\u064a\u0632. \u0647\u0630\u0647 \u0647\u064a \u0627\u0644\u0642\u0641\u0632\u0629 \u0627\u0644\u062a\u064a \u062a\u0641\u0635\u0644 \u0628\u064a\u0646 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u062c\u064a\u062f \u0648\u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0630\u064a \u064a\u0647\u0632\u0643 \u062f\u0648\u0646 \u062a\u0634\u0648\u064a\u0647. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u064a\u0648\u0645 \u0648\u0633\u062a\u0641\u0647\u0645 \u0644\u0645\u0627\u0630\u0627 100,000+ \u0645\u0633\u062a\u0645\u0639 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 Loudify \u0643\u0644 \u064a\u0648\u0645.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062a\u0648\u062c\u0647 \u0625\u0644\u0649 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0635\u0648\u062a \u2013 \u0627\u062e\u062a\u0631 \u0645\u0644\u0641 Podcast \u0623\u0648 Gaming \u0648\u0634\u063a\u0644 +200%. \u0633\u062a\u0633\u0645\u0639 \u0627\u0644\u0641\u0631\u0642 \u0641\u0648\u0631\u064b\u0627. P.S. \u0644\u0627\u062d\u0638 \u0623\u0646 Top Streaks \u064a\u0638\u0647\u0631 \u0644\u0643 \u062a\u0631\u062a\u064a\u0628\u0643 \u0627\u0644\u0639\u0627\u0644\u0645\u064a. \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0631\u064a\u062f \u0627\u0644\u0628\u0642\u0627\u0621 \u0641\u064a \u0627\u0644\u0642\u0645\u0629\u060c \u0644\u0627 \u062a\u0641\u0648\u062a \u064a\u0648\u0645\u064b\u0627 \u0648\u0627\u062d\u062f\u064b\u0627."
  ],
