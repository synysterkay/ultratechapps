{
  "subject": "112 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u043b\u0438 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u043d\u0430 200%",
  "preview_text": "\u0422\u043e, \u0447\u0442\u043e \u043e\u043d\u0438 \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u0438\u043d\u0430\u0447\u0435 \u2014 \u0438 \u043f\u043e\u0447\u0435\u043c\u0443 \u0432\u044b \u043e\u0442\u0441\u0442\u0430\u0435\u0442\u0435, \u0435\u0441\u043b\u0438 \u043d\u0435 \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u0442\u043e \u0436\u0435 \u0441\u0430\u043c\u043e\u0435.",
  "body_paragraphs": [
    "\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0443\u0442\u0440\u043e\u043c 112 \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u043a\u0430\u0447\u0430\u043b\u0438 \u044d\u0442\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u043e\u0434\u043d\u0443 \u0432\u0435\u0449\u044c. \u041e\u043d\u0438 \u0432\u043a\u043b\u044e\u0447\u0438\u043b\u0438 \u0440\u0435\u0436\u0438\u043c \u00ab\u041c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u00bb \u2014 \u0438 \u0441\u043c\u043e\u0442\u0440\u0435\u043b\u0438 \u0432\u0438\u0434\u0435\u043e \u043d\u0430 YouTube \u0431\u0435\u0437 \u0435\u0434\u0438\u043d\u043e\u0433\u043e \u0440\u0435\u043a\u043b\u0430\u043c\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0440\u044b\u0432\u0430. \u0411\u0435\u0437 \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0438\u0445 \u043e\u043a\u043e\u043d. \u0411\u0435\u0437 \u043d\u0430\u0437\u043e\u0439\u043b\u0438\u0432\u044b\u0445 \u0437\u0432\u0443\u043a\u043e\u0432. \u041f\u0440\u043e\u0441\u0442\u043e \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430.",
    "\u041e\u043d\u0438 \u043d\u0435 \u0438\u0441\u043a\u0430\u043b\u0438 \u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0438\u0441\u0441. \u041e\u043d\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0445\u043e\u0442\u0435\u043b\u0438, \u0447\u0442\u043e\u0431\u044b \u0437\u0432\u0443\u043a \u0431\u044b\u043b \u0447\u0438\u0441\u0442\u044b\u043c, \u0431\u0435\u0437 \u043b\u0438\u0448\u043d\u0435\u0433\u043e \u0448\u0443\u043c\u0430. \u0418 \u043e\u043d\u0438 \u043d\u0430\u0448\u043b\u0438 \u044d\u0442\u043e \u0437\u0434\u0435\u0441\u044c. 200% \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u044f, \u043d\u043e\u043b\u044c \u0440\u0435\u043a\u043b\u0430\u043c\u044b, \u043d\u043e\u043b\u044c \u043f\u0440\u0435\u0440\u044b\u0432\u0430\u043d\u0438\u0439. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 \u00ab\u043f\u043e\u0434\u043e\u0436\u0434\u0438\u0442\u0435 5 \u0441\u0435\u043a\u0443\u043d\u0434\u00bb, \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u00ab\u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u043f\u0440\u0435\u043c\u0438\u0443\u043c\u00bb \u043a\u0430\u0436\u0434\u044b\u0435 10 \u043c\u0438\u043d\u0443\u0442.",
    "\u0424\u0443\u043d\u043a\u0446\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043e\u043d\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438 \u2014 \u0430\u0432\u0442\u043e-\u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u0438 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u043e\u0432. \u0417\u0430\u0439\u0434\u0438\u0442\u0435 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u00ab\u0410\u0432\u0442\u043e\u0431\u0443\u0441\u0442\u00bb. \u042d\u0442\u043e \u0432\u0441\u0451. \u041a\u0430\u043a \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u044b \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u0435 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438, \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0441\u0430\u043c\u043e \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0435. \u0411\u0435\u0437 \u044d\u043a\u0440\u0430\u043d\u043e\u0432, \u0431\u0435\u0437 \u043a\u043d\u043e\u043f\u043e\u043a, \u0431\u0435\u0437 \u043e\u0442\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0439.",
    "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435, \u0432\u043a\u043b\u044e\u0447\u0435\u043d \u043b\u0438 \u0443 \u0432\u0430\u0441 \u0430\u0432\u0442\u043e-\u0431\u0443\u0441\u0442. \u0415\u0441\u043b\u0438 \u043d\u0435\u0442 \u2014 \u0441\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e. 112 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0443\u0436\u0435 \u0432\u043f\u0435\u0440\u0435\u0434\u0438. P.S. \u042d\u0442\u043e \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e. \u041f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c."
  ],
