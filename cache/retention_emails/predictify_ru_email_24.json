{
  "subject": "\u042f \u043d\u0435 \u0432\u0435\u0440\u0438\u043b \u0432 Predictify. \u0412\u043e\u0442 \u0447\u0442\u043e \u044f \u043f\u043e\u043d\u044f\u043b \u0447\u0435\u0440\u0435\u0437 \u043c\u0435\u0441\u044f\u0446",
  "preview_text": "\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u043e\u0434\u043d\u043e\u0433\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u043d\u0430\u0448\u0443 \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0432\u0441\u0451. \u0427\u0438\u0442\u0430\u0439, \u043f\u043e\u043a\u0430 \u043d\u0435 \u0443\u0434\u0430\u043b\u0438\u043b.",
  "body_paragraphs": [
    "\u0421\u043b\u0443\u0448\u0430\u0439, \u0443 \u043d\u0430\u0441 \u0431\u044b\u043b \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c. \u0417\u043e\u0432\u0443\u0442 \u0414\u043c\u0438\u0442\u0440\u0438\u0439. \u041e\u043d \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b Predictify, \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0432 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443: '\u0412\u0430\u0448\u0430 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u2014 \u0444\u0438\u0433\u043d\u044f. \u042f \u043b\u0443\u0447\u0448\u0435 \u0437\u043d\u0430\u044e \u0444\u0443\u0442\u0431\u043e\u043b'. \u0418 \u0443\u0448\u0451\u043b. \u0427\u0435\u0440\u0435\u0437 \u0442\u0440\u0438 \u043d\u0435\u0434\u0435\u043b\u0438 \u043e\u043d \u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f. \u0420\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0435\u0433\u043e '\u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u044b\u0435' \u0441\u0442\u0430\u0432\u043a\u0438 \u043f\u0440\u043e\u0433\u043e\u0440\u0435\u043b\u0438 \u0442\u0440\u0438 \u0440\u0430\u0437\u0430 \u043f\u043e\u0434\u0440\u044f\u0434, \u0430 \u0434\u0440\u0443\u0437\u044c\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438\u0441\u044c AI, \u0432\u044b\u0438\u0433\u0440\u044b\u0432\u0430\u043b\u0438. \u041e\u043d \u043f\u0440\u0438\u0437\u043d\u0430\u043b\u0441\u044f: '\u042f \u0431\u044b\u043b \u0438\u0434\u0438\u043e\u0442\u043e\u043c'. \u0418 \u044d\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043b\u043e \u043d\u0430\u0441 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\u0441\u044f.",
    "\u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u043d\u0430\u0447\u0430\u043b \u0441 \u0431\u0430\u0437\u043e\u0432\u044b\u0445 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u043e\u0432 \u2014 \u043d\u0430 \u0410\u041f\u041b. AI \u043f\u043e\u043a\u0430\u0437\u0430\u043b 85% \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043d\u0430 \u043f\u043e\u0431\u0435\u0434\u0443 \u0410\u0440\u0441\u0435\u043d\u0430\u043b\u0430, \u043d\u043e \u0414\u0438\u043c\u043e\u043d \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043d\u0430 \u043d\u0438\u0447\u044c\u044e. '\u0413\u043b\u0430\u0437\u0430 \u0441\u043a\u0430\u0437\u0430\u043b\u0438 \u043e\u0434\u043d\u043e, \u0434\u0430\u043d\u043d\u044b\u0435 \u2014 \u0434\u0440\u0443\u0433\u043e\u0435'. \u041f\u0440\u043e\u0438\u0433\u0440\u0430\u043b. \u041f\u043e\u0442\u043e\u043c \u043e\u043d \u0432\u043a\u043b\u044e\u0447\u0438\u043b \u0430\u043d\u0430\u043b\u0438\u0437 xG \u0438 \u0442\u0430\u043a\u0442\u0438\u043a\u0438. \u0423\u0432\u0438\u0434\u0435\u043b, \u0447\u0442\u043e \u0443 \u0421\u0438\u0442\u0438 \u043e\u0436\u0438\u0434\u0430\u0435\u043c\u044b\u0435 \u0433\u043e\u043b\u044b (xG) 2.4 \u043f\u0440\u043e\u0442\u0438\u0432 0.8 \u2014 \u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u043e \u0434\u0430\u043d\u043d\u044b\u043c. \u0412\u044b\u0438\u0433\u0440\u0430\u043b. \u0422\u0435\u043f\u0435\u0440\u044c \u043e\u043d \u043d\u0435 \u0434\u0435\u043b\u0430\u0435\u0442 \u0441\u0442\u0430\u0432\u043a\u0443 \u0431\u0435\u0437 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0447\u0435\u0440\u0435\u0437 AI. \u0415\u0433\u043e \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u0432\u044b\u0440\u043e\u0441\u043b\u0430 \u0441 40% \u0434\u043e 72%.",
    "\u0418 \u0432\u043e\u0442 \u0447\u0442\u043e \u044f \u0445\u043e\u0447\u0443 \u0441\u043a\u0430\u0437\u0430\u0442\u044c: Predictify \u043d\u0435 \u043c\u0430\u0433\u0438\u044f. \u042d\u0442\u043e \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442. \u0415\u0441\u043b\u0438 \u0442\u044b \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0448\u044c '\u0414\u0435\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u043c\u0430\u0442\u0447\u0430' \u0438 '\u0421\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 xG', \u0442\u044b \u0442\u0435\u0440\u044f\u0435\u0448\u044c \u0434\u0435\u043d\u044c\u0433\u0438. \u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043d\u0430\u0439\u0434\u0438 \u043b\u044e\u0431\u043e\u0439 \u043c\u0430\u0442\u0447 \u041b\u0427 \u043d\u0430 \u044d\u0442\u043e\u0439 \u043d\u0435\u0434\u0435\u043b\u0435, \u043d\u0430\u0436\u043c\u0438 \u043d\u0430 '\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u043a\u0430' \u2014 \u0438 \u0442\u044b \u0443\u0432\u0438\u0434\u0438\u0448\u044c, \u043a\u0430\u043a AI \u0440\u0430\u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442 \u043a\u0430\u0436\u0434\u0443\u044e \u0430\u0442\u0430\u043a\u0443. \u0411\u0435\u0437 \u044d\u0442\u043e\u0433\u043e \u0442\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0433\u0430\u0434\u044b\u0432\u0430\u0435\u0448\u044c.",
    "\u041f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0437\u0430\u0439\u0434\u0438 \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043e\u0442\u043a\u0440\u043e\u0439 \u0440\u0430\u0437\u0434\u0435\u043b '\u041f\u0440\u043e\u0433\u043d\u043e\u0437 \u0434\u043d\u044f' \u0438 \u0441\u0440\u0430\u0432\u043d\u0438 \u0441\u0432\u043e\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0441 AI. \u0415\u0441\u043b\u0438 \u0442\u0432\u043e\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0445\u0443\u0436\u0435, \u0447\u0435\u043c \u0443 AI, \u2014 \u0437\u043d\u0430\u0447\u0438\u0442, \u043f\u043e\u0440\u0430 \u043c\u0435\u043d\u044f\u0442\u044c \u043f\u043e\u0434\u0445\u043e\u0434. P.S. \u0414\u043c\u0438\u0442\u0440\u0438\u0439 \u0442\u0435\u043f\u0435\u0440\u044c \u0432 \u0442\u043e\u043f-10 \u043d\u0430\u0448\u0435\u0433\u043e IQ-\u043a\u0432\u0438\u0437\u0430. \u0421\u043f\u043e\u0440\u0438\u043c, \u0442\u044b \u043d\u0435 \u0441\u043c\u043e\u0436\u0435\u0448\u044c \u0435\u0433\u043e \u043e\u0431\u043e\u0439\u0442\u0438?",
    ""
