{
  "subject": "\u041f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u0435: \u044f \u043f\u0438\u0441\u0430\u043b \u043a\u043e\u0434 \u0432 2 \u043d\u043e\u0447\u0438",
  "preview_text": "\u041f\u043e\u0447\u0435\u043c\u0443 \u044f \u043d\u0435 \u0441\u043f\u0430\u043b, \u043f\u043e\u043a\u0430 \u0442\u044b \u0441\u043b\u0443\u0448\u0430\u043b \u0442\u0440\u0435\u043a\u0438. \u0418\u0441\u0442\u043e\u0440\u0438\u044f, \u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0441\u0442\u043e\u0438\u0442 \u043e\u0434\u043d\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u044f.",
  "body_paragraphs": [
    "\u0411\u044b\u043b\u043e 2:03 \u043d\u043e\u0447\u0438. \u042f \u0441\u0438\u0434\u0435\u043b \u0441 \u0447\u0430\u0448\u043a\u043e\u0439 \u043e\u0441\u0442\u044b\u0432\u0448\u0435\u0433\u043e \u043a\u043e\u0444\u0435, \u0441\u043b\u0443\u0448\u0430\u043b \u0431\u0438\u0442 \u043d\u0430 \u0441\u0432\u043e\u0438\u0445 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u0445 \u0438 \u0437\u043b\u0438\u043b\u0441\u044f. \u041f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0435 \u044d\u0442\u043e\u0442 \u0442\u0440\u0435\u043a \u0437\u0432\u0443\u0447\u0430\u043b \u043a\u0430\u043a \u043a\u043e\u043d\u0441\u0435\u0440\u0432\u043d\u0430\u044f \u0431\u0430\u043d\u043a\u0430. \u041d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0431\u0430\u0441\u0430, \u043d\u0438\u043a\u0430\u043a\u043e\u0439 \u044d\u043d\u0435\u0440\u0433\u0438\u0438. \u041f\u0440\u043e\u0441\u0442\u043e \u043f\u043b\u043e\u0441\u043a\u0438\u0439 \u0437\u0432\u0443\u043a. \u0418 \u044f \u043f\u043e\u043d\u044f\u043b: \u0435\u0441\u043b\u0438 \u044f, \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u043d\u0435 \u043c\u043e\u0433\u0443 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e \u0441\u043b\u0443\u0448\u0430\u0442\u044c \u043c\u0443\u0437\u044b\u043a\u0443 \u043d\u0430 \u0441\u0432\u043e\u0451\u043c \u0436\u0435 \u0434\u0435\u0432\u0430\u0439\u0441\u0435 \u2014 \u0447\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u043e \u0442\u0435\u0431\u0435?",
    "\u042f \u043d\u0435 \u0445\u043e\u0442\u0435\u043b \u0434\u0435\u043b\u0430\u0442\u044c \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0439 \u00ab\u0443\u0441\u0438\u043b\u0438\u0442\u0435\u043b\u044c\u00bb, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u0448\u0438\u043f\u0435\u043d\u0438\u044f. \u041c\u043d\u0435 \u043d\u0443\u0436\u043d\u043e \u0431\u044b\u043b\u043e, \u0447\u0442\u043e\u0431\u044b \u0442\u044b \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0441\u0443\u0431\u0431\u0430\u0441 \u0432 \u0433\u0440\u0443\u0434\u0438, \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u0443 \u0442\u0435\u0431\u044f \u0434\u0435\u0448\u0451\u0432\u044b\u0435 \u0437\u0430\u0442\u044b\u0447\u043a\u0438. \u0427\u0442\u043e\u0431\u044b \u0443\u0434\u0430\u0440 \u043c\u0430\u043b\u043e\u0433\u043e \u0431\u0430\u0440\u0430\u0431\u0430\u043d\u0430 \u043f\u0440\u043e\u0431\u0438\u0432\u0430\u043b, \u0430 \u043d\u0435 \u0442\u043e\u043d\u0443\u043b \u0432 \u0448\u0443\u043c\u0435 \u0443\u043b\u0438\u0446\u044b. \u0422\u0430\u043a \u0440\u043e\u0434\u0438\u043b\u0430\u0441\u044c \u043e\u0434\u043d\u0430 \u0444\u0438\u0447\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u044f \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043b \u0434\u043e 4 \u0443\u0442\u0440\u0430. \u042f \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0437\u044f\u043b \u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0435\u0442 \u043d\u0438\u0437\u043a\u0438\u0435 \u0447\u0430\u0441\u0442\u043e\u0442\u044b, \u043d\u0435 \u043b\u043e\u043c\u0430\u044f \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u0437\u0432\u0443\u043a. \u0418 \u0434\u0430 \u2014 \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043d\u0430 \u0432\u0441\u0451\u043c: Spotify, YouTube, TikTok.",
    "\u042d\u0442\u043e \u0442\u0430 \u0441\u0430\u043c\u0430\u044f \u043a\u043d\u043e\u043f\u043a\u0430 Bass Virtualizer \u0432 \u0442\u0432\u043e\u0451\u043c \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438. \u042f \u0437\u043d\u0430\u044e, \u0447\u0442\u043e \u043c\u043d\u043e\u0433\u0438\u0435 \u0435\u0451 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u044e\u0442, \u043d\u043e \u043e\u043d\u0430 \u2014 \u0441\u0435\u0440\u0434\u0446\u0435 Bass Booster. \u0412\u043a\u043b\u044e\u0447\u0438 \u0435\u0451 \u0441\u0435\u0439\u0447\u0430\u0441 \u2014 \u0438 \u0443\u0441\u043b\u044b\u0448\u0438\u0448\u044c \u0440\u0430\u0437\u043d\u0438\u0446\u0443. \u0414\u0430\u0436\u0435 \u043d\u0430 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0445 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u0445 \u0431\u0430\u0441 \u0441\u0442\u0430\u043d\u0435\u0442 \u043f\u043b\u043e\u0442\u043d\u044b\u043c, \u043e\u0431\u044a\u0451\u043c\u043d\u044b\u043c. \u0410 \u0435\u0441\u043b\u0438 \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c 3D Surround, \u0442\u0440\u0435\u043a \u043e\u0431\u0435\u0440\u043d\u0451\u0442 \u0442\u0435\u0431\u044f \u0441\u043e \u0432\u0441\u0435\u0445 \u0441\u0442\u043e\u0440\u043e\u043d. \u041f\u043e\u0432\u0435\u0440\u044c, \u044f \u043d\u0435 \u0441\u043f\u0430\u043b \u044d\u0442\u0443 \u043d\u043e\u0447\u044c, \u0447\u0442\u043e\u0431\u044b \u0442\u044b \u043c\u043e\u0433 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0436\u0430\u0442\u044c \u043e\u0434\u043d\u0443 \u043a\u043d\u043e\u043f\u043a\u0443 \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0437\u0432\u0443\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u043d\u044c\u0448\u0435 \u0434\u0430\u0432\u0430\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u043e\u043b\u043e\u043d\u043a\u0438 \u0437\u0430 500 \u0431\u0430\u043a\u0441\u043e\u0432.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041d\u0430\u0436\u043c\u0438 \u043d\u0430 Bass Virtualizer \u0438 \u0432\u043a\u043b\u044e\u0447\u0438 \u043b\u044e\u0431\u043e\u0439 \u0442\u0440\u0435\u043a \u0441 \u043c\u043e\u0449\u043d\u044b\u043c \u0431\u0438\u0442\u043e\u043c \u2014 EDM, \u0445\u0438\u043f-\u0445\u043e\u043f \u0438\u043b\u0438 \u0440\u043e\u043a. \u0421\u0434\u0435\u043b\u0430\u0439 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u043d\u0430 70% \u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043b\u0443\u0448\u0430\u0439. P.S. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u043f\u043e\u043b\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u2014 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u043f\u0440\u0435\u043c\u0438\u0443\u043c \u043d\u0430 7 \u0434\u043d\u0435\u0439 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e. \u0422\u0430\u043c 10-\u043f\u043e\u043b\u043e\u0441\u043d\u044b\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u044f \u0434\u043e\u043f\u0438\u043b\u0438\u0432\u0430\u043b \u0432 \u0442\u0443 \u0436\u0435 \u043d\u043e\u0447\u044c. \u0423\u0432\u0435\u0440\u0435\u043d, \u0442\u044b \u043e\u0446\u0435\u043d\u0438\u0448\u044c."
