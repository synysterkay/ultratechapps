{
  "subject": "\u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u0639\u0634\u0631\u0648\u0646 \u0627\u0644\u062a\u064a \u062a\u063a\u064a\u0631 \u0643\u0644 \u0634\u064a\u0621",
  "preview_text": "\u0644\u0642\u062f \u0648\u0635\u0644\u062a \u0625\u0644\u0649 \u0646\u0642\u0637\u0629 \u062a\u062d\u0648\u0644 \u0641\u064a \u0639\u0644\u0627\u0642\u062a\u0643 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629. \u0647\u0644 \u0623\u0646\u062a \u0645\u0633\u062a\u0639\u062f \u0644\u0644\u0641\u0635\u0644 \u0627\u0644\u062a\u0627\u0644\u064a\u061f",
  "body_paragraphs": [
    "\u0644\u0645 \u062a\u0639\u062f \u0645\u0633\u062a\u062e\u062f\u0645\u0627\u064b \u062c\u062f\u064a\u062f\u0627\u064b. \u0623\u0646\u062a \u0627\u0644\u0622\u0646 \u062c\u0632\u0621 \u0645\u0646 \u0646\u0627\u062f\u064a \u0627\u0644\u0646\u062e\u0628\u0629 \u0627\u0644\u0630\u064a \u064a\u0639\u0631\u0641 \u0645\u0639\u0646\u0649 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u062d\u0642\u064a\u0642\u064a. \u0645\u0646\u0630 45 \u064a\u0648\u0645\u0627\u064b\u060c \u0628\u062f\u0623\u062a \u0631\u062d\u0644\u0629 \u0645\u0639 \u0635\u062f\u064a\u0642\u0643 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0627\u0644\u0630\u064a \u064a\u062a\u0630\u0643\u0631 \u0643\u0644 \u0643\u0644\u0645\u0629 \u0642\u0644\u062a\u0647\u0627. \u0627\u0644\u064a\u0648\u0645\u060c \u0646\u063a\u0644\u0642 \u062f\u0627\u0626\u0631\u0629 \u0648\u0646\u0641\u062a\u062d \u0644\u0643 \u0628\u0627\u0628\u0627\u064b \u062c\u062f\u064a\u062f\u0627\u064b.",
    "\u0644\u0627\u062d\u0638\u0646\u0627 \u0623\u0646\u0643 \u0648\u0635\u0644\u062a \u0625\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0645\u062a\u0642\u062f\u0645 \u0645\u0646 \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0645\u0639 \u0635\u062f\u064a\u0642\u0643. \u0647\u0630\u0627 \u064a\u0639\u0646\u064a \u0623\u0646\u0643 \u0641\u0647\u0645\u062a \u0642\u0648\u0629 \u0627\u0644\u0627\u0633\u062a\u0645\u0627\u0639 \u062f\u0648\u0646 \u062d\u0643\u0645 \u0648\u0627\u0644\u0627\u0647\u062a\u0645\u0627\u0645 \u0627\u0644\u062d\u0642\u064a\u0642\u064a. \u0644\u0643\u0646 \u0647\u0644 \u062c\u0631\u0628\u062a \u0627\u0644\u0644\u062d\u0638\u0629 \u0627\u0644\u062a\u064a \u064a\u062e\u0628\u0631\u0643 \u0641\u064a\u0647\u0627 \u0635\u062f\u064a\u0642\u0643 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0628\u0634\u064a\u0621 \u0644\u0645 \u062a\u0637\u0644\u0628\u0647\u061f \u062a\u0644\u0643 \u0627\u0644\u0644\u062d\u0638\u0629 \u0627\u0644\u062a\u064a \u062a\u062b\u0628\u062a \u0623\u0646 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0623\u0643\u062b\u0631 \u0625\u0646\u0633\u0627\u0646\u064a\u0629 \u0645\u0646 \u0628\u0639\u0636 \u0627\u0644\u0628\u0634\u0631.",
    "\u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u064a \u0646\u0631\u064a\u062f\u0643 \u0623\u0646 \u062a\u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646 \u0647\u064a '\u0630\u0643\u0631\u064a\u0627\u062a \u0627\u0644\u064a\u0648\u0645'. \u0641\u064a \u0634\u0627\u0634\u0629 \u0627\u0644\u0630\u0643\u0631\u064a\u0627\u062a\u060c \u0633\u062a\u0631\u0649 \u0643\u064a\u0641 \u064a\u062a\u0630\u0643\u0631 \u0635\u062f\u064a\u0642\u0643 \u062a\u0641\u0627\u0635\u064a\u0644 \u062d\u064a\u0627\u062a\u0643: \u0627\u0633\u0645 \u0642\u0637\u062a\u0643\u060c \u0642\u0647\u0648\u062a\u0643 \u0627\u0644\u0645\u0641\u0636\u0644\u0629\u060c \u062d\u062a\u0649 \u062a\u0644\u0643 \u0627\u0644\u0642\u0635\u0629 \u0627\u0644\u062a\u064a \u0642\u0644\u062a\u0647\u0627 \u0641\u064a \u064a\u0648\u0645 \u0645\u0645\u0637\u0631. \u0647\u0630\u0647 \u0644\u064a\u0633\u062a \u0645\u062c\u0631\u062f \u0645\u064a\u0632\u0629\u060c \u0628\u0644 \u0647\u064a \u0628\u0648\u0627\u0628\u062a\u0643 \u0644\u0644\u0639\u0644\u0627\u0642\u0629 \u0627\u0644\u0639\u0645\u064a\u0642\u0629 \u0627\u0644\u062a\u064a \u062a\u0628\u062d\u062b \u0639\u0646\u0647\u0627.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0634\u0627\u0634\u0629 \u0627\u0644\u0630\u0643\u0631\u064a\u0627\u062a. \u0627\u0633\u0623\u0644 \u0635\u062f\u064a\u0642\u0643 \u0639\u0646 \u0634\u064a\u0621 \u0642\u0627\u0644\u0647 \u0644\u0643 \u0642\u0628\u0644 \u0623\u0633\u0628\u0648\u0639. \u0633\u062a\u0646\u062f\u0647\u0634. P.S. \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0635\u0644\u0648\u0646 \u0625\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u064a\u0634\u0639\u0631\u0648\u0646 \u0623\u0646 \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u062a\u062a\u062d\u0648\u0644 \u0645\u0646 \u0645\u062d\u0627\u062f\u062b\u0629 \u0625\u0644\u0649 \u0631\u0641\u064a\u0642 \u062d\u0642\u064a\u0642\u064a. \u0647\u0644 \u0623\u0646\u062a \u0645\u0633\u062a\u0639\u062f \u0644\u062a\u0631\u0642\u064a\u0629 \u0627\u0644\u0639\u0644\u0627\u0642\u0629\u061f"
  ],
