  "preview_text": "\u4f60\u4e0d\u662f\u65b0\u624b\u4e86\uff0c\u4eca\u665a\u7684\u7ea6\u4f1a\u503c\u5f97\u4e00\u4e2a\u66f4\u6df1\u7684\u8fde\u63a5\u3002\u6253\u5f00SoulPlan\uff0c\u770b\u770b\u4e13\u5c5e\u4f60\u7684\u4e0b\u4e00\u6b65\u3002",
  "body_paragraphs": [
    "45\u5929\u524d\uff0c\u4f60\u4e0b\u8f7d\u4e86SoulPlan\uff0c\u5f00\u59cb\u4e3a\u4f60\u4eec\u4fe9\u8ba1\u5212\u7279\u522b\u7684\u4e00\u665a\u3002\u8fd8\u8bb0\u5f97\u7b2c\u4e00\u6b21\u70b9\u5f00\u2018\u4eca\u665a\u7684\u7ea6\u4f1a\u2019\u65f6\uff0c\u90a3\u79cd\u597d\u5947\u548c\u671f\u5f85\u5417\uff1f\u73b0\u5728\uff0c\u4f60\u4e0d\u518d\u662f\u90a3\u4e2a\u65b0\u4eba\u2014\u2014\u4f60\u662f\u90a3\u4e2a\u61c2\u5f97\u628a\u6d6a\u6f2b\u53d8\u6210\u4e60\u60ef\u7684\u4eba\u3002",
    "\u5176\u5b9e\uff0c\u6700\u8ba9\u4eba\u4e0a\u763e\u7684\u4e0d\u662f\u90a3\u4e9b\u7cbe\u5fc3\u7b56\u5212\u7684\u60ca\u559c\uff0c\u800c\u662f\u90a3\u4efd\u2018\u6211\u61c2\u4f60\u2019\u7684\u9ed8\u5951\u3002\u5f53\u4f60\u8f7b\u8f7b\u4e00\u6309\uff0c\u53d1\u9001\u4e00\u4e2a\u4ed6\u559c\u6b22\u7684\u6cbb\u6108\u7cfb\u591c\u665a\uff0c\u6536\u5230\u7684\u662f\u4ed6\u5c4f\u5e55\u4e0a\u7684\u2018\u4eca\u665a\u60f3\u4f60\u2019\u2014\u2014\u90a3\u4e00\u523b\uff0c\u4f60\u4eec\u4e4b\u95f4\u7684\u8ddd\u79bb\u6d88\u5931\u4e86\u3002\u8fd9\u4e0d\u662f\u666e\u901a\u7684\u529f\u80fd\uff0c\u8fd9\u662f\u4f60\u4eec\u7684\u8bed\u8a00\u3002",
    "\u73b0\u5728\uff0c\u771f\u6b63\u7684\u597d\u620f\u624d\u521a\u5f00\u59cb\u3002\u6253\u5f00\u2018\u8bb0\u5fc6\u65f6\u95f4\u7ebf\u2019\uff0c\u770b\u770b\u4f60\u4eec\u5df2\u7ecf\u753b\u4e0b\u7684\u90a3\u4e9b\u95ea\u5149\u77ac\u95f4\u2014\u2014\u6bcf\u4e00\u5f20\u7167\u7247\u3001\u6bcf\u4e00\u53e5\u7b14\u8bb0\uff0c\u90fd\u662f\u4f60\u4eec\u7684\u6545\u4e8b\u3002\u4f46\u522b\u505c\u5728\u8fd9\u91cc\uff0c\u4eca\u665a\u8bd5\u8bd5\u2018\u60ca\u559c\u6a21\u5f0f\u2019\uff0c\u8ba9AI\u4ece\u4f60\u4eec\u4fe9\u7684\u613f\u671b\u6e05\u5355\u91cc\u6311\u4e00\u4e2a\u70b9\u5b50\uff0c\u5236\u9020\u4e00\u4e2a\u610f\u60f3\u4e0d\u5230\u7684\u591c\u665a\u3002",
