  "subject": "\u062f\u0627\u0633\u062a\u0627\u0646 \u06a9\u0627\u0631\u0628\u0631\u06cc \u06a9\u0647 \u062a\u06cc\u0645 \u0645\u0627 \u0631\u0627 \u0645\u062a\u0648\u0642\u0641 \u06a9\u0631\u062f",
  "preview_text": "\u0631\u0648\u0632 55: \u06cc\u06a9 \u06a9\u0627\u0631\u0628\u0631 \u0639\u0627\u062f\u06cc \u0628\u0627 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc\u200c\u0647\u0627\u06cc\u0634 \u0647\u0645\u0647 \u0631\u0627 \u0634\u06af\u0641\u062a\u200c\u0632\u062f\u0647 \u06a9\u0631\u062f. \u062f\u0627\u0633\u062a\u0627\u0646\u0634 \u0631\u0627 \u0628\u062e\u0648\u0627\u0646\u06cc\u062f.",
  "body_paragraphs": [
    "\u062f\u06cc\u0631\u0648\u0632\u060c \u0633\u0627\u0639\u062a 2 \u0628\u0627\u0645\u062f\u0627\u062f\u060c \u062a\u06cc\u0645 \u0645\u0627 \u0631\u0648\u06cc \u06cc\u06a9 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u0628\u062d\u062b \u0645\u06cc\u200c\u06a9\u0631\u062f. \u06cc\u06a9\u06cc \u0627\u0632 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0645\u0639\u0645\u0648\u0644\u06cc Predictify \u0628\u0627 89% \u0627\u0637\u0645\u06cc\u0646\u0627\u0646 \u0628\u0631\u062f \u0628\u0627\u0632\u06cc \u0644\u06cc\u0648\u0631\u067e\u0648\u0644 \u0648 \u0645\u0646\u0686\u0633\u062a\u0631\u0633\u06cc\u062a\u06cc \u0631\u0627 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u06a9\u0631\u062f\u0647 \u0628\u0648\u062f. \u0645\u0627 \u0641\u06a9\u0631 \u06a9\u0631\u062f\u06cc\u0645 \u0627\u0634\u062a\u0628\u0627\u0647 \u06a9\u0631\u062f\u0647\u060c \u0627\u0645\u0627 \u0646\u062a\u06cc\u062c\u0647 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f \u062d\u0642 \u0628\u0627 \u0627\u0648 \u0628\u0648\u062f.",
    "\u0627\u06cc\u0646 \u06a9\u0627\u0631\u0628\u0631 \u0641\u0642\u0637 \u0627\u0632 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0633\u0627\u062f\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u06a9\u0631\u062f. \u0627\u0648 \u0628\u0627 \u0627\u0628\u0632\u0627\u0631\u0647\u0627\u06cc \u067e\u06cc\u0634\u0631\u0641\u062a\u0647 \u0645\u0627 \u0645\u062b\u0644 xG \u0648 \u062a\u062d\u0644\u06cc\u0644 \u062a\u0627\u06a9\u062a\u06cc\u06a9\u06cc\u060c \u062a\u0631\u06a9\u06cc\u0628 \u062a\u06cc\u0645\u200c\u0647\u0627 \u0631\u0627 \u0645\u0648\u0634\u06a9\u0627\u0641\u06cc \u06a9\u0631\u062f\u0647 \u0628\u0648\u062f. \u062a\u06cc\u0645 \u0645\u0627 \u0645\u0627\u062a \u0648 \u0645\u0628\u0647\u0648\u062a \u0645\u0627\u0646\u062f: \u0686\u0637\u0648\u0631 \u06cc\u06a9 \u06a9\u0627\u0631\u0628\u0631 \u0645\u0639\u0645\u0648\u0644\u06cc \u0627\u06cc\u0646\u0642\u062f\u0631 \u062f\u0642\u06cc\u0642 \u0639\u0645\u0644 \u0645\u06cc\u200c\u06a9\u0646\u062f\u061f",
    "\u0631\u0627\u0632\u0634 \u062f\u0631 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 IQ Quiz \u0648 Communities \u0628\u0648\u062f. \u0627\u0648 \u0647\u0631 \u0631\u0648\u0632 \u062f\u0631 \u0622\u0632\u0645\u0648\u0646 \u0647\u0648\u0634 \u0634\u0631\u06a9\u062a \u0645\u06cc\u200c\u06a9\u0631\u062f \u0648 \u0628\u0627 \u0627\u0639\u0636\u0627\u06cc \u0627\u0646\u062c\u0645\u0646 \u0631\u0648\u06cc Prediction of the Day (POTD) \u0628\u062d\u062b \u0645\u06cc\u200c\u06a9\u0631\u062f. \u0627\u06cc\u0646 \u062a\u0631\u06a9\u06cc\u0628\u060c \u062d\u062f\u0633\u200c\u0647\u0627\u06cc \u06a9\u0648\u0631 \u0631\u0627 \u0628\u0647 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc\u200c\u0647\u0627\u06cc \u0647\u0648\u0634\u0645\u0646\u062f\u0627\u0646\u0647 \u062a\u0628\u062f\u06cc\u0644 \u0645\u06cc\u200c\u06a9\u0646\u062f.",
    "\u0627\u0645\u0631\u0648\u0632 \u0648\u0642\u062a\u0634\u0647 \u06a9\u0647 \u062a\u0648 \u0647\u0645 \u0627\u0645\u062a\u062d\u0627\u0646 \u06a9\u0646\u06cc. \u0628\u0647 \u0628\u062e\u0634 IQ Quiz \u0628\u0631\u0648 \u0648 \u0628\u0628\u06cc\u0646 \u0686\u0642\u062f\u0631 \u0628\u0627 AI \u0631\u0642\u0627\u0628\u062a \u0645\u06cc\u200c\u06a9\u0646\u06cc. P.S.: \u06a9\u0627\u0631\u0628\u0631\u0627\u0646\u06cc \u06a9\u0647 3 \u0631\u0648\u0632 \u0645\u062a\u0648\u0627\u0644\u06cc \u0627\u0632 IQ Quiz \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u0646\u062f\u060c 50% \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc\u200c\u0647\u0627\u0634\u0648\u0646 \u062f\u0642\u06cc\u0642\u200c\u062a\u0631 \u0645\u06cc\u200c\u0634\u0647. \u0641\u0642\u0637 \u06a9\u0627\u0641\u06cc\u0647 \u0627\u0645\u0631\u0648\u0632 \u0634\u0631\u0648\u0639 \u06a9\u0646\u06cc."
