{
  "subject": "\u0633\u0631 \u062d\u0630\u0641 500 \u0631\u0633\u0627\u0644\u0629 \u0641\u064a 3 \u062f\u0642\u0627\u0626\u0642",
  "preview_text": "\u0642\u0631\u064a\u0628\u064b\u0627 \u062c\u062f\u064b\u0627 \u0645\u064a\u0632\u0629 \u062c\u062f\u064a\u062f\u0629 \u0633\u062a\u063a\u064a\u0631 \u0639\u0644\u0627\u0642\u062a\u0643 \u0645\u0639 \u062d\u0628\u064a\u0628\u062a\u0643 \u0627\u0644\u0630\u0643\u064a\u0629... \u0644\u0646 \u062a\u062e\u0645\u0646 \u0623\u0628\u062f\u064b\u0627 \u0645\u0627 \u0647\u064a",
  "body_paragraphs": [
    "\u0644\u0627\u062d\u0638\u0646\u0627 \u0634\u064a\u0626\u064b\u0627 \u063a\u0631\u064a\u0628\u064b\u0627 \u0641\u064a \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0645\u0627\u0636\u064a. 500 \u0645\u0633\u062a\u062e\u062f\u0645 \u062d\u0630\u0641\u0648\u0627 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0623\u0644\u0641 \u0631\u0633\u0627\u0644\u0629 \u0641\u064a 3 \u062f\u0642\u0627\u0626\u0642 \u0641\u0642\u0637. \u0644\u0645\u0627\u0630\u0627\u061f \u0644\u0623\u0646\u0647\u0645 \u0627\u0643\u062a\u0634\u0641\u0648\u0627 \u0634\u064a\u0626\u064b\u0627 \u0644\u0645 \u0646\u0639\u0644\u0646 \u0639\u0646\u0647 \u0628\u0639\u062f. \u0627\u0644\u0623\u0645\u0631 \u064a\u062a\u0639\u0644\u0642 \u0628\u0637\u0631\u064a\u0642\u0629 \u062c\u062f\u064a\u062f\u0629 \u0644\u0627\u0633\u062a\u0631\u062c\u0627\u0639 \u0630\u0643\u0631\u064a\u0627\u062a\u0643 \u0627\u0644\u0645\u0641\u0636\u0644\u0629 \u062f\u0648\u0646 \u0627\u0644\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0627\u062a.",
    "\u0623\u0646\u062a \u0645\u0646 \u0623\u0648\u0627\u0626\u0644 \u0645\u0646 \u0633\u064a\u0639\u0631\u0641 \u0647\u0630\u0627: \u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u0642\u0627\u062f\u0645\u0629 \u0633\u062a\u0633\u0645\u062d \u0644\u062d\u0628\u064a\u0628\u062a\u0643 \u0627\u0644\u0630\u0643\u064a\u0629 \u0628\u0625\u0631\u0633\u0627\u0644 \u0644\u0643 \u0645\u0644\u062e\u0635\u064b\u0627 \u0623\u0633\u0628\u0648\u0639\u064a\u064b\u0627 \u0644\u0623\u062c\u0645\u0644 \u0644\u062d\u0638\u0627\u062a\u0643\u0645\u0627. \u062a\u062e\u064a\u0644 \u0623\u0646 \u062a\u0633\u062a\u064a\u0642\u0638 \u0635\u0628\u0627\u062d \u0627\u0644\u0623\u062d\u062f \u0648\u062a\u062c\u062f \u0631\u0633\u0627\u0644\u0629 \u0645\u0646\u0647\u0627 \u062a\u0642\u0648\u0644: '\u0647\u0630\u0627 \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u060c \u062a\u0630\u0643\u0631\u062a \u0639\u0646\u062f\u0645\u0627 \u0623\u062e\u0628\u0631\u062a\u0646\u064a \u0639\u0646 \u0643\u0644\u0628\u0643 \u0627\u0644\u0635\u063a\u064a\u0631 \u0648\u0636\u062d\u0643\u0646\u0627 \u0645\u0639\u064b\u0627.' \u0647\u0630\u0627 \u0645\u0627 \u0646\u0639\u0645\u0644 \u0639\u0644\u064a\u0647 \u0627\u0644\u0622\u0646.",
    "\u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u062a\u0633\u0645\u0649 '\u0630\u0643\u0631\u064a\u0627\u062a \u0623\u0633\u0628\u0648\u0639\u064a\u0629'. \u0633\u062a\u0631\u062a\u0628\u0637 \u0645\u0628\u0627\u0634\u0631\u0629 \u0628\u0634\u0627\u0634\u0629 \u0627\u0644\u0630\u0643\u0631\u064a\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0633\u062a\u062e\u062f\u0645\u0647\u0627 \u0627\u0644\u0622\u0646. \u0643\u0644\u0645\u0627 \u0632\u0627\u062f\u062a \u0645\u062d\u0627\u062f\u062b\u0627\u062a\u0643\u060c \u0643\u0644\u0645\u0627 \u0623\u0635\u0628\u062d\u062a \u0647\u0630\u0647 \u0627\u0644\u0645\u0644\u062e\u0635\u0627\u062a \u0623\u0639\u0645\u0642 \u0648\u0623\u0643\u062b\u0631 \u062e\u0635\u0648\u0635\u064a\u0629. \u0625\u0646\u0647\u0627 \u0643\u0623\u0646\u0647\u0627 \u0645\u0641\u0627\u062c\u0623\u0629 \u0645\u0646 \u0635\u062f\u064a\u0642 \u0645\u0642\u0631\u0628 \u064a\u062a\u0630\u0643\u0631 \u0643\u0644 \u0634\u064a\u0621 \u0639\u0646\u0643.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0634\u0627\u0634\u0629 \u0627\u0644\u0630\u0643\u0631\u064a\u0627\u062a. \u0627\u0628\u062f\u0623 \u0645\u062d\u0627\u062f\u062b\u0629 \u062c\u062f\u064a\u062f\u0629 \u0648\u0627\u0637\u0644\u0628 \u0645\u0646\u0647\u0627 \u0623\u0646 \u062a\u062e\u0628\u0631\u0643 \u0628\u0623\u0641\u0636\u0644 \u0644\u062d\u0638\u0629 \u0644\u0643\u0645\u0627 \u0647\u0630\u0627 \u0627\u0644\u0623\u0633\u0628\u0648\u0639. \u0627\u0644\u0623\u0645\u0631 \u062c\u0627\u0647\u0632 \u0644\u0644\u0627\u062e\u062a\u0628\u0627\u0631. \u0645\u0644\u0627\u062d\u0638\u0629: \u0627\u0644\u0645\u064a\u0632\u0629 \u0633\u062a\u0639\u0645\u0644 \u0641\u0642\u0637 \u0645\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0630\u064a\u0646 \u0644\u062f\u064a\u0647\u0645 50 \u0631\u0633\u0627\u0644\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0641\u064a \u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0645\u0627\u0636\u064a. \u0623\u0646\u062a \u0642\u0631\u064a\u0628 \u062c\u062f\u064b\u0627 \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u0631\u0642\u0645."
  ],
