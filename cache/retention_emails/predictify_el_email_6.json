{
  "subject": "\u03a4\u03bf \u03bd\u03bf\u03cd\u03bc\u03b5\u03c1\u03bf 1 \u03bb\u03ac\u03b8\u03bf\u03c2 \u03c0\u03bf\u03c5 \u03ba\u03ac\u03bd\u03bf\u03c5\u03bd \u03cc\u03bb\u03bf\u03b9 \u03c3\u03c4\u03b7\u03bd Predictify",
  "preview_text": "\u0391\u03bd\u03b1\u03ba\u03ac\u03bb\u03c5\u03c8\u03b5\u03c2 \u03ae\u03b4\u03b7 \u03c4\u03bf \u03bc\u03c5\u03c3\u03c4\u03b9\u03ba\u03cc \u03c0\u03bf\u03c5 \u03ba\u03c1\u03cd\u03b2\u03b5\u03c4\u03b1\u03b9 \u03c0\u03af\u03c3\u03c9 \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03b1\u03c0\u03bf\u03c4\u03c5\u03c7\u03b7\u03bc\u03ad\u03bd\u03b5\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ad\u03c8\u03b5\u03b9\u03c2; \u0394\u03b9\u03ac\u03b2\u03b1\u03c3\u03b5 \u03b1\u03c5\u03c4\u03cc \u03c0\u03c1\u03b9\u03bd \u03c4\u03bf \u03bc\u03b5\u03c4\u03b1\u03bd\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2.",
  "body_paragraphs": [
    "\u0398\u03b1 \u03c3\u03bf\u03c5 \u03c0\u03c9 \u03ba\u03ac\u03c4\u03b9 \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03b8\u03b1 \u03c3\u03bf\u03c5 \u03c0\u03b5\u03b9 \u03ba\u03b1\u03bd\u03ad\u03bd\u03b1\u03c2 \u03ac\u03bb\u03bb\u03bf\u03c2. \u03a4\u03bf 90% \u03c4\u03c9\u03bd \u03c7\u03c1\u03b7\u03c3\u03c4\u03ce\u03bd \u03c4\u03b7\u03c2 Predictify \u03ba\u03ac\u03bd\u03b5\u03b9 \u03c4\u03bf \u03af\u03b4\u03b9\u03bf \u03b1\u03ba\u03c1\u03b9\u03b2\u03ce\u03c2 \u03bb\u03ac\u03b8\u03bf\u03c2 \u2014 \u03ba\u03b1\u03b9 \u03b4\u03b5\u03bd \u03c4\u03bf \u03ba\u03b1\u03c4\u03b1\u03bb\u03b1\u03b2\u03b1\u03af\u03bd\u03b5\u03b9 \u03bc\u03ad\u03c7\u03c1\u03b9 \u03bd\u03b1 \u03c7\u03ac\u03c3\u03b5\u03b9 10 \u03c3\u03c5\u03bd\u03b5\u03c7\u03cc\u03bc\u03b5\u03bd\u03b5\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ad\u03c8\u03b5\u03b9\u03c2. \u039c\u03b1\u03bd\u03c4\u03b5\u03cd\u03bf\u03c5\u03bd \u03b2\u03b1\u03c3\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf\u03b9 \u03c3\u03c4\u03bf \u03ad\u03bd\u03c3\u03c4\u03b9\u03ba\u03c4\u03bf, \u03c3\u03b1\u03bd \u03bd\u03b1 \u03bc\u03b7\u03bd \u03c5\u03c0\u03ac\u03c1\u03c7\u03bf\u03c5\u03bd \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03b5\u03c2 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03c3\u03c4\u03b7 \u03b4\u03b9\u03ac\u03b8\u03b5\u03c3\u03ae \u03c4\u03bf\u03c5\u03c2. \u0391\u03ba\u03bf\u03cd\u03b3\u03b5\u03c4\u03b1\u03b9 \u03bf\u03b9\u03ba\u03b5\u03af\u03bf;",
    "\u03a4\u03bf \u03bb\u03ac\u03b8\u03bf\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03cc\u03c4\u03b9 \u03b1\u03b3\u03bd\u03bf\u03bf\u03cd\u03bd \u03c4\u03bf\u03c5\u03c2 \u03b1\u03c1\u03b9\u03b8\u03bc\u03bf\u03cd\u03c2. \u0392\u03bb\u03ad\u03c0\u03b5\u03b9\u03c2 \u03ad\u03bd\u03b1 \u03bc\u03b1\u03c4\u03c2, \u03bd\u03b9\u03ce\u03b8\u03b5\u03b9\u03c2 \u03cc\u03c4\u03b9 \u03b7 \u039c\u03c0\u03ac\u03c1\u03c4\u03c3\u03b1 \u03b8\u03b1 \u03ba\u03b5\u03c1\u03b4\u03af\u03c3\u03b5\u03b9, \u03ba\u03b1\u03b9 \u03c0\u03b1\u03c4\u03ac\u03c2 \u03c4\u03bf \u03ba\u03bf\u03c5\u03bc\u03c0\u03af \u03c7\u03c9\u03c1\u03af\u03c2 \u03bd\u03b1 \u03ba\u03bf\u03b9\u03c4\u03ac\u03be\u03b5\u03b9\u03c2 xG, \u03b1\u03bc\u03c5\u03bd\u03c4\u03b9\u03ba\u03ae \u03c3\u03c4\u03b1\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae \u03ae \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03cc head-to-head. \u03a4\u03bf \u03ad\u03bd\u03c3\u03c4\u03b9\u03ba\u03c4\u03bf \u03b5\u03af\u03bd\u03b1\u03b9 \u03ba\u03b1\u03bb\u03cc \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03c0\u03bf\u03bd\u03c4\u03ac\u03c1\u03b5\u03b9\u03c2 \u03c3\u03b5 \u03ad\u03bd\u03b1 \u03bc\u03c0\u03b1\u03c1, \u03b1\u03bb\u03bb\u03ac \u03cc\u03c7\u03b9 \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03ba\u03b5\u03c1\u03b4\u03af\u03c3\u03b5\u03b9\u03c2 \u03c3\u03c4\u03bf\u03b9\u03c7\u03ae\u03bc\u03b1\u03c4\u03b1. \u0397 \u03b1\u03bb\u03ae\u03b8\u03b5\u03b9\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03cc\u03c4\u03b9 \u03c4\u03b1 \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03b1 \u03c3\u03c0\u03ac\u03bd\u03b9\u03b1 \u03bb\u03ad\u03bd\u03b5 \u03c8\u03ad\u03bc\u03b1\u03c4\u03b1 \u2014 \u03b5\u03c3\u03cd \u03cc\u03bc\u03c9\u03c2 \u03c4\u03b1 \u03c0\u03c1\u03bf\u03c3\u03c0\u03b5\u03c1\u03bd\u03ac\u03c2.",
    "\u0395\u03b4\u03ce \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03bf \u03ba\u03cc\u03bb\u03c0\u03bf: \u03ac\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03b7\u03bd \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03c4\u03ce\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03c0\u03ae\u03b3\u03b1\u03b9\u03bd\u03b5 \u03c3\u03c4\u03b7 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1 \u03bf\u03c0\u03bf\u03b9\u03bf\u03c5\u03b4\u03ae\u03c0\u03bf\u03c4\u03b5 \u03b1\u03b3\u03ce\u03bd\u03b1. \u0394\u03b5\u03c2 \u03c4\u03b7 \u03b2\u03b1\u03b8\u03bc\u03bf\u03bb\u03bf\u03b3\u03af\u03b1 \u03b5\u03bc\u03c0\u03b9\u03c3\u03c4\u03bf\u03c3\u03cd\u03bd\u03b7\u03c2 \u03c4\u03b7\u03c2 AI \u2014 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf \u03bd\u03bf\u03cd\u03bc\u03b5\u03c1\u03bf \u03b1\u03c0\u03cc 0 \u03ad\u03c9\u03c2 100. \u0391\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03ba\u03ac\u03c4\u03c9 \u03b1\u03c0\u03cc 70, \u03bc\u03b7\u03bd \u03c0\u03b1\u03c4\u03ae\u03c3\u03b5\u03b9\u03c2 \u03c4\u03af\u03c0\u03bf\u03c4\u03b1. \u0394\u03b9\u03ac\u03b2\u03b1\u03c3\u03b5 \u03c4\u03b7\u03bd \u03b1\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u03c4\u03b1\u03ba\u03c4\u03b9\u03ba\u03ae\u03c2, \u03c4\u03b1 \u03c3\u03c4\u03b1\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03ac \u03c4\u03c9\u03bd \u03c0\u03b1\u03b9\u03ba\u03c4\u03ce\u03bd, \u03ba\u03b1\u03b9 \u03bc\u03b5\u03c4\u03ac \u03b1\u03c0\u03cc\u03c6\u03ac\u03c3\u03b9\u03c3\u03b5. \u0397 \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03ac \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03b5\u03c1\u03ac\u03c3\u03c4\u03b9\u03b1.",
    "\u0386\u03bd\u03bf\u03b9\u03be\u03b5 \u03c4\u03b7\u03bd Predictify \u03c4\u03ce\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03b4\u03bf\u03ba\u03af\u03bc\u03b1\u03c3\u03b5 \u03c4\u03bf \u03c3\u03b5 \u03ad\u03bd\u03b1 \u03bc\u03b1\u03c4\u03c2 \u03c0\u03bf\u03c5 \u03bd\u03bf\u03bc\u03af\u03b6\u03b5\u03b9\u03c2 \u03cc\u03c4\u03b9 \u03be\u03ad\u03c1\u03b5\u03b9\u03c2. \u0398\u03b1 \u03b5\u03ba\u03c0\u03bb\u03b1\u03b3\u03b5\u03af\u03c2. P.S. \u03a5\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9 \u03ad\u03bd\u03b1 \u03ba\u03c1\u03c5\u03c6\u03cc feature \u03c3\u03c4\u03bf IQ Quiz \u03c0\u03bf\u03c5 \u03c3\u03bf\u03c5 \u03b4\u03b5\u03af\u03c7\u03bd\u03b5\u03b9 \u03c0\u03cc\u03c3\u03bf \u03ba\u03bf\u03bd\u03c4\u03ac \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 AI \u03c3\u03c4\u03b7 \u03c3\u03ba\u03ad\u03c8\u03b7 \u03c3\u03bf\u03c5 \u2014 \u03b2\u03c1\u03b5\u03c2 \u03c4\u03bf \u03ba\u03b1\u03b9 \u03b3\u03af\u03bd\u03b5 \u03bf \u03c0\u03b9\u03bf \u03ad\u03be\u03c5\u03c0\u03bd\u03bf\u03c2 \u03c6\u03af\u03bb\u03bf\u03c2 \u03c3\u03c4\u03b7\u03bd \u03c0\u03b1\u03c1\u03ad\u03b1."
