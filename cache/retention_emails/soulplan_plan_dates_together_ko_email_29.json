  "subject": "68\uc77c \ub3d9\uc548 \ud568\uaed8\ud574\uc900 \ub2f9\uc2e0\uc5d0\uac8c\ub9cc",
  "preview_text": "\uc6b0\ub9ac\uac00 \uc624\ub798\ub41c \uc0ac\uc6a9\uc790\uc5d0\uac8c\ub9cc \ub4dc\ub9ac\ub294 \uc791\uc740 \uc120\ubb3c\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc9c0\uae08 \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\uc9c0\ub09c 68\uc77c \ub3d9\uc548 \uc18c\uc6b8\ud50c\ub79c\uc744 \ud568\uaed8\ud574\uc8fc\uc154\uc11c \uc815\ub9d0 \uac10\uc0ac\ud569\ub2c8\ub2e4. \ub2f9\uc2e0\uacfc \ud30c\ud2b8\ub108\uac00 \uc313\uc544\uc628 \ub370\uc774\ud2b8 \uae30\ub85d\uacfc \ucd94\uc5b5\uc774 \uc800\ud76c\uc5d0\uac8c\ub294 \ud070 \uc758\ubbf8\uc785\ub2c8\ub2e4. \uc624\ub298\uc740 \uc624\ub798\ub41c \uc0ac\uc6a9\uc790\uc5d0\uac8c\ub9cc \ub4dc\ub9ac\ub294 \ud2b9\ubcc4\ud55c \uac83\uc774 \uc788\uc5b4\uc694.",
    "\ub9ce\uc740 \ucee4\ud50c\uc774 \uba87 \uc8fc\ub9cc \uc9c0\ub098\uba74 \ub370\uc774\ud2b8 \uc544\uc774\ub514\uc5b4\uac00 \ub5a8\uc5b4\uc9c0\uace0 \uc77c\uc0c1\uc5d0 \uac07\ud788\uace4 \ud569\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \ub2f9\uc2e0\uc740 \ub2e4\ub985\ub2c8\ub2e4. \uafb8\uc900\ud788 \ud568\uaed8\ud574\uc628 \ub9cc\ud07c, \uc774\uc81c\ub294 \ub354 \uae4a\uc740 \uc5f0\uacb0\uc744 \uc704\ud55c \ubb34\uc5b8\uac00\uac00 \ud544\uc694\ud560 \ub54c\uc785\ub2c8\ub2e4.",
    "\uadf8\ub798\uc11c \uc900\ube44\ud588\uc2b5\ub2c8\ub2e4. '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \uae30\ub2a5 \uc548\uc5d0 \uc228\uaca8\uc9c4 VIP \ubaa8\ub4dc\ub97c \uc624\ub298\ub9cc \uacf5\uac1c\ud569\ub2c8\ub2e4. \uc571\uc744 \uc5f4\uace0 \uba54\uc778 \ud654\uba74\uc5d0\uc11c '\uc624\ub298\uc758 \ub370\uc774\ud2b8' \uce74\ub4dc\ub97c \ub450 \ubc88 \ud0ed\ud558\uba74, \ud3c9\uc18c\uc5d0\ub294 \ubcf4\uc774\uc9c0 \uc54a\ub294 '\uc2dc\ud06c\ub9bf \ub370\uc774\ud2b8 \ud14c\ub9c8'\uac00 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \ud30c\ud2b8\ub108\uc640 \ud568\uaed8 \ud2b9\ubcc4\ud55c \ubc24\uc744 \uacc4\ud68d\ud574\ubcf4\uc138\uc694.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uc5b4 '\uc624\ub298\uc758 \ub370\uc774\ud2b8'\ub97c \ub450 \ubc88 \ud0ed\ud574\ubcf4\uc138\uc694. P.S. \uc774 \uc2dc\ud06c\ub9bf \ubaa8\ub4dc\ub294 24\uc2dc\uac04 \ud6c4\uc5d0 \uc0ac\ub77c\uc9d1\ub2c8\ub2e4. \ub193\uce58\uc9c0 \ub9c8\uc138\uc694."
  ],
