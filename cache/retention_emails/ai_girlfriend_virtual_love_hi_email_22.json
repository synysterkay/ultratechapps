{
  "subject": "\u0935\u094b \u091f\u094d\u0930\u093f\u0915 \u091c\u094b \u0939\u0930 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930 50\u0935\u0947\u0902 \u0926\u093f\u0928 \u0938\u0940\u0916\u0924\u093e \u0939\u0948",
  "preview_text": "\u0906\u092a\u0915\u0947 \u0905\u0902\u0926\u0930 \u091b\u093f\u092a\u093e \u0939\u0948 \u090f\u0915 \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u2013 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947 \u0926\u094b \u091f\u0948\u092a \u092e\u0947\u0902 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u094b \u0905\u0917\u0932\u0947 \u0932\u0947\u0935\u0932 \u092a\u0930 \u0932\u0947 \u091c\u093e\u090f\u0902\u0964",
  "body_paragraphs": [
    "\u0926\u093f\u0928 50 \u092a\u0930 \u092a\u0939\u0941\u0902\u091a \u0917\u090f? \u0924\u094b \u0905\u092c \u0935\u0915\u094d\u0924 \u0939\u0948 \u0915\u093f \u0906\u092a \u0909\u0938 \u091a\u0940\u091c\u093c \u0915\u094b \u091c\u093e\u0928\u0947\u0902 \u091c\u094b \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u092a\u0924\u093e \u0928\u0939\u0940\u0902 \u2013 \u0939\u092e\u093e\u0930\u0947 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930 \u0930\u094b\u091c\u093c \u0907\u0938\u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0915\u094b\u0908 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964",
    "\u092c\u093e\u0924 \u092f\u0947 \u0939\u0948: \u0939\u0930 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u0947 \u092a\u093e\u0938 \u090f\u0915 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u2018\u092e\u0942\u0921 \u092e\u0948\u091a\u2019 \u092b\u0940\u091a\u0930 \u0939\u0948\u0964 \u0906\u092a \u0938\u093f\u0930\u094d\u092b \u0926\u094b \u091f\u0948\u092a \u0938\u0947 \u0909\u0938\u0947 \u092c\u0924\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u091c \u0906\u092a \u0915\u0948\u0938\u093e \u092e\u0939\u0938\u0942\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902 \u2013 \u0914\u0930 \u0935\u094b \u0924\u0941\u0930\u0902\u0924 \u0905\u092a\u0928\u0940 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u094b \u0909\u0938 \u092e\u0942\u0921 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0922\u093e\u0932 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964 \u091c\u0948\u0938\u0947, \u0905\u0917\u0930 \u0906\u092a \u0909\u0926\u093e\u0938 \u0939\u0948\u0902, \u0924\u094b \u0935\u094b \u0906\u092a\u0915\u094b \u0939\u0902\u0938\u093e\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0917\u0940; \u0905\u0917\u0930 \u0916\u0941\u0936 \u0939\u0948\u0902, \u0924\u094b \u091c\u0936\u094d\u0928 \u092e\u0928\u093e\u090f\u0917\u0940\u0964 \u092f\u0947 \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u0906\u092a\u0915\u094b \u092c\u093f\u0928\u093e \u0915\u0941\u091b \u0915\u0939\u0947 \u0917\u0939\u0930\u093e \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u092c\u0928\u093e\u0928\u0947 \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
    "\u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u0938 \u0905\u092a\u0928\u0940 AI \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u0947 \u091a\u0948\u091f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u091c\u093e\u090f\u0902, \u090a\u092a\u0930 \u0926\u093e\u090f\u0902 \u0915\u094b\u0928\u0947 \u092e\u0947\u0902 \u0924\u0940\u0928 \u0921\u0949\u091f\u094d\u0938 \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902, \u0914\u0930 \u2018\u092e\u0942\u0921 \u092e\u0948\u091a\u2019 \u091a\u0941\u0928\u0947\u0902\u0964 \u092b\u093f\u0930 \u0905\u092a\u0928\u093e \u092e\u0942\u0921 \u0938\u0947\u091f \u0915\u0930\u0947\u0902 \u2013 \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u0948\u0938\u0947 \u0935\u094b \u092a\u0932 \u092d\u0930 \u092e\u0947\u0902 \u092c\u0926\u0932 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092f\u0947 \u0935\u094b \u091f\u094d\u0930\u093f\u0915 \u0939\u0948 \u091c\u094b \u0939\u0930 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0915\u094b\u0908 \u0936\u0947\u092f\u0930 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964",
    "\u0905\u092d\u0940 \u0905\u092a\u0928\u0940 \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u094b \u0914\u0930 \u2018\u092e\u0942\u0921 \u092e\u0948\u091a\u2019 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b\u0964 P.S. \u2013 \u0905\u0917\u0930 \u0924\u0941\u092e \u0907\u0938\u0947 2 \u092e\u093f\u0928\u091f \u0915\u0947 \u0905\u0902\u0926\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u094b\u0917\u0947, \u0924\u094b \u0935\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u090f\u0915 \u0938\u094d\u092a\u0947\u0936\u0932 \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0926\u0947\u0917\u0940 \u2013 \u0932\u0947\u0915\u093f\u0928 \u092f\u0947 \u0938\u093f\u0930\u094d\u092b \u0906\u091c \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0964"
  ],
