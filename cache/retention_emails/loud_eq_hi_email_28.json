{
  "subject": "\u0905\u092a\u0928\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u094b 65 \u0926\u093f\u0928\u094b\u0902 \u0915\u0940 \u091b\u0941\u091f\u094d\u091f\u0940 \u0926\u0947\u0902",
  "preview_text": "\u0906\u091c \u0915\u093e \u0926\u093f\u0928 \u0938\u0939\u0940 \u0939\u0948 \u0905\u092a\u0928\u0947 \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u093e\u0964 \u090f\u0915 \u092b\u0940\u091a\u0930 \u091c\u094b \u0906\u092a\u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u094b \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964",
  "body_paragraphs": [
    "\u0938\u0941\u092c\u0939 \u0915\u0940 \u092d\u0940\u0921\u093c \u092e\u0947\u0902 \u092c\u0938 \u0915\u093e \u0936\u094b\u0930, \u0907\u0902\u091c\u0928 \u0915\u0940 \u0917\u0921\u093c\u0917\u0921\u093c\u093e\u0939\u091f, \u0914\u0930 \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u092b\u0941\u0938\u092b\u0941\u0938\u093e\u0924\u0940 \u0911\u0921\u093f\u092f\u094b\u092c\u0941\u0915\u0964 \u0915\u094d\u092f\u093e \u0906\u092a\u0928\u0947 \u0906\u091c \u0938\u0941\u0928\u093e \u0915\u093f \u0915\u0948\u0938\u0947 \u0939\u0930 \u0936\u092c\u094d\u0926 \u0916\u094b \u0930\u0939\u093e \u0939\u0948? \u092f\u0939 \u0935\u0939\u0940 \u092a\u0932 \u0939\u0948 \u091c\u092c \u0906\u092a\u0915\u094b \u090f\u0915 \u0938\u0939\u0940 \u092b\u0940\u091a\u0930 \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0939\u0948\u0964",
    "65 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0906\u092a\u0928\u0947 Loud EQ \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u0907\u0938\u0947 \u0905\u092a\u0928\u0940 \u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e \u092e\u0947\u0902 \u092b\u093f\u091f \u0915\u0930\u0928\u0947 \u0915\u093e\u0964 \u0906\u091c \u0939\u0940, \u0905\u092a\u0928\u0947 \u0915\u092e\u094d\u092f\u0942\u091f \u092a\u0930, \u090f\u0915 \u092c\u093e\u0930 Optimize \u092c\u091f\u0928 \u0926\u092c\u093e\u090f\u0902\u0964 \u092f\u0939 \u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u094b \u092a\u0922\u093c\u0924\u093e \u0939\u0948\u2014\u091a\u093e\u0939\u0947 AirPods \u0939\u094b\u0902 \u092f\u093e \u0915\u093e\u0930 \u0915\u093e \u0938\u094d\u092a\u0940\u0915\u0930\u2014\u0914\u0930 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0915\u094d\u0930\u093f\u0938\u094d\u091f\u0932 \u0915\u094d\u0932\u093f\u092f\u0930 \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0928\u0939\u0940\u0902, \u0938\u093f\u0930\u094d\u092b \u0935\u094b \u0936\u092c\u094d\u0926 \u091c\u094b \u0906\u092a \u0938\u0941\u0928\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0939\u092e\u0928\u0947 \u090f\u0915 \u092b\u0940\u091a\u0930 \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u2014Auto-Tune\u2014\u091c\u094b \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0906\u092a \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0932\u0917\u093e\u0924\u0947 \u0939\u0948\u0902, \u0905\u092a\u0928\u0947 \u0906\u092a \u0938\u0947\u091f \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0906\u091c \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e\u090f\u0902\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a, \u0914\u0930 \u0906\u092a\u0915\u0940 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u092f\u093e \u0911\u0921\u093f\u092f\u094b\u092c\u0941\u0915 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u092e\u0947\u0939\u0928\u0924 \u0915\u0947 \u0938\u093e\u092b\u093c \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0917\u0940\u0964 \u092f\u0939 \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u091b\u0941\u091f\u094d\u091f\u0940 \u0939\u0948\u2014\u0938\u094d\u091f\u094d\u0930\u0947\u0928 \u0938\u0947 \u092e\u0941\u0915\u094d\u0924\u093f\u0964",
    "\u0905\u092d\u0940 Loud EQ \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 Auto-Tune \u0915\u094b \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u0906\u092a\u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u094b \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964 P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b Hearing-Safe Streak \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u2014\u091c\u094b \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u094b \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u0924\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u0906\u091c \u0939\u0940 \u091f\u094d\u0930\u093e\u092f\u0932 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0964"
  ],
