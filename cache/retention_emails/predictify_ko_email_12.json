{
  "subject": "\uc0c8\ubcbd 2\uc2dc\uc758 \uc2e4\uc218\uac00 \ubc14\uafbc \uc608\uce21",
  "preview_text": "\ud55c \uc0ac\uc6a9\uc790\uac00 \ubc1c\uacac\ud55c \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774 \uc608\uce21 \uc801\uc911\ub960\uc744 40% \uc62c\ub838\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\ub3c4 \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\uc9c0\ub09c\uc8fc, \ud55c \uc0ac\uc6a9\uc790\uac00 \uc0c8\ubcbd 2\uc2dc\uc5d0 \uc2e4\uc218\ub85c \uc571\uc758 '\ucee4\ubba4\ub2c8\ud2f0' \ud0ed\uc744 \ub20c\ub800\uc5b4\uc694. \uadf8\ub7f0\ub370 \uadf8\uac8c \ubaa8\ub4e0 \uac78 \ubc14\uafe8\uc2b5\ub2c8\ub2e4. \uadf8\ub294 \uadf8\ub0a0 \ubc24 '\ud504\ub9ac\ubbf8\uc5b4\ub9ac\uadf8 \ub9e8\uc2dc\ud2f0 \ub300 \uc544\uc2a4\ub110' \uacbd\uae30\uc758 \ud22c\ud45c \uacb0\uacfc\ub97c \ubcf4\uace0 \ucda9\uaca9\uc744 \ubc1b\uc558\uc8e0. \ucee4\ubba4\ub2c8\ud2f0\uac00 \ubf51\uc740 '\uc624\ub298\uc758 \uc608\uce21'(POTD)\uc774 AI \uc608\uce21\uacfc \uc644\uc804\ud788 \ub2ec\ub790\uac70\ub4e0\uc694.",
    "\uadf8\ub294 \ub370\uc774\ud130\ub9cc \ubbff\uace0 AI \uc608\uce21\uc744 \ub530\ub77c\uac14\uc9c0\ub9cc, \ucee4\ubba4\ub2c8\ud2f0\uc758 'POTD'\ub294 \ud32c\ub4e4\uc758 \uc9c1\uad00\uacfc \uacbd\ud5d8\uc744 \ubc18\uc601\ud588\uc2b5\ub2c8\ub2e4. \uacb0\uad6d POTD\uac00 \ub9de\uc558\uace0, \uadf8\ub294 \uae68\ub2ec\uc558\uc5b4\uc694. \uc608\uce21\uc740 \uc22b\uc790\ub9cc\uc774 \uc544\ub2c8\ub77c \uc0ac\ub78c\uc758 \uac10\uac01\ub3c4 \uc911\uc694\ud558\ub2e4\ub294 \uac78. \uc774\ud6c4 \uadf8\ub294 \ub9e4\uc77c POTD\uc5d0 \ud22c\ud45c\ud558\uace0, \uc790\uc2e0\uc758 \uc608\uce21\uc744 \ucee4\ubba4\ub2c8\ud2f0\uc5d0 \uacf5\uc720\ud558\uba70 \uc801\uc911\ub960\uc744 40% \uc62c\ub838\uc2b5\ub2c8\ub2e4.",
    "\uc774\uac8c \ubc14\ub85c Predictify\uc758 '\ucee4\ubba4\ub2c8\ud2f0' \uae30\ub2a5\uc774\uc5d0\uc694. AI \ubd84\uc11d(\uc218\ucc9c \uac1c \ubcc0\uc218, xG, \uc810\uc720\uc728 \ub4f1)\uacfc \ud568\uaed8, \ud32c\ub4e4\uc774 \uc9c1\uc811 \ud22c\ud45c\ub85c \ubf51\uc740 'Prediction of the Day'\ub97c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \uc608\uce21\uc744 \uac80\uc99d\ud558\uace0, \ub2e4\ub978 \ud32c\ub4e4\uacfc \ud1a0\ub860\ud558\uba70, \ub370\uc774\ud130\uc640 \uc9c1\uad00\uc758 \uc644\ubcbd\ud55c \uc870\ud569\uc744 \ucc3e\uc544\ubcf4\uc138\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0 '\ucee4\ubba4\ub2c8\ud2f0' \ud0ed\uc73c\ub85c \uac00\uc11c \uc624\ub298\uc758 POTD\uc5d0 \ud22c\ud45c\ud558\uc138\uc694. \ub2f9\uc2e0\uc758 \uc120\ud0dd\uc774 \ub9de\ub294\uc9c0 AI\uc640 \ube44\uad50\ud574\ubcf4\ub294 \uc7ac\ubbf8\uac00 \uc3e0\uc3e0\ud560 \uac70\uc608\uc694. P.S. \ud504\ub9ac\ubbf8\uc5c4($12.99/\uc6d4, 3\uc77c \ubb34\ub8cc \uccb4\ud5d8)\uc744 \uc774\uc6a9\ud558\uba74 \ubaa8\ub4e0 \ub9ac\uadf8\uc758 AI \uc608\uce21\uacfc \uace0\uae09 \ud1b5\uacc4\ub97c \ubb34\uc81c\ud55c\uc73c\ub85c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uccab \ub2ec\uc740 \ub9dd\uc124\uc77c \ud544\uc694 \uc5c6\uc5b4\uc694."
