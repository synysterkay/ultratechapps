{
  "subject": "\ub0b4\uac00 \uc774 \uc571\uc5d0\uc11c \uc228\uae34 \uae30\ub2a5\uc744 \ucc3e\uc740 \ubc29\ubc95",
  "preview_text": "90%\uc758 \uc720\uc800\uac00 \ubaa8\ub974\ub294 \uc774 \uae30\ub2a5 \ud558\ub098\ub85c \ub0b4 \uc608\uce21\uc774 \uc644\uc804\ud788 \ub2ec\ub77c\uc84c\ub2e4. \ub108\ub3c4 \ud655\uc778\ud574\ubd10.",
  "body_paragraphs": [
    "\uc194\uc9c1\ud788 \ub9d0\ud558\uba74, \uc774 \uc571\uc744 \uae54\uace0 \ucc98\uc74c 2\uc8fc \ub3d9\uc548\uc740 \uac70\uc758 \uc548 \uc37c\uc5b4. \uadf8\ub0e5 \ud3c9\uc18c\ucc98\ub7fc \uac10\uc73c\ub85c \uc608\uce21\ud558\uace0 \ub118\uacbc\uc9c0. \uadfc\ub370 \uc5b4\ub290 \ub0a0, \uc6b0\uc5f0\ud788 \ud55c \uae30\ub2a5\uc744 \ubc1c\uacac\ud588\uc5b4. \uadf8\uac8c \ub0b4 \uc608\uce21 \uc131\uacf5\ub960\uc744 \uc644\uc804\ud788 \ubc14\uafd4\ub1a8\ub2e4.",
    "\uc774 \uae30\ub2a5\uc744 \uc4f0\uae30 \uc804\uc5d0\ub294 AI \uc608\uce21\uc774 \uadf8\ub0e5 \uc22b\uc790 \ub180\uc74c\uc774\ub77c\uace0 \uc0dd\uac01\ud588\uc5b4. \uadfc\ub370 \ud55c\ubc88 \uae4a\uc774 \ub4e4\uc5ec\ub2e4\ubcf4\ub2c8\uae4c, AI\uac00 \uacbd\uae30\ub9c8\ub2e4 \uc218\ucc9c \uac1c\uc758 \ubcc0\uc218\ub97c \ubd84\uc11d\ud558\uace0 \uac01 \uc608\uce21\uc5d0 \uc2e0\ub8b0\ub3c4 \uc810\uc218\ub97c \ub9e4\uae34\ub2e4\ub294 \uac78 \uc54c\uac8c \ub410\uc5b4. \uc774 \uc2e0\ub8b0\ub3c4 \uc810\uc218 \ud558\ub098\ub9cc \ubd10\ub3c4 \ub0b4\uac00 \ubca0\ud305\ud560 \uac00\uce58\uac00 \uc788\ub294 \uacbd\uae30\uc778\uc9c0 \ubc14\ub85c \uc54c \uc218 \uc788\ub354\ub77c\uace0.",
    "\uc774\uac8c \ubc14\ub85c AI \uc608\uce21\uc758 '\uc0c1\uc138 \ubd84\uc11d' \uae30\ub2a5\uc774\uc57c. \ud504\ub9ac\ubbf8\uc5b4\ub9ac\uadf8, \ub77c \ub9ac\uac00, \ubd84\ub370\uc2a4\ub9ac\uac00, \ucc54\ud53c\uc5b8\uc2a4\ub9ac\uadf8 \ub4f1 50\uac1c \uc774\uc0c1 \ub9ac\uadf8\uc758 \ubaa8\ub4e0 \uacbd\uae30\uc5d0 \ub300\ud574 AI\uac00 \uc65c \uc774\ub7f0 \uc608\uce21\uc744 \ub0b4\ub1a8\ub294\uc9c0, \uc5b4\ub5a4 \ub370\uc774\ud130\ub97c \uae30\ubc18\uc73c\ub85c \ud588\ub294\uc9c0, \ud648\ud300\uc758 \uc810\uc720\uc728\uacfc \uc6d0\uc815\ud300\uc758 \uc218\ube44 \uac15\ub3c4 \uac19\uc740 \uc138\ubd80 \uc9c0\ud45c\uae4c\uc9c0 \ub2e4 \ubcf4\uc5ec\uc918. \uc774 \uae30\ub2a5\uc744 \ud55c\ubc88 \uc368\ubcf4\uba74, \uadf8\ub0e5 \uc608\uce21\ub9cc \ubcf4\ub294 \uac8c \uc5bc\ub9c8\ub098 \uc544\uc26c\uc6b4\uc9c0 \uc54c\uac8c \ub420 \uac70\uc57c.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uace0 \uc544\ubb34 \uacbd\uae30\ub098 \uace8\ub77c\uc11c '\uc0c1\uc138 \ubd84\uc11d'\uc744 \ub20c\ub7ec\ubd10. \uadf8\ub7ec\uba74 \ub0b4\uac00 \ubb34\uc2a8 \ub9d0\uc744 \ud558\ub294\uc9c0 \uc54c\uac8c \ub420 \uac70\uc57c. P.S. \uc774 \uae30\ub2a5\uc740 \ud504\ub9ac\ubbf8\uc5c4\uc5d0\uc11c \ub354 \ub9ce\uc740 \ub370\uc774\ud130\ub97c \uc81c\uacf5\ud558\ub294\ub370, 3\uc77c \ubb34\ub8cc \uccb4\ud5d8\uc73c\ub85c \ucda9\ubd84\ud788 \ub9db\ubcfc \uc218 \uc788\uc5b4. \ub193\uce58\uc9c0 \ub9c8."
  ],
  "cta_text": "\uc0c1\uc138 \ubd84\uc11d \ud655\uc778\ud558\uae30",
