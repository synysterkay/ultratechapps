{
  "subject": "\u0986\u09aa\u09a8\u09be\u09b0 \u09e9\u099f\u09bf \u09ad\u09c1\u09b2 \u09af\u09be \u09ab\u09b2\u09be\u09ab\u09b2 \u09a8\u09b7\u09cd\u099f \u0995\u09b0\u099b\u09c7",
  "preview_text": "\u0985\u09a7\u09bf\u0995\u09be\u0982\u09b6 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0 \u098f\u0987 \u09ad\u09c1\u09b2\u0997\u09c1\u09b2\u09cb \u0995\u09b0\u09c7 \u09ac\u09b8\u09c7\u0964 \u099c\u09c7\u09a8\u09c7 \u09a8\u09bf\u09a8 \u09b8\u09b9\u099c \u09b8\u09ae\u09be\u09a7\u09be\u09a8 \u098f\u09ac\u0982 \u0986\u099c\u0987 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09b0\u09c1\u09a8\u0964",
  "body_paragraphs": [
    "\u0986\u09aa\u09a8\u09bf \u0995\u09bf \u099c\u09be\u09a8\u09c7\u09a8, \u09ee\u09e6% \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0 \u09b6\u09c1\u09b0\u09c1\u09a4\u09c7 \u09a1\u09c7\u099f\u09be \u09a8\u09be \u09a6\u09c7\u0996\u09c7 \u09b6\u09c1\u09a7\u09c1 \u0997\u09be\u099f \u09ab\u09bf\u09b2\u09bf\u0982 \u09a8\u09bf\u09df\u09c7 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u0995\u09b0\u09c7? \u098f\u099f\u09be\u0987 \u09b8\u09ac\u099a\u09c7\u09df\u09c7 \u09ac\u09dc \u09ad\u09c1\u09b2\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09ab\u09b2\u09be\u09ab\u09b2 \u09a8\u09b7\u09cd\u099f \u09b9\u0993\u09df\u09be\u09b0 \u09aa\u09c7\u099b\u09a8\u09c7 \u098f\u0987 \u0995\u09be\u09b0\u09a3\u0964",
    "Predictify-\u09a4\u09c7 AI \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3 \u0995\u09b0\u09c7 \u09b9\u09be\u099c\u09be\u09b0\u09cb \u09ad\u09c7\u09b0\u09bf\u09df\u09c7\u09ac\u09b2 \u2014 \u09a6\u09b2\u09c7\u09b0 \u0986\u0995\u09cd\u09b0\u09ae\u09a3\u0995\u09cd\u09b7\u09ae\u09a4\u09be, \u09a1\u09bf\u09ab\u09c7\u09a8\u09cd\u09b8\u09bf\u09ad \u09b6\u0995\u09cd\u09a4\u09bf, xG, \u09b9\u09c7\u09a1-\u099f\u09c1-\u09b9\u09c7\u09a1 \u0987\u09a4\u09bf\u09b9\u09be\u09b8\u0964 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0985\u09a8\u09c7\u0995\u09c7 \u09b6\u09c1\u09a7\u09c1 \u09b8\u09cd\u0995\u09cb\u09b0 \u0985\u09a8\u09c1\u09ae\u09be\u09a8 \u0995\u09b0\u09c7, \u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u09b8\u09cd\u0995\u09cb\u09b0 \u0989\u09aa\u09c7\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c7\u0964 \u098f\u099f\u09be \u09ad\u09c1\u09b2\u0964",
    "\u09b8\u09b9\u099c \u09b8\u09ae\u09be\u09a7\u09be\u09a8? \u098f\u0995\u099f\u09bf \u09ae\u09cd\u09af\u09be\u099a \u0996\u09c1\u09b2\u09c1\u09a8, AI-\u098f\u09b0 \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3 \u09a6\u09c7\u0996\u09c1\u09a8\u0964 \u0995\u09a8\u09ab\u09bf\u09a1\u09c7\u09a8\u09cd\u09b8 \u09b8\u09cd\u0995\u09cb\u09b0 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09bf\u09a6\u09cd\u09a7\u09be\u09a8\u09cd\u09a4\u0995\u09c7 \u0997\u09be\u0987\u09a1 \u0995\u09b0\u09ac\u09c7\u0964 \u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u0997\u09be\u099f \u09ab\u09bf\u09b2\u09bf\u0982 \u099b\u09c7\u09dc\u09c7 \u09a1\u09c7\u099f\u09be \u09ab\u09b2\u09cb \u0995\u09b0\u09c7\u09a8, \u09ab\u09b2\u09be\u09ab\u09b2 \u09aa\u09be\u09b2\u09cd\u099f\u09c7 \u09af\u09be\u09ac\u09c7\u0964",
    "\u0986\u099c\u0987 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u09a1\u09c7\u099f\u09be-\u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u0995 \u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09b6\u09a8 \u09a6\u09bf\u09a8\u0964 \u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09c1\u09a8 \u098f\u09ac\u0982 '\u09aa\u09cd\u09b0\u09c7\u09a1\u09bf\u0995\u09cd\u099f' \u099f\u09cd\u09af\u09be\u09ac\u09c7 \u09af\u09be\u09a8\u0964 P.S. \u2014 IQ \u0995\u09c1\u0987\u099c\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09ab\u09c1\u099f\u09ac\u09b2 \u099c\u09cd\u099e\u09be\u09a8 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8, \u09a6\u09c7\u0996\u09c1\u09a8 AI-\u098f\u09b0 \u099a\u09c7\u09df\u09c7 \u0995\u09a4\u099f\u09be \u098f\u0997\u09bf\u09df\u09c7\u0964"
  ],
