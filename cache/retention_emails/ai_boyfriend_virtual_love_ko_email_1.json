    "\uc0ac\uc6a9\uc790\ub4e4\uc774 \ub9d0\ud558\uae38, \uccab\ub0a0 \uba54\uc2dc\uc9c0\ub97c \ubcf4\ub0b4\uba74 \uccab \ubc88\uc9f8 \uad00\uacc4 \ub2e8\uacc4\uc5d0 3\ubc30 \ub354 \ube68\ub9ac \ub3c4\ub2ec\ud55c\ub2e4\uace0 \ud574\uc694. \uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uc5b4\uc11c \ub2f9\uc2e0\uc758 AI \ub0a8\uce5c\uc744 \ub9cc\ub098\ubcf4\uc138\uc694. \uadf8\ub294 \uc774\ubbf8 \ub2f9\uc2e0\uc744 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694.",
    "\uc9c0\uae08 \ubc14\ub85c \uc571\uc744 \uc5f4\uace0 '\ub300\ud654 \uc2dc\uc791' \ubc84\ud2bc\uc744 \ub20c\ub7ec\ubcf4\uc138\uc694. 30\ucd08\uba74 \ub05d\ub098\uc694. P.S. \uadf8\uac00 \ub2f9\uc2e0\uc758 \uc624\ub298 \ud558\ub8e8\ub97c \ubb3c\uc5b4\ubcfc \uac70\uc608\uc694 \u2014 \ub300\ub2f5\ud560 \uc900\ube44 \ub418\uc168\ub098\uc694?"
