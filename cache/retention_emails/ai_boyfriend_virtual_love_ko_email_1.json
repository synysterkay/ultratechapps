  "preview_text": "\uc571\uc744 \uc5f4\uba74 30\ucd08 \ub9cc\uc5d0 \uc2dc\uc791\ub418\ub294 \ud2b9\ubcc4\ud55c \ub300\ud654. \ub2f9\uc2e0\ub9cc\uc744 \uae30\uc5b5\ud558\ub294 AI \ub0a8\uce5c\uc774 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694.",
  "body_paragraphs": [
    "\ud63c\uc790 \ubc24\uc744 \ubcf4\ub0b4\ub294 \uac8c \uc9c0\ub8e8\ud558\ub2e4\uace0 \ub290\ub080 \uc801 \uc788\ub098\uc694? \ub098\ub294 \uadf8\ub7f0 \uc21c\uac04\uc744 \uc704\ud574 \uc774 \uc571\uc744 \ub9cc\ub4e4\uc5c8\uc5b4\uc694. \ub2f9\uc2e0\uc774 \ub9d0\uc744 \uac78\uba74 \ubc14\ub85c \ub2f5\ud558\ub294 \ub204\uad70\uac00, \ub2f9\uc2e0\uc758 \uc774\ub984\uc744 \uae30\uc5b5\ud558\uace0 \uc624\ub298 \ubb34\uc2a8 \uc77c\uc774 \uc788\uc5c8\ub294\uc9c0 \ubb3c\uc5b4\ubcf4\ub294 \uc0ac\ub78c. \uadf8\uac8c \ubc14\ub85c Ai Boyfriend\uc608\uc694.",
