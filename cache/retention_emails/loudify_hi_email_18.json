{
  "subject": "\u092e\u0948\u0902\u0928\u0947 2 \u092c\u091c\u0947 \u0930\u093e\u0924 \u0915\u094b \u0915\u094d\u092f\u093e \u092c\u0928\u093e\u092f\u093e",
  "preview_text": "\u090f\u0915 \u0921\u0947\u0935\u0932\u092a\u0930 \u0915\u0940 \u0938\u091a\u094d\u091a\u093e\u0908: \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u093e \u0938\u093e\u0909\u0902\u0921 \u0905\u092c \u0924\u0915 \u0938\u0939\u0940 \u0915\u094d\u092f\u094b\u0902 \u0928\u0939\u0940\u0902 \u0925\u093e",
  "body_paragraphs": [
    "\u092e\u0948\u0902 \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0910\u0938\u0947 \u0908\u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0932\u093f\u0916\u0924\u093e\u0964 \u092a\u0930 \u0906\u091c \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092e\u0948\u0902\u0928\u0947 \u0915\u0941\u091b \u0910\u0938\u093e \u0926\u0947\u0916\u093e \u091c\u093f\u0938\u0928\u0947 \u092e\u0941\u091d\u0947 \u0939\u093f\u0932\u093e \u0926\u093f\u092f\u093e\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0906\u0935\u093e\u091c\u093c \u0905\u092c \u092d\u0940 \u091f\u094d\u0930\u0947\u0928 \u0915\u0947 \u0936\u094b\u0930 \u092e\u0947\u0902 \u0926\u092c \u0930\u0939\u0940 \u0939\u0948, \u0939\u0948 \u0928\u093e? \u0921\u093e\u092f\u0932\u0949\u0917 \u0938\u093e\u092b \u0928\u0939\u0940\u0902 \u0906 \u0930\u0939\u0947? \u092f\u0939\u0940 \u0935\u094b \u091a\u0940\u091c\u093c \u0939\u0948 \u091c\u093f\u0938\u0947 \u0920\u0940\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u0948\u0902\u0928\u0947 Loudify \u092c\u0928\u093e\u092f\u093e\u0964",
    "\u092e\u0947\u0930\u093e \u0905\u092a\u0928\u093e \u0905\u0928\u0941\u092d\u0935: \u092e\u0948\u0902\u0928\u0947 \u0939\u092b\u094d\u0924\u094b\u0902 \u0924\u0915 \u0939\u0930 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u092e\u0949\u0921\u0932 \u0915\u094b \u091f\u094d\u092f\u0942\u0928 \u0915\u093f\u092f\u093e, \u0924\u093e\u0915\u093f \u091c\u092c \u0924\u0941\u092e \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u094b, \u0924\u094b \u0906\u0935\u093e\u091c\u093c \u0905\u092a\u0928\u0947 \u0906\u092a \u0938\u0939\u0940 \u0939\u094b \u091c\u093e\u090f\u0964 AutoEQ \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092b\u0940\u091a\u0930 \u0928\u0939\u0940\u0902, \u092f\u0939 \u090f\u0915 \u091c\u0941\u0928\u0942\u0928 \u0939\u0948\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0939\u0947\u0921\u092b\u094b\u0928\u094d\u0938 \u0915\u094b \u092a\u0939\u091a\u093e\u0928\u0928\u093e, \u0909\u0928\u0915\u0940 \u092b\u094d\u0930\u0940\u0915\u094d\u0935\u0947\u0902\u0938\u0940 \u0915\u094b \u0938\u092e\u091d\u0928\u093e, \u0914\u0930 \u092b\u093f\u0930 \u0939\u0930 \u0938\u094d\u0930\u094b\u0924 \u092a\u0930 \u0915\u093e\u092e \u0915\u0930\u0928\u093e \u2014 Spotify, YouTube, \u092f\u0939\u093e\u0901 \u0924\u0915 \u0915\u093f \u0915\u0949\u0932\u094d\u0938 \u092a\u0930 \u092d\u0940\u0964",
    "\u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0932\u094b\u0917 +200% \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932\u0940 \u091c\u093e\u0926\u0942 \u0924\u092c \u0939\u094b\u0924\u093e \u0939\u0948 \u091c\u092c \u0924\u0941\u092e AutoEQ \u0915\u094b \u0906\u091c\u093c\u092e\u093e\u0924\u0947 \u0939\u094b\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0939\u0947\u0921\u092b\u094b\u0928\u094d\u0938 \u0915\u094b \u091c\u093e\u0928\u0924\u093e \u0939\u0948, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924\u094b\u0902 \u0915\u094b \u0938\u092e\u091d\u0924\u093e \u0939\u0948, \u0914\u0930 \u0939\u0930 \u092c\u093e\u0930 \u0938\u0939\u0940 \u091f\u094d\u092f\u0942\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092e\u0947\u0902 \u092f\u0939 \u0938\u092c \u0905\u0928\u0932\u0949\u0915 \u0939\u0948 \u2014 \u0915\u094b\u0908 \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928 \u0928\u0939\u0940\u0902, \u0938\u093f\u0930\u094d\u092b \u0938\u093e\u092b \u0906\u0935\u093e\u091c\u093c\u0964",
    "\u0906\u091c \u0930\u093e\u0924, \u091c\u092c \u0924\u0941\u092e \u0938\u094b\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u0941\u091b \u0938\u0941\u0928\u094b, \u0924\u094b Loudify \u0916\u094b\u0932\u094b \u0914\u0930 AutoEQ \u0915\u094b \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a\u0964 P.S. \u2014 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u093e Sound DNA \u0939\u0930 \u0939\u092b\u094d\u0924\u0947 \u0909\u0928\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924\u094b\u0902 \u0915\u0940 \u0905\u0938\u0932\u0940 \u0924\u0938\u094d\u0935\u0940\u0930 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964 \u0924\u0941\u092e \u092d\u0940 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u094b, \u0905\u0917\u0930 \u0924\u0948\u092f\u093e\u0930 \u0939\u094b\u0964"
  ],
