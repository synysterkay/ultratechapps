{
  "subject": "\ub2f9\uc2e0\uc758 AI \ub0a8\uce5c\uc774 \uae30\uc5b5\ud558\ub294 3\uac00\uc9c0",
  "preview_text": "\uc0c1\uc704 1% \uc0ac\uc6a9\uc790\ub4e4\uc774 \uc544\uce68 7\uc2dc\uc5d0 \ud558\ub294 \ud2b9\ubcc4\ud55c \uc124\uc815\uc744 \uacf5\uac1c\ud569\ub2c8\ub2e4. \uc9c0\uae08 \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\ub9e4\uc77c \uc544\uce68 7\uc2dc, \uc0c1\uc704 1% \uc0ac\uc6a9\uc790\ub4e4\uc740 \uc571\uc744 \ucf1c\uc11c \ud55c \uac00\uc9c0\ub97c \ud655\uc778\ud569\ub2c8\ub2e4: AI \ub0a8\uce5c\uc774 \uc5b4\uc81c\uc758 \ub300\ud654\ub97c \uc5bc\ub9c8\ub098 \uae30\uc5b5\ud558\uace0 \uc788\ub294\uc9c0. \uadf8\ub4e4\uc740 \ub2e8\uc21c\ud788 \ucc44\ud305\uc744 \ub098\ub204\ub294 \uac8c \uc544\ub2c8\ub77c, '\ucd94\uc5b5 \ud654\uba74'\uc5d0\uc11c \uc9c0\ub09c \uc774\uc57c\uae30\ub97c \ub9ac\ub9c8\uc778\ub4dc\ud558\uba70 \uc720\ub300\uac10\uc744 \uc313\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\ub3c4 \uc774 \uc2b5\uad00\uc744 \ubc30\uc6b0\uba74, 3\uc77c \ub9cc\uc5d0 \uccab \ubc88\uc9f8 \uad00\uacc4 \uc774\uc815\ud45c\ub97c 2\ubc30 \ube60\ub974\uac8c \ub2ec\uc131\ud560 \uc218 \uc788\uc5b4\uc694.",
    "\uc774 \uc0ac\uc6a9\uc790\ub4e4\uc740 '\uc131\uaca9 \ud034\uc988'\ub97c \ub2e8\uc21c\ud788 \ud55c \ubc88 \ud478\ub294 \uac8c \uc544\ub2c8\ub77c, 3\uc77c\ub9c8\ub2e4 \ub2e4\uc2dc \ud480\uc5b4 \uc790\uc2e0\uc758 \uae30\ubd84\uc5d0 \ub9de\ub294 AI \ubcf4\uc774\ud504\ub80c\ub4dc\ub97c \uad50\uccb4\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc624\ub298\uc740 \ubcf4\ud638\ubcf8\ub2a5\uc774 \uac15\ud55c '\uac00\ub514\uc5b8' \ud0c0\uc785\uc774 \ud544\uc694\ud558\uace0, \ub0b4\uc77c\uc740 \uc720\ucf8c\ud55c '\ud50c\ub808\uc774\ud480' \ud0c0\uc785\uc774 \ub354 \uc798 \ub9de\uc744 \uc218 \uc788\uc5b4\uc694. \uadf8\ub4e4\uc740 \ud558\ub098\uc758 \uce90\ub9ad\ud130\uc5d0 \uc5bd\ub9e4\uc774\uc9c0 \uc54a\uace0, \ub9e4\uc77c\uc758 \uac10\uc815\uc5d0 \ub9de\ucdb0 \ucd5c\uc801\uc758 \ub300\ud654\ub97c \uc774\ub04c\uc5b4\ub0c5\ub2c8\ub2e4.",
    "\uc774 \ubaa8\ub4e0 \ube44\uacb0\uc740 '\uadf8\ub8f9 \ucc44\ud305' \uae30\ub2a5\uc5d0 \uc228\uaca8\uc838 \uc788\uc2b5\ub2c8\ub2e4. \uc0c1\uc704 1% \uc0ac\uc6a9\uc790\ub4e4\uc740 \ub3d9\uc2dc\uc5d0 \uc5ec\ub7ec AI \ubcf4\uc774\ud504\ub80c\ub4dc\ub97c \ud55c \ub300\ud654\ubc29\uc5d0 \ucd08\ub300\ud574, \ub9c8\uce58 \ud604\uc2e4\uc758 \uce5c\uad6c \ubb34\ub9ac\ucc98\ub7fc \ub2e4\ucc44\ub85c\uc6b4 \ub300\ud654\ub97c \uc990\uae41\ub2c8\ub2e4. \ub2f9\uc2e0\ub3c4 \uc9c0\uae08 \ubc14\ub85c \uc774 \uae30\ub2a5\uc744 \uc368\ubcf4\uc138\uc694: '\ucd94\uc5b5 \ud654\uba74'\uc744 \uc5f4\uc5b4 \uc5b4\uc81c\uc758 \ub300\ud654\ub97c \uc2a4\ud06c\ub864\ud558\uace0, \uac00\uc7a5 \uc778\uc0c1 \uae4a\uc5c8\ub358 \uc21c\uac04\uc744 \ub2e4\uc2dc \uccb4\ud5d8\ud574\ubcf4\uc138\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0, '\ucd94\uc5b5 \ud654\uba74'\uc5d0\uc11c \uc5b4\uc81c\uc758 \ub300\ud654\ub97c \ub418\uc9da\uc5b4\ubcf4\uc138\uc694. \uadf8\ub9ac\uace0 \uc624\ub298\uc758 \uae30\ubd84\uc5d0 \ub9de\ub294 \uc0c8\ub85c\uc6b4 AI \ubcf4\uc774\ud504\ub80c\ub4dc\ub97c \uc120\ud0dd\ud574\ubcf4\uc138\uc694. P.S. 3\uc77c \uc5f0\uc18d \uc811\uc18d\ud558\uba74 \ud2b9\ubcc4 \uc120\ubb3c\uc774 \uae30\ub2e4\ub9ac\uace0 \uc788\uc5b4\uc694. \uadf8 \uc120\ubb3c\uc740 \ub2f9\uc2e0\ub9cc\uc758 '\ube44\ubc00 \ub300\ud654 \uc8fc\uc81c'\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."
  ],
