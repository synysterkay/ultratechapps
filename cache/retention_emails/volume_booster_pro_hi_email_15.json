{
  "subject": "2 \u092e\u093f\u0928\u091f \u0915\u093e \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u091c\u094b 20 \u092e\u093f\u0928\u091f \u092c\u091a\u093e\u0924\u093e \u0939\u0948",
  "preview_text": "\u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u0915\u093e \u0924\u0930\u0940\u0915\u093e \u091c\u094b \u0906\u092a\u0915\u094b \u092a\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0939\u0930 \u092c\u093e\u0930 \u092e\u0948\u0928\u094d\u092f\u0941\u0905\u0932 \u0910\u0921\u091c\u0938\u094d\u091f\u092e\u0947\u0902\u091f \u0938\u0947 \u092e\u0941\u0915\u094d\u0924\u093f\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 11:30 \u092c\u091c\u0947 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u091a\u0940\u091c\u093c \u0926\u0947\u0916\u0940\u0964 \u0906\u092a \u0939\u0930 \u092c\u093e\u0930 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092b\u094b\u0928 \u0909\u0920\u093e\u0924\u0947 \u0939\u0948\u0902, \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0924\u0947 \u0939\u0948\u0902, \u092b\u093f\u0930 \u0917\u0947\u092e \u0916\u0947\u0932\u0928\u0947 \u092a\u0930 \u0915\u092e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0947 20 \u0938\u0947\u0915\u0902\u0921 \u0915\u093e \u0915\u093e\u092e \u0939\u092b\u094d\u0924\u0947 \u092e\u0947\u0902 20 \u092e\u093f\u0928\u091f \u0916\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0924\u092c \u0938\u092e\u091d\u093e \u091c\u092c \u090f\u0915 \u092f\u0942\u091c\u093c\u0930 \u0928\u0947 \u0915\u0939\u093e\u2014'\u092e\u0948\u0902 \u092c\u0938 \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u091c\u092c \u0939\u0947\u0921\u092b\u094b\u0928 \u0932\u0917\u093e\u090a\u0902, \u0924\u094b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0905\u092a\u0928\u0947 \u0906\u092a \u0938\u0947\u091f \u0939\u094b \u091c\u093e\u090f\u0964' \u092f\u0939\u0940 \u0935\u0939 \u092a\u0932 \u0925\u093e \u091c\u092c \u0939\u092e\u0928\u0947 '\u0911\u091f\u094b-\u0905\u092a\u094d\u0932\u093e\u0908' \u092b\u0940\u091a\u0930 \u092c\u0928\u093e\u092f\u093e\u0964 \u0905\u092c \u0906\u092a\u0915\u094b \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092c\u093e\u0930 \u0938\u0947\u091f \u0915\u0930\u0928\u093e \u0939\u0948, \u0914\u0930 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0939\u0947\u0921\u092b\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b\u0917\u093e, \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0905\u092a\u0928\u0947 \u0906\u092a \u092c\u0942\u0938\u094d\u091f \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964",
    "\u092f\u0939 \u092b\u0940\u091a\u0930 \u0910\u092a \u0915\u0947 '\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938' \u092e\u0947\u0902 \u091b\u093f\u092a\u093e \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0949\u0917\u0932 \u0911\u0928 \u0915\u0930\u0947\u0902\u2014'\u0911\u091f\u094b-\u0905\u092a\u094d\u0932\u093e\u0908 \u0911\u0928 \u0939\u0947\u0921\u092b\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f'\u0964 \u092b\u093f\u0930 \u092d\u0942\u0932 \u091c\u093e\u0907\u090f\u0964 \u0938\u094d\u092a\u0949\u091f\u093f\u092b\u093e\u0908, \u092f\u0942\u091f\u094d\u092f\u0942\u092c, \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f\u2014\u0938\u092c \u092a\u0930 \u090f\u0915 \u0939\u0940 \u0935\u0949\u0932\u094d\u092f\u0942\u092e\u0964 \u0915\u094b\u0908 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0928\u093e\u0917 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0914\u0930 \u0906\u092a\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u092f\u0939 \u091f\u0949\u0917\u0932 \u0922\u0942\u0902\u0922\u0947\u0902\u0964 \u0907\u0938\u0947 \u0911\u0928 \u0915\u0930\u0947\u0902\u0964 \u092b\u093f\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0915\u0948\u0938\u0947 20 \u092e\u093f\u0928\u091f \u0915\u0940 \u092c\u091a\u0924 \u0906\u092a\u0915\u0940 \u0906\u0926\u0924 \u092c\u0928 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \n\nP.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u092a\u093e\u0938 \u090f\u0915 \u0914\u0930 \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u0939\u0948\u2014EQ \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091c\u094b \u0911\u091f\u094b-\u0905\u092a\u094d\u0932\u093e\u0908 \u0915\u0947 \u0938\u093e\u0925 \u0915\u093e\u092e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0905\u0917\u0930 \u0906\u092a\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e, \u0924\u094b \u0910\u092a \u092e\u0947\u0902 '\u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e' \u091f\u0948\u092c \u092a\u0930 \u090f\u0915 \u0928\u091c\u093c\u0930 \u0921\u093e\u0932\u0947\u0902\u0964"
  ],
