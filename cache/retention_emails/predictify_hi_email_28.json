{
  "subject": "\u0907\u0938 \u0938\u0940\u091c\u093c\u0928 \u0915\u0940 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u0917\u0932\u0924\u0940 \u092e\u0924 \u0915\u0930\u094b - \u092f\u0939 \u0938\u0941\u0935\u093f\u0927\u093e \u0905\u092d\u0940 \u091c\u0930\u0942\u0930\u0940 \u0939\u0948",
  "preview_text": "\u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0935\u093f\u0902\u0921\u094b \u0916\u0941\u0932\u0940 \u0939\u0948 \u0914\u0930 \u0939\u0930 \u092b\u0948\u0928 \u090f\u0915 \u0939\u0940 \u0917\u0932\u0924\u0940 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964 \u0924\u0941\u092e \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0947\u0964",
  "body_paragraphs": [
    "\u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0935\u093f\u0902\u0921\u094b \u091a\u0932 \u0930\u0939\u0940 \u0939\u0948\u0964 \u0939\u0930 \u0915\u094b\u0908 \u092c\u0938 \u0916\u092c\u0930\u094b\u0902 \u0914\u0930 \u0905\u092b\u0935\u093e\u0939\u094b\u0902 \u092a\u0930 \u091a\u093f\u0932\u094d\u0932\u093e \u0930\u0939\u093e \u0939\u0948\u0964 '\u092f\u0939 \u0938\u094d\u091f\u094d\u0930\u093e\u0907\u0915\u0930 \u0939\u092e\u0947\u0902 \u091a\u0948\u0902\u092a\u093f\u092f\u0928 \u092c\u0928\u093e\u090f\u0917\u093e!' '\u092f\u0939 \u0921\u093f\u092b\u0947\u0902\u0921\u0930 \u092c\u0930\u094d\u092c\u093e\u0926 \u0915\u0930 \u0926\u0947\u0917\u093e!' \u0938\u092c\u0915\u093e \u0926\u093f\u0932 \u0926\u093f\u092e\u093e\u0917 \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u092d\u093e\u0935\u0928\u093e\u0913\u0902 \u0938\u0947 \u0915\u093e\u092e \u0932\u0947 \u0930\u0939\u093e \u0939\u0948\u0964 \u0914\u0930 \u092f\u0939\u0940\u0902 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u0917\u0932\u0924\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0915\u093e \u0938\u092e\u092f \u0938\u093f\u0930\u094d\u092b \u0916\u092c\u0930\u0947\u0902 \u092a\u0922\u093c\u0928\u0947 \u0915\u093e \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0921\u0947\u091f\u093e \u0938\u0947 \u0938\u0935\u093e\u0932 \u092a\u0942\u091b\u0928\u0947 \u0915\u093e \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0928\u092f\u093e \u0938\u093e\u0907\u0928\u093f\u0902\u0917 \u0935\u093e\u0915\u0908 \u091f\u0940\u092e \u0915\u0940 \u090f\u0915\u094d\u0938\u092a\u0947\u0915\u094d\u091f\u0947\u0921 \u0917\u094b\u0932 (xG) \u092c\u0922\u093c\u093e\u090f\u0917\u093e? \u0915\u094d\u092f\u093e \u092f\u0939 \u0916\u093f\u0932\u093e\u0921\u093c\u0940 \u092a\u093f\u091b\u0932\u0940 \u091f\u0940\u092e \u0915\u0947 \u0938\u093f\u0938\u094d\u091f\u092e \u092e\u0947\u0902 \u0939\u0940 \u0905\u091a\u094d\u091b\u093e \u0925\u093e? \u091c\u0935\u093e\u092c \u0938\u092c\u0915\u0947 \u092a\u093e\u0938 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0938\u093f\u0930\u094d\u092b \u0909\u0928\u0915\u0947 \u092a\u093e\u0938 \u0939\u0948 \u091c\u094b \u0905\u0902\u0927\u0947 \u0905\u0928\u0941\u092e\u093e\u0928 \u0928\u0939\u0940\u0902, \u0920\u094b\u0938 \u0906\u0902\u0915\u0921\u093c\u0947 \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964",
    "Predictify \u0915\u093e AI \u091a\u0948\u091f \u092b\u0940\u091a\u0930 \u0916\u094b\u0932\u094b\u0964 \u0905\u092d\u0940\u0964 \u0909\u0938\u0938\u0947 \u0938\u0940\u0927\u0947 \u092a\u0942\u091b\u094b: '\u092e\u0948\u0928 \u092f\u0942\u0928\u093e\u0907\u091f\u0947\u0921 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938 \u0928\u090f \u0935\u093f\u0902\u0917\u0930 \u0915\u093e xG \u0915\u094d\u092f\u093e \u0930\u0939\u0947\u0917\u093e?' \u092f\u093e '\u0906\u0930\u094d\u0938\u0947\u0928\u0932 \u0915\u0940 \u0921\u093f\u092b\u0947\u0902\u0938 \u0907\u0938 \u0928\u090f \u0938\u0947\u0902\u091f\u0930-\u092c\u0948\u0915 \u0938\u0947 \u0915\u093f\u0924\u0928\u0940 \u092e\u091c\u092c\u0942\u0924 \u0939\u094b\u0917\u0940?' \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0938\u0947\u0915\u0902\u0921\u094b\u0902 \u092e\u0947\u0902 \u0935\u094b \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u092e\u093f\u0932\u0947\u0917\u093e \u091c\u094b \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u092e\u0948\u091a\u094b\u0902 \u0915\u0947 \u0921\u0947\u091f\u093e \u092a\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0939\u0948\u0964 \u092f\u0939 \u0938\u0941\u0935\u093f\u0927\u093e \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0939\u0930 \u092b\u0948\u0928 \u0938\u0947 \u0926\u094b \u0915\u0926\u092e \u0906\u0917\u0947 \u0930\u0916 \u0926\u0947\u0917\u0940\u0964",
    "\u0905\u092a\u0928\u0940 \u092b\u0941\u091f\u092c\u0949\u0932 IQ \u0915\u094b \u0938\u093e\u092c\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u093e \u092f\u0939 \u0938\u0939\u0940 \u092e\u094c\u0915\u093e \u0939\u0948\u0964 \u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b, AI \u091a\u0948\u091f \u092a\u0930 \u091c\u093e\u0913, \u0914\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0935\u093f\u0902\u0921\u094b \u092a\u0930 \u0915\u094b\u0908 \u092d\u0940 \u0938\u0935\u093e\u0932 \u0926\u093e\u0917 \u0926\u094b\u0964 \u0926\u0947\u0916\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0926\u094b\u0938\u094d\u0924 \u0915\u0948\u0938\u0947 \u0939\u0948\u0930\u093e\u0928 \u0930\u0939 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902 \u091c\u092c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092c\u093e\u0924\u091a\u0940\u0924 \u092e\u0947\u0902 \u0938\u093f\u0930\u094d\u092b \u091c\u094b\u0936 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0906\u0902\u0915\u0921\u093c\u0947 \u0939\u094b\u0902\u0917\u0947\u0964 \u092a\u0940.\u090f\u0938.: \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0915\u0947 3-\u0926\u093f\u0928 \u0915\u0947 \u091f\u094d\u0930\u093e\u092f\u0932 \u092e\u0947\u0902 \u0924\u0941\u092e \u0905\u0938\u0940\u092e\u093f\u0924 \u0938\u0935\u093e\u0932 \u092a\u0942\u091b \u0938\u0915\u0924\u0947 \u0939\u094b\u0964 \u0907\u0938 \u0935\u093f\u0902\u0921\u094b \u0915\u0947 \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u091c\u0930\u0942\u0930 \u0906\u091c\u092e\u093e\u0913\u0964"
  ],
