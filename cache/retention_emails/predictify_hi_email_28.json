  "subject": "\u092e\u0948\u091a \u0915\u0947 59 \u092e\u093f\u0928\u091f \u2014 67% \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0915\u0949\u0932",
  "preview_text": "\u0906\u092a\u0915\u093e \u092b\u0947\u0935\u0930\u0947\u091f \u092e\u0948\u091a \u0905\u092d\u0940 \u091a\u0932 \u0930\u0939\u093e \u0939\u0948\u0964 \u0915\u094d\u092f\u093e AI \u0915\u0939 \u0930\u0939\u093e \u0939\u0948? \u0905\u0902\u0926\u0930 \u0926\u0947\u0916\u0947\u0902\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0930, \u0915\u0932 \u0930\u093e\u0924 \u092e\u0948\u0902 \u0938\u094b\u092b\u0947 \u092a\u0930 \u092c\u0948\u0920\u093e \u0925\u093e \u0914\u0930 \u092e\u0948\u091a \u0926\u0947\u0916 \u0930\u0939\u093e \u0925\u093e\u0964 59\u0935\u0947\u0902 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u092e\u0941\u091d\u0947 \u0932\u0917\u093e \u0915\u093f \u0917\u094b\u0932 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092e\u0947\u0930\u093e gut feeling 100% \u0938\u0939\u0940 \u0928\u0939\u0940\u0902 \u0925\u093e\u0964 \u0924\u092c \u092e\u0948\u0902\u0928\u0947 Predictify \u0916\u094b\u0932\u093e\u0964",
    "AI \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0909\u0938 \u092e\u0948\u091a \u092e\u0947\u0902 \u0905\u091f\u0948\u0915\u093f\u0902\u0917 \u090f\u092b\u093f\u0936\u093f\u090f\u0902\u0938\u0940 73% \u0925\u0940 \u0914\u0930 \u0921\u093f\u092b\u0947\u0902\u0938 \u0915\u092e\u091c\u094b\u0930\u0964 67% \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0917\u094b\u0932 \u0915\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u0940 \u0926\u0940\u0964 \u0914\u0930 \u0939\u093e\u0901, 61\u0935\u0947\u0902 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0917\u094b\u0932 \u0939\u094b \u0917\u092f\u093e\u0964 \u092f\u0939 \u0915\u094b\u0908 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902, \u0921\u0947\u091f\u093e \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0906\u092a\u0915\u0947 \u092b\u0947\u0935\u0930\u0947\u091f \u0932\u0940\u0917 \u0915\u0947 \u092e\u0948\u091a \u091a\u0932 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 Predictify \u0915\u093e AI \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f \u0932\u093e\u0907\u0935 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0926\u0947 \u0930\u0939\u093e \u0939\u0948 \u2014 \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0915\u0947 \u0938\u093e\u0925\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0938\u0947 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0915\u093f\u0938 \u091f\u0940\u092e \u0915\u0947 \u092a\u093e\u0938 \u091c\u0940\u0924\u0928\u0947 \u0915\u093e \u092e\u094c\u0915\u093e \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0947 \u092e\u0948\u091a \u0915\u093e \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u091a\u0947\u0915 \u0915\u0930\u0947\u0902\u0964 P.S. \u2014 \u0905\u0917\u0930 \u0906\u092a \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902 (3 \u0926\u093f\u0928 \u092b\u094d\u0930\u0940), \u0924\u094b \u0938\u092d\u0940 \u0932\u0940\u0917 \u0915\u0947 \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u0906\u0902\u0915\u0921\u093c\u0947 \u0905\u0928\u0932\u0949\u0915 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 12.99 \u0921\u0949\u0932\u0930/\u092e\u0939\u0940\u0928\u093e, \u0932\u0947\u0915\u093f\u0928 \u092a\u0939\u0932\u0947 3 \u0926\u093f\u0928 \u092e\u0941\u092b\u094d\u0924\u0964"
