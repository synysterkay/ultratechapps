{
  "subject": "30 \u0434\u043d\u0435\u0439 \u0441 \u043d\u0430\u043c\u0438 \u2014 200% \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438",
  "preview_text": "\u0422\u044b \u0447\u0430\u0441\u0442\u044c \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0441\u043b\u0443\u0448\u0430\u0435\u0442 \u0433\u0440\u043e\u043c\u0447\u0435. \u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u0432\u043a\u043b\u044e\u0447\u0438 \u0431\u0430\u0441-\u0431\u0443\u0441\u0442\u0435\u0440.",
  "body_paragraphs": [
    "\u0422\u044b \u0437\u043d\u0430\u0435\u0448\u044c \u044d\u0442\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e, \u043a\u043e\u0433\u0434\u0430 \u043d\u0430\u0436\u0438\u043c\u0430\u0435\u0448\u044c \u043d\u0430 \u043f\u043b\u044e\u0441\u0438\u043a \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438, \u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0443\u0436\u0435 \u043d\u0430 \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c\u0435? \u042f \u0442\u043e\u0436\u0435 \u0447\u0435\u0440\u0435\u0437 \u044d\u0442\u043e \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043b. \u041d\u043e \u0442\u0435\u043f\u0435\u0440\u044c \u0443 \u043d\u0430\u0441 \u0435\u0441\u0442\u044c Volume Booster, \u0438 \u044d\u0442\u043e \u043c\u0435\u043d\u044f\u0435\u0442 \u0432\u0441\u0451. \u0417\u0430 30 \u0434\u043d\u0435\u0439 \u0441 \u043d\u0430\u043c\u0438 \u0442\u044b \u0441\u0442\u0430\u043b \u0447\u0430\u0441\u0442\u044c\u044e \u0433\u0440\u0443\u043f\u043f\u044b \u043b\u044e\u0434\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c \u043e\u0442 \u0442\u0438\u0448\u0438\u043d\u044b \u0438 \u0441\u043a\u0443\u0447\u043d\u043e\u0433\u043e \u0437\u0432\u0443\u043a\u0430.",
    "\u041a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u0442\u044b\u0441\u044f\u0447\u0438 \u0442\u0430\u043a\u0438\u0445 \u0436\u0435, \u043a\u0430\u043a \u0442\u044b, \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0447\u0442\u043e\u0431\u044b \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043c\u0443\u0437\u044b\u043a\u0443, \u043f\u043e\u0434\u043a\u0430\u0441\u0442\u044b \u0438\u043b\u0438 \u0444\u0438\u043b\u044c\u043c\u044b \u0433\u0440\u043e\u043c\u0447\u0435 \u0438 \u043d\u0430\u0441\u044b\u0449\u0435\u043d\u043d\u0435\u0435. \u041c\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0432\u044b\u0448\u0430\u0435\u043c \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u2014 \u043c\u044b \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u043c \u0431\u0430\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0442\u0435\u0440\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u0434\u0435\u0448\u0451\u0432\u044b\u0445 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430\u0445. \u0422\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0437\u0432\u0443\u0447\u0438\u0442 \u0438\u043d\u0430\u0447\u0435, \u0438 \u0442\u044b \u044d\u0442\u043e \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u043b.",
    "\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u0441 \u043f\u0440\u0435\u0441\u0435\u0442\u0430\u043c\u0438: \u0432\u044b\u0431\u0435\u0440\u0438 \u00ab\u0420\u043e\u043a\u00bb \u0434\u043b\u044f \u043a\u043e\u043d\u0446\u0435\u0440\u0442\u043d\u043e\u0433\u043e \u0437\u0432\u0443\u043a\u0430 \u0438\u043b\u0438 \u00ab\u0414\u0436\u0430\u0437\u00bb \u0434\u043b\u044f \u0442\u0451\u043f\u043b\u044b\u0445 \u0447\u0430\u0441\u0442\u043e\u0442. \u0410 \u0435\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c, \u0447\u0442\u043e\u0431\u044b \u0431\u0430\u0441 \u0431\u0438\u043b \u0432 \u0433\u0440\u0443\u0434\u044c, \u0432\u043a\u043b\u044e\u0447\u0438 Bass Booster \u043d\u0430 \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c. \u042d\u0442\u043e \u043a\u0430\u043a \u043a\u0443\u043f\u0438\u0442\u044c \u043d\u043e\u0432\u0443\u044e \u043a\u043e\u043b\u043e\u043d\u043a\u0443, \u043d\u043e \u0431\u0435\u0437 \u0434\u0435\u043d\u0435\u0433.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Volume Booster \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043d\u0430\u0436\u043c\u0438 \u043d\u0430 \u043a\u043d\u043e\u043f\u043a\u0443 \u00ab\u0423\u0441\u0438\u043b\u0438\u0442\u044c\u00bb \u2014 \u043f\u0443\u0441\u0442\u044c \u0441\u043e\u0441\u0435\u0434\u0438 \u0437\u043d\u0430\u044e\u0442, \u0447\u0442\u043e \u0442\u044b \u0437\u0434\u0435\u0441\u044c. P.S. \u0422\u044b \u0443\u0436\u0435 \u043f\u0440\u043e\u0431\u043e\u0432\u0430\u043b \u043f\u0440\u0435\u043c\u0438\u0443\u043c? \u0422\u0430\u043c \u0431\u0435\u0437\u043b\u0438\u043c\u0438\u0442\u043d\u044b\u0435 \u0443\u0440\u043e\u0432\u043d\u0438 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u044f \u0438 \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u0442\u044b\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440. \u041f\u0435\u0440\u0432\u044b\u0439 \u043c\u0435\u0441\u044f\u0446 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e \u2014 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0436\u043d\u0438 \u043d\u0430 \u0437\u0432\u0451\u0437\u0434\u043e\u0447\u043a\u0443 \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438."
  ],
