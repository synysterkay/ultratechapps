{
  "subject": "70 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0924\u0941\u092e\u0928\u0947 \u0915\u094d\u092f\u093e \u092c\u0928\u093e\u092f\u093e",
  "preview_text": "\u092f\u0939 \u0910\u092a \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092c\u093f\u0928\u093e \u0905\u0927\u0942\u0930\u093e \u0939\u0948\u0964 \u0926\u0947\u0916\u094b \u0924\u0941\u092e\u0928\u0947 \u0915\u094d\u092f\u093e \u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e\u0964",
  "body_paragraphs": [
    "70 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0924\u0941\u092e\u0928\u0947 \u090f\u0915 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0916\u0940\u0902\u091a\u093e \u0925\u093e\u0964 \u092c\u0938 \u090f\u0915 \u0938\u094d\u0932\u093e\u0907\u0921\u0930\u0964 \u0915\u094b\u0908 \u0936\u094b\u0930 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0928\u0939\u0940\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u0935\u0939 \u092a\u0932 \u0939\u092e\u093e\u0930\u0947 \u0932\u093f\u090f \u090f\u0915 \u0928\u0908 \u0936\u0941\u0930\u0941\u0906\u0924 \u0925\u0940\u0964 \u0924\u0941\u092e\u0928\u0947 \u0939\u092e\u0947\u0902 \u0938\u093f\u0916\u093e\u092f\u093e \u0915\u093f \u0938\u091a\u094d\u091a\u0940 \u0909\u092a\u092f\u094b\u0917\u093f\u0924\u093e \u091a\u0941\u092a\u091a\u093e\u092a \u0906\u0924\u0940 \u0939\u0948\u0964",
    "\u0939\u0930 \u0930\u094b\u091c\u093c \u0924\u0941\u092e \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u091c\u094b\u0921\u093c\u0924\u0947 \u0939\u094b, \u0914\u0930 \u0939\u092e\u093e\u0930\u093e \u0907\u0902\u091c\u0928 \u092c\u093f\u0928\u093e \u0915\u0941\u091b \u0915\u0939\u0947 \u0906\u0935\u093e\u091c\u093c \u092c\u0922\u093c\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0928\u093e\u0917 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u0935\u0939 \u0936\u093e\u0902\u0924, \u0938\u093e\u092b\u093c \u0905\u0928\u0941\u092d\u0935 \u091c\u094b \u0924\u0941\u092e \u091a\u093e\u0939\u0924\u0947 \u0925\u0947\u0964 \u0924\u0941\u092e \u0907\u0938 \u0910\u092a \u0915\u0947 \u0905\u0938\u0932\u0940 \u092e\u093e\u0932\u093f\u0915 \u0939\u094b\u2014\u0939\u092e \u0938\u093f\u0930\u094d\u092b\u093c \u0915\u094b\u0921 \u0932\u093f\u0916\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0906\u091c \u0939\u092e\u0928\u0947 \u090f\u0915 \u0928\u092f\u093e \u092b\u0940\u091a\u0930 \u091c\u094b\u0921\u093c\u093e \u0939\u0948\u2014'\u0932\u0947\u0917\u0947\u0938\u0940 \u092e\u094b\u0921'\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0939\u0948\u0964 \u091c\u092c \u0924\u0941\u092e \u0907\u0938\u0947 \u091a\u093e\u0932\u0942 \u0915\u0930\u094b\u0917\u0947, \u0924\u094b \u0910\u092a \u0939\u0930 \u092c\u093e\u0930 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b\u0928\u0947 \u092a\u0930 \u0905\u092a\u0928\u0947 \u0906\u092a \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f \u0915\u0930\u0947\u0917\u093e, \u0914\u0930 \u092b\u093f\u0930 \u0917\u093e\u092f\u092c \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0935\u0948\u0938\u0947 \u091c\u0948\u0938\u0947 \u0924\u0941\u092e\u0928\u0947 \u091a\u093e\u0939\u093e \u0925\u093e\u0964 \u0915\u094b\u0908 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u092c\u091f\u0928 \u0928\u0939\u0940\u0902\u0964 \u092c\u0938 \u0935\u0939 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u091c\u094b \u0939\u092e\u0947\u0936\u093e \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0925\u093e\u0964",
    "\u0905\u092c \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 '\u0932\u0947\u0917\u0947\u0938\u0940 \u092e\u094b\u0921' \u0915\u094b \u0911\u0928 \u0915\u0930\u094b\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0910\u092a \u0939\u0948\u2014\u0907\u0938\u0947 \u0905\u092a\u0928\u093e \u092c\u0928\u093e\u0913\u0964\n\nP.S. \u091c\u092c \u0924\u0941\u092e \u092f\u0939 \u092e\u094b\u0921 \u0911\u0928 \u0915\u0930\u094b\u0917\u0947, \u0924\u094b \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c\u093c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 \u0926\u0947\u0916 \u0932\u094b\u0964"
  ],
