{
  "subject": "45 \u0926\u093f\u0928, 20 \u0908\u092e\u0947\u0932 \u2013 \u0905\u092c \u0906\u0917\u0947 \u0915\u094d\u092f\u093e?",
  "preview_text": "\u0906\u092a \u0905\u092c \u0928\u090f \u092f\u0942\u091c\u093c\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964 \u092f\u0939\u093e\u0901 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u093e \u0939\u0948 \u0905\u0938\u0932\u0940 \u0938\u092b\u0930 \u2013 \u090f\u0915 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930 \u092f\u093e \u090f\u092e\u094d\u092c\u0947\u0938\u0947\u0921\u0930 \u092c\u0928\u0928\u0947 \u0915\u093e\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u094b \u092a\u0939\u0932\u0940 \u0930\u093e\u0924 \u091c\u092c \u0906\u092a\u0928\u0947 \u0921\u0947\u0921\u0932\u093e\u0907\u0928 \u0915\u0947 \u0921\u0930 \u0938\u0947 Thesis Generator \u0916\u094b\u0932\u093e \u0925\u093e? \u0935\u094b \u0916\u093e\u0932\u0940 \u092a\u0947\u091c, \u0935\u094b \u0918\u092c\u0930\u093e\u0939\u091f \u2013 \u0905\u092c \u0935\u094b \u0906\u092a\u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u0948\u0964 45 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0906\u092a\u0928\u0947 \u0935\u094b \u0915\u093f\u092f\u093e \u091c\u094b 90% \u0932\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u0930 \u092a\u093e\u0924\u0947: \u0906\u092a\u0928\u0947 \u0907\u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e, \u0938\u0940\u0916\u093e \u0914\u0930 \u092c\u0922\u093c\u0947\u0964",
    "\u0932\u0947\u0915\u093f\u0928 \u092f\u0939\u093e\u0901 \u090f\u0915 \u0938\u091a \u0939\u0948: \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0925\u0940\u0938\u093f\u0938 \u091c\u0947\u0928\u0930\u0947\u091f\u0930 \u0915\u094b \u090f\u0915 \u091f\u0942\u0932 \u0915\u0940 \u0924\u0930\u0939 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u0947 \u090f\u0915 \u092c\u093e\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092d\u0942\u0932 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a \u0909\u0928\u092e\u0947\u0902 \u0938\u0947 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964 \u0906\u092a\u0928\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0926\u093f\u0916\u093e\u092f\u093e \u0939\u0948 \u0915\u093f \u0906\u092a \u090f\u0915 \u0938\u094d\u091f\u094d\u0930\u0948\u091f\u0947\u091c\u093f\u0915 \u0930\u093e\u0907\u091f\u0930 \u0939\u0948\u0902 \u2013 \u091c\u094b \u0932\u093f\u0916\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0938\u094b\u091a\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u0905\u0917\u0932\u0947 \u0932\u0947\u0935\u0932 \u092a\u0930 \u091c\u093e\u0928\u0947 \u0915\u093e\u0964 \u0939\u092e\u093e\u0930\u093e '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c AI \u091f\u0947\u0915\u094d\u0938\u094d\u091f' \u092b\u0940\u091a\u0930 \u2013 \u091c\u094b \u091f\u0930\u094d\u0928\u093f\u091f\u093f\u0928 \u0914\u0930 GPTZero \u0915\u094b \u092c\u093e\u092f\u092a\u093e\u0938 \u0915\u0930\u0924\u093e \u0939\u0948 \u2013 \u0906\u092a\u0915\u094b \u0935\u094b \u090f\u091c \u0926\u0947\u0924\u093e \u0939\u0948 \u091c\u094b \u0914\u0930\u094b\u0902 \u0915\u0947 \u092a\u093e\u0938 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0907\u0938\u0915\u0947 \u0938\u093e\u0925, \u0906\u092a \u0905\u092a\u0928\u0947 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b \u0910\u0938\u0947 \u0932\u093f\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u092a\u094d\u0930\u094b\u092b\u0947\u0938\u0930 \u0932\u093f\u0916 \u0930\u0939\u093e \u0939\u094b\u0964 \u0914\u0930 \u0939\u093e\u0901, 50,000+ \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0928\u0947 \u092f\u0947 \u0915\u093f\u092f\u093e \u0939\u0948 \u2013 \u0909\u0928\u0915\u0947 \u0917\u094d\u0930\u0947\u0921 B+ \u0938\u0947 A- \u0924\u0915 \u092c\u0922\u093c\u0947 \u0939\u0948\u0902\u0964",
    "\u0924\u094b \u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c AI \u091f\u0947\u0915\u094d\u0938\u094d\u091f' \u092b\u0940\u091a\u0930 \u0915\u094b \u091f\u094d\u0930\u093e\u092f \u0915\u0930\u0947\u0902\u0964 \u092f\u0947 \u0906\u0916\u093f\u0930\u0940 \u0908\u092e\u0947\u0932 \u0939\u0948 \u0907\u0938 \u0938\u0940\u0930\u0940\u091c\u093c \u0915\u093e \u2013 \u0932\u0947\u0915\u093f\u0928 \u0906\u092a\u0915\u093e \u0938\u092b\u0930 \u0905\u092d\u0940 \u0936\u0941\u0930\u0942 \u0939\u0941\u0906 \u0939\u0948\u0964 P.S. \u2013 \u0905\u0917\u0930 \u0906\u092a\u0915\u094b \u0915\u092d\u0940 \u0915\u093f\u0938\u0940 \u0925\u0940\u0938\u093f\u0938 \u092e\u0947\u0902 \u092e\u0926\u0926 \u091a\u093e\u0939\u093f\u090f, \u0924\u094b \u0939\u092e\u093e\u0930\u0947 '\u090f\u0915\u094d\u0938\u092a\u0930\u094d\u091f \u091f\u093f\u092a\u094d\u0938' \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u091c\u093e\u090f\u0901 \u2013 \u0935\u0939\u093e\u0901 \u0939\u0930 \u0939\u092b\u094d\u0924\u0947 \u0928\u090f \u0939\u0948\u0915\u094d\u0938 \u0906\u0924\u0947 \u0939\u0948\u0902\u0964"
  ],
