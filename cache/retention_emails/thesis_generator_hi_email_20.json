{
  "subject": "\u0935\u094b \u0917\u0932\u0924\u0940 \u091c\u094b 90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902",
  "preview_text": "\u0906\u092a \u0905\u092c \u0928\u090f \u092f\u0942\u091c\u093c\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u091a\u0940\u091c\u093c \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u094b \u092e\u093f\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u092a\u0922\u093c\u093f\u090f \u0914\u0930 \u091c\u093e\u0928\u093f\u090f\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u091c\u092c \u0906\u092a\u0928\u0947 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 Thesis Generator \u0916\u094b\u0932\u093e \u0925\u093e? \u0921\u0930, \u0915\u0902\u092b\u094d\u092f\u0942\u091c\u093c\u0928, \u0914\u0930 \u090f\u0915 \u0916\u093e\u0932\u0940 \u092a\u0947\u091c\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u092c \u0906\u092a \u0935\u0939\u093e\u0901 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964 \u0906\u092a\u0928\u0947 \u090f\u092a \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e, \u0925\u0940\u0938\u093f\u0938 \u092c\u0928\u093e\u0908, \u0914\u0930 \u0936\u093e\u092f\u0926 \u0917\u094d\u0930\u0947\u0921 \u092d\u0940 \u0938\u0941\u0927\u093e\u0930\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u090f\u0915 \u092c\u093e\u0924 \u0939\u0948 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u0940 \u0939\u0948: 90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u0917\u0932\u0924\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u0909\u0928\u094d\u0939\u0947\u0902 \u092a\u093e\u0935\u0930 \u092f\u0942\u091c\u093c\u0930 \u092c\u0928\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u0940 \u0939\u0948\u0964",
    "\u0935\u094b \u0917\u0932\u0924\u0940 \u0939\u0948 \u0915\u093f \u0935\u0947 \u0938\u093f\u0930\u094d\u092b \u092c\u0947\u0938\u093f\u0915 \u092b\u0940\u091a\u0930\u094d\u0938 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c AI \u091f\u0947\u0915\u094d\u0938\u094d\u091f' \u092b\u0940\u091a\u0930 \u0915\u094b \u0907\u0917\u094d\u0928\u094b\u0930 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0935\u0939\u0940 \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b Turnitin \u0914\u0930 GPTZero \u0938\u0947 \u092c\u091a\u093e\u0924\u093e \u0939\u0948, \u0914\u0930 \u0907\u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0906\u092a\u0915\u0940 \u0930\u093e\u0907\u091f\u093f\u0902\u0917 \u0914\u0930 \u092d\u0940 \u0928\u0947\u091a\u0941\u0930\u0932 \u0932\u0917\u0924\u0940 \u0939\u0948\u0964 \u0906\u092a\u0915\u094b \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0928\u0947 \u0938\u092c\u0915\u0941\u091b \u0938\u0940\u0916 \u0932\u093f\u092f\u093e, \u0932\u0947\u0915\u093f\u0928 \u092f\u0939 \u090f\u0915 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u0939\u0925\u093f\u092f\u093e\u0930 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u094b \u090f-\u0917\u094d\u0930\u0947\u0921 \u0938\u0947 \u092c\u0940-\u0917\u094d\u0930\u0947\u0921 \u092e\u0947\u0902 \u092b\u0930\u094d\u0915 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u0915\u093f \u0906\u092a \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e\u090f\u0902\u0964 \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, '\u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c' \u092c\u091f\u0928 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0915\u0948\u0938\u0947 \u0906\u092a\u0915\u093e \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0914\u0930 \u092d\u0940 \u0911\u0925\u0947\u0902\u091f\u093f\u0915 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092b\u0940\u091a\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948, \u092f\u0939 \u0906\u092a\u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u0939\u0948 \u090f\u0915 \u092a\u094d\u0930\u094b\u092b\u0947\u0936\u0928\u0932 \u0930\u093f\u0938\u0930\u094d\u091a\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902\u0964 \u0906\u092a \u0905\u092c \u0928\u090f \u092f\u0942\u091c\u093c\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902, \u0907\u0938\u0932\u093f\u090f \u0907\u0938\u0947 \u0905\u092a\u0928\u0947 \u0906\u0930\u094d\u092e\u0930\u0940 \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u0947\u0902\u0964",
    "\u0906\u091c \u0939\u0940 \u090f\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0940 \u092a\u0941\u0930\u093e\u0928\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b \u0939\u094d\u092f\u0942\u092e\u0928\u093e\u0907\u091c\u093c \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u0947\u0902\u0964 \u0906\u092a\u0915\u094b \u092b\u0930\u094d\u0915 \u0928\u091c\u093c\u0930 \u0906\u090f\u0917\u093e\u0964 \u092a\u0940.\u090f\u0938. - \u0905\u0917\u0930 \u0906\u092a\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 '\u0906\u0909\u091f\u0932\u093e\u0907\u0928 \u091f\u0942 \u092b\u0941\u0932 \u092a\u0947\u092a\u0930' \u092b\u0940\u091a\u0930 \u0928\u0939\u0940\u0902 \u0906\u091c\u093c\u092e\u093e\u092f\u093e, \u0924\u094b \u0935\u0939 \u092d\u0940 \u090f\u0915 \u0917\u0947\u092e-\u091a\u0947\u0902\u091c\u0930 \u0939\u0948\u0964 \u0907\u0938\u0947 \u092e\u093f\u0938 \u092e\u0924 \u0915\u0940\u091c\u093f\u090f\u0964"
  ],
