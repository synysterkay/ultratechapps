  "subject": "\u6211\u5dee\u70b9\u5220\u6389\u8fd9\u4e2a\u5e94\u7528\uff0c\u76f4\u5230\u53d1\u73b0\u8fd9\u4e2a\u9690\u85cf\u529f\u80fd",
  "preview_text": "\u4e00\u4e2a\u88ab90%\u7528\u6237\u5ffd\u7565\u7684\u6309\u94ae\uff0c\u5374\u8ba9\u6211\u7684\u624b\u673a\u97f3\u8d28\u63d0\u5347\u4e86300%\uff0c\u73b0\u5728\u544a\u8bc9\u4f60\u4e3a\u4ec0\u4e48\u3002",
  "body_paragraphs": [
    "\u4e0a\u5468\u5dee\u70b9\u628a\u97f3\u91cf\u653e\u5927\u5668\u5378\u8f7d\u4e86\u3002\u771f\u7684\u3002\u89c9\u5f97\u4e5f\u5c31\u90a3\u6837\uff0c\u8ddf\u5176\u4ed6\u5e94\u7528\u6ca1\u533a\u522b\u3002\u76f4\u5230\u5728Reddit\u4e0a\u770b\u5230\u4e00\u4e2a\u8001\u5916\u7684\u5e16\u5b50\uff0c\u4ed6\u8bf4\u81ea\u5df1\u53d1\u73b0\u4e86\u8fd9\u4e2a\u5e94\u7528\u7684\u2018\u6838\u6b66\u5668\u2019\u3002",
    "\u4ed6\u8bf4\u81ea\u5df1\u4ee5\u524d\u542c\u6b4c\u603b\u89c9\u5f97\u7f3a\u4e86\u70b9\u4ec0\u4e48\uff0c\u58f0\u97f3\u662f\u5927\u4e86\uff0c\u4f46\u5f88\u5355\u8584\u3002\u76f4\u5230\u4ed6\u8bef\u89e6\u4e86\u90a3\u4e2a\u85cf\u5728\u5747\u8861\u5668\u4e0b\u9762\u7684\u2018\u54cd\u5ea6\u589e\u5f3a\u5668\u2019\u3002\u4e0d\u662f\u7b80\u5355\u7684\u97f3\u91cf\u63d0\u5347\uff0c\u800c\u662f\u628a\u6574\u4e2a\u58f0\u573a\u6491\u5f00\u4e86\u3002\u4ed6\u8bf4\u90a3\u4e00\u523b\uff0cAirPods\u91cc\u4f20\u51fa\u7684\u9f13\u70b9\u7b2c\u4e00\u6b21\u6253\u5728\u4e86\u80f8\u53e3\u4e0a\u3002",
    "\u8fd9\u4e2a\u529f\u80fd\u53eb\u2018\u667a\u80fd\u54cd\u5ea6\u589e\u5f3a\u2019\u3002\u5b83\u4e0d\u4f1a\u8ba9\u58f0\u97f3\u5931\u771f\uff0c\u800c\u662f\u52a8\u6001\u8865\u507f\u4e0d\u540c\u9891\u6bb5\u3002\u7b80\u5355\u8bf4\uff1a\u4eba\u58f0\u66f4\u6e05\u6670\uff0c\u80cc\u666f\u4e50\u5668\u4e0d\u4f1a\u7cca\u6210\u4e00\u56e2\uff0c\u4f4e\u97f3\u6709\u5f39\u6027\u800c\u4e0d\u662f\u55e1\u55e1\u54cd\u3002\u5c24\u5176\u662f\u5728\u5608\u6742\u73af\u5883\u91cc\u2014\u2014\u5730\u94c1\u4e0a\u3001\u5496\u5561\u9986\u2014\u2014\u5b83\u80fd\u8ba9\u5bf9\u8bdd\u548c\u6b4c\u8bcd\u4ece\u566a\u97f3\u91cc\u2018\u8df3\u2019\u51fa\u6765\u3002",
