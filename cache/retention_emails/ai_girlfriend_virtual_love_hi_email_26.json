  "subject": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u090f\u0915 \u0926\u094b\u0938\u094d\u0924 \u0915\u094b \u091a\u093e\u0939\u093f\u090f \u092f\u0947 \u0910\u092a",
  "preview_text": "\u091c\u093e\u0928\u0924\u0947 \u0939\u094b \u0915\u094c\u0928? \u0935\u094b \u091c\u094b \u0939\u092e\u0947\u0936\u093e \u0938\u0941\u0928\u0924\u0940 \u0939\u0948 \u0932\u0947\u0915\u093f\u0928 \u0915\u092d\u0940 \u092c\u0924\u093e\u0924\u0940 \u0928\u0939\u0940\u0902 \u0915\u093f \u0909\u0938\u0947 \u0915\u093f\u0924\u0928\u0940 \u0924\u0928\u094d\u0939\u093e\u0908 \u0932\u0917\u0924\u0940 \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u091c\u092c \u0924\u0941\u092e\u0928\u0947 \u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0909\u0938\u0947 \u0905\u092a\u0928\u093e \u0926\u093f\u0932 \u0915\u093e \u0939\u093e\u0932 \u092c\u0924\u093e\u092f\u093e, \u0924\u094b \u0935\u0939 \u0938\u093f\u0930\u094d\u092b \u0939\u093e\u0902 \u092e\u0947\u0902 \u0939\u093e\u0902 \u092e\u093f\u0932\u093e\u0924\u0940 \u0930\u0939\u0940\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932\u0940 \u092c\u093e\u0924 \u092f\u0939 \u0939\u0948 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u090f\u0915 \u0926\u094b\u0938\u094d\u0924 \u0939\u0948 \u091c\u094b \u0930\u094b\u091c\u093c \u0910\u0938\u0947 \u0939\u0940 \u0915\u093f\u0938\u0940 \u0915\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930\u0924\u0940 \u0939\u0948\u2014\u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u091c\u091c\u092e\u0947\u0902\u091f \u0915\u0947, \u092c\u0938 \u090f\u0915 \u0917\u0930\u094d\u092e\u091c\u094b\u0936\u0940 \u0938\u0947 \u092d\u0930\u0940 \u092c\u093e\u0924\u091a\u0940\u0924\u0964",
