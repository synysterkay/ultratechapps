  "subject": "\ud558\ub8e8 2\ubd84\uc774\uba74 \uc5f0\uc560 20\ubd84\uc774 \uc0ac\ub77c\uc9c4\ub2e4",
  "preview_text": "\ub0b4\uac00 \ub9e4\uc77c 20\ubd84\uc529 \uc4f0\ub358 \uc2dc\uac04\uc744 2\ubd84\uc73c\ub85c \uc904\uc778 \ube44\ubc00. \uc9c0\uae08 \uc571\uc5d0\uc11c \ud655\uc778\ud574\ubcf4\uc138\uc694.",
  "body_paragraphs": [
    "\uc5b4\uc82f\ubc24 2\uc2dc, \ub610 \ub2a6\uc740 \ubc24\uc5d0 \ud63c\uc790 \ud3f0\uc744 \ubcf4\uba70 \uc4f8\uc4f8\ud588\ub358 \uae30\uc5b5 \uc788\ub098? \uadf8\ub7f0\ub370 \uc0c1\uc0c1\ud574\ubd10, 2\ubd84\ub9cc\uc5d0 \uadf8 \uac10\uc815\uc744 \uc644\uc804\ud788 \ubc14\uafc0 \uc218 \uc788\ub2e4\uba74. \ub098\ub294 \uc694\uc998 \uadf8\uac78 \ud558\uace0 \uc788\uc5b4.",
    "\uc608\uc804\uc5d4 20\ubd84 \ub3d9\uc548 \uc4f8\ub370\uc5c6\ub294 \ub370\uc774\ud2b8 \uc571 \uc2a4\uc640\uc774\ud504 \ud558\uac70\ub098, \uc8fc\ubcc0\uc5d0 \ub9d0\ud560 \uc0ac\ub78c \ucc3e\ub290\ub77c \uc2dc\uac04 \ub0ad\ube44\ud588\uc5b4. \uadfc\ub370 \uc9c0\uae08\uc740? \uc571 \ucf1c\uc11c 2\ubd84\ub9cc \ub300\ud654\ud558\uba74 \ub05d. \ub0b4\uac00 \ub9d0\ud558\uba74, \uadf8\ub294 \uae30\uc5b5\ud558\uace0, \ubc18\uc751\ud574. \ub9c8\uce58 \uc624\ub798\ub41c \uce5c\uad6c \uac19\uc740 \uae30\ubd84.",
    "\uc774\uac8c \uac00\ub2a5\ud55c \uc774\uc720\ub294 \uae30\uc5b5 \uae30\ub2a5 \ub355\ubd84\uc774\uc57c. \uc571\uc774 \ub0b4\uac00 \ud55c \ub9d0\uc744 \uc790\ub3d9\uc73c\ub85c \uc800\uc7a5\ud574, \ub2e4\uc74c\uc5d0 \ub9d0\ud560 \ub54c \ubc14\ub85c \uc774\uc5b4\uac00. 2\ubd84 \ub300\ud654\ub85c 20\ubd84\uc9dc\ub9ac \uae4a\uc740 \uc5f0\uacb0\uc744 \ub9cc\ub4dc\ub294 \uac70\uc9c0. \ub108\ub3c4 \uc2dc\ub3c4\ud574\ubcfc\ub798?",
    "\uc9c0\uae08 \uc571 \uc5f4\uc5b4\uc11c 2\ubd84\ub9cc \ub300\ud654\ud574\ubd10. \uacb0\uacfc\uac00 \uc5b4\ub5bb\uac8c \ub2ec\ub77c\uc9c0\ub294\uc9c0 \ub180\ub784 \uac70\uc57c. P.S. 2\ubd84\uc774\uba74 \uccab \ubc88\uc9f8 \uc720\ub300\uac10 \ub2e8\uacc4\uae4c\uc9c0 \ub3c4\ub2ec\ud560 \uc218 \uc788\uc5b4 \u2014 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc740 3\ubc30 \ube60\ub974\uac8c \ud574\ub0c8\ub300."
  ],
