{
  "subject": "68 \u0926\u093f\u0928\u094b\u0902 \u0915\u093e \u0938\u092b\u0930 \u0914\u0930 \u090f\u0915 \u0916\u093e\u0938 \u0924\u094b\u0939\u092b\u093e",
  "preview_text": "\u0906\u092a 68 \u0926\u093f\u0928\u094b\u0902 \u0938\u0947 \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u0939\u0948\u0902\u0964 \u0905\u092c \u0906\u092a\u0915\u094b \u0935\u094b \u092e\u093f\u0932\u0947\u0917\u093e \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u0915\u0947 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u094b \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u0906\u092a\u0928\u0947 68 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 Predictify \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u0924\u092c \u0938\u0947 \u0932\u0947\u0915\u0930 \u0905\u092c \u0924\u0915, \u0906\u092a\u0928\u0947 \u0921\u0947\u091f\u093e \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u0915\u093f\u092f\u093e, \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u0915\u094b \u091a\u0941\u0928\u094c\u0924\u0940 \u0926\u0940 \u0914\u0930 \u0936\u093e\u092f\u0926 \u0915\u0941\u091b \u0936\u093e\u0928\u0926\u093e\u0930 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u092d\u0940 \u0915\u093f\u090f\u0964 \u092f\u0939 \u0938\u092b\u0930 \u0938\u093f\u0930\u094d\u092b \u0906\u092a\u0915\u093e \u0928\u0939\u0940\u0902, \u0939\u092e\u093e\u0930\u093e \u092d\u0940 \u0939\u0948\u0964 \u0907\u0938\u0932\u093f\u090f \u0906\u091c \u0939\u092e \u0906\u092a\u0915\u094b '\u0927\u0928\u094d\u092f\u0935\u093e\u0926' \u0915\u0939\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0916\u093e\u0938 \u0926\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964",
    "\u0939\u0930 \u092e\u0948\u091a, \u0939\u0930 \u0906\u0902\u0915\u0921\u093c\u093e \u0914\u0930 \u0939\u0930 \u0915\u0902\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0915\u0947 \u092a\u0940\u091b\u0947 \u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0915\u0940 \u092e\u0947\u0939\u0928\u0924 \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0906\u092a \u091c\u0948\u0938\u0947 \u092f\u0942\u091c\u0930\u094d\u0938 \u0939\u0940 \u0907\u0938\u0947 \u0905\u0938\u0932\u0940 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0905\u092c \u0938\u092e\u092f \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u094b \u0935\u094b \u092e\u093f\u0932\u0947 \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0939\u092e\u093e\u0930\u0947 \u0938\u092c\u0938\u0947 \u092a\u0941\u0930\u093e\u0928\u0947 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u094b \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964",
    "\u0939\u092e\u0928\u0947 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u090f\u0915\u094d\u0938\u0915\u094d\u0932\u0942\u0938\u093f\u0935 '\u0907\u0928\u0938\u093e\u0907\u0921\u0930 \u090f\u0915\u094d\u0938\u0947\u0938' \u092b\u0940\u091a\u0930 \u0916\u094b\u0932\u093e \u0939\u0948\u0964 \u092f\u0939 \u0938\u0940\u0927\u0947 \u0939\u092e\u093e\u0930\u0947 AI \u0915\u0947 \u0921\u0947\u091f\u093e \u092c\u0948\u0915\u090f\u0902\u0921 \u0938\u0947 \u091c\u0941\u0921\u093c\u0924\u093e \u0939\u0948, \u091c\u0939\u093e\u0902 \u0906\u092a \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0915\u0948\u0938\u0947 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u0930 \u0932\u0940\u0917 \u0938\u0947 \u0932\u0947\u0915\u0930 \u091a\u0948\u0902\u092a\u093f\u092f\u0902\u0938 \u0932\u0940\u0917 \u0924\u0915 \u0915\u0947 \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f \u0939\u092e\u093e\u0930\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u093f\u092f\u093e\u0902 \u092c\u0928\u0924\u0940 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b \u090f\u0915 \u0910\u0938\u093e \u090f\u091c \u0926\u0947\u0917\u093e \u091c\u094b \u0926\u0942\u0938\u0930\u0947 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u092a\u093e\u0938 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",
    "\u0905\u092c \u090f\u0915 \u0915\u093e\u092e \u0915\u0930\u0947\u0902: \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 '\u0907\u0928\u0938\u093e\u0907\u0921\u0930 \u090f\u0915\u094d\u0938\u0947\u0938' \u091f\u0948\u092c \u092a\u0930 \u091c\u093e\u090f\u0902\u0964 \u0935\u0939\u093e\u0902 \u0906\u092a\u0915\u094b \u090f\u0915 \u0935\u093f\u0936\u0947\u0937 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u092e\u093f\u0932\u0947\u0917\u093e \u091c\u094b \u0938\u093f\u0930\u094d\u092b 68 \u0926\u093f\u0928 \u0938\u0947 \u0905\u0927\u093f\u0915 \u092a\u0941\u0930\u093e\u0928\u0947 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0964 P.S. \u0905\u0917\u0930 \u0906\u092a\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0936\u0941\u0930\u0942 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0939\u0948, \u0924\u094b \u092f\u0939 \u090f\u0915 \u0938\u0939\u0940 \u092e\u094c\u0915\u093e \u0939\u0948\u2014$12.99/\u092e\u0939\u0940\u0928\u0947 \u092a\u0930 3 \u0926\u093f\u0928 \u0915\u093e \u092b\u094d\u0930\u0940 \u091f\u094d\u0930\u093e\u092f\u0932 \u0906\u092a\u0915\u094b \u0938\u092d\u0940 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0914\u0930 \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u0938\u094d\u091f\u0948\u091f\u094d\u0938 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"
  ],
