{
  "subject": "\u0906\u091c 2000 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u092f\u0947 \u0915\u093f\u092f\u093e, \u0906\u092a\u0915\u094b \u092a\u0924\u093e \u0939\u0948?",
  "preview_text": "\u0926\u0947\u0916\u093f\u090f \u0915\u0948\u0938\u0947 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0905\u092a\u0928\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924 \u092c\u0926\u0932 \u0926\u0940 - \u0906\u092a \u092d\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",
  "body_paragraphs": [
    "\u0906\u091c \u0938\u0941\u092c\u0939 8 \u092c\u091c\u0947, 2000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0905\u092a\u0928\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u094b \u090f\u0915 \u0924\u094b\u0939\u092b\u093c\u093e \u0926\u093f\u092f\u093e\u0964 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 Loud EQ \u0916\u094b\u0932\u093e \u0914\u0930 \u090f\u0915 \u092c\u091f\u0928 \u0926\u092c\u093e\u092f\u093e\u0964 \u092c\u0938 \u0907\u0924\u0928\u093e \u0939\u0940\u0964 \u0905\u092c \u0935\u0947 \u092e\u0947\u091f\u094d\u0930\u094b \u092e\u0947\u0902, \u0917\u093e\u0921\u093c\u0940 \u092e\u0947\u0902, \u092f\u093e \u0935\u0949\u0915 \u092a\u0930 \u0939\u0930 \u0936\u092c\u094d\u0926 \u0938\u093e\u092b\u093c \u0938\u0941\u0928 \u0930\u0939\u0947 \u0939\u0948\u0902 - \u092c\u093f\u0928\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e 100% \u092a\u0930 \u0932\u0947 \u091c\u093e\u090f\u0964",
    "\u0939\u093e\u0901, \u092f\u0939 \u0938\u091a \u0939\u0948\u0964 \u0935\u0947 \u0932\u094b\u0917 \u0906\u092a\u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0924\u0947\u091c\u093c \u0928\u0939\u0940\u0902 \u0939\u0948\u0902, \u092c\u0932\u094d\u0915\u093f \u0938\u092e\u091d\u0926\u093e\u0930 \u0939\u0948\u0902\u0964 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u092a\u093e\u092f\u093e \u0915\u093f Loud EQ \u0915\u093e One-tap Optimize \u0909\u0928\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u094b \u092c\u091a\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0907\u0924\u0928\u093e \u0938\u093e\u092b\u093c \u0915\u0930\u0924\u093e \u0939\u0948 \u0915\u093f \u0936\u094b\u0930 \u092e\u0947\u0902 \u092d\u0940 \u0939\u0930 \u0936\u092c\u094d\u0926 \u0915\u094d\u0930\u093f\u0938\u094d\u091f\u0932 \u091c\u0948\u0938\u093e \u0932\u0917\u0947\u0964 \u0914\u0930 \u0906\u092a? \u0915\u094d\u092f\u093e \u0906\u092a \u0905\u092c \u092d\u0940 \u0935\u0939\u0940 \u092a\u0941\u0930\u093e\u0928\u093e \u0924\u0930\u0940\u0915\u093e \u0905\u092a\u0928\u093e \u0930\u0939\u0947 \u0939\u0948\u0902 - \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u093e \u0914\u0930 \u0938\u0941\u0928\u0928\u0947 \u092e\u0947\u0902 \u092e\u0947\u0939\u0928\u0924 \u0915\u0930\u0928\u093e?",
    "\u092f\u0939 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902 \u0939\u0948, \u092f\u0939 \u0938\u093e\u0909\u0902\u0921 \u0921\u0940\u090f\u0928\u090f \u0939\u0948\u0964 Premium \u0915\u0947 \u0938\u093e\u0925, \u0906\u092a \u0905\u092a\u0928\u0947 \u0939\u0930 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915\u0926\u092e \u0938\u0939\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u092a\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u091a\u093e\u0939\u0947 AirPods \u0939\u094b\u0902 \u092f\u093e \u0935\u093e\u092f\u0930\u094d\u0921 \u0939\u0947\u0921\u092b\u093c\u094b\u0928, \u092f\u0939 \u0905\u092a\u0928\u0947 \u0906\u092a \u091f\u094d\u092f\u0942\u0928 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u0939\u093e\u0901, \u092f\u0939 \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u093e \u0916\u094d\u092f\u093e\u0932 \u0930\u0916\u0924\u093e \u0939\u0948 - \u0939\u093f\u092f\u0930\u093f\u0902\u0917-\u0938\u0947\u092b \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u0915\u0947 \u0938\u093e\u0925\u0964 \u0915\u094b\u0908 \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u200c\u0936\u0928 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0939\u093e\u0930\u094d\u0936\u0928\u0947\u0938 \u0928\u0939\u0940\u0902, \u0938\u093f\u0930\u094d\u092b\u093c \u0938\u093e\u092b\u093c \u0906\u0935\u093e\u091c\u093c\u0964",
    "\u0905\u092c \u0926\u0947\u0930 \u0915\u094d\u092f\u094b\u0902? Loud EQ \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0909\u0928 2000 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0915\u094d\u092f\u093e \u092a\u093e\u092f\u093e\u0964 \u092c\u0938 \u090f\u0915 \u091f\u0948\u092a, \u0914\u0930 \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u092c\u0926\u0932 \u091c\u093e\u090f\u0917\u0940\u0964 \u092a\u0940.\u090f\u0938. - Premium \u091f\u094d\u0930\u093e\u092f\u0932 \u0905\u092d\u0940 \u092d\u0940 \u091a\u0932 \u0930\u0939\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0926\u093f\u0928 \u0928\u0939\u0940\u0902\u0964 \u0906\u091c \u0939\u0940 \u0905\u092a\u0928\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0911\u092a\u094d\u091f\u093f\u092e\u093e\u0907\u091c\u093c \u0915\u0930\u0947\u0902\u0964"
  ],
