{
  "subject": "\u0906\u092a\u0915\u0940 28 \u0926\u093f\u0928 \u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e: 4 \u0917\u0941\u0928\u093e \u0905\u0927\u093f\u0915 \u0924\u093e\u0930\u0940\u0916\u0947\u0902",
  "preview_text": "\u0906\u092a\u0928\u0947 \u090f\u0915 \u092e\u0939\u0940\u0928\u0947 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u0939\u093e\u0938\u093f\u0932 \u0915\u093f\u092f\u093e \u0939\u0948? \u091a\u094c\u0902\u0915\u093f\u090f \u092e\u0924, \u0939\u092e\u0928\u0947 \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0917\u0924\u093f \u0915\u094b \u091f\u094d\u0930\u0948\u0915 \u0915\u093f\u092f\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u090f\u0915 \u092e\u0939\u0940\u0928\u093e \u092a\u0939\u0932\u0947 \u0906\u092a\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e, '\u0915\u0932 \u0924\u093e\u0930\u0940\u0916 \u092a\u094d\u0932\u093e\u0928 \u0915\u0930\u0942\u0902\u0917\u093e\u0964' \u0935\u0939 '\u0915\u0932' \u0906\u091c 28 \u0926\u093f\u0928 \u092c\u093e\u0926 \u0939\u0948\u0964 \u0914\u0930 \u0939\u092e\u0928\u0947 \u0915\u0941\u091b \u0926\u0947\u0916\u093e \u0939\u0948\u0964",
    "\u091c\u093f\u0928 \u091c\u094b\u0921\u093c\u094b\u0902 \u0928\u0947 \u092a\u0939\u0932\u0947 24 \u0918\u0902\u091f\u0947 \u092e\u0947\u0902 Tonight's Date \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e, \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0905\u0917\u0932\u0947 \u092e\u0939\u0940\u0928\u0947 4 \u0917\u0941\u0928\u093e \u0905\u0927\u093f\u0915 \u0924\u093e\u0930\u0940\u0916\u0947\u0902 \u092a\u094d\u0932\u093e\u0928 \u0915\u0940\u0902\u0964 \u0906\u092a \u092d\u0940 \u0909\u0938\u0940 \u0930\u093e\u0938\u094d\u0924\u0947 \u092a\u0930 \u0939\u0948\u0902\u0964 \u0906\u092a\u0928\u0947 \u0936\u093e\u092f\u0926 \u0915\u0941\u091b \u0936\u093e\u092e\u0947\u0902 \u0938\u0939\u0947\u091c\u0940 \u0939\u094b\u0902, \u0915\u0941\u091b \u092f\u093e\u0926\u0947\u0902 \u091f\u093e\u0907\u092e\u0932\u093e\u0907\u0928 \u092a\u0930 \u091c\u094b\u0921\u093c\u0940 \u0939\u094b\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932\u0940 \u092e\u091c\u093e \u0905\u092d\u0940 \u092c\u093e\u0915\u0940 \u0939\u0948\u0964",
    "\u0906\u092a\u0915\u0940 Memory Timeline \u092a\u0930 \u0915\u093f\u0924\u0928\u0940 \u0924\u0938\u094d\u0935\u0940\u0930\u0947\u0902 \u0939\u0948\u0902? \u0935\u0939\u093e\u0902 \u090f\u0915 \u0928\u0908 \u0924\u093e\u0930\u0940\u0916 \u0915\u093e \u092b\u094b\u091f\u094b \u091c\u094b\u0921\u093c\u0928\u0947 \u0938\u0947 \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0917\u0924\u093f \u0914\u0930 \u0917\u0939\u0930\u0940 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0914\u0930 Partner Proposal Celebration \u2014 \u091c\u092c \u0906\u092a \u0915\u093f\u0938\u0940 \u0924\u093e\u0930\u0940\u0916 \u0915\u094b \u092d\u0947\u091c\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0906\u092a\u0915\u093e \u0938\u093e\u0925\u0940 \u090f\u0915 \u092a\u0942\u0930\u094d\u0923-\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0932 \u0926\u0947\u0916\u0924\u093e \u0939\u0948, \u091c\u094b \u0915\u0939\u0924\u093e \u0939\u0948 '\u0906\u091c \u0930\u093e\u0924 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f\u0964' \u092f\u0939\u0940 \u091b\u094b\u091f\u0947 \u092a\u0932 \u092c\u0921\u093c\u0947 \u092c\u0926\u0932\u093e\u0935 \u0932\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",
    "\u0905\u092c \u0905\u0917\u0932\u093e \u0915\u0926\u092e: \u0906\u091c \u0930\u093e\u0924, \u0915\u094b\u0908 \u092d\u0940 \u092e\u0942\u0921 \u091a\u0941\u0928\u0947\u0902 \u2014 \u0915\u094b\u091c\u0940, \u090f\u0921\u0935\u0947\u0902\u091a\u0930\u0938, \u092a\u094d\u0932\u0947\u092b\u0941\u0932, \u092f\u093e \u0939\u0940\u0932\u093f\u0902\u0917 \u2014 \u0914\u0930 30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u0905\u0917\u0932\u0940 \u092f\u093e\u0926 \u092c\u0928\u093e\u090f\u0902\u0964 \u0916\u094b\u0932\u0947\u0902 SoulPlan \u0914\u0930 \u0905\u092a\u0928\u0940 \u092a\u0939\u0932\u0940 \u0924\u093e\u0930\u0940\u0916 \u0915\u094b \u091f\u093e\u0907\u092e\u0932\u093e\u0907\u0928 \u092a\u0930 \u091c\u094b\u0921\u093c\u0947\u0902\u0964 P.S. \u2014 \u0915\u094d\u092f\u093e \u0906\u092a\u0928\u0947 \u0926\u0947\u0916\u093e? \u0906\u092a\u0915\u0940 Streak \u092b\u094d\u0930\u0940\u091c \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948 \u092c\u093f\u0928\u093e \u0936\u0930\u094d\u092e \u0915\u0947\u0964 \u0915\u094b\u0908 \u0926\u092c\u093e\u0935 \u0928\u0939\u0940\u0902, \u092c\u0938 \u0905\u092a\u0928\u0940 \u0930\u092b\u094d\u0924\u093e\u0930\u0964"
  ],
