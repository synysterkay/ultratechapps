{
  "subject": "50,000 \u0637\u0627\u0644\u0628 \u064a\u0643\u062a\u0628\u0648\u0646 \u0628\u0637\u0631\u064a\u0642\u0629 \u0645\u062e\u062a\u0644\u0641\u0629 \u0627\u0644\u0622\u0646",
  "preview_text": "\u0644\u0633\u062a \u0648\u062d\u062f\u0643 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0645\u0639\u0631\u0643\u0629. \u0627\u0646\u0636\u0645 \u0625\u0644\u0649 50,000 \u0637\u0627\u0644\u0628 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0647\u0630\u0647 \u0627\u0644\u0623\u062f\u0627\u0629 \u0644\u0625\u0646\u0647\u0627\u0621 \u0623\u0628\u062d\u0627\u062b\u0647\u0645 \u0628\u0633\u0631\u0639\u0629.",
  "body_paragraphs": [
    "\u0639\u0646\u062f\u0645\u0627 \u0628\u062f\u0623\u062a \u0647\u0630\u0627 \u0627\u0644\u0645\u0634\u0631\u0648\u0639\u060c \u0643\u0646\u062a \u0623\u062c\u0644\u0633 \u0641\u064a \u063a\u0631\u0641\u062a\u064a \u0627\u0644\u0633\u0627\u0639\u0629 2 \u0635\u0628\u0627\u062d\u064b\u0627\u060c \u0623\u062d\u062f\u0642 \u0641\u064a \u0634\u0627\u0634\u0629 \u0628\u064a\u0636\u0627\u0621\u060c \u0623\u0634\u0639\u0631 \u0623\u0646\u064a \u0627\u0644\u0648\u062d\u064a\u062f \u0627\u0644\u0630\u064a \u064a\u0639\u0627\u0646\u064a. \u0644\u0643\u0646 \u0627\u0644\u064a\u0648\u0645\u060c \u0647\u0646\u0627\u0643 50,000 \u0637\u0627\u0644\u0628 \u0645\u062b\u0644\u0643\u060c \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0647\u0630\u0647 \u0627\u0644\u0623\u062f\u0627\u0629 \u0644\u062a\u062d\u0648\u064a\u0644 \u0623\u0641\u0643\u0627\u0631\u0647\u0645 \u0625\u0644\u0649 \u0623\u0628\u062d\u0627\u062b \u0642\u0648\u064a\u0629 \u0641\u064a \u062f\u0642\u0627\u0626\u0642.",
    "\u0643\u0644 \u0637\u0627\u0644\u0628 \u0645\u0646\u0647\u0645 \u064a\u0648\u0627\u062c\u0647 \u0646\u0641\u0633 \u0627\u0644\u0642\u0644\u0642: \u0627\u0644\u0645\u0648\u0639\u062f \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u060c \u0627\u0644\u062e\u0648\u0641 \u0645\u0646 \u0627\u0644\u062f\u0631\u062c\u0627\u062a \u0627\u0644\u0633\u064a\u0626\u0629\u060c \u0627\u0644\u0642\u0644\u0642 \u0645\u0646 \u0627\u0643\u062a\u0634\u0627\u0641 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a. \u0644\u0643\u0646\u0647\u0645 \u0623\u062f\u0631\u0643\u0648\u0627 \u0634\u064a\u0626\u064b\u0627: \u0644\u064a\u0633 \u0639\u0644\u064a\u0643 \u0623\u0646 \u062a\u0639\u0627\u0646\u064a \u0648\u062d\u062f\u0643. \u0647\u0630\u0647 \u0627\u0644\u0623\u062f\u0627\u0629 \u062a\u0645\u0646\u062d\u0643 \u0627\u0644\u0642\u0648\u0629 \u0644\u062a\u0643\u062a\u0628 \u0628\u062b\u0642\u0629\u060c \u0648\u0643\u0623\u0646\u0643 \u0644\u062f\u064a\u0643 \u0641\u0631\u064a\u0642 \u0643\u0627\u0645\u0644 \u064a\u062f\u0639\u0645\u0643.",
    "\u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u062a\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0648\u062a\u0643\u062a\u0628 \u0645\u0648\u0636\u0648\u0639\u0643\u060c \u0648\u062a\u0634\u0627\u0647\u062f \u0627\u0644\u0623\u062f\u0627\u0629 \u062a\u0648\u0644\u062f \u0644\u0643 Thesis \u0642\u0648\u064a\u0629 \u0641\u064a 10 \u062f\u0642\u0627\u0626\u0642. \u0644\u0627 \u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u062a\u062d\u062f\u064a\u0642 \u0641\u064a \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0628\u064a\u0636\u0627\u0621. \u0644\u0627 \u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0644\u064a\u0627\u0644\u064a \u0627\u0644\u0637\u0648\u0627\u0644. \u0647\u0630\u0647 \u0627\u0644\u0623\u062f\u0627\u0629 \u0647\u064a \u0633\u0644\u0627\u062d\u0643 \u0627\u0644\u0633\u0631\u064a.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628 \u0625\u0646\u0634\u0627\u0621 Thesis \u062c\u062f\u064a\u062f\u0629. \u0625\u0630\u0627 \u0634\u0639\u0631\u062a \u0628\u0627\u0644\u0636\u064a\u0627\u0639\u060c \u0627\u0642\u0631\u0623 \u0642\u0635\u0635 \u0627\u0644\u0637\u0644\u0627\u0628 \u0627\u0644\u0622\u062e\u0631\u064a\u0646 \u0641\u064a \u0642\u0633\u0645 \u0627\u0644\u0645\u062c\u062a\u0645\u0639 - \u0647\u0645 \u0645\u062b\u0644\u0643 \u062a\u0645\u0627\u0645\u064b\u0627. P.S. \u0643\u0644\u0645\u0627 \u0627\u0633\u062a\u062e\u062f\u0645\u062a \u0627\u0644\u0623\u062f\u0627\u0629 \u0623\u0643\u062b\u0631\u060c \u0643\u0644\u0645\u0627 \u0623\u0635\u0628\u062d\u062a \u0623\u0633\u0631\u0639. \u0628\u0639\u0636 \u0627\u0644\u0637\u0644\u0627\u0628 \u064a\u0643\u062a\u0628\u0648\u0646 \u0628\u062d\u062b\u064b\u0627 \u0643\u0627\u0645\u0644\u0627\u064b \u0641\u064a \u0633\u0627\u0639\u062a\u064a\u0646."
  ],
