{
  "subject": "\u0412\u0438\u043f\u0440\u043e\u0431\u0443\u0439 3-\u0434\u0435\u043d\u043d\u0438\u0439 \u0432\u0438\u043a\u043b\u0438\u043a \u0432\u0456\u0434 Predictify",
  "preview_text": "\u0417\u0440\u043e\u0431\u0438 \u0441\u0432\u043e\u0457 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438 \u0442\u043e\u0447\u043d\u0456\u0448\u0438\u043c\u0438 \u0432\u0441\u044c\u043e\u0433\u043e \u0437\u0430 3 \u0434\u043d\u0456. \u041f\u043e\u0431\u0430\u0447 \u0440\u0456\u0437\u043d\u0438\u0446\u044e \u0441\u0430\u043c.",
  "body_paragraphs": [
    "\u0421\u043b\u0443\u0445\u0430\u0439, \u044f \u0437\u043d\u0430\u044e \u0446\u0435 \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044f: \u0442\u0438 \u0434\u0438\u0432\u0438\u0448\u0441\u044f \u043c\u0430\u0442\u0447, \u0434\u0443\u043c\u0430\u0454\u0448, \u0449\u043e \u0432\u0441\u0435 \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0438\u0432, \u0430 \u043f\u043e\u0442\u0456\u043c \u2014 \u0431\u0430\u0446 \u2014 \u0456 \u043f\u0440\u043e\u0433\u0440\u0430\u0448. \u0406 \u0442\u0438 \u0437\u0430\u043b\u0438\u0448\u0430\u0454\u0448\u0441\u044f \u0437 \u0442\u0438\u043c \u0441\u0430\u043c\u0438\u043c \u043f\u0438\u0442\u0430\u043d\u043d\u044f\u043c: \u0447\u043e\u043c\u0443 \u044f \u043d\u0435 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0432 \u043d\u0430 \u0456\u043d\u0448\u0435? \u0426\u0435 \u0434\u0440\u0430\u0442\u0443\u0454, \u043f\u0440\u0430\u0432\u0434\u0430? \u0410\u043b\u0435 \u0449\u043e, \u044f\u043a\u0431\u0438 \u044f \u0441\u043a\u0430\u0437\u0430\u0432 \u0442\u043e\u0431\u0456, \u0449\u043e \u0432\u0441\u044c\u043e\u0433\u043e \u0437\u0430 3 \u0434\u043d\u0456 \u0442\u0438 \u043c\u043e\u0436\u0435\u0448 \u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u0446\u0435 \u043d\u0430\u0437\u0430\u0432\u0436\u0434\u0438?",
    "\u041e\u0441\u044c \u0432 \u0447\u043e\u043c\u0443 \u0441\u043f\u0440\u0430\u0432\u0430: \u0431\u0456\u043b\u044c\u0448\u0456\u0441\u0442\u044c \u0444\u0430\u043d\u0430\u0442\u0456\u0432 \u043f\u043e\u043a\u043b\u0430\u0434\u0430\u044e\u0442\u044c\u0441\u044f \u043d\u0430 \u0456\u043d\u0442\u0443\u0457\u0446\u0456\u044e, \u0430\u043b\u0435 \u0434\u0430\u043d\u0456 \u0437\u0430\u0432\u0436\u0434\u0438 \u043f\u0435\u0440\u0435\u043c\u0430\u0433\u0430\u044e\u0442\u044c. \u041d\u0430\u0448 AI \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0454 \u0442\u0438\u0441\u044f\u0447\u0456 \u0437\u043c\u0456\u043d\u043d\u0438\u0445 \u0437\u0430 \u043c\u0430\u0442\u0447 \u2014 \u0432\u0456\u0434 xG \u0434\u043e \u0442\u0430\u043a\u0442\u0438\u0447\u043d\u0438\u0445 \u0441\u0445\u0435\u043c \u2014 \u0456 \u0434\u0430\u0454 \u0442\u043e\u0431\u0456 \u0442\u043e\u0447\u043d\u0456 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438 \u0437 \u0440\u0456\u0432\u043d\u0435\u043c \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u043e\u0441\u0442\u0456. \u0422\u0438 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0433\u0430\u0434\u0443\u0454\u0448, \u0442\u0438 \u0437\u043d\u0430\u0454\u0448. \u0406 \u044f \u043a\u0438\u0434\u0430\u044e \u0442\u043e\u0431\u0456 \u0432\u0438\u043a\u043b\u0438\u043a: \u0441\u043f\u0440\u043e\u0431\u0443\u0439 \u0446\u0435 3 \u0434\u043d\u0456 \u043f\u043e\u0441\u043f\u0456\u043b\u044c. \u041a\u043e\u0436\u043d\u043e\u0433\u043e \u0434\u043d\u044f \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a, \u0434\u0438\u0432\u0438\u0441\u044c \u043d\u0430 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438 \u0437 \u0432\u0438\u0441\u043e\u043a\u043e\u044e \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456\u0441\u0442\u044e \u0456 \u043f\u043e\u0440\u0456\u0432\u043d\u044e\u0439 \u0437 \u0440\u0435\u0430\u043b\u044c\u043d\u0456\u0441\u0442\u044e. \u041f\u043e\u0431\u0430\u0447\u0438\u0448, \u044f\u043a \u0442\u0432\u043e\u0457 \u0440\u0456\u0448\u0435\u043d\u043d\u044f \u0441\u0442\u0430\u043d\u0443\u0442\u044c \u0440\u043e\u0437\u0443\u043c\u043d\u0456\u0448\u0438\u043c\u0438.",
    "\u0424\u0443\u043d\u043a\u0446\u0456\u044f, \u044f\u043a\u0430 \u0442\u043e\u0431\u0456 \u0434\u043e\u043f\u043e\u043c\u043e\u0436\u0435 \u2014 \u0446\u0435 '\u041f\u0440\u043e\u0433\u043d\u043e\u0437 \u0434\u043d\u044f' \u0437 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u043e\u043c \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u043e\u0441\u0442\u0456. \u041f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u0439\u0434\u0438 \u0432 \u0440\u043e\u0437\u0434\u0456\u043b '\u0413\u043e\u043b\u043e\u0432\u043d\u0430' \u0456 \u043f\u043e\u0434\u0438\u0432\u0438\u0441\u044c \u043d\u0430 \u043c\u0430\u0442\u0447\u0456 \u0437 \u043f\u043e\u0437\u043d\u0430\u0447\u043a\u043e\u044e 80%+. \u0410 \u0449\u0435 \u0442\u0438 \u043c\u043e\u0436\u0435\u0448 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0441\u0435\u0431\u0435 \u0432 IQ-\u0432\u0456\u043a\u0442\u043e\u0440\u0438\u043d\u0456 \u2014 \u0437\u043c\u0430\u0433\u0430\u0439\u0441\u044f \u0437 AI \u0456 \u0437\u0430\u0440\u043e\u0431\u043b\u044f\u0439 \u0431\u0430\u043b\u0438. \u0426\u0435 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0433\u0440\u0430, \u0446\u0435 \u0441\u043f\u043e\u0441\u0456\u0431 \u043d\u0430\u0432\u0447\u0438\u0442\u0438\u0441\u044f \u0447\u0438\u0442\u0430\u0442\u0438 \u0433\u0440\u0443 \u044f\u043a \u043f\u0440\u043e\u0444\u0435\u0441\u0456\u043e\u043d\u0430\u043b.",
    "\u0422\u043e\u0436 \u043e\u0441\u044c \u0442\u0432\u0456\u0439 \u043f\u043b\u0430\u043d: \u0432\u0456\u0434\u043a\u0440\u0438\u0439 Predictify \u0437\u0430\u0440\u0430\u0437, \u0437\u043d\u0430\u0439\u0434\u0438 \u043e\u0434\u0438\u043d \u043c\u0430\u0442\u0447 \u0437 \u0432\u0438\u0441\u043e\u043a\u043e\u044e \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456\u0441\u0442\u044e \u0456 \u0437\u0440\u043e\u0431\u0438 \u043f\u0440\u043e\u0433\u043d\u043e\u0437. \u0417\u0440\u043e\u0431\u0438 \u0446\u0435 3 \u0434\u043d\u0456 \u043f\u043e\u0441\u043f\u0456\u043b\u044c. \u0406 \u043f\u0456\u0441\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u043d\u0430\u043f\u0438\u0448\u0438 \u043c\u0435\u043d\u0456 \u2014 \u044f \u0437\u043d\u0430\u044e, \u0449\u043e \u0442\u0438 \u0431\u0443\u0434\u0435\u0448 \u0437\u0434\u0438\u0432\u043e\u0432\u0430\u043d\u0438\u0439. P.S. \u0414\u043e \u0440\u0435\u0447\u0456, \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456, \u044f\u043a\u0456 \u043f\u0440\u043e\u0431\u0443\u044e\u0442\u044c \u0446\u0435\u0439 \u0432\u0438\u043a\u043b\u0438\u043a, \u0432 \u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u043c\u0443 \u043f\u0456\u0434\u0432\u0438\u0449\u0443\u044e\u0442\u044c \u0442\u043e\u0447\u043d\u0456\u0441\u0442\u044c \u0441\u0432\u043e\u0457\u0445 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0456\u0432 \u043d\u0430 40% \u0432\u0436\u0435 \u043d\u0430 3-\u0439 \u0434\u0435\u043d\u044c. \u041d\u0435 \u0432\u0456\u0440 \u043c\u0435\u043d\u0456 \u043d\u0430 \u0441\u043b\u043e\u0432\u043e \u2014 \u043f\u0435\u0440\u0435\u0432\u0456\u0440 \u0441\u0430\u043c."
  ],
