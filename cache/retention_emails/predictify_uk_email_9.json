{
  "subject": "\u0421\u0435\u043a\u0440\u0435\u0442, \u044f\u043a\u0438\u0439 \u0437\u043c\u0456\u043d\u044e\u0454 \u0432\u0441\u0435",
  "preview_text": "\u0422\u0440\u0438 \u0434\u043d\u0456 \u2014 \u0456 \u0442\u0438 \u043f\u043e\u0431\u0430\u0447\u0438\u0448, \u043d\u0430\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0442\u0432\u043e\u0457 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438 \u0441\u0442\u0430\u043d\u0443\u0442\u044c \u0442\u043e\u0447\u043d\u0456\u0448\u0438\u043c\u0438. \u0414\u0456\u0437\u043d\u0430\u0439\u0441\u044f, \u044f\u043a \u0446\u0435 \u043f\u0440\u0430\u0446\u044e\u0454.",
  "body_paragraphs": [
    "\u0421\u043b\u0443\u0445\u0430\u0439, \u044f \u043d\u0435 \u0437\u0431\u0438\u0440\u0430\u044e\u0441\u044f \u0432\u043c\u043e\u0432\u043b\u044f\u0442\u0438 \u0442\u0435\u0431\u0435. \u041f\u0440\u043e\u0441\u0442\u043e \u0441\u043f\u0440\u043e\u0431\u0443\u0439 \u043e\u0434\u0438\u043d \u043f\u0440\u043e\u0441\u0442\u0438\u0439 \u0435\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442. \u0422\u0438 \u0437\u043d\u0430\u0454\u0448, \u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0440\u0430\u0437\u0456\u0432 \u0442\u0432\u043e\u0454 \u00ab\u043d\u0443\u0442\u0440\u043e\u00bb \u043f\u0456\u0434\u0432\u043e\u0434\u0438\u043b\u043e \u0442\u0435\u0431\u0435 \u0432 \u0441\u0442\u0430\u0432\u043a\u0430\u0445? \u042f \u0441\u0430\u043c \u0447\u0435\u0440\u0435\u0437 \u0446\u0435 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0432 \u2014 \u0434\u0443\u043c\u0430\u0432, \u0449\u043e \u0437\u043d\u0430\u044e \u0444\u0443\u0442\u0431\u043e\u043b, \u0430 \u0432\u0438\u044f\u0432\u043b\u044f\u043b\u043e\u0441\u044f, \u0449\u043e \u0434\u0430\u043d\u0456 \u0433\u043e\u0432\u043e\u0440\u044f\u0442\u044c \u0456\u043d\u0448\u0435.",
    "\u041e\u0441\u044c \u0443 \u0447\u043e\u043c\u0443 \u0440\u0456\u0447: \u0437\u0430 \u0442\u0440\u0438 \u0434\u043d\u0456 \u0442\u0438 \u043c\u043e\u0436\u0435\u0448 \u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u0441\u0432\u0456\u0439 \u043f\u0456\u0434\u0445\u0456\u0434 \u043d\u0430\u0437\u0430\u0432\u0436\u0434\u0438. \u041f\u043e\u0447\u043d\u0438 \u0437 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0433\u043e \u0447\u0435\u043b\u0435\u043d\u0434\u0436\u0443 \u2014 \u043a\u043e\u0436\u0435\u043d \u0434\u0435\u043d\u044c \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0439 Predictify \u0456 \u0434\u0438\u0432\u0438\u0441\u044c \u043d\u0430 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438 AI \u0434\u043b\u044f \u043e\u0434\u043d\u043e\u0433\u043e \u043c\u0430\u0442\u0447\u0443. \u041d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0447\u0438\u0442\u0430\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442, \u0430 \u043f\u043e\u0440\u0456\u0432\u043d\u044e\u0439 \u0437\u0456 \u0441\u0432\u043e\u0457\u043c\u0438 \u0434\u0443\u043c\u043a\u0430\u043c\u0438. \u041f\u043e\u0431\u0430\u0447\u0438\u0448, \u044f\u043a \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u043b\u0430\u043c\u0430\u0454 \u0441\u0442\u0435\u0440\u0435\u043e\u0442\u0438\u043f\u0438.",
    "\u041d\u0430\u0448 AI \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0454 \u0442\u0438\u0441\u044f\u0447\u0456 \u0437\u043c\u0456\u043d\u043d\u0438\u0445 \u043d\u0430 \u043c\u0430\u0442\u0447 \u2014 \u0432\u0456\u0434 xG \u0434\u043e \u0442\u0430\u043a\u0442\u0438\u0447\u043d\u0438\u0445 \u0441\u0445\u0435\u043c. \u0406 \u0442\u0438 \u043c\u043e\u0436\u0435\u0448 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0446\u0435 \u043f\u0440\u044f\u043c\u043e \u0437\u0430\u0440\u0430\u0437. \u0412\u0456\u0434\u043a\u0440\u0438\u0439 \u0440\u043e\u0437\u0434\u0456\u043b \u0437 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0430\u043c\u0438 \u043d\u0430 \u0437\u0430\u0432\u0442\u0440\u0430, \u0432\u0438\u0431\u0435\u0440\u0438 \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u043c\u0430\u0442\u0447 \u0456 \u0433\u043b\u044f\u043d\u044c \u043d\u0430 Confidence Score. \u0426\u0435 \u043d\u0435 \u043c\u0430\u0433\u0456\u044f \u2014 \u0446\u0435 \u0434\u0430\u043d\u0456. \u0406 \u0432\u043e\u043d\u0438 \u043f\u0440\u0430\u0446\u044e\u044e\u0442\u044c \u043a\u0440\u0430\u0449\u0435, \u043d\u0456\u0436 \u0431\u0443\u0434\u044c-\u044f\u043a\u0430 \u0456\u043d\u0442\u0443\u0457\u0446\u0456\u044f.",
    "\u0412\u0456\u0437\u044c\u043c\u0438 \u0446\u0435\u0439 \u0432\u0438\u043a\u043b\u0438\u043a: \u0442\u0440\u0438 \u0434\u043d\u0456, \u0442\u0440\u0438 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438, \u043e\u0434\u0438\u043d \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0412\u0456\u0434\u043a\u0440\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0456 \u0437\u043d\u0430\u0439\u0434\u0438 \u043c\u0430\u0442\u0447, \u044f\u043a\u0438\u0439 \u0442\u0435\u0431\u0435 \u0446\u0456\u043a\u0430\u0432\u0438\u0442\u044c. \u041f.\u0421. \u041d\u0435 \u0434\u0438\u0432\u0443\u0439\u0441\u044f, \u044f\u043a\u0449\u043e \u043f\u0456\u0441\u043b\u044f \u0442\u0440\u0435\u0442\u044c\u043e\u0433\u043e \u0434\u043d\u044f \u0437\u0430\u0445\u043e\u0447\u0435\u0448 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 Premium \u2014 \u0442\u0430\u043c \u0454 3-\u0434\u0435\u043d\u043d\u0438\u0439 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0438\u0439 \u043f\u0435\u0440\u0456\u043e\u0434. \u0410\u043b\u0435 \u0441\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043f\u0440\u043e\u0431\u0443\u0439."
