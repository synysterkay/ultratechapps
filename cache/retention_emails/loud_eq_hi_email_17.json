{
  "subject": "37 \u0926\u093f\u0928\u094b\u0902 \u0915\u0940 \u0906\u0926\u0924",
  "preview_text": "\u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e \u091c\u094b \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u092c\u0926\u0932 \u0926\u0947\u0917\u0940\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u0939 \u0926\u093f\u0928 \u091c\u092c \u0906\u092a\u0928\u0947 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 Loud EQ \u0916\u094b\u0932\u093e \u0925\u093e? \u0909\u0938 \u0938\u092e\u092f \u0906\u092a \u092c\u0938 \u090f\u0915 \u0906\u0935\u093e\u091c\u093c \u0922\u0942\u0902\u0922 \u0930\u0939\u0947 \u0925\u0947\u0964 \u0906\u091c, 37 \u0926\u093f\u0928 \u092c\u093e\u0926, \u0906\u092a \u092a\u0939\u0932\u0947 \u0938\u0947 \u0915\u0939\u0940\u0902 \u092c\u0947\u0939\u0924\u0930 \u0938\u0941\u0928 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u0905\u0938\u0932\u0940 \u091c\u093e\u0926\u0942 \u0924\u092c \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u093e \u0939\u0948 \u091c\u092c \u092f\u0939 \u090f\u0915 \u0906\u0926\u0924 \u092c\u0928 \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
    "\u090f\u0915 3-\u092e\u093f\u0928\u091f \u0915\u0940 \u0930\u0942\u091f\u0940\u0928 \u0915\u0940 \u0915\u0932\u094d\u092a\u0928\u093e \u0915\u0930\u0947\u0902: \u0938\u0941\u092c\u0939 \u0905\u092a\u0928\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u092f\u093e \u0911\u0921\u093f\u092f\u094b\u092c\u0941\u0915 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947, \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 'Optimize' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u0935\u0939\u0940 \u090f\u0915 \u0915\u0926\u092e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u092b\u093c\u094b\u0928 \u0915\u0947 \u0938\u094d\u092a\u0940\u0915\u0930 \u0915\u094b \u0906\u092a\u0915\u0940 \u091c\u0947\u092c \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u091f\u094d\u092f\u0942\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092a\u0930\u093f\u0923\u093e\u092e? \u0906\u0935\u093e\u091c\u093c \u0907\u0924\u0928\u0940 \u0938\u093e\u092b\u093c \u0914\u0930 \u0924\u0947\u091c\u093c \u0915\u093f \u0906\u092a\u0915\u094b \u0915\u092d\u0940 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0928\u0947 \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902 \u092a\u0921\u093c\u0924\u0940\u0964",
    "Loud EQ \u0915\u093e 'One-tap Optimize' \u092b\u0940\u091a\u0930 \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0928\u093f\u091c\u0940 \u0938\u093e\u0909\u0902\u0921 \u0907\u0902\u091c\u0940\u0928\u093f\u092f\u0930 \u0915\u0940 \u0924\u0930\u0939 \u0939\u0948\u0964 \u092f\u0939 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0906\u092a AirPods \u092f\u093e \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u092a\u094d\u0932\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0905\u092a\u0928\u0947 \u0906\u092a \u090f\u0915\u094d\u091f\u093f\u0935 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0915\u0947 \u0938\u093e\u0925, \u0906\u092a \u0928 \u0938\u093f\u0930\u094d\u092b\u093c \u0938\u0941\u0928\u0924\u0947 \u0939\u0948\u0902, \u092c\u0932\u094d\u0915\u093f \u0939\u0930 \u0936\u092c\u094d\u0926, \u0939\u0930 \u0927\u0941\u0928 \u0915\u094b \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u2014 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0935\u093f\u0915\u0943\u0924\u093f \u0915\u0947\u0964",
    "\u0924\u094b \u0906\u091c \u0915\u0940 \u091a\u0941\u0928\u094c\u0924\u0940: \u0905\u0917\u0932\u0940 \u092c\u093e\u0930 \u091c\u092c \u0906\u092a \u0915\u094b\u0908 \u0911\u0921\u093f\u092f\u094b \u091a\u0932\u093e\u090f\u0901, \u092a\u0939\u0932\u0947 'Optimize' \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964 \u092c\u0938 3 \u0938\u0947\u0915\u0902\u0921\u0964 \u092b\u093f\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0915\u0948\u0938\u0947 \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924 \u092c\u0926\u0932 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u092a\u093e\u0938 'Sound DNA' \u0914\u0930 'Hearing-safe Streak' \u091c\u0948\u0938\u0940 \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0901 \u0939\u0948\u0902 \u091c\u094b \u0907\u0938 \u0930\u0942\u091f\u0940\u0928 \u0915\u094b \u0914\u0930 \u092d\u0940 \u0936\u0915\u094d\u0924\u093f\u0936\u093e\u0932\u0940 \u092c\u0928\u093e\u0924\u0940 \u0939\u0948\u0902\u0964"
  ],
