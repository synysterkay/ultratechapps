{
  "subject": "\u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0917\u0932\u0924\u0940 \u0915\u0940 \u0925\u0940 - \u0905\u092c 2 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0915\u0930\u0924\u093e \u0939\u0942\u0901 \u0935\u094b \u091c\u094b 20 \u092e\u093f\u0928\u091f \u0932\u0947\u0924\u093e \u0925\u093e",
  "preview_text": "\u0906\u092a \u092d\u0940 \u0936\u093e\u092f\u0926 \u092f\u0939\u0940 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u090f\u0915 \u091b\u094b\u091f\u093e \u092c\u0926\u0932\u093e\u0935 \u0906\u092a\u0915\u094b \u0939\u0930 \u092e\u0948\u091a \u092e\u0947\u0902 18 \u092e\u093f\u0928\u091f \u092c\u091a\u093e\u090f\u0917\u093e\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 \u0938\u0940\u091c\u093c\u0928 \u092e\u0947\u0902 \u092e\u0948\u0902 \u0939\u0930 \u0936\u0928\u093f\u0935\u093e\u0930 \u0938\u0941\u092c\u0939 20 \u092e\u093f\u0928\u091f \u092c\u0930\u094d\u092c\u093e\u0926 \u0915\u0930\u0924\u093e \u0925\u093e\u0964 \u091f\u0940\u092e \u092b\u0949\u0930\u094d\u092e \u091a\u0947\u0915 \u0915\u0930\u0928\u093e, \u0939\u0947\u0921-\u091f\u0942-\u0939\u0940\u0921 \u0926\u0947\u0916\u0928\u093e, \u0916\u093f\u0932\u093e\u0921\u093c\u093f\u092f\u094b\u0902 \u0915\u0947 \u0906\u0902\u0915\u0921\u093c\u0947 \u091c\u0941\u091f\u093e\u0928\u093e - \u0914\u0930 \u092b\u093f\u0930 \u092d\u0940 \u0917\u0932\u0924 \u0905\u0928\u0941\u092e\u093e\u0928 \u0932\u0917\u093e\u0928\u093e\u0964 \u092e\u0948\u0902 \u0921\u0947\u091f\u093e \u092e\u0947\u0902 \u0921\u0942\u092c\u093e \u0930\u0939\u0924\u093e \u0925\u093e \u092a\u0930 \u0928\u0924\u0940\u091c\u093e \u0935\u0939\u0940 \u0922\u093e\u0915 \u0915\u0947 \u0924\u0940\u0928 \u092a\u093e\u0924\u0964",
    "\u092b\u093f\u0930 \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0924\u0930\u0940\u0915\u093e \u0916\u094b\u091c\u093e \u091c\u094b \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0905\u092c \u092e\u0948\u091a \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u092e\u0941\u091d\u0947 \u092a\u0924\u093e \u091a\u0932 \u091c\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u093f\u0938 \u091f\u0940\u092e \u092a\u0930 \u0926\u093e\u0902\u0935 \u0932\u0917\u093e\u0928\u093e \u0938\u0939\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0915\u094b\u0908 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902, \u092c\u0938 \u0938\u0939\u0940 \u091f\u0942\u0932 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0939\u0948\u0964 \u0914\u0930 \u092f\u0939 \u091f\u0942\u0932 \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u092e\u0947\u0902 \u092a\u0939\u0932\u0947 \u0938\u0947 \u092e\u094c\u091c\u0942\u0926 \u0939\u0948\u0964",
    "Predictify \u0915\u093e AI \u091a\u0948\u091f \u0935\u0939 \u0930\u0939\u0938\u094d\u092f \u0939\u0948 \u091c\u093f\u0938\u0947 90% \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0928\u091c\u093c\u0930\u0905\u0902\u0926\u093e\u091c\u093c \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u0938 \u090f\u0915 \u0938\u0935\u093e\u0932 \u092a\u0942\u091b\u0947\u0902: '\u0906\u091c \u0915\u0947 \u092e\u0948\u091a \u092e\u0947\u0902 \u0915\u094c\u0928 \u091c\u0940\u0924\u0947\u0917\u093e \u0914\u0930 \u0915\u094d\u092f\u094b\u0902?' 60 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0906\u092a\u0915\u094b \u092a\u0942\u0930\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092e\u093f\u0932 \u091c\u093e\u090f\u0917\u0940 - xG, \u091f\u0940\u092e \u092b\u0949\u0930\u094d\u092e, \u091f\u0948\u0915\u094d\u091f\u093f\u0915\u0932 \u090f\u0928\u093e\u0932\u093f\u0938\u093f\u0938, \u0914\u0930 \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0938\u092c \u0915\u0941\u091b\u0964 \u0935\u094b \u0938\u092c \u091c\u094b \u092e\u0948\u0902 20 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0907\u0915\u091f\u094d\u0920\u093e \u0915\u0930\u0924\u093e \u0925\u093e\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 AI \u091a\u0948\u091f \u092e\u0947\u0902 \u092f\u0939 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902: '\u0906\u091c \u0930\u093e\u0924 \u0915\u0947 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u0930 \u0932\u0940\u0917 \u092e\u0948\u091a \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0926\u094b'\u0964 \u0926\u0947\u0916\u0947\u0902 \u0915\u0948\u0938\u0947 2 \u092e\u093f\u0928\u091f \u0906\u092a\u0915\u0940 \u092a\u0942\u0930\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u092c\u0926\u0932 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939 \u0914\u0930 \u092d\u0940 \u0924\u0947\u091c\u093c \u0939\u0948 - \u0935\u094b \u0938\u0940\u0927\u0947 \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u0938\u094d\u091f\u0948\u091f\u094d\u0938 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u092c\u093f\u0928\u093e \u0938\u0935\u093e\u0932 \u092a\u0942\u091b\u0947\u0964 3-\u0926\u093f\u0928 \u0915\u093e \u091f\u094d\u0930\u093e\u092f\u0932 \u0905\u092d\u0940 \u092d\u0940 \u091a\u0932 \u0930\u0939\u093e \u0939\u0948 \u0905\u0917\u0930 \u0906\u092a\u0928\u0947 \u0936\u0941\u0930\u0942 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e\u0964"
  ],
