{
  "subject": "\u0422\u043e\u043f-1% \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432 \u0440\u043e\u0431\u043b\u044f\u0442\u044c \u0446\u0435 \u0456\u043d\u0430\u043a\u0448\u0435",
  "preview_text": "\u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u0441\u0435\u043a\u0440\u0435\u0442, \u044f\u043a\u0438\u0439 \u0437\u043c\u0456\u043d\u044e\u0454 \u0433\u0440\u0443. \u0414\u0456\u0437\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u044f\u043a \u0435\u043a\u0441\u043f\u0435\u0440\u0442\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c Predictify.",
  "body_paragraphs": [
    "\u042f \u043f\u043e\u043c\u0456\u0442\u0438\u0432, \u0449\u043e \u0431\u0456\u043b\u044c\u0448\u0456\u0441\u0442\u044c \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u044e\u0442\u044c \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0456 \u0434\u0438\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438. \u0410\u043b\u0435 \u0442\u043e\u043f-1% \u0440\u043e\u0431\u043b\u044f\u0442\u044c \u0437\u043e\u0432\u0441\u0456\u043c \u0456\u043d\u0430\u043a\u0448\u0435. \u0412\u043e\u043d\u0438 \u043d\u0435 \u0447\u0435\u043a\u0430\u044e\u0442\u044c, \u043f\u043e\u043a\u0438 AI \u0441\u043a\u0430\u0436\u0435 \u0457\u043c, \u0449\u043e \u0440\u043e\u0431\u0438\u0442\u0438. \u0412\u043e\u043d\u0438 \u0441\u0442\u0432\u043e\u0440\u044e\u044e\u0442\u044c \u0432\u043b\u0430\u0441\u043d\u0438\u0439 \u0440\u043e\u0431\u043e\u0447\u0438\u0439 \u043f\u0440\u043e\u0446\u0435\u0441 \u2014 \u0456 \u0446\u0435 \u0434\u0430\u0454 \u0457\u043c \u043f\u0435\u0440\u0435\u0432\u0430\u0433\u0443, \u044f\u043a\u0443 \u043d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0437\u0432\u0438\u0447\u0430\u0439\u043d\u0438\u043c \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u043c.",
    "\u041e\u0441\u044c \u0443 \u0447\u043e\u043c\u0443 \u0441\u0435\u043a\u0440\u0435\u0442: \u0432\u043e\u043d\u0438 \u043f\u043e\u0447\u0438\u043d\u0430\u044e\u0442\u044c \u043d\u0435 \u0437 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0456\u0432, \u0430 \u0437 \u043c\u0430\u0442\u0447\u0456\u0432, \u0434\u0435 \u0454 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448\u0430 \u043d\u0435\u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u0456\u0441\u0442\u044c. \u0412\u043e\u043d\u0438 \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u044e\u0442\u044c \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443 \u043a\u043e\u043c\u0430\u043d\u0434\u0438, \u0434\u0438\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u043d\u0430 xG, \u043e\u0431\u043e\u0440\u043e\u043d\u043d\u0456 \u043f\u043e\u043a\u0430\u0437\u043d\u0438\u043a\u0438 \u0442\u0430 \u0456\u0441\u0442\u043e\u0440\u0456\u044e \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0435\u0439. \u041f\u043e\u0442\u0456\u043c \u0432\u043e\u043d\u0438 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u044f\u0442\u044c \u0434\u043e AI Chat \u0456 \u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0435 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f: '\u042f\u043a\u0430 \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u0456\u0441\u0442\u044c, \u0449\u043e \u043e\u0431\u043e\u0440\u043e\u043d\u0430 \u041b\u0456\u0432\u0435\u0440\u043f\u0443\u043b\u044f \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0433\u043e\u043b \u043f\u0440\u043e\u0442\u0438 \u041c\u0430\u043d \u0421\u0456\u0442\u0456 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u0445 10 \u043c\u0430\u0442\u0447\u0456\u0432?' \u0406 \u043b\u0438\u0448\u0435 \u043f\u0456\u0441\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0432\u043e\u043d\u0438 \u0434\u0438\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u043d\u0430 \u043f\u0440\u043e\u0433\u043d\u043e\u0437.",
    "\u0423 Predictify \u0454 \u0444\u0443\u043d\u043a\u0446\u0456\u044f, \u044f\u043a\u0430 \u0446\u0435 \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u2014 AI Chat. \u0412\u0456\u043d \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 \u0442\u0456 \u0441\u0430\u043c\u0456 \u0434\u0430\u043d\u0456, \u0449\u043e \u0439 \u043d\u0430\u0448\u0456 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438, \u0430\u043b\u0435 \u0434\u0430\u0454 \u0432\u0430\u043c \u0433\u043d\u0443\u0447\u043a\u0456\u0441\u0442\u044c. \u0422\u043e\u043f-1% \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0447\u0438\u0442\u0430\u044e\u0442\u044c \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438, \u0432\u043e\u043d\u0438 \u0437\u0430\u0434\u0430\u044e\u0442\u044c \u043f\u0438\u0442\u0430\u043d\u043d\u044f, \u044f\u043a\u0456 \u043d\u0456\u0445\u0442\u043e \u0456\u043d\u0448\u0438\u0439 \u043d\u0435 \u0437\u0430\u0434\u0430\u0454. \u0412\u043e\u043d\u0438 \u0441\u0442\u0432\u043e\u0440\u044e\u044e\u0442\u044c \u0432\u043b\u0430\u0441\u043d\u0438\u0439 \u0430\u043d\u0430\u043b\u0456\u0442\u0438\u0447\u043d\u0438\u0439 \u0437\u0432\u0456\u0442 \u043f\u0435\u0440\u0435\u0434 \u0442\u0438\u043c, \u044f\u043a \u0437\u0440\u043e\u0431\u0438\u0442\u0438 \u0441\u0442\u0430\u0432\u043a\u0443. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0446\u0435 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456: \u0432\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u0434\u043e\u0434\u0430\u0442\u043e\u043a, \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043c\u0430\u0442\u0447, \u044f\u043a\u0438\u0439 \u0432\u0430\u0441 \u0446\u0456\u043a\u0430\u0432\u0438\u0442\u044c, \u0456 \u0437\u0430\u043f\u0438\u0442\u0430\u0439\u0442\u0435 AI Chat: '\u0427\u0438 \u0432\u0430\u0440\u0442\u043e \u0440\u043e\u0431\u0438\u0442\u0438 \u0441\u0442\u0430\u0432\u043a\u0443 \u043d\u0430 \u0442\u043e\u0442\u0430\u043b \u0431\u0456\u043b\u044c\u0448\u0435 2.5?'",
    "\u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 Predictify \u0437\u0430\u0440\u0430\u0437 \u0456 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0446\u0435 \u043d\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u0446\u0456. P.S. \u0411\u043e\u043d\u0443\u0441\u0438: \u0449\u043e\u0434\u0435\u043d\u043d\u0456 \u0441\u0442\u0440\u0456\u043a\u0438 \u0434\u0430\u044e\u0442\u044c \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0456 \u043a\u0440\u0435\u0434\u0438\u0442\u0438, \u0430 Premium \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454 \u043f\u043e\u0432\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0432\u0441\u0456\u0445 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0456\u0432 \u2014 3 \u0434\u043d\u0456 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u043e, \u043f\u043e\u0442\u0456\u043c $12.99/\u043c\u0456\u0441."
