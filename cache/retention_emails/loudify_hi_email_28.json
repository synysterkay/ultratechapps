{
  "subject": "\u0905\u092c \u0938\u0930\u094d\u0926\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0926\u092b\u0928 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0938\u093e\u092b \u0938\u0941\u0928\u094b",
  "preview_text": "\u0938\u0930\u094d\u0926\u093f\u092f\u094b\u0902 \u0915\u0940 \u0939\u0935\u093e \u0914\u0930 \u0939\u0940\u091f\u0930 \u0915\u0947 \u0936\u094b\u0930 \u092e\u0947\u0902 \u0906\u0935\u093e\u091c\u093c \u0926\u092c \u091c\u093e\u0924\u0940 \u0939\u0948? Loudify \u0915\u093e \u0906\u091c \u0915\u093e \u092b\u0940\u091a\u0930 \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964",
  "body_paragraphs": [
    "\u0938\u0930\u094d\u0926\u093f\u092f\u094b\u0902 \u0915\u0940 \u0938\u0941\u092c\u0939, \u092c\u0938 \u092e\u0947\u0902 \u0939\u0940\u091f\u0930 \u091a\u0932 \u0930\u0939\u093e \u0939\u0948, \u0916\u093f\u0921\u093c\u0915\u0940 \u0938\u0947 \u0939\u0935\u093e \u0906 \u0930\u0939\u0940 \u0939\u0948, \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u0917\u0941\u0928\u0917\u0941\u0928\u093e\u0939\u091f \u092c\u0928 \u0917\u092f\u093e \u0939\u0948\u0964 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0913, \u0932\u0947\u0915\u093f\u0928 \u0921\u093e\u092f\u0932\u0949\u0917 \u0914\u0930 \u0936\u094b\u0930 \u092e\u0947\u0902 \u092b\u0930\u094d\u0915\u093c \u0928\u0939\u0940\u0902\u0964 \u092f\u0939\u0940 \u0935\u094b \u092a\u0932 \u0939\u0948 \u091c\u092c Loudify \u0915\u093e \u090f\u0915 \u092b\u0940\u091a\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0917\u0947\u092e \u092c\u0926\u0932 \u0938\u0915\u0924\u093e \u0939\u0948\u0964",
    "\u0939\u092e\u0928\u0947 100,000+ \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u0938\u093e\u092b \u0914\u0930 \u0924\u0947\u091c\u093c \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964 \u0938\u0930\u094d\u0926\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0918\u0930 \u0915\u0947 \u0905\u0902\u0926\u0930 \u092f\u093e \u092c\u093e\u0939\u0930, \u0939\u0930 \u091c\u0917\u0939 \u0936\u094b\u0930 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0939\u094b\u0924\u093e \u0939\u0948 \u2014 HVAC, \u091f\u094d\u0930\u0947\u0928, \u0921\u093f\u0936\u0935\u0949\u0936\u0930\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092b\u094b\u0928 \u0915\u093e \u0938\u093f\u0938\u094d\u091f\u092e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u090f\u0915 \u0926\u0940\u0935\u093e\u0930 \u0939\u0948\u0964 Loudify \u0909\u0938\u0947 \u0924\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964 +200% \u0932\u093e\u0909\u0921, \u0932\u0947\u0915\u093f\u0928 \u092c\u093f\u0928\u093e \u0921\u093f\u0938\u094d\u091f\u0949\u0930\u094d\u0936\u0928\u0964 \u0906\u0935\u093e\u091c\u093c \u0935\u0939\u093e\u0901 \u0938\u093e\u092b \u091c\u0939\u093e\u0901 \u092e\u093e\u092f\u0928\u0947 \u0930\u0916\u0924\u0940 \u0939\u0948\u0964",
    "\u0906\u091c \u0915\u093e \u092b\u0940\u091a\u0930 \u0939\u0948 '\u0917\u0947\u092e\u093f\u0902\u0917 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932' \u2014 \u0938\u093f\u0930\u094d\u092b\u093c \u0917\u0947\u092e\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902\u0964 \u0907\u0938\u0947 \u0924\u0941\u0930\u0902\u0924 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u092a\u0939\u091a\u093e\u0928 \u0932\u093f\u090f \u091c\u093e\u090f\u0902\u0917\u0947, AutoEQ \u0938\u0947 \u091f\u094d\u092f\u0942\u0928 \u0939\u094b \u091c\u093e\u090f\u0902\u0917\u0947, \u0914\u0930 \u0939\u0930 \u0906\u0935\u093e\u091c\u093c \u0938\u093e\u092b\u093c \u0928\u093f\u0915\u0932\u0947\u0917\u0940\u0964 \u091a\u093e\u0939\u0947 Spotify \u0939\u094b, Audible \u0939\u094b, \u092f\u093e YouTube \u2014 \u0938\u092c \u0915\u0941\u091b \u090f\u0915 \u091f\u0948\u092a \u092e\u0947\u0902\u0964",
    "\u0916\u094b\u0932\u094b Loudify, '\u0917\u0947\u092e\u093f\u0902\u0917 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u094b, \u0914\u0930 \u0906\u091c \u0915\u0940 \u0930\u093e\u0924 \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0938\u093e\u092b \u0938\u0941\u0928\u094b\u0964 P.S. \u2014 \u0905\u0917\u0930 \u0924\u0941\u092e\u0928\u0947 \u0905\u092c \u0924\u0915 Sound DNA \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u0940, \u0924\u094b \u0935\u094b \u092d\u0940 \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0939\u092b\u094d\u0924\u0947 \u0915\u093e \u0938\u0941\u0928\u0928\u0947 \u0915\u093e \u0921\u0947\u091f\u093e \u2014 \u0905\u0938\u0932\u0940, \u092b\u093c\u0947\u0915 \u0928\u0939\u0940\u0902\u0964"
  ],
