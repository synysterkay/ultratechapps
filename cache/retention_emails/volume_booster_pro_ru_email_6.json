{
  "subject": "\u041e\u0448\u0438\u0431\u043a\u0430 2 \u043d\u043e\u0447\u0438, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u044e\u0442 80%",
  "preview_text": "\u041e\u0434\u0438\u043d \u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u0448\u0430\u0433, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u0435\u043d\u044f\u0435\u0442 \u0432\u0441\u0451. \u0411\u0435\u0437 \u0440\u0435\u043a\u043b\u0430\u043c\u044b, \u0431\u0435\u0437 \u043b\u0438\u0448\u043d\u0435\u0433\u043e \u0448\u0443\u043c\u0430.",
  "body_paragraphs": [
    "\u0412\u044b \u043a\u0443\u043f\u0438\u043b\u0438 Volume Booster Pro, \u0447\u0442\u043e\u0431\u044b \u0437\u0432\u0443\u043a \u0441\u0442\u0430\u043b \u0433\u0440\u043e\u043c\u0447\u0435, \u0430 \u043d\u0435 \u0447\u0442\u043e\u0431\u044b \u0431\u043e\u0440\u043e\u0442\u044c\u0441\u044f \u0441 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u043e\u043c. \u041d\u043e \u0432\u043e\u0442 \u0447\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e: \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0431\u0443\u0441\u0442\u0435\u0440, \u0441\u043b\u0443\u0448\u0430\u0435\u0442 \u043f\u0430\u0440\u0443 \u0442\u0440\u0435\u043a\u043e\u0432 \u0438 \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u043e \u043d\u0435\u0433\u043e. \u0410 \u043f\u043e\u0442\u043e\u043c \u0436\u0430\u043b\u0443\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u044d\u0444\u0444\u0435\u043a\u0442 \u043f\u0440\u043e\u043f\u0430\u043b.",
    "\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u043d\u0435 \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438. \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u0432\u044b \u043d\u0435 \u0434\u0430\u043b\u0438 \u0435\u043c\u0443 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0432 \u0444\u043e\u043d\u0435. \u0411\u0443\u0441\u0442\u0435\u0440 \u0436\u0438\u0432\u0451\u0442 \u0432 \u043f\u0430\u043d\u0435\u043b\u0438 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439 \u2014 \u043f\u0440\u043e\u0432\u0435\u0434\u0438\u0442\u0435 \u0432\u043d\u0438\u0437, \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u0438\u043a\u043e\u043d\u043a\u0443. \u041e\u043d \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u0441\u044f, \u043a\u043e\u0433\u0434\u0430 \u0432\u044b \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438, \u0438 \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0441\u044f \u0441\u0430\u043c. \u042d\u0442\u043e \u043d\u0435 \u043c\u0430\u0433\u0438\u044f, \u044d\u0442\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u043d\u0430 3 \u0441\u0435\u043a\u0443\u043d\u0434\u044b.",
    "\u0417\u0430\u0439\u0434\u0438\u0442\u0435 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0431\u0443\u0441\u0442\u0435\u0440\u0430. \u0422\u0430\u043c \u0435\u0441\u0442\u044c \u0442\u0443\u043c\u0431\u043b\u0435\u0440 \u00ab\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0440\u0438 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0433\u0430\u0440\u043d\u0438\u0442\u0443\u0440\u044b\u00bb. \u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0435\u0433\u043e \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u2014 \u0438 \u0437\u0430\u0431\u0443\u0434\u044c\u0442\u0435. \u0421 \u044d\u0442\u043e\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0432\u0430\u0448 \u0437\u0432\u0443\u043a \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442 +200%, \u0431\u0435\u0437 \u043b\u0438\u0448\u043d\u0438\u0445 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0439. \u041d\u0438\u043a\u0430\u043a\u043e\u0439 \u0440\u0435\u043a\u043b\u0430\u043c\u044b, \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439. \u0422\u043e\u043b\u044c\u043a\u043e \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c, \u043a\u0430\u043a \u0432\u044b \u0438 \u0445\u043e\u0442\u0435\u043b\u0438.",
    "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0441\u0435\u0439\u0447\u0430\u0441, \u043d\u0430\u0439\u0434\u0438\u0442\u0435 \u044d\u0442\u043e\u0442 \u0442\u0443\u043c\u0431\u043b\u0435\u0440 \u0438 \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0435\u0433\u043e. \u042d\u0442\u043e \u0437\u0430\u0439\u043c\u0451\u0442 \u043c\u0435\u043d\u044c\u0448\u0435 \u043c\u0438\u043d\u0443\u0442\u044b.\n\nP.S. \u0415\u0441\u043b\u0438 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u043b\u044e\u0431\u0438\u043c\u044b\u0439 \u043f\u043b\u0435\u0439\u043b\u0438\u0441\u0442 \u0438\u043b\u0438 \u043f\u043e\u0434\u043a\u0430\u0441\u0442, \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0431\u0443\u0441\u0442\u0435\u0440 \u043d\u0430 \u043d\u0451\u043c. \u0412\u044b \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u0441\u044c, \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0447\u0438\u0449\u0435 \u0437\u0432\u0443\u0447\u0430\u0442 \u0442\u0438\u0445\u0438\u0435 \u0441\u0446\u0435\u043d\u044b, \u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043d\u0443\u0436\u043d\u043e \u043a\u0440\u0443\u0442\u0438\u0442\u044c \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u043d\u0430 \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c."
  ],
