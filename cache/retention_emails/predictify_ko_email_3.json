  "subject": "\ub2e8 60\ucd08\uba74 \ubc14\ub00c\ub294 \uc608\uce21 \uacb0\uacfc\uc758 \ube44\ubc00",
  "preview_text": "\ud55c \uac00\uc9c0 \uc791\uc740 \uc124\uc815\uc774 \ub2f9\uc2e0\uc758 \uc608\uce21 \uc131\uacf5\ub960\uc744 \ub192\uc785\ub2c8\ub2e4. \uc9c0\uae08 \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "\ub2f9\uc2e0\uc774 \uc624\ub298 \ubcf8 \uacbd\uae30\uc5d0\uc11c \uc608\uce21\uc774 \ube57\ub098\uac04 \uc774\uc720\ub97c \uc54c\uc544\uc694? \ub2e8\uc21c\ud788 \uac10\uc5d0 \uc758\uc874\ud588\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc800\ub3c4 \uadf8\ub7ac\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \ud55c \uac00\uc9c0 \uc791\uc740 \ud2b8\ub9ad\uc744 \uc54c\uac8c \ub41c \ud6c4\ub85c, \uc81c \uc608\uce21 \uc815\ud655\ub3c4\uac00 \ud655 \uc62c\ub790\uc2b5\ub2c8\ub2e4.",
    "\uadf8 \ud2b8\ub9ad\uc740? \uba3c\uc800 \uacbd\uae30 \uc804\uc5d0 '\ucee8\ud53c\ub358\uc2a4 \uc2a4\ucf54\uc5b4'\ub97c \ud655\uc778\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. AI\uac00 \uac01 \ud300\uc758 \ucd5c\uadfc xG, \uc218\ube44 \uac15\ub3c4, \uc810\uc720\uc728\uc744 \ubd84\uc11d\ud574 \uc5bc\ub9c8\ub098 \ud655\uc2e0\ud558\ub294\uc9c0 \uc54c\ub824\uc90d\ub2c8\ub2e4. \uc774\uac78 \ubcf4\uc9c0 \uc54a\uace0 \uc608\uce21\ud558\uba74, \ub9c8\uce58 \ub208\uc744 \uac00\ub9ac\uace0 \ub2e4\ud2b8\ub97c \ub358\uc9c0\ub294 \uac83\uacfc \uac19\uc544\uc694.",
    "Predictify \uc571\uc5d0\uc11c \uacbd\uae30 \uce74\ub4dc\ub97c \uc5f4\uba74, \uc0c1\ub2e8\uc5d0 \ucee8\ud53c\ub358\uc2a4 \uc2a4\ucf54\uc5b4\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4. 80% \uc774\uc0c1\uc77c \ub54c\ub9cc \ubca0\ud305\ud558\uac70\ub098 \uc608\uce21\uc744 \uacf5\uc720\ud574\ubcf4\uc138\uc694. \uadf8\ub7ec\uba74 \ub2f9\uc2e0\uc758 \uc2b9\ub960\uc774 \ud655\uc2e4\ud788 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4.",
    "\uc9c0\uae08 \ubc14\ub85c Predictify\ub97c \uc5f4\uc5b4 \uc624\ub298 \uacbd\uae30 \uc911 \ud558\ub098\uc758 \ucee8\ud53c\ub358\uc2a4 \uc2a4\ucf54\uc5b4\ub97c \ud655\uc778\ud574\ubcf4\uc138\uc694. \ub2e8 60\ucd08\uba74 \ub05d\ub0a9\ub2c8\ub2e4. P.S. \uc774 \ud301\uc744 \uc368\ubcf8 \uc0ac\ub78c\ub4e4\uc740 \"\uac10\uc774 \uc544\ub2c8\ub77c \ub370\uc774\ud130\ub85c \uc2b9\ubd80\ud55c\ub2e4\"\ub294 \ub290\ub08c\uc744 \ubc1b\uc558\ub2e4\uace0 \ub9d0\ud569\ub2c8\ub2e4."
