{
  "subject": "\u0631\u0627\u062a 2 \u0628\u062c\u06d2 \u06a9\u06cc \u0627\u06cc\u06a9 \u0639\u062c\u06cc\u0628 \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc",
  "preview_text": "\u0627\u06cc\u06a9 \u0635\u0627\u0631\u0641 \u0646\u06d2 \u0627\u06cc\u0633\u0627 \u06a9\u0686\u06be \u06a9\u06cc\u0627 \u062c\u0648 \u06c1\u0645 \u0646\u06d2 \u06a9\u0628\u06be\u06cc \u0633\u0648\u0686\u0627 \u0628\u06be\u06cc \u0646\u06c1 \u062a\u06be\u0627\u06d4 \u0622\u067e \u0628\u06be\u06cc \u062d\u06cc\u0631\u0627\u0646 \u06c1\u0648 \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2\u06d4",
  "body_paragraphs": [
    "\u0645\u06cc\u06ba \u0622\u067e \u06a9\u0648 \u0627\u06cc\u06a9 \u06a9\u06c1\u0627\u0646\u06cc \u0633\u0646\u0627\u062a\u0627 \u06c1\u0648\u06ba\u06d4 \u0631\u0627\u062a \u06a9\u06d2 2 \u0628\u062c\u06d2\u060c \u0627\u06cc\u06a9 \u0635\u0627\u0631\u0641 \u0646\u06d2 Predictify \u06a9\u06be\u0648\u0644\u0627 \u0627\u0648\u0631 \u0627\u067e\u0646\u06d2 \u067e\u0633\u0646\u062f\u06cc\u062f\u06c1 \u06a9\u06be\u0644\u0627\u0691\u06cc \u06a9\u06d2 \u0627\u06af\u0644\u06d2 \u06af\u0648\u0644 \u06a9\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc \u06a9\u0631\u0646\u06d2 \u0644\u06af\u0627\u06d4 \u0644\u06cc\u06a9\u0646 \u0648\u06c1 \u0635\u0631\u0641 \u0645\u06cc\u0686 \u06a9\u0627 \u0646\u062a\u06cc\u062c\u06c1 \u0646\u06c1\u06cc\u06ba \u062f\u06cc\u06a9\u06be \u0631\u06c1\u0627 \u062a\u06be\u0627\u2014\u0648\u06c1 \u0627\u067e\u0646\u06d2 \u062f\u0648\u0633\u062a\u0648\u06ba \u0633\u06d2 \u0634\u0631\u0637 \u0644\u06af\u0627 \u0631\u06c1\u0627 \u062a\u06be\u0627 \u06a9\u06c1 \u06a9\u0648\u0646 \u0633\u0627 \u0645\u0646\u0679 \u0645\u06cc\u06ba \u06af\u0648\u0644 \u06c1\u0648\u06af\u0627\u06d4 \u0648\u06c1 \u06a9\u06c1\u062a\u0627 \u06c1\u06d2\u060c '\u06cc\u06c1 \u062a\u0648 \u0627\u06cc\u06a9 \u06af\u06cc\u0645 \u06c1\u06d2\u060c \u0644\u06cc\u06a9\u0646 \u0688\u06cc\u0679\u0627 \u0645\u062c\u06be\u06d2 \u0633\u0628 \u0633\u06d2 \u0622\u06af\u06d2 \u0631\u06a9\u06be\u062a\u0627 \u06c1\u06d2\u06d4'",
    "\u06c1\u0645 \u0646\u06d2 \u0633\u0648\u0686\u0627 \u062a\u06be\u0627 \u06a9\u06c1 \u0622\u067e \u0635\u0631\u0641 \u0628\u0691\u06d2 \u0645\u06cc\u0686\u0648\u06ba \u06a9\u06cc \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc \u06a9\u0631\u06cc\u06ba \u06af\u06d2\u060c \u0644\u06cc\u06a9\u0646 \u0622\u067e \u0646\u06d2 \u06c1\u0645\u06cc\u06ba \u063a\u0644\u0637 \u062b\u0627\u0628\u062a \u06a9\u06cc\u0627\u06d4 \u0622\u067e \u0646\u06d2 \u0686\u06be\u0648\u0679\u06cc \u0644\u06cc\u06af\u0648\u06ba\u060c \u0646\u0627\u06cc\u0627\u0628 \u0645\u06cc\u0686\u0648\u06ba\u060c \u0627\u0648\u0631 \u062d\u062a\u06cc\u0670 \u06a9\u06c1 \u062f\u0648\u0633\u062a\u0648\u06ba \u06a9\u06d2 \u062f\u0631\u0645\u06cc\u0627\u0646 \u0686\u06be\u0648\u0679\u06cc \u0634\u0631\u0637\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u0628\u06be\u06cc Predictify \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u0627 \u0634\u0631\u0648\u0639 \u06a9\u0631 \u062f\u06cc\u0627\u06d4 \u06cc\u06c1 \u0648\u06c1 \u0686\u06cc\u0632 \u06c1\u06d2 \u062c\u0648 \u06c1\u0645 \u0646\u06d2 \u06a9\u0628\u06be\u06cc \u062a\u0648\u0642\u0639 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc \u062a\u06be\u06cc\u2014\u0622\u067e \u0646\u06d2 \u0627\u0633\u06d2 \u0627\u067e\u0646\u0627 \u0630\u0627\u062a\u06cc \u06a9\u06be\u06cc\u0644 \u06a9\u0627 \u062a\u062c\u0632\u06cc\u06c1 \u06a9\u0627\u0631 \u0628\u0646\u0627 \u0644\u06cc\u0627 \u06c1\u06d2\u06d4",
    "\u0627\u0628 \u0622\u067e \u06a9\u0686\u06be \u0627\u0648\u0631 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u0633 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0634\u0627\u06cc\u062f \u0622\u067e \u0646\u06d2 \u0633\u0648\u0686\u0627 \u0628\u06be\u06cc \u0646\u06c1 \u06c1\u0648\u06d4 AI Chat \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2\u060c \u0622\u067e \u06a9\u0633\u06cc \u0628\u06be\u06cc \u06a9\u06be\u0644\u0627\u0691\u06cc \u06a9\u06cc \u0641\u0627\u0631\u0645\u060c \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0679\u06cc\u0645 \u06a9\u06cc \u062d\u06a9\u0645\u062a \u0639\u0645\u0644\u06cc\u060c \u06cc\u0627 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0645\u06cc\u0686 \u06a9\u06d2 \u0627\u0639\u062f\u0627\u062f \u0648 \u0634\u0645\u0627\u0631 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u067e\u0648\u0686\u06be \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u2014\u0635\u0631\u0641 \u0686\u0646\u062f \u0633\u06cc\u06a9\u0646\u0688 \u0645\u06cc\u06ba\u06d4 \u062c\u06cc\u0633\u06d2 \u0622\u067e \u06a9\u0627 \u0627\u067e\u0646\u0627 \u0688\u06cc\u0679\u0627 \u062a\u062c\u0632\u06cc\u06c1 \u06a9\u0627\u0631\u060c \u0644\u06cc\u06a9\u0646 \u0645\u0641\u062a\u06d4",
    "\u062a\u0648 \u0622\u062c \u0631\u0627\u062a\u060c \u0627\u067e\u0646\u06d2 \u0641\u0648\u0646 \u0645\u06cc\u06ba Predictify \u06a9\u06be\u0648\u0644\u06cc\u06ba \u0627\u0648\u0631 \u0627\u06af\u0644\u06d2 \u0645\u06cc\u0686 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u06a9\u0686\u06be \u0646\u06cc\u0627 \u067e\u0648\u0686\u06be\u06cc\u06ba\u06d4 \u0634\u0627\u06cc\u062f \u0622\u067e \u06a9\u0648 \u0648\u06c1 \u062c\u0648\u0627\u0628 \u0645\u0644\u06d2 \u062c\u0648 \u0622\u067e \u0646\u06d2 \u06a9\u0628\u06be\u06cc \u0646\u06c1\u06cc\u06ba \u0633\u0648\u0686\u0627 \u062a\u06be\u0627\u06d4 P.S.\u2014\u06a9\u06cc\u0627 \u0622\u067e \u062c\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u06c1\u0645\u0627\u0631\u06d2 \u067e\u0631\u06cc\u0645\u06cc\u0645 \u0635\u0627\u0631\u0641\u06cc\u0646 3 \u062f\u0646 \u06a9\u06d2 \u0645\u0641\u062a \u0679\u0631\u0627\u0626\u0644 \u0645\u06cc\u06ba 12.99 \u0688\u0627\u0644\u0631 \u0641\u06cc \u0645\u06c1\u06cc\u0646\u06c1 \u0645\u06cc\u06ba \u062a\u0645\u0627\u0645 \u067e\u06cc\u0634\u06cc\u0646 \u06af\u0648\u0626\u06cc\u0627\u06ba \u0627\u0648\u0631 \u062c\u062f\u06cc\u062f \u0627\u0639\u062f\u0627\u062f \u0648 \u0634\u0645\u0627\u0631 \u062d\u0627\u0635\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u061f \u0628\u0633 \u0627\u06cc\u06a9 \u0628\u0627\u0631 \u06a9\u0648\u0634\u0634 \u06a9\u0631\u06cc\u06ba\u06d4"
