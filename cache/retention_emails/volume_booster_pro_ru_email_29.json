{
  "subject": "68 \u0434\u043d\u0435\u0439 \u0441 \u0432\u0430\u043c\u0438 \u2014 \u0432\u043e\u0442 \u0447\u0442\u043e \u0432\u044b \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u043b\u0438",
  "preview_text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u0434\u043e\u0432\u0435\u0440\u0438\u0435. \u041e\u0442\u043a\u0440\u044b\u0432\u0430\u044e \u0434\u0432\u0435\u0440\u044c, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0432\u0438\u0434\u044f\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0435, \u043a\u0442\u043e \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u043d\u0430\u0434\u043e\u043b\u0433\u043e.",
  "body_paragraphs": [
    "\u0412\u044b \u0437\u0434\u0435\u0441\u044c \u0443\u0436\u0435 68 \u0434\u043d\u0435\u0439. \u042d\u0442\u043e \u043c\u043d\u043e\u0433\u043e \u0434\u043b\u044f \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0433\u0440\u043e\u043c\u0447\u0435. \u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u0443\u0445\u043e\u0434\u044f\u0442 \u043d\u0430 \u0432\u0442\u043e\u0440\u043e\u0439 \u043d\u0435\u0434\u0435\u043b\u0435 \u2014 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u044e\u0442\u0441\u044f, \u0437\u0430\u0431\u044b\u0432\u0430\u044e\u0442, \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u0441\u044f. \u041d\u043e \u0432\u044b \u043e\u0441\u0442\u0430\u043b\u0438\u0441\u044c. \u0418 \u044f \u0445\u043e\u0447\u0443 \u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0441\u043f\u0430\u0441\u0438\u0431\u043e.",
    "\u041d\u0435 \u0437\u0430 \u0434\u0435\u043d\u044c\u0433\u0438. \u0417\u0430 \u0442\u043e, \u0447\u0442\u043e \u0434\u0430\u043b\u0438 \u0448\u0430\u043d\u0441 \u0442\u0438\u0445\u043e\u0439 \u0443\u0442\u0438\u043b\u0438\u0442\u0435 \u0431\u0435\u0437 \u0440\u0435\u043a\u043b\u0430\u043c\u044b, \u0431\u0435\u0437 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439, \u0431\u0435\u0437 \u0432\u0441\u0435\u0433\u043e \u043b\u0438\u0448\u043d\u0435\u0433\u043e. \u0412\u044b \u2014 \u0442\u0435, \u0434\u043b\u044f \u043a\u043e\u0433\u043e \u043c\u044b \u0443\u0431\u0440\u0430\u043b\u0438 \u0432\u0441\u0451, \u043a\u0440\u043e\u043c\u0435 \u043f\u043e\u043b\u0437\u0443\u043d\u043a\u0430 \u0438 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440\u0430. \u0422\u0435, \u043a\u0442\u043e \u0437\u043d\u0430\u0435\u0442: \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0434\u043e\u043b\u0436\u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c, \u043a\u043e\u0433\u0434\u0430 \u043d\u0443\u0436\u043d\u043e, \u0438 \u043c\u043e\u043b\u0447\u0430\u0442\u044c, \u043a\u043e\u0433\u0434\u0430 \u043d\u0435\u0442.",
    "\u0414\u043b\u044f \u0432\u0430\u0441 \u2014 \u0442\u043e, \u0447\u0435\u0433\u043e \u043d\u0435\u0442 \u0432 \u043e\u0431\u0449\u0435\u043c \u0434\u043e\u0441\u0442\u0443\u043f\u0435: \u0441\u043a\u0440\u044b\u0442\u044b\u0439 \u0440\u0435\u0436\u0438\u043c \u00ab\u0442\u0438\u0445\u0438\u0439 \u0431\u0443\u0441\u0442\u0435\u0440\u00bb. \u041e\u043d \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0435\u0442 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u043d\u0430 200% \u043f\u0440\u0438 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u043e\u0432, \u043d\u043e \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043d\u0438 \u043e\u0434\u043d\u043e\u0439 \u0438\u043a\u043e\u043d\u043a\u0438. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0439. \u041f\u0440\u043e\u0441\u0442\u043e \u0437\u0432\u0443\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0435\u0441\u0442\u044c. \u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0435\u0433\u043e \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445 \u2014 \u043e\u043d \u0436\u0434\u0430\u043b \u0432\u0430\u0441.",
    "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u043d\u0430\u0439\u0434\u0438\u0442\u0435 \u00ab\u0422\u0438\u0445\u0438\u0439 \u0431\u0443\u0441\u0442\u0435\u0440\u00bb \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a. \u042d\u0442\u043e \u043f\u043e\u0434\u0430\u0440\u043e\u043a \u0442\u0435\u043c, \u043a\u0442\u043e \u0441 \u043d\u0430\u043c\u0438 \u0442\u0430\u043a \u0434\u043e\u043b\u0433\u043e.",
    "P.S. \u0415\u0441\u043b\u0438 \u0432\u044b \u0435\u0449\u0451 \u043d\u0435 \u043f\u0440\u043e\u0431\u043e\u0432\u0430\u043b\u0438 \u043f\u0440\u0435\u043c\u0438\u0443\u043c \u2014 \u0441\u0435\u0439\u0447\u0430\u0441 \u0441\u0430\u043c\u043e\u0435 \u0432\u0440\u0435\u043c\u044f. \u041f\u0435\u0440\u0432\u0430\u044f \u043d\u0435\u0434\u0435\u043b\u044f \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e, \u0438 \u0432\u044b \u0443\u0432\u0438\u0434\u0438\u0442\u0435, \u043a\u0430\u043a \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0431\u0435\u0437 \u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0438\u0441\u0441\u043e\u0432."
  ],
