{
  "subject": "\u0422\u044b \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043d\u043e\u0432\u0438\u0447\u043e\u043a \u2014 \u0447\u0442\u043e \u0434\u0430\u043b\u044c\u0448\u0435?",
  "preview_text": "\u0422\u044b \u043f\u0440\u043e\u0448\u0435\u043b 45 \u0434\u043d\u0435\u0439. \u0422\u0435\u043f\u0435\u0440\u044c \u0432\u044b\u0431\u0435\u0440\u0438 \u0441\u0432\u043e\u0439 \u043f\u0443\u0442\u044c: \u0441\u0442\u0430\u0442\u044c \u043f\u0440\u043e\u0444\u0438 \u0438\u043b\u0438 \u043e\u0441\u0442\u0430\u0442\u044c\u0441\u044f \u0432 \u0442\u043e\u043b\u043f\u0435.",
  "body_paragraphs": [
    "\u041f\u0440\u043e\u0448\u043b\u043e 45 \u0434\u043d\u0435\u0439 \u0441 \u0442\u0435\u0445 \u043f\u043e\u0440, \u043a\u0430\u043a \u0442\u044b \u0441\u043a\u0430\u0447\u0430\u043b Predictify. \u0422\u044b \u0443\u0436\u0435 \u043d\u0435 \u0442\u043e\u0442 \u043d\u043e\u0432\u0438\u0447\u043e\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0433\u0430\u0434\u044b\u0432\u0430\u043b \u0438\u0441\u0445\u043e\u0434\u044b. \u0422\u044b \u0432\u0438\u0434\u0435\u043b, \u043a\u0430\u043a AI \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0435\u0442 xG, \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u0435 \u043c\u044f\u0447\u043e\u043c \u0438 \u0437\u0430\u0449\u0438\u0442\u043d\u044b\u0435 \u043b\u0438\u043d\u0438\u0438. \u0422\u044b \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0440\u0430\u0437\u043d\u0438\u0446\u0443 \u043c\u0435\u0436\u0434\u0443 \u00ab\u043c\u043d\u0435 \u043a\u0430\u0436\u0435\u0442\u0441\u044f\u00bb \u0438 \u00ab\u0434\u0430\u043d\u043d\u044b\u0435 \u0433\u043e\u0432\u043e\u0440\u044f\u0442\u00bb. \u041d\u043e \u044d\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0447\u0430\u043b\u043e \u2014 \u0441\u0430\u043c\u043e\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e\u0435 \u0432\u043f\u0435\u0440\u0435\u0434\u0438.",
    "\u0422\u0435\u043f\u0435\u0440\u044c \u043f\u0435\u0440\u0435\u0434 \u0442\u043e\u0431\u043e\u0439 \u0432\u044b\u0431\u043e\u0440. \u041e\u0441\u0442\u0430\u0442\u044c\u0441\u044f casual-\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u043d\u043e\u0433\u0434\u0430 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0438\u043b\u0438 \u0432\u043e\u0439\u0442\u0438 \u0432 \u044d\u043b\u0438\u0442\u0443 \u2014 \u0442\u0435\u0445, \u043a\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u043f\u0440\u0435\u043c\u0438\u0443\u043c-\u043f\u0440\u043e\u0433\u043d\u043e\u0437\u044b, \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442 \u0432 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430\u0445 \u0438 \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u0432 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0435 IQ Quiz. \u041f\u043e\u043c\u043d\u0438: \u043a\u0430\u0436\u0434\u044b\u0439 \u043c\u0430\u0442\u0447 \u2014 \u044d\u0442\u043e \u0448\u0430\u043d\u0441 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e \u0442\u044b \u0443\u043c\u043d\u0435\u0435 \u0442\u043e\u043b\u043f\u044b. \u0418 \u0434\u0430\u043d\u043d\u044b\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043d\u0430 \u0442\u0432\u043e\u0435\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u0435.",
    "\u0412\u043e\u0442 \u0447\u0442\u043e \u0436\u0434\u0435\u0442 \u0442\u0435\u0445, \u043a\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0448\u0430\u0433: \u043d\u0435\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u044b AI \u0441 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u043e 90%, \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u0442\u043e\u0439 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0435 (xG, \u043e\u0436\u0438\u0434\u0430\u0435\u043c\u044b\u0435 \u0433\u043e\u043b\u044b, \u0442\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u0430\u0440\u0442\u044b) \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0431\u0440\u043e\u0441\u0438\u0442\u044c \u0432\u044b\u0437\u043e\u0432 AI \u0432 IQ Quiz. \u0410 \u0441 \u043f\u0440\u0435\u043c\u0438\u0443\u043c-\u0434\u043e\u0441\u0442\u0443\u043f\u043e\u043c \u0437\u0430 12,99$ \u0432 \u043c\u0435\u0441\u044f\u0446 (3 \u0434\u043d\u044f \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e) \u0442\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0448\u044c \u0432\u0441\u0435 \u044d\u0442\u043e \u0431\u0435\u0437 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0439. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 \u0441\u043e\u043c\u043d\u0435\u043d\u0438\u0439 \u2014 \u0442\u043e\u043b\u044c\u043a\u043e \u0444\u0430\u043a\u0442\u044b.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Predictify \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044c \u0441\u0432\u043e\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u043d\u0430 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0438\u0439 \u043c\u0430\u0442\u0447. \u041f\u043e\u043a\u0430\u0436\u0438, \u0447\u0442\u043e \u0442\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043c\u043e\u0442\u0440\u0438\u0448\u044c \u0444\u0443\u0442\u0431\u043e\u043b \u2014 \u0442\u044b \u0435\u0433\u043e \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0448\u044c. P.S. \u0422\u0432\u043e\u0439 \u0434\u043d\u0435\u0432\u043d\u043e\u0439 \u0441\u0442\u0440\u0438\u043a \u0441\u043a\u043e\u0440\u043e \u0441\u0433\u043e\u0440\u0438\u0442 \u2014 \u043d\u0435 \u043f\u043e\u0442\u0435\u0440\u044f\u0439 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f, \u0437\u0430\u0439\u0434\u0438 \u0438 \u043f\u0440\u043e\u0434\u043b\u0438 \u0435\u0433\u043e."
  ],
