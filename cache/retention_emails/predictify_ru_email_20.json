{
  "subject": "\u0422\u044b \u0443\u0436\u0435 \u043d\u0435 \u043d\u043e\u0432\u0438\u0447\u043e\u043a \u2014 \u0432\u043e\u0442 \u0447\u0442\u043e \u0434\u0430\u043b\u044c\u0448\u0435",
  "preview_text": "45 \u0434\u043d\u0435\u0439 \u0441 Predictify \u2014 \u0442\u044b \u043f\u0440\u043e\u0448\u0435\u043b \u043f\u0443\u0442\u044c. \u0422\u0435\u043f\u0435\u0440\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e. \u0423\u0437\u043d\u0430\u0439, \u0447\u0442\u043e \u0436\u0434\u0435\u0442 \u0442\u0435\u0431\u044f \u0432\u043f\u0435\u0440\u0435\u0434\u0438.",
  "body_paragraphs": [
    "45 \u0434\u043d\u0435\u0439 \u043d\u0430\u0437\u0430\u0434 \u0442\u044b \u0441\u043a\u0430\u0447\u0430\u043b Predictify, \u0434\u0443\u043c\u0430\u044f, \u0447\u0442\u043e \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u043e\u0432. \u0422\u044b \u043e\u0448\u0438\u0431\u0430\u043b\u0441\u044f \u2014 \u0438 \u044f \u0440\u0430\u0434, \u0447\u0442\u043e \u0442\u044b \u044d\u0442\u043e \u043f\u043e\u043d\u044f\u043b. \u0422\u044b \u0443\u0436\u0435 \u043d\u0435 \u043d\u043e\u0432\u0438\u0447\u043e\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0433\u0430\u0434\u0430\u0435\u0442 \u043d\u0430 \u043a\u043e\u0444\u0435\u0439\u043d\u043e\u0439 \u0433\u0443\u0449\u0435. \u0422\u044b \u2014 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0437\u043d\u0430\u0435\u0442, \u0447\u0442\u043e xG \u0432\u044b\u0448\u0435 1.5 \u0432 \u043c\u0430\u0442\u0447\u0435 \u00ab\u041b\u0438\u0432\u0435\u0440\u043f\u0443\u043b\u044f\u00bb \u043f\u0440\u043e\u0442\u0438\u0432 \u00ab\u042d\u0432\u0435\u0440\u0442\u043e\u043d\u0430\u00bb \u2014 \u044d\u0442\u043e \u043d\u0435 \u0443\u0434\u0430\u0447\u0430, \u0430 \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044c.",
    "\u041f\u043e\u043c\u043d\u0438\u0448\u044c, \u043a\u0430\u043a \u0442\u044b \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u043e\u0442\u043a\u0440\u044b\u043b \u0440\u0430\u0437\u0434\u0435\u043b \u0441 \u0440\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0435\u043c \u0438 \u043f\u0440\u043e\u043b\u0438\u0441\u0442\u0430\u043b 50 \u043b\u0438\u0433? \u0418\u043b\u0438 \u043a\u0430\u043a \u0442\u0432\u043e\u0439 \u043f\u0435\u0440\u0432\u044b\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u043f\u043e \u00ab\u0411\u0430\u0440\u0441\u0435\u043b\u043e\u043d\u0435\u00bb \u0441 confidence score 85% \u0437\u0430\u043b\u0435\u0442\u0435\u043b, \u0438 \u0442\u044b \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0441\u0435\u0431\u044f \u0433\u0435\u043d\u0438\u0435\u043c? \u042d\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0447\u0430\u043b\u043e. \u0422\u044b \u0443\u0436\u0435 \u043f\u0440\u043e\u0448\u0435\u043b \u044d\u0442\u0430\u043f \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u2014 \u0442\u0435\u043f\u0435\u0440\u044c \u043f\u0440\u0438\u0448\u043b\u043e \u0432\u0440\u0435\u043c\u044f \u0441\u0442\u0430\u0442\u044c \u0447\u0430\u0441\u0442\u044c\u044e \u0447\u0435\u0433\u043e-\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0435\u0433\u043e.",
    "\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 IQ Quiz \u2014 \u0431\u0440\u043e\u0441\u044c \u0432\u044b\u0437\u043e\u0432 AI \u0438 \u043f\u043e\u043a\u0430\u0436\u0438, \u043a\u0442\u043e \u0442\u0443\u0442 \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0437\u043d\u0430\u0442\u043e\u043a \u0444\u0443\u0442\u0431\u043e\u043b\u0430. \u0418\u043b\u0438 \u0437\u0430\u0439\u0434\u0438 \u0432 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430: \u0442\u0430\u043c \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u044e\u0442 Prediction of the Day, \u0438 \u0442\u0432\u043e\u0439 \u0433\u043e\u043b\u043e\u0441 \u043c\u043e\u0436\u0435\u0442 \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0440\u0430\u0441\u043a\u043b\u0430\u0434. \u0422\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u2014 \u0442\u044b \u043d\u0430\u0448 \u0430\u043c\u0431\u0430\u0441\u0441\u0430\u0434\u043e\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u0435\u0442 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u0432\u043e\u0435\u0439 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u043e\u0439 \u0438 \u0438\u043d\u0442\u0443\u0438\u0446\u0438\u0435\u0439.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Predictify \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u0432\u044b\u0431\u0435\u0440\u0438 \u043e\u0434\u0438\u043d \u043c\u0430\u0442\u0447 \u043d\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f. \u041f\u0440\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0439 \u0435\u0433\u043e, \u043f\u043e\u0441\u0442\u0430\u0432\u044c \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0438 \u043f\u043e\u0434\u0435\u043b\u0438\u0441\u044c \u0438\u043c \u0432 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435. P.S. \u0422\u0432\u043e\u044f \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u0430\u044f \u0441\u0435\u0440\u0438\u044f \u0443\u0436\u0435 \u043d\u0430 7-\u043c \u0434\u043d\u0435 \u2014 \u043d\u0435 \u0434\u0430\u0439 \u0435\u0439 \u0441\u0433\u043e\u0440\u0435\u0442\u044c. \u041d\u043e\u0432\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u0436\u0434\u0443\u0442 \u0442\u0435\u0445, \u043a\u0442\u043e \u043d\u0435 \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f."
