{
  "subject": "\u0422\u0438 \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435 \u043d\u043e\u0432\u0430\u0447\u043e\u043a \u2014 \u043e\u0441\u044c \u0449\u043e \u0434\u0430\u043b\u0456",
  "preview_text": "45 \u0434\u043d\u0456\u0432 \u0442\u043e\u043c\u0443 \u0442\u0438 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0432 Predictify. \u0422\u0435\u043f\u0435\u0440 \u0447\u0430\u0441 \u0434\u0456\u0437\u043d\u0430\u0442\u0438\u0441\u044f, \u0449\u043e \u043f\u0440\u0438\u0445\u043e\u0432\u0443\u044e\u0442\u044c \u0442\u0432\u043e\u0457 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438.",
  "body_paragraphs": [
    "\u0422\u0438 \u0432\u0436\u0435 45 \u0434\u043d\u0456\u0432 \u0437 \u043d\u0430\u043c\u0438, \u0456 \u0446\u0435 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0446\u0438\u0444\u0440\u0430. \u0422\u0438 \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0442\u0438\u043a\u0430\u0432 \u043f\u0430\u043b\u044c\u0446\u0435\u043c \u0443 \u043d\u0435\u0431\u043e, \u043a\u043e\u043b\u0438 \u0441\u0442\u0430\u0432\u0438\u0432 \u043d\u0430 \u043c\u0430\u0442\u0447. \u0422\u0438 \u043f\u043e\u0447\u0430\u0432 \u0431\u0430\u0447\u0438\u0442\u0438 \u0433\u0440\u0443 \u0456\u043d\u0430\u043a\u0448\u0435 \u2014 \u0447\u0435\u0440\u0435\u0437 xG, \u0432\u043e\u043b\u043e\u0434\u0456\u043d\u043d\u044f \u043c'\u044f\u0447\u0435\u043c, \u0441\u043b\u0430\u0431\u043a\u0456 \u0441\u0442\u043e\u0440\u043e\u043d\u0438 \u0441\u0443\u043f\u0435\u0440\u043d\u0438\u043a\u0430. \u0410\u043b\u0435 \u0454 \u043e\u0434\u043d\u0430 \u0440\u0456\u0447, \u044f\u043a\u0443 90% \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u044e\u0442\u044c, \u0456 \u0446\u0435 \u043a\u043e\u0448\u0442\u0443\u0454 \u0457\u043c \u0441\u043f\u0440\u0430\u0432\u0436\u043d\u0456\u0445 \u0456\u043d\u0441\u0430\u0439\u0442\u0456\u0432.",
    "\u0421\u043f\u0440\u0430\u0432\u0430 \u0432 \u0442\u043e\u043c\u0443, \u0449\u043e \u0434\u0430\u043d\u0456 \u0431\u0435\u0437 \u0434\u0456\u0457 \u2014 \u043f\u0440\u043e\u0441\u0442\u043e \u0448\u0443\u043c. \u0422\u0438 \u043c\u0456\u0433 \u043f\u043e\u043c\u0456\u0442\u0438\u0442\u0438, \u044f\u043a AI \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0454 \u0442\u0438\u0441\u044f\u0447\u0456 \u0437\u043c\u0456\u043d\u043d\u0438\u0445 \u0437\u0430 \u043c\u0430\u0442\u0447, \u0430\u043b\u0435 \u0447\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0432 \u0442\u0438 \u0446\u0435, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0441\u0432\u043e\u044e \u0444\u0443\u0442\u0431\u043e\u043b\u044c\u043d\u0443 \u0456\u043d\u0442\u0443\u0457\u0446\u0456\u044e? \u0404 \u043e\u0434\u0438\u043d \u0442\u0435\u0441\u0442, \u044f\u043a\u0438\u0439 \u0437\u043c\u0456\u043d\u044e\u0454 \u0432\u0441\u0435 \u2014 \u0456 \u0432\u0456\u043d \u0443\u0436\u0435 \u0447\u0435\u043a\u0430\u0454 \u043d\u0430 \u0442\u0435\u0431\u0435 \u0432 \u0434\u043e\u0434\u0430\u0442\u043a\u0443.",
    "\u0417\u0430\u0431\u0443\u0434\u044c \u043f\u0440\u043e \u043f\u0430\u0441\u0438\u0432\u043d\u0435 \u0447\u0438\u0442\u0430\u043d\u043d\u044f \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0456\u0432. \u041d\u0430\u0448 IQ Quiz \u2014 \u0446\u0435 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0433\u0440\u0430, \u0446\u0435 \u0432\u0438\u043a\u043b\u0438\u043a. \u0422\u0438 \u0437\u043c\u0430\u0433\u0430\u0454\u0448\u0441\u044f \u0437 AI, \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u0454\u0448 \u0441\u0432\u043e\u0457 \u0437\u043d\u0430\u043d\u043d\u044f \u043f\u0440\u043e \u043b\u0456\u0433\u0438, \u0433\u0440\u0430\u0432\u0446\u0456\u0432, \u0442\u0430\u043a\u0442\u0438\u043a\u0443. \u0429\u043e\u0440\u0430\u0437\u0443, \u043a\u043e\u043b\u0438 \u0442\u0438 \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454\u0448 \u0434\u043e\u0434\u0430\u0442\u043e\u043a, \u0442\u0438 \u0441\u0442\u0430\u0454\u0448 \u0440\u043e\u0437\u0443\u043c\u043d\u0456\u0448\u0438\u043c \u0437\u0430 90% \u0444\u0430\u043d\u0430\u0442\u0456\u0432. \u0406 \u0446\u0435 \u043d\u0435 \u0445\u0432\u0430\u0441\u0442\u043e\u0449\u0456 \u2014 \u0446\u0435 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430.",
    "\u0412\u0456\u0434\u043a\u0440\u0438\u0439 Predictify \u0437\u0430\u0440\u0430\u0437, \u0437\u043d\u0430\u0439\u0434\u0438 \u0432\u043a\u043b\u0430\u0434\u043a\u0443 IQ Quiz \u0456 \u0434\u043e\u0432\u0435\u0434\u0438, \u0449\u043e \u0442\u0438 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0431\u043e\u043b\u0456\u0432\u0430\u043b\u044c\u043d\u0438\u043a, \u0430 \u0441\u043f\u0440\u0430\u0432\u0436\u043d\u0456\u0439 \u0430\u043d\u0430\u043b\u0456\u0442\u0438\u043a. P.S. \u0422\u0438 \u0432\u0436\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0432 3 \u0434\u043d\u0456 \u043f\u043e\u0441\u043f\u0456\u043b\u044c? \u041f\u043e\u0432\u0435\u0440\u043d\u0438 \u0441\u0442\u0440\u0438\u043a \u2014 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0456 \u043a\u0440\u0435\u0434\u0438\u0442\u0438 \u0447\u0435\u043a\u0430\u044e\u0442\u044c."
  ],
