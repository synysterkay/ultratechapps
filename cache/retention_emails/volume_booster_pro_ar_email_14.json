{
  "subject": "30 \u064a\u0648\u0645\u0627\u064b \u0645\u0639 500 \u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u062b\u0644\u0643",
  "preview_text": "\u0623\u0646\u062a \u0627\u0644\u0622\u0646 \u062c\u0632\u0621 \u0645\u0646 \u0645\u062c\u0645\u0648\u0639\u0629 \u062a\u062e\u062a\u0627\u0631 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0646\u0638\u064a\u0641. \u0645\u062c\u062a\u0645\u0639 \u064a\u0631\u0641\u0636 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0641\u064a \u062a\u0637\u0628\u064a\u0642 \u064a\u0648\u0645\u064a.",
  "body_paragraphs": [
    "\u0642\u0628\u0644 30 \u064a\u0648\u0645\u0627\u064b\u060c \u062d\u0645\u0644\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u0631\u0628\u0645\u0627 \u0643\u0646\u062a \u062a\u0628\u062d\u062b \u0639\u0646 \u062d\u0644 \u0628\u0633\u064a\u0637: \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u062f\u0648\u0646 \u0641\u0648\u0627\u0635\u0644 \u0625\u0639\u0644\u0627\u0646\u064a\u0629. \u0623\u0646\u062a \u0644\u0633\u062a \u0648\u062d\u062f\u0643. \u0647\u0646\u0627\u0643 500 \u0645\u0633\u062a\u062e\u062f\u0645 \u0622\u062e\u0631\u064a\u0646 \u064a\u0641\u0639\u0644\u0648\u0646 \u0627\u0644\u0634\u064a\u0621 \u0646\u0641\u0633\u0647 \u0643\u0644 \u064a\u0648\u0645.",
    "\u0647\u0630\u0627 \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u062a\u0637\u0628\u064a\u0642. \u0625\u0646\u0647 \u062a\u062d\u0648\u0644 \u0635\u063a\u064a\u0631 \u0641\u064a \u0637\u0631\u064a\u0642\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0643 \u0644\u0644\u0635\u0648\u062a. \u0623\u0646\u062a \u062a\u062e\u062a\u0627\u0631 \u0627\u0644\u0647\u062f\u0648\u0621 \u0641\u064a \u0639\u0627\u0644\u0645 \u0645\u0644\u064a\u0621 \u0628\u0627\u0644\u0636\u062c\u064a\u062c. \u0643\u0644 \u0645\u0631\u0629 \u062a\u0641\u062a\u062d \u0627\u0644\u0634\u0631\u064a\u0637 \u0648\u062a\u0636\u0628\u0637\u0647\u060c \u0623\u0646\u062a \u062a\u0624\u0643\u062f: \u0623\u0646\u0627 \u0623\u0631\u0641\u0636 \u0627\u0644\u0625\u0632\u0639\u0627\u062c.",
    "\u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u062a\u064a \u062a\u062c\u0645\u0639\u0646\u0627: \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u064a\u0637\u0628\u0642 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0639\u0646\u062f \u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a. \u0628\u062f\u0648\u0646 \u0646\u0642\u0631\u0627\u062a\u060c \u0628\u062f\u0648\u0646 \u0625\u0634\u0639\u0627\u0631\u0627\u062a. \u0645\u062c\u0631\u062f \u0635\u0648\u062a \u0646\u0642\u064a \u064a\u0628\u062f\u0623 \u0645\u0646 \u062d\u064a\u062b \u062a\u0648\u0642\u0641\u062a. \u0647\u0630\u0627 \u0645\u0627 \u064a\u0641\u0639\u0644\u0647 80% \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0646\u0634\u0637\u064a\u0646 \u064a\u0648\u0645\u064a\u0627\u064b.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646. \u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0648\u0641\u0639\u0651\u0644 '\u062a\u0637\u0628\u064a\u0642 \u062a\u0644\u0642\u0627\u0626\u064a \u0639\u0646\u062f \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a'. \u0623\u0646\u062a \u0627\u0644\u0622\u0646 \u062c\u0632\u0621 \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u062a\u063a\u064a\u064a\u0631. P.S. \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u0641\u0639\u0644\u0648\u0627 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 3 \u0645\u0631\u0627\u062a \u0623\u0633\u0628\u0648\u0639\u064a\u0627\u064b \u0623\u0643\u062b\u0631 \u0645\u0646 \u063a\u064a\u0631\u0647\u0645."
  ],
