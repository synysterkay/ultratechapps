{
  "subject": "\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0410\u043b\u0435\u043a\u0441\u0435\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u043d\u0430\u0441 \u0437\u0430\u043c\u0435\u0440\u0435\u0442\u044c",
  "preview_text": "\u041e\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043d\u0430\u043c \u0432 3 \u0443\u0442\u0440\u0430. \u041c\u044b \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b\u0438. \u0418 \u043f\u043e\u043d\u044f\u043b\u0438, \u0447\u0442\u043e \u0432\u0441\u0451 \u043d\u0435 \u0437\u0440\u044f.",
  "body_paragraphs": [
    "\u0422\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u0434\u043d\u044f \u043d\u0430\u043c \u043f\u0440\u0438\u0448\u043b\u043e \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435. 3:14 \u0443\u0442\u0440\u0430. \u041f\u0430\u0440\u0435\u043d\u044c \u043f\u043e \u0438\u043c\u0435\u043d\u0438 \u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u043d\u0430\u043f\u0438\u0441\u0430\u043b: \u00ab\u042f \u0443\u0441\u043b\u044b\u0448\u0430\u043b \u0431\u0430\u0441, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043d\u0435 \u0431\u044b\u043b\u043e 10 \u043b\u0435\u0442\u00bb. \u041e\u043d \u0441\u043b\u0443\u0448\u0430\u043b \u0442\u0440\u0435\u043a \u043d\u0430 \u0441\u0432\u043e\u0438\u0445 \u0434\u0435\u0448\u0451\u0432\u044b\u0445 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u0445 \u2014 \u0438 \u0432\u0434\u0440\u0443\u0433 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0443\u0434\u0430\u0440 \u0432 \u0433\u0440\u0443\u0434\u0438. \u041d\u0435 \u0432 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430\u0445. \u0412 \u0433\u0440\u0443\u0434\u0438. \u041c\u044b \u043f\u0435\u0440\u0435\u0447\u0438\u0442\u044b\u0432\u0430\u043b\u0438 \u044d\u0442\u043e \u0440\u0430\u0437 \u0434\u0435\u0441\u044f\u0442\u044c.",
    "\u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u2014 \u043d\u0435 \u0430\u0443\u0434\u0438\u043e\u0444\u0438\u043b. \u041e\u043d \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0441\u0442\u0430\u043b \u043e\u0442 \u043f\u043b\u043e\u0441\u043a\u043e\u0433\u043e \u0437\u0432\u0443\u043a\u0430. Hip-Hop \u0434\u043e\u043b\u0436\u0435\u043d \u043a\u0430\u0447\u0430\u0442\u044c, \u0430 \u043d\u0435 \u043f\u0438\u0449\u0430\u0442\u044c. \u041e\u043d \u043e\u0442\u043a\u0440\u044b\u043b Bass Booster, \u0432\u043a\u043b\u044e\u0447\u0438\u043b Bass Virtualizer \u0438 3D Surround \u2014 \u0438 \u0435\u0433\u043e \u043c\u0438\u0440 \u043f\u0435\u0440\u0435\u0432\u0435\u0440\u043d\u0443\u043b\u0441\u044f. \u00ab\u0422\u0435\u043f\u0435\u0440\u044c \u044f \u0441\u043b\u044b\u0448\u0443, \u043a\u0430\u043a \u0431\u0430\u0441-\u0431\u043e\u0447\u043a\u0430 \u0431\u044c\u0451\u0442 \u0432 \u0437\u0430\u0442\u044b\u043b\u043e\u043a\u00bb, \u2014 \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043e\u043d. \u041c\u044b \u043d\u0435 \u0448\u0443\u0442\u0438\u043c.",
    "\u042d\u0442\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u2014 \u043d\u0435 \u043f\u0440\u043e \u043d\u0430\u0441. \u041e\u043d\u0430 \u043f\u0440\u043e \u0442\u0435\u0431\u044f. \u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043d\u0430\u0436\u043c\u0438 \u00abBass Virtualizer\u00bb \u0438 \u0432\u0440\u0443\u0431\u0438 \u043b\u044e\u0431\u043e\u0439 \u0442\u0440\u0435\u043a \u0441 \u043f\u043b\u043e\u0442\u043d\u044b\u043c \u043d\u0438\u0437\u043e\u043c. \u041f\u043e\u0442\u044f\u043d\u0438 Boost-\u0441\u043b\u0430\u0439\u0434\u0435\u0440 \u0432\u043f\u0440\u0430\u0432\u043e. \u041f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0439 \u0440\u0430\u0437\u043d\u0438\u0446\u0443. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u043f\u043e\u043b\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u2014 Premium \u0434\u0430\u0451\u0442 \u043d\u0435\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0439 \u0431\u0443\u0441\u0442 \u0438 10-\u043f\u043e\u043b\u043e\u0441\u043d\u044b\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440. \u041d\u043e \u0434\u0430\u0436\u0435 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e \u0442\u044b \u0443\u0441\u043b\u044b\u0448\u0438\u0448\u044c \u0442\u043e, \u0447\u0435\u0433\u043e \u0440\u0430\u043d\u044c\u0448\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Bass Booster \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u0412\u043a\u043b\u044e\u0447\u0438 \u0442\u0440\u0435\u043a, \u0433\u0434\u0435 \u0432\u0430\u0436\u0435\u043d \u0431\u0430\u0441. \u0418 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043b\u0443\u0448\u0430\u0439. P.S. \u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0437\u0430 \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0435 \u0432\u044b\u043a\u043b\u044e\u0447\u0438\u043b \u0442\u0440\u0435\u043a \u043d\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0435. \u041d\u0430\u0434\u0435\u0435\u043c\u0441\u044f, \u0442\u044b \u0442\u043e\u0436\u0435."
  ],
