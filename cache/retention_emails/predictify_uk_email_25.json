{
  "subject": "25-\u0439 \u0434\u0435\u043d\u044c \u043f\u0456\u0441\u043b\u044f \u0440\u0435\u0454\u0441\u0442\u0440\u0430\u0446\u0456\u0457: \u043d\u0435\u0441\u043f\u043e\u0434\u0456\u0432\u0430\u043d\u0438\u0439 \u0441\u043f\u043e\u0441\u0456\u0431 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Predictify",
  "preview_text": "\u042f \u043d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u043e\u0447\u0456\u043a\u0443\u0432\u0430\u0432, \u0449\u043e \u0445\u0442\u043e\u0441\u044c \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0454 \u043d\u0430\u0448 \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0442\u0430\u043a. \u0410\u043b\u0435 \u043e\u0434\u0438\u043d \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447 \u0437\u0434\u0438\u0432\u0443\u0432\u0430\u0432 \u043d\u0430\u0432\u0456\u0442\u044c \u043d\u0430\u0448\u0443 \u043a\u043e\u043c\u0430\u043d\u0434\u0443.",
  "body_paragraphs": [
    "\u041c\u0438\u043d\u0443\u043b\u043e\u0433\u043e \u0442\u0438\u0436\u043d\u044f \u044f \u043e\u0442\u0440\u0438\u043c\u0430\u0432 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u0432\u0456\u0434 \u0445\u043b\u043e\u043f\u0446\u044f \u0437 \u041d\u0456\u043c\u0435\u0447\u0447\u0438\u043d\u0438. \u0412\u0456\u043d \u043d\u0430\u043f\u0438\u0441\u0430\u0432: '\u042f \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e Predictify \u043d\u0435 \u0434\u043b\u044f \u0441\u0442\u0430\u0432\u043e\u043a, \u0430 \u0434\u043b\u044f \u0441\u0443\u043f\u0435\u0440\u0435\u0447\u043e\u043a \u0437 \u0442\u0430\u0442\u043e\u043c \u0449\u043e\u043d\u0435\u0434\u0456\u043b\u0456.' \u0421\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u044f \u043d\u0435 \u043f\u043e\u0432\u0456\u0440\u0438\u0432, \u0430\u043b\u0435 \u0432\u0456\u043d \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0432 \u0441\u043a\u0440\u0456\u043d\u0448\u043e\u0442\u0438. \u041a\u043e\u0436\u0435\u043d \u043c\u0430\u0442\u0447 \u0411\u0443\u043d\u0434\u0435\u0441\u043b\u0456\u0433\u0438 \u0432\u0456\u043d \u0437\u0430\u0437\u0434\u0430\u043b\u0435\u0433\u0456\u0434\u044c \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u0432 \u043d\u0430\u0448\u0456 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438, \u0430 \u043f\u043e\u0442\u0456\u043c \u0441\u043f\u0435\u0440\u0435\u0447\u0430\u0432\u0441\u044f \u0437 \u0431\u0430\u0442\u044c\u043a\u043e\u043c, \u0445\u0442\u043e \u043c\u0430\u0454 \u0440\u0430\u0446\u0456\u044e. \u0406 \u0432\u0456\u043d \u0432\u0438\u0433\u0440\u0430\u0432 8 \u0456\u0437 10 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u0445 \u0441\u0443\u043f\u0435\u0440\u0435\u0447\u043e\u043a.",
    "\u0426\u0435 \u0437\u043c\u0443\u0441\u0438\u043b\u043e \u043c\u0435\u043d\u0435 \u0437\u0430\u0434\u0443\u043c\u0430\u0442\u0438\u0441\u044f: \u043c\u0438 \u0441\u0442\u0432\u043e\u0440\u0438\u043b\u0438 Predictify \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 \u0434\u0430\u043d\u0438\u0445 \u0456 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0456\u0432, \u0430\u043b\u0435 \u0432\u0438\u044f\u0432\u0438\u043b\u043e\u0441\u044f, \u0449\u043e \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0439 \u0441\u043f\u043e\u0441\u0456\u0431 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u2014 \u0446\u0435 \u0434\u0456\u043b\u0438\u0442\u0438\u0441\u044f \u0437\u043d\u0430\u043d\u043d\u044f\u043c\u0438 \u0437 \u0434\u0440\u0443\u0437\u044f\u043c\u0438 \u0430\u0431\u043e \u0440\u043e\u0434\u0438\u043d\u043e\u044e. \u041a\u043e\u043b\u0438 \u0432\u0438 \u0431\u0430\u0447\u0438\u0442\u0435, \u0449\u043e AI \u0434\u0430\u0454 72% \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u043e\u0441\u0442\u0456 \u043d\u0430 \u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0443 '\u0411\u0430\u0432\u0430\u0440\u0456\u0457', \u0432\u0438 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u0435 \u0446\u0438\u0444\u0440\u0443 \u2014 \u0432\u0438 \u043e\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u0435 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442. \u0406 \u0446\u0435 \u043f\u0440\u0430\u0446\u044e\u0454 \u043d\u0430\u0432\u0456\u0442\u044c \u0434\u043b\u044f \u0442\u0438\u0445, \u0445\u0442\u043e \u043d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u0440\u043e\u0431\u0438\u0432 \u0441\u0442\u0430\u0432\u043e\u043a.",
    "\u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0441\u0430\u043c\u0456: \u0432\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u0434\u043e\u0434\u0430\u0442\u043e\u043a, \u0437\u043d\u0430\u0439\u0434\u0456\u0442\u044c \u043c\u0430\u0442\u0447 \u041b\u0456\u0433\u0438 \u0447\u0435\u043c\u043f\u0456\u043e\u043d\u0456\u0432 \u0446\u044c\u043e\u0433\u043e \u0442\u0438\u0436\u043d\u044f \u0456 \u043f\u043e\u0434\u0438\u0432\u0456\u0442\u044c\u0441\u044f \u043d\u0430 Confidence Score \u0431\u0456\u043b\u044f \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0443. \u041f\u043e\u0442\u0456\u043c \u0437\u0430\u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443\u0439\u0442\u0435 \u0434\u0440\u0443\u0433\u043e\u0432\u0456 \u0430\u0431\u043e \u043d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u0443 \u0447\u0430\u0442 \u0456 \u0441\u043a\u0430\u0436\u0456\u0442\u044c: '\u042f \u0437\u043d\u0430\u044e, \u0449\u043e \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456 \u0432\u0438\u0433\u0440\u0430\u0454 '\u041c\u0430\u043d \u0421\u0456\u0442\u0456' \u0437 81% \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u043e\u0441\u0442\u0456.' \u041f\u043e\u0431\u0430\u0447\u0438\u0442\u0435, \u044f\u043a \u0437\u043c\u0456\u043d\u0438\u0442\u044c\u0441\u044f \u0439\u043e\u0433\u043e \u043e\u0431\u043b\u0438\u0447\u0447\u044f. \u0426\u0435 \u043d\u0435 \u043f\u0440\u043e \u0433\u0440\u043e\u0448\u0456 \u2014 \u0446\u0435 \u043f\u0440\u043e \u0442\u0435, \u0449\u043e\u0431 \u0431\u0443\u0442\u0438 \u043d\u0430\u0439\u0440\u043e\u0437\u0443\u043c\u043d\u0456\u0448\u0438\u043c \u0444\u0430\u043d\u0430\u0442\u043e\u043c \u0443 \u043a\u0456\u043c\u043d\u0430\u0442\u0456.",
    "\u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 Predictify \u0437\u0430\u0440\u0430\u0437 \u0456 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438 \u043d\u0430 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456\u0448\u043d\u0456\u0439 \u043c\u0430\u0442\u0447. \u041f\u043e\u0442\u0456\u043c \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0439\u0442\u0435 \u043a\u043e\u0433\u043e\u0441\u044c \u043d\u0430 \u0441\u0443\u043f\u0435\u0440\u0435\u0447\u043a\u0443 \u2014 \u0456 \u043f\u043e\u0434\u0438\u0432\u0456\u0442\u044c\u0441\u044f, \u0445\u0442\u043e \u043c\u0430\u0454 \u0440\u0430\u0446\u0456\u044e. P.S. \u042f\u043a\u0449\u043e \u0432\u0438 \u0449\u0435 \u043d\u0435 \u043f\u0440\u043e\u0431\u0443\u0432\u0430\u043b\u0438 Premium, \u0437\u0430\u0440\u0430\u0437 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u0438\u0439 \u0447\u0430\u0441: 3-\u0434\u0435\u043d\u043d\u0438\u0439 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u0432\u0456\u0434\u043a\u0440\u0438\u0454 \u0432\u0441\u0456 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438 \u0442\u0430 \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0443 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443. \u0412\u0430\u0448 \u0442\u0430\u0442\u043e \u0449\u0435 \u043d\u0435 \u0437\u043d\u0430\u0454, \u0449\u043e \u0439\u043e\u0433\u043e \u0447\u0435\u043a\u0430\u0454."
  ],
