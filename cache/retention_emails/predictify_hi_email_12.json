{
  "subject": "\u090f\u0915 \u0917\u0932\u0924\u0940 \u091c\u094b 90% \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 (\u092e\u0948\u0902\u0928\u0947 \u092d\u0940 \u0915\u0940 \u0925\u0940)",
  "preview_text": "\u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u092b\u0940\u091a\u0930 \u0915\u094b \u092e\u0939\u0940\u0928\u094b\u0902 \u0924\u0915 \u0928\u091c\u0930\u0905\u0902\u0926\u093e\u091c \u0915\u093f\u092f\u093e\u0964 \u092b\u093f\u0930 \u090f\u0915 \u0926\u093f\u0928 \u0907\u0938\u0928\u0947 \u092e\u0947\u0930\u0940 \u092b\u0941\u091f\u092c\u0949\u0932 \u0938\u092e\u091d \u0939\u0940 \u092c\u0926\u0932 \u0926\u0940\u0964",
  "body_paragraphs": [
    "\u092e\u0947\u0930\u0947 \u090f\u0915 \u0926\u094b\u0938\u094d\u0924 \u0928\u0947 \u0915\u0939\u093e, '\u0924\u0947\u0930\u093e AI \u0924\u094b \u0939\u092e\u0947\u0936\u093e \u0917\u0932\u0924 \u0938\u093e\u092c\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964' \u092e\u0948\u0902 \u091a\u0941\u092a \u0930\u0939\u093e\u0964 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0935\u094b \u0938\u0939\u0940 \u0925\u093e\u0964 \u092e\u0948\u0902 \u0938\u093f\u0930\u094d\u092b \u092b\u093e\u0907\u0928\u0932 \u0938\u094d\u0915\u094b\u0930 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0926\u0947\u0916\u0915\u0930 \u092c\u0948\u0920 \u091c\u093e\u0924\u093e \u0925\u093e\u0964 \u091c\u0948\u0938\u0947 \u0915\u093f \u092e\u0948\u091a \u0915\u093e \u0928\u0924\u0940\u091c\u093e \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0928\u0902\u092c\u0930 \u0939\u0948\u0964 \u092c\u0947\u0935\u0915\u0942\u092b\u0940 \u0925\u0940\u0964",
    "\u092b\u093f\u0930 \u090f\u0915 \u0926\u093f\u0928, \u091a\u0948\u0902\u092a\u093f\u092f\u0902\u0938 \u0932\u0940\u0917 \u0915\u0947 \u092e\u0948\u091a \u0938\u0947 \u092a\u0939\u0932\u0947, \u092e\u0948\u0902\u0928\u0947 \u0935\u094b '\u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930' \u0935\u093e\u0932\u093e \u092c\u091f\u0928 \u0926\u092c\u093e \u0926\u093f\u092f\u093e\u0964 \u091c\u094b \u0939\u092e\u0947\u0936\u093e \u0928\u0940\u091a\u0947 \u091b\u0941\u092a\u093e \u0930\u0939\u0924\u093e \u0939\u0948\u0964 \u0909\u0938\u0928\u0947 \u0938\u094d\u0915\u094b\u0930 \u0915\u0947 \u0938\u093e\u0925-\u0938\u093e\u0925 \u0926\u093f\u0916\u093e\u092f\u093e: 'AI \u0915\u094b 78% \u092f\u0915\u0940\u0928 \u0939\u0948 \u0915\u093f \u0939\u094b\u092e \u091f\u0940\u092e \u091c\u0940\u0924\u0947\u0917\u0940, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0909\u0928\u0915\u093e \u0921\u093f\u092b\u0947\u0902\u0938\u093f\u0935 \u0938\u094d\u091f\u094d\u0930\u0947\u0902\u0925 \u0907\u0928\u0915\u0940 \u091f\u0949\u092a \u0938\u094d\u091f\u094d\u0930\u093e\u0907\u0915\u0930 \u0915\u0947 xG \u0938\u0947 40% \u091c\u094d\u092f\u093e\u0926\u093e \u0939\u0948\u0964' \u092f\u0947 \u0938\u093f\u0930\u094d\u092b \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0928\u0939\u0940\u0902 \u0925\u093e\u0964 \u092f\u0947 \u092a\u0942\u0930\u0940 \u0915\u0939\u093e\u0928\u0940 \u0925\u0940\u0964",
    "\u092f\u0947 Predictify \u0915\u093e \u0938\u092c\u0938\u0947 \u0917\u0939\u0930\u093e \u0930\u093e\u091c \u0939\u0948: \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930\u0964 \u092f\u0947 \u0906\u092a\u0915\u094b \u092c\u0924\u093e\u0924\u093e \u0939\u0948 \u0915\u093f AI \u0915\u093f\u0924\u0928\u093e \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u091f \u0939\u0948, \u0914\u0930 \u0915\u094d\u092f\u094b\u0902\u0964 \u092f\u0947 \u0938\u093f\u0930\u094d\u092b '3-1' \u0928\u0939\u0940\u0902 \u0915\u0939\u0924\u093e\u0964 \u092f\u0947 \u0915\u0939\u0924\u093e \u0939\u0948, '3-1, \u0914\u0930 \u092f\u0939\u093e\u0901 \u0939\u0948\u0902 \u0935\u094b 5 \u0921\u0947\u091f\u093e \u092a\u0949\u0907\u0902\u091f\u094d\u0938 \u091c\u093f\u0928\u0915\u0940 \u0935\u091c\u0939 \u0938\u0947\u0964' \u0907\u0938\u0928\u0947 \u092e\u0947\u0930\u0947 \u0932\u093f\u090f \u0917\u0947\u092e \u0926\u0947\u0916\u0928\u0947 \u0915\u093e \u0924\u0930\u0940\u0915\u093e \u092c\u0926\u0932 \u0926\u093f\u092f\u093e\u0964 \u0905\u092c \u092e\u0948\u0902 \u0926\u093e\u0935 \u0932\u0917\u093e\u0924\u093e \u0939\u0942\u0901 \u0924\u094b \u092a\u0942\u0930\u0947 \u0906\u0924\u094d\u092e\u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u0938\u0947\u0964",
    "\u0906\u091c \u0939\u0940 \u090f\u0915 \u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u092e\u0948\u091a \u0915\u093e \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930 \u0916\u094b\u0932\u094b\u0964 \u0926\u0947\u0916\u094b AI \u0915\u094d\u092f\u093e \u0915\u0939\u0924\u093e \u0939\u0948\u0964 \u092b\u0948\u0938\u0932\u093e \u0924\u0941\u092e \u0915\u0930\u0928\u093e\u0964 \u092c\u091f\u0928 \u0926\u092c\u093e\u0913 \u0914\u0930 \u0905\u0902\u0926\u0930 \u0915\u093e \u0930\u093e\u091c \u091c\u093e\u0928\u094b\u0964 P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939 \u092b\u0940\u091a\u0930 \u0914\u0930 \u092d\u0940 \u0917\u0939\u0930\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u2013 \u0939\u0930 \u0938\u094d\u091f\u0948\u091f \u0915\u0947 \u092a\u0940\u091b\u0947 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964 3-\u0926\u093f\u0928 \u0915\u093e \u091f\u094d\u0930\u093e\u092f\u0932 \u0932\u0947\u0915\u0930 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u094b, \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u092b\u094d\u0930\u0940\u0964"
  ],
