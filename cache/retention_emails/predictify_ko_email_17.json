{
  "subject": "\uc774 \uae30\ub2a5\uc744 3\ubd84\ub9cc \uc368\ubcf4\uc138\uc694, \uacb0\uacfc\uac00 \uc644\uc804 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4",
  "preview_text": "\ub300\ubd80\ubd84\uc758 \uc720\uc800\uac00 \ub193\uce58\ub294 3\ubd84 \ub8e8\ud2f4\uc774 Predictify\ub97c 10\ubc30 \ub354 \ud6a8\uacfc\uc801\uc73c\ub85c \ub9cc\ub4ed\ub2c8\ub2e4. \uc9c0\uae08 \ud655\uc778\ud558\uc138\uc694.",
  "body_paragraphs": [
    "\uc194\uc9c1\ud788 \ub9d0\ud560\uac8c\uc694. \uc571\uc744 \uae54\uc544\ub193\uace0\ub3c4 \uc81c\ub300\ub85c \ud65c\uc6a9 \ubabb \ud558\ub294 \ubd84\ub4e4\uc774 \ub108\ubb34 \ub9ce\uc544\uc694. \uc800\ub3c4 \ucc98\uc74c\uc5d4 \uadf8\ub7ac\uac70\ub4e0\uc694. \uadf8\ub7f0\ub370 \uc6b0\uc5f0\ud788 \ubc1c\uacac\ud55c 3\ubd84\uc9dc\ub9ac \ub8e8\ud2f4 \ud558\ub098\uac00 \uc81c \uc608\uce21 \uc801\uc911\ub960\uc744 \ud655 \uc62c\ub824\uc92c\uc5b4\uc694.",
    "\ub9e4\uc77c \uacbd\uae30 \uc2dc\uc791 \uc804, Predictify\uc5d0\uc11c AI \ubd84\uc11d \ubcf4\uace0\uc11c\ub97c 3\ubd84\ub9cc \ud6d1\uc5b4\ubcf4\ub294 \uac70\uc608\uc694. xG, \uc218\ube44 \uac15\ub3c4, \uc0c1\ub300 \uc804\uc801 \uac19\uc740 \ud575\uc2ec \ub370\uc774\ud130\ub97c \ubcf4\uba74 \uac10\uc5d0 \uc758\uc874\ud558\ub358 \ub54c\uc640 \ube44\uad50\uac00 \uc548 \ub3fc\uc694. \uc774\uac8c \uc2b5\uad00\uc774 \ub418\uba74, \ub354 \uc774\uc0c1 '\uc544 \uadf8\ub0e5 \uc774 \ud300\uc774 \uc774\uae30\uaca0\uc9c0' \ud558\uc9c0 \uc54a\uace0 \ub370\uc774\ud130\ub85c \uc2b9\ubd80\ub97c \uac78\uac8c \ub429\ub2c8\ub2e4.",
    "\uc0ac\uc2e4 \uc774\uac74 AI \ucc44\ud305 \uae30\ub2a5\uc774\ub791 \uc5f0\uacb0\ub418\ub294\ub370\uc694. '\uc624\ub298 \ub9e8\uc2dc\ud2f0 vs \uc544\uc2a4\ub110, \ub204\uac00 \uc720\ub9ac\ud574?' \uac19\uc740 \uc9c8\ubb38\uc744 \ub358\uc9c0\uba74 AI\uac00 \uc989\uc2dc \ub370\uc774\ud130 \uae30\ubc18 \ub2f5\ubcc0\uc744 \uc918\uc694. 3\ubd84\uc774\uba74 \ucda9\ubd84\ud574\uc694. \uc2b5\uad00\uc744 \ub9cc\ub4e4\uba74 \ub2f9\uc2e0\ub3c4 '\uc800 \uc0ac\ub78c\uc740 \uc65c \uc774\ub807\uac8c \uc608\uce21\uc744 \uc798\ud558\uc9c0?' \uc18c\ub9ac\ub97c \ub4e3\uac8c \ub420 \uac70\uc608\uc694.",
    "\uc9c0\uae08 \uc571\uc744 \uc5f4\uace0 AI \ucc44\ud305\uc5d0 '\uc624\ub298\uc758 \uac00\uc7a5 \uc88b\uc740 \uc608\uce21\uc740?'\uc774\ub77c\uace0 \ubb3c\uc5b4\ubcf4\uc138\uc694. \uadf8\uac8c \uccab\uac78\uc74c\uc774\uc5d0\uc694. P.S. \uc774 \ub8e8\ud2f4\uc744 7\uc77c \uc5f0\uc18d\uc73c\ub85c \ud558\uba74, \uc2a4\ud2b8\ub9ad \uc5c5\uc801\ub3c4 \uc313\uc774\uace0 \ud06c\ub808\ub527\ub3c4 \ubc1b\uc744 \uc218 \uc788\uc5b4\uc694. \uc624\ub298\ubd80\ud130 \uc2dc\uc791\ud574\ubcf4\ub294 \uac8c \uc5b4\ub54c\uc694?"
  ],
