{
  "subject": "\u0627\u0639\u062a\u0631\u0627\u0641: \u0642\u0628\u0644 \u0627\u0632 \u0627\u06cc\u0646 \u0627\u067e \u0627\u0634\u062a\u0628\u0627\u0647 \u0645\u06cc\u200c\u06a9\u0631\u062f\u0645",
  "preview_text": "\u062a\u0641\u0627\u0648\u062a \u0628\u06cc\u0646 \u062d\u062f\u0633 \u0632\u062f\u0646 \u0648 \u062f\u0627\u0646\u0633\u062a\u0646 \u0631\u0648 \u0628\u0628\u06cc\u0646. \u0631\u0648\u0632 \u06f5\u06f3 \u0648 \u06cc\u0647 \u0627\u0639\u062a\u0631\u0627\u0641 \u0634\u062e\u0635\u06cc.",
  "body_paragraphs": [
    "\u0631\u0627\u0633\u062a\u0634 \u0631\u0648 \u0628\u062e\u0648\u0627\u0645\u060c \u0642\u0628\u0644 \u0627\u0632 \u0627\u06cc\u0646\u06a9\u0647 \u0627\u0632 Predictify \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u0645\u060c \u0647\u0645\u06cc\u0634\u0647 \u0628\u0627 \u063a\u0631\u06cc\u0632\u0647 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u0645\u06cc\u200c\u06a9\u0631\u062f\u0645. \u0646\u062a\u06cc\u062c\u0647\u061f \u06a9\u0644\u06cc \u0628\u0627\u062e\u062a \u0648 \u062d\u0633\u0631\u062a. \u06cc\u06a9 \u0628\u0627\u0631 \u0641\u06a9\u0631 \u06a9\u0631\u062f\u0645 \u0628\u0627\u0631\u0633\u0644\u0648\u0646\u0627 \u0631\u0627\u062d\u062a \u0645\u06cc\u200c\u0628\u0631\u0647\u060c \u0648\u0644\u06cc \u0622\u0645\u0627\u0631 \u0646\u0634\u0648\u0646 \u062f\u0627\u062f \u062e\u0637 \u062d\u0645\u0644\u0647\u200c\u0634\u0648\u0646 \u062a\u0648 \u0628\u0627\u0632\u06cc\u200c\u0647\u0627\u06cc \u062e\u0627\u0631\u062c \u0627\u0632 \u062e\u0648\u0646\u0647 \u0636\u0639\u06cc\u0641\u0647. \u0627\u0648\u0646 \u0645\u0648\u0642\u0639 \u062a\u0627\u0632\u0647 \u0641\u0647\u0645\u06cc\u062f\u0645 \u0686\u0642\u062f\u0631 \u0627\u0634\u062a\u0628\u0627\u0647 \u0645\u06cc\u200c\u06a9\u0631\u062f\u0645.",
    "\u062d\u0627\u0644\u0627 \u062f\u06cc\u06af\u0647 \u0628\u062f\u0648\u0646 \u062f\u0627\u062f\u0647 \u0647\u06cc\u0686 \u062a\u0635\u0645\u06cc\u0645\u06cc \u0646\u0645\u06cc\u200c\u06af\u06cc\u0631\u0645. Predictify \u0628\u0647\u0645 \u06cc\u0627\u062f \u062f\u0627\u062f \u06a9\u0647 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc\u200c\u0647\u0627\u06cc \u062d\u0631\u0641\u0647\u200c\u0627\u06cc \u0686\u0637\u0648\u0631\u06cc\u0647. \u0628\u0627 \u062a\u062d\u0644\u06cc\u0644 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u0627\u0632 \u0647\u0632\u0627\u0631\u0627\u0646 \u0645\u062a\u063a\u06cc\u0631\u060c \u062f\u06cc\u06af\u0647 \u0645\u062b\u0644 \u0642\u0628\u0644 \u0633\u0627\u062f\u0647\u200c\u0644\u0648\u062d \u0646\u06cc\u0633\u062a\u0645. \u0641\u0631\u0642 \u0628\u06cc\u0646 \u0642\u0628\u0644 \u0648 \u0628\u0639\u062f \u0648\u0627\u0642\u0639\u0627\u064b \u062e\u062c\u0627\u0644\u062a\u200c\u0622\u0648\u0631\u0647. \u062f\u0648\u0633\u062a\u0627\u0645 \u0647\u0646\u0648\u0632 \u062d\u062f\u0633 \u0645\u06cc\u200c\u0632\u0646\u0646\u060c \u0645\u0646 \u0645\u06cc\u200c\u062f\u0648\u0646\u0645.",
    "\u0648\u06cc\u0698\u06af\u06cc \u06a9\u0647 \u0639\u0648\u0636\u0634 \u06a9\u0631\u062f: \u0627\u0645\u062a\u06cc\u0627\u0632 \u0627\u0639\u062a\u0645\u0627\u062f (Confidence Score). \u0647\u0631 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u06cc\u0647 \u062f\u0631\u0635\u062f \u062f\u0627\u0631\u0647 \u06a9\u0647 \u0646\u0634\u0648\u0646 \u0645\u06cc\u062f\u0647 \u0686\u0642\u062f\u0631 \u0645\u06cc\u200c\u062a\u0648\u0646\u0645 \u0631\u0648\u0634 \u062d\u0633\u0627\u0628 \u06a9\u0646\u0645. \u0645\u062b\u0644\u0627\u064b \u0628\u0631\u0627\u06cc \u0628\u0627\u0632\u06cc \u0627\u0645\u0634\u0628\u060c \u0633\u06cc\u0633\u062a\u0645 \u06f8\u06f5\u066a \u0628\u0647 \u0628\u0631\u062f \u0628\u0627\u06cc\u0631\u0646 \u062f\u0627\u062f\u0647. \u0627\u06cc\u0646 \u062f\u06cc\u06af\u0647 \u062d\u062f\u0633 \u0646\u06cc\u0633\u062a\u060c \u0639\u0644\u0645\u0647. \u062a\u0648\u06cc \u0628\u062e\u0634 IQ Quiz \u0647\u0645 \u0645\u06cc\u200c\u062a\u0648\u0646\u0645 \u062f\u0627\u0646\u0634\u0645 \u0631\u0648 \u0628\u0627 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u0645\u0642\u0627\u06cc\u0633\u0647 \u06a9\u0646\u0645.",
    "\u0628\u0631\u0648 \u062a\u0648\u06cc \u0627\u067e \u0648 \u06cc\u0647 \u0646\u06af\u0627\u0647\u06cc \u0628\u0647 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u0627\u0645\u0631\u0648\u0632 \u0628\u0646\u062f\u0627\u0632. \u0645\u0637\u0645\u0626\u0646\u0645 \u0641\u0631\u0642 \u0631\u0648 \u062d\u0633 \u0645\u06cc\u200c\u06a9\u0646\u06cc. P.S. \u0627\u06af\u0647 \u0647\u0646\u0648\u0632 \u067e\u0631\u06cc\u0645\u06cc\u0648\u0645 \u0631\u0648 \u0641\u0639\u0627\u0644 \u0646\u06a9\u0631\u062f\u06cc\u060c \u0633\u0647 \u0631\u0648\u0632 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0645\u0646\u062a\u0638\u0631\u062a\u0647. \u0642\u06cc\u0645\u062a\u0634 \u0641\u0642\u0637 \u06f1\u06f2.\u06f9\u06f9 \u062f\u0644\u0627\u0631 \u0645\u0627\u0647\u0627\u0646\u0647\u200c\u0633\u062a\u060c \u0648\u0644\u06cc \u0627\u0631\u0632\u0634\u0634 \u0631\u0648 \u06cc\u0647 \u062f\u0646\u06cc\u0627 \u062f\u0627\u0631\u0647."
  ],
