{
  "subject": "\u0906\u091c 2000 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u092f\u0939 \u0915\u093f\u092f\u093e",
  "preview_text": "\u091c\u093e\u0928\u093f\u090f \u0915\u094d\u092f\u094b\u0902 \u0939\u0930 \u0915\u094b\u0908 \u0905\u092a\u0928\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e \u0930\u0939\u093e \u0939\u0948 \u0914\u0930 \u0906\u092a \u092a\u0940\u091b\u0947 \u0930\u0939 \u0917\u090f \u0939\u0948\u0902",
  "body_paragraphs": [
    "\u0906\u091c \u0938\u0941\u092c\u0939 8 \u092c\u091c\u0947 \u0939\u0940 2000 \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u092f\u093e\u0964 \u0914\u0930 \u0935\u094b \u0938\u093f\u0930\u094d\u092b \u0938\u0941\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u0928\u0908 \u0926\u0941\u0928\u093f\u092f\u093e \u092e\u0947\u0902 \u0916\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964 \u091c\u092c \u0935\u0947 \u092c\u0938 \u0938\u094d\u091f\u0949\u092a \u092a\u0930 \u0925\u0947 \u092f\u093e \u091f\u094d\u0930\u0947\u0928 \u092e\u0947\u0902, \u0909\u0928\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u092c\u093e\u0938 \u0917\u0942\u0902\u091c \u0930\u0939\u093e \u0925\u093e, \u0939\u0930 \u0936\u092c\u094d\u0926 \u0938\u093e\u092b \u0925\u093e\u0964 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u0939\u0948, \u0935\u094b \u0915\u094d\u0937\u0923 \u091c\u092c \u0924\u0941\u092e \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u0947 \u0915\u094b \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0938\u0939\u0940 \u092e\u093e\u0924\u094d\u0930\u093e \u092e\u0947\u0902 \u0938\u0941\u0928\u0924\u0947 \u0939\u094b\u2014\u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0930\u0941\u0915\u093e\u0935\u091f \u0915\u0947, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0936\u094b\u0930 \u0915\u0947?",
    "\u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0928\u0939\u0940\u0902 \u0939\u0948, \u092f\u0939 \u090f\u0915 \u0905\u0928\u0941\u092d\u0935 \u0939\u0948\u0964 \u0932\u094b\u0917 \u092c\u0924\u093e \u0930\u0939\u0947 \u0939\u0948\u0902 \u0915\u093f \u0909\u0928\u0915\u0947 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0905\u092c \u0938\u093e\u092b \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u092d\u0940\u0921\u093c \u092e\u0947\u0902 \u092d\u0940\u0964 \u0909\u0928\u0915\u0947 \u0917\u093e\u0928\u0947 \u092e\u0947\u0902 \u0935\u0939 \u0917\u0939\u0930\u093e\u0908 \u0939\u0948 \u091c\u094b \u092a\u0939\u0932\u0947 \u0928\u0939\u0940\u0902 \u0925\u0940\u0964 \u0914\u0930 \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u0940 \u092c\u093e\u0924? \u092f\u0939 \u0938\u092c \u0909\u0928\u0915\u0947 \u092b\u094b\u0928 \u0938\u0947 \u0939\u0940 \u0939\u094b \u0930\u0939\u093e \u0939\u0948\u0964 \u0924\u0941\u092e \u092d\u0940 \u0909\u0928\u092e\u0947\u0902 \u0938\u0947 \u0939\u094b \u0938\u0915\u0924\u0947 \u0939\u094b, \u0932\u0947\u0915\u093f\u0928 \u0924\u0941\u092e\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u0935\u0939 \u092c\u091f\u0928 \u0928\u0939\u0940\u0902 \u0926\u092c\u093e\u092f\u093e\u0964",
    "\u0939\u092e\u093e\u0930\u0947 \u0910\u092a \u0915\u093e Bass Booster \u092b\u0940\u091a\u0930 \u0907\u0938\u0947 \u0938\u0902\u092d\u0935 \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u2014\u090f\u0915 \u091f\u0948\u092a \u0938\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092b\u094b\u0928 \u090f\u0915 \u091b\u094b\u091f\u0947 \u0915\u0902\u0938\u0930\u094d\u091f \u0939\u0949\u0932 \u092e\u0947\u0902 \u092c\u0926\u0932 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u091a\u093e\u0939\u0947 \u0924\u0941\u092e Spotify \u092a\u0930 \u0939\u094b \u092f\u093e YouTube, \u0939\u0930 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u092c\u0922\u093c\u093e\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u091c\u094b \u0932\u094b\u0917 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092a\u0930 \u0939\u0948\u0902, \u0935\u0947 \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0914\u0930 \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 EQ \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0915\u093e \u092e\u091c\u093c\u093e \u0932\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0924\u0941\u092e \u0915\u094d\u092f\u094b\u0902 \u092a\u0940\u091b\u0947 \u0939\u094b?",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 Bass Booster \u0915\u094b \u0906\u091c\u093c\u092e\u093e\u0913\u0964 \u0926\u0947\u0916\u094b \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u093e \u0915\u0948\u0938\u0947 \u092c\u0926\u0932\u0924\u093e \u0939\u0948\u0964 P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0905\u092d\u0940 \u092d\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u2014\u0939\u0930 \u0915\u094b\u0908 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0907\u0938\u0915\u093e \u092b\u093e\u092f\u0926\u093e \u0909\u0920\u093e \u091a\u0941\u0915\u093e \u0939\u0948, \u0924\u0941\u092e \u0905\u092d\u0940 \u092d\u0940 \u0938\u094b\u091a \u0930\u0939\u0947 \u0939\u094b?"
  ],
