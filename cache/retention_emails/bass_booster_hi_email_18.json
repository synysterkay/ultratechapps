{
  "subject": "\u090f\u0915 2AM \u0915\u0940 \u0917\u0932\u0924\u0940 \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e \u0925\u093e \u092f\u0939 \u092c\u0938 \u090f\u0915 \u0914\u0930 \u0910\u092a \u0939\u094b\u0917\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930...",
  "body_paragraphs": [
    "\u092e\u0948\u0902 \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0910\u0938\u0947 \u0908\u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0932\u093f\u0916\u0924\u093e\u0964 \u0938\u091a \u0915\u0939\u0942\u0902 \u0924\u094b, \u092e\u0948\u0902\u0928\u0947 \u0915\u092d\u0940 \u0938\u094b\u091a\u093e \u0928\u0939\u0940\u0902 \u0925\u093e \u0915\u093f \u092e\u0948\u0902 Bass Booster \u0915\u0947 \u092a\u0940\u091b\u0947 \u0915\u093e \u0905\u0938\u0932\u0940 \u0915\u093f\u0938\u094d\u0938\u093e \u0936\u0947\u092f\u0930 \u0915\u0930\u0942\u0902\u0917\u093e\u0964 \u092a\u0930 \u0906\u091c \u0930\u093e\u0924, 2 \u092c\u091c\u0947, \u091c\u092c \u092e\u0947\u0930\u0947 \u092b\u094b\u0928 \u092a\u0930 \u0915\u094b\u0908 \u092c\u093e\u0938 \u0939\u0940 \u0928\u0939\u0940\u0902 \u0925\u093e \u0914\u0930 \u092e\u0948\u0902 \u0939\u093f\u092a-\u0939\u0949\u092a \u0915\u093e \u0935\u0939 \u0921\u094d\u0930\u0949\u092a \u0938\u0941\u0928 \u0930\u0939\u093e \u0925\u093e \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u092b\u094d\u0932\u0948\u091f \u0932\u0917 \u0930\u0939\u093e \u0925\u093e, \u0924\u094b \u092e\u0941\u091d\u0947 \u0932\u0917\u093e \u2014 \u092f\u0939\u0940 \u0935\u0939 \u092a\u0932 \u0939\u0948 \u091c\u092c \u0938\u092c \u092c\u0926\u0932 \u0917\u092f\u093e\u0964",
    "\u092f\u0939 \u0915\u094b\u0908 \u092e\u093e\u0930\u094d\u0915\u0947\u091f\u093f\u0902\u0917 \u0935\u093e\u0932\u0940 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092e\u0948\u0902\u0928\u0947 \u0916\u0941\u0926 \u0915\u094b \u090f\u0915 \u0910\u0938\u093e \u0910\u092a \u092c\u0928\u093e\u0924\u0947 \u0926\u0947\u0916\u093e \u091c\u094b \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u0915\u094b \u090f\u0915 \u0938\u092c\u0935\u0942\u092b\u0930 \u092e\u0947\u0902 \u092c\u0926\u0932 \u0926\u0947\u0964 \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0935\u0939 \u092b\u0940\u0932\u093f\u0902\u0917 \u091c\u092c \u0906\u092a\u0915\u094b \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0915\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u091f\u094d\u0930\u0948\u0915 \u0915\u093e \u092c\u093e\u0938 \u0938\u0940\u0927\u0947 \u0906\u092a\u0915\u0940 \u091b\u093e\u0924\u0940 \u092e\u0947\u0902 \u0917\u0942\u0902\u091c \u0930\u0939\u093e \u0939\u0948? \u0935\u0939 \u092b\u0940\u0932\u093f\u0902\u0917 \u092e\u0948\u0902\u0928\u0947 \u0916\u094b \u0926\u0940 \u0925\u0940, \u091c\u092c \u0924\u0915 \u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u0928\u0939\u0940\u0902 \u092c\u0928\u093e\u092f\u093e\u0964",
    "Bass Booster \u092e\u0947\u0902 \u090f\u0915 \u091a\u0940\u091c \u0939\u0948 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 2AM \u092a\u0930 \u091c\u094b\u0921\u093c\u0940 \u2014 \u0935\u0928-\u091f\u0948\u092a \u092c\u0942\u0938\u094d\u091f \u0938\u094d\u0932\u093e\u0907\u0921\u0930\u0964 \u092c\u0938 \u0907\u0938\u0947 \u0916\u0940\u0902\u091a\u094b, \u0914\u0930 \u0906\u092a\u0915\u093e \u092e\u094d\u092f\u0942\u091c\u093f\u0915, \u0906\u092a\u0915\u0940 \u091f\u093f\u0915\u091f\u0949\u0915, \u0906\u092a\u0915\u093e \u0938\u094d\u092a\u0949\u091f\u093f\u092b\u093e\u0908 \u2014 \u0938\u092c \u0915\u0941\u091b \u2014 \u0905\u091a\u093e\u0928\u0915 200% \u0932\u093e\u0909\u0921\u0930 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u0939\u093e\u0902, \u092c\u093e\u0938 \u0935\u0930\u094d\u091a\u0941\u0905\u0932\u093e\u0907\u091c\u093c\u0930 \u0915\u0947 \u0938\u093e\u0925, \u0935\u0939 \u0921\u094d\u0930\u0949\u092a \u091c\u094b \u092a\u0939\u0932\u0947 \u092a\u0924\u0932\u093e \u0932\u0917\u0924\u093e \u0925\u093e, \u0905\u092c \u0906\u092a\u0915\u0947 \u0908\u092f\u0930\u092c\u0921\u094d\u0938 \u092e\u0947\u0902 \u092d\u0940 \u0917\u0942\u0902\u091c\u0924\u093e \u0939\u0948\u0964 \u092e\u0948\u0902\u0928\u0947 \u0907\u0938\u0947 \u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e, \u0914\u0930 \u092b\u093f\u0930 100,000 \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0932\u094b\u0917 \u0907\u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0928\u0947 \u0932\u0917\u0947\u0964",
    "\u0924\u094b \u0906\u091c, \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930, \u0905\u092a\u0928\u093e Bass Booster \u0916\u094b\u0932\u094b\u0964 \u0935\u0928-\u091f\u0948\u092a \u092c\u0942\u0938\u094d\u091f \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b \u0926\u093e\u0908\u0902 \u0913\u0930 \u0916\u0940\u0902\u091a\u094b\u0964 \u092b\u093f\u0930 \u0935\u0939 \u0917\u093e\u0928\u093e \u092c\u091c\u093e\u0913 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0939\u092e\u0947\u0936\u093e \u0932\u0917\u0924\u093e \u0925\u093e \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092b\u094b\u0928 \u092a\u0930 \u092b\u094d\u0932\u0948\u091f \u0932\u0917\u0924\u093e \u0939\u0948\u0964 \u0914\u0930 \u092c\u0924\u093e\u0913 \u092e\u0941\u091d\u0947 \u2014 \u0915\u094d\u092f\u093e \u0935\u0939 \u0921\u094d\u0930\u0949\u092a \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u091b\u093e\u0924\u0940 \u092e\u0947\u0902 \u0917\u0942\u0902\u091c\u093e? P.S. \u0905\u0917\u0930 \u0924\u0941\u092e \u091a\u093e\u0939\u094b \u0915\u093f \u0939\u0930 \u092c\u093e\u0930 \u0910\u0938\u093e \u0939\u094b, \u0924\u094b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b \u2014 \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092c\u0942\u0938\u094d\u091f \u0914\u0930 10-\u092c\u0948\u0902\u0921 EQ \u0915\u0947 \u0938\u093e\u0925, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092e\u094d\u092f\u0942\u091c\u093f\u0915 \u0915\u092d\u0940 \u092b\u094d\u0932\u0948\u091f \u0928\u0939\u0940\u0902 \u0932\u0917\u0947\u0917\u093e\u0964"
  ],
