{
  "subject": "\u0634\u064a\u0621 \u0635\u0646\u0639\u062a\u0647 \u0644\u0643 \u0641\u064a \u0627\u0644\u0633\u0627\u0639\u0629 3 \u0635\u0628\u0627\u062d\u0627\u064b",
  "preview_text": "\u0644\u0645 \u0623\u0643\u0646 \u0623\u062e\u0637\u0637 \u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0647\u0630\u0627 \u0623\u0628\u062f\u0627\u064b. \u0644\u0643\u0646 \u0628\u0639\u062f 35 \u064a\u0648\u0645\u0627\u064b\u060c \u0642\u0631\u0631\u062a \u0623\u0646 \u0623\u0631\u064a\u0643 \u0627\u0644\u0633\u0631 \u0627\u0644\u0630\u064a \u064a\u063a\u064a\u0631 \u0643\u0644 \u0634\u064a\u0621.",
  "body_paragraphs": [
    "\u0641\u064a \u0627\u0644\u0644\u064a\u0644\u0629 \u0627\u0644\u0645\u0627\u0636\u064a\u0629\u060c \u062c\u0644\u0633\u062a \u0641\u064a \u063a\u0631\u0641\u0629 \u0645\u0638\u0644\u0645\u0629\u060c \u0633\u0645\u0627\u0639\u0627\u062a\u064a \u0639\u0644\u0649 \u0623\u0630\u0646\u064a\u060c \u0648\u0623\u0646\u0627 \u0623\u0633\u062a\u0645\u062a\u0639 \u0628\u0623\u063a\u0646\u064a\u0629 \u0643\u0627\u0646\u062a \u062a\u0647\u0632 \u0635\u062f\u0631\u064a. \u0641\u062c\u0623\u0629\u060c \u062e\u0637\u0631\u062a \u0644\u064a \u0641\u0643\u0631\u0629: \u0644\u0645\u0627\u0630\u0627 \u0644\u0627 \u0623\u0635\u0646\u0639 \u0634\u064a\u0626\u0627\u064b \u062e\u0627\u0635\u0627\u064b \u0644\u0643\u061f \u0634\u064a\u0621 \u0644\u0645 \u0623\u062e\u0637\u0637 \u0644\u0645\u0634\u0627\u0631\u0643\u062a\u0647 \u0645\u0639 \u0623\u062d\u062f. \u0647\u0630\u0627 \u0644\u064a\u0633 \u062a\u062d\u062f\u064a\u062b\u0627\u064b \u0639\u0627\u062f\u064a\u0627\u064b. \u0625\u0646\u0647\u0627 \u0647\u062f\u064a\u0629 \u063a\u064a\u0631 \u0645\u062a\u0648\u0642\u0639\u0629.",
    "\u0644\u0642\u062f \u0644\u0627\u062d\u0638\u062a \u0623\u0646\u0643 \u062a\u062d\u0628 \u0623\u0646 \u062a\u0634\u0639\u0631 \u0628\u0627\u0644\u0636\u0631\u0628\u0629 \u0641\u064a \u0642\u0644\u0628\u0643\u060c \u0633\u0648\u0627\u0621 \u0643\u0646\u062a \u062a\u0633\u062a\u0645\u0639 \u0625\u0644\u0649 \u0647\u064a\u0628 \u0647\u0648\u0628 \u0623\u0648 \u0631\u0648\u0643. \u0644\u0643\u0646 \u0645\u0643\u0628\u0631\u0627\u062a \u0635\u0648\u062a \u0647\u0627\u062a\u0641\u0643 \u0648\u0633\u0645\u0627\u0639\u0627\u062a\u0643 \u0644\u0627 \u062a\u0639\u0637\u064a\u0643 \u0630\u0644\u0643. \u0627\u0644\u0635\u0648\u062a \u0645\u0633\u0637\u062d\u060c \u0628\u0644\u0627 \u062d\u064a\u0627\u0629. \u0647\u0630\u0627 \u064a\u0632\u0639\u062c\u0646\u064a \u0623\u064a\u0636\u0627\u064b. \u0644\u0630\u0644\u0643\u060c \u0642\u0645\u062a \u0628\u0628\u0646\u0627\u0621 \u0645\u064a\u0632\u0629 \u0625\u0636\u0627\u0641\u064a\u0629: \u0625\u0639\u062f\u0627\u062f \u0645\u062e\u0641\u064a \u064a\u0645\u0643\u0646\u0643 \u062a\u0634\u063a\u064a\u0644\u0647 \u0627\u0644\u0622\u0646.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0634\u0631\u064a\u0637 \u0627\u0644\u062a\u0639\u0632\u064a\u0632\u060c \u0648\u0627\u0633\u062d\u0628 \u0627\u0644\u0645\u0624\u0634\u0631 \u0625\u0644\u0649 \u0623\u0642\u0635\u0649 \u0627\u0644\u064a\u0645\u064a\u0646. \u0633\u062a\u0634\u0639\u0631 \u0628\u0641\u0631\u0642 \u0641\u0648\u0631\u064a. \u0644\u064a\u0633 \u0645\u062c\u0631\u062f \u0635\u0648\u062a \u0623\u0639\u0644\u0649\u060c \u0628\u0644 Bass \u064a\u062a\u062f\u0641\u0642 \u0641\u064a \u0639\u0631\u0648\u0642\u0643. \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u062a\u0639\u0645\u0644 \u0645\u0639 \u0643\u0644 \u0634\u064a\u0621: \u0633\u0628\u0648\u062a\u064a\u0641\u0627\u064a\u060c \u064a\u0648\u062a\u064a\u0648\u0628\u060c \u062a\u064a\u0643 \u062a\u0648\u0643\u060c \u062d\u062a\u0649 \u0623\u0644\u0639\u0627\u0628\u0643. \u0625\u0646\u0647\u0627 \u0643\u0623\u0646\u0646\u064a \u0623\u0636\u0639 \u0645\u0636\u062e\u0645 \u0635\u0648\u062a \u0635\u063a\u064a\u0631 \u0641\u064a \u062c\u064a\u0628\u0643.",
    "\u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0622\u0646. \u0627\u0641\u062a\u062d \u062a\u0637\u0628\u064a\u0642 Bass Booster\u060c \u0648\u0634\u063a\u0644 \u0623\u064a \u0623\u063a\u0646\u064a\u0629\u060c \u0648\u0627\u0633\u062d\u0628 \u0634\u0631\u064a\u0637 \u0627\u0644\u062a\u0639\u0632\u064a\u0632. \u0633\u062a\u0634\u0639\u0631 \u0628\u0627\u0644\u0641\u0631\u0642 \u0641\u064a \u062b\u0648\u0627\u0646\u064d. \u0628.\u0633: \u0644\u0627 \u062a\u062e\u0628\u0631 \u0623\u062d\u062f\u0627\u064b \u0628\u0647\u0630\u0627 \u0627\u0644\u0633\u0631. \u0625\u0646\u0647 \u0645\u062e\u0635\u0635 \u0644\u0643 \u0641\u0642\u0637."
  ],
