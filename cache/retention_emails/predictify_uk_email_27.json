{
  "subject": "10 000 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432 \u2014 \u043e\u0434\u0438\u043d \u0441\u043f\u0456\u043b\u044c\u043d\u0438\u0439 \u0432\u0438\u0441\u043d\u043e\u0432\u043e\u043a",
  "preview_text": "\u041c\u0438 \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u043b\u0438 \u0434\u0430\u043d\u0456 10 000 \u0444\u0430\u043d\u0430\u0442\u0456\u0432 \u0456 \u0437\u043d\u0430\u0439\u0448\u043b\u0438 \u0442\u0435, \u0449\u043e \u0437\u043c\u0456\u043d\u044e\u0454 \u0432\u0441\u0435. \u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435, \u0449\u043e\u0431 \u0434\u0456\u0437\u043d\u0430\u0442\u0438\u0441\u044f, \u0447\u0438 \u0432\u0438 \u0441\u0435\u0440\u0435\u0434 \u0442\u0438\u0445, \u0445\u0442\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0438\u0439 \u0432\u0438\u0431\u0456\u0440.",
  "body_paragraphs": [
    "\u0423\u044f\u0432\u0438: \u043c\u0438 \u0432\u0437\u044f\u043b\u0438 10 000 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432 Predictify \u0456 \u043f\u043e\u0434\u0438\u0432\u0438\u043b\u0438\u0441\u044f, \u044f\u043a \u0432\u043e\u043d\u0438 \u0440\u043e\u0431\u043b\u044f\u0442\u044c \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438. \u0406 \u0437\u043d\u0430\u0454\u0448 \u0449\u043e? 78% \u0437 \u043d\u0438\u0445, \u0445\u0442\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0432 \u043d\u0430\u0448 AI \u0445\u043e\u0447\u0430 \u0431 \u0440\u0430\u0437, \u043f\u0456\u0434\u0432\u0438\u0449\u0438\u043b\u0438 \u0442\u043e\u0447\u043d\u0456\u0441\u0442\u044c \u0441\u0432\u043e\u0457\u0445 \u0441\u0442\u0430\u0432\u043e\u043a \u043d\u0430 34%. \u0426\u0435 \u043d\u0435 \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0456\u0441\u0442\u044c \u2014 \u0446\u0435 \u0434\u0430\u043d\u0456. \u0410\u043b\u0435 \u0454 \u043e\u0434\u0438\u043d \u043d\u044e\u0430\u043d\u0441: \u0431\u0456\u043b\u044c\u0448\u0456\u0441\u0442\u044c \u0442\u0438\u0445, \u0445\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0431\u0443\u0432\u0430\u0432 AI, \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u0432\u0430\u043b\u0438 \u043f\u043e\u043a\u043b\u0430\u0434\u0430\u0442\u0438\u0441\u044f \u043d\u0430 \u0456\u043d\u0442\u0443\u0457\u0446\u0456\u044e. \u0406 \u043f\u0440\u043e\u0433\u0440\u0430\u0432\u0430\u043b\u0438 \u0447\u0430\u0441\u0442\u0456\u0448\u0435.",
    "\u042f\u043a \u0446\u0435 \u043f\u0440\u0430\u0446\u044e\u0454? \u041d\u0430\u0448 AI \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0454 \u0442\u0438\u0441\u044f\u0447\u0456 \u0437\u043c\u0456\u043d\u043d\u0438\u0445 \u043d\u0430 \u043c\u0430\u0442\u0447: xG, \u043e\u0431\u043e\u0440\u043e\u043d\u0443, \u0430\u0442\u0430\u043a\u0443, \u0456\u0441\u0442\u043e\u0440\u0456\u044e \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0435\u0439. \u0412\u0456\u043d \u043d\u0435 \u0432\u0433\u0430\u0434\u0443\u0454 \u2014 \u0432\u0456\u043d \u0440\u0430\u0445\u0443\u0454. \u0406 \u0434\u0430\u0454 \u0442\u043e\u0431\u0456 \u0447\u0456\u0442\u043a\u0438\u0439 \u0432\u0456\u0434\u0441\u043e\u0442\u043e\u043a \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u043e\u0441\u0442\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0443 \u043c\u0430\u0442\u0447\u0456 \u0411\u0430\u0432\u0430\u0440\u0456\u044f \u043f\u0440\u043e\u0442\u0438 \u0411\u043e\u0440\u0443\u0441\u0441\u0456\u0457 \u0414\u043e\u0440\u0442\u043c\u0443\u043d\u0434 AI \u043f\u043e\u043a\u0430\u0437\u0430\u0432 67% \u043d\u0430 \u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0443 \u0411\u0430\u0432\u0430\u0440\u0456\u0457. \u0406 \u0446\u0435 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043b\u043e\u0441\u044f. \u0410\u043b\u0435 \u0446\u0435 \u043b\u0438\u0448\u0435 \u043e\u0434\u0438\u043d \u043f\u0440\u0438\u043a\u043b\u0430\u0434.",
    "\u0422\u0438 \u0432\u0436\u0435 \u043c\u0430\u0454\u0448 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0446\u044c\u043e\u0433\u043e \u0432 \u0440\u043e\u0437\u0434\u0456\u043b\u0456 \"\u041f\u0440\u043e\u0433\u043d\u043e\u0437\u0438\". \u041f\u0440\u043e\u0441\u0442\u043e \u0432\u0456\u0434\u043a\u0440\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a, \u043e\u0431\u0435\u0440\u0438 \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u043c\u0430\u0442\u0447 \u0456 \u043f\u043e\u0434\u0438\u0432\u0438\u0441\u044f \u043d\u0430 Confidence Score. \u0426\u0435 \u044f\u043a \u043c\u0430\u0442\u0438 \u0434\u0440\u0443\u0433\u0430-\u0430\u043d\u0430\u043b\u0456\u0442\u0438\u043a\u0430, \u044f\u043a\u0438\u0439 \u0437\u0430\u0432\u0436\u0434\u0438 \u043f\u043e\u0440\u0443\u0447. \u0406 \u043d\u0435 \u0437\u0430\u0431\u0443\u0434\u044c \u043f\u0440\u043e IQ Quiz \u2014 \u043f\u0435\u0440\u0435\u0432\u0456\u0440, \u0447\u0438 \u0442\u0432\u0456\u0439 \u0444\u0443\u0442\u0431\u043e\u043b\u044c\u043d\u0438\u0439 \u0456\u043d\u0442\u0435\u043b\u0435\u043a\u0442 \u0432\u0438\u0449\u0438\u0439 \u0437\u0430 AI.",
    "\u0412\u0456\u0434\u043a\u0440\u0438\u0439 Predictify \u0437\u0430\u0440\u0430\u0437 \u0456 \u0437\u043d\u0430\u0439\u0434\u0438 \u043c\u0430\u0442\u0447, \u0434\u0435 AI \u0434\u0430\u0454 \u043f\u043e\u043d\u0430\u0434 60% \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u043e\u0441\u0442\u0456. \u041f\u043e\u0441\u0442\u0430\u0432 \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0456 \u043f\u043e\u0434\u0438\u0432\u0438\u0441\u044f, \u0447\u0438 \u0432\u0438\u0433\u0440\u0430\u0454\u0448. P.S. \u0414\u043e \u0440\u0435\u0447\u0456, \u0442\u0456, \u0445\u0442\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 Premium, \u043e\u0442\u0440\u0438\u043c\u0443\u044e\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0438\u0445 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a \u2014 \u0441\u0435\u0440\u0435\u0434\u043d\u0456\u0439 \u0432\u0438\u0433\u0440\u0430\u0448 \u0442\u0430\u043c \u043d\u0430 20% \u0432\u0438\u0449\u0438\u0439. \u0410\u043b\u0435 \u0446\u0435 \u0432\u0436\u0435 \u0456\u043d\u0448\u0430 \u0456\u0441\u0442\u043e\u0440\u0456\u044f."
