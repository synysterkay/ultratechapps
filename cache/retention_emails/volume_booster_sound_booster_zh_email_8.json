{
  "subject": "\u90a3\u4e2a\u51cc\u66682\u70b9\u6539\u53d8\u4e00\u5207\u7684\u9519\u8bef",
  "preview_text": "\u4e00\u4e2a\u97f3\u4e50\u7231\u597d\u8005\u7684\u771f\u5b9e\u6545\u4e8b\uff1a\u5979\u5982\u4f55\u7528\u6211\u4eec\u7684\u5e94\u7528\u5f7b\u5e95\u6539\u53d8\u542c\u6b4c\u4f53\u9a8c\u3002",
  "body_paragraphs": [
    "\u4f60\u6709\u6ca1\u6709\u8fc7\u90a3\u79cd\u611f\u89c9\uff0c\u624b\u673a\u97f3\u91cf\u63a8\u5230\u9876\uff0c\u8fd8\u662f\u542c\u4e0d\u6e05\u6700\u559c\u6b22\u7684\u6b4c\uff1f\u4e0a\u4e2a\u6708\uff0c\u6709\u4e2a\u53eb\u5c0f\u6797\u7684\u7528\u6237\u53d1\u6765\u6d88\u606f\uff0c\u8bf4\u5979\u5dee\u70b9\u653e\u5f03\u6211\u4eec\u7684\u5e94\u7528\u3002\u5979\u662f\u4e2a\u901a\u52e4\u65cf\uff0c\u6bcf\u5929\u5728\u5730\u94c1\u4e0a\u542c\u64ad\u5ba2\uff0c\u4f46\u5608\u6742\u7684\u73af\u5883\u8ba9\u5979\u603b\u662f\u9519\u8fc7\u5173\u952e\u5185\u5bb9\u3002\u76f4\u5230\u6709\u4e00\u5929\u51cc\u66682\u70b9\uff0c\u5979\u5931\u7720\u4e86\uff0c\u65e0\u804a\u4e2d\u6253\u5f00\u4e86\u6211\u4eec\u7684\u5e94\u7528\uff0c\u70b9\u4e86\u90a3\u4e2a\u5979\u4e00\u76f4\u5ffd\u7565\u7684\u6309\u94ae\u3002",
    "\u5979\u8bf4\uff0c\u90a3\u4e00\u523b\u5979\u6123\u4f4f\u4e86\u3002\u5979\u9009\u4e86\u4e00\u9996\u7535\u5b50\u4e50\uff0c\u539f\u672c\u4ee5\u4e3a\u662f\u8033\u673a\u7684\u6781\u9650\uff0c\u4f46\u7ecf\u8fc7\u6211\u4eec\u7684\u9884\u8bbe\u8c03\u97f3\u540e\uff0c\u4f4e\u97f3\u50cf\u6f6e\u6c34\u4e00\u6837\u6d8c\u6765\uff0c\u8fde\u5730\u94c1\u8f70\u9e23\u58f0\u90fd\u88ab\u76d6\u8fc7\u4e86\u3002\u5979\u54ed\u4e86\uff0c\u4e0d\u662f\u60b2\u4f24\uff0c\u800c\u662f\u56e0\u4e3a\u7ec8\u4e8e\u542c\u6e05\u4e86\u97f3\u4e50\u91cc\u7684\u6bcf\u4e2a\u7ec6\u8282\u3002\u8fd9\u542c\u8d77\u6765\u5938\u5f20\uff0c\u4f46\u8fd9\u5c31\u662f\u4e3a\u4ec0\u4e48\u6211\u4eec\u8bbe\u8ba1\u8fd9\u4e2a\u5e94\u7528\uff1a\u8ba9\u5e73\u51e1\u65f6\u523b\u53d8\u5f97\u4e0d\u51e1\u3002",
    "\u4f60\u9700\u8981\u7684\u529f\u80fd\u4e00\u76f4\u5c31\u5728\u4f60\u7684\u6307\u5c16\u3002\u6253\u5f00\u5e94\u7528\uff0c\u8bd5\u8bd5\u201c\u7235\u58eb\u201d\u6216\u201c\u7535\u5b50\u201d\u9884\u8bbe\uff0c\u6216\u8005\u6ed1\u52a8\u5747\u8861\u5668\u5230\u4f60\u7684\u504f\u597d\u3002\u7cfb\u7edf\u4f1a\u8bb0\u4f4f\u4f60\u7684\u8bbe\u7f6e\uff0c\u4ee5\u540e\u6bcf\u6b21\u6253\u5f00\u90fd\u81ea\u52a8\u4f18\u5316\u3002\u8fd9\u5c31\u662f\u4e3a\u4ec0\u4e48\u51e0\u5343\u4eba\u6bcf\u5929\u7528\u5b83\u2014\u2014\u4e0d\u662f\u56e0\u4e3a\u5b83\u82b1\u54e8\uff0c\u800c\u662f\u56e0\u4e3a\u5b83\u89e3\u51b3\u4e86\u6700\u70e6\u4eba\u7684\u95ee\u9898\u3002",
    "\u73b0\u5728\u5c31\u6253\u5f00\u5e94\u7528\uff0c\u70b9\u51fb\u90a3\u4e2a\u4f60\u4e4b\u524d\u53ef\u80fd\u5ffd\u7565\u7684\u201c\u97f3\u91cf\u589e\u5f3a\u201d\u6309\u94ae\u3002\u8c03\u9ad8\u5230200%\uff0c\u611f\u53d7\u4f60\u7684\u624b\u673a\u50cf\u65b0\u7684\u4e00\u6837\u3002P.S. \u5982\u679c\u4f60\u8fd8\u6ca1\u8bd5\u8fc7\u9ad8\u7ea7\u5747\u8861\u5668\uff0c\u89e3\u9501\u5b83\u540e\u80fd\u8ba9\u97f3\u4e50\u5c42\u6b21\u611f\u7ffb\u500d\u3002\u522b\u7b49\u4e86\uff0c\u4f60\u7684\u8033\u6735\u503c\u5f97\u8fd9\u77ac\u95f4\u3002"
  ],
  "cta_text": "\u6253\u5f00\u5e94\u7528\uff0c\u8bd5\u8bd5\u97f3\u91cf\u589e\u5f3a",
