  "subject": "\u544a\u767d\u3057\u307e\u3059\u3001\u3053\u306e\u30e1\u30fc\u30eb\u3092\u9001\u308b\u306e\u306f\u521d\u3081\u3066\u3067\u3059",
  "preview_text": "\u958b\u767a\u8005\u304b\u3089\u306e\u500b\u4eba\u7684\u306a\u30e1\u30c3\u30bb\u30fc\u30b8\u3067\u3059\u3002\u30a2\u30d7\u30ea\u306e\u88cf\u5074\u306b\u3042\u308b\u771f\u5b9f\u3092\u304a\u4f1d\u3048\u3057\u307e\u3059\u3002",
  "body_paragraphs": [
    "\u6b63\u76f4\u306b\u8a00\u3046\u3068\u3001\u666e\u6bb5\u3053\u3093\u306a\u30e1\u30fc\u30eb\u306f\u66f8\u304d\u307e\u305b\u3093\u3002\u3067\u3082\u4eca\u65e5\u306f\u3069\u3046\u3057\u3066\u3082\u4f1d\u3048\u305f\u3044\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u3042\u306a\u305f\u304cSoulPlan\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u304b\u308939\u65e5\u3002\u305d\u306e\u9593\u306b\u3001\u3069\u308c\u3060\u3051\u306e\u30c7\u30fc\u30c8\u3092\u8a08\u753b\u3057\u307e\u3057\u305f\u304b\uff1f\u3082\u3057\u300c\u3042\u307e\u308a\u4f7f\u3063\u3066\u3044\u306a\u3044\u300d\u306a\u3089\u3001\u305d\u308c\u306f\u79c1\u305f\u3061\u306e\u8cac\u4efb\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002",
    "\u5b9f\u306f\u3001\u3053\u306e\u30a2\u30d7\u30ea\u306b\u306f\u591a\u304f\u306e\u30ab\u30c3\u30d7\u30eb\u304c\u898b\u9003\u3057\u3066\u3044\u308b\u6a5f\u80fd\u304c\u3042\u308a\u307e\u3059\u3002\u305d\u308c\u306f\u300c\u30b5\u30d7\u30e9\u30a4\u30ba\u30c7\u30fc\u30c8\u30d7\u30e9\u30f3\u30ca\u30fc\u300d\u3067\u3059\u3002\u30d1\u30fc\u30c8\u30ca\u30fc\u304c\u77e5\u3089\u306a\u3044\u3046\u3061\u306b\u3001\u3042\u306a\u305f\u304c\u30c7\u30fc\u30c8\u3092\u8a08\u753b\u3057\u3001\u76f8\u624b\u3092\u9a5a\u304b\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3093\u3067\u3059\u3002\u3053\u308c\u3092\u4f7f\u3046\u3068\u3001\u65e5\u5e38\u304c\u4e00\u6c17\u306b\u7279\u5225\u306a\u3082\u306e\u306b\u5909\u308f\u308a\u307e\u3059\u3002\u79c1\u305f\u3061\u304c\u30c6\u30b9\u30c8\u3057\u305f\u30ab\u30c3\u30d7\u30eb\u306e92%\u304c\u300c\u95a2\u4fc2\u304c\u6539\u5584\u3057\u305f\u300d\u3068\u8a00\u3063\u3066\u3044\u307e\u3059\u3002",
    "\u3053\u306e\u6a5f\u80fd\u306f\u3001\u305f\u3060\u306e\u30c7\u30fc\u30c8\u63d0\u6848\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u3042\u306a\u305f\u304c\u300c\u6c17\u306b\u304b\u3051\u3066\u3044\u308b\u300d\u3053\u3068\u3092\u8a3c\u660e\u3059\u308b\u30c4\u30fc\u30eb\u3067\u3059\u3002\u30d1\u30fc\u30c8\u30ca\u30fc\u304c\u300c\u307e\u305f\u540c\u3058\u30ec\u30b9\u30c8\u30e9\u30f3\uff1f\u300d\u3068\u601d\u3046\u4ee3\u308f\u308a\u306b\u3001\u300c\u3044\u3064\u3082\u65b0\u3057\u3044\u3053\u3068\u3092\u8003\u3048\u3066\u304f\u308c\u308b\u306d\u300d\u3068\u611f\u3058\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002\u30a2\u30d7\u30ea\u3092\u958b\u3044\u3066\u3001\u30b5\u30d7\u30e9\u30a4\u30ba\u30e2\u30fc\u30c9\u3092\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u4e88\u7b97\u3084\u8208\u5473\u306b\u5408\u308f\u305b\u305f\u30a2\u30a4\u30c7\u30a2\u304c\u3059\u3050\u306b\u51fa\u3066\u304d\u307e\u3059\u3002",
    "\u4eca\u3059\u3050\u30a2\u30d7\u30ea\u3092\u958b\u3044\u3066\u3001\u53f3\u4e0a\u306e\u300c\u30b5\u30d7\u30e9\u30a4\u30ba\u300d\u30bf\u30d6\u3092\u30bf\u30c3\u30d7\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6700\u521d\u306e\u30c7\u30fc\u30c8\u30d7\u30e9\u30f3\u3092\u4f5c\u308b\u3060\u3051\u3067\u3001\u30d1\u30fc\u30c8\u30ca\u30fc\u306b\u901a\u77e5\u304c\u5c4a\u304d\u307e\u3059\u3002P.S. \u3053\u306e\u6a5f\u80fd\u3092\u4f7f\u3063\u305f\u30ab\u30c3\u30d7\u30eb\u306f\u3001\u30c7\u30fc\u30c8\u306e\u56de\u6570\u304c\u5e73\u57473\u500d\u306b\u306a\u308a\u307e\u3057\u305f\u3002\u3042\u306a\u305f\u3082\u8a66\u3057\u3066\u307f\u307e\u305b\u3093\u304b\uff1f"
