{
  "subject": "\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0630\u064a \u0627\u0643\u062a\u0634\u0641 \u0627\u0644\u0642\u0648\u0629 \u0627\u0644\u062e\u0641\u064a\u0629 \u0641\u064a \u0644\u0648\u062f\u064a\u0641\u0627\u064a",
  "preview_text": "\u0642\u0635\u0629 \u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u062c\u062f \u062d\u0644\u0627\u064b \u0644\u0645\u0634\u0643\u0644\u0629 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u062a\u064a \u0623\u0632\u0639\u062c\u062a\u0647 \u0644\u0633\u0646\u0648\u0627\u062a. \u0642\u062f \u062a\u0643\u0648\u0646 \u0623\u0646\u062a \u0627\u0644\u062a\u0627\u0644\u064a.",
  "body_paragraphs": [
    "\u0642\u0628\u0644 \u0634\u0647\u0631\u064a\u0646\u060c \u0623\u0631\u0633\u0644 \u0644\u0646\u0627 \u0645\u0633\u062a\u062e\u062f\u0645 \u064a\u064f\u062f\u0639\u0649 \u0633\u0627\u0645\u0631 \u0631\u0633\u0627\u0644\u0629 \u063a\u0627\u0636\u0628\u0629. \u0642\u0627\u0644 \u0625\u0646\u0647 \u062c\u0631\u0628 \u0643\u0644 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0635\u0648\u062a\u060c \u0644\u0643\u0646\u0647\u0627 \u0643\u0627\u0646\u062a \u0625\u0645\u0627 \u062a\u0633\u0628\u0628 \u062a\u0634\u0648\u064a\u0634\u064b\u0627 \u0623\u0648 \u062a\u0646\u0633\u0649 \u0625\u0639\u062f\u0627\u062f\u0627\u062a\u0647 \u0628\u0639\u062f \u0623\u0648\u0644 \u0627\u0633\u062a\u062e\u062f\u0627\u0645. \u0643\u0627\u0646 \u0639\u0644\u0649 \u0648\u0634\u0643 \u062d\u0630\u0641 \u0644\u0648\u062f\u064a\u0641\u0627\u064a.",
    "\u062b\u0645 \u0627\u0643\u062a\u0634\u0641 \u0634\u064a\u0626\u064b\u0627 \u0648\u0627\u062d\u062f\u064b\u0627 \u063a\u064a\u0651\u0631 \u0643\u0644 \u0634\u064a\u0621. \u062e\u0627\u0635\u064a\u0629 AutoEQ \u0627\u0644\u0645\u062e\u0635\u0635\u0629 \u0627\u0644\u062a\u064a \u062a\u062a\u0630\u0643\u0631 \u0633\u0645\u0627\u0639\u0627\u062a\u0647 \u0641\u0648\u0631 \u0627\u062a\u0635\u0627\u0644\u0647\u0627. \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0636\u0628\u0637 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u064a\u062f\u0648\u064a\u064b\u0627 \u0643\u0644 \u0645\u0631\u0629\u060c \u0623\u0635\u0628\u062d \u0635\u0648\u062a\u0647 \u0646\u0638\u064a\u0641\u064b\u0627 \u0648\u0642\u0648\u064a\u064b\u0627 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627. \u0642\u0627\u0644 \u0633\u0627\u0645\u0631: '\u0627\u0644\u0622\u0646 \u0623\u0633\u0645\u0639 \u0643\u0644 \u0643\u0644\u0645\u0629 \u0641\u064a \u0627\u0644\u0628\u0648\u062f\u0643\u0627\u0633\u062a \u062d\u062a\u0649 \u0641\u064a \u0645\u062a\u0631\u0648 \u0627\u0644\u0623\u0646\u0641\u0627\u0642.'",
    "\u0647\u0630\u0647 \u0627\u0644\u062e\u0627\u0635\u064a\u0629 \u0644\u064a\u0633\u062a \u0645\u062c\u0631\u062f \u0645\u064a\u0632\u0629 \u0639\u0627\u062f\u064a\u0629. \u0625\u0646\u0647\u0627 \u0645\u0635\u0645\u0645\u0629 \u0644\u0645\u0626\u0627\u062a \u0627\u0644\u0645\u0648\u062f\u064a\u0644\u0627\u062a \u0645\u0646 \u0627\u0644\u0633\u0645\u0627\u0639\u0627\u062a\u060c \u0648\u062a\u0639\u0645\u0644 \u0645\u0639 \u0623\u064a \u0645\u0635\u062f\u0631 \u0635\u0648\u062a\u2014\u0633\u0628\u0648\u062a\u064a\u0641\u0627\u064a\u060c \u064a\u0648\u062a\u064a\u0648\u0628\u060c \u062d\u062a\u0649 \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0627\u062a. \u0627\u0644\u0641\u0631\u0642 \u0623\u0646\u0643 \u0645\u0627 \u0639\u0627\u062f \u062a\u062d\u062a\u0627\u062c \u062a\u0636\u0628\u0637 \u0634\u064a\u0626\u064b\u0627. \u0644\u0648\u062f\u064a\u0641\u0627\u064a \u064a\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0633\u0645\u0627\u0639\u062a\u0643 \u0648\u064a\u0637\u0628\u0642 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u062b\u0627\u0644\u064a\u0629.",
    "\u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u064a\u0648\u0645. \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u0631\u0628\u0637 \u0633\u0645\u0627\u0639\u062a\u0643\u060c \u0648\u0634\u0627\u0647\u062f \u0643\u064a\u0641 \u062a\u062a\u062d\u0648\u0644 \u062c\u0648\u062f\u0629 \u0627\u0644\u0635\u0648\u062a. \u0628.\u0633. \u0625\u0630\u0627 \u062c\u0631\u0628\u062a AutoEQ\u060c \u0633\u062a\u0644\u0627\u062d\u0638 \u0627\u0644\u0641\u0631\u0642 \u0641\u064a \u0623\u0648\u0644 10 \u062b\u0648\u0627\u0646\u064d\u2014\u0648\u0644\u0646 \u062a\u0639\u0648\u062f \u0644\u0644\u0648\u0636\u0639 \u0627\u0644\u064a\u062f\u0648\u064a \u0623\u0628\u062f\u064b\u0627."
  ],
