{
  "subject": "\u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0917\u0932\u0924\u0940 \u0915\u0940 - \u092f\u0939 \u092b\u0940\u091a\u0930 \u0936\u0947\u092f\u0930 \u0928\u0939\u0940\u0902 \u0915\u0930\u0928\u093e \u0925\u093e",
  "preview_text": "\u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092d\u0940 \u091b\u0941\u092a\u093e \u0939\u0941\u0906 \u0925\u093e \u092f\u0939 \u0938\u0940\u0915\u094d\u0930\u0947\u091f\u0964 \u0905\u092d\u0940 \u0916\u094b\u0932\u0947\u0902, \u0915\u0932 \u0924\u0915 \u0936\u093e\u092f\u0926 \u0939\u091f\u093e \u0926\u0942\u0902\u0964",
  "body_paragraphs": [
    "\u0938\u091a \u0915\u0939\u0942\u0902? \u092e\u0948\u0902 \u092f\u0939 \u0908\u092e\u0947\u0932 \u092d\u0947\u091c\u0928\u0947 \u0935\u093e\u0932\u093e \u092d\u0940 \u0928\u0939\u0940\u0902 \u0925\u093e\u0964 \u0939\u092e\u093e\u0930\u0947 \u0921\u0947\u0935\u0932\u092a\u0930\u094d\u0938 \u0928\u0947 \u0915\u0939\u093e '\u0907\u0938\u0947 \u0938\u092c\u0915\u0947 \u0938\u093e\u0925 \u0936\u0947\u092f\u0930 \u092e\u0924 \u0915\u0930\u094b, \u092f\u0939 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092d\u0940 \u091c\u094d\u092f\u093e\u0926\u093e \u092a\u093e\u0935\u0930\u092b\u0941\u0932 \u0939\u0948'\u0964 \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u0938\u094b\u091a\u093e - \u091c\u094b \u0932\u094b\u0917 35 \u0926\u093f\u0928 \u0938\u0947 \u0910\u092a \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0907\u0938\u0915\u0947 \u0905\u0938\u0932\u0940 \u0939\u0915\u0926\u093e\u0930 \u0939\u0948\u0902\u0964",
    "\u0926\u0947\u0916\u094b, \u091c\u092c \u0939\u092e\u0928\u0947 AI \u0915\u094b \u091f\u094d\u0930\u0947\u0928 \u0915\u093f\u092f\u093e, \u0924\u094b \u0909\u0938\u092e\u0947\u0902 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e '\u0913\u0935\u0930\u0930\u093e\u0907\u0921' \u0938\u093f\u0938\u094d\u091f\u092e \u092c\u0928\u093e\u092f\u093e \u0925\u093e\u0964 \u092e\u0948\u091a \u0915\u0947 2 \u0918\u0902\u091f\u0947 \u092a\u0939\u0932\u0947, \u0905\u0917\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 AI \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928 \u0938\u0947 \u0905\u0932\u0917 \u0939\u0948, \u0924\u094b \u0924\u0941\u092e \u092e\u0948\u0928\u094d\u092f\u0941\u0905\u0932\u0940 \u090f\u0921\u091c\u0938\u094d\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964 \u092a\u0930 \u092f\u0939 \u092b\u0940\u091a\u0930 \u0939\u092e\u0928\u0947 \u091b\u0941\u092a\u093e \u0926\u093f\u092f\u093e \u0915\u094d\u092f\u094b\u0902\u0915\u093f... \u0921\u0930 \u0932\u0917\u093e \u0915\u093f \u0932\u094b\u0917 \u0917\u0932\u0924 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0947\u0902\u0917\u0947\u0964 \u0906\u091c \u092e\u0948\u0902 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092c\u0924\u093e \u0930\u0939\u093e \u0939\u0942\u0902 \u0915\u0948\u0938\u0947 \u092f\u0942\u091c \u0915\u0930\u0928\u093e \u0939\u0948\u0964",
    "Predictify \u0916\u094b\u0932\u094b\u0964 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u092e\u0948\u091a \u092a\u0930 \u091c\u093e\u0913\u0964 \u092a\u094d\u0930\u093f\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u0947 \u0928\u0940\u091a\u0947 '\u092e\u0947\u0930\u0940 \u0930\u093e\u092f \u0905\u0932\u0917 \u0939\u0948' \u0915\u093e \u0911\u092a\u094d\u0936\u0928 \u0926\u093f\u0916\u0947\u0917\u093e\u0964 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u094b \u0914\u0930 \u0905\u092a\u0928\u093e \u0938\u094d\u0915\u094b\u0930 \u0938\u0947\u091f \u0915\u0930\u094b\u0964 AI \u0924\u0941\u0930\u0902\u0924 \u092c\u0924\u093e\u090f\u0917\u093e \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0930\u093e\u092f \u0915\u0947 \u092a\u0915\u094d\u0937 \u092e\u0947\u0902 \u0915\u093f\u0924\u0928\u0947 \u0921\u0947\u091f\u093e \u092a\u0949\u0907\u0902\u091f\u094d\u0938 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0938\u0940\u0927\u093e \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092b\u0941\u091f\u092c\u0949\u0932 IQ \u0915\u094b AI \u0915\u0947 \u0938\u093e\u0925 \u0915\u0902\u092a\u0947\u092f\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u090f\u0915 \u092e\u0948\u091a \u092a\u0930 \u0905\u092a\u0928\u0940 \u0930\u093e\u092f \u0938\u0947\u091f \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u094b\u0964 \u091c\u094b \u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0938\u091f\u0940\u0915 \u0930\u0939\u0947\u0917\u093e, \u0909\u0938\u0947 \u0905\u0917\u0932\u0947 7 \u0926\u093f\u0928 \u0915\u0947 \u0932\u093f\u090f \u092b\u094d\u0930\u0940 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u090f\u0915\u094d\u0938\u0947\u0938 \u0926\u0942\u0902\u0917\u093e\u0964 \u0938\u0940\u0930\u0940\u092f\u0938\u0932\u0940\u0964 P.S.: \u092f\u0939 \u0911\u092a\u094d\u0936\u0928 \u0938\u093f\u0930\u094d\u092b 48 \u0918\u0902\u091f\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915\u094d\u091f\u093f\u0935 \u0930\u0939\u0947\u0917\u093e\u0964 \u092b\u093f\u0930 \u0939\u092e\u0947\u0936\u093e \u0915\u0947 \u0932\u093f\u090f \u0917\u093e\u092f\u092c\u0964"
  ],
