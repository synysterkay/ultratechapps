{
  "subject": "\u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092c\u0928\u093e\u0908 \u090f\u0915 \u091a\u0940\u091c\u093c \u091c\u094b \u092c\u0926\u0932 \u0926\u0947\u0917\u0940 \u0906\u092a\u0915\u093e \u0916\u0947\u0932",
  "preview_text": "\u092e\u0948\u0902\u0928\u0947 \u0915\u0941\u091b \u090f\u0915\u094d\u0938\u094d\u091f\u094d\u0930\u093e \u092c\u0928\u093e\u092f\u093e \u091c\u094b \u0936\u0947\u092f\u0930 \u0915\u0930\u0928\u0947 \u0915\u093e \u092a\u094d\u0932\u093e\u0928 \u0928\u0939\u0940\u0902 \u0925\u093e\u0964 \u0916\u0941\u0926 \u0926\u0947\u0916\u093f\u090f \u0915\u0948\u0938\u0947 \u092f\u0939 \u0906\u092a\u0915\u0947 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u094b \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0940 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092e\u0948\u0902 \u0915\u0941\u091b \u0928\u092f\u093e \u092c\u0928\u093e \u0930\u0939\u093e \u0925\u093e \u2013 \u090f\u0915 \u0910\u0938\u093e \u092b\u0940\u091a\u0930 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0915\u092d\u0940 \u0936\u0947\u092f\u0930 \u0915\u0930\u0928\u0947 \u0915\u093e \u0938\u094b\u091a\u093e \u0928\u0939\u0940\u0902 \u0925\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u092b\u093f\u0930 \u0938\u094b\u091a\u093e, \u0915\u094d\u092f\u094b\u0902 \u0928 \u0906\u092a\u0915\u094b \u092a\u0939\u0932\u0947 \u0926\u093f\u092f\u093e \u091c\u093e\u090f? \u092f\u0939 \u090f\u0915 \u0917\u0941\u092a\u094d\u0924 \u0939\u0925\u093f\u092f\u093e\u0930 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u092b\u0941\u091f\u092c\u0949\u0932 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964",
    "\u0939\u092e\u093e\u0930\u0947 AI \u0928\u0947 \u0939\u091c\u093e\u0930\u094b\u0902 \u092e\u0948\u091a\u094b\u0902 \u0915\u093e \u090f\u0928\u093e\u0932\u093f\u0938\u093f\u0938 \u0915\u093f\u092f\u093e, \u0914\u0930 \u092e\u0948\u0902\u0928\u0947 \u092a\u093e\u092f\u093e \u0915\u093f 80% \u0917\u0932\u0924 \u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u091a\u0940\u091c\u093c \u0915\u0940 \u0915\u092e\u0940 \u0938\u0947 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u2013 \u0938\u0939\u0940 \u0921\u0947\u091f\u093e \u0915\u093e\u0964 \u0907\u0938\u0932\u093f\u090f \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u0928\u092f\u093e \u091f\u0942\u0932 \u092c\u0928\u093e\u092f\u093e \u091c\u094b \u0906\u092a\u0915\u094b \u092c\u0924\u093e\u090f\u0917\u093e \u0915\u094c\u0928 \u0938\u093e \u092e\u0948\u091a \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u093e \u092e\u094c\u0915\u093e \u0939\u0948, \u0914\u0930 \u0915\u092c \u0906\u092a\u0915\u094b \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u091b\u094b\u0921\u093c\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964",
    "\u0905\u092c \u0906\u092a\u0915\u094b \u0939\u0930 \u092e\u0948\u091a \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 '\u0938\u0940\u0915\u094d\u0930\u0947\u091f \u0915\u0949\u0928\u094d\u092b\u093f\u0921\u0947\u0902\u0938 \u0938\u094d\u0915\u094b\u0930' \u092e\u093f\u0932\u0947\u0917\u093e \u2013 \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948 \u091c\u094b \u0921\u0947\u091f\u093e \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u090f\u0915 \u0928\u093f\u091c\u0940 \u091a\u0948\u091f \u092e\u0947\u0902 \u091b\u093f\u092a\u093e \u0939\u0948, \u091c\u0939\u093e\u0902 \u0906\u092a AI \u0938\u0947 \u0938\u0940\u0927\u0947 \u0938\u0935\u093e\u0932 \u092a\u0942\u091b \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u0938 \u0905\u092a\u0928\u0947 \u0905\u0915\u093e\u0909\u0902\u091f \u092e\u0947\u0902 \u091c\u093e\u090f\u0902 \u0914\u0930 'AI \u091a\u0948\u091f' \u0916\u094b\u0932\u0947\u0902 \u2013 \u0935\u0939\u093e\u0902 \u0906\u092a\u0915\u094b \u090f\u0915 \u0928\u092f\u093e \u092c\u091f\u0928 \u0926\u093f\u0916\u0947\u0917\u093e\u0964",
    "\u0906\u091c \u0939\u0940 \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e\u090f\u0902 \u2013 \u092e\u0948\u0902\u0928\u0947 \u0907\u0938\u0947 \u0938\u093f\u0930\u094d\u092b \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964 \u0914\u0930 \u0939\u093e\u0902, \u092f\u0939 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092d\u0940 \u090f\u0915\u094d\u0938\u094d\u091f\u094d\u0930\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0906\u092a \u0907\u0938\u0947 \u092e\u0941\u092b\u094d\u0924 \u092e\u0947\u0902 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0905\u0917\u0930 \u0906\u092a\u0915\u094b \u092f\u0939 \u092a\u0938\u0902\u0926 \u0906\u090f, \u0924\u094b \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u090f\u0902\u0964 P.S. \u2013 \u092e\u0948\u0902\u0928\u0947 \u0907\u0938 \u091f\u0942\u0932 \u092e\u0947\u0902 \u090f\u0915 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0921\u093e\u0932\u0940 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0940 \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u0915\u094b \u0926\u094b\u0917\u0941\u0928\u093e \u0915\u0930 \u0938\u0915\u0924\u0940 \u0939\u0948 \u2013 \u092c\u0938 \u0907\u0938\u0947 \u0916\u094b\u0932\u0915\u0930 \u0926\u0947\u0916\u0947\u0902\u0964"
  ],
