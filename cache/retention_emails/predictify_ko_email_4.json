  "body_paragraphs": [
    "\uc624\ub298 \uc544\uce68 7\uc2dc, Predictify\uc5d0\uc11c 3,847\uba85\uc758 \ucd95\uad6c \ud32c\ub4e4\uc774 \uac19\uc740 \uacbd\uae30 \uc608\uce21\uc744 \ud655\uc778\ud588\uc5b4. \uadf8\uc911 72%\uac00 AI\uc758 88% \uc2e0\ub8b0\ub3c4 \uc608\uce21\uc744 \ub530\ub790\uace0, \uacb0\uacfc\ub294? \uc815\ud655\ud788 \ub9de\uc544\ub5a8\uc5b4\uc84c\uc9c0. \uc774 \ub370\uc774\ud130\ub294 \ub2e8\uc21c\ud55c \uc6b4\uc774 \uc544\ub2c8\uc57c.",
