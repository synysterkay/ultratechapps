{
  "subject": "\u041e\u0448\u0438\u0431\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0434\u0435\u043b\u0430\u044e\u0442 90% \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439",
  "preview_text": "\u041e\u043d\u0438 \u0442\u0435\u0440\u044f\u044e\u0442 \u0431\u0430\u0441 \u0438\u0437-\u0437\u0430 \u043e\u0434\u043d\u043e\u0439 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438. \u0410 \u0442\u044b \u0443\u0436\u0435 \u043f\u043e\u043f\u0430\u043b\u0441\u044f? \u0423\u0437\u043d\u0430\u0439, \u043a\u0430\u043a \u044d\u0442\u043e \u0438\u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0437\u0430 10 \u0441\u0435\u043a\u0443\u043d\u0434.",
  "body_paragraphs": [
    "\u0422\u044b \u043a\u0443\u043f\u0438\u043b \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438 \u0437\u0430 15 \u0442\u044b\u0441\u044f\u0447, \u0430 \u0431\u0430\u0441 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u043f\u043b\u043e\u0441\u043a\u0438\u0439. \u0417\u043d\u0430\u043a\u043e\u043c\u043e? \u042f \u0442\u043e\u0436\u0435 \u0442\u0430\u043a \u0434\u0435\u043b\u0430\u043b \u2014 \u0432\u043a\u043b\u044e\u0447\u0430\u043b \u0442\u0440\u0435\u043a, \u0436\u0434\u0430\u043b \u0443\u0434\u0430\u0440\u0430, \u0430 \u0441\u043b\u044b\u0448\u0430\u043b \u0442\u043e\u043b\u044c\u043a\u043e \u0448\u0438\u043f\u0435\u043d\u0438\u0435. \u041e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f, \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u0435 \u043d\u043e\u0432\u0438\u0447\u043a\u0438 \u0432 Bass Booster \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u044e\u0442 \u043e\u0434\u043d\u0443 \u0438 \u0442\u0443 \u0436\u0435 \u043e\u0448\u0438\u0431\u043a\u0443: \u043e\u043d\u0438 \u043a\u0440\u0443\u0442\u044f\u0442 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c, \u043d\u043e \u043d\u0435 \u0442\u0440\u043e\u0433\u0430\u044e\u0442 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440. \u0422\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u043d\u0435 \u0433\u043b\u0443\u0445\u043e\u0439 \u2014 \u0442\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u0434\u0430\u043b \u0435\u043c\u0443 \u0448\u0430\u043d\u0441\u0430.",
    "\u0412\u043e\u0442 \u0432 \u0447\u0451\u043c \u0434\u0435\u043b\u043e: \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0439 \u0437\u0432\u0443\u043a \u043e\u0431\u0440\u0435\u0437\u0430\u0435\u0442 \u043d\u0438\u0437\u043a\u0438\u0435 \u0447\u0430\u0441\u0442\u043e\u0442\u044b, \u0447\u0442\u043e\u0431\u044b \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438 \u043d\u0435 \u0445\u0440\u0438\u043f\u0435\u043b\u0438. \u041d\u043e \u043a\u043e\u0433\u0434\u0430 \u0442\u044b \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0448\u044c Bass Booster, \u043e\u043d \u0431\u0435\u0440\u0451\u0442 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u043d\u0430 \u0441\u0435\u0431\u044f. \u041e\u0448\u0438\u0431\u043a\u0430 \u2014 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a Boost \u043d\u0430 \u043d\u0443\u043b\u0435 \u0438 \u0436\u0434\u0430\u0442\u044c \u0447\u0443\u0434\u0430. \u041d\u0443\u0436\u043d\u043e \u0441\u0434\u0432\u0438\u043d\u0443\u0442\u044c \u0435\u0433\u043e \u0445\u043e\u0442\u044f \u0431\u044b \u043d\u0430 50% \u0438 \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c Bass Virtualizer. \u0422\u043e\u0433\u0434\u0430 \u0431\u0430\u0441 \u0443\u0434\u0430\u0440\u0438\u0442 \u0432 \u0433\u0440\u0443\u0434\u044c, \u0434\u0430\u0436\u0435 \u043d\u0430 \u0434\u0435\u0448\u0451\u0432\u044b\u0445 \u0437\u0430\u0442\u044b\u0447\u043a\u0430\u0445. \u042f \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u043b \u043d\u0430 100 \u0442\u0440\u0435\u043a\u0430\u0445 \u2014 \u0431\u0435\u0437 \u044d\u0442\u043e\u0433\u043e \u0448\u0430\u0433\u0430 \u0442\u044b \u0442\u0435\u0440\u044f\u0435\u0448\u044c 80% \u044d\u0444\u0444\u0435\u043a\u0442\u0430.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041d\u0430\u0436\u043c\u0438 \u043d\u0430 Bass Virtualizer \u2014 \u043e\u043d \u0432\u043d\u0438\u0437\u0443, \u0440\u044f\u0434\u043e\u043c \u0441 3D Surround. \u041f\u043e\u0442\u043e\u043c \u043f\u043e\u0442\u044f\u043d\u0438 Boost \u0432\u043f\u0440\u0430\u0432\u043e. \u0423\u0441\u043b\u044b\u0448\u0438\u0448\u044c \u0440\u0430\u0437\u043d\u0438\u0446\u0443 \u0437\u0430 3 \u0441\u0435\u043a\u0443\u043d\u0434\u044b. Hip-Hop \u0437\u0430\u0437\u0432\u0443\u0447\u0438\u0442 \u0442\u0430\u043a, \u0431\u0443\u0434\u0442\u043e \u0442\u044b \u0432 \u043a\u043b\u0443\u0431\u0435. EDM \u2014 \u043a\u0430\u043a \u043d\u0430 \u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043b\u0435. \u0422\u043e\u043b\u044c\u043a\u043e \u043d\u0435 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044f: \u043d\u0430 200% \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u0438 \u0441\u043e\u0441\u0435\u0434\u0438 \u043f\u043e\u0441\u0442\u0443\u0447\u0430\u0442 \u0432 \u0441\u0442\u0435\u043d\u0443. \u041d\u043e \u044d\u0442\u043e \u0443\u0436\u0435 \u0438\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430.",
    "\u0421\u0434\u0435\u043b\u0430\u0439 \u044d\u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u041e\u0442\u043a\u0440\u043e\u0439 Bass Booster, \u0432\u043a\u043b\u044e\u0447\u0438 Bass Virtualizer \u0438 \u0441\u0434\u0432\u0438\u043d\u044c Boost \u0434\u043e 70%. \u041f\u043e\u0442\u043e\u043c \u043f\u043e\u0441\u0442\u0430\u0432\u044c \u043b\u044e\u0431\u043e\u0439 \u0442\u0440\u0435\u043a \u0441 \u0431\u0430\u0441\u043e\u043c \u2014 \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, 'HUMBLE.' Kendrick Lamar. \u0415\u0441\u043b\u0438 \u043d\u0435 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044c \u0432\u0438\u0431\u0440\u0430\u0446\u0438\u044e \u0432 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430\u0445, \u043d\u0430\u043f\u0438\u0448\u0438 \u043c\u043d\u0435. \u042f \u043e\u0442\u0432\u0435\u0447\u0443. P.S. \u041f\u0440\u0435\u043c\u0438\u0443\u043c \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043f\u043e\u043b\u043d\u044b\u0439 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440 \u2014 10 \u043f\u043e\u043b\u043e\u0441, \u0447\u0442\u043e\u0431\u044b \u0432\u044b\u0440\u0435\u0437\u0430\u0442\u044c \u043b\u0438\u0448\u043d\u0438\u0435 \u0447\u0430\u0441\u0442\u043e\u0442\u044b \u0438 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0431\u0430\u0441 \u0435\u0449\u0451 \u0447\u0438\u0449\u0435. \u041d\u043e \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e. \u0422\u044b \u043f\u043e\u0439\u043c\u0451\u0448\u044c, \u0437\u0430\u0447\u0435\u043c \u043e\u043d \u043d\u0443\u0436\u0435\u043d."
  ],
