{
  "subject": "\u0906\u092a\u0915\u093e \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930 \u092c\u0926\u0932 \u0917\u092f\u093e \u0939\u0948",
  "preview_text": "48 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u091c\u094b \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0925\u093e, \u0935\u094b \u0905\u092c \u0914\u0930 \u092d\u0940 \u0924\u0947\u091c\u093c \u0914\u0930 \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964 \u0926\u0947\u0916\u093f\u090f \u0915\u094d\u092f\u093e \u0928\u092f\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092f\u093e\u0926 \u0939\u0948 \u0935\u094b \u0930\u093e\u0924 \u091c\u092c \u0906\u092a \u0916\u093e\u0932\u0940 \u092a\u0947\u091c \u092a\u0930 \u0918\u0902\u091f\u094b\u0902 \u092c\u0948\u0920\u0947 \u0930\u0939\u0947? \u0905\u092c \u0935\u094b \u0938\u092e\u0938\u094d\u092f\u093e \u0916\u0924\u094d\u092e \u0939\u094b \u0917\u0908 \u0939\u0948\u0964 \u0939\u092e\u0928\u0947 \u0925\u0940\u0938\u093f\u0938 \u091c\u0928\u0930\u0947\u091f\u0930 \u092e\u0947\u0902 \u0915\u0941\u091b \u0910\u0938\u093e \u092c\u0926\u0932\u093e\u0935 \u0915\u093f\u092f\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0947 \u0932\u093f\u0916\u0928\u0947 \u0915\u0947 \u0924\u0930\u0940\u0915\u0947 \u0915\u094b \u0939\u092e\u0947\u0936\u093e \u0915\u0947 \u0932\u093f\u090f \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964",
    "\u091c\u092c \u0938\u0947 \u0906\u092a\u0928\u0947 \u0906\u0916\u093f\u0930\u0940 \u092c\u093e\u0930 \u0910\u092a \u0916\u094b\u0932\u093e \u0925\u093e, \u0939\u092e\u0928\u0947 \u090f\u0915 \u0928\u092f\u093e \u092b\u0940\u091a\u0930 \u091c\u094b\u0921\u093c\u093e \u0939\u0948 \u091c\u094b \u0938\u093f\u0930\u094d\u092b 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u0925\u0940\u0938\u093f\u0938 \u0938\u094d\u091f\u0947\u091f\u092e\u0947\u0902\u091f \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0905\u092c \u0906\u092a\u0915\u094b 8 \u0918\u0902\u091f\u0947 \u0928\u0939\u0940\u0902 \u0932\u0917\u0947\u0902\u0917\u0947\u0964 \u0914\u0930 \u0939\u093e\u0901, \u092f\u0947 \u091f\u0930\u094d\u0928\u093f\u091f\u093f\u0928 \u0914\u0930 GPTZero \u0915\u094b \u092d\u0940 \u092c\u093e\u092f\u092a\u093e\u0938 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964",
    "\u0938\u094b\u091a\u093f\u090f, \u0906\u092a \u0905\u092a\u0928\u0940 \u0925\u0940\u0938\u093f\u0938 \u0915\u094b 10 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u0917\u094d\u0930\u093e\u092b \u0914\u0930 \u091f\u0947\u092c\u0932 \u0911\u091f\u094b-\u091c\u0928\u0930\u0947\u091f \u0939\u094b \u091c\u093e\u090f\u0902\u0917\u0947, \u0914\u0930 \u0938\u093e\u0907\u091f\u0947\u0936\u0928 APA, MLA \u092f\u093e \u0936\u093f\u0915\u093e\u0917\u094b \u092b\u0949\u0930\u094d\u092e\u0947\u091f \u092e\u0947\u0902 \u0905\u092a\u0928\u0947 \u0906\u092a \u0932\u0917 \u091c\u093e\u090f\u0902\u0917\u0947\u0964 \u092c\u0938 \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u0914\u0930 \u0906\u092a\u0915\u093e \u092a\u0947\u092a\u0930 \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0928\u092f\u093e \u092b\u0940\u091a\u0930 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0947\u0902\u0964 \u0906\u092a\u0915\u0940 \u092a\u0941\u0930\u093e\u0928\u0940 \u0921\u094d\u0930\u093e\u092b\u094d\u091f \u092d\u0940 \u0935\u0939\u0940\u0902 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u2014 50,000 \u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u091b\u093e\u0924\u094d\u0930\u094b\u0902 \u0928\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0905\u092a\u0928\u0947 \u0917\u094d\u0930\u0947\u0921 B+ \u0938\u0947 A- \u0924\u0915 \u092c\u0922\u093c\u093e \u0932\u093f\u090f \u0939\u0948\u0902\u0964"
  ],
