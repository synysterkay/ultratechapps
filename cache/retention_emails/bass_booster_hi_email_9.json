{
  "subject": "\u0924\u0940\u0928 \u0926\u093f\u0928 \u0915\u093e \u091a\u0948\u0932\u0947\u0902\u091c, \u0905\u092a\u0928\u0947 \u0915\u093e\u0928\u094b\u0902 \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u0915\u0930\u094b",
  "preview_text": "\u0915\u0932\u094d\u092a\u0928\u093e \u0915\u0930\u094b \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092b\u094b\u0928 \u0938\u092c\u0935\u0942\u092b\u0930 \u091c\u0948\u0938\u093e \u0932\u0917\u0947\u0964 \u092c\u0938 \u0924\u0940\u0928 \u0926\u093f\u0928 \u0915\u093e \u092a\u094d\u0930\u092f\u094b\u0917, \u0926\u0947\u0916\u094b \u0915\u094d\u092f\u093e \u092c\u0926\u0932\u0924\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u0905\u0930\u0947 \u092d\u093e\u0908, \u0915\u094d\u092f\u093e \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092b\u094b\u0928 \u0905\u0938\u0932\u0940 \u092c\u093e\u0938 \u0926\u0947 \u0938\u0915\u0924\u093e \u0939\u0948? \u092e\u0948\u0902 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u090f\u0915 \u091a\u0948\u0932\u0947\u0902\u091c \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u2014\u0938\u093f\u0930\u094d\u092b \u0924\u0940\u0928 \u0926\u093f\u0928\u0964 \u0939\u0930 \u092c\u093e\u0930 \u0917\u093e\u0928\u093e \u0938\u0941\u0928\u094b, \u0939\u0930 \u092c\u093e\u0930 \u0935\u0940\u0921\u093f\u092f\u094b \u0926\u0947\u0916\u094b, \u092c\u0938 \u090f\u0915 \u092c\u093e\u0930 Bass Booster \u0916\u094b\u0932\u094b\u0964 \u0924\u0941\u092e \u0926\u0947\u0916\u094b\u0917\u0947 \u0915\u093f '\u0926 \u0921\u094d\u0930\u0949\u092a' \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u091b\u093e\u0924\u0940 \u092a\u0930 \u0932\u0917\u0924\u093e \u0939\u0948, \u0939\u0935\u093e \u092e\u0947\u0902 \u0928\u0939\u0940\u0902\u0964",
    "\u0938\u094b\u091a\u094b, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0939\u093f\u092a-\u0939\u0949\u092a \u091f\u094d\u0930\u0948\u0915 \u0915\u093e \u092c\u093e\u0938 \u0905\u092c \u0938\u093f\u0930\u094d\u092b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0915\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0905\u0902\u0926\u0930 \u0917\u0942\u0902\u091c\u0947\u0917\u093e\u0964 \u092e\u0948\u0902\u0928\u0947 \u092f\u0939 \u091a\u0948\u0932\u0947\u0902\u091c \u0916\u0941\u0926 \u0915\u093f\u092f\u093e\u2014\u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u0932\u0917\u093e \u0915\u093f \u0915\u0941\u091b \u0916\u093e\u0938 \u0928\u0939\u0940\u0902, \u0926\u0942\u0938\u0930\u0947 \u0926\u093f\u0928 \u0927\u094d\u092f\u093e\u0928 \u0906\u092f\u093e \u0915\u093f \u0906\u0935\u093e\u091c\u093c \u092e\u0947\u0902 \u0917\u0939\u0930\u093e\u0908 \u0939\u0948, \u0924\u0940\u0938\u0930\u0947 \u0926\u093f\u0928 \u092a\u0924\u093e \u091a\u0932\u093e \u0915\u093f \u092e\u0948\u0902 \u092c\u093f\u0928\u093e \u0907\u0938\u0915\u0947 \u0938\u0941\u0928 \u0939\u0940 \u0928\u0939\u0940\u0902 \u0938\u0915\u0924\u093e\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092b\u094b\u0928 \u092e\u0947\u0902 \u091b\u093f\u092a\u0940 \u0924\u093e\u0915\u0924 \u0915\u094b \u091c\u0917\u093e\u0913\u0964",
    "\u092c\u0938 \u090f\u0915 \u091f\u0948\u092a \u0938\u0947 '\u092c\u093e\u0938 \u0935\u0930\u094d\u091a\u0941\u0905\u0932\u093e\u0907\u091c\u093c\u0930' \u0911\u0928 \u0915\u0930\u094b\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0908\u092f\u0930\u092c\u0921\u094d\u0938 \u0915\u094b \u092d\u0940 \u0938\u092c\u0935\u0942\u092b\u0930 \u092c\u0928\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 3D \u0938\u0930\u093e\u0909\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u0939\u0930 \u092c\u0940\u091f \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0918\u0947\u0930 \u0932\u0947\u0917\u0940\u0964 \u0915\u094b\u0908 \u0938\u0947\u091f\u093f\u0902\u0917 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u091d\u0902\u091d\u091f\u2014\u092c\u0938 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0916\u0940\u0902\u091a\u094b \u0914\u0930 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u094b\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u092b\u094d\u0930\u0940 \u0939\u0948, \u0905\u0917\u0930 \u091a\u093e\u0939\u094b \u0924\u094b \u092a\u0942\u0930\u093e 10-\u092c\u0948\u0902\u0921 EQ \u092d\u0940 \u0916\u094b\u0932 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964",
    "\u0905\u092c \u0915\u0930\u094b: \u0906\u091c \u0939\u0940 Bass Booster \u0916\u094b\u0932\u094b \u0914\u0930 '\u092c\u093e\u0938 \u0935\u0930\u094d\u091a\u0941\u0905\u0932\u093e\u0907\u091c\u093c\u0930' \u0915\u094b \u0911\u0928 \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u093e \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0917\u093e\u0928\u093e \u0938\u0941\u0928\u094b\u0964 \u0924\u0940\u0928 \u0926\u093f\u0928 \u092c\u093e\u0926 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0928\u093e \u0915\u093f \u0915\u094d\u092f\u093e \u092c\u0926\u0932\u093e\u0964 \n\nP.S. \u0905\u0917\u0930 \u0924\u0941\u092e \u0924\u0940\u0938\u0930\u0947 \u0926\u093f\u0928 \u092d\u0940 \u0935\u093e\u092a\u0938 \u092a\u0941\u0930\u093e\u0928\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u092a\u0930 \u091c\u093e\u0913\u0917\u0947, \u0924\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092a\u0924\u093e \u091a\u0932\u0947\u0917\u093e \u0915\u093f \u0924\u0941\u092e \u0915\u093f\u0924\u0928\u093e \u092e\u093f\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0925\u0947\u0964"
  ],
