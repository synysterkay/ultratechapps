  "body_paragraphs": [
    "\u51cc\u6668\u4e24\u70b9\uff0c\u4f60\u6b63\u6234\u7740\u8033\u673a\u542c\u64ad\u5ba2\uff0c\u97f3\u91cf\u7a81\u7136\u8df3\u51fa\u4e00\u4e2a\u5e7f\u544a\u901a\u77e5\u3002\u4f60\u76b1\u7709\uff0c\u6ed1\u6389\uff0c\u7ee7\u7eed\u542c\u3002\u5341\u79d2\u540e\uff0c\u53c8\u4e00\u4e2a\u5f39\u7a97\u3002\u4f60\u5173\u6389\u4e86\u5e94\u7528\u3002\u8fd9\u4e0d\u662f\u4f60\u60f3\u8981\u7684\u4f53\u9a8c\u2014\u2014\u4f60\u53ea\u60f3\u8ba9\u97f3\u91cf\u53d8\u5927\uff0c\u7136\u540e\u5fd8\u8bb0\u5b83\u3002",
