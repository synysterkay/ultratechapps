{
  "subject": "\u0627\u0644\u0633\u0631 \u0627\u0644\u0630\u064a \u0644\u0627 \u064a\u062e\u0628\u0631\u0643 \u0628\u0647 \u0627\u0644\u0637\u0644\u0627\u0628 \u0627\u0644\u0645\u062a\u0641\u0648\u0642\u0648\u0646",
  "preview_text": "\u0643\u064a\u0641 \u064a\u0633\u062a\u062e\u062f\u0645 \u0623\u0641\u0636\u0644 1% \u0645\u0646 \u0637\u0644\u0627\u0628\u0646\u0627 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0644\u062a\u062d\u0642\u064a\u0642 \u062f\u0631\u062c\u0627\u062a A \u0641\u064a \u0648\u0642\u062a \u0642\u064a\u0627\u0633\u064a\u061f \u0627\u0643\u062a\u0634\u0641 \u0627\u0644\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0622\u0646.",
  "body_paragraphs": [
    "\u0647\u0644 \u062a\u0639\u0644\u0645 \u0623\u0646 90% \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u062a\u062c\u0627\u0647\u0644\u0648\u0646 \u0625\u0639\u062f\u0627\u062f\u064b\u0627 \u0648\u0627\u062d\u062f\u064b\u0627 \u0628\u0633\u064a\u0637\u064b\u0627 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u061f \u0644\u0642\u062f \u0634\u0627\u0647\u062f\u062a \u0628\u0646\u0641\u0633\u064a \u0643\u064a\u0641 \u064a\u0633\u062a\u062e\u062f\u0645 \u0623\u0641\u0636\u0644 \u0637\u0644\u0627\u0628\u0646\u0627 \u0647\u0630\u0627 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0644\u062a\u062d\u0648\u064a\u0644 \u0623\u0637\u0631\u0648\u062d\u0627\u062a\u0647\u0645 \u0645\u0646 \u0645\u062c\u0631\u062f \u0643\u0644\u0645\u0627\u062a \u0625\u0644\u0649 \u0623\u0628\u062d\u0627\u062b \u0642\u0648\u064a\u0629 \u062a\u0646\u0627\u0644 \u0625\u0639\u062c\u0627\u0628 \u0627\u0644\u0623\u0633\u0627\u062a\u0630\u0629.",
    "\u0647\u0624\u0644\u0627\u0621 \u0627\u0644\u0637\u0644\u0627\u0628 \u0644\u0627 \u064a\u0636\u064a\u0639\u0648\u0646 \u0633\u0627\u0639\u0627\u062a \u0641\u064a \u0627\u0644\u062a\u0641\u0643\u064a\u0631 \u0641\u064a \u0627\u0644\u0641\u0643\u0631\u0629 \u0627\u0644\u0623\u0648\u0644\u0649. \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0630\u0644\u0643\u060c \u064a\u0641\u062a\u062d\u0648\u0646 \u0645\u064a\u0632\u0629 '\u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0623\u0637\u0631\u0648\u062d\u0629 \u0627\u0644\u0630\u0643\u064a\u0629' \u0648\u064a\u062d\u062f\u062f\u0648\u0646 \u0627\u0644\u0646\u0648\u0639 \u0627\u0644\u0645\u062b\u0627\u0644\u064a \u0644\u0623\u0637\u0631\u0648\u062d\u062a\u0647\u0645 (\u0645\u062b\u0644\u0627\u064b \u062c\u062f\u0644\u064a\u0629 \u0623\u0648 \u062a\u062d\u0644\u064a\u0644\u064a\u0629) \u0641\u064a \u0623\u0642\u0644 \u0645\u0646 10 \u062f\u0642\u0627\u0626\u0642. \u0647\u0630\u0627 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0628\u0633\u064a\u0637 \u0647\u0648 \u0645\u0627 \u064a\u0641\u0635\u0644 \u0628\u064a\u0646 \u0623\u0637\u0631\u0648\u062d\u0629 \u0639\u0627\u062f\u064a\u0629 \u0648\u0623\u062e\u0631\u0649 \u0645\u0645\u062a\u0627\u0632\u0629.",
    "\u0644\u0642\u062f \u0644\u0627\u062d\u0638\u062a \u0623\u0646 \u0623\u0641\u0636\u0644 1% \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u064a\u0636\u0628\u0637\u0648\u0646 \u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0627\u0633\u062a\u0634\u0647\u0627\u062f\u0627\u062a (APA \u0623\u0648 MLA) \u0642\u0628\u0644 \u0628\u062f\u0621 \u0627\u0644\u0643\u062a\u0627\u0628\u0629\u060c \u062b\u0645 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0645\u064a\u0632\u0629 '\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0646\u0635 \u0625\u0644\u0649 \u0625\u0646\u0633\u0627\u0646\u064a' \u0644\u062a\u062c\u0646\u0628 \u0623\u064a \u0627\u0643\u062a\u0634\u0627\u0641 \u0630\u0643\u064a. \u0627\u0644\u0646\u062a\u064a\u062c\u0629: \u0623\u0637\u0631\u0648\u062d\u0627\u062a \u062c\u0627\u0647\u0632\u0629 \u0644\u0644\u062a\u0633\u0644\u064a\u0645 \u062a\u0628\u062f\u0648 \u0643\u0623\u0646\u0647\u0627 \u0643\u062a\u0628\u062a \u0628\u0648\u0627\u0633\u0637\u0629 \u062e\u0628\u064a\u0631 \u0645\u062d\u062a\u0631\u0641.",
    "\u062c\u0631\u0628 \u0647\u0630\u0627 \u0627\u0644\u0622\u0646: \u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0627\u062e\u062a\u0631 '\u062a\u0648\u0644\u064a\u062f \u0623\u0637\u0631\u0648\u062d\u0629 \u062c\u062f\u064a\u062f\u0629'\u060c \u062b\u0645 \u0627\u062e\u062a\u0631 \u0627\u0644\u0646\u0648\u0639 '\u062c\u062f\u0644\u064a' \u0648\u0634\u0627\u0647\u062f \u0627\u0644\u0641\u0631\u0642 \u0628\u0646\u0641\u0633\u0643. \u0623\u0646\u0627 \u0645\u062a\u0623\u0643\u062f \u0623\u0646\u0643 \u0633\u062a\u0646\u062f\u0647\u0634 \u0645\u0646 \u0627\u0644\u0646\u062a\u064a\u062c\u0629. \u0645\u0644\u0627\u062d\u0638\u0629: \u0644\u0627 \u062a\u0646\u0633\u064e \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u064a\u0632\u0629 '\u062a\u0635\u062f\u064a\u0631 PDF' \u0628\u0639\u062f \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0644\u062a\u0642\u062f\u064a\u0645 \u0639\u0645\u0644 \u0627\u062d\u062a\u0631\u0627\u0641\u064a."
  ],
  "cta_text": "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u062c\u0631\u0628 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0630\u0643\u064a",
