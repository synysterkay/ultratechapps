{
  "subject": "68 \u0926\u093f\u0928\u094b\u0902 \u0915\u093e \u0938\u092b\u0930 \u2013 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0916\u093e\u0938",
  "preview_text": "\u0939\u092e\u0928\u0947 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u090f\u0915\u094d\u0938\u0915\u094d\u0932\u0942\u0938\u093f\u0935 \u092b\u0940\u091a\u0930 \u0916\u094b\u0932\u093e \u0939\u0948\u0964 \u091c\u093e\u0928\u093f\u090f \u0915\u0948\u0938\u0947 \u0906\u092a\u0915\u0940 \u0932\u0949\u092f\u0932\u094d\u091f\u0940 \u0928\u0947 \u092f\u0939 \u092e\u0941\u092e\u0915\u093f\u0928 \u0915\u093f\u092f\u093e\u0964",
  "body_paragraphs": [
    "68 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 \u0906\u092a\u0928\u0947 Loudify \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u0909\u0938 \u0926\u093f\u0928 \u0938\u0947 \u0932\u0947\u0915\u0930 \u0906\u091c \u0924\u0915, \u0906\u092a \u0939\u0930 \u0926\u093f\u0928 \u0915\u0941\u091b \u0928 \u0915\u0941\u091b \u0938\u0941\u0928 \u0930\u0939\u0947 \u0939\u0948\u0902 \u2013 \u091a\u093e\u0939\u0947 \u0935\u094b \u091f\u094d\u0930\u0947\u0928 \u0915\u093e \u0936\u094b\u0930 \u0939\u094b \u092f\u093e \u0921\u093f\u0936\u0935\u0949\u0936\u0930 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c\u0964 \u0939\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0928\u0947 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u094b \u0938\u0939\u0940 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u091f\u094d\u092f\u0942\u0928 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u092f\u0939 \u0906\u0938\u093e\u0928 \u0928\u0939\u0940\u0902 \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u0906\u092a\u0928\u0947 \u0915\u093f\u092f\u093e\u0964",
    "\u0906\u091c \u0939\u092e \u0906\u092a\u0915\u094b \u0927\u0928\u094d\u092f\u0935\u093e\u0926 \u0926\u0947\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0936\u092c\u094d\u0926 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0915\u0941\u091b \u0910\u0938\u093e \u0926\u0947\u0915\u0930 \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0909\u0928\u094d\u0939\u0940\u0902 \u0915\u094b \u092e\u093f\u0932\u0924\u093e \u0939\u0948 \u091c\u094b \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u0932\u0902\u092c\u093e \u0938\u092b\u0930 \u0924\u092f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u092e\u0928\u0947 \u090f\u0915 \u090f\u0915\u094d\u0938\u0915\u094d\u0932\u0942\u0938\u093f\u0935 \u0907\u0928\u0938\u093e\u0907\u0921\u0930 \u090f\u0915\u094d\u0938\u0947\u0938 \u0916\u094b\u0932\u093e \u0939\u0948 \u2013 \u092f\u0939 \u090f\u0915 \u0910\u0938\u093e \u092b\u0940\u091a\u0930 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0947 \u0938\u093e\u0909\u0902\u0921 \u0921\u0940\u090f\u0928\u090f \u0915\u0940 \u0917\u0939\u0930\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0906\u092a \u091c\u093e\u0928 \u092a\u093e\u090f\u0902\u0917\u0947 \u0915\u093f \u0906\u092a\u0928\u0947 \u0939\u0930 \u0939\u092b\u094d\u0924\u0947 \u0915\u093f\u0924\u0928\u0940 \u0926\u0947\u0930 \u0938\u0941\u0928\u093e, \u0915\u094c\u0928 \u0938\u093e \u0911\u0921\u093f\u092f\u094b \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e, \u0914\u0930 \u0915\u0948\u0938\u0947 \u0906\u092a\u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924\u0947\u0902 \u092c\u0926\u0932 \u0930\u0939\u0940 \u0939\u0948\u0902\u0964",
    "\u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0939 \u0906\u092a\u0915\u093e \u092a\u0930\u094d\u0938\u0928\u0932 \u0911\u0921\u093f\u092f\u094b \u091c\u0930\u094d\u0928\u0932 \u0939\u0948\u0964 \u0939\u0930 \u0939\u092b\u094d\u0924\u0947 \u0906\u092a\u0915\u094b \u090f\u0915 \u0938\u093e\u0909\u0902\u0921 \u0921\u0940\u090f\u0928\u090f \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u092e\u093f\u0932\u0947\u0917\u0940 \u091c\u094b \u092c\u0924\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u0906\u092a\u0928\u0947 \u0915\u0948\u0938\u0947 \u0938\u0941\u0928\u093e \u2013 \u0915\u092c, \u0915\u093f\u0924\u0928\u0940 \u0926\u0947\u0930, \u0914\u0930 \u0915\u093f\u0938 \u0924\u0930\u0939 \u0915\u093e \u0915\u0902\u091f\u0947\u0902\u091f\u0964 \u092f\u0939 \u0935\u0939\u0940 \u0921\u0947\u091f\u093e \u0939\u0948 \u091c\u094b \u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u0940 \u0939\u0948 \u0924\u093e\u0915\u093f \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0906\u092a Loudify \u0916\u094b\u0932\u0947\u0902, \u0924\u094b \u0906\u092a\u0915\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u092a\u0930\u0926\u0947 \u092a\u0930 \u090f\u0915\u0926\u092e \u0938\u0939\u0940 \u091f\u094d\u092f\u0942\u0928 \u0939\u094b\u0902\u0964",
    "\u0905\u092c \u090f\u0915 \u0915\u093e\u092e \u0915\u0930\u0947\u0902: Loudify \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0940 \u0938\u093e\u0909\u0902\u0921 \u0921\u0940\u090f\u0928\u090f \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0926\u0947\u0916\u0947\u0902\u0964 \u092f\u0939 \u0906\u092a\u0915\u0947 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092e\u0947\u0902 'Sound DNA' \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u0939\u0948\u0964 \u0914\u0930 \u092f\u0926\u093f \u0906\u092a\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0936\u0941\u0930\u0942 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0939\u0948, \u0924\u094b \u092f\u0939 \u0938\u0939\u0940 \u092e\u094c\u0915\u093e \u0939\u0948\u0964 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0938\u0947 \u0906\u092a\u0915\u094b \u092a\u0942\u0930\u093e +200% \u092c\u0942\u0938\u094d\u091f, \u0911\u091f\u094b\u0908\u0915\u094d\u092f\u0942 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0914\u0930 \u0939\u0930 \u0939\u092b\u094d\u0924\u0947 \u0915\u0940 \u092a\u0942\u0930\u0940 \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u2013 \u0939\u092e\u0928\u0947 \u0926\u0947\u0916\u093e \u0939\u0948 \u0915\u093f \u091c\u094b \u0932\u094b\u0917 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092a\u0930 \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0935\u0947 \u0914\u0938\u0924\u0928 40% \u091c\u094d\u092f\u093e\u0926\u093e \u0938\u0941\u0928\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u094d\u092f\u094b\u0902? \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0906\u0935\u093e\u091c\u093c \u0938\u093e\u092b \u0914\u0930 \u0924\u0947\u091c\u093c \u0939\u094b\u0924\u0940 \u0939\u0948, \u0914\u0930 \u0939\u0930 \u092c\u093e\u0930 \u0906\u092a\u0915\u0947 \u0939\u0947\u0921\u092b\u093c