{
  "subject": "70\uc77c \uc804 \ub2f9\uc2e0\uc774 \uc2dc\uc791\ud55c \uc608\uce21 \ud601\uba85",
  "preview_text": "\ub2f9\uc2e0\uc740 \ub2e8\uc21c\ud55c \uc0ac\uc6a9\uc790\uac00 \uc544\ub2d9\ub2c8\ub2e4. 70\uc77c \ub3d9\uc548 \uc313\uc544\uc628 \ub370\uc774\ud130\uac00 \uc624\ub298 \uc0c8\ub85c\uc6b4 \uc758\ubbf8\ub97c \ub9cc\ub4ed\ub2c8\ub2e4.",
  "body_paragraphs": [
    "70\uc77c \uc804, \ub2f9\uc2e0\uc740 Predictify\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud588\uc2b5\ub2c8\ub2e4. \uadf8 \uc21c\uac04\ubd80\ud130 \ub2f9\uc2e0\uc758 \uc608\uce21\uc740 \ub2e8\uc21c\ud55c \ucd94\uce21\uc774 \uc544\ub2c8\uc5c8\uc2b5\ub2c8\ub2e4. \ub9e4 \uacbd\uae30\ub9c8\ub2e4 AI\uac00 \ubd84\uc11d\ud55c \uc218\ucc9c \uac1c\uc758 \ubcc0\uc218\uac00 \ub2f9\uc2e0\uc758 \uc120\ud0dd\uc744 \ub4b7\ubc1b\uce68\ud588\uc2b5\ub2c8\ub2e4. \uc624\ub298, \uc6b0\ub9ac\ub294 \ub2f9\uc2e0\uc774 \uc774 \uc5ec\uc815\uc758 \uc77c\ubd80\ub77c\ub294 \uc0ac\uc2e4\uc744 \uacf5\uc720\ud558\uace0 \uc2f6\uc2b5\ub2c8\ub2e4.",
    "\ub2f9\uc2e0\uc774 \uc608\uce21\ud55c \ubaa8\ub4e0 \uacbd\uae30, \ub9e4\uae34 \ubaa8\ub4e0 \uc810\uc218, \uc313\uc740 \ubaa8\ub4e0 \uc2a4\ud2b8\ub9ad\uc740 Predictify\uc758 DNA\ub97c \ud615\uc131\ud588\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \ub370\uc774\ud130\ub294 AI \ubaa8\ub378\uc744 \uac1c\uc120\ud558\uace0, \ucee4\ubba4\ub2c8\ud2f0\uc758 \uc608\uce21 \uc815\ud655\ub3c4\ub97c \ub192\uc774\uba70, \uc804 \uc138\uacc4 \ucd95\uad6c \ud32c\ub4e4\uc774 \ub354 \uc2a4\ub9c8\ud2b8\ud55c \uacb0\uc815\uc744 \ub0b4\ub9ac\ub3c4\ub85d \ub3d5\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \ub354 \uc774\uc0c1 \uc0ac\uc6a9\uc790\uac00 \uc544\ub2c8\ub77c, \uc774 \uc571\uc758 \ubbf8\ub798\ub97c \ud568\uaed8 \ub9cc\ub4dc\ub294 \uac1c\ucc99\uc790\uc785\ub2c8\ub2e4.",
    "\uc624\ub298, '\ub808\uac70\uc2dc \ubbf8\uc158'\uc774 \ud65c\uc131\ud654\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc774 \ubbf8\uc158\uc740 \ub2f9\uc2e0\uc758 \uc608\uce21 \uc5ed\uc0ac\ub97c \uae30\ubc18\uc73c\ub85c \ub9de\ucda4 \uc124\uacc4\ub41c \ub3c4\uc804 \uacfc\uc81c\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub2f9\uc2e0\uc774 \uac00\uc7a5 \ub9ce\uc774 \uc608\uce21\ud55c \ub9ac\uadf8\uc758 \ub2e4\uc74c \uacbd\uae30\uc5d0\uc11c 80% \uc774\uc0c1\uc758 \uc2e0\ub8b0\ub3c4\ub97c \uac00\uc9c4 \uc2b9\ubd80\ub97c \ucc3e\uc544 \uc608\uce21\ud574\ubcf4\uc138\uc694. \uc131\uacf5\ud558\uba74 '\ub370\uc774\ud130 \uc120\uad6c\uc790' \ubc30\uc9c0\ub97c \ud68d\ub4dd\ud558\uace0, \ucee4\ubba4\ub2c8\ud2f0 \ub9ac\ub354\ubcf4\ub4dc\uc5d0 \uc774\ub984\uc744 \ub0a8\uae30\uac8c \ub429\ub2c8\ub2e4.",
    "\uc9c0\uae08 Predictify\ub97c \uc5f4\uace0 '\ub808\uac70\uc2dc \ubbf8\uc158' \ud0ed\uc744 \ud655\uc778\ud558\uc138\uc694. \ub2f9\uc2e0\uc758 \uc608\uce21\uc774 \uc571\uc758 \ubbf8\ub798\ub97c \ud615\uc131\ud569\ub2c8\ub2e4. \uc624\ub298\uc758 \uc608\uce21\uc774 \ub0b4\uc77c\uc758 AI\ub97c \ub9cc\ub4ed\ub2c8\ub2e4. P.S. \ud504\ub9ac\ubbf8\uc5c4 \uc0ac\uc6a9\uc790\ub294 \ubbf8\uc158 \ubcf4\uc0c1\uc774 2\ubc30\ub85c \uc9c0\uae09\ub429\ub2c8\ub2e4. 3\uc77c \ubb34\ub8cc \uccb4\ud5d8\uc73c\ub85c \uc9c0\uae08 \uc2dc\uc791\ud574\ubcf4\uc138\uc694."
  ],
