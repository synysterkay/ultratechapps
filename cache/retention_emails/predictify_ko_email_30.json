{
  "subject": "\uc9c4\uc9dc \ud32c\ub9cc \uc544\ub294 \uc608\uce21\uc758 \ube44\ubc00",
  "preview_text": "70\uc77c \uc804\uc5d0 \ub2e4\uc6b4\ubc1b\uc740 \ub2f9\uc2e0, \uc774\uc81c \uc608\uce21\uc758 \uc9c4\uc9dc \uc8fc\uc778\uc774 \ub420 \uc2dc\uac04\uc785\ub2c8\ub2e4. \ub193\uce58\uba74 \ud6c4\ud68c\ud560 \uc774\uc57c\uae30",
  "body_paragraphs": [
    "70\uc77c \uc804, \ub2f9\uc2e0\uc774 Predictify\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud55c \uc21c\uac04\ubd80\ud130 \uc6b0\ub9ac\ub294 \ub2f9\uc2e0\uc744 \ub2e8\uc21c\ud55c \uc0ac\uc6a9\uc790\uac00 \uc544\ub2c8\ub77c \uc608\uce21 \ud601\uba85\uc758 \uc77c\uc6d0\uc73c\ub85c \ubd24\uc5b4\uc694. \uc9c0\uae08\uae4c\uc9c0 \uc218\ucc9c \uac1c\uc758 \uacbd\uae30\ub97c \ubd84\uc11d\ud558\uba70 \uc313\uc544\uc628 \ub370\uc774\ud130 \uc18d\uc5d0 \ub2f9\uc2e0\uc758 \ud754\uc801\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7f0\ub370 \ub9d0\uc774\uc8e0, \uc9c4\uc9dc \ubcc0\ud654\ub294 \uc774\uc81c \uc2dc\uc791\uc785\ub2c8\ub2e4.",
    "\uc6b0\ub9ac\ub294 \ub2f9\uc2e0\uc774 \ub2e8\uc21c\ud788 \uacb0\uacfc\ub97c \ub9de\ucd94\ub294 \uac78 \uc6d0\ud558\uc9c0 \uc54a\uc544\uc694. \uc608\uce21 \uc790\uccb4\ub97c \uc9c0\ubc30\ud558\ub294 \ubc95\uc744 \uac00\ub974\uccd0 \ub4dc\ub9ac\uace0 \uc2f6\uc2b5\ub2c8\ub2e4. AI\uac00 \ubd84\uc11d\ud55c xG, \uc218\ube44 \ud6a8\uc728, \uc804\uc220 \ub370\uc774\ud130\ub97c \ud65c\uc6a9\ud558\uba74 \ub2f9\uc2e0\uc758 \uc9c1\uac10\uc774 \ub354 \uc774\uc0c1 \ub3c4\ubc15\uc774 \uc544\ub2c8\ub77c \uacfc\ud559\uc774 \ub429\ub2c8\ub2e4. \uc774\ubbf8 \uc218\ubc31\ub9cc \uba85\uc758 \ud32c\uc774 \uc774 \ud798\uc744 \ub290\ub07c\uace0 \uc788\uc5b4\uc694.",
    "\uc624\ub298, \uc571\uc5d0\uc11c '\ub808\uac70\uc2dc \ubbf8\uc158'\uc774\ub77c\ub294 \uc0c8 \uae30\ub2a5\uc744 \ub9cc\ub098\ubcf4\uc138\uc694. \uc774\ub294 \ub2f9\uc2e0\uc758 \uc608\uce21 \uc2e4\ub825\uc744 \uc2dc\ud5d8\ud558\uace0 \ucee4\ubba4\ub2c8\ud2f0\uc5d0 \uae30\uc5ec\ud558\ub294 \ud2b9\ubcc4\ud55c \ub3c4\uc804\uc785\ub2c8\ub2e4. IQ \ud034\uc988\ub098 POTD \ud22c\ud45c\ucc98\ub7fc \uc7ac\ubbf8\uc788\uc9c0\ub9cc, \ub354 \uae4a\uc740 \uc758\ubbf8\uac00 \uc788\uc5b4\uc694\u2014\ub2f9\uc2e0\uc758 \ub370\uc774\ud130\uac00 \ubbf8\ub798 \uc608\uce21 \ubaa8\ub378\uc744 \uac1c\uc120\ud558\ub294 \ub370 \uc4f0\uc785\ub2c8\ub2e4. \ud504\ub9ac\ubbf8\uc5c4 \uc0ac\uc6a9\uc790\ub77c\uba74 \ub354 \ub9ce\uc740 \ud1b5\ucc30\ub825\uc744 \uc5bb\uc744 \uc218 \uc788\uc9c0\ub9cc, \ubb34\ub8cc\ub85c\ub3c4 \ucda9\ubd84\ud788 \uc2dc\uc791\ud560 \uc218 \uc788\uc5b4\uc694.",
    "\uc9c0\uae08 Predictify\ub97c \uc5f4\uace0 '\ub808\uac70\uc2dc \ubbf8\uc158'\uc744 \ud655\uc778\ud558\uc138\uc694. \ub2f9\uc2e0\uc758 \uc608\uce21\uc774 \ub2e4\uc74c \uc138\ub300\ub97c \uc704\ud55c \uae30\uc900\uc774 \ub429\ub2c8\ub2e4. P.S. 3\uc77c \ubb34\ub8cc \ud504\ub9ac\ubbf8\uc5c4 \uccb4\ud5d8\uc73c\ub85c \ubaa8\ub4e0 \uc608\uce21\uacfc \uace0\uae09 \ud1b5\uacc4\ub97c \uacbd\ud5d8\ud574\ubcf4\uc138\uc694\u2014\ud55c \ubc88 \ub9db\ubcf4\uba74 \ubabb \ub193\uc744 \uac81\ub2c8\ub2e4."
  ],
