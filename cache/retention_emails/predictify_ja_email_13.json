  "subject": "28\u65e5\u9593\u7d9a\u3051\u305f\u3042\u306a\u305f\u3060\u3051\u304c\u77e5\u308b\u79d8\u5bc6\u306e\u30c7\u30fc\u30bf",
  "preview_text": "\u3053\u306e1\u30f6\u6708\u3067\u3042\u306a\u305f\u304c\u4e88\u6e2c\u3057\u305f\u8a66\u5408\u6570\u3068AI\u304c\u767a\u898b\u3057\u305f\u300c\u3042\u308b\u50be\u5411\u300d\u3092\u516c\u958b\u3002\u898b\u9003\u3059\u3068\u640d\u3057\u307e\u3059\u3002",
  "body_paragraphs": [
    "\u3042\u306e\u65e5\u304b\u3089\u3061\u3087\u3046\u30691\u30f6\u6708\u3002\u3042\u306a\u305f\u304c\u6700\u521d\u306b\u4e88\u6e2c\u3092\u7acb\u3066\u305f\u3042\u306e\u8a66\u5408\u3092\u899a\u3048\u3066\u3044\u307e\u3059\u304b\uff1f \u305d\u306e\u65e5\u304b\u3089\u4eca\u65e5\u307e\u3067\u3001\u3042\u306a\u305f\u306f\u3082\u3046\u5358\u306a\u308b\u30b5\u30c3\u30ab\u30fc\u30d5\u30a1\u30f3\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u30c7\u30fc\u30bf\u3068\u5411\u304d\u5408\u3044\u3001AI\u3068\u7af6\u3044\u3001\u81ea\u5206\u306e\u52d8\u3092\u6570\u5b57\u3067\u691c\u8a3c\u3057\u3066\u304d\u305f\u300c\u4e88\u6e2c\u8005\u300d\u3067\u3059\u3002",
    "\u3053\u306e28\u65e5\u9593\u3067\u3001\u3042\u306a\u305f\u306f\u5e73\u5747\u3057\u3066\u9031\u306b5\u8a66\u5408\u4ee5\u4e0a\u306e\u4e88\u6e2c\u3092\u7acb\u3066\u3001AI\u306e\u78ba\u4fe1\u5ea6\u3092\u53c2\u8003\u306b\u3057\u306a\u304c\u3089\u81ea\u5206\u306e\u30b5\u30c3\u30ab\u30fc\u77e5\u8b58\u3092\u78e8\u3044\u3066\u304d\u307e\u3057\u305f\u3002\u4ed6\u306e\u30e6\u30fc\u30b6\u30fc\u304c\u6c17\u3065\u304b\u306a\u3044\u7d30\u304b\u3044\u7d71\u8a08\u2014\u2014\u4f8b\u3048\u3070\u3001\u7279\u5b9a\u306e\u30c1\u30fc\u30e0\u304c\u96e8\u306e\u65e5\u306e\u5f8c\u534a\u306b\u5931\u70b9\u3057\u3084\u3059\u3044\u50be\u5411\u2014\u2014\u3092\u7121\u610f\u8b58\u306b\u8aad\u307f\u53d6\u308b\u529b\u304c\u3064\u3044\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u304c\u300c\u7d99\u7d9a\u300d\u304c\u751f\u3080\u672c\u5f53\u306e\u30a2\u30c9\u30d0\u30f3\u30c6\u30fc\u30b8\u3067\u3059\u3002",
    "\u305d\u3053\u3067\u4eca\u65e5\u306f\u3001\u3042\u306a\u305f\u3060\u3051\u306e\u300c1\u30f6\u6708\u9032\u6357\u30ec\u30dd\u30fc\u30c8\u300d\u3092\u7528\u610f\u3057\u307e\u3057\u305f\u3002\u30a2\u30d7\u30ea\u5185\u306e\u300c\u5b9f\u7e3e\u300d\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u958b\u304f\u3068\u3001\u3042\u306a\u305f\u304c\u4e88\u6e2c\u306b\u53c2\u52a0\u3057\u305f\u5168\u8a66\u5408\u306e\u5206\u6790\u3001AI\u3068\u306e\u4e88\u6e2c\u4e00\u81f4\u7387\u306e\u63a8\u79fb\u3001\u305d\u3057\u3066\u3042\u306a\u305f\u304c\u6700\u3082\u5f97\u610f\u3068\u3059\u308b\u30ea\u30fc\u30b0\u304c\u4e00\u76ee\u3067\u5206\u304b\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u5358\u306a\u308b\u8a18\u9332\u3067\u306f\u306a\u304f\u3001\u3053\u308c\u304b\u3089\u5148\u306e\u4e88\u6e2c\u7cbe\u5ea6\u3092\u5287\u7684\u306b\u4e0a\u3052\u308b\u305f\u3081\u306e\u300c\u500b\u4eba\u5c02\u7528\u30c7\u30fc\u30bf\u300d\u3067\u3059\u3002",
