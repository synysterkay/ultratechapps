{
  "subject": "\u0421\u0435\u043a\u0440\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0442 \u0442\u0435\u0431\u0435 20 \u043c\u0438\u043d\u0443\u0442",
  "preview_text": "\u041a\u0430\u043a \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0437\u0430 2 \u043c\u0438\u043d\u0443\u0442\u044b \u0442\u043e, \u043d\u0430 \u0447\u0442\u043e \u0443\u0445\u043e\u0434\u0438\u043b\u043e \u043f\u043e\u043b\u0447\u0430\u0441\u0430. \u0422\u044b \u0431\u0443\u0434\u0435\u0448\u044c \u0432 \u0448\u043e\u043a\u0435.",
  "body_paragraphs": [
    "\u042f \u0437\u043d\u0430\u044e, \u0442\u044b \u043f\u0440\u0438\u0432\u044b\u043a \u0442\u0440\u0430\u0442\u0438\u0442\u044c \u043a\u0443\u0447\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043d\u0430 \u0430\u043d\u0430\u043b\u0438\u0437 \u043c\u0430\u0442\u0447\u0435\u0439: \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u0434\u0435\u0441\u044f\u0442\u043a\u0438 \u0432\u043a\u043b\u0430\u0434\u043e\u043a, \u0441\u0432\u0435\u0440\u044f\u0442\u044c \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443, \u0447\u0438\u0442\u0430\u0442\u044c \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u044b. \u0410 \u043f\u043e\u0442\u043e\u043c \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u043e\u0448\u0438\u0431\u0430\u0442\u044c\u0441\u044f. \u0423 \u043c\u0435\u043d\u044f \u0431\u044b\u043b\u043e \u0442\u0430\u043a \u0436\u0435, \u043f\u043e\u043a\u0430 \u044f \u043d\u0435 \u043d\u0430\u0448\u0451\u043b \u043e\u0434\u043d\u0443 \u0444\u0438\u0448\u043a\u0443 \u0432 Predictify.",
    "\u041e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e\u0431\u044b \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0442\u043e\u0447\u043d\u044b\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437, \u043d\u0443\u0436\u043d\u043e \u0432\u0441\u0435\u0433\u043e 2 \u043c\u0438\u043d\u0443\u0442\u044b. \u0417\u0430\u0445\u043e\u0434\u0438\u0448\u044c, \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0448\u044c \u043c\u0430\u0442\u0447, \u0441\u043c\u043e\u0442\u0440\u0438\u0448\u044c \u043d\u0430 Confidence Score \u043e\u0442 AI \u2014 \u0438 \u0432\u0441\u0451. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 \u043a\u043e\u043f\u0430\u043d\u0438\u0439 \u0432 xG, possession \u0438\u043b\u0438 defensive strength. \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0443\u0436\u0435 \u043f\u0435\u0440\u0435\u0432\u0430\u0440\u0438\u043b \u0442\u044b\u0441\u044f\u0447\u0438 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0438 \u0432\u044b\u0434\u0430\u043b \u0433\u043e\u0442\u043e\u0432\u044b\u0439 \u043e\u0442\u0432\u0435\u0442.",
    "\u0421\u0435\u0440\u044c\u0451\u0437\u043d\u043e, \u044d\u0442\u043e \u043a\u0430\u043a \u0435\u0441\u043b\u0438 \u0431\u044b \u0443 \u0442\u0435\u0431\u044f \u0431\u044b\u043b \u043b\u0438\u0447\u043d\u044b\u0439 \u0430\u043d\u0430\u043b\u0438\u0442\u0438\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0437\u0430 \u0441\u0435\u043a\u0443\u043d\u0434\u0443 \u043f\u043e\u0434\u0441\u043e\u0432\u044b\u0432\u0430\u0435\u0442 \u0448\u043f\u0430\u0440\u0433\u0430\u043b\u043a\u0443. \u041d\u0430 \u0434\u043d\u044f\u0445 \u044f \u0442\u0430\u043a \u043f\u043e\u0434\u043d\u044f\u043b \u0441\u0435\u0431\u0435 \u043a\u0440\u0435\u0434\u0438\u0442\u044b \u2014 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043d\u0430 \u043f\u043e\u0431\u0435\u0434\u0443 \u00ab\u0420\u0435\u0430\u043b\u0430\u00bb \u0432 \u0434\u0435\u0440\u0431\u0438, AI \u0434\u0430\u043b 87% \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u0438. \u0417\u0430\u0448\u043b\u043e. \u0422\u044b \u043c\u043e\u0436\u0435\u0448\u044c \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0442\u043e \u0436\u0435 \u0441\u0430\u043c\u043e\u0435: \u043e\u0442\u043a\u0440\u043e\u0439 \u0432\u043a\u043b\u0430\u0434\u043a\u0443 \u00ab\u041c\u0430\u0442\u0447\u0438\u00bb \u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043c\u043e\u0442\u0440\u0438 \u043d\u0430 \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u043e\u0442 \u0441\u0430\u043c\u044b\u0445 \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u043e\u0432.",
    "\u0425\u0432\u0430\u0442\u0438\u0442 \u0433\u0430\u0434\u0430\u0442\u044c. \u0417\u0430\u0439\u0434\u0438 \u0432 Predictify \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441, \u0432\u044b\u0431\u0435\u0440\u0438 \u043b\u044e\u0431\u043e\u0439 \u043c\u0430\u0442\u0447 \u0438 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438, \u0447\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442 AI. P.S. \u041a\u0441\u0442\u0430\u0442\u0438, \u0435\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u0435\u0449\u0451 \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u2014 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0443\u0439 Premium \u043d\u0430 3 \u0434\u043d\u044f \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e. \u0422\u0430\u043c \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b \u0432\u0441\u0435 \u043b\u0438\u0433\u0438 \u0438 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u0430\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430. \u041d\u043e \u0434\u0430\u0436\u0435 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e \u044d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043a\u0430\u043a \u0447\u0430\u0441\u044b."
