{
  "subject": "2 \u043c\u0438\u043d\u0443\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0437\u0430\u043c\u0435\u043d\u044f\u0442 20",
  "preview_text": "\u0417\u0430\u0431\u0443\u0434\u044c\u0442\u0435 \u043e \u0447\u0430\u0441\u0430\u0445 \u0430\u043d\u0430\u043b\u0438\u0437\u0430. \u041f\u043e\u043a\u0430\u0436\u0438\u0442\u0435, \u043a\u0430\u043a Predictify \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0442 \u0432\u0440\u0435\u043c\u044f \u043d\u0430 \u0441\u0442\u0430\u0432\u043a\u0430\u0445.",
  "body_paragraphs": [
    "\u041f\u043e\u043c\u043d\u0438\u0442\u0435 \u0442\u043e\u0442 \u0432\u0435\u0447\u0435\u0440, \u043a\u043e\u0433\u0434\u0430 \u0432\u044b \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u043b\u0438 \u0447\u0430\u0441 \u043d\u0430 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u0444\u043e\u0440\u043c, \u0442\u0440\u0430\u0432\u043c \u0438 \u043f\u043e\u0433\u043e\u0434\u044b, \u0430 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u043e \u043d\u0435 \u0441\u0440\u0430\u0431\u043e\u0442\u0430\u043b? \u042f \u0442\u043e\u0436\u0435 \u0447\u0435\u0440\u0435\u0437 \u044d\u0442\u043e \u043f\u0440\u043e\u0448\u0435\u043b. \u041d\u043e \u043f\u043e\u0442\u043e\u043c \u043f\u043e\u043d\u044f\u043b: 80% \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b \u0431\u0435\u0440\u0435\u0442 \u043d\u0430 \u0441\u0435\u0431\u044f \u0418\u0418. \u0412\u043e\u0442 \u043a\u0430\u043a \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0437\u0430 2 \u043c\u0438\u043d\u0443\u0442\u044b \u0442\u043e, \u0447\u0442\u043e \u0440\u0430\u043d\u044c\u0448\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u043b\u043e 20.",
    "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 Predictify \u0438 \u043f\u0435\u0440\u0435\u0439\u0434\u0438\u0442\u0435 \u043a \u043c\u0430\u0442\u0447\u0443, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u0430\u0441 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442. \u041d\u0435 \u0447\u0438\u0442\u0430\u0439\u0442\u0435 10 \u0441\u0442\u0430\u0442\u0435\u0439 \u2014 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0437\u0433\u043b\u044f\u043d\u0438\u0442\u0435 \u043d\u0430 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0418\u0418. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u00ab\u041b\u0438\u0432\u0435\u0440\u043f\u0443\u043b\u044c \u2014 \u041c\u0430\u043d \u0421\u0438\u0442\u0438: 72%\u00bb. \u042d\u0442\u043e \u043d\u0435 \u0434\u043e\u0433\u0430\u0434\u043a\u0430, \u044d\u0442\u043e \u0430\u043d\u0430\u043b\u0438\u0437 \u0442\u044b\u0441\u044f\u0447 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445: xG, \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u0435, \u0441\u0438\u043b\u0430 \u0437\u0430\u0449\u0438\u0442\u044b, \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u0432\u0441\u0442\u0440\u0435\u0447. \u0412\u0430\u043c \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0435\u0448\u0438\u0442\u044c, \u0438\u0433\u0440\u0430\u0442\u044c \u043f\u043e \u043d\u0435\u043c\u0443 \u0438\u043b\u0438 \u043d\u0435\u0442.",
    "\u0424\u0443\u043d\u043a\u0446\u0438\u044f \u00ab\u041a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440 \u0441\u0442\u0430\u0432\u043e\u043a\u00bb \u0434\u0435\u043b\u0430\u0435\u0442 \u0438\u043c\u0435\u043d\u043d\u043e \u044d\u0442\u043e: \u0432\u044b \u0432\u0432\u043e\u0434\u0438\u0442\u0435 \u043a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442, \u0418\u0418 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u0435\u0441\u0442\u044c \u043b\u0438 \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u044c. \u0420\u0430\u043d\u044c\u0448\u0435 \u044f \u0441\u0447\u0438\u0442\u0430\u043b \u0432\u0440\u0443\u0447\u043d\u0443\u044e, \u0441\u0432\u0435\u0440\u044f\u043b\u0441\u044f \u0441 \u0440\u044b\u043d\u043a\u0430\u043c\u0438. \u0422\u0435\u043f\u0435\u0440\u044c \u044d\u0442\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 2 \u043c\u0438\u043d\u0443\u0442\u044b. \u0418 \u0434\u0430, \u0432\u044b \u0432\u0441\u0435 \u0435\u0449\u0435 \u043c\u043e\u0436\u0435\u0442\u0435 \u043a\u043e\u043f\u0430\u0442\u044c \u0433\u043b\u0443\u0431\u0436\u0435 \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0430\u0445 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438, \u043d\u043e \u043d\u0430\u0447\u0430\u0442\u044c \u0441\u0442\u043e\u0438\u0442 \u0441 \u044d\u0442\u043e\u0433\u043e.",
    "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 Predictify \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441, \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043b\u044e\u0431\u043e\u0439 \u043c\u0430\u0442\u0447 \u0438\u0437 \u0442\u043e\u043f-\u043b\u0438\u0433\u0438 \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0418\u0418. \u0423\u0432\u0438\u0434\u0438\u0442\u0435, \u043a\u0430\u043a \u0431\u044b\u0441\u0442\u0440\u043e \u044d\u0442\u043e \u043c\u0435\u043d\u044f\u0435\u0442 \u043f\u043e\u0434\u0445\u043e\u0434. P.S. \u0417\u0430 3 \u0434\u043d\u044f \u043f\u0440\u0435\u043c\u0438\u0443\u043c-\u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u0432\u044b \u0443\u0437\u043d\u0430\u0435\u0442\u0435, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0442\u0435\u0440\u044f\u043b\u0438 \u0440\u0430\u043d\u044c\u0448\u0435."
  ],
