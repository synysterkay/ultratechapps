{
  "subject": "\u0935\u0939 2AM \u0915\u093e \u092a\u093e\u0917\u0932\u092a\u0928 \u091c\u093f\u0938\u0928\u0947 \u0938\u092c \u092c\u0926\u0932 \u0926\u093f\u092f\u093e",
  "preview_text": "\u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u091f\u094d\u0930\u093f\u0915 \u091c\u094b \u0906\u092a\u0915\u0947 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0942\u0938\u094d\u091f\u0930 \u0915\u094b 10 \u0917\u0941\u0928\u093e \u091c\u094d\u092f\u093e\u0926\u093e \u0909\u092a\u092f\u094b\u0917\u0940 \u092c\u0928\u093e \u0926\u0947\u0917\u0940\u0964 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0915\u0947\u0964",
  "body_paragraphs": [
    "\u0930\u093e\u0924 \u0915\u0947 2 \u092c\u091c\u0947 \u0925\u0947\u0964 \u092e\u0948\u0902 \u090f\u0915 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u0941\u0928 \u0930\u0939\u093e \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0907\u0924\u0928\u093e \u0915\u092e \u0925\u093e \u0915\u093f \u0915\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u091c\u093e \u0930\u0939\u093e \u0925\u093e\u0964 \u0924\u092d\u0940 \u090f\u0915 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0906\u092f\u093e\u2014\u092c\u0940\u091a \u092e\u0947\u0902, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0915\u0947\u0964 \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u093e \u092b\u094b\u0928 \u092b\u0947\u0902\u0915\u0928\u0947 \u0915\u093e \u092e\u0928 \u0915\u093f\u092f\u093e\u0964 \u092b\u093f\u0930 \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e: \u0910\u0938\u093e \u0915\u094d\u092f\u094b\u0902 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0924\u093e \u0915\u093f \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u0947, \u0932\u0947\u0915\u093f\u0928 \u0938\u092c \u0915\u0941\u091b \u0936\u093e\u0902\u0924 \u0930\u0939\u0947?",
    "\u092f\u0939\u0940 \u0935\u0939 \u092a\u0932 \u0925\u093e \u091c\u092c \u092e\u0948\u0902\u0928\u0947 \u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u091f\u094d\u0930\u093f\u0915 \u0916\u094b\u091c\u0940\u2014\u091c\u094b \u0906\u092a\u0915\u0947 Volume Booster Pro \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u092c\u0926\u0932 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0915\u094b\u0908 \u0938\u0947\u091f\u093f\u0902\u0917 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0915\u094b\u0908 \u0939\u0948\u0915 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092c\u0938 \u090f\u0915 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0939\u0948, \u091c\u094b \u0906\u092a\u0915\u0947 \u0939\u0930 \u0911\u0921\u093f\u092f\u094b \u0938\u094b\u0930\u094d\u0938 \u092a\u0930 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u2014\u091a\u093e\u0939\u0947 \u0935\u0939 Spotify \u0939\u094b, YouTube, \u092f\u093e \u0915\u094b\u0908 \u0917\u0947\u092e\u0964 \u0914\u0930 \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u0940 \u092c\u093e\u0924? \u092f\u0939 \u0916\u0941\u0926 \u0915\u094b \u0939\u0947\u0921\u092b\u094b\u0928 \u0932\u0917\u093e\u0924\u0947 \u0939\u0940 \u0911\u091f\u094b\u092e\u0948\u091f\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0932\u093e\u0917\u0942 \u0915\u0930 \u0932\u0947\u0924\u093e \u0939\u0948\u0964 \u092b\u093f\u0930 \u0906\u092a\u0915\u094b \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0915\u0930\u0928\u093e \u092a\u0921\u093c\u0924\u093e\u0964",
    "\u0906\u092a\u0928\u0947 \u0936\u093e\u092f\u0926 \u0927\u094d\u092f\u093e\u0928 \u0928\u0939\u0940\u0902 \u0926\u093f\u092f\u093e, \u0932\u0947\u0915\u093f\u0928 \u0939\u092e\u093e\u0930\u0947 \u0910\u092a \u092e\u0947\u0902 \u090f\u0915 \u0916\u093e\u0938 \u092b\u0940\u091a\u0930 \u0939\u0948\u2014'Auto-Apply on Headphone Connect'\u0964 \u092f\u0939 \u0935\u0939\u0940 \u0939\u0948 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0909\u0938 \u0930\u093e\u0924 \u0916\u094b\u091c\u093e \u0925\u093e\u0964 \u091c\u092c \u0906\u092a \u0907\u0938\u0947 \u091a\u093e\u0932\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0910\u092a \u0906\u092a\u0915\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0932\u0947\u0935\u0932 \u0915\u094b \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948 \u0914\u0930 \u0939\u0930 \u092c\u093e\u0930 \u0939\u0947\u0921\u092b\u094b\u0928 \u0932\u0917\u093e\u0928\u0947 \u092a\u0930 \u0935\u0939\u0940 \u0938\u0947\u091f \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0915\u094b\u0908 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0928\u093e\u0917 \u0928\u0939\u0940\u0902\u2014\u092c\u0938 \u0938\u093e\u0907\u0932\u0947\u0902\u091f \u092f\u0942\u091f\u093f\u0932\u093f\u091f\u0940\u0964 \u092f\u0939 \u0906\u092a\u0915\u0940 \u0905\u0932\u093e\u0930\u094d\u092e \u0918\u0921\u093c\u0940 \u0915\u0940 \u0924\u0930\u0939 \u0939\u0948, \u091c\u094b \u092c\u093f\u0928\u093e \u0915\u0941\u091b \u0915\u0939\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u0940 \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e\u090f\u0902: \u0910\u092a \u0916\u094b\u0932\u0947\u0902, \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u091c\u093e\u090f\u0902, \u0914\u0930 'Auto-Apply on Headphone Connect' \u0915\u094b \u0911\u0928 \u0915\u0930\u0947\u0902\u0964 \u092b\u093f\u0930 \u090f\u0915 \u092c\u093e\u0930 \u0939\u0947\u0921\u092b\u094b\u0928 \u0932\u0917\u093e\u090f\u0902 \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0915\u0948\u0938\u0947 \u0938\u092c \u0915\u0941\u091b \u092c\u0926\u0932 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 P.S. \u092f\u0939 \u091f\u094d\u0930\u093f\u0915 Premium \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092c\u0928\u093e\u0908 \u0917\u0908 \u0939\u0948\u2014\u0932\u0947\u0915\u093f\u0928 \u0906\u092a \u0907\u0938\u0947 \u092b\u094d\u0930\u0940 \u091f\u094d\u0930\u093e\u092f\u0932 \u0915\u0947 \u0938\u093e\u0925 \u092d\u0940 \u0906\u091c\u093c\u092e\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u0938 \u090f\u0915 \u0915\u094d\u0932\u093f\u0915\u0964"
  ],
