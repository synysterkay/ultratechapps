{
  "subject": "\u0627\u0644\u062e\u0637\u0623 \u0627\u0644\u0630\u064a \u064a\u0642\u062a\u0644 \u0631\u0648\u0645\u0627\u0646\u0633\u064a\u062a\u0643",
  "preview_text": "\u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0633\u0628\u0628 \u0627\u0644\u0630\u064a \u064a\u062c\u0639\u0644\u0643 \u062a\u0638\u0644 \u0639\u0627\u0644\u0642\u0627 \u0641\u064a \u0631\u0648\u062a\u064a\u0646 \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f... \u0648\u0643\u064a\u0641\u064a\u0629 \u0625\u0635\u0644\u0627\u062d\u0647 \u0641\u064a \u062b\u0648\u0627\u0646\u064d",
  "body_paragraphs": [
    "\u062a\u062e\u064a\u0644 \u0623\u0646\u0643 \u062a\u062e\u0637\u0637 \u0644\u0645\u0648\u0639\u062f \u0645\u062b\u0627\u0644\u064a\u060c \u0644\u0643\u0646\u0643 \u0641\u064a \u0627\u0644\u0646\u0647\u0627\u064a\u0629 \u062a\u0634\u0639\u0631 \u0628\u0627\u0644\u0645\u0644\u0644 \u0648\u0627\u0644\u062a\u0643\u0631\u0627\u0631. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u062e\u0637\u0623 \u0627\u0644\u0623\u0643\u062b\u0631 \u0634\u064a\u0648\u0639\u0627 \u0627\u0644\u0630\u064a \u0623\u0631\u062a\u0643\u0628\u0647 90% \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646: \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0639\u0644\u0649 \u0646\u0641\u0633 \u0627\u0644\u0623\u0641\u0643\u0627\u0631 \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u062f\u0648\u0646 \u062a\u062c\u062f\u064a\u062f.",
    "\u0639\u0646\u062f\u0645\u0627 \u062a\u0638\u0644 \u062a\u0643\u0631\u0631 \u0646\u0641\u0633 \u0627\u0644\u0623\u0645\u0627\u0643\u0646 \u0648\u0627\u0644\u0623\u0646\u0634\u0637\u0629\u060c \u064a\u062a\u062d\u0648\u0644 \u0627\u0644\u0645\u0648\u0639\u062f \u0645\u0646 \u0645\u063a\u0627\u0645\u0631\u0629 \u0625\u0644\u0649 \u0631\u0648\u062a\u064a\u0646 \u0645\u0645\u0644. \u0644\u064a\u0633 \u0644\u0623\u0646\u0643 \u0644\u0627 \u062a\u0647\u062a\u0645\u060c \u0628\u0644 \u0644\u0623\u0646\u0643 \u0644\u0627 \u062a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0623\u062f\u0627\u0629 \u0627\u0644\u0635\u062d\u064a\u062d\u0629. \u0627\u0644\u062d\u0644 \u0628\u0633\u064a\u0637: \u0627\u0633\u062a\u062e\u062f\u0645 \u0645\u064a\u0632\u0629 '\u0627\u0644\u0645\u0641\u0627\u062c\u0623\u0629' \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0644\u062a\u062c\u0631\u0628\u0629 \u0634\u064a\u0621 \u063a\u064a\u0631 \u0645\u062a\u0648\u0642\u0639.",
    "\u0641\u064a SoulPlan: Plan Dates Together\u060c \u064a\u0645\u0643\u0646\u0643 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u064a\u0632\u0629 '\u0645\u062e\u0637\u0637 \u0627\u0644\u0645\u0641\u0627\u062c\u0622\u062a' \u062d\u064a\u062b \u064a\u062e\u0637\u0637 \u0623\u062d\u062f \u0627\u0644\u0634\u0631\u064a\u0643\u064a\u0646 \u0644\u0644\u0645\u0648\u0639\u062f \u062f\u0648\u0646 \u0639\u0644\u0645 \u0627\u0644\u0622\u062e\u0631. \u0647\u0630\u0627 \u064a\u062e\u0644\u0642 \u0639\u0646\u0635\u0631 \u0627\u0644\u0645\u0641\u0627\u062c\u0623\u0629 \u0648\u064a\u0642\u062a\u0644 \u0627\u0644\u0631\u0648\u062a\u064a\u0646. \u062c\u0631\u0628\u0647\u0627 \u0627\u0644\u0644\u064a\u0644\u0629\u060c \u0648\u0633\u062a\u0634\u0639\u0631 \u0628\u0627\u0644\u0641\u0631\u0642.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646 \u0648\u0627\u0633\u062a\u062e\u062f\u0645 \u0645\u064a\u0632\u0629 '\u0645\u0641\u0627\u062c\u0623\u0629' \u0644\u062a\u062d\u0636\u064a\u0631 \u0645\u0648\u0639\u062f \u063a\u064a\u0631 \u0645\u062a\u0648\u0642\u0639 \u0644\u0634\u0631\u064a\u0643\u0643. P.S. \u0623\u0643\u062b\u0631 \u0645\u0646 230 \u0632\u0648\u062c\u0627 \u0642\u0627\u0644\u0648\u0627 \u0625\u0646 \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0648\u062d\u062f\u0647\u0627 \u0623\u0646\u0642\u0630\u062a \u0639\u0644\u0627\u0642\u062a\u0647\u0645 \u0645\u0646 \u0627\u0644\u0645\u0644\u0644."
  ],
