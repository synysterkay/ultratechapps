{
  "subject": "68 \u0926\u093f\u0928 \u092c\u093e\u0926 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u0930\u093e\u091c",
  "preview_text": "\u091c\u094b \u0939\u092e\u0928\u0947 \u0915\u0947\u0935\u0932 \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u0915\u0947 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u092c\u0924\u093e\u092f\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0935\u093f\u0936\u0947\u0937 \u0911\u092b\u0930\u0964",
  "body_paragraphs": [
    "\u0906\u092a\u0928\u0947 68 \u0926\u093f\u0928 \u092a\u0939\u0932\u0947 Volume Booster Pro \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0925\u093e\u0964 \u0939\u092e \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u0939\u0948\u0902 \u091c\u094b \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u0915\u093e\u092e \u0915\u0930\u0947 \u2014 \u0915\u094b\u0908 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0928\u094b\u091f\u093f\u092b\u093c\u093f\u0915\u0947\u0936\u0928 \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u091d\u0902\u091d\u091f \u0928\u0939\u0940\u0902\u0964 \u0907\u0938\u0915\u0947 \u0932\u093f\u090f \u0927\u0928\u094d\u092f\u0935\u093e\u0926\u0964",
    "\u0939\u092e\u0928\u0947 \u090f\u0915 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u092c\u0928\u093e\u0908 \u0939\u0948 \u091c\u094b \u0915\u0947\u0935\u0932 \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u0915\u0947 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0964 \u092f\u0939 \u0915\u094b\u0908 \u0928\u092f\u093e \u092b\u0940\u091a\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u0924\u0930\u0940\u0915\u093e \u0939\u0948 \u091c\u093f\u0938\u0938\u0947 \u0906\u092a \u0905\u092a\u0928\u0947 \u0910\u092a \u0915\u094b \u0914\u0930 \u092d\u0940 \u091a\u0941\u092a\u091a\u093e\u092a \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0939\u092e\u093e\u0930\u093e '\u0917\u0941\u092a\u094d\u0924 \u092e\u094b\u0921' \u0939\u0948 \u2014 \u091c\u092c \u0906\u092a \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0905\u092a\u0928\u0947 \u0906\u092a +200% \u092c\u0922\u093c \u091c\u093e\u0924\u093e \u0939\u0948, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0915\u0947\u0964 \u092c\u0938 \u0932\u0917\u093e\u0913 \u0914\u0930 \u092d\u0942\u0932 \u091c\u093e\u0913\u0964",
    "\u0907\u0938\u0947 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u091c\u093e\u090f\u0902\u0964 \u0935\u0939\u093e\u0901 '\u0911\u091f\u094b \u092c\u0942\u0938\u094d\u091f' \u091f\u0949\u0917\u0932 \u0915\u094b \u0911\u0928 \u0915\u0930\u0947\u0902\u0964 \u092b\u093f\u0930 \u0905\u0917\u0932\u0940 \u092c\u093e\u0930 \u091c\u092c \u0906\u092a \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0932\u0917\u093e\u090f\u0902\u0917\u0947, \u0924\u094b \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0905\u092a\u0928\u0947 \u0906\u092a \u092c\u0922\u093c \u091c\u093e\u090f\u0917\u093e \u2014 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0928\u094b\u091f\u093f\u092b\u093c\u093f\u0915\u0947\u0936\u0928 \u092f\u093e \u092a\u0949\u092a-\u0905\u092a \u0915\u0947\u0964 \u092f\u0939 \u0935\u0939\u0940 \u091a\u0941\u092a\u091a\u093e\u092a \u0915\u093e\u092e \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u0905\u0928\u0941\u092d\u0935 \u0939\u0948 \u091c\u093f\u0938\u0947 \u0939\u092e\u0928\u0947 \u0921\u093f\u091c\u093c\u093e\u0907\u0928 \u0915\u093f\u092f\u093e \u0939\u0948\u0964",
    "P.S. \u092f\u0939 \u092b\u0940\u091a\u0930 \u0915\u0947\u0935\u0932 \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948 \u091c\u094b 60 \u0926\u093f\u0928 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0938\u092e\u092f \u0924\u0915 \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a \u0907\u0938\u0947 \u0939\u0915\u0926\u093e\u0930 \u0939\u0948\u0902\u0964"
  ],
