{
  "subject": "9 \u0442\u044b\u0441\u044f\u0447 \u0441\u043b\u0443\u0448\u0430\u044e\u0442 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u2014 \u0438 \u0442\u044b \u043d\u0435\u0442",
  "preview_text": "\u041f\u043e\u043a\u0430 \u0442\u044b \u0447\u0438\u0442\u0430\u0435\u0448\u044c \u044d\u0442\u043e, \u0432 Bass Booster \u0443\u0436\u0435 9 \u0442\u044b\u0441\u044f\u0447 \u0447\u0435\u043b\u043e\u0432\u0435\u043a. \u041e\u043d\u0438 \u0443\u0441\u043b\u044b\u0448\u0430\u043b\u0438 \u0431\u0430\u0441, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0443 \u0442\u0435\u0431\u044f \u043d\u0435\u0442. \u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u2014 \u0443\u0431\u0435\u0434\u0438\u0441\u044c \u0441\u0430\u043c.",
  "body_paragraphs": [
    "\u041f\u043e\u043a\u0430 \u0442\u044b \u0447\u0438\u0442\u0430\u0435\u0448\u044c \u044d\u0442\u043e, 9 000 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0443\u0436\u0435 \u0441\u043b\u0443\u0448\u0430\u044e\u0442 \u043c\u0443\u0437\u044b\u043a\u0443 \u0432 Bass Booster. \u041d\u0435 \u0432\u0447\u0435\u0440\u0430, \u043d\u0435 \u0437\u0430\u0432\u0442\u0440\u0430 \u2014 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u0418 \u0443 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0438\u0437 \u043d\u0438\u0445 \u0431\u0430\u0441 \u0431\u044c\u0451\u0442 \u0432 \u0433\u0440\u0443\u0434\u044c, \u0434\u0430\u0436\u0435 \u043d\u0430 \u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u0445. \u0410 \u0442\u044b \u0432\u0441\u0451 \u0435\u0449\u0451 \u0442\u0435\u0440\u043f\u0438\u0448\u044c \u043f\u043b\u043e\u0441\u043a\u0438\u0439 \u0437\u0432\u0443\u043a?",
    "\u0412\u043e\u0442 \u0447\u0442\u043e \u0441\u043b\u0443\u0447\u0438\u043b\u043e\u0441\u044c \u0441\u0435\u0433\u043e\u0434\u043d\u044f: \u043e\u0434\u0438\u043d \u043f\u0430\u0440\u0435\u043d\u044c \u0432\u043a\u043b\u044e\u0447\u0438\u043b \u0442\u0440\u0435\u043a Kanye West \u2014 \u00abPraise God\u00bb \u0447\u0435\u0440\u0435\u0437 Bass Booster, \u0438 \u0435\u0433\u043e \u043a\u043e\u043b\u043e\u043d\u043a\u0430 \u0432 \u043c\u0430\u0448\u0438\u043d\u0435 \u0447\u0443\u0442\u044c \u043d\u0435 \u043b\u043e\u043f\u043d\u0443\u043b\u0430 \u043e\u0442 \u0431\u0430\u0441\u0430. \u0414\u0440\u0443\u0433\u043e\u0439 \u2014 \u043d\u0430\u0448\u0451\u043b \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0443 \u0434\u043b\u044f \u00abBohemian Rhapsody\u00bb, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0437\u0432\u0443\u0447\u0438\u0442 \u043a\u0430\u043a \u0436\u0438\u0432\u043e\u0439 \u043a\u043e\u043d\u0446\u0435\u0440\u0442. \u0422\u0440\u0435\u0442\u0438\u0439 \u2014 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u0434\u0432\u0438\u043d\u0443\u043b \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a Boost \u0438 \u0437\u0430\u0431\u044b\u043b, \u0447\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0442\u0438\u0448\u0438\u043d\u0430. \u0418 \u044d\u0442\u043e \u043d\u0435 \u0435\u0434\u0438\u043d\u0438\u0447\u043d\u044b\u0435 \u0441\u043b\u0443\u0447\u0430\u0438 \u2014 \u044d\u0442\u043e \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c.",
    "\u0423 \u0442\u0435\u0431\u044f \u0443\u0436\u0435 \u0435\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u044d\u0442\u043e\u0439 \u0441\u0438\u043b\u0435. \u041e\u0442\u043a\u0440\u043e\u0439 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0432\u043a\u043b\u044e\u0447\u0438 \u043b\u044e\u0431\u043e\u0439 \u0442\u0440\u0435\u043a \u2014 \u0445\u043e\u0442\u044c Kendrick Lamar, \u0445\u043e\u0442\u044c Skrillex, \u0445\u043e\u0442\u044c AC/DC \u2014 \u0438 \u0441\u0434\u0432\u0438\u043d\u044c \u043f\u043e\u043b\u0437\u0443\u043d\u043e\u043a Boost \u0432\u043f\u0440\u0430\u0432\u043e. \u041f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0439 \u0440\u0430\u0437\u043d\u0438\u0446\u0443 \u0437\u0430 3 \u0441\u0435\u043a\u0443\u043d\u0434\u044b. \u0415\u0441\u043b\u0438 \u0437\u0432\u0443\u043a \u043d\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0441\u043e\u0447\u043d\u0435\u0435, \u044f \u0441\u044a\u0435\u043c \u0441\u0432\u043e\u0438 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0438.",
    "\u041e\u0442\u043a\u0440\u043e\u0439 Bass Booster \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441. \u0421\u0434\u0432\u0438\u043d\u044c Boost \u043d\u0430 \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c. \u0418 \u043d\u0430\u043f\u0438\u0448\u0438 \u043c\u043d\u0435, \u0447\u0442\u043e \u0443\u0441\u043b\u044b\u0448\u0430\u043b. P.S. \u0415\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c, \u0447\u0442\u043e\u0431\u044b \u0431\u0430\u0441 \u0432\u0438\u0431\u0440\u0438\u0440\u043e\u0432\u0430\u043b \u0434\u0430\u0436\u0435 \u0432 \u0434\u0435\u0448\u0451\u0432\u044b\u0445 \u043d\u0430\u0443\u0448\u043d\u0438\u043a\u0430\u0445 \u2014 \u0432\u043a\u043b\u044e\u0447\u0438 Bass Virtualizer \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445. \u042d\u0442\u043e \u043a\u0430\u043a \u0441\u0430\u0431\u0432\u0443\u0444\u0435\u0440 \u0432 \u043a\u0430\u0440\u043c\u0430\u043d\u0435."
  ],
