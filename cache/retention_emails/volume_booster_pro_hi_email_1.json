{
  "subject": "30 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0938\u093e\u0909\u0902\u0921 \u092c\u0942\u0938\u094d\u091f, \u0915\u094b\u0908 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0928\u0939\u0940\u0902",
  "preview_text": "\u090f\u0915 \u0915\u094d\u0932\u093f\u0915, \u0924\u0940\u0928 \u0938\u0947\u0915\u0902\u0921, \u092b\u093f\u0930 \u092d\u0942\u0932 \u091c\u093e\u0907\u090f\u0964 \u092f\u0939\u0940 \u0939\u0948 Volume Booster Pro\u0964",
  "body_paragraphs": [
    "\u0906\u092a\u0928\u0947 \u092b\u094d\u0930\u0940 \u0935\u0930\u094d\u091c\u0928 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e \u2014 \u0914\u0930 \u092c\u0940\u091a-\u092c\u0940\u091a \u092e\u0947\u0902 \u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928\u094b\u0902 \u0938\u0947 \u092a\u0930\u0947\u0936\u093e\u0928 \u0939\u0941\u090f\u0964",
    "\u0939\u092e\u0928\u0947 \u0935\u0939\u0940 \u092c\u0942\u0938\u094d\u091f \u0907\u0902\u091c\u0928 \u0932\u093f\u092f\u093e, \u0938\u093f\u0930\u094d\u092b \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0939\u091f\u093e \u0926\u093f\u090f\u0964 \u0905\u092c \u0915\u094b\u0908 \u092a\u0949\u092a-\u0905\u092a \u0928\u0939\u0940\u0902, \u0915\u094b\u0908 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0928\u0939\u0940\u0902\u0964 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0914\u0930 \u090f\u0915 EQ\u0964",
    "\u0939\u0947\u0921\u092b\u094b\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b\u0924\u0947 \u0939\u0940 \u0911\u091f\u094b-\u090f\u092a\u094d\u0932\u093e\u0908 \u0939\u094b\u0924\u093e \u0939\u0948 \u2014 \u092b\u093f\u0930 \u0906\u092a\u0915\u0947 \u0930\u093e\u0938\u094d\u0924\u0947 \u0938\u0947 \u0939\u091f \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0938\u094d\u092a\u0949\u091f\u093f\u092b\u093e\u0908, \u092f\u0942\u091f\u094d\u092f\u0942\u092c, \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u2014 \u0938\u092c \u092a\u0930 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0938\u094d\u0932\u093e\u0907\u0921\u0930 \u0915\u094b +200% \u092a\u0930 \u0932\u0947 \u091c\u093e\u090f\u0902\u0964 \u0926\u0947\u0916\u093f\u090f \u0915\u093f\u0924\u0928\u093e \u0938\u093e\u092b \u0914\u0930 \u0924\u0947\u091c\u093c \u0939\u0948\u0964 P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u090f\u0915 \u092c\u093e\u0930 \u0915\u093e \u092a\u0947\u092e\u0947\u0902\u091f \u092f\u093e \u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093f\u092a\u094d\u0936\u0928 \u2014 \u0926\u094b\u0928\u094b\u0902 \u092e\u0947\u0902 \u092a\u0942\u0930\u093e \u092b\u0940\u091a\u0930 \u0905\u0928\u0932\u0949\u0915\u0964"
