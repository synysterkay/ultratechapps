{
  "subject": "\u0935\u094b \u092b\u0940\u091a\u0930 \u091c\u094b 42 \u0926\u093f\u0928 \u092c\u093e\u0926 \u0906 \u0930\u0939\u093e \u0939\u0948",
  "preview_text": "\u0905\u092d\u0940 \u0938\u093f\u0930\u094d\u092b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u091d\u0932\u0915\u0964 \u092c\u093e\u0915\u0940 \u0938\u092c\u0915\u094b \u092c\u093e\u0926 \u092e\u0947\u0902 \u092a\u0924\u093e \u091a\u0932\u0947\u0917\u093e\u0964",
  "body_paragraphs": [
    "\u0915\u0932 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092e\u0948\u0902\u0928\u0947 \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u092a\u0930 \u0915\u0941\u091b \u0910\u0938\u093e \u0938\u0941\u0928\u093e \u091c\u094b \u092e\u0948\u0902 \u092d\u0942\u0932 \u0928\u0939\u0940\u0902 \u092a\u093e\u092f\u093e\u0964 \u092c\u093e\u0938 \u0907\u0924\u0928\u093e \u0917\u0939\u0930\u093e \u0925\u093e \u0915\u093f \u0932\u0917\u093e \u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u0938\u092c\u0935\u0942\u092b\u0930 \u092e\u0947\u0930\u0947 \u0915\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0927\u0921\u093c\u0915 \u0930\u0939\u093e \u0939\u094b\u0964",
    "\u0935\u094b \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u091f\u0947\u0938\u094d\u091f \u0925\u093e\u2014\u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0928\u0947 \u090f\u0915 \u0928\u092f\u093e \u092b\u0940\u091a\u0930 \u092c\u0928\u093e\u092f\u093e \u0939\u0948 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0908\u092f\u0930\u092c\u0921\u094d\u0938 \u0915\u094b \u0905\u0938\u0932\u0940 \u0925\u093f\u090f\u091f\u0930 \u092e\u0947\u0902 \u092c\u0926\u0932 \u0926\u0947\u0917\u093e\u0964 \u0905\u092d\u0940 \u092f\u0947 \u092c\u0940\u091f\u093e \u092e\u0947\u0902 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092e\u0948\u0902 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092a\u0939\u0932\u0947 \u092c\u0924\u093e \u0930\u0939\u093e \u0939\u0942\u0901 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0924\u0941\u092e \u0939\u092e\u093e\u0930\u0947 \u0936\u0941\u0930\u0941\u0906\u0924\u0940 \u092f\u0942\u091c\u093c\u0930 \u0939\u094b\u0964",
    "\u092f\u0947 \u0928\u092f\u093e '\u092c\u093e\u0938 \u0935\u0930\u094d\u091a\u0941\u0905\u0932\u093e\u0907\u091c\u093c\u0930 2.0' \u0939\u0930 \u0917\u093e\u0928\u0947 \u0915\u094b \u0910\u0938\u0947 \u092c\u091c\u093e\u090f\u0917\u093e \u091c\u0948\u0938\u0947 \u0924\u0941\u092e \u0932\u093e\u0907\u0935 \u0915\u0949\u0928\u094d\u0938\u0930\u094d\u091f \u092e\u0947\u0902 \u0939\u094b\u0964 \u0939\u093f\u092a-\u0939\u0949\u092a \u0915\u093e \u0939\u0930 \u092c\u0940\u091f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u091b\u093e\u0924\u0940 \u092e\u0947\u0902 \u0917\u0942\u0902\u091c\u0947\u0917\u093e, EDM \u0915\u093e \u0921\u094d\u0930\u0949\u092a \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u091d\u0915\u091d\u094b\u0930 \u0926\u0947\u0917\u093e\u0964 \u092c\u0938 Bass Booster \u0916\u094b\u0932\u094b \u0914\u0930 '\u092a\u094d\u0930\u0940\u0938\u0947\u091f\u094d\u0938' \u092e\u0947\u0902 \u091c\u093e\u0913\u2014\u0935\u0939\u093e\u0901 '\u0938\u094d\u0928\u0940\u0915 \u092a\u0940\u0915' \u092c\u091f\u0928 \u0926\u093f\u0916\u0947\u0917\u093e\u0964",
    "\u0906\u091c \u0939\u0940 \u0907\u0938\u0947 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b \u0914\u0930 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0913 \u0915\u0948\u0938\u093e \u0932\u0917\u093e\u0964 \u092f\u0947 \u092b\u0940\u091a\u0930 \u0905\u0917\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u0938\u092c\u0915\u0947 \u0932\u093f\u090f \u0906\u090f\u0917\u093e, \u0932\u0947\u0915\u093f\u0928 \u0924\u0941\u092e \u092a\u0939\u0932\u0947 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u094b\u0964 P.S. \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u094b \u092f\u0947 \u0905\u0928\u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092e\u093f\u0932\u0947\u0917\u093e\u2014\u092c\u093e\u0915\u0940 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092c\u093e\u0930\u0964"
  ],
