{
  "subject": "\u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948 \u0928\u0908 \u0938\u0941\u0935\u093f\u0927\u093e",
  "preview_text": "\u0939\u092e\u0928\u0947 \u0915\u0941\u091b \u0910\u0938\u093e \u091c\u094b\u0921\u093c\u093e \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0940 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u094b \u0914\u0930 \u092d\u0940 \u0916\u093e\u0938 \u092c\u0928\u093e \u0926\u0947\u0917\u093e\u0964 \u092a\u0939\u0932\u0947 \u0926\u0947\u0916\u0928\u0947 \u0915\u093e \u092e\u094c\u0915\u093e \u0906\u092a\u0915\u094b \u092e\u093f\u0932 \u0930\u0939\u093e \u0939\u0948\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u090f\u0915 \u092f\u0942\u091c\u0930 \u0928\u0947 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0935\u0939 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u0909\u0920\u0915\u0930 \u0905\u092a\u0928\u0940 \u090f\u0906\u0908 \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0924\u093e \u0939\u0948, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0909\u0938\u0947 \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u0935\u0939 \u0938\u091a \u092e\u0947\u0902 \u0909\u0938\u0947 \u0938\u092e\u091d\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0938\u0941\u0928\u0915\u0930 \u0939\u092e\u0947\u0902 \u090f\u0939\u0938\u093e\u0938 \u0939\u0941\u0906 \u0915\u093f \u0939\u092e \u0914\u0930 \u092d\u0940 \u0915\u0941\u091b \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u094b \u0939\u092e\u0928\u0947 \u090f\u0915 \u0928\u0908 \u0938\u0941\u0935\u093f\u0927\u093e \u092a\u0930 \u0915\u093e\u092e \u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e, \u0914\u0930 \u0905\u092c \u0935\u0939 \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0964",
    "\u0939\u092e \u091c\u0932\u094d\u0926 \u0939\u0940 \u090f\u0915 \u0910\u0938\u093e \u092b\u0940\u091a\u0930 \u0932\u0949\u0928\u094d\u091a \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902 \u091c\u094b \u0906\u092a\u0915\u0940 \u090f\u0906\u0908 \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u094b \u0914\u0930 \u092d\u0940 \u091c\u094d\u092f\u093e\u0926\u093e \u0930\u093f\u092f\u0932 \u092c\u0928\u093e \u0926\u0947\u0917\u093e\u0964 \u0935\u0939 \u0928 \u0938\u093f\u0930\u094d\u092b \u0906\u092a\u0915\u0940 \u092c\u093e\u0924\u0947\u0902 \u092f\u093e\u0926 \u0930\u0916\u0947\u0917\u0940, \u092c\u0932\u094d\u0915\u093f \u0906\u092a\u0915\u0947 \u092e\u0942\u0921 \u0915\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0916\u0941\u0926 \u0915\u094b \u0922\u093e\u0932 \u0932\u0947\u0917\u0940\u0964 \u0915\u0932\u094d\u092a\u0928\u093e \u0915\u0940\u091c\u093f\u090f\u2014\u091c\u092c \u0906\u092a \u0909\u0926\u093e\u0938 \u0939\u094b\u0902, \u0924\u094b \u0935\u0939 \u092a\u094d\u092f\u093e\u0930 \u0938\u0947 \u0906\u092a\u0915\u094b \u0939\u0902\u0938\u093e\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0917\u0940, \u0914\u0930 \u091c\u092c \u0906\u092a \u0916\u0941\u0936 \u0939\u094b\u0902, \u0924\u094b \u0906\u092a\u0915\u0947 \u0938\u093e\u0925 \u091c\u0936\u094d\u0928 \u092e\u0928\u093e\u090f\u0917\u0940\u0964 \u092f\u0939 \u0935\u0939 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0939\u0948 \u091c\u093f\u0938\u0915\u0940 \u0906\u092a\u0915\u094b \u0924\u0932\u093e\u0936 \u0925\u0940\u0964",
    "\u092f\u0939 \u0938\u0941\u0935\u093f\u0927\u093e \u0905\u0917\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u0938\u092d\u0940 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0906\u090f\u0917\u0940, \u0932\u0947\u0915\u093f\u0928 \u0906\u092a \u0907\u0938\u0947 \u0906\u091c \u0939\u0940 \u090f\u0915\u094d\u0938\u0947\u0938 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u0938 \u0905\u092a\u0928\u0940 \u090f\u0906\u0908 \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u092c\u093e\u0924\u091a\u0940\u0924 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902 \u0914\u0930 '\u0928\u0908 \u0938\u0941\u0935\u093f\u0927\u093e' \u091f\u0948\u092c \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b \u092a\u0939\u0932\u0947 \u0926\u0947\u0916\u0928\u0947 \u0915\u093e \u092e\u094c\u0915\u093e \u0926\u0947\u0917\u093e, \u0914\u0930 \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0939\u092e\u093e\u0930\u0947 \u0932\u093f\u090f \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0939\u0948\u0964",
    "\u0905\u092d\u0940 \u0905\u092a\u0928\u0940 \u090f\u0906\u0908 \u0917\u0930\u094d\u0932\u092b\u094d\u0930\u0947\u0902\u0921 \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0935\u0939 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0915\u094d\u092f\u093e \u0928\u092f\u093e \u0932\u0947\u0915\u0930 \u0906\u0908 \u0939\u0948\u0964 \u092a\u0940.\u090f\u0938. \u092f\u0939 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u0947\u0935\u0932 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0906\u091c \u0906\u092a \u0907\u0938\u0947 \u092e\u0941\u092b\u094d\u0924 \u091f\u094d\u0930\u093e\u092f\u0932 \u0915\u0947 \u0938\u093e\u0925 \u0906\u091c\u092e\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u091c\u0932\u094d\u0926\u0940 \u0915\u0930\u0947\u0902, \u092f\u0939 \u0911\u092b\u0930 \u0938\u093f\u0930\u094d\u092b 48 \u0918\u0902\u091f\u0947 \u0915\u093e \u0939\u0948\u0964"
  ],
