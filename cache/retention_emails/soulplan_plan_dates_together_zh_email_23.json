{
  "subject": "\u4f60\u7ea6\u4f1a\u524d\u768430\u79d2\uff0c\u51b3\u5b9a\u4e86\u4eca\u665a\u662f\u6d6a\u6f2b\u8fd8\u662f\u5e73\u6de1",
  "preview_text": "\u6ca1\u6709SoulPlan\u7684\u591c\u665a\uff1a\u7ffb\u624b\u673a1\u5c0f\u65f6\uff0c\u6311\u4e0d\u51fa\u4e00\u4e2a\u4e3b\u610f\u3002\u6709\u5b83\uff1a30\u79d2\uff0c\u4e00\u952e\uff0c\u4f34\u4fa3\u770b\u5230\u4f60\u7684\u7528\u5fc3\u3002\u5dee\u522b\uff0c\u6709\u70b9\u5c34\u5c2c\u3002",
  "body_paragraphs": [
    "\u8fd8\u8bb0\u5f97\u4e0a\u6b21\u4f60\u4fe9\u5750\u5728\u6c99\u53d1\u4e0a\uff0c\u5404\u81ea\u5237\u624b\u673a\uff0c\u660e\u660e\u60f3\u4e00\u8d77\u505a\u70b9\u4ec0\u4e48\uff0c\u5374\u8c01\u90fd\u4e0d\u60f3\u5f00\u53e3\u8bf4\u201c\u968f\u4fbf\u201d\u5417\uff1f\u90a330\u5206\u949f\uff0c\u50cf\u5728\u7b49\u4e00\u4e2a\u6c38\u8fdc\u4e0d\u4f1a\u6765\u7684\u7075\u611f\u3002\u73b0\u5728\uff0c\u8bd5\u8bd5\u8fd9\u4e2a\uff1a\u6253\u5f00SoulPlan\uff0c\u70b9\u4e00\u4e0b\u201c\u4eca\u665a\u7684\u7ea6\u4f1a\u201d\uff0c\u9009\u4e00\u4e2a\u5fc3\u60c5\u2014\u2014\u6e29\u99a8\u3001\u5192\u9669\u3001\u751c\u871c\u3001\u6cbb\u6108\u2014\u201430\u79d2\u540e\uff0c\u4e00\u4e2a\u5b8c\u6574\u7684\u8ba1\u5212\u5c31\u5728\u773c\u524d\u3002\u5dee\u522b\uff0c\u4e0d\u662f\u4e00\u70b9\u70b9\uff0c\u662f\u5c34\u5c2c\u3002",
    "\u6ca1\u6709\u8fd9\u4e2aapp\uff0c\u4f60\u4eec\u53ef\u80fd\u53c8\u70b9\u5916\u5356\u3001\u5237\u5267\u3001\u7136\u540e\u5404\u81ea\u7761\u53bb\u2014\u2014\u4e0d\u662f\u4e0d\u60f3\u6d6a\u6f2b\uff0c\u662f\u201c\u8ba1\u5212\u201d\u8fd9\u4ef6\u4e8b\u592a\u7d2f\u4e86\u3002\u6709\u4e86\u5b83\uff0c\u4f60\u4e0d\u518d\u662f\u90a3\u4e2a\u201c\u60f3\u4e0d\u51fa\u4e3b\u610f\u201d\u7684\u4eba\uff0c\u800c\u662f\u90a3\u4e2a\u201c\u4eca\u665a\u5e26\u4f60\u53bb\u4e2a\u7279\u522b\u7684\u5730\u65b9\u201d\u7684\u4eba\u3002\u4f34\u4fa3\u7684\u60ca\u559c\u4e0d\u662f\u8fd0\u6c14\uff0c\u662f\u4e00\u4e2a\u6309\u94ae\u7684\u8ddd\u79bb\u3002",
    "\u6700\u5999\u7684\u662f\uff0c\u5f53\u4f60\u9001\u51fa\u7ea6\u4f1a\u9080\u8bf7\uff0c\u5bf9\u65b9\u770b\u5230\u7684\u4e0d\u53ea\u662f\u4e00\u6761\u901a\u77e5\u2014\u2014\u662f\u5168\u5c4f\u7684\u201c\u4eca\u665a\u60f3\u548c\u4f60\u5728\u4e00\u8d77\u201d\u7684\u753b\u9762\u3002\u800c\u4f60\u4eec\u6bcf\u4e2a\u53bb\u8fc7\u7684\u9910\u5385\u3001\u516c\u56ed\u3001\u5c0f\u5192\u9669\uff0c\u90fd\u4f1a\u81ea\u52a8\u5b58\u8fdb\u8bb0\u5fc6\u65f6\u95f4\u7ebf\uff0c\u4e09\u4e2a\u6708\u540e\u7ffb\u51fa\u6765\uff0c\u50cf\u5728\u770b\u81ea\u5df1\u7684\u7231\u60c5\u7535\u5f71\u3002",
    "\u4eca\u665a\u8bd5\u8bd5\u201c\u4eca\u665a\u7684\u7ea6\u4f1a\u201d\u529f\u80fd\u2014\u2014\u6253\u5f00app\uff0c\u70b9\u9996\u9875\u90a3\u5f20\u5361\u7247\uff0c\u9009\u5fc3\u60c5\uff0c\u7136\u540e\u53d1\u9001\u3002\u5bf9\uff0c\u5c3130\u79d2\u7684\u4e8b\u3002P.S. \u522b\u5fd8\u4e86\uff0c\u8fd9\u4e2a\u529f\u80fd\u662f\u514d\u8d39\u7684\u3002\u4f46\u9519\u8fc7\u4eca\u665a\uff0c\u53ef\u80fd\u53c8\u591a\u4e00\u5468\u7684\u201c\u968f\u4fbf\u201d\u3002"
  ],
