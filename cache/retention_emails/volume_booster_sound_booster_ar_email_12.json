{
  "subject": "\u0627\u0639\u062a\u0631\u0627\u0641: \u0643\u0646\u062a \u0623\u062a\u062c\u0627\u0647\u0644 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631 \u0627\u0644\u062e\u0637\u0623 \u0637\u0648\u0627\u0644 \u0627\u0644\u0648\u0642\u062a",
  "preview_text": "\u0627\u0643\u062a\u0634\u0641\u062a \u0628\u0627\u0644\u0635\u062f\u0641\u0629 \u0643\u064a\u0641 \u062d\u0648\u0651\u0644 \u0645\u064a\u0632\u0629 \u0648\u0627\u062d\u062f\u0629 \u0645\u062f\u0641\u0648\u0646\u0629 \u0647\u0627\u062a\u0641\u064a \u0625\u0644\u0649 \u0646\u0638\u0627\u0645 \u0635\u0648\u062a\u064a \u0627\u062d\u062a\u0631\u0627\u0641\u064a. \u0644\u0646 \u062a\u0646\u0638\u0631 \u0625\u0644\u0649 \u062a\u0637\u0628\u064a\u0642\u0643 \u0628\u0646\u0641\u0633 \u0627\u0644\u0637\u0631\u064a\u0642\u0629.",
  "body_paragraphs": [
    "\u0643\u0646\u062a \u0623\u0633\u062a\u0645\u0639 \u0625\u0644\u0649 \u0623\u0644\u0628\u0648\u0645\u064a \u0627\u0644\u0645\u0641\u0636\u0644\u060c \u0645\u062d\u0628\u0637\u064b\u0627 \u0644\u0623\u0646 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0644\u0627 \u062a\u0632\u0627\u0644 \u062a\u0628\u062f\u0648 '\u0645\u0633\u0637\u062d\u0629' \u062d\u062a\u0649 \u0628\u0639\u062f \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u062a \u0644\u0623\u0642\u0635\u0649 \u062d\u062f. \u0634\u0639\u0631\u062a \u0648\u0643\u0623\u0646 \u0634\u064a\u0626\u064b\u0627 \u0623\u0633\u0627\u0633\u064a\u064b\u0627 \u0646\u0627\u0642\u0635\u060c \u0643\u0623\u0646\u0643 \u062a\u0634\u0627\u0647\u062f \u0641\u064a\u0644\u0645\u064b\u0627 \u0645\u0644\u0648\u0646\u064b\u0627 \u0628\u0627\u0644\u0623\u0628\u064a\u0636 \u0648\u0627\u0644\u0623\u0633\u0648\u062f. \u062b\u0645 \u062d\u062f\u062b \u0627\u0644\u0623\u0645\u0631: \u0644\u0645\u0633\u0629 \u062e\u0627\u0637\u0626\u0629 \u063a\u064a\u0631\u062a \u0643\u0644 \u0634\u064a\u0621.",
    "\u0628\u0627\u0644\u0635\u062f\u0641\u0629\u060c \u0636\u063a\u0637\u062a \u0639\u0644\u0649 \u0632\u0631 '\u0627\u0644\u0645\u0639\u0632\u0632\u0627\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629' \u0627\u0644\u0630\u064a \u0643\u0646\u062a \u0623\u062a\u062c\u0627\u0647\u0644\u0647 \u062f\u0627\u0626\u0645\u064b\u0627 \u0644\u0623\u0646\u0647 \u0628\u062f\u0627 \u062a\u0642\u0646\u064a\u064b\u0627 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0627\u0644\u0644\u0627\u0632\u0645. \u0641\u062a\u062d\u062a \u0646\u0627\u0641\u0630\u0629 \u0635\u063a\u064a\u0631\u0629 \u0645\u0639 \u0645\u0646\u0632\u0644\u0642\u064a\u0646: '\u0645\u064f\u062d\u0633\u0651\u0646 \u0627\u0644\u0648\u0636\u0648\u062d' \u0648 '\u0645\u0636\u062e\u0645 \u0627\u0644\u0648\u0633\u0637\u064a\u0627\u062a'. \u062d\u0631\u0643\u062a\u0647\u0645 \u0642\u0644\u064a\u0644\u064b\u0627... \u0648\u0641\u062c\u0623\u0629\u060c \u0643\u0644 \u0622\u0644\u0629 \u0645\u0648\u0633\u064a\u0642\u064a\u0629 \u062e\u0631\u062c\u062a \u0645\u0646 \u0639\u0632\u0644\u062a\u0647\u0627. \u0633\u0645\u0639\u062a \u062a\u0641\u0627\u0635\u064a\u0644 \u0644\u0645 \u0623\u0633\u0645\u0639\u0647\u0627 \u0645\u0646 \u0642\u0628\u0644 \u0641\u064a \u0646\u0641\u0633 \u0627\u0644\u0623\u063a\u0646\u064a\u0629 \u0627\u0644\u062a\u064a \u0627\u0633\u062a\u0645\u0639\u062a \u0644\u0647\u0627 \u0645\u0626\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u062a. \u0643\u0627\u0646 \u0627\u0644\u0623\u0645\u0631 \u0623\u0634\u0628\u0647 \u0628\u062a\u0646\u0638\u064a\u0641 \u0632\u062c\u0627\u062c \u0645\u062a\u0633\u062e \u0643\u0627\u0646 \u064a\u062d\u062c\u0628 \u0635\u0648\u062a\u064a \u0627\u0644\u0645\u0641\u0636\u0644.",
    "\u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0627\u0644\u0645\u062f\u0641\u0648\u0646\u0629 \u062a\u0633\u0645\u0649 '\u0645\u064f\u062d\u0633\u0651\u0646 \u0627\u0644\u062f\u0642\u0629 \u0627\u0644\u0635\u0648\u062a\u064a\u0629'. \u0647\u064a \u0644\u064a\u0633\u062a \u0645\u062c\u0631\u062f \u0631\u0641\u0639 \u0644\u0644\u0635\u0648\u062a\u060c \u0628\u0644 \u0647\u064a \u0639\u0645\u0644\u064a\u0629 '\u062a\u0646\u0638\u064a\u0641' \u0644\u0644\u0635\u0648\u062a. \u062a\u0642\u0648\u0645 \u0628\u062a\u0636\u062e\u064a\u0645 \u0627\u0644\u062a\u0631\u062f\u062f\u0627\u062a \u0627\u0644\u0648\u0633\u0637\u0649 \u062d\u064a\u062b \u062a\u0643\u0645\u0646 \u0645\u0639\u0638\u0645 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0623\u0635\u0648\u0627\u062a \u0627\u0644\u0628\u0634\u0631\u064a\u0629 \u0648\u0627\u0644\u0622\u0644\u0627\u062a\u060c \u0628\u064a\u0646\u0645\u0627 \u062a\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u062a\u0648\u0627\u0632\u0646 \u0627\u0644\u0635\u0648\u062a \u0643\u0644\u0647. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0633\u0631 \u0627\u0644\u0630\u064a \u064a\u062c\u0639\u0644 \u0627\u0644\u0628\u0648\u062f\u0643\u0627\u0633\u062a \u064a\u0628\u062f\u0648 \u0648\u0643\u0623\u0646\u0647 \u0645\u0633\u062c\u0644 \u0641\u064a \u0627\u0633\u062a\u0648\u062f\u064a\u0648\u060c \u0648\u064a\u062c\u0639\u0644 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0627\u0644\u0643\u0644\u0627\u0633\u064a\u0643\u064a\u0629 \u062a\u062a\u0646\u0641\u0633.",
    "\u0627\u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0622\u0646\u060c \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 '\u0627\u0644\u0645\u0639\u0632\u0632\u0627\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629' \u0628\u062c\u0627\u0646\u0628 \u0645\u0639\u0627\u062f\u0644 \u0627\u0644\u0635\u0648\u062a\u060c \u0648\u062c\u0631\u0651\u0628 \u062a\u062d\u0631\u064a\u0643 \u0645\u0646\u0632\u0644\u0642 '\u0645\u064f\u062d\u0633\u0651\u0646 \u0627\u0644\u0648\u0636\u0648\u062d' \u0623\u062b\u0646\u0627\u0621 \u062a\u0634\u063a\u064a\u0644 \u0623\u064a \u0628\u0648\u062f\u0643\u0627\u0633\u062a \u0623\u0648 \u0623\u063a\u0646\u064a\u0629. \u0627\u0633\u062a\u0645\u0639 \u0643\u064a\u0641 \u062a\u0638\u0647\u0631 \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0648\u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0643\u0645\u0627 \u0644\u0648 \u0623\u0646 \u0627\u0644\u0645\u062a\u062d\u062f\u062b \u064a\u062c\u0644\u0633 \u0628\u062c\u0627\u0646\u0628\u0643. \u062c\u0631\u0628\u0647 \u0644\u0645\u062f\u0629 30 \u062b\u0627\u0646\u064a\u0629 \u0641\u0642\u0637. P.S.: \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0643\u062a\u0634\u0641\u0648\u0646 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631 \u064a\u0628\u0642\u0648\u0646 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0636\u0639\u0641 \u0627\u0644\u0645\u062f\u0629... \u0627\u0644\u0622\u0646 \u0639\u0631\u0641\u062a \u0627\u0644\u0633\u0628\u0628."
  ],
