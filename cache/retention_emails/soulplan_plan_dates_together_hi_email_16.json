{
  "subject": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0916\u093e\u0938 \u092c\u0928\u093e\u092f\u093e \u0939\u0948",
  "preview_text": "\u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092c\u0948\u0920\u0915\u0930 \u0938\u094b\u091a\u093e, \u092f\u0947 \u0924\u0941\u092e \u0926\u094b\u0928\u094b\u0902 \u0915\u094b \u092a\u0938\u0902\u0926 \u0906\u090f\u0917\u093e\u0964 \u092c\u093f\u0928\u093e \u092c\u0924\u093e\u090f \u0936\u0947\u092f\u0930 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0901\u0964",
  "body_paragraphs": [
    "\u092a\u093f\u091b\u0932\u0947 \u0939\u092b\u094d\u0924\u0947 \u0930\u093e\u0924 2 \u092c\u091c\u0947 \u092e\u0948\u0902 \u092c\u0948\u0920\u093e \u0925\u093e \u0914\u0930 \u0938\u094b\u091a \u0930\u0939\u093e \u0925\u093e \u0915\u093f \u0924\u0941\u092e \u0926\u094b\u0928\u094b\u0902 \u0915\u094b \u0915\u0948\u0938\u0947 \u0914\u0930 \u092d\u0940 \u091c\u094d\u092f\u093e\u0926\u093e \u0916\u093e\u0938 \u0932\u092e\u094d\u0939\u0947 \u092e\u093f\u0932 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u092d\u0940 \u092e\u0948\u0902\u0928\u0947 \u0915\u0941\u091b \u092c\u0928\u093e\u092f\u093e \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0915\u093f\u0938\u0940 \u0915\u094b \u0928\u0939\u0940\u0902 \u0926\u093f\u0916\u093e\u092f\u093e\u0964 \u092f\u0947 \u0910\u092a \u0915\u093e \u0915\u094b\u0908 \u092b\u0940\u091a\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u0924\u094b\u0939\u092b\u093e \u0939\u0948 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0938\u093f\u0930\u094d\u092b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0915\u093f\u092f\u093e \u0939\u0948\u0964",
    "\u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u091c\u094b\u0921\u093c\u0947 \u0905\u0915\u094d\u0938\u0930 \u090f\u0915 \u0939\u0940 \u0924\u0930\u0939 \u0915\u0940 \u0921\u0947\u091f\u094d\u0938 \u092a\u0930 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u092b\u093f\u0930 \u092a\u094d\u0932\u093e\u0928\u093f\u0902\u0917 \u092e\u0947\u0902 \u0925\u0915 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0924\u094b \u092e\u0948\u0902\u0928\u0947 \u0938\u094b\u091a\u093e, \u0915\u094d\u092f\u094b\u0902 \u0928 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0915\u0941\u091b \u0910\u0938\u093e \u0926\u0942\u0901 \u091c\u094b \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0939\u0930 \u0939\u092b\u094d\u0924\u0947 \u090f\u0915 \u0928\u0908 \u0914\u0930 \u0905\u0928\u094b\u0916\u0940 \u0921\u0947\u091f \u0915\u093e \u0906\u0907\u0921\u093f\u092f\u093e \u0926\u0947, \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u092e\u0941\u092b\u094d\u0924 \u0914\u0930 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u092a\u094d\u0930\u0947\u0936\u0930 \u0915\u0947\u0964 \u092f\u0947 \u0935\u094b \u091a\u0940\u091c\u093c \u0939\u0948 \u091c\u094b \u092e\u0948\u0902\u0928\u0947 \u0915\u092d\u0940 \u0936\u0947\u092f\u0930 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0938\u094b\u091a\u0940 \u0928\u0939\u0940\u0902 \u0925\u0940, \u0932\u0947\u0915\u093f\u0928 \u0906\u091c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u0916\u094b\u0932 \u0930\u0939\u093e \u0939\u0942\u0901\u0964",
    "\u092f\u093e\u0926 \u0939\u0948 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 SoulPlan: Plan Dates Together \u0935\u093e\u0932\u0940 'Tonight's Date' \u092b\u0940\u091a\u0930? \u0935\u094b \u091c\u094b \u090f\u0915 \u091f\u0948\u092a \u092a\u0930 \u092e\u0942\u0921 \u091a\u0941\u0928\u0915\u0930 \u0921\u0947\u091f \u092a\u094d\u0932\u093e\u0928 \u0915\u0930 \u0926\u0947\u0924\u0940 \u0939\u0948? \u092e\u0948\u0902\u0928\u0947 \u0909\u0938\u0940 \u092e\u0947\u0902 \u090f\u0915 \u091b\u093f\u092a\u093e \u0939\u0941\u0906 \u092e\u094b\u0921 \u091c\u094b\u0921\u093c\u093e \u0939\u0948 - '\u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u0928\u093e\u0907\u091f'\u0964 \u0907\u0938\u0947 \u0922\u0942\u0902\u0922\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u094b\u092e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u092b\u094b\u091f\u094b \u0915\u094b \u0924\u0940\u0928 \u092c\u093e\u0930 \u091f\u0948\u092a \u0915\u0930\u094b \u0914\u0930 \u092b\u093f\u0930 '\u0905\u0928\u0932\u0949\u0915 \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c' \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u094b\u0964 \u092f\u0947 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0910\u0938\u0940 \u0921\u0947\u091f\u094d\u0938 \u0926\u0947\u0917\u093e \u091c\u094b \u0924\u0941\u092e\u0928\u0947 \u0915\u092d\u0940 \u0938\u094b\u091a\u0940 \u0928\u0939\u0940\u0902 \u0939\u094b\u0902\u0917\u0940, \u0914\u0930 \u092f\u0947 \u0938\u093f\u0930\u094d\u092b 24 \u0918\u0902\u091f\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915\u094d\u091f\u093f\u0935 \u0939\u0948\u0964",
    "\u0905\u092c \u0910\u092a \u0916\u094b\u0932\u094b \u0914\u0930 \u0939\u094b\u092e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0905\u092a\u0928\u0940 \u092b\u094b\u091f\u094b \u0915\u094b \u0924\u0940\u0928 \u092c\u093e\u0930 \u091f\u0948\u092a \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u094b\u0964 \u092f\u0947 \u0924\u094b\u0939\u092b\u093e \u0938\u093f\u0930\u094d\u092b \u0906\u091c \u0930\u093e\u0924 \u0924\u0915 \u0939\u0948\u0964 P.S. - \u090f\u0915 \u092c\u093e\u0930 \u091f\u094d\u0930\u093e\u0908 \u0915\u0930\u094b\u0917\u0947 \u0924\u094b \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u0928\u093e \u0915\u093f \u0915\u0948\u0938\u093e \u0932\u0917\u093e, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092e\u0948\u0902\u0928\u0947 \u092f\u0947 \u0938\u093f\u0930\u094d\u092b \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092e\u0941\u0938\u094d\u0915\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964"
  ],
