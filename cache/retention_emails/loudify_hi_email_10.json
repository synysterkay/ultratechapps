{
  "subject": "\u0906\u092a\u0915\u0940 21 \u0926\u093f\u0928 \u0915\u0940 \u0906\u0926\u0924 \u091c\u094b \u092c\u0926\u0932 \u0926\u0947\u0917\u0940 \u0938\u092c",
  "preview_text": "\u091f\u0949\u092a 1% \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0940 \u0935\u0930\u094d\u0915\u092b\u093c\u094d\u0932\u094b \u0915\u093e \u0930\u093e\u091c\u093c \u2013 \u0907\u0938\u0947 \u0906\u091c\u093c\u092e\u093e\u090f\u0902 \u0914\u0930 \u092b\u0930\u094d\u0915 \u0926\u0947\u0916\u0947\u0902",
  "body_paragraphs": [
    "\u0930\u0941\u0915\u094b, \u0915\u094d\u092f\u093e \u0906\u092a\u0928\u0947 \u0915\u092d\u0940 \u0938\u094b\u091a\u093e \u0939\u0948 \u0915\u093f \u0939\u092e\u093e\u0930\u0947 \u091f\u0949\u092a 1% \u092f\u0942\u091c\u0930\u094d\u0938 \u0905\u092a\u0928\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u094b \u0915\u0948\u0938\u0947 \u091f\u094d\u092f\u0942\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902? \u0935\u0947 \u0939\u0930 \u0930\u094b\u091c\u093c \u090f\u0915 \u0939\u0940 \u0924\u0930\u0940\u0915\u093e \u0905\u092a\u0928\u093e\u0924\u0947 \u0939\u0948\u0902 \u2013 \u0914\u0930 \u0906\u092a \u092d\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0915\u094b\u0908 \u091c\u093e\u0926\u0942 \u0928\u0939\u0940\u0902, \u092c\u0938 \u090f\u0915 \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0935\u0930\u094d\u0915\u092b\u093c\u094d\u0932\u094b \u0939\u0948\u0964",
    "\u0926\u0947\u0916\u093f\u090f, \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092c\u0922\u093c\u093e\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092b\u093f\u0930 \u0921\u093e\u092f\u0932\u0949\u0917 \u0917\u093e\u092f\u092c \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u091f\u0949\u092a 1% \u092f\u0942\u091c\u0930\u094d\u0938 \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u094b \u0938\u0947\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u2013 \u0935\u0947 AutoEQ \u0915\u094b \u090f\u0915 \u092c\u093e\u0930 \u0915\u0948\u0932\u093f\u092c\u094d\u0930\u0947\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092b\u093f\u0930 \u092d\u0942\u0932 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u0930 \u092c\u093e\u0930 \u091c\u092c \u0935\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b\u0924\u0947 \u0939\u0948\u0902, \u0911\u0921\u093f\u092f\u094b \u0905\u092a\u0928\u0947 \u0906\u092a \u092a\u0930\u092b\u0947\u0915\u094d\u091f \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092f\u0939\u0940 \u092b\u0930\u094d\u0915 \u0939\u0948\u0964",
    "\u0939\u092e\u093e\u0930\u0940 '\u092a\u094d\u0930\u094b \u0935\u0930\u094d\u0915\u092b\u093c\u094d\u0932\u094b' \u092b\u0940\u091a\u0930 \u0906\u092a\u0915\u094b \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u091f\u0948\u092a \u092e\u0947\u0902 \u0905\u092a\u0928\u093e \u0938\u093e\u0909\u0902\u0921 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092c\u0926\u0932\u0928\u0947 \u0926\u0947\u0924\u0940 \u0939\u0948 \u2013 \u092e\u094d\u092f\u0942\u091c\u093c\u093f\u0915, \u092e\u0942\u0935\u0940, \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u092f\u093e \u0917\u0947\u092e\u093f\u0902\u0917\u0964 \u0914\u0930 \u091c\u092c \u0906\u092a \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092a\u0930 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0906\u092a\u0915\u094b 200+ \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u092e\u0949\u0921\u0932\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u092e\u093f\u0932\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0915\u094b\u0908 \u0917\u093f\u092e\u093f\u0915 \u0928\u0939\u0940\u0902 \u2013 \u092f\u0939 \u0905\u0938\u0932\u0940 \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0939\u0948\u0964",
    "\u0905\u092c \u090f\u0915 \u0915\u093e\u092e \u0915\u0930\u0947\u0902: \u0906\u091c Loudify \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0947 \u0932\u093f\u090f AutoEQ \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964 \u092c\u0938 30 \u0938\u0947\u0915\u0902\u0921 \u0932\u0917\u0924\u0947 \u0939\u0948\u0902\u0964 \u092b\u093f\u0930 \u0926\u0947\u0916\u093f\u090f \u0915\u0948\u0938\u0947 \u0939\u0930 \u0917\u093e\u0928\u093e \u0914\u0930 \u0939\u0930 \u092a\u0949\u0921\u0915\u093e\u0938\u094d\u091f \u0938\u093e\u092b\u093c \u0914\u0930 \u0924\u0947\u091c\u093c \u0932\u0917\u0924\u093e \u0939\u0948\u0964 P.S. \u2013 '\u0938\u093e\u0909\u0902\u0921 DNA' \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0906\u092a\u0915\u094b \u0939\u092b\u093c\u094d\u0924\u0947 \u0915\u0947 \u0905\u0902\u0924 \u092e\u0947\u0902 \u092a\u0938\u0902\u0926 \u0906\u090f\u0917\u0940 \u2013 \u0905\u0938\u0932\u0940 \u0921\u0947\u091f\u093e, \u0905\u0938\u0932\u0940 \u0938\u0941\u0927\u093e\u0930\u0964"
  ],
