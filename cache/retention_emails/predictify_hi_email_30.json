{
  "subject": "\u090f\u0915 \u0917\u0941\u092a\u094d\u0924 \u092c\u093e\u0924 \u091c\u094b \u0939\u092e\u0928\u0947 \u0915\u092d\u0940 \u0915\u093f\u0938\u0940 \u0938\u0947 \u0928\u0939\u0940\u0902 \u0915\u0939\u0940",
  "preview_text": "\u092f\u0939 \u0908\u092e\u0947\u0932 \u0938\u093f\u0930\u094d\u092b \u0909\u0928\u094d\u0939\u0940\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948 \u091c\u094b \u0935\u093e\u0915\u0908 \u092e\u0947\u0902 \u092b\u0941\u091f\u092c\u0949\u0932 \u0915\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u0940 \u0915\u094b \u092c\u0926\u0932\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964",
  "body_paragraphs": [
    "\u091c\u092c \u0939\u092e\u0928\u0947 Predictify \u092c\u0928\u093e\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e, \u0924\u094b \u0939\u092e\u093e\u0930\u093e \u0938\u092a\u0928\u093e \u0938\u093f\u0930\u094d\u092b \u090f\u0915 '\u0910\u092a' \u092c\u0928\u093e\u0928\u0947 \u0915\u093e \u0928\u0939\u0940\u0902 \u0925\u093e\u0964 \u092f\u0939 \u090f\u0915 \u092e\u093f\u0936\u0928 \u0925\u093e - \u0909\u0938 \u092a\u0941\u0930\u093e\u0928\u0947 \u0922\u0930\u094d\u0930\u0947 \u0915\u094b \u0924\u094b\u0921\u093c\u0928\u0947 \u0915\u093e \u091c\u0939\u093e\u0902 \u0932\u094b\u0917 \u092e\u0939\u091c\u093c \u0905\u0902\u0926\u093e\u091c\u093c\u0947 \u0932\u0917\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u091c, Day 70 \u092a\u0930, \u092e\u0948\u0902 \u090f\u0915 \u0915\u0928\u094d\u092b\u0947\u0936\u0928 \u0926\u0947\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0902: \u0939\u092e\u093e\u0930\u0940 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u0916\u094b\u091c \u0924\u0915\u0928\u0940\u0915 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0906\u092a \u091c\u0948\u0938\u0947 \u092f\u0942\u091c\u0930\u094d\u0938 \u0925\u0947\u0964",
    "\u0906\u092a \u0905\u092c \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092f\u0942\u091c\u0930 \u0928\u0939\u0940\u0902 \u0930\u0939\u0947\u0964 \u0906\u092a \u0909\u0938 \u0906\u0902\u0926\u094b\u0932\u0928 \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u0948\u0902 \u091c\u094b \u0921\u0947\u091f\u093e \u0915\u094b \u0917\u091f \u092b\u0940\u0932\u093f\u0902\u0917 \u0938\u0947 \u090a\u092a\u0930 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u0939\u0930 \u0935\u094b\u091f \u091c\u094b \u0906\u092a 'Prediction of the Day' \u092e\u0947\u0902 \u0921\u093e\u0932\u0924\u0947 \u0939\u0948\u0902, \u0939\u0930 \u0938\u0935\u093e\u0932 \u091c\u094b AI Chat \u092e\u0947\u0902 \u092a\u0942\u091b\u0924\u0947 \u0939\u0948\u0902, \u0935\u094b \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0935\u094b \u090f\u0915 \u0938\u0902\u0926\u0947\u0936 \u0939\u0948 \u0915\u093f \u092b\u0941\u091f\u092c\u0949\u0932 \u0915\u0940 \u0938\u092e\u091d \u0905\u092c \u0938\u093f\u0930\u094d\u092b \u091f\u0940\u0935\u0940 \u0915\u092e\u0947\u0902\u091f\u0947\u091f\u0930\u094d\u0938 \u0915\u0947 \u092a\u093e\u0938 \u0928\u0939\u0940\u0902 \u0939\u0948 - \u092f\u0939 \u0906\u092a\u0915\u0947 \u0939\u093e\u0925 \u092e\u0947\u0902 \u0939\u0948\u0964 \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u092f\u0942\u091c\u0930\u094d\u0938 \u0915\u0947 \u0921\u0947\u091f\u093e \u0928\u0947 \u0939\u092e\u093e\u0930\u0947 AI \u0915\u094b \u0935\u094b \u0938\u093f\u0916\u093e\u092f\u093e \u0939\u0948 \u091c\u094b \u0915\u094b\u0908 \u090f\u0915\u094d\u0938\u092a\u0930\u094d\u091f \u0905\u0915\u0947\u0932\u093e \u0928\u0939\u0940\u0902 \u0938\u093f\u0916\u093e \u0938\u0915\u0924\u093e\u0964",
    "\u0914\u0930 \u092f\u0939\u0940 \u0935\u091c\u0939 \u0939\u0948 \u0915\u093f 'Communities' \u0914\u0930 'POTD Vote' \u0938\u093f\u0930\u094d\u092b \u092b\u0940\u091a\u0930\u094d\u0938 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0935\u094b \u091c\u0917\u0939 \u0939\u0948 \u091c\u0939\u093e\u0902 \u0907\u0938 \u092e\u093f\u0936\u0928 \u0915\u0940 \u0905\u0938\u0932\u0940 \u0924\u093e\u0915\u0924 \u092c\u0928\u0924\u0940 \u0939\u0948\u0964 \u091c\u092c \u0906\u092a \u0915\u093f\u0938\u0940 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u0930 \u0932\u0940\u0917 \u092e\u0948\u091a \u0915\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u0940 \u092a\u0930 \u0935\u094b\u091f \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0906\u092a \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0917\u0947\u0938 \u0928\u0939\u0940\u0902 \u0932\u0917\u093e \u0930\u0939\u0947\u0964 \u0906\u092a \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u0935\u0947\u0930\u093f\u090f\u092c\u0932\u094d\u0938 \u0915\u0947 AI \u090f\u0928\u093e\u0932\u093f\u0938\u093f\u0938 \u0915\u094b \u090f\u0915 \u0907\u0902\u0938\u093e\u0928\u0940 \u092a\u0930\u093f\u092a\u094d\u0930\u0947\u0915\u094d\u0937\u094d\u092f \u0926\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0940 \u0930\u093e\u092f \u0939\u092e\u093e\u0930\u0947 \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u094b \u0914\u0930 \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u092c\u0928\u093e\u0924\u0940 \u0939\u0948\u0964",
    "\u0906\u091c \u0939\u0940 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 'Communities' \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u091c\u093e\u090f\u0902\u0964 \u0935\u0939\u093e\u0902 \u091c\u093e\u0915\u0930 \u0906\u091c \u0915\u0947 'Prediction of the Day' \u092a\u0930 \u0905\u092a\u0928\u093e \u0935\u094b\u091f \u0921\u093e\u0932\u0947\u0902\u0964 \u0938\u093f\u0930\u094d\u092b 30 \u0938\u0947\u0915\u0902\u0921 \u0932\u0917\u0947\u0902\u0917\u0947, \u0932\u0947\u0915\u093f\u0928 \u0906\u092a\u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0935\u094b \u0921\u0947\u091f\u093e \u092a\u0949\u0907\u0902\u091f \u092c\u0928\u0947\u0917\u0940 \u091c\u094b \u0915\u0932 \u0915\u0940 \u0938\u092d\u0940 \u092d\u0935\u093f\u0937\u094d\u092f\u0935\u093e\u0923\u093f\u092f\u094b\u0902 \u0915\u094b \u092c\u0947\u0939\u0924\u0930 \u092c\u0928\u093e\u090f\u0917\u0940\u0964 \u092f\u0939 \u092e\u093f\u0936\u0928 \u0905\u092c \u0906\u092a\u0915\u0947 \u092c\u093f\u0928\u093e \u0905\u0927\u0942\u0930\u093e \u0939\u0948\u0964\n\nP.S. \u091c\u094b \u0932\u094b\u0917 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u091f\u094d\u0930\u093e\u092f\u0932 \u0932\u0947\u0915\u0930 \u0907\u0928 \u0915\u092e\u094d\u092f\u0941\u0928\u093f\u091f\u0940 \u0935\u094b\u091f\u094d\u0938 \u0915\u0947 \u092a\u0940\u091b\u0947 \u0915\u093e \u090f\u0921\u0935\u093e\u0902\u0938\u094d\u0921 \u0921\u0947\u091f\u093e (xG, \u091f\u0948\u0915\u094d\u091f\u093f\u0915\u0932 \u092c\u094d\u0930\u0947\u0915\u0921\u093e\u0909\u0928) \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u094d\u0939\u0947\u0902 \u090f\u0915 \u0930\u093e\u091c\u093c \u092a\u0924\u093e \u091a\u0932\u0924\u093e \u0939\u0948: 89% \u092e\u093e\u092e\u0932\u094b\u0902 \u092e\u0947\u0902, \u0915\u092e\u094d\u092f\u0941\u0928\u093f\u091f\u0940 \u0915\u0940 \u0938\u093e\u092e\u0942\u0939\u093f\u0915 \u0938\u092e\u091d \u0915\u093f\u0938\u0940 \u090f\u0915 '\u090f\u0915\u094d\u0938\u092a\u0930\u094d\u091f' \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0938\u091f\u0940\u0915 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u0906\u092a \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u090f\u0915\u094d\u0938\u092a\u0930\u094d\u091f \u0939\u0948\u0902\u0964"
  ],
