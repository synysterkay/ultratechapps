{
  "subject": "42 \u0926\u093f\u0928, \u0914\u0930 \u0905\u092c \u0906 \u0930\u0939\u093e \u0939\u0948 \u0915\u0941\u091b \u092c\u0921\u093c\u093e",
  "preview_text": "\u0906\u092a\u0915\u0947 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0928\u0908 \u0938\u0941\u0935\u093f\u0927\u093e, \u091c\u094b \u0939\u092e\u0928\u0947 \u0905\u092c \u0924\u0915 \u0915\u093f\u0938\u0940 \u0915\u094b \u0928\u0939\u0940\u0902 \u0926\u093f\u0916\u093e\u0908\u0964 \u092a\u0939\u0932\u0947 \u0906\u092a \u0926\u0947\u0916\u093f\u090f\u0964",
  "body_paragraphs": [
    "\u0938\u0941\u0928\u093f\u090f, \u0939\u092e \u0915\u0941\u091b \u0910\u0938\u093e \u092c\u0928\u093e \u0930\u0939\u0947 \u0939\u0948\u0902 \u091c\u094b \u0906\u092a\u0915\u0947 \u0939\u0930 \u0915\u0928\u0947\u0915\u094d\u091f\u0947\u0921 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u094b \u092a\u0939\u091a\u093e\u0928\u0947\u0917\u093e \u0914\u0930 \u0909\u0938\u0947 \u0924\u0941\u0930\u0902\u0924 \u091f\u094d\u092f\u0942\u0928 \u0915\u0930 \u0926\u0947\u0917\u093e\u0964 \u092f\u0939 \u0915\u094b\u0908 AI \u091a\u092e\u0924\u094d\u0915\u093e\u0930 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u0910\u0938\u093e \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0939\u0948 \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0906\u092a\u0915\u0947 \u0915\u093e\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0964",
    "\u0939\u092e\u0928\u0947 100,000 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0932\u094b\u0917\u094b\u0902 \u0915\u0940 \u0938\u0941\u0928\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924\u094b\u0902 \u0915\u093e \u0905\u0927\u094d\u092f\u092f\u0928 \u0915\u093f\u092f\u093e \u0914\u0930 \u092a\u093e\u092f\u093e \u0915\u093f \u0939\u0930 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u093e \u0905\u092a\u0928\u093e \u090f\u0915 '\u0927\u094d\u0935\u0928\u093f \u091a\u0947\u0939\u0930\u093e' \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0905\u092c \u0939\u092e \u0909\u0938\u0947 \u0915\u0948\u0926 \u0915\u0930 \u0932\u0947\u0902\u0917\u0947, \u0924\u093e\u0915\u093f \u091c\u092c \u092d\u0940 \u0906\u092a \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902, \u0906\u092a\u0915\u094b \u0935\u0939\u0940 \u0938\u093e\u092b \u0914\u0930 \u0924\u0947\u091c\u093c \u0906\u0935\u093e\u091c\u093c \u092e\u093f\u0932\u0947\u0964",
    "\u0905\u0917\u0932\u0947 \u0939\u092b\u093c\u094d\u0924\u0947 \u0906 \u0930\u0939\u093e \u0939\u0948: '\u0938\u093e\u0909\u0902\u0921 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092e\u0948\u0928\u0947\u091c\u0930' \u2014 \u091c\u0939\u093e\u0901 \u0906\u092a \u0905\u092a\u0928\u0947 \u0939\u0930 \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917-\u0905\u0932\u0917 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0938\u0947\u0935 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0914\u0930 \u0939\u093e\u0901, \u092f\u0939 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092f\u0942\u091c\u093c\u0930\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u0939\u094b\u0917\u093e\u0964",
